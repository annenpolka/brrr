#!/usr/bin/env python3
"""effect: declared / assigned / env-layer provenance as one record for KEY."""

from __future__ import annotations

import json
import os
import re
import sys
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import Dict, Iterable, Iterator, List, Optional, Sequence, Tuple

USAGE = "usage: effect [--json] KEY [DIR]"

CONFIG_EXTS = {".yml", ".yaml", ".toml", ".cfg", ".ini", ".json"}
SOURCE_EXTS = {".py", ".js", ".ts", ".go", ".rs", ".c"}
SKIP_DIRS = {
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    "dist",
    "build",
    "target",
    ".tox",
    ".mypy_cache",
    ".hdd",
}
MAX_FILE_BYTES = 2 * 1024 * 1024
BOOL_WORDS = {"true", "false", "yes", "no", "on", "off", "null", "none"}
DEFAULT_ENV_FILES = (".env", ".env.local")
VALID_ENV_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
ENV_NAME = r"[A-Za-z_][A-Za-z0-9_]*"

DEFER_PATTERNS = (
    re.compile(r"\$\{(" + ENV_NAME + r")\}"),
    re.compile(r"(?<![A-Za-z0-9_])\$(" + ENV_NAME + r")"),
    re.compile(r"os\.getenv\(\s*['\"](" + ENV_NAME + r")['\"]"),
    re.compile(r"(?<![A-Za-z0-9_])getenv\(\s*['\"](" + ENV_NAME + r")['\"]"),
    re.compile(r"os\.environ\.get\(\s*['\"](" + ENV_NAME + r")['\"]"),
    re.compile(r"os\.environ\[\s*['\"](" + ENV_NAME + r")['\"]"),
    re.compile(r"process\.env\.(" + ENV_NAME + r")"),
    re.compile(r"process\.env\[\s*['\"](" + ENV_NAME + r")['\"]"),
    re.compile(r"env::var\(\s*['\"](" + ENV_NAME + r")['\"]"),
)


@dataclass
class Hit:
    path: str
    line: int
    text: str
    side: str
    raw_value: Optional[str]
    comparable: bool
    reason: Optional[str] = None
    in_comment: bool = False

    def display_value(self) -> str:
        if self.raw_value is None:
            return "—"
        if not self.comparable:
            extra = f": {self.reason}" if self.reason else ""
            return f"{self.raw_value} (not comparable{extra})"
        return self.raw_value


@dataclass(frozen=True)
class EnvAssign:
    key: str
    value: str
    path: str
    line: int


@dataclass
class EnvRow:
    key: str
    value: str
    source: str
    empty_override: bool
    inherited: Optional[str]
    in_file: bool
    in_process: bool
    why: str


@dataclass
class Effective:
    status: str  # value | empty | unknown
    value: Optional[str]
    reason: Optional[str]


@dataclass
class Effect:
    key: str
    directory: str
    declared: list[Hit] = field(default_factory=list)
    assigned: list[Hit] = field(default_factory=list)
    comments: list[Hit] = field(default_factory=list)
    env_source: list[EnvRow] = field(default_factory=list)
    deferred: list[str] = field(default_factory=list)
    effective: Effective = field(default_factory=lambda: Effective("unknown", None, None))
    disagree: bool = False


def is_dotenv_name(name: str) -> bool:
    return name == ".env" or name.startswith(".env.")


def is_config_file(path: Path) -> bool:
    if is_dotenv_name(path.name):
        return False
    return path.suffix.lower() in CONFIG_EXTS


def is_source_file(path: Path) -> bool:
    return path.suffix.lower() in SOURCE_EXTS


def iter_files(root: Path) -> Iterator[Path]:
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
        base = Path(dirpath)
        for name in filenames:
            if name.startswith("."):
                continue
            path = base / name
            if is_config_file(path) or is_source_file(path):
                yield path


def _key_atom(key: str) -> str:
    escaped = re.escape(key)
    return rf"(?:['\"]{escaped}['\"]|{escaped})"


def config_key_re(key: str) -> re.Pattern[str]:
    atom = _key_atom(key)
    # Declarations sit at the start of a config line (indent / export ok).
    # Compact JSON/TOML may lead with { [ or a previous member's comma, so
    # {"KEY": 5} is still a declaration. Pretty-printed JSON already matched.
    return re.compile(
        rf"(?P<pre>^[\t {{[,]*(?:export[\t ]+)?)(?P<key>{atom})(?P<op>[\t ]*(:=|:|=)[\t ]*)(?P<rest>.*)$"
    )


def source_key_re(key: str) -> re.Pattern[str]:
    atom = _key_atom(key)
    return re.compile(
        rf"^(?P<pre>.*?)(?<![A-Za-z0-9_])(?P<key>{atom})(?![A-Za-z0-9_])(?P<op>[\t ]*(:=|:|=)[\t ]*)(?P<rest>.*)$"
    )


def comment_key_re(key: str) -> re.Pattern[str]:
    atom = _key_atom(key)
    return re.compile(
        rf"(?<![A-Za-z0-9_])(?P<key>{atom})(?![A-Za-z0-9_])(?P<op>[\t ]*(:=|:|=)[\t ]*)(?P<rest>.*)$"
    )


def assignment_operator_ok(line: str, m: re.Match[str]) -> bool:
    op = m.group("op")
    stripped = op.strip()
    if stripped in {":=", ":"}:
        return True
    if stripped != "=":
        return False
    eq_at = m.start("op") + op.find("=")
    prev = line[eq_at - 1] if eq_at > 0 else ""
    nxt = line[eq_at + 1] if eq_at + 1 < len(line) else ""
    if prev in "!<>=" or nxt == "=":
        return False
    return True


@dataclass
class CommentState:
    block: bool = False
    triple: Optional[str] = None

    def consume(self, line: str, ext: str) -> str:
        if self.block:
            if "*/" in line:
                self.block = False
                after = line.split("*/", 1)[1]
                if after.strip():
                    return self.consume(after, ext)
            return "comment"
        if self.triple:
            if self.triple in line:
                self.triple = None
            return "comment"
        stripped = line.lstrip()
        if stripped.startswith("#") or stripped.startswith("//"):
            return "comment"
        if ext in {".ini", ".cfg"} and stripped.startswith(";"):
            return "comment"
        if stripped.startswith("/*"):
            if "*/" in stripped:
                after = stripped.split("*/", 1)[1]
                if after.strip():
                    return self.consume(after, ext)
                return "comment"
            self.block = True
            return "comment"
        if ext == ".py":
            for quote in ('"""', "'''"):
                if stripped.startswith(quote):
                    rest = stripped[len(quote) :]
                    if quote in rest:
                        return "comment"
                    self.triple = quote
                    return "comment"
        return "code"


def strip_inline_comment(text: str) -> str:
    out: List[str] = []
    quote: Optional[str] = None
    i = 0
    while i < len(text):
        ch = text[i]
        if quote:
            out.append(ch)
            if ch == "\\" and i + 1 < len(text):
                out.append(text[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "'\"":
            quote = ch
            out.append(ch)
            i += 1
            continue
        if ch == "#" and (i == 0 or text[i - 1].isspace()):
            break
        if ch == "/" and i + 1 < len(text) and text[i + 1] == "/" and (i == 0 or text[i - 1].isspace()):
            break
        out.append(ch)
        i += 1
    return "".join(out).rstrip()


def _json_sibling_follows(leftover: str) -> bool:
    """True when leftover is a closer, a trailing comma, or `, "next"`."""
    if not leftover:
        return False
    if leftover[0] in "}]":
        return True
    if leftover[0] != ",":
        return False
    nxt = leftover[1:].lstrip()
    if not nxt or nxt[0] in "}]":
        return True
    if nxt[0] in "'\"":
        return True
    return False


def first_member_token(rest: str) -> str:
    """Keep the first value when more JSON members share the line.

    Compact `5, "host": "localhost"}` compares as `5`. A value that is
    itself `{...}` / `[...]` is left whole (non-scalar). `5, 6` is left
    whole so a tuple assignment stays unparsed, not a fake scalar 5.
    """
    s = rest.strip()
    if not s or s[0] in "{[(":
        return rest
    if s[0] in "'\"":
        quote = s[0]
        i = 1
        while i < len(s):
            ch = s[i]
            if ch == "\\" and i + 1 < len(s):
                i += 2
                continue
            if ch == quote:
                i += 1
                break
            i += 1
        leftover = s[i:].lstrip()
        if _json_sibling_follows(leftover):
            return s[:i]
        return rest
    m = re.match(r"[^\s,}\];]+", s)
    if not m:
        return rest
    leftover = s[m.end() :].lstrip()
    if _json_sibling_follows(leftover):
        return m.group(0)
    return rest


def parse_scalar(
    rest: str, *, compact_json: bool = False
) -> tuple[Optional[str], bool, Optional[str]]:
    rest = strip_inline_comment(rest).strip()
    # Only cut JSON siblings on compact object/array lines. Applying the
    # cut everywhere ate `${WAIT}` and `os.getenv("TIMEOUT", "5")`.
    if compact_json:
        rest = first_member_token(rest)
    if rest.endswith((",", ";")):
        rest = rest[:-1].rstrip()
    if not rest:
        return None, False, "empty"
    if rest[0] in "{[(":
        return rest, False, "non-scalar"
    if rest.startswith("$") or "${" in rest or "{{" in rest:
        return rest, False, "interpolation"
    if re.search(r"[A-Za-z_]\w*\s*\(", rest):
        return rest, False, "call"
    if "[" in rest:
        return rest, False, "subscript"
    if rest[0] in "'\"":
        quote = rest[0]
        inner: List[str] = []
        i = 1
        closed = False
        while i < len(rest):
            ch = rest[i]
            if ch == "\\" and i + 1 < len(rest):
                inner.append(rest[i + 1])
                i += 2
                continue
            if ch == quote:
                closed = True
                i += 1
                break
            inner.append(ch)
            i += 1
        if not closed:
            return rest, False, "unterminated-string"
        leftover = rest[i:].strip()
        if leftover and leftover not in {",", ";", ")"}:
            return rest, False, "expression"
        return "".join(inner), True, None
    if re.fullmatch(r"-?\d+(?:\.\d+)?", rest):
        return rest, True, None
    if rest.lower() in BOOL_WORDS:
        return rest, True, None
    if re.fullmatch(r"-?\d+(?:\.\d+)?[A-Za-z%]+", rest):
        return rest, True, None
    if re.search(r"[=+\*/|&<>?:]", rest):
        return rest, False, "expression"
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_\.]*", rest):
        return rest, False, "identifier"
    return rest, False, "unparsed"


def canonical(value: str) -> object:
    lowered = value.lower()
    if re.fullmatch(r"-?\d+", value):
        return int(value)
    if re.fullmatch(r"-?\d+\.\d+", value):
        return float(value)
    if lowered in {"true", "yes", "on"}:
        return True
    if lowered in {"false", "no", "off"}:
        return False
    if lowered in {"null", "none"}:
        return None
    return value


def values_equal(a: str, b: str) -> bool:
    return canonical(a) == canonical(b)


def relpath(path: Path, root: Path) -> str:
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return str(path)


def _make_hit(rel: str, lineno: int, line: str, m: re.Match[str], side: str, in_comment: bool) -> Optional[Hit]:
    if not assignment_operator_ok(line, m):
        return None
    pre = m.groupdict().get("pre") or ""
    compact_json = side == "declaration" and any(ch in pre for ch in "{[,")
    raw, comparable, reason = parse_scalar(m.group("rest"), compact_json=compact_json)
    if raw is None and reason == "empty":
        return None
    return Hit(
        path=rel,
        line=lineno,
        text=line.rstrip(),
        side=side,
        raw_value=raw,
        comparable=comparable,
        reason=reason,
        in_comment=in_comment,
    )


def scan_file(path: Path, root: Path, key: str, side: str) -> tuple[list[Hit], list[Hit]]:
    code_hits: list[Hit] = []
    comment_hits: list[Hit] = []
    try:
        size = path.stat().st_size
    except OSError:
        return code_hits, comment_hits
    if size > MAX_FILE_BYTES:
        return code_hits, comment_hits
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return code_hits, comment_hits
    rel = relpath(path, root)
    ext = path.suffix.lower()
    code_pattern = config_key_re(key) if side == "declaration" else source_key_re(key)
    cmt_pattern = comment_key_re(key)
    state = CommentState()
    for lineno, line in enumerate(text.splitlines(), 1):
        kind = state.consume(line, ext)
        if kind == "comment":
            m = cmt_pattern.search(line)
            if not m:
                continue
            hit = _make_hit(rel, lineno, line, m, "comment", True)
            if hit:
                comment_hits.append(hit)
            continue
        m = code_pattern.search(line)
        if not m:
            continue
        hit = _make_hit(rel, lineno, line, m, side, False)
        if hit:
            code_hits.append(hit)
    return code_hits, comment_hits


def scan(root: Path, key: str) -> tuple[list[Hit], list[Hit], list[Hit]]:
    declarations: list[Hit] = []
    assignments: list[Hit] = []
    comments: list[Hit] = []
    for path in iter_files(root):
        if is_config_file(path):
            code, cmt = scan_file(path, root, key, "declaration")
            declarations.extend(code)
            comments.extend(cmt)
        elif is_source_file(path):
            code, cmt = scan_file(path, root, key, "assignment")
            assignments.extend(code)
            comments.extend(cmt)
    return declarations, assignments, comments


def comparable_hits(hits: Iterable[Hit]) -> list[Hit]:
    return [h for h in hits if h.comparable and h.raw_value is not None and not h.in_comment]


def unique_values(hits: Iterable[Hit]) -> list[str]:
    seen: list[str] = []
    canons: list[object] = []
    for h in hits:
        assert h.raw_value is not None
        c = canonical(h.raw_value)
        if c not in canons:
            canons.append(c)
            seen.append(h.raw_value)
    return seen


def extract_deferred(hits: Iterable[Hit]) -> list[str]:
    order: list[str] = []
    seen = set()
    for h in hits:
        if h.in_comment:
            continue
        blob = " ".join(x for x in (h.raw_value, h.text) if x)
        for pat in DEFER_PATTERNS:
            for m in pat.finditer(blob):
                name = m.group(1)
                if name not in seen:
                    seen.add(name)
                    order.append(name)
    return order


def strip_export_prefix(stripped: str) -> str:
    if stripped.startswith("export"):
        rest = stripped[6:]
        if rest[:1].isspace():
            return rest.lstrip()
    return stripped


def parse_dotenv_value(raw: str) -> str:
    i = 0
    n = len(raw)
    while i < n and raw[i] in " \t":
        i += 1
    if i >= n:
        return ""
    if raw[i] in "'\"":
        quote = raw[i]
        i += 1
        out: List[str] = []
        while i < n:
            c = raw[i]
            if quote == '"' and c == "\\" and i + 1 < n:
                nxt = raw[i + 1]
                escapes = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", '"': '"', "'": "'"}
                out.append(escapes.get(nxt, nxt))
                i += 2
                continue
            if c == quote:
                return "".join(out)
            out.append(c)
            i += 1
        return "".join(out)
    out = []
    while i < n:
        c = raw[i]
        if c == "#" and (not out or out[-1] in " \t"):
            break
        out.append(c)
        i += 1
    return "".join(out).rstrip()


def parse_dotenv(path: Path) -> List[EnvAssign]:
    out: List[EnvAssign] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return out
    except OSError as exc:
        raise SystemExit(f"effect: cannot read {path}: {exc}") from exc
    for n, raw in enumerate(lines, 1):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        stripped = strip_export_prefix(stripped)
        if "=" not in stripped:
            continue
        key, _, value = stripped.partition("=")
        key = key.strip()
        if not key or not VALID_ENV_KEY.match(key):
            continue
        out.append(EnvAssign(key=key, value=parse_dotenv_value(value), path=str(path), line=n))
    return out


def load_dotenv(directory: Path, names: Sequence[str] = DEFAULT_ENV_FILES) -> Dict[str, EnvAssign]:
    won: Dict[str, EnvAssign] = {}
    for name in names:
        path = directory / name
        if not path.is_file():
            continue
        for assign in parse_dotenv(path):
            won[assign.key] = assign
    return won


def env_row(
    name: str,
    files: Dict[str, EnvAssign],
    process_env: Dict[str, str],
    root: Path,
    why: str,
) -> EnvRow:
    in_process = name in process_env
    inherited = process_env[name] if in_process else None
    if name in files:
        a = files[name]
        src = Path(a.path)
        loc = f"{relpath(src, root)}:{a.line}"
        return EnvRow(
            key=name,
            value=a.value,
            source=f"file:{loc}",
            empty_override=(a.value == ""),
            inherited=inherited,
            in_file=True,
            in_process=in_process,
            why=why,
        )
    if in_process:
        return EnvRow(
            key=name,
            value=inherited or "",
            source="env",
            empty_override=False,
            inherited=inherited,
            in_file=False,
            in_process=True,
            why=why,
        )
    return EnvRow(
        key=name,
        value="",
        source="unset",
        empty_override=False,
        inherited=None,
        in_file=False,
        in_process=False,
        why=why,
    )


def why_for(name: str, key: str, deferred: Sequence[str]) -> str:
    if name in deferred:
        return "deferred"
    if name == key:
        return "key"
    if name.lower() == key.lower():
        return "case-variant"
    return "related"


def collect_env_rows(
    key: str,
    deferred: Sequence[str],
    files: Dict[str, EnvAssign],
    process_env: Dict[str, str],
    root: Path,
) -> list[EnvRow]:
    names: list[str] = []
    seen = set()

    def add(name: str) -> None:
        if name and name not in seen:
            seen.add(name)
            names.append(name)

    add(key)
    if key.upper() != key:
        add(key.upper())
    if key.lower() != key:
        add(key.lower())
    for name in deferred:
        add(name)

    rows = [env_row(n, files, process_env, root, why_for(n, key, deferred)) for n in names]
    kept: list[EnvRow] = []
    for row in rows:
        if row.key == key:
            kept.append(row)
            continue
        if row.why == "deferred":
            kept.append(row)
            continue
        if row.in_file or row.in_process:
            kept.append(row)
    return kept


def fmt_vals(vals: Sequence[str]) -> str:
    if not vals:
        return "(none)"
    return ", ".join("(empty)" if v == "" else v for v in vals)


def decide_effective(
    declared: list[Hit],
    assigned: list[Hit],
    env_rows: list[EnvRow],
    deferred: Sequence[str],
) -> tuple[Effective, bool]:
    d_comp = comparable_hits(declared)
    a_comp = comparable_hits(assigned)
    d_vals = unique_values(d_comp)
    a_vals = unique_values(a_comp)
    literal_disagree = False
    if d_comp and a_comp:
        for d in d_comp:
            for a in a_comp:
                if not values_equal(d.raw_value or "", a.raw_value or ""):
                    literal_disagree = True
                    break

    deferred_present = [
        r for r in env_rows if r.key in deferred and r.source != "unset"
    ]
    deferred_vals: list[str] = []
    seen_c: list[object] = []
    for r in deferred_present:
        c = canonical(r.value)
        if c not in seen_c:
            seen_c.append(c)
            deferred_vals.append(r.value)

    if literal_disagree:
        reason = f"declared {fmt_vals(d_vals)} vs assigned {fmt_vals(a_vals)}"
        return Effective("unknown", None, reason), True

    if d_comp and a_comp:
        agreed = d_vals[0]
        if deferred_vals and any(not values_equal(v, agreed) for v in deferred_vals):
            return (
                Effective(
                    "unknown",
                    None,
                    f"agreed literal {agreed} vs env {fmt_vals(deferred_vals)}",
                ),
                False,
            )
        return Effective("value", agreed, None), False

    if deferred:
        if len(deferred_vals) > 1:
            return (
                Effective("unknown", None, f"env names disagree ({fmt_vals(deferred_vals)})"),
                False,
            )
        if deferred_present:
            env_val = deferred_vals[0]
            if d_comp or a_comp:
                lit = (d_vals or a_vals)[0]
                if not values_equal(lit, env_val):
                    return (
                        Effective(
                            "unknown",
                            None,
                            f"literal {fmt_vals([lit])} vs env {fmt_vals([env_val])}",
                        ),
                        False,
                    )
                return Effective("value", lit, None), False
            if all(r.empty_override for r in deferred_present):
                names = ", ".join(r.key for r in deferred_present)
                return Effective("empty", "", f"empty override of {names}"), False
            return Effective("value", env_val, None), False
        if declared or assigned:
            return Effective("unknown", None, "sites defer to unset env"), False

    if d_comp and not assigned:
        if len(d_vals) > 1:
            return Effective("unknown", None, f"declared values disagree ({fmt_vals(d_vals)})"), False
        return Effective("value", d_vals[0], None), False
    if a_comp and not declared:
        if len(a_vals) > 1:
            return Effective("unknown", None, f"assigned values disagree ({fmt_vals(a_vals)})"), False
        return Effective("value", a_vals[0], None), False
    if d_comp and assigned and not a_comp:
        return Effective("unknown", None, "assignment not statically comparable"), False
    if a_comp and declared and not d_comp:
        return Effective("unknown", None, "declaration not statically comparable"), False
    if declared or assigned:
        return Effective("unknown", None, "sites found, none statically comparable"), False
    return Effective("unknown", None, "no declaration or assignment sites"), False


def build_effect(
    key: str,
    directory: Path,
    declared: list[Hit],
    assigned: list[Hit],
    comments: list[Hit],
    process_env: Optional[Dict[str, str]] = None,
) -> Effect:
    env = dict(os.environ if process_env is None else process_env)
    files = load_dotenv(directory)
    deferred = extract_deferred(list(declared) + list(assigned))
    rows = collect_env_rows(key, deferred, files, env, directory)
    effective, disagree = decide_effective(declared, assigned, rows, deferred)
    return Effect(
        key=key,
        directory=str(directory.resolve()),
        declared=declared,
        assigned=assigned,
        comments=comments,
        env_source=rows,
        deferred=deferred,
        effective=effective,
        disagree=disagree,
    )


def hit_to_json(h: Hit) -> dict:
    return asdict(h)


def env_to_json(r: EnvRow) -> dict:
    return {
        "key": r.key,
        "value": r.value,
        "source": r.source,
        "empty_override": r.empty_override,
        "inherited": r.inherited,
        "in_file": r.in_file,
        "in_process": r.in_process,
        "why": r.why,
    }


def effect_to_json(rec: Effect) -> dict:
    return {
        "key": rec.key,
        "directory": rec.directory,
        "declared": [hit_to_json(h) for h in rec.declared],
        "assigned": [hit_to_json(h) for h in rec.assigned],
        "comments": [hit_to_json(h) for h in rec.comments],
        "env_source": [env_to_json(r) for r in rec.env_source],
        "deferred": rec.deferred,
        "effective": {
            "status": rec.effective.status,
            "value": rec.effective.value,
            "reason": rec.effective.reason,
        },
        "disagree": rec.disagree,
    }


def fmt_hit(h: Hit) -> str:
    return f"{h.path}:{h.line}\t{h.text}\tvalue={h.display_value()}"


def fmt_env(r: EnvRow) -> str:
    parts = [r.key, r.source]
    if r.source == "unset":
        parts.append(f"why={r.why}")
        return "\t".join(parts)
    shown = r.value if r.value != "" else "(empty)"
    parts.append(f"value={shown}")
    if r.empty_override:
        parts.append("EMPTY_OVERRIDE: yes")
    if r.in_file:
        if r.in_process:
            parts.append(f"INHERITED: {r.inherited}")
        else:
            parts.append("INHERITED: (unset)")
    parts.append(f"why={r.why}")
    return "\t".join(parts)


def print_human(rec: Effect) -> None:
    print(f"KEY: {rec.key}")
    print("DECLARED:")
    code_d = [h for h in rec.declared if not h.in_comment]
    if code_d:
        for h in code_d:
            print(f"  {fmt_hit(h)}")
    else:
        print("  (none)")
    cfg_comments = []
    src_comments = []
    for h in rec.comments:
        suffix = Path(h.path).suffix.lower()
        if suffix in CONFIG_EXTS:
            cfg_comments.append(h)
        else:
            src_comments.append(h)
    for h in cfg_comments:
        print(f"  (comment) {fmt_hit(h)}")
    print("ASSIGNED:")
    if rec.assigned:
        for h in rec.assigned:
            print(f"  {fmt_hit(h)}")
    else:
        print("  (none)")
    for h in src_comments:
        print(f"  (comment) {fmt_hit(h)}")
    print("ENV_SOURCE:")
    if rec.env_source:
        for r in rec.env_source:
            print(f"  {fmt_env(r)}")
    else:
        print("  (none)")
    print("EFFECTIVE:")
    eff = rec.effective
    if eff.status == "unknown":
        extra = f"\t{eff.reason}" if eff.reason else ""
        print(f"  unknown{extra}")
    elif eff.status == "empty":
        extra = f"\t{eff.reason}" if eff.reason else ""
        print(f"  (empty){extra}")
    else:
        extra = f"\t{eff.reason}" if eff.reason else ""
        print(f"  {eff.value}{extra}")


def parse_args(argv: list[str]) -> tuple[str, Path, bool]:
    json_mode = False
    positional: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            print(USAGE)
            print(
                "One record for KEY: DECLARED (config), ASSIGNED (source), "
                "ENV_SOURCE (dotenv/process, including deferred names), EFFECTIVE."
            )
            raise SystemExit(0)
        if arg == "--json":
            json_mode = True
            i += 1
            continue
        if arg.startswith("-"):
            print(f"effect: unknown option {arg}", file=sys.stderr)
            print(USAGE, file=sys.stderr)
            raise SystemExit(1)
        positional.append(arg)
        i += 1
    if not positional:
        print("effect: missing KEY", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        raise SystemExit(1)
    if len(positional) > 2:
        print("effect: too many arguments", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        raise SystemExit(1)
    key = positional[0]
    if not key.strip():
        print("effect: empty KEY", file=sys.stderr)
        raise SystemExit(1)
    directory = Path(positional[1]) if len(positional) == 2 else Path(".")
    if not directory.exists():
        print(f"effect: directory not found: {directory}", file=sys.stderr)
        raise SystemExit(1)
    if not directory.is_dir():
        print(f"effect: not a directory: {directory}", file=sys.stderr)
        raise SystemExit(1)
    return key, directory, json_mode


def exit_code(rec: Effect) -> int:
    return 2 if rec.disagree else 0


def main(argv: list[str] | None = None) -> int:
    key, directory, json_mode = parse_args(argv if argv is not None else sys.argv[1:])
    declared, assigned, comments = scan(directory, key)
    rec = build_effect(key, directory, declared, assigned, comments)
    if json_mode:
        json.dump(effect_to_json(rec), sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        print_human(rec)
    return exit_code(rec)


if __name__ == "__main__":
    raise SystemExit(main())
