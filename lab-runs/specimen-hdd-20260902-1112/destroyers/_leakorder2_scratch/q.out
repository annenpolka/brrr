file  q.py
order test_a,test_b  test_a=PASS test_b=FAIL  leftover={'q.queue': "deque(['a'])", 'q.unfinished_tasks': 1}
order test_b,test_a  test_b=PASS test_a=PASS  leftover={'q.queue': "deque(['a'])", 'q.unfinished_tasks': 1}
