# Handwritten both-done rec. Caller module keys are ignored; loadgroup regroups
# to two completed-only units. Not the harvest hang (test_1 done, test_2 open).
collection	testing/test_timeout.py::test_1	testing/test_timeout.py::test_2
unit	testing/test_timeout.py	testing/test_timeout.py::test_1	done
unit	testing/test_timeout.py	testing/test_timeout.py::test_2	done
