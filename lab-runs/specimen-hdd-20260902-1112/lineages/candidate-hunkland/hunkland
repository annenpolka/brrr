#!/usr/bin/env python3
"""hunkland: compare where an insert landed with the hunk header's named line."""

from __future__ import annotations

import argparse
import difflib
import importlib.machinery
import importlib.util
import re
import sys
from pathlib import Path


HUNK_RE = re.compile(
    r"@@\s+-(\d+)(?:,(\d+))?\s+\+(\d+)(?:,(\d+))?\s+@@"
)


def parse_hunk(text: str) -> tuple[int, int, int, int]:
    match = HUNK_RE.search(text)
    if match is None:
        raise ValueError(f"no unified-diff hunk header in {text!r}")
    old_start = int(match.group(1))
    old_count = 1 if match.group(2) is None else int(match.group(2))
    new_start = int(match.group(3))
    new_count = 1 if match.group(4) is None else int(match.group(4))
    return old_start, old_count, new_start, new_count


def split_lines(text: str) -> list[str]:
    if text == "":
        return []
    return text.splitlines(keepends=True)


def find_lands(orig: str, result: str) -> list[int]:
    old_lines = split_lines(orig)
    new_lines = split_lines(result)
    matcher = difflib.SequenceMatcher(a=old_lines, b=new_lines, autojunk=False)
    lands: list[int] = []
    for tag, _i1, _i2, j1, j2 in matcher.get_opcodes():
        if tag in ("insert", "replace"):
            lands.extend(range(j1 + 1, j2 + 1))
    return lands


def line_at(text: str, n: int | None) -> str:
    if n is None or n < 1:
        return "none"
    lines = split_lines(text)
    if n > len(lines):
        return "none"
    return lines[n - 1].rstrip("\n")


def verdict_for(land: int | None, match: bool, apply_exit: int) -> str:
    if land is None:
        return "no-insert"
    if apply_exit != 0:
        return "apply-failed"
    if match:
        return "aligned"
    return "mis-indexed"


def inspect(
    orig: str,
    result: str,
    hunk: str,
    apply_exit: int = 0,
) -> dict:
    old_start, old_count, header, _new_count = parse_hunk(hunk)
    lands = find_lands(orig, result)
    land: int | None = lands[0] if lands else None
    match = land == header
    return {
        "hunk": hunk.strip(),
        "old_start": old_start,
        "old_count": old_count,
        "header": header,
        "header_line": line_at(result, header),
        "land": land,
        "land_line": line_at(result, land),
        "apply_exit": apply_exit,
        "match": match,
        "verdict": verdict_for(land, match, apply_exit),
    }


def fmt_land(land: int | None) -> str:
    return "none" if land is None else str(land)


def format_report(result: dict) -> str:
    lines = [
        f"header\t{result['header']}",
        f"header_line\t{result['header_line']}",
        f"land\t{fmt_land(result['land'])}",
        f"land_line\t{result['land_line']}",
        f"apply_exit\t{result['apply_exit']}",
        f"match\t{'yes' if result['match'] else 'no'}",
        f"verdict\t{result['verdict']}",
    ]
    return "\n".join(lines) + "\n"


def load_apply_hunk(path: Path):
    loader = importlib.machinery.SourceFileLoader("hunkland_applier", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise ValueError(f"cannot load applier {path}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    fn = getattr(mod, "apply_hunk", None)
    if not callable(fn):
        raise ValueError(f"no apply_hunk() in {path}")
    return fn


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="hunkland",
        description=(
            "Compare where a patch insert landed with the line the hunk "
            "header named. Apply exit 0 can still be match no."
        ),
    )
    parser.add_argument("orig", metavar="ORIG", help="original file")
    parser.add_argument(
        "result",
        metavar="RESULT",
        nargs="?",
        help="applied result file (omit when using --applier)",
    )
    parser.add_argument(
        "--hunk",
        required=True,
        help="unified-diff hunk header, e.g. '@@ -2,0 +3 @@'",
    )
    parser.add_argument(
        "--applier",
        metavar="PATH",
        help="Python module with apply_hunk(text, old_start, old_count, insert)",
    )
    parser.add_argument(
        "--insert",
        default="inserted",
        help="inserted text when using --applier (default: inserted)",
    )
    parser.add_argument(
        "--apply-exit",
        type=int,
        default=0,
        metavar="N",
        help="apply process exit (default 0)",
    )
    return parser.parse_args(argv)


def applied_result(args: argparse.Namespace, orig: str) -> str:
    if args.applier is not None and args.result is not None:
        raise ValueError("pass RESULT or --applier, not both")
    if args.applier is not None:
        apply_hunk = load_apply_hunk(Path(args.applier))
        old_start, old_count, _header, _new_count = parse_hunk(args.hunk)
        return apply_hunk(orig, old_start, old_count, args.insert)
    if args.result is None:
        raise ValueError("RESULT file required unless --applier is set")
    return read_text(Path(args.result))


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    orig_path = Path(args.orig)
    try:
        orig = read_text(orig_path)
        result = applied_result(args, orig)
        report = inspect(orig, result, args.hunk, apply_exit=args.apply_exit)
    except (OSError, TypeError) as err:
        print(f"hunkland: {err}", file=sys.stderr)
        return 1
    except ValueError as err:
        print(f"hunkland: {err}", file=sys.stderr)
        return 2
    sys.stdout.write(format_report(report))
    return 0


if __name__ == "__main__":
    sys.exit(main())
