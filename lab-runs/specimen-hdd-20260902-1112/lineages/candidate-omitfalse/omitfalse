#!/usr/bin/env python3
"""omitfalse: name which encoding omitted a false key vs kept it."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


def load_obj(path: str) -> dict:
    text = Path(path).read_text(encoding="utf-8")
    obj = json.loads(text)
    if not isinstance(obj, dict):
        raise ValueError(f"{path}: expected a JSON object")
    return obj


def inspect(left: dict, right: dict, key: str, missing_as: str) -> dict:
    l_has = key in left
    r_has = key in right
    omitted = []
    if not l_has and r_has:
        omitted.append("a")
    if l_has and not r_has:
        omitted.append("b")
    if not l_has and not r_has:
        omitted.append("both")
    return {
        "key": key,
        "a_has": l_has,
        "a_value": left.get(key, "missing"),
        "b_has": r_has,
        "b_value": right.get(key, "missing"),
        "omitted": omitted,
        "downstream_missing": missing_as,
        "disagree": l_has != r_has,
    }


def fmt_val(value) -> str:
    if value == "missing":
        return "missing"
    if value is False:
        return "false"
    if value is True:
        return "true"
    if value is None:
        return "null"
    return json.dumps(value, ensure_ascii=False)


def format_report(result: dict) -> str:
    omitted = "\t".join(result["omitted"]) if result["omitted"] else "none"
    lines = [
        f"key\t{result['key']}",
        f"a_has\t{'yes' if result['a_has'] else 'no'}",
        f"a_value\t{fmt_val(result['a_value'])}",
        f"b_has\t{'yes' if result['b_has'] else 'no'}",
        f"b_value\t{fmt_val(result['b_value'])}",
        f"omitted\t{omitted}",
        f"downstream_missing\t{result['downstream_missing']}",
        f"disagree\t{'yes' if result['disagree'] else 'no'}",
    ]
    return "\n".join(lines) + "\n"


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="omitfalse",
        description=(
            "Compare two JSON objects. Name which encoding omitted a key "
            "(typically false) and what missing means downstream."
        ),
    )
    parser.add_argument("first")
    parser.add_argument("second")
    parser.add_argument("--key", default="flag")
    parser.add_argument("--missing-as", default="true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    try:
        left = load_obj(args.first)
        right = load_obj(args.second)
        result = inspect(left, right, args.key, args.missing_as)
    except (OSError, ValueError, json.JSONDecodeError) as err:
        print(f"omitfalse: {err}", file=sys.stderr)
        return 1
    sys.stdout.write(format_report(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
