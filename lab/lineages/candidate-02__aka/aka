GENERATED_RE = re.compile(
    r"(?:^|/)(?:.*\.(?:generated|gen|min)|.*_generated|.*Generated|.*_pb2)(?:\.[^/]+)?$",
    re.IGNORECASE,
)

# Quoted strings. Single-quoted skip the common rust/char case of len 1 later.
STRING_RE = re.compile(
    r"""(?P<dq>"(?:\\.|[^"\\])*")|(?P<sq>'(?:\\.|[^'\\])*')"""
)

# --kebab-flag or --camelFlag
FLAG_RE = re.compile(r"--([A-Za-z][A-Za-z0-9_-]{1,})")

# YAML-ish keys at the start of a line (indent ok).
YAML_KEY_RE = re.compile(
    r"^[ \t]{0,16}(?P<key>[A-Za-z_][A-Za-z0-9_-]{1,64})[ \t]*:",
    re.MULTILINE,
)

IDENT_RE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_]{1,64})\b")

CAMEL_RE = re.compile(r"^[a-z]+[A-Z][A-Za-z0-9]+$")
PASCAL_RE = re.compile(r"^[A-Z][a-z0-9]+[A-Z][A-Za-z0-9]+$")
SNAKE_RE = re.compile(r"^[a-z][a-z0-9]*_[a-z0-9_]+$")
CONST_RE = re.compile(r"^[A-Z][A-Z0-9]*_[A-Z0-9_]+$")
KEBAB_RE = re.compile(r"^[a-z][a-z0-9]*-[a-z0-9-]+$")
DOTTED_RE = re.compile(r"^[A-Za-z][A-Za-z0-9]*\.[A-Za-z0-9._-]+$")

SPLIT_CAMEL_1 = re.compile(r"([a-z0-9])([A-Z])")
SPLIT_CAMEL_2 = re.compile(r"([A-Z]+)([A-Z][a-z])")
SEP_RE = re.compile(r"[_\-./:]+")

