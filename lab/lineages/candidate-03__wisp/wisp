    re.compile(r"^\s*impl(?:\s*<[^>]*>)?\s+(?:[A-Za-z_][A-Za-z0-9_:]*\s+for\s+)?([A-Za-z_][A-Za-z0-9_]*)"),
]
RE_PY = [
    re.compile(r"^\s*(?:async\s+)?def\s+(?:self\.)?([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*class\s+([A-Za-z_][A-Za-z0-9_]*)"),
]
RE_RB = [
    re.compile(r"^\s*def\s+(?:self\.)?([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*class\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*module\s+([A-Za-z_][A-Za-z0-9_]*)"),
]
RE_JS = [
    re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?function\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:abstract\s+)?class\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*(?:export\s+)?(?:type|interface|enum|namespace)\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(
        r"^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"
        r"(?:async\s+)?(?:function\b|\()"
    ),
]
RE_GO = [
    re.compile(r"^\s*func\s+(?:\([^)]*\)\s+)?([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*type\s+([A-Za-z_][A-Za-z0-9_]*)"),
]
RE_SWIFT = [
    re.compile(
        r"^\s*(?:public\s+|private\s+|internal\s+|fileprivate\s+|open\s+)?"
        r"(?:override\s+)?(?:mutating\s+)?"
        r"(?:func|class|struct|enum|protocol|actor|typealias)\s+"
        r"([A-Za-z_][A-Za-z0-9_]*)"
    ),
]
RE_KT = [
    re.compile(
        r"^\s*(?:public\s+|private\s+|internal\s+|protected\s+)?"
        r"(?:override\s+)?(?:fun|class|object|interface|enum)\s+([A-Za-z_][A-Za-z0-9_]*)"
    ),
]
RE_SH = [
    re.compile(r"^\s*(?:function\s+([A-Za-z_][A-Za-z0-9_]*)|(?:function\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*\(\))"),
]
RE_PKL = [
    re.compile(r"^\s*(?:abstract\s+)?class\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*typealias\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*function\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"^\s*module\s+([A-Za-z_][A-Za-z0-9_]*)"),
]
# Conservative fallback: keywords, never JS let/const or shell name().
RE_FALLBACK = RE_RUST + RE_PY + RE_GO + RE_SWIFT

EXT_RES: dict[str, list[re.Pattern[str]]] = {}
for _ext, _res in (
    ((".rs",), RE_RUST),
    ((".py",), RE_PY),
    ((".rb",), RE_RB),
    ((".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".vue", ".svelte"), RE_JS),
    ((".go",), RE_GO),
    ((".swift",), RE_SWIFT),
    ((".kt", ".kts"), RE_KT),
    ((".sh", ".bash", ".zsh"), RE_SH),
    ((".pkl",), RE_PKL),
):
    for _e in _ext:
        EXT_RES[_e] = _res

# `use foo as bar` / `app_with_files as fake_app` — living aliases, not ghosts.
