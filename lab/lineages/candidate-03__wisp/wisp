# Python 3 \w is Unicode-aware; reject leading digits.
IDENT_RE = re.compile(r"[^\W\d][\w]*", re.UNICODE)

RE_RUST = [
    re.compile(
        r"^\s*(?:pub(?:\([^)]*\))?\s+)?"
        r"(?:async\s+)?(?:unsafe\s+)?(?:const\s+)?"
        r"(?:extern\s+(?:\"[^\"]+\"\s+)?)?"
        r"(?:fn|struct|enum|trait|type|mod)\s+([A-Za-z_][A-Za-z0-9_]*)"
