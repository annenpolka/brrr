def self_test() -> int:
    failures: list[str] = []

    def expect(cond: bool, msg: str) -> None:
        if not cond:
            failures.append(msg)

    with tempfile.TemporaryDirectory(prefix="haunt-selftest-") as tmp:
        build_fixture(tmp)
        ns = argparse.Namespace(
            repo=tmp,
            range=None,
            max_commits=0,
            since=None,
            until=None,
            verbose=False,
            kind="all",
            keep_obituary=False,
        )
        deaths = collect_deaths(tmp, None, 0, None, None, False)
        names = {(d.kind, d.name) for d in deaths}
        expect(("fn", "parse_legacy_widget") in names, f"missing fn death, got {names}")
        expect(("flag", "legacy-widget") in names, f"missing flag death, got {names}")
        expect(any(d.kind == "file" and d.name.endswith("deploy_legacy.sh") for d in deaths), "missing file death")
        expect(("fn", "keep_forever") in names, "missing renamed fn death")
        expect(("enum", "WatcherHealth") in names, f"missing enum death, got {names}")
        expect(("fn", "fake_app") in names, "missing fake_app death")
        expect(("fn", "only_in_plan_helper") in names, "missing plan-only fn death")

        idx = build_head_index(tmp, deaths, False)
        findings = classify(deaths, idx, keep_obituary=False)
        haunts = {(f.death.kind, f.death.name): f for f in findings if f.status == "HAUNT"}
        archives = {(f.death.kind, f.death.name) for f in findings if f.status == "ARCHIVE"}
        moves = {(f.death.kind, f.death.name) for f in findings if f.status == "MOVE"}
        deads = {(f.death.kind, f.death.name) for f in findings if f.status == "DEAD"}

        expect(("fn", "parse_legacy_widget") in haunts, f"parse_legacy_widget should HAUNT, haunts={set(haunts)}")
        f = haunts.get(("fn", "parse_legacy_widget"))
        if f:
            kinds = {r.kind for r in f.remnants}
            expect("docs" in kinds, f"expected docs remnant, got {[(r.kind, r.path) for r in f.remnants]}")
            expect("obituary" not in kinds, f"changelog leaked: {f.remnants}")

        expect(("flag", "legacy-widget") in haunts, "flag should HAUNT via README")
        expect(
            any(k == "file" and n.endswith("deploy_legacy.sh") for (k, n) in haunts),
            f"deleted script path should HAUNT, haunts={set(haunts)}",
        )
        expect(("fn", "keep_forever") in deads or ("fn", "keep_forever") not in haunts, "renamed keep_forever should not HAUNT")
        expect(("fn", "parse_ok") not in haunts, "living parse_ok should not haunt")

        expect(("enum", "WatcherHealth") in moves, f"kind-shift enum→struct should MOVE, moves={moves}")
        expect(("fn", "fake_app") in moves, f"import alias should MOVE, moves={moves}")
        expect(("fn", "only_in_plan_helper") in archives, f"plan-only mention should ARCHIVE, archives={archives}")
        expect(("fn", "predicateRejected") not in haunts, "homonym local must not HAUNT")
        expect(
            any(k == "file" and n.endswith("gone/SKILL.md") for (k, n) in haunts),
            f"full path gone/SKILL.md should HAUNT via docs/refs.md, haunts={set(haunts)}",
        )
        expect(
            not any(k == "file" and n.endswith("gone/init.sh") for (k, n) in haunts),
            "generic basename init.sh must not HAUNT sibling keep/init.sh",
        )
        expect(("flag", "keep-me") not in haunts, "live flag --keep-me must not HAUNT")
        expect(
            not any(k == "file" and n.endswith("moved.md") for (k, n) in haunts),
            "rename destination docs/moved.md must not count as leftover of moved.md",
        )

        # --keep-obituary should surface changelog
        findings2 = classify(deaths, idx, keep_obituary=True)
        f2 = next(f for f in findings2 if f.death.name == "parse_legacy_widget" and f.death.kind == "fn")
        expect(any(r.kind == "obituary" for r in f2.remnants), "keep-obituary should count CHANGELOG")

        birth = run_git(tmp, ["rev-list", "--max-parents=0", "HEAD"]).stdout.strip().split()[0]
        deaths_range = collect_deaths(tmp, birth, 1, None, None, False)
        expect(len(deaths_range) == 0, f"birth commit should have 0 deaths, got {deaths_range}")

    if failures:
        eprint("self-test FAILED:")
        for msg in failures:
            eprint("  -", msg)
        return 1
    eprint("self-test ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    if args.self_test:
        return self_test()
    findings, err = scan(args)
    if err:
        return err
    emit(findings, args)
    haunts = [f for f in findings if f.status == "HAUNT"]
    if args.verbose:
        eprint(
            f"{len(haunts)} haunts, "
            f"{sum(1 for f in findings if f.status=='ARCHIVE')} archival, "
            f"{sum(1 for f in findings if f.status=='DEAD')} dead, "
            f"{sum(1 for f in findings if f.status=='MOVE')} moves"
        )
    if args.strict and haunts:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
