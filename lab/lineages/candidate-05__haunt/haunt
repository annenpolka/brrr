#!/usr/bin/env python3
"""haunt — find names that died in git history but still speak in the living tree.

Dead-code tools find living symbols with no references. haunt is the inverse:
it mines deletions (definitions, paths, flags) and reports remnants that
survived — docs, tests, CI, comments — after the definition is gone.

    haunt                 # scan current branch
    haunt main..HEAD      # names that died in this range
    haunt --json          # machine output
    haunt --strict        # exit 1 if any HAUNT remains
"""
