    )

    hom = Fact(
        "rename",
        "threshold",
        "threshold",
        "absentThreshold",
        Origin("PresenceArbiter.swift", 11, "threshold: Double = 0.4"),
    )
    check(
        "homonym different binding",
        is_homonym_binding(hom, "private let threshold: Double = 0.7"),
    )
    check(
        "not homonym same leftover value",
        not is_homonym_binding(
            Fact("value", "threshold", "0.4", "0.45", Origin("a.swift", 1, "x")),
            "threshold: Double = 0.4",
        ),
    )

    return 1 if failures else 0


def main(argv: Sequence[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in {"self-test", "--self-test"}:
        return cmd_self_test()
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.version:
        print(f"zanei {VERSION}")
        return 0

    root = Path(args.root).resolve()
    if not root.exists():
        die(f"root not found: {root}")

    kinds = parse_kinds(args.kinds)
    diff_text, frm, to = obtain_diff(root, args)
    files = parse_unified_diff(diff_text)
    facts = extract_facts(files, kinds)

    if args.facts_only:
        if args.json:
            print_json([], facts, frm=frm, to=to, root=root)
        else:
            print(f"zanei: {len(facts)} fact(s)  {frm} → {to}")
            for fa in facts:
                print(
                    f"  {fa.kind:<8} {fa.name}: {fa.old!r} → {fa.new!r}  ({fa.origin.path}:{fa.origin.line})"
                )
        return 0

    search_rev: str | None
    if to in {"worktree", "index", "diff"}:
        search_rev = None
    else:
        search_rev = to

    findings = scan(
        root,
        search_rev,
        facts,
        min_score=args.min_score,
        changed_new_lines=changed_new_lines(files),
    )

    if args.json:
        print_json(findings, facts, frm=frm, to=to, root=root)
    elif args.tsv:
        print_tsv(findings)
    else:
        print_human(
            findings,
            facts,
            frm=frm,
            to=to,
            root=root,
            explain=args.explain,
            color=color_enabled(args, sys.stdout),
        )
    return 1 if findings else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
