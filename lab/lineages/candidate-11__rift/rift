def _self_check(cond: bool, msg: str) -> None:
    if not cond:
        raise AssertionError(msg)


def self_test() -> None:
    files = parse_unified_diff(DIFF_DEF_A)
    _self_check(len(files) == 1, "parse one file")
    _self_check(files[0].path == "src/parse.rs", files[0].path)
    _self_check(files[0].lines[0][0] == "-", "minus line")
    _self_check("parse_config" in files[0].lines[0][2], "old ident")

    weird = parse_unified_diff(DIFF_WEIRD_A)
    _self_check(len(weird) == 1, "weird file parsed")
    _self_check("weird file-" in weird[0].path, weird[0].path)
    _self_check("文" in weird[0].path, f"unicode in path: {weird[0].path!r}")

    kwargs = dict(
        allow_common=False,
        extra_ignore=(),
        no_ignore=False,
        strict=False,
        kinds=KINDS_DEFAULT,
        hidden_only=False,
    )

    r = analyze_diffs(
        DIFF_DEF_A, DIFF_USE_B, textual=(), merge_clean=True,
        a_label="A", b_label="B", base="base", one_sided=False, **kwargs,
    )
    _self_check(len(r.rifts) == 1, f"def-use count {r.rifts}")
    _self_check(r.rifts[0].ident == "parse_config", r.rifts[0].ident)
    _self_check(r.rifts[0].kind == "def-use", r.rifts[0].kind)
    _self_check(r.rifts[0].hidden is True, "hidden when merge clean")

    r = analyze_diffs(
        DIFF_DELETE_A, DIFF_NEW_USE_B, textual=(), merge_clean=True,
        a_label="A", b_label="B", base="base", one_sided=False, **kwargs,
    )
    _self_check(any(x.kind == "delete-use" and x.ident == "parse_config" for x in r.rifts),
                f"delete-use: {r.rifts}")

    r = analyze_diffs(
        DIFF_UNRELATED_A, DIFF_UNRELATED_B, textual=(), merge_clean=True,
        a_label="A", b_label="B", base="base", one_sided=False, **kwargs,
    )
