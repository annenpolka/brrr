IDENT_RE = re.compile(r"\b[A-Za-z_][A-Za-z0-9_]*\b")
HUNK_RE = re.compile(
    r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@(.*)$"
)

# Keywords that introduce a definition of the following identifier.
INTRO_RE = re.compile(
    r"""
    \b(
        fn | func | function | def | class | struct | enum | trait |
        interface | protocol | type | typedef | record | actor |
        extension | module | namespace | object | union | newtype |
        macro_rules!?
    )\b
    (?:\s*<[^>]*>)?
    \s+
    ([A-Za-z_][A-Za-z0-9_]*)
    """,
    re.VERBOSE,
)
IMPL_RE = re.compile(
    r"""
    \bimpl\b
    (?:\s*<[^>]*>)?
    \s+
    (?:([A-Za-z_][A-Za-z0-9_]*)\s+for\s+)?
    ([A-Za-z_][A-Za-z0-9_]*)
    """,
    re.VERBOSE,
)
BINDING_RE = re.compile(
    r"""
    \b(?:export\s+)?(?:declare\s+)?(?:pub\s+)?(?:static\s+)?
    (?:const | let | var | val)\s+
    ([A-Za-z_][A-Za-z0-9_]*)
    """,
    re.VERBOSE,
)

COMMENT_LINE_RE = re.compile(
    r"""^\s*(//|/\*|\* |#|-- |<!--|\{/\*)"""
)
# Git funcname headers often name the enclosing type (class/struct). Those
# are not signature changes. Only treat callable intros as touched defs.
