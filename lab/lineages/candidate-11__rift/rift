def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="rift",
        description=(
            "Detect identifier-level conflicts that a clean git merge would hide. "
            "Compares two changesets (two revs vs their merge-base, a merge commit, "
            "or two unified diffs) and reports crossed definition/use edits."
        ),
        epilog="Exit 0 if no rifts, 1 if rifts exist, 2 on usage/git error.",
    )
    p.add_argument("revs", nargs="*", help="A, B, or A...B  (B defaults to HEAD)")
    p.add_argument("-C", "--repo", default=None, help="git -C directory")
    p.add_argument("--merge", metavar="COMMIT", help="audit a merge commit's two parents")
    p.add_argument("--diffs", nargs=2, metavar=("A.diff", "B.diff"),
                   help="compare two unified-diff files (no git required)")
    p.add_argument("--audit", nargs="?", const="20", metavar="N",
                   help="scan the last N merge commits (default 20)")
    p.add_argument("-o", "--format", choices=("text", "json", "tsv"), default="text")
    p.add_argument("-q", "--quiet", action="store_true", help="no stdout; exit status only")
    p.add_argument("--all", action="store_true", help="include use-use rifts")
    p.add_argument("--common", action="store_true", help="do not filter generic identifiers")
    p.add_argument("--strict", action="store_true",
                   help="only count definition lines in +/- hunks, not hunk headers")
    p.add_argument("--also-text", action="store_true",
                   help="include rifts that git merge-tree already flags as textual conflicts")
    p.add_argument("--ignore", action="append", default=[], metavar="GLOB",
                   help="extra path ignore glob (repeatable)")
    p.add_argument("--no-ignore", action="store_true", help="do not ignore lock/docs/vendor paths")
    p.add_argument("--no-snippets", action="store_true")
    p.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    p.add_argument("--self-test", action="store_true")
    p.add_argument("--version", action="version", version=f"rift {__version__}")
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.self_test:
        try:
            self_test()
        except AssertionError as e:
            sys.stderr.write(f"rift --self-test FAILED: {e}\n")
            return 2
        return 0

    kinds = KINDS_DEFAULT + (("use-use",) if args.all else ())
    analyze_kwargs = dict(
        allow_common=args.common,
        extra_ignore=tuple(args.ignore),
        no_ignore=args.no_ignore,
        strict=args.strict,
        kinds=kinds,
        hidden_only=not args.also_text,
    )
    color = color_enabled(args.color)
    snippets = not args.no_snippets
    cwd = args.repo

    try:
        if args.diffs:
            with open(args.diffs[0], encoding="utf-8", errors="surrogateescape") as f:
                diff_a = f.read()
            with open(args.diffs[1], encoding="utf-8", errors="surrogateescape") as f:
                diff_b = f.read()
            report = analyze_diffs(
                diff_a, diff_b, textual=(), merge_clean=None,
                a_label=args.diffs[0], b_label=args.diffs[1],
                base=None, one_sided=False,
                a_name=args.diffs[0], b_name=args.diffs[1],
                **analyze_kwargs,
            )
        elif args.audit is not None:
            n = int(args.audit)
            return run_audit(
                cwd, n, analyze_kwargs,
                fmt=args.format, color=color, snippets=snippets, quiet=args.quiet,
            )
        else:
            if args.merge:
                body = git_text(["rev-parse", args.merge], cwd=cwd).strip()
                parents = git_text(["rev-parse", f"{body}^1", f"{body}^2"], cwd=cwd).split()
                if len(parents) < 2:
                    sys.stderr.write("rift: --merge commit is not a merge\n")
                    return 2
                rev_a, rev_b = parents[0], parents[1]
            else:
                revs = list(args.revs)
                if len(revs) == 1 and parse_range_token(revs[0]):
                    rev_a, rev_b = parse_range_token(revs[0])  # type: ignore[misc]
                elif len(revs) == 1:
                    rev_a, rev_b = revs[0], "HEAD"
                elif len(revs) == 2:
                    rev_a, rev_b = revs[0], revs[1]
                elif len(revs) == 0:
                    sys.stderr.write("rift: need A [B], A...B, --merge, --diffs, or --audit\n")
                    return 2
                else:
                    sys.stderr.write("rift: too many revision arguments\n")
                    return 2
            a, b, base, one_sided = resolve_revs(rev_a, rev_b, cwd)
            if one_sided:
                report = Report(
                    a=a, b=b, base=base, textual_conflicts=[],
                    merge_clean=True, one_sided=True, rifts=[],
                    a_name=rev_a, b_name=rev_b,
                )
            else:
                left = base or a
                diff_a = collect_diff(left, a, cwd)
                diff_b = collect_diff(left, b, cwd)
                clean, textual = merge_tree_conflicts(a, b, cwd)
                report = analyze_diffs(
                    diff_a, diff_b, textual=textual, merge_clean=clean,
                    a_label=a, b_label=b, base=base, one_sided=False,
                    a_name=rev_a, b_name=rev_b,
                    **analyze_kwargs,
                )
    except GitError as e:
        sys.stderr.write(f"rift: {e}\n")
        return 2
    except OSError as e:
        sys.stderr.write(f"rift: {e}\n")
        return 2

    if not args.quiet:
        if args.format == "json":
            sys.stdout.write(format_json(report))
        elif args.format == "tsv":
            sys.stdout.write(format_tsv(report))
        else:
            sys.stdout.write(format_text(report, color=color, snippets=snippets))

    if report.one_sided:
        return 0
    return 1 if report.rifts else 0


if __name__ == "__main__":
    sys.exit(main())
