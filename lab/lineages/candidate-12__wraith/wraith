# Definition extractors. First matching group is the name.
DEF_LINE_PATTERNS = [
    re.compile(rf"^\s*(?:{VIS})*(?:async\s+|unsafe\s+|const\s+)*fn\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*(?:async\s+)?function\*?\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:async\s+)?def\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*class\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*struct\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*enum\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*interface\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*trait\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*type\s+({IDENT})\s*[=<]"),
    re.compile(rf"^\s*(?:{VIS})*protocol\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*actor\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*extension\s+({IDENT})\b"),
    re.compile(rf"^\s*macro_rules!\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*mod\s+({IDENT})\b"),
    re.compile(rf"^\s*(?:{VIS})*func\s+(?:\([^)]*\)\s*)?({IDENT})\b"),
    re.compile(
        rf"^\s*(?:{VIS})*(?:const|let|var)\s+({IDENT})\s*=\s*(?:async\s*)?(?:function\b|\(|\{{)"
    ),
    re.compile(rf"^\s*export\s+(?:const|let|var)\s+({IDENT})\b"),
    re.compile(rf"^\s*pub(?:\([^)]*\))?\s+const\s+({IDENT})\b"),
    re.compile(
        rf"^\s*export\s+(?:default\s+)?(?:const|let|var|class|type|interface|enum|function)\s+({IDENT})\b"
    ),
    re.compile(rf"^\s*#define\s+({IDENT})\b"),
]

LOOSE_DEF_RE_CACHE: dict[str, re.Pattern[str]] = {}
_CAMEL_SPLIT = re.compile(r"[A-Z]?[a-z]+|[A-Z]+(?![a-z])|[0-9]+")
AS_ALIAS = re.compile(rf"\bas\s+({IDENT})\b")


