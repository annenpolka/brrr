        encoding="utf-8",
    )
    (root / "src" / "auth" / "legacy_jwt_helper.py").write_text(
        "def decode_legacy_jwt(token):\n    return token\n\n",
        encoding="utf-8",
    )
    (root / "src" / "weird name (copy).py").write_text(
        "def loadLegacyToken(raw):\n    return raw.strip()\n\n",
        encoding="utf-8",
    )
    (root / "Makefile").write_text(
        "retry:\n\tpython -c 'from src.retry import retry_with_backoff; retry_with_backoff(lambda: 1)'\n",
        encoding="utf-8",
    )
    (root / "README.md").write_text(
        "# demo\n\nTalks to UserService and retry_with_backoff.\n",
        encoding="utf-8",
    )
    (root / "docker-compose.yml").write_text(
        "services:\n  api:\n    volumes:\n      - ./src/auth/legacy_jwt_helper.py:/app/jwt.py\n",
        encoding="utf-8",
