    run(["git", "add", "."])
    run(["git", "commit", "-q", "-m", "initial: retry, UserService, jwt helper, weird file"])

    # Rename UserService -> AccountService, delete the rest, leave leftovers.
    (root / "src" / "users.py").write_text(
        "class AccountService:\n    def load(self):\n        return []\n\n",
        encoding="utf-8",
    )
    (root / "src" / "ops.py").write_text(
        'def apply(op):\n    if op == "scale-fixed-critical":\n        return 1\n    return 0\n',
        encoding="utf-8",
    )
    (root / "src" / "test_helpers.py").write_text(
        "from src.helpers import app_with_files as fake_app\n\n"
        "def test_it():\n    assert fake_app([]) == []  # fake_app still bound\n",
        encoding="utf-8",
    )
    (root / "src" / "retry.py").unlink()
    (root / "src" / "auth" / "legacy_jwt_helper.py").unlink()
    (root / "src" / "weird name (copy).py").unlink()
    run(["git", "add", "-A"])
    run(["git", "commit", "-q", "-m", "delete retry/jwt/weird; rename UserService to AccountService"])


def self_test() -> int:
    with tempfile.TemporaryDirectory(prefix="wraith-selftest-") as td:
        root = Path(td)
        build_self_test_repo(root)
        result = scan(
            str(root),
            old=None,
            new=None,
            max_commits=50,
            since=None,
            range_spec=None,
            include_code=False,
            names_filter=None,
        )
        found = {h.name for h in result.holdouts}
        groups = {
            "retry": {"retry_with_backoff"},
            "user": {"UserService"},
            "jwt": {
                "legacy_jwt_helper",
                "legacy_jwt_helper.py",
                "src/auth/legacy_jwt_helper.py",
            },
            "legacy-token": {"loadLegacyToken"},
            "weird-file": {
                "src/weird name (copy).py",
                "weird name (copy).py",
                "weird name (copy)",
            },
        }
        print(f"self-test repo: {root}")
        print(f"holdout names: {sorted(found)}")
        missing_groups = [g for g, names in groups.items() if not (found & names)]
        if missing_groups:
            print(f"MISSING holdout groups: {missing_groups}", file=sys.stderr)
            print(format_human(result, C(False), show_all_mentions=True))
            return 1
        jwt_aliases = found & groups["jwt"]
        if len(jwt_aliases) != 1:
            print(f"path-identity collapse failed: {sorted(jwt_aliases)}", file=sys.stderr)
            return 1
        retry = next(h for h in result.holdouts if h.name == "retry_with_backoff")
        surfaces = {m.surface for m in retry.mentions}
        if "retry-with-backoff" not in surfaces:
            print("missing kebab-case variant mention retry-with-backoff", file=sys.stderr)
            print(format_human(result, C(False), show_all_mentions=True))
            return 1
        makefile_hits = [m for m in retry.mentions if m.path == "Makefile"]
        if len(makefile_hits) != 1:
            print(f"expected 1 Makefile mention, got {len(makefile_hits)}", file=sys.stderr)
            return 1
        if "AccountService" in found:
            print("false positive: AccountService is still defined", file=sys.stderr)
            return 1
        for alive in ("scaleFixedCritical", "ScaleFixedCritical", "fake_app", "app_with_files"):
            if alive in found:
                print(f"false positive: {alive} should be treated as living/renamed", file=sys.stderr)
                print(format_human(result, C(False), show_all_mentions=True))
                return 1
        print("required holdouts: ok")
        print("variant hit: retry-with-backoff")
        print("path-identity collapse: ok")
        print(format_human(result, C(False), show_all_mentions=True))
        return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="wraith",
        description="Find names whose definitions died in git but which still linger in docs, configs, scripts, comments, and strings.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  wraith                       deaths from recent history, mentions in the worktree
  wraith main                  two-tree: defined in main, gone now, still mentioned
  wraith main HEAD             two-tree between two commits
  wraith --range main..HEAD    names that died on this branch and still linger
  wraith --porcelain           path:line:name:why:death  (pipable)
  wraith --json                machine-readable

exit 2 if any holdout is found (like grep). --ok-exit always exits 0 on success.
""",
    )
    p.add_argument("old", nargs="?", help="old revision (two-tree mode). omit to scan history")
    p.add_argument("new", nargs="?", help="new revision (default: worktree)")
    p.add_argument("-C", "--repo", default=".", help="repository path")
    p.add_argument("--range", dest="range_spec", help="limit history to a git revision range")
    p.add_argument("--since", help="git log --since (history mode)")
    p.add_argument("--max-commits", type=int, default=DEFAULT_MAX_COMMITS)
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--porcelain", action="store_true", help="stable one-line output")
    p.add_argument("--all", action="store_true", help="include live-code identifier mentions")
    p.add_argument("--exact", action="store_true", help="do not match kebab/snake/camel variants")
    p.add_argument(
        "--ignore",
        action="append",
        default=[],
        help="omit mentions matching a glob (repeatable; 'plans/**' supported)",
    )
    p.add_argument("--name", action="append", dest="names", help="only this name (repeatable)")
    p.add_argument("--ok-exit", action="store_true", help="exit 0 even when holdouts exist")
    p.add_argument("--self-test", action="store_true", help="run the built-in fixture and exit")
    p.add_argument("-a", "--all-mentions", action="store_true", help="do not truncate mention lists")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    if args.self_test:
        return self_test()
    try:
        root = repo_root(os.path.abspath(args.repo))
    except GitError as e:
        print(f"wraith: {e}", file=sys.stderr)
        return 1

    names_filter = set(args.names) if args.names else None
    new = args.new
    old = args.old
    try:
        result = scan(
            root,
            old=old,
            new=new,
            max_commits=args.max_commits,
            since=args.since,
            range_spec=args.range_spec,
            include_code=args.all,
            names_filter=names_filter,
            variants=not args.exact,
            ignore=args.ignore,
        )
    except GitError as e:
        print(f"wraith: {e}", file=sys.stderr)
        return 1

    col = C(color_enabled(sys.stdout) and not args.json and not args.porcelain)
    if args.json:
        sys.stdout.write(format_json(result))
    elif args.porcelain:
        sys.stdout.write(format_porcelain(result))
    else:
        sys.stdout.write(format_human(result, col, show_all_mentions=args.all_mentions))

    if result.holdouts and not args.ok_exit:
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
