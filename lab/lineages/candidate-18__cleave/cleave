def list_source_files(root: Path, extra_exclude: list[str] | None = None) -> list[Path]:
    extra = extra_exclude or []
    files: list[Path] = []
    git_dir = root / ".git"
    listed: list[str] | None = None
    if git_dir.exists() or (root / ".git").is_file():
        r = subprocess.run(
            ["git", "-C", str(root), "ls-files", "-z"],
            capture_output=True,
            check=False,
        )
        if r.returncode == 0 and r.stdout:
            listed = [p.decode("utf-8", "surrogateescape") for p in r.stdout.split(b"\0") if p]
    if listed is not None:
        for rel in listed:
            p = root / rel
            if p.suffix.lower() not in EXTS:
                continue
            parts = Path(rel).parts
            if any(part in SKIP_DIR for part in parts):
                continue
            if any(ex in rel.replace("\\", "/") for ex in extra):
                continue
            if p.is_file():
                files.append(p)
        return files
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIR and not d.startswith(".")]
        for name in filenames:
            p = Path(dirpath) / name
            if p.suffix.lower() not in EXTS:
                continue
            rel = str(p.relative_to(root))
            if any(ex in rel.replace("\\", "/") for ex in extra):
                continue
            files.append(p)
    return files


def read_text(path: Path) -> Optional[str]:
    try:
        if path.stat().st_size > MAX_FILE_BYTES:
            return None
        data = path.read_bytes()
    except OSError:
        return None
    if b"\0" in data[:4096]:
        return None
    for enc in ("utf-8", "utf-8-sig", "latin-1"):
        try:
            return data.decode(enc)
        except UnicodeDecodeError:
            continue
    return data.decode("utf-8", "replace")


# ---------------------------------------------------------------------------
# tokenizer
# ---------------------------------------------------------------------------

@dataclass
class Tok:
    k: str  # id num str op attr
    v: str
    line: int
    i: int


def tokenize(src: str, lang: str) -> list[Tok]:
    out: list[Tok] = []
    i, n, line = 0, len(src), 1
    isalnum = str.isalnum

    def peek(k: int = 0) -> str:
        j = i + k
        return src[j] if j < n else ""

    while i < n:
        c = src[i]
        if c == "\n":
            line += 1
            i += 1
            continue
        if c.isspace():
            i += 1
            continue
        # comments
        if lang == "py" and c == "#":
            while i < n and src[i] != "\n":
                i += 1
            continue
        if lang != "py" and c == "/" and peek(1) == "/":
            i += 2
            while i < n and src[i] != "\n":
                i += 1
            continue
        if c == "/" and peek(1) == "*":
            i += 2
            while i + 1 < n and not (src[i] == "*" and src[i + 1] == "/"):
                if src[i] == "\n":
                    line += 1
                i += 1
            i = min(n, i + 2)
            continue
        # rust/swift attributes kept as attr tokens
        if c == "#" and lang in ("rs", "swift") and peek(1) in "![":
            j = i
            i += 1
            if peek() == "!":
                i += 1
            if peek() == "[":
                depth = 0
                while i < n:
                    if src[i] == "[":
                        depth += 1
                    elif src[i] == "]":
                        depth -= 1
                        i += 1
                        if depth == 0:
                            break
                        continue
                    elif src[i] == "\n":
                        line += 1
                    i += 1
            out.append(Tok("attr", src[j:i], line, j))
            continue
        # strings
        if c in "\"'`" or (
            c == "r" and peek(1) in "\"'" and lang in ("py", "rs")
        ) or (
            lang == "py" and c in "fFbBuU" and peek(1) in "\"'"
        ):
            j = i
            sl, sln, st = _scan_string(src, i, lang)
            if sln:
                # count newlines inside
                line += src[i:i + sln].count("\n")
                out.append(Tok("str", sl, line, j))
                i += sln
                continue
        if c == "'" and lang == "rs":
            # lifetime 'a or char 'x'
            if peek(1) == "\\" or (peek(1) and peek(2) == "'"):
                sl, sln, _ = _scan_string(src, i, lang)
                line += src[i:i + sln].count("\n")
                out.append(Tok("str", sl, line, i))
                i += sln
                continue
            j = i + 1
            while j < n and (src[j].isalnum() or src[j] == "_"):
                j += 1
            out.append(Tok("id", src[i:j], line, i))
            i = j
            continue
        # numbers
        if c.isdigit() or (c == "." and peek(1).isdigit()):
            j = i
            if c == "0" and peek(1) in "xXoObB":
                j += 2
                while j < n and src[j] in "0123456789abcdefABCDEFoOlLuU_":
                    j += 1
            else:
                j = i
                while j < n and (src[j].isdigit() or src[j] in "._eE+-"):
                    # stop on identifier-like after number
                    if src[j] in "+-" and src[j - 1] not in "eE":
                        break
                    j += 1
            out.append(Tok("num", src[i:j], line, i))
            i = j
            continue
        # ident
        if c.isalpha() or c == "_" or ord(c) > 127:
            j = i + 1
            while j < n and (src[j].isalnum() or src[j] in "_$" or ord(src[j]) > 127):
                j += 1
            # rust/js macro foo!
            v = src[i:j]
            if j < n and src[j] == "!" and lang == "rs":
                v += "!"
                j += 1
            out.append(Tok("id", v, line, i))
            i = j
            continue
        three = src[i : i + 3]
        if three in ("===", "!==", ">>>", "...", "<<="):
            out.append(Tok("op", three, line, i))
            i += 3
            continue
        two = src[i : i + 2]
        if two in ("::", "=>", "->", "==", "!=", "<=", ">=", "&&", "||", "??", "?.", ".."):
            out.append(Tok("op", two, line, i))
            i += 2
            continue
        out.append(Tok("op", c, line, i))
        i += 1
    return out


def _scan_string(src: str, i: int, lang: str) -> tuple[str, int, int]:
    """Return (token_text, length, end_line_delta). length 0 = not a string."""
    n = len(src)
    start = i
    # prefixes
    while i < n and src[i] in "rRfFbBuU":
        i += 1
    if i >= n or src[i] not in "\"'`":
        return "", 0, 0
    quote = src[i]
    triple = src[i:i + 3] == quote * 3
    i += 3 if triple else 1
    raw = lang == "rs" and src[start] == "r"
    hashn = 0
    if raw and quote == "#" or (lang == "rs" and src[start] == "r" and "#" in src[start:start + 8]):
        pass
    # rust raw r#"..."#
    if lang == "rs" and src[start] == "r":
        k = start + 1
        while k < n and src[k] == "#":
            hashn += 1
            k += 1
        if k < n and src[k] in "\"'":
            quote = src[k]
            i = k + 1
            close = quote + ("#" * hashn)
            j = i
            while j < n:
                if src[j:j + len(close)] == close:
                    j += len(close)
                    return src[start:j], j - start, 0
                j += 1
            return src[start:], n - start, 0
    while i < n:
        c = src[i]
        if triple:
            if src[i:i + 3] == quote * 3:
                i += 3
                return src[start:i], i - start, 0
            i += 1
            continue
        if c == "\\" and not raw:
            i += 2
            continue
        if c == quote:
            i += 1
            return src[start:i], i - start, 0
        if c == "\n" and quote != "`" and not triple and lang != "py":
            # unclosed
            return src[start:i], i - start, 0
        i += 1
    return src[start:], n - start, 0


# ---------------------------------------------------------------------------
# param / arg parsing from token slices
# ---------------------------------------------------------------------------

def split_top(tokens: list[Tok], sep: str = ",") -> list[list[Tok]]:
    parts: list[list[Tok]] = []
    cur: list[Tok] = []
    dpar = dbrc = dbrk = 0
    for t in tokens:
        if t.k == "op":
            if t.v == "(":
                dpar += 1
            elif t.v == ")":
                dpar -= 1
            elif t.v == "{":
                dbrc += 1
            elif t.v == "}":
                dbrc -= 1
            elif t.v == "[":
                dbrk += 1
            elif t.v == "]":
                dbrk -= 1
            elif t.v == sep and dpar == 0 and dbrc == 0 and dbrk == 0:
                if cur:
                    parts.append(cur)
                cur = []
                continue
        cur.append(t)
    if cur:
        parts.append(cur)
    return parts


def tokens_src(toks: list[Tok]) -> str:
    if not toks:
        return ""
    return " ".join(t.v for t in toks)


def parse_params(lang: str, inner: list[Tok]) -> list[Param]:
    chunks = split_top(inner)
    params: list[Param] = []
    pending_names: list[str] = []
    for ch in chunks:
        ch = [t for t in ch if not (t.k == "op" and t.v == "\n")]
        if not ch:
            continue
        text = tokens_src(ch)
        if text in ("...", "*args", "**kwargs") or text.startswith("*") or text.startswith("..."):
            continue
        if lang == "rs":
            joined = "".join(t.v for t in ch)
            if re.fullmatch(r"&?(mut)?self", joined.replace(" ", "")):
                continue
            name = None
            for t in ch:
                if t.k == "id" and t.v not in ("mut", "pub", "ref", "const"):
                    name = t.v
                    break
            if name:
                params.append(Param(name))
            continue
        if lang == "swift":
            ids = [t for t in ch if t.k == "id"]
            # first id that's not a type-ish keyword may be label
            # patterns: `_ name: T`  `label name: T`  `name: T`  `name T` no
            colon = next((i for i, t in enumerate(ch) if t.k == "op" and t.v == ":"), None)
            if colon is None:
                if ids:
                    params.append(Param(ids[0].v, label=ids[0].v))
                continue
            before = [t for t in ch[:colon] if t.k == "id" or (t.k == "op" and t.v == "_")]
            default = None
            eq = next((i for i, t in enumerate(ch) if t.k == "op" and t.v == "="), None)
            if eq is not None:
                default = _literal_from_tokens(ch[eq + 1 :])
            if len(before) >= 2:
                label = before[0].v
                name = before[1].v
                params.append(Param(name, default, label=label))
            elif before:
                params.append(Param(before[0].v, default, label=before[0].v))
            continue
        if lang == "go":
            ids = [t.v for t in ch if t.k == "id"]
            # `x, y int` was split — this chunk is either `x` or `y int`
            if len(ids) == 1:
                pending_names.append(ids[0])
                # if this chunk has a type (more tokens), flush
                if len(ch) > 1:
                    for nm in pending_names:
                        if nm not in ("int", "string", "bool", "error", "byte", "rune", "float64", "float32", "any"):
                            params.append(Param(nm))
                    pending_names = []
            else:
                # x int  or  x y — last may be type
                names, maybe_type = ids[:-1], ids[-1] if ids else None
                for nm in pending_names + names:
                    params.append(Param(nm))
                pending_names = []
                if maybe_type and maybe_type[0].islower() and maybe_type not in (
                    "int",
                    "string",
                    "bool",
                    "error",
                    "byte",
                    "rune",
                    "any",
                    "float64",
                    "float32",
                    "int64",
                    "int32",
                    "uint",
                ):
                    params.append(Param(maybe_type))
            continue
        # js / default
        if ch[0].k == "op" and ch[0].v in "{[":
            params.append(Param(f"${len(params)}"))
            continue
        eq = next((i for i, t in enumerate(ch) if t.k == "op" and t.v == "="), None)
        name = next((t.v for t in ch if t.k == "id"), None)
        if not name:
            continue
        default = _literal_from_tokens(ch[eq + 1 :]) if eq is not None else None
        params.append(Param(name, default))
    for nm in pending_names:
        params.append(Param(nm))
    return params


def _is_enum_tag(recv: str, attr: str, op: str) -> bool:
    if op == "::":
        return True
    if op == "." and (looks_const_name(attr) or (recv[:1].isupper() and attr[:1].isupper())):
        return True
    return False


def _literal_from_tokens(toks: list[Tok]) -> Optional[str]:
    toks = [t for t in toks if t.k != "attr" and not (t.k == "op" and t.v in (";", ",", ")"))]
    if not toks:
        return None
    if len(toks) == 1:
        t = toks[0]
        if t.k == "num":
            return canon_lit(t.v)
        if t.k == "str":
            if "${" in t.v or r"\(" in t.v:
                return None
            return canon_lit(t.v)
        if t.k == "id" and t.v.lower() in ("true", "false", "none", "null", "nil", "undefined"):
            return canon_lit(t.v)
        return None
    # unary minus
    if toks[0].k == "op" and toks[0].v in "+-" and len(toks) == 2 and toks[1].k == "num":
        return canon_lit(toks[0].v + toks[1].v)
    # enum / case tag, not field access like cfg.host
    if (
        len(toks) == 3
        and toks[0].k == "id"
        and toks[1].k == "op"
        and toks[1].v in (".", "::")
        and toks[2].k == "id"
        and _is_enum_tag(toks[0].v, toks[2].v, toks[1].v)
    ):
        return toks[0].v + toks[1].v + toks[2].v
    if len(toks) == 2 and toks[0].k == "op" and toks[0].v == "." and toks[1].k == "id":
        return "." + toks[1].v
    return None


def parse_object_bag(toks: list[Tok], consts: dict[str, str]) -> Optional[dict[str, Arg]]:
    if not toks or not (toks[0].k == "op" and toks[0].v == "{"):
        return None
    # drop outer braces
    inner = toks[1:]
    if inner and inner[-1].k == "op" and inner[-1].v == "}":
        inner = inner[:-1]
    if not inner:
        return {}
    bag: dict[str, Arg] = {}
    for i, ch in enumerate(split_top(inner)):
        if not ch:
            continue
        # shorthand { catalog } or { catalog: expr } or { catalog, }
        if ch[0].k != "id":
            continue
        key = ch[0].v
        colon = next((j for j, t in enumerate(ch) if t.k == "op" and t.v == ":"), None)
        if colon is None:
            # shorthand
            bag[key] = _arg_from_tokens(0, key, [ch[0]], consts)
        else:
            bag[key] = _arg_from_tokens(0, key, ch[colon + 1 :], consts)
    return bag if bag else {}


def _arg_from_tokens(index: int, name: Optional[str], toks: list[Tok], consts: dict[str, str]) -> Arg:
    lit = _literal_from_tokens(toks)
    if lit is not None:
        return Arg(index, name, "lit", lit)
    if len(toks) == 1 and toks[0].k == "id":
        idv = toks[0].v
        if idv in consts:
            return Arg(index, name, "lit", consts[idv])
        return Arg(index, name, "dyn", None)
    if (
        len(toks) == 3
        and toks[0].k == "id"
        and toks[1].k == "op"
        and toks[1].v in (".", "::")
        and toks[2].k == "id"
        and (looks_const_name(toks[2].v) or toks[1].v == "::")
    ):
        # Foo::BAR or Mode.Fast — treat as literal tag
        if not (len(toks) > 3 and toks[3].k == "op" and toks[3].v == "("):
            return Arg(index, name, "lit", toks[0].v + toks[1].v + toks[2].v)
    return Arg(index, name, "dyn", None)


def parse_args(lang: str, inner: list[Tok], consts: dict[str, str], params: list[Param] | None) -> tuple[list[Arg], dict[str, Arg]]:
    chunks = split_top(inner)
    args: list[Arg] = []
    bags: dict[str, Arg] = {}
    used_kw = False
    for i, ch in enumerate(chunks):
        if not ch:
            continue
        # keyword a=b (py) or a: b (swift/js object is different)
        name = None
        value_toks = ch
        if lang == "py":
            eq = next((j for j, t in enumerate(ch) if t.k == "op" and t.v == "="), None)
            if eq is not None and ch[0].k == "id":
                name = ch[0].v
                value_toks = ch[eq + 1 :]
                used_kw = True
        elif lang == "swift":
            colon = next((j for j, t in enumerate(ch) if t.k == "op" and t.v == ":"), None)
            if colon is not None and ch[0].k == "id" and colon == 1:
                name = ch[0].v
                value_toks = ch[colon + 1 :]
                used_kw = True
        # js object bag as first-class arg
        bag = parse_object_bag(ch, consts) if ch[0].k == "op" and ch[0].v == "{" else None
        if bag is not None and lang in ("js", "py", "ts"):
            # positional bag — expand
            for k, a in bag.items():
                bags[k] = a
            args.append(Arg(i, name or (params[i].name if params and i < len(params) else f"${i}"), "dyn", "{...}"))
            continue
        if name is None and params and i < len(params) and not used_kw:
            name = params[i].name
        args.append(_arg_from_tokens(i, name, value_toks, consts))
    return args, bags


