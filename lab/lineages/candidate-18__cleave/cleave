def use_color(mode: str) -> bool:
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def wrap(enabled: bool, code: str, s: str) -> str:
    if not enabled:
        return s
    return f"\033[{code}m{s}\033[0m"


def rel_site(c: Call) -> str:
    return f"{c.path}:{c.line}"


def render_human(reports: list[Report], color: bool, show_all: bool) -> str:
    lines: list[str] = []
    shown = 0
    for r in reports:
        if not show_all and not r.tilts and len(r.worlds) < 2:
            continue
        shown += 1
        params = ", ".join(
            (p.name + (f"={p.default}" if p.default is not None else "")) for p in r.fn.params
        )
        head = f"{r.fn.qualname}  {r.fn.path}:{r.fn.line}  ({params})"
        flag = wrap(color, "31;1", "  TILT") if r.tilts else ""
        ntest = sum(1 for c in r.calls if c.is_test)
        nprod = sum(1 for c in r.calls if not c.is_test)
        lines.append(wrap(color, "1", head) + flag)
        lines.append(
            f"  {len(r.calls)} calls  {len(r.worlds)} worlds  test:{ntest} prod:{nprod}"
        )
        for w in r.worlds:
            who = []
            if w.n_test:
                who.append(wrap(color, "32", f"test:{w.n_test}"))
            if w.n_prod:
                who.append(wrap(color, "33", f"prod:{w.n_prod}"))
            sites = (w.test_calls + w.prod_calls)[:3]
            site_s = "  ".join(rel_site(c) for c in sites)
            extra = "" if len(w.test_calls) + len(w.prod_calls) <= 3 else " …"
            lines.append(f"  world  {w.label:40s}  {' '.join(who)}")
            lines.append(f"         {site_s}{extra}")
        for a in r.arms:
            inhabit = []
            if a.test:
                inhabit.append("test")
            if a.prod:
                inhabit.append("prod")
            tag = ",".join(inhabit) if inhabit else "nobody"
            mark = ""
            if a.prod and not a.test:
                mark = wrap(color, "31", "  prod-only")
            elif a.test and not a.prod:
                mark = wrap(color, "36", "  test-only")
            lines.append(f"  arm    {a.pred:40s}  {tag}{mark}")
        for g in r.members:
            miss = wrap(color, "31", fmt_vals(g.missing)) if g.missing else "[]"
            lines.append(
                f"  members {g.collection}  {g.param}  {len(g.members)}  hit={fmt_vals(g.witnessed)}  miss={miss}"
            )
        for t in r.tilts:
            lines.append("  " + wrap(color, "31", f"tilt   {t.kind:16s}  {t.detail}"))
        lines.append("")
    if not shown:
        nfn = len(reports)
        nw = sum(1 for r in reports if len(r.worlds) > 1)
        nt = sum(1 for r in reports if r.tilts)
        lines.append(f"no tilts  functions_with_calls={nfn} multi_world={nw} tilt={nt}")
    return "\n".join(lines).rstrip() + "\n"


def render_json(reports: list[Report], tilts_only: bool) -> str:
    payload = []
    for r in reports:
        if tilts_only and not r.tilts:
            continue
        payload.append(
            {
                "name": r.fn.name,
                "qualname": r.fn.qualname,
                "def": {"path": r.fn.path, "line": r.fn.line, "params": [p.name for p in r.fn.params]},
                "calls": len(r.calls),
                "n_test": sum(1 for c in r.calls if c.is_test),
                "n_prod": sum(1 for c in r.calls if not c.is_test),
                "worlds": [
                    {
                        "label": w.label,
                        "n_test": w.n_test,
                        "n_prod": w.n_prod,
                        "sites": [rel_site(c) for c in (w.test_calls + w.prod_calls)[:8]],
                    }
                    for w in r.worlds
                ],
                "arms": [{"pred": a.pred, "test": a.test, "prod": a.prod} for a in r.arms],
                "members": [
                    {
                        "param": g.param,
                        "collection": g.collection,
                        "members": g.members,
                        "witnessed": g.witnessed,
                        "missing": g.missing,
                    }
                    for g in r.members
                ],
                "tilts": [{"kind": t.kind, "detail": t.detail} for t in r.tilts],
            }
        )
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def render_tsv(reports: list[Report], tilts_only: bool) -> str:
    lines = ["kind\tfn\tpath\tline\ta\tb\tc"]
    for r in reports:
        if tilts_only and not r.tilts:
            continue
        q = r.fn.qualname
        for t in r.tilts:
            lines.append(f"tilt\t{q}\t{r.fn.path}\t{r.fn.line}\t{t.kind}\t{t.detail}\t")
        for w in r.worlds:
            sites = ",".join(rel_site(c) for c in (w.test_calls + w.prod_calls)[:5])
            lines.append(
                f"world\t{q}\t{r.fn.path}\t{r.fn.line}\t{w.label}\ttest={w.n_test} prod={w.n_prod}\t{sites}"
            )
        for a in r.arms:
            lines.append(
                f"arm\t{q}\t{r.fn.path}\t{r.fn.line}\t{a.pred}\ttest={int(a.test)} prod={int(a.prod)}\t"
            )
    return "\n".join(lines) + "\n"


def render_porcelain(reports: list[Report]) -> str:
    lines = []
    for r in reports:
        for t in r.tilts:
            lines.append(f"tilt\t{r.fn.qualname}\t{t.kind}\t{t.detail}\t{r.fn.path}:{r.fn.line}")
        if not r.tilts:
            continue
    return "\n".join(lines) + ("\n" if lines else "")


