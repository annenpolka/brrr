def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cleave",
        description="Partition functions into the argument worlds their callers inhabit. "
        "Report when tests and production do not live in the same worlds.",
    )
    p.add_argument("names", nargs="*", help="function names to inspect (default: all with tilts)")
    p.add_argument("-C", "--root", default=".", help="repository / tree root")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--tsv", action="store_true", help="TSV output")
    p.add_argument("--porcelain", action="store_true", help="stable tilt lines")
    p.add_argument("--all", action="store_true", help="print every function with calls, not only tilts/multi-world")
    p.add_argument("--tilt", action="store_true", help="only functions that tilt")
    p.add_argument("--check", action="store_true", help="exit 1 if any tilt")
    p.add_argument("--min-callers", type=int, default=2, help="minimum call sites (default 2)")
    p.add_argument("--test-defs", action="store_true", help="include functions defined in tests as subjects")
    p.add_argument("--exclude", action="append", default=[], help="substring of relative path to skip (repeatable)")
    p.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    p.add_argument("--self-test", action="store_true")
    p.add_argument("--summary", action="store_true", help="one-line census")
    p.add_argument("--version", action="store_true")
    return p


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    p = build_parser()
    try:
        args = p.parse_args(argv)
    except SystemExit as e:
        return int(e.code) if isinstance(e.code, int) else 2
    if args.version:
        print(VERSION)
        return 0
    if args.self_test:
        return self_test()
    root = Path(args.root).resolve()
    if not root.exists():
        eprint(f"cleave: no such path: {root}")
        return 2
    defs, calls, reports = analyze(root, args.exclude, include_test_defs=args.test_defs)
    tilts_only = args.tilt or (not args.all and not args.names and not args.summary)
    filtered = filter_reports(reports, args.names, args.min_callers, tilts_only=False)
    if args.names:
        view = filtered
    elif args.all:
        view = filtered
    elif tilts_only:
        view = [r for r in filtered if r.tilts]
    else:
        view = filtered

    n_tilt_fns = sum(1 for r in reports if r.tilts)
    n_tilt = sum(len(r.tilts) for r in reports)

    if args.summary:
        print(
            f"files={len(list_source_files(root, args.exclude))} defs={len(defs)} calls={len(calls)} "
            f"reported={len(reports)} multi_world={sum(1 for r in reports if len(r.worlds)>1)} "
            f"tilt_fns={n_tilt_fns} tilts={n_tilt}"
        )
        if args.check:
            return 1 if n_tilt_fns else 0
        return 0

    color = use_color(args.color)
    if args.json:
        sys.stdout.write(render_json(view if args.names or args.all or args.tilt else [r for r in filtered if r.tilts] or view, tilts_only=False))
    elif args.tsv:
        sys.stdout.write(render_tsv(view, tilts_only=False))
    elif args.porcelain:
        sys.stdout.write(render_porcelain(reports if not args.names else view))
    else:
        sys.stdout.write(render_human(view if (args.names or args.all) else [r for r in filtered if r.tilts] or [], color, show_all=args.all or bool(args.names)))

    if args.check:
        pool = view if args.names else reports
        return 1 if any(r.tilts for r in pool) else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
