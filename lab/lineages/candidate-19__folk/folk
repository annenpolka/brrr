def py_call_evt(node: ast.Call) -> CallEvt | None:
    func = node.func
    name = None
    recv = None
    if isinstance(func, ast.Name):
        name = func.id
    elif isinstance(func, ast.Attribute):
        name = func.attr
        if isinstance(func.value, ast.Name):
            recv = func.value.id
        elif isinstance(func.value, ast.Attribute) and isinstance(func.value.value, ast.Name):
            recv = f"{func.value.value.id}.{func.value.attr}"
        elif isinstance(func.value, ast.Name) is False and isinstance(func.value, ast.Call):
            recv = None
    if not name or name.startswith("__"):
        return None
    return CallEvt(name=name, recv=recv, lineno=getattr(node, "lineno", 1), col=getattr(node, "col_offset", 0))


def py_calls_in(node: ast.AST | None) -> list[CallEvt]:
    if node is None:
        return []
    out: list[CallEvt] = []

    def walk(n: ast.AST) -> None:
        if isinstance(n, ast.Call):
            if isinstance(n.func, ast.Attribute):
                walk(n.func.value)
            elif not isinstance(n.func, ast.Name):
                walk(n.func)
            for a in n.args:
                walk(a)
            for k in n.keywords:
                walk(k.value)
            ev = py_call_evt(n)
            if ev:
                out.append(ev)
            return
        for ch in ast.iter_child_nodes(n):
            walk(ch)

    walk(node)
    return out


class PyCFG:
    def __init__(self, filename: str) -> None:
        self.filename = filename

    def stmts(self, body: list[ast.stmt]) -> list[list]:
        paths: list[list] = [[]]
        for stmt in body:
            bits = self.stmt(stmt)
            paths = concat_paths(paths, bits)
        return paths or [[]]

    def stmt(self, stmt: ast.stmt) -> list[list]:
        if isinstance(stmt, ast.If):
            prefix = py_calls_in(stmt.test)
            then = self.stmts(stmt.body)
            els = self.stmts(stmt.orelse) if stmt.orelse else [[]]
            return [prefix + p for p in then + els]
        if isinstance(stmt, ast.While):
            prefix = py_calls_in(stmt.test)
            body = self.stmts(stmt.body)
            # 0 or 1 iteration
            return [prefix] + [prefix + p for p in body]
        if isinstance(stmt, ast.For):
            prefix = py_calls_in(stmt.iter) + py_calls_in(stmt.target)
            body = self.stmts(stmt.body)
            return [prefix] + [prefix + p for p in body]
        if isinstance(stmt, ast.Try):
            try_p = self.stmts(stmt.body)
            else_p = self.stmts(stmt.orelse) if stmt.orelse else [[]]
            fin_p = self.stmts(stmt.finalbody) if stmt.finalbody else [[]]
            success = concat_paths(concat_paths(try_p, else_p), fin_p)
            handlers: list[list] = []
            for h in stmt.handlers:
                hp = self.stmts(h.body)
                handlers.extend(concat_paths(hp, fin_p))
            if not stmt.handlers and not stmt.finalbody:
                return try_p
            return success + handlers
        if isinstance(stmt, ast.With):
            prefix: list[CallEvt] = []
            synthetic: list[CallEvt] = []
            for item in stmt.items:
                prefix.extend(py_calls_in(item.context_expr))
                # with open(...) as f: imply close at end of block
                for ev in py_calls_in(item.context_expr):
                    if ev.name in {"open", "lock", "acquire"}:
                        inv = {"open": "close", "lock": "unlock", "acquire": "release"}[ev.name]
                        synthetic.append(
                            CallEvt(name=inv, recv=ev.recv, lineno=stmt.lineno, col=stmt.col_offset)
                        )
            body = self.stmts(stmt.body)
            return [prefix + p + synthetic for p in body]
        if isinstance(stmt, ast.Match):
            prefix = py_calls_in(stmt.subject)
            cases: list[list] = []
            for c in stmt.cases:
                cases.extend(self.stmts(c.body))
            if not cases:
                cases = [[]]
            return [prefix + p for p in cases]
        if isinstance(stmt, (ast.Return, ast.Raise)):
            value = stmt.value if isinstance(stmt, ast.Return) else (stmt.exc if isinstance(stmt, ast.Raise) else None)
            calls = py_calls_in(value)
            kind = "return" if isinstance(stmt, ast.Return) else "throw"
            marker = CallEvt(name=kind, recv=None, lineno=stmt.lineno, col=stmt.col_offset, kind=kind)
            return [calls + [marker, END]]
        if isinstance(stmt, ast.FunctionDef) or isinstance(stmt, ast.AsyncFunctionDef):
            # nested function: not part of this body's call sequence
            return [[]]
        if isinstance(stmt, ast.ClassDef):
            return [[]]
        # generic: collect calls in this statement's expressions, not nested bodies
        return [py_calls_in(stmt)]


def extract_python(path: Path, src: str, is_test: bool) -> list[FunctionTrace]:
    try:
        tree = ast.parse(src, filename=str(path))
    except SyntaxError as exc:
        eprint(f"folk: python parse error {path}:{exc.lineno}: {exc.msg}")
        return []
    cfg = PyCFG(str(path))
    out: list[FunctionTrace] = []

    class Visitor(ast.NodeVisitor):
        def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
            self._fn(node)
            self.generic_visit(node)

        def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> None:
            self._fn(node)
            self.generic_visit(node)

        def _fn(self, node: ast.FunctionDef | ast.AsyncFunctionDef) -> None:
            raw_paths = cfg.stmts(node.body)
            paths: list[list[CallEvt]] = []
            for p in raw_paths:
                clean = [x for x in p if x is not END and isinstance(x, CallEvt)]
                paths.append(clean)
            out.append(
                FunctionTrace(
                    file=str(path),
                    name=node.name,
                    lineno=node.lineno,
                    lang="py",
                    is_test=is_test or node.name.startswith("test"),
                    paths=paths or [[]],
                )
            )

    Visitor().visit(tree)
    return out


