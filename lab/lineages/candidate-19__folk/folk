def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def is_test_path(path: Path) -> bool:
    if TEST_FILE_RE.search(path.name):
        return True
    return any(part.lower() in TEST_DIR_NAMES for part in path.parts)


def should_skip_dir(name: str) -> bool:
    return name in SKIP_DIRS or name.startswith(".")


def iter_source_files(roots: list[Path], langs: set[str] | None) -> Iterator[Path]:
    for root in roots:
        if root.is_file():
            yield root
            continue
        if not root.exists():
            eprint(f"folk: no such path: {root}")
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if not should_skip_dir(d)]
            for fn in filenames:
                p = Path(dirpath) / fn
                ext = p.suffix.lower()
                lang = LANG_BY_EXT.get(ext)
                if not lang:
                    continue
                if langs and lang not in langs:
                    continue
                if any(part in p.name for part in (".min.", "vendor_bundle")):
                    continue
                yield p


def read_text(path: Path) -> str | None:
    try:
        data = path.read_bytes()
    except OSError as exc:
        eprint(f"folk: skip {path}: {exc}")
        return None
    if len(data) > MAX_FILE_BYTES:
        eprint(f"folk: skip {path}: too large ({len(data)} bytes)")
        return None
    return data.decode("utf-8", errors="replace")


def camel_to_words(name: str) -> list[str]:
    s = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", name)
    s = s.replace("-", "_")
    return [w.lower() for w in s.split("_") if w]


def stem_split(name: str) -> tuple[str, str]:
    """Split beginTx / begin_tx / startCapture into (verb, rest)."""
    words = camel_to_words(name)
    if not words:
        return name.lower(), ""
    return words[0], "".join(words[1:])


def is_stopword(name: str) -> bool:
    if name in STOPWORDS:
        return True
    if ASSERT_RE.match(name):
        return True
    if name.endswith("!") and name[:-1] in STOPWORDS:
        return True
    return False


def verbs_inverse(va: str, vb: str) -> bool:
    if not va or not vb or va == vb:
        return False
    if (va, vb) in EXACT_INVERSES:
        return True
    if va.startswith("un") and va[2:] == vb:
        return True
    if vb.startswith("un") and vb[2:] == va:
        return True
    if va.startswith("de") and va[2:] == vb:
        return True
    if vb.startswith("de") and vb[2:] == va:
        return True
    return False


def lexical_inverse(a: str, b: str) -> bool:
    if a == b:
        return False
    la, lb = a.lower(), b.lower()
    if la == lb:
        return False
    if verbs_inverse(la, lb):
        return True
    va, ra = stem_split(a)
    vb, rb = stem_split(b)
    if not verbs_inverse(va, vb):
        return False
    # begin_tx / commit_tx (same remainder) or push_back / pop_front
    return ra == rb or (ra, rb) in DIRECTIONAL_RESTS


def is_generic_inverse(a: str, b: str) -> bool:
    va, _ = stem_split(a)
    vb, _ = stem_split(b)
    return (va, vb) in GENERIC_VERB_PAIRS


def is_protocol_move(name: str) -> bool:
    low = name.lower()
    if low in ALL_PROTOCOL_VERBS:
        return True
    if low.startswith("un") and low[2:] in ALL_PROTOCOL_VERBS:
        return True
    v, _ = stem_split(name)
    return v in ALL_PROTOCOL_VERBS or (v.startswith("un") and v[2:] in ALL_PROTOCOL_VERBS)


def is_constructorish(name: str) -> bool:
    return bool(name) and name[0].isupper() and any(c.islower() for c in name[1:])


def concat_paths(paths: list[list], suffixes: list[list], cap: int = MAX_PATHS) -> list[list]:
    out: list[list] = []
    for p in paths:
        if p and p[-1] is END:
            out.append(p)
            continue
        for s in suffixes:
            out.append(p + s)
            if len(out) >= cap:
                return out
    return out if out else paths


