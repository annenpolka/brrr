@dataclass(frozen=True)
class CallEvt:
    name: str
    recv: str | None
    lineno: int
    col: int
    kind: str = "call"  # call | return | throw

    @property
    def key(self) -> str:
        return self.name

    def display(self) -> str:
        if self.recv:
            return f"{self.recv}.{self.name}"
        return self.name


@dataclass
class FunctionTrace:
    file: str
    name: str
    lineno: int
    lang: str
    is_test: bool
    paths: list[list[CallEvt]] = field(default_factory=list)


@dataclass
class PairStat:
    left: str
    right: str
    lang: str = ""
    together: int = 0
    only_left: int = 0
    only_right: int = 0
    reversed: int = 0
    same_recv: int = 0
    funcs: set[str] = field(default_factory=set)
    langs: set[str] = field(default_factory=set)
    why: set[str] = field(default_factory=set)

    def score(self) -> float:
        den = self.together + self.only_left + self.only_right
        if den <= 0:
            return 0.0
        return self.together / den


