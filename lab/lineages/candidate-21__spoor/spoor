        f"waitpid_at: {report['waitpid_ms']}ms",
        f"quiesce: {report['settle_ms']}ms after waitpid"
        + ("  LATE ACTIVITY" if report["late_writes"] else "  (world already still)"),
        f"watch: {report['watch_backend']}",
        "",
    ]
    tests = report.get("tests") or {}
    if tests.get("count"):
        lines.append(
            f"tests: {tests.get('passed', 0)} passed  {tests.get('failed', 0)} failed  "
