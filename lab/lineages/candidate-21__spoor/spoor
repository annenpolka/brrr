        if len(fresh) > 12:
            lines.append(f"  ... {len(fresh) - 12} more")
        lines.append("")
    if undeclared:
        lines.append(f"undeclared generated-like ({len(undeclared)}):")
        for g in undeclared[:8]:
            lines.append(f"  {g['path']}")
