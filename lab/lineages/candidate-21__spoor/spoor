    interesting = [g for g in report["generated"] if g["status"] in {"stale", "orphan-source"}]
    fresh = [g for g in report["generated"] if g["status"] == "fresh"]
    undeclared = [g for g in report["generated"] if g["status"] == "undeclared"]
    if interesting:
        lines.append("attention:")
        for g in interesting:
            lag = g.get("lag_s")
            lag_s = f"  lag={lag}s" if lag is not None else ""
            lines.append(f"  {g['status'].upper():<14} {g['path']}{lag_s}")
            if g.get("declared_source"):
