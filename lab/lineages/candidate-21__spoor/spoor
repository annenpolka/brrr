            )
            lines.append(f"       e.g. {b['sample'][0]}")
    return "\n".join(lines).rstrip() + "\n"


def late_writes_from_timeline(
    events: list[dict[str, Any]], exit_t: float
) -> list[dict[str, Any]]:
    out = []
    seen: set[str] = set()
    for ev in events:
        if ev.get("kind") != "fs":
            continue
        if ev.get("t", 0) + 1e-9 < exit_t:
            continue
        path = ev.get("path")
        if not path or path in seen:
            continue
        flags = ev.get("flags") or ""
        if "Removed" in flags:
            continue
        seen.add(path)
        rec = {
            "t_after_exit": round(ev["t"] - exit_t, 4),
            "path": path,
            "flags": flags,
            "class": ev.get("class"),
            "via": "watch",
        }
        out.append(rec)
    out.sort(key=lambda r: r["t_after_exit"])
    return out


def late_writes_from_mtimes(
    paths: Iterable[str],
    waitpid_wall: float,
    tmp_roots: list[str],
    slop: float = 0.02,
) -> list[dict[str, Any]]:
    """Files whose mtime is at/after waitpid — the bookend sensor.

    Watchers can miss short-lived trees (slow to arm, overflow). Git status
    plus mtime still sees the residue.
    """
    out = []
    for path in paths:
        npath = normpath(path)
        try:
            mtime = os.path.getmtime(npath)
        except OSError:
            continue
        if mtime + slop < waitpid_wall:
            continue
        out.append(
            {
                "t_after_exit": round(mtime - waitpid_wall, 4),
                "path": npath,
                "flags": "Updated",
                "class": classify_path(npath, tmp_roots),
                "via": "mtime",
            }
        )
    out.sort(key=lambda r: r["t_after_exit"])
    return out


def merge_late_writes(*groups: list[dict[str, Any]]) -> list[dict[str, Any]]:
    by: dict[str, dict[str, Any]] = {}
    for group in groups:
        for rec in group:
            path = rec["path"]
            prev = by.get(path)
            if prev is None or rec["t_after_exit"] < prev["t_after_exit"]:
                if prev and prev.get("via") != rec.get("via"):
                    rec = {**rec, "via": f"{rec.get('via')}+{prev.get('via')}"}
                by[path] = rec
    return sorted(by.values(), key=lambda r: r["t_after_exit"])


def human_run(report: dict[str, Any]) -> str:
    lines = [
