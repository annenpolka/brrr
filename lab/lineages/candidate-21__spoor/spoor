GENERATED_NAME_RE = re.compile(
    r"(?:\.generated\.|_generated\.|\.gen\.|Generated)", re.IGNORECASE
)
GENERATED_HEADER_RE = re.compile(
    r"(?i)(@generated|code generated|generated from|generated by|do not edit|auto-?generated)"
)
FROM_SOURCE_RE = re.compile(
    r"(?i)(?:generated(?:\s+(?:code\s+)?)?(?:from|by.*?from)|@generated(?:\s+by\s+\S+\s+from)?)\s+(\S+)"
)
FROM_FALLBACK_RE = re.compile(r"(?i)\bfrom\s+(\S+)")
BY_GENERATOR_RE = re.compile(r"(?i)(?:@generated\s+by|generated by)\s+(\S+)")
JSON_SOURCE_RE = re.compile(r'"source"\s*:\s*"([^"]+)"')
SOURCE_LINE_RE = re.compile(r"(?im)^(?:source|# source)\s*:\s*`?(\S+?)`?\s*$")
DOC_BASENAMES = {
    "AGENTS.md",
    "README.md",
    "README.ja.md",
    "CLAUDE.md",
    "CODEOWNERS",
    "LICENSE",
    "CONTRIBUTING.md",
}

LIBTEST_RE = re.compile(r"^test (.+?) \.\.\. (ok|FAILED|ignored|failed|bench)")
PYTEST_RE = re.compile(
    r"^((?:[\w./-]+::)+[\w\[\].-]+) (PASSED|FAILED|SKIPPED|ERROR|XFAIL)"
)
SWIFT_XC_RE = re.compile(r"^Test Case '-\[([^\]]+)\]' (passed|failed)")
SWIFT_TESTING_RE = re.compile(
    r"^(?:✔|✘|√|×|✓)\s+Test\s+(?:\"([^\"]+)\"|(.+?))\s+(passed|failed)"
)
CARGO_RUNNING_RE = re.compile(r"^\s*Running (.+)$")
CARGO_RESULT_RE = re.compile(
    r"^test result: (\w+)\. (\d+) passed; (\d+) failed; (\d+) ignored"
)
VITEST_RE = re.compile(r"^\s*(✓|×|✗|x|✔|✘)\s+(\S.+)$")

PUNCT_TRAIL_RE = re.compile(r"[.,;:)\]>]+$")


def monotonic() -> float:
    return time.monotonic()


def wallclock() -> float:
    return time.time()


def iso(ts: float) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(ts)) + f".{int((ts % 1) * 1000):03d}"


def normpath(p: str | Path) -> str:
    path = os.path.abspath(os.path.expanduser(str(p)))
    # macOS: /var is /private/var, /tmp is /private/tmp
    try:
        path = os.path.realpath(path)
    except OSError:
        pass
    return path


def is_under(path: str, root: str) -> bool:
    path = normpath(path)
    root = normpath(root)
    return path == root or path.startswith(root + os.sep)


def path_parts(path: str) -> set[str]:
    return set(Path(path).parts)


def looks_tmp(path: str, tmp_roots: Iterable[str]) -> bool:
    n = normpath(path)
    if n.startswith("/tmp/") or n.startswith("/private/tmp/"):
        return True
    if "/var/folders/" in n or "/private/var/folders/" in n:
        return True
    for root in tmp_roots:
        if root and is_under(n, root):
            return True
    return False


def looks_generated_name(path: str) -> bool:
    name = os.path.basename(path)
    if GENERATED_NAME_RE.search(name):
        return True
    if name.endswith(".generated"):
        return True
    return False


def read_header(path: str, limit: int = 8) -> str:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            lines = []
            for i, line in enumerate(fh):
                if i >= limit:
                    break
                lines.append(line)
            return "".join(lines)
    except OSError:
        return ""


def looks_generated_file(path: str) -> bool:
    base = os.path.basename(path)
    if base in LOCKFILE_NAMES or base in DOC_BASENAMES:
        return False
    if looks_generated_name(path):
        return True
    if not os.path.isfile(path):
        return False
    try:
        if os.path.getsize(path) > 2_000_000:
            return False
    except OSError:
        return False
    header = read_header(path)
    if not GENERATED_HEADER_RE.search(header):
        return False
    # Human docs often mention generation; require a machine banner.
    first = header.splitlines()[:2]
    banner = "\n".join(first)
    return bool(
        re.search(r"(?i)generated from|@generated|do not edit|code generated", banner)
    )


def looks_like_source_path(token: str) -> bool:
    if not token:
        return False
    low = token.lower()
    if low in {"the", "this", "a", "an", "by", "cargo", "code", "file", "files"}:
        return False
    if token.startswith("#") or token.startswith("internal/"):
        return False
    if "/" in token or token.startswith("."):
        return True
    return bool(re.search(r"\.(pkl|ts|tsx|js|jsx|swift|py|rs|json|yml|yaml|md|mbt)$", token, re.I))


def parse_declared_source(header: str) -> str | None:
    for rx in (FROM_SOURCE_RE, SOURCE_LINE_RE, JSON_SOURCE_RE):
        m = rx.search(header)
        if not m:
            continue
        raw = PUNCT_TRAIL_RE.sub("", m.group(1).strip().strip("`\"'"))
        if looks_like_source_path(raw):
            return raw
    if GENERATED_HEADER_RE.search(header):
        m = FROM_FALLBACK_RE.search(header)
        if m:
            raw = PUNCT_TRAIL_RE.sub("", m.group(1).strip().strip("`\"'"))
            if looks_like_source_path(raw):
                return raw
    return None


def parse_declared_generator(header: str) -> str | None:
    m = BY_GENERATOR_RE.search(header)
    if not m:
        return None
    return PUNCT_TRAIL_RE.sub("", m.group(1).strip().strip("`\"'"))


def classify_path(path: str, tmp_roots: Iterable[str] | None = None) -> str:
    parts = path_parts(path)
    if parts & {".git"}:
        return "vcs"
    if parts & (PRUNE_DIR_NAMES - {".git"}):
        return "cache"
    if looks_tmp(path, tmp_roots or []):
        return "tmp"
    if looks_generated_name(path) or looks_generated_file(path):
        return "generated"
    return "source"


def parse_test_line(text: str) -> dict[str, str] | None:
    s = text.rstrip("\r\n")
    if not s:
        return None
    m = LIBTEST_RE.match(s)
    if m:
        status = m.group(2).lower()
        if status == "failed":
            status = "failed"
        elif status == "ok":
            status = "passed"
        return {"runner": "libtest", "name": m.group(1), "status": status}
    m = PYTEST_RE.match(s)
    if m:
        return {"runner": "pytest", "name": m.group(1), "status": m.group(2).lower()}
    m = SWIFT_XC_RE.match(s)
    if m:
        return {
            "runner": "xctest",
            "name": m.group(1),
            "status": "passed" if m.group(2) == "passed" else "failed",
        }
    m = SWIFT_TESTING_RE.match(s)
    if m:
        name = m.group(1) or m.group(2)
        return {
            "runner": "swift-testing",
            "name": name.strip(),
            "status": "passed" if m.group(3) == "passed" else "failed",
        }
    m = CARGO_RESULT_RE.match(s)
    if m:
        return {
            "runner": "libtest-summary",
            "name": "*summary*",
            "status": m.group(1).lower(),
            "passed": m.group(2),
            "failed": m.group(3),
            "ignored": m.group(4),
        }
    m = CARGO_RUNNING_RE.match(s)
    if m:
        return {"runner": "cargo", "name": m.group(1).strip(), "status": "running"}
    m = VITEST_RE.match(s)
    if m:
        mark = m.group(1)
        status = "passed" if mark in {"✓", "✔", "√"} else "failed"
        return {"runner": "vitest", "name": m.group(2).strip(), "status": status}
    return None


def is_test_result(ev: dict[str, str]) -> bool:
    if ev.get("name") == "*summary*":
        return False
    if ev.get("status") == "running":
        return False
    return ev.get("runner") in {
        "libtest",
        "pytest",
        "xctest",
        "swift-testing",
        "vitest",
    }


def snapshot_processes() -> dict[int, dict[str, Any]]:
    try:
        out = subprocess.check_output(
            ["ps", "-ax", "-o", "pid=,ppid=,pgid=,stat=,command="],
            text=True,
            errors="replace",
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return {}
    procs: dict[int, dict[str, Any]] = {}
    for line in out.splitlines():
        line = line.lstrip()
        parts = line.split(None, 4)
        if len(parts) < 5:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
            pgid = int(parts[2])
        except ValueError:
            continue
        procs[pid] = {
            "pid": pid,
            "ppid": ppid,
            "pgid": pgid,
            "stat": parts[3],
            "command": parts[4],
        }
    return procs


def descendants_of(root_pid: int, procs: dict[int, dict[str, Any]]) -> set[int]:
    by_ppid: dict[int, list[int]] = defaultdict(list)
    for pid, info in procs.items():
        by_ppid[info["ppid"]].append(pid)
    out: set[int] = set()
    stack = [root_pid]
    while stack:
        p = stack.pop()
        for c in by_ppid.get(p, []):
            if c not in out:
                out.add(c)
                stack.append(c)
    return out


def git_toplevel(cwd: str) -> str | None:
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            text=True,
            stderr=subprocess.DEVNULL,
        )
        return out.strip() or None
    except (OSError, subprocess.CalledProcessError):
        return None


def git_porcelain(cwd: str) -> list[dict[str, str]]:
    try:
        out = subprocess.check_output(
            ["git", "status", "--porcelain=v1", "-uall"],
            cwd=cwd,
            text=True,
            errors="replace",
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return []
    rows = []
    for line in out.splitlines():
        if not line:
            continue
        status = line[:2]
        path = line[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        rows.append({"status": status, "path": path})
    return rows


def porcelain_set(rows: list[dict[str, str]]) -> set[tuple[str, str]]:
    return {(r["status"], r["path"]) for r in rows}


def should_prune_dir(name: str, include_caches: bool) -> bool:
    if name in {".git"}:
        return True
    if include_caches:
        return False
    return name in PRUNE_DIR_NAMES


def iter_files(root: str, include_caches: bool, max_files: int = 200_000):
    root = normpath(root)
    n = 0
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = [d for d in dirnames if not should_prune_dir(d, include_caches)]
        for name in filenames:
            if name in IGNORE_FILE_NAMES:
                continue
            n += 1
            if n > max_files:
                return
            yield os.path.join(dirpath, name)


def file_meta(path: str) -> dict[str, Any] | None:
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not os.path.isfile(path) and not os.path.islink(path):
        return None
    digest = None
    if st.st_size <= 65536 and os.path.isfile(path):
        try:
            h = hashlib.sha1()
            with open(path, "rb") as fh:
                h.update(fh.read())
            digest = h.hexdigest()
        except OSError:
            digest = None
    return {
        "path": path,
        "mtime": st.st_mtime,
        "mtime_ns": getattr(st, "st_mtime_ns", int(st.st_mtime * 1e9)),
        "size": st.st_size,
        "sha1": digest,
    }


def walk_snapshot(roots: list[str], include_caches: bool) -> dict[str, dict[str, Any]]:
    snap: dict[str, dict[str, Any]] = {}
    for root in roots:
        if not root or not os.path.isdir(root):
            continue
        for path in iter_files(root, include_caches):
            meta = file_meta(path)
            if meta:
                snap[normpath(path)] = meta
    return snap


def diff_snapshots(
    before: dict[str, dict[str, Any]], after: dict[str, dict[str, Any]]
) -> dict[str, list[dict[str, Any]]]:
    created = []
    deleted = []
    updated = []
    for path, meta in after.items():
        if path not in before:
            created.append(meta)
        else:
            prev = before[path]
            content_changed = (
                prev.get("sha1")
                and meta.get("sha1")
                and prev["sha1"] != meta["sha1"]
            )
            time_changed = prev.get("mtime_ns") != meta.get("mtime_ns")
            size_changed = prev["size"] != meta["size"]
            if content_changed or time_changed or size_changed:
                updated.append(
                    {
                        **meta,
                        "prev_mtime": prev["mtime"],
                        "prev_size": prev["size"],
                    }
                )
    for path, meta in before.items():
        if path not in after:
            deleted.append(meta)
    return {"created": created, "updated": updated, "deleted": deleted}


def which(cmd: str) -> str | None:
    return shutil.which(cmd)


def start_fswatch(paths: list[str], include_caches: bool) -> subprocess.Popen | None:
    exe = which("fswatch")
    if not exe:
        return None
    watch = [p for p in paths if p and os.path.exists(p)]
    if not watch:
        return None
    cmd = [
        exe,
        "-0",
        "-r",
        "--latency",
        "0.05",
        "--format",
        "%f\x1f%p",
        "--event-flag-separator",
        ",",
        "--extended",
    ]
    if not include_caches:
        for name in sorted(PRUNE_DIR_NAMES):
            cmd.extend(["--prune", rf"(^|/){re.escape(name)}$"])
    cmd.extend(watch)
    try:
        return subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
        )
    except OSError:
        return None


def parse_fswatch_record(rec: bytes) -> tuple[str, str] | None:
    try:
        text = rec.decode("utf-8", "replace")
    except Exception:
        return None
    if "\x1f" not in text:
        # fall back: flags may be empty
        flags, _, path = text.partition(" ")
        path = path or flags
        flags = flags if path != flags else ""
        return flags, path
    flags, path = text.split("\x1f", 1)
    return flags, path


class Timeline:
    def __init__(self, cap: int = 20000):
        self.cap = cap
        self.lock = threading.Lock()
        self.events: list[dict[str, Any]] = []
        self.dropped = 0

    def add(self, event: dict[str, Any]) -> None:
        with self.lock:
            if len(self.events) >= self.cap:
                self.dropped += 1
                return
            self.events.append(event)

    def snapshot(self) -> list[dict[str, Any]]:
        with self.lock:
            return list(self.events)


def pump_stdio(
    src,
    dest,
    stream: str,
    t0: float,
    timeline: Timeline,
    tests: list[dict[str, Any]],
    tests_lock: threading.Lock,
    quiet: bool,
    watch_roots: list[str] | None = None,
    include_caches: bool = False,
    test_snaps: list[dict[str, dict[str, Any]]] | None = None,
) -> None:
    while True:
        line = src.readline()
        if not line:
            break
        t = monotonic() - t0
        if not quiet and dest is not None:
            try:
                dest.write(line)
                dest.flush()
            except BrokenPipeError:
                pass
        text = line.decode("utf-8", "replace")
        timeline.add(
            {
                "t": round(t, 4),
                "kind": "stdio",
                "stream": stream,
                "line": text.rstrip("\n"),
            }
        )
        parsed = parse_test_line(text)
        if parsed and is_test_result(parsed):
            ev = {**parsed, "t": round(t, 4)}
            snap = None
            if watch_roots:
                snap = walk_snapshot(watch_roots, include_caches)
            with tests_lock:
                tests.append(ev)
                if test_snaps is not None and snap is not None:
                    test_snaps.append(snap)
            timeline.add({"t": round(t, 4), "kind": "test", **ev})


def fswatch_reader(
    proc: subprocess.Popen,
    t0: float,
    timeline: Timeline,
    ignore_pids: set[int],
    include_caches: bool,
    tmp_roots: list[str],
) -> None:
    assert proc.stdout is not None
    buf = b""
    while True:
        chunk = proc.stdout.read(8192)
        if not chunk:
            break
        buf += chunk
        *parts, buf = buf.split(b"\0")
        receipt = monotonic() - t0
        for rec in parts:
            if not rec:
                continue
            parsed = parse_fswatch_record(rec)
            if not parsed:
                continue
            flags, path = parsed
            if not path:
                continue
            npath = normpath(path)
            if os.path.basename(npath) in IGNORE_FILE_NAMES:
                continue
            parts_set = path_parts(npath)
            if ".git" in parts_set:
                continue
            if not include_caches and (parts_set & (PRUNE_DIR_NAMES - {".git"})):
                # still keep tmp
                if not looks_tmp(npath, tmp_roots):
                    continue
            kind = "fs"
            timeline.add(
                {
                    "t": round(receipt, 4),
                    "kind": kind,
                    "flags": flags,
                    "path": npath,
                    "class": classify_path(npath, tmp_roots),
                }
            )


def poll_walker(
    stop: threading.Event,
    roots: list[str],
    include_caches: bool,
    t0: float,
    timeline: Timeline,
    interval: float,
    tmp_roots: list[str],
) -> None:
    prev = walk_snapshot(roots, include_caches)
    while not stop.wait(interval):
        cur = walk_snapshot(roots, include_caches)
        t = monotonic() - t0
        diff = diff_snapshots(prev, cur)
        for meta in diff["created"]:
            timeline.add(
                {
                    "t": round(t, 4),
                    "kind": "fs",
                    "flags": "Created",
                    "path": meta["path"],
                    "class": classify_path(meta["path"], tmp_roots),
                    "size": meta["size"],
                }
            )
        for meta in diff["updated"]:
            timeline.add(
                {
                    "t": round(t, 4),
                    "kind": "fs",
                    "flags": "Updated",
                    "path": meta["path"],
                    "class": classify_path(meta["path"], tmp_roots),
                    "size": meta["size"],
                }
            )
        for meta in diff["deleted"]:
            timeline.add(
                {
                    "t": round(t, 4),
                    "kind": "fs",
                    "flags": "Removed",
                    "path": meta["path"],
                    "class": classify_path(meta["path"], tmp_roots),
                }
            )
        prev = cur


def harvest_descendants(
    root_pid: int,
    tracked: set[int],
    lock: threading.Lock,
    ignore: set[int],
) -> None:
    procs = snapshot_processes()
    with lock:
        tracked.add(root_pid)
        extra: set[int] = set()
        for pid in list(tracked):
            extra |= descendants_of(pid, procs)
        for pid, info in procs.items():
            if info["ppid"] in tracked and pid not in ignore:
                extra.add(pid)
            # Children that called setsid() still show ppid=root for a beat.
            if info["ppid"] == root_pid and pid not in ignore:
                extra.add(pid)
        tracked |= extra


def proc_sampler(
    stop: threading.Event,
    root_pid: int,
    tracked: set[int],
    lock: threading.Lock,
    interval: float,
    ignore: set[int],
) -> None:
    harvest_descendants(root_pid, tracked, lock, ignore)
    while not stop.wait(interval):
        harvest_descendants(root_pid, tracked, lock, ignore)
    harvest_descendants(root_pid, tracked, lock, ignore)


def collisions_from_writers(by_test: dict[str, list[dict[str, Any]]]) -> list[dict[str, Any]]:
    writers: dict[str, set[str]] = defaultdict(set)
    for name, evs in by_test.items():
        for ev in evs:
            path = ev.get("path")
            flags = ev.get("flags") or ""
            if path and not any(x in flags for x in ("Removed", "Renamed")):
                writers[path].add(name)
    collisions = []
    for path, names in sorted(writers.items()):
        if len(names) > 1:
            collisions.append({"path": path, "tests": sorted(names)})
    return collisions


def attribute_fs_to_tests(
    fs_events: list[dict[str, Any]], tests: list[dict[str, Any]]
) -> tuple[dict[str, list[dict[str, Any]]], list[dict[str, Any]]]:
    """Events in (prev_test.t, this_test.t] belong to this_test.

    libtest / pytest print the name when the test finishes, so boundary
    snapshots recover per-test residue without syscall tracing.
    """
    if not tests:
        return {}, []
    ordered = sorted(tests, key=lambda e: e["t"])
    by_test: dict[str, list[dict[str, Any]]] = defaultdict(list)
    bounds = []
    prev_t = 0.0
    for te in ordered:
        bounds.append((prev_t, te["t"], te["name"]))
        prev_t = te["t"]
    for ev in fs_events:
        t = ev.get("t", 0.0)
        assigned = None
        for start, end, name in bounds:
            if start < t <= end:
                assigned = name
                break
        if assigned:
            by_test[assigned].append(ev)
    return dict(by_test), collisions_from_writers(by_test)


def attribute_snaps_to_tests(
    before: dict[str, dict[str, Any]],
    test_snaps: list[dict[str, dict[str, Any]]],
    tests: list[dict[str, Any]],
    tmp_roots: list[str],
) -> tuple[dict[str, list[dict[str, Any]]], list[dict[str, Any]]]:
    if not tests or not test_snaps:
        return {}, []
    by_test: dict[str, list[dict[str, Any]]] = defaultdict(list)
    prev = before
    for te, snap in zip(tests, test_snaps):
        diff = diff_snapshots(prev, snap)
        for meta in diff["created"] + diff["updated"]:
            by_test[te["name"]].append(
                {
                    "t": te["t"],
                    "kind": "fs",
                    "flags": "Updated",
                    "path": meta["path"],
                    "class": classify_path(meta["path"], tmp_roots),
                    "via": "test-boundary",
                }
            )
        prev = snap
    return dict(by_test), collisions_from_writers(by_test)


def aggregate_by_class(paths: Iterable[str], tmp_roots: list[str]) -> dict[str, int]:
    counts: dict[str, int] = defaultdict(int)
    for p in paths:
        counts[classify_path(p, tmp_roots)] += 1
    return dict(counts)


def resolve_declared(product: Path, declared: str, root: Path) -> Path:
    declared = declared.strip().lstrip("./")
    candidates = [
        product.parent / declared,
        root / declared,
        product.parent.parent / declared,
        product.parent.parent.parent / declared,
    ]
    for c in candidates:
        try:
            if c.exists():
                return c.resolve()
        except OSError:
            continue
    return (root / declared)


def restamp_generated(g: dict[str, Any], topo: Path) -> None:
    declared = g.get("declared_source")
    path = g["abs_path"]
    if not declared:
        g["status"] = "undeclared"
        g["lag_s"] = None
        return
    sp = resolve_declared(Path(path), declared, topo)
    g["source_path"] = str(sp)
    if not sp.exists():
        g["status"] = "orphan-source"
        g["lag_s"] = None
        return
    try:
        source_mtime = os.path.getmtime(sp)
    except OSError:
        source_mtime = None
    g["source_mtime"] = source_mtime
    parent = sp.parent
    tree_mtime = None
    tree_path = None
    if parent.name in {"specs", "spec", "schemas", "schema", "contracts"}:
        tree_path = str(parent)
        newest = source_mtime or 0.0
        try:
            for dirpath, dirnames, filenames in os.walk(parent):
                dirnames[:] = [d for d in dirnames if d not in PRUNE_DIR_NAMES]
                for name in filenames:
                    fp = os.path.join(dirpath, name)
                    try:
                        newest = max(newest, os.path.getmtime(fp))
                    except OSError:
                        pass
        except OSError:
            pass
        tree_mtime = newest
        compare_mtime = tree_mtime
    else:
        compare_mtime = source_mtime
    g["source_tree"] = tree_path
    g["source_tree_mtime"] = tree_mtime
    product_mtime = g["mtime"]
    g["status"] = "fresh"
    if compare_mtime is not None and compare_mtime > product_mtime + 1.0:
        g["status"] = "stale"
    g["lag_s"] = (
        round((tree_mtime or source_mtime) - product_mtime, 3)
        if (tree_mtime or source_mtime) is not None
        else None
    )


def inherit_sibling_sources(generated: list[dict[str, Any]], topo: Path) -> None:
    by_dir: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for g in generated:
        by_dir[str(Path(g["abs_path"]).parent)].append(g)
    for g in generated:
        if g.get("declared_source"):
            continue
        parent = Path(g["abs_path"]).parent
        donor = None
        for _ in range(4):
            candidates = [
                x for x in by_dir.get(str(parent), []) if x.get("declared_source")
            ]
            if candidates:
                donor = candidates[0]
                break
            if parent == parent.parent:
                break
            parent = parent.parent
        if not donor:
            continue
        g["declared_source"] = donor["declared_source"]
        g["declared_generator"] = g.get("declared_generator") or donor.get(
            "declared_generator"
        )
        g["inherited_source"] = True
        restamp_generated(g, topo)


def inspect_tree(root: str, include_caches: bool, burst_gap: float = 2.0) -> dict[str, Any]:
    root_n = normpath(root)
    topo = git_toplevel(root_n) or root_n
    generated: list[dict[str, Any]] = []
    mtimes: list[tuple[str, float, int]] = []
    scanned = 0
    for path in iter_files(root_n, include_caches=include_caches):
        scanned += 1
        meta = file_meta(path)
        if not meta:
            continue
        mtimes.append((path, meta["mtime"], meta["size"]))
        if not looks_generated_file(path):
            continue
        header = read_header(path)
        declared = parse_declared_source(header)
        generator = parse_declared_generator(header)
        rec = {
            "path": os.path.relpath(path, root_n) if is_under(path, root_n) else path,
            "abs_path": path,
            "mtime": meta["mtime"],
            "mtime_iso": iso(meta["mtime"]),
            "size": meta["size"],
            "declared_source": declared,
            "declared_generator": generator,
            "source_path": None,
            "source_mtime": None,
            "source_tree": None,
            "source_tree_mtime": None,
            "status": "undeclared",
            "lag_s": None,
            "inherited_source": False,
        }
        restamp_generated(rec, Path(topo))
        generated.append(rec)
    inherit_sibling_sources(generated, Path(topo))

    mtimes.sort(key=lambda x: x[1])
    bursts: list[list[tuple[str, float, int]]] = []
    current: list[tuple[str, float, int]] = []
    for item in mtimes:
        if not current or item[1] - current[-1][1] <= burst_gap:
            current.append(item)
        else:
            bursts.append(current)
            current = [item]
    if current:
        bursts.append(current)
    bursts.sort(key=lambda b: len(b), reverse=True)
    burst_out = []
    for b in bursts[:8]:
        if len(b) < 3:
            continue
        classes = aggregate_by_class([p for p, _, _ in b], [])
        burst_out.append(
            {
                "count": len(b),
                "t_start": iso(b[0][1]),
                "t_end": iso(b[-1][1]),
                "span_s": round(b[-1][1] - b[0][1], 3),
                "classes": classes,
                "sample": [
                    os.path.relpath(p, root_n) if is_under(p, root_n) else p
                    for p, _, _ in b[:5]
                ],
            }
        )

    counts = defaultdict(int)
    for g in generated:
        counts[g["status"]] += 1

    return {
        "tool": "spoor",
        "version": VERSION,
        "mode": "inspect",
        "root": root_n,
        "git_toplevel": topo,
        "scanned_files": scanned,
        "generated_count": len(generated),
        "generated_status": dict(counts),
        "generated": generated,
        "write_bursts": burst_out,
    }


