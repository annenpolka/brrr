            lines.append(f"  ... {len(report['late_writes']) - 20} more")
        lines.append("")
    leaked = report.get("leaked_processes") or []
    if leaked:
        lines.append(f"leaked processes ({len(leaked)}):")
        for p in leaked[:15]:
            cmd = p["command"]
            if len(cmd) > 100:
                cmd = cmd[:97] + "..."
            lines.append(f"  pid {p['pid']:<6} {p['stat']:<4} {cmd}")
        lines.append("")
    else:
        lines.append("leaked processes: none")
        lines.append("")
    git_res = report.get("git_residue") or {}
    intro = git_res.get("introduced") or []
    if intro:
        lines.append("git residue (introduced):")
        for row in intro[:30]:
            lines.append(f"  {row['status']} {row['path']}")
        if len(intro) > 30:
            lines.append(f"  ... {len(intro) - 30} more")
        lines.append("")
    else:
        lines.append("git residue: none")
        lines.append("")
    tmp = report.get("tmp_residue") or []
    if tmp:
        lines.append(f"tmp residue ({len(tmp)}):")
        for p in tmp[:20]:
            lines.append(f"  {p['op']:<7} {p['path']}")
        if len(tmp) > 20:
            lines.append(f"  ... {len(tmp) - 20} more")
        lines.append("")
    coll = report.get("collisions") or []
    if coll:
        lines.append(f"test collisions ({len(coll)} paths written by >1 test):")
        for c in coll[:20]:
            lines.append(f"  {c['path']}")
            lines.append(f"    tests: {', '.join(c['tests'])}")
        lines.append("")
    else:
        if tests.get("count"):
            lines.append("test collisions: none")
            lines.append("")
    residue = report.get("fs_diff") or {}
    created = residue.get("created") or []
    if created:
        by_c = aggregate_by_class([c["path"] for c in created], report.get("tmp_roots") or [])
        lines.append(f"created files: {len(created)}  {by_c}")
        interesting = [
            c
            for c in created
            if classify_path(c["path"], report.get("tmp_roots") or [])
            in {"source", "generated", "tmp"}
        ]
        for c in interesting[:15]:
            rel = c["path"]
            lines.append(f"  + {classify_path(rel, report.get('tmp_roots') or []):<9} {rel}")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def kill_pids(pids: Iterable[int]) -> None:
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    time.sleep(0.05)
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass


def run_command(args: argparse.Namespace) -> dict[str, Any]:
    cwd = normpath(args.cwd or os.getcwd())
    command = list(args.command)
    if not command:
        raise SystemExit("spoor: missing command after --")

    env = os.environ.copy()
    sandbox = None
    tmp_roots = []
    if args.sandbox_tmp:
        sandbox = tempfile.mkdtemp(prefix="spoor-tmp-")
        env["TMPDIR"] = sandbox
        env["TEMP"] = sandbox
        env["TMP"] = sandbox
        tmp_roots.append(sandbox)
    env_tmp = env.get("TMPDIR") or env.get("TMP") or "/tmp"
    tmp_roots.append(normpath(env_tmp))
    if os.path.isdir("/tmp"):
        tmp_roots.append("/tmp")
    if os.path.isdir("/private/tmp"):
        tmp_roots.append("/private/tmp")

    watch_paths = []
    if sandbox:
        watch_paths.append(sandbox)
    if args.watch_tmp:
        watch_paths.append(normpath(env_tmp))
    if args.watch_cwd:
        watch_paths.append(cwd)
    for extra in args.watch or []:
        watch_paths.append(normpath(extra))
    # de-dup
    seen_w = set()
    watch_uniq = []
    for p in watch_paths:
        if p not in seen_w:
            seen_w.add(p)
            watch_uniq.append(p)
    watch_paths = watch_uniq

    git_before = git_porcelain(cwd)
    snap_roots = list(watch_paths)
    if args.snapshot_tree and cwd not in snap_roots:
        snap_roots.append(cwd)
    before_snap = walk_snapshot(snap_roots, args.include_caches) if snap_roots else {}

    timeline = Timeline(cap=args.max_events)
    tests: list[dict[str, Any]] = []
    test_snaps: list[dict[str, dict[str, Any]]] = []
    tests_lock = threading.Lock()
    t0 = monotonic()
    t0_wall = wallclock()
    waitpid_wall = None

    fsw = None
    if watch_paths and not args.poll:
        fsw = start_fswatch(watch_paths, args.include_caches)
    stop_poll = threading.Event()
    watch_backend = "git-bookend"
    reader_thread = None
    if fsw is not None:
        watch_backend = "fswatch"
        reader_thread = threading.Thread(
            target=fswatch_reader,
            args=(fsw, t0, timeline, set(), args.include_caches, tmp_roots),
            daemon=True,
        )
        reader_thread.start()
        # FSEvents is not live the instant fswatch execs. Give a tiny arming window
        # when the watched set is small so the first writes are not lost.
        time.sleep(0.05)
    poll_thread = None
    if watch_paths:
        # Poll even when fswatch is up: small watch roots, and it feeds
        # test-boundary attribution when FSEvents is late to arm.
        if fsw is None:
            watch_backend = "poll"
        else:
            watch_backend = "fswatch+poll"
        poll_thread = threading.Thread(
            target=poll_walker,
            args=(
                stop_poll,
                watch_paths,
                args.include_caches,
                t0,
                timeline,
                max(args.poll_ms, 20) / 1000.0,
                tmp_roots,
            ),
            daemon=True,
        )
        poll_thread.start()

    child = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=cwd,
        env=env,
        start_new_session=True,
    )
    ignore_pids = {os.getpid(), os.getppid()}
    if fsw is not None:
        ignore_pids.add(fsw.pid)

    tracked: set[int] = {child.pid}
    tracked_lock = threading.Lock()
    stop_ps = threading.Event()
    ps_thread = threading.Thread(
        target=proc_sampler,
        args=(
            stop_ps,
            child.pid,
            tracked,
            tracked_lock,
            max(args.poll_ms, 20) / 1000.0,
            ignore_pids,
        ),
        daemon=True,
    )
    ps_thread.start()

    quiet = args.quiet or args.json
    t_out = threading.Thread(
        target=pump_stdio,
        args=(
            child.stdout,
            sys.stdout.buffer,
            "stdout",
            t0,
            timeline,
            tests,
            tests_lock,
            quiet,
            watch_paths,
            args.include_caches,
            test_snaps,
        ),
        daemon=True,
    )
    t_err = threading.Thread(
        target=pump_stdio,
        args=(
            child.stderr,
            sys.stderr.buffer,
            "stderr",
            t0,
            timeline,
            tests,
            tests_lock,
            quiet,
            None,
            False,
            None,
        ),
        daemon=True,
    )
    t_out.start()
    t_err.start()

    timed_out = False
    try:
        child.wait(timeout=args.timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except OSError:
            child.terminate()
        try:
            child.wait(timeout=1.5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except OSError:
                child.kill()
            child.wait()

    t_out.join(timeout=2)
    t_err.join(timeout=2)
    waitpid_t = monotonic() - t0
    waitpid_wall = wallclock()
    timeline.add({"t": round(waitpid_t, 4), "kind": "waitpid", "pid": child.pid})

    settle_s = args.settle_ms / 1000.0
    settle_timeout = args.settle_timeout_ms / 1000.0
    last_fs = waitpid_t
    settle_deadline = waitpid_t + settle_timeout
    while True:
        now = monotonic() - t0
        if now >= settle_deadline:
            break
        events = timeline.snapshot()
        fs_after = [e for e in events if e.get("kind") == "fs" and e.get("t", 0) >= waitpid_t]
        if fs_after:
            last_fs = max(last_fs, max(e["t"] for e in fs_after))
        if now - last_fs >= settle_s:
            break
        time.sleep(max(args.poll_ms, 20) / 1000.0)

    t_end = monotonic() - t0
    stop_ps.set()
    stop_poll.set()
    if fsw is not None:
        try:
            fsw.terminate()
            fsw.wait(timeout=1)
        except Exception:
            try:
                fsw.kill()
            except OSError:
                pass
    if reader_thread is not None:
        reader_thread.join(timeout=1.5)
    if poll_thread is not None:
        poll_thread.join(timeout=1.5)
    ps_thread.join(timeout=1)

    after_snap = walk_snapshot(snap_roots, args.include_caches) if snap_roots else {}
    git_after = git_porcelain(cwd)
    fs_diff = diff_snapshots(before_snap, after_snap) if snap_roots else {"created": [], "updated": [], "deleted": []}

    procs_now = snapshot_processes()
    with tracked_lock:
        tracked_copy = set(tracked)
    leaked = []
    for pid in sorted(tracked_copy):
        if pid in ignore_pids or pid == child.pid:
            continue
        info = procs_now.get(pid)
        if not info:
            continue
        if str(info["stat"]).startswith("Z"):
            continue
        leaked.append(info)

    events = timeline.snapshot()
    fs_events = [e for e in events if e.get("kind") == "fs"]
    with tests_lock:
        test_list = list(tests)
        snaps_copy = list(test_snaps)
    by_watch, coll_watch = attribute_fs_to_tests(fs_events, test_list)
    by_snap, coll_snap = attribute_snaps_to_tests(
        before_snap, snaps_copy, test_list, tmp_roots
    )
    by_test: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for src in (by_watch, by_snap):
        for name, evs in src.items():
            by_test[name].extend(evs)
    collisions = coll_snap or coll_watch
    if coll_snap and coll_watch:
        # union by path
        by_path: dict[str, set[str]] = defaultdict(set)
        for c in coll_snap + coll_watch:
            by_path[c["path"]].update(c["tests"])
        collisions = [
            {"path": p, "tests": sorted(ns)} for p, ns in sorted(by_path.items()) if len(ns) > 1
        ]

    before_set = porcelain_set(git_before)
    after_set = porcelain_set(git_after)
    introduced = [
        {"status": s, "path": p} for (s, p) in sorted(after_set - before_set)
    ]
    cleared = [
        {"status": s, "path": p} for (s, p) in sorted(before_set - after_set)
    ]

    tmp_residue = []
    for op, items in fs_diff.items():
        for meta in items:
            if looks_tmp(meta["path"], tmp_roots):
                tmp_residue.append(
                    {
                        "op": op,
                        "path": meta["path"],
                        "size": meta.get("size"),
                    }
                )
    # also leftover files still in sandbox
    if sandbox and os.path.isdir(sandbox):
        for dirpath, _, filenames in os.walk(sandbox):
            for name in filenames:
                p = normpath(os.path.join(dirpath, name))
                if not any(x["path"] == p for x in tmp_residue):
                    try:
                        sz = os.path.getsize(p)
                    except OSError:
                        sz = None
                    tmp_residue.append({"op": "left", "path": p, "size": sz})

    late_watch = late_writes_from_timeline(events, waitpid_t)
    mtime_paths = []
    for row in introduced:
        mtime_paths.append(os.path.join(cwd, row["path"]))
    for op in ("created", "updated"):
        for meta in fs_diff.get(op, []):
            mtime_paths.append(meta["path"])
    for row in tmp_residue:
        mtime_paths.append(row["path"])
    late_mtime = late_writes_from_mtimes(
        mtime_paths, waitpid_wall or wallclock(), tmp_roots
    )
    late = merge_late_writes(late_watch, late_mtime)

    passed = sum(1 for t in test_list if t.get("status") in {"passed", "ok"})
    failed = sum(1 for t in test_list if t.get("status") in {"failed", "error"})
    ignored = sum(1 for t in test_list if t.get("status") in {"ignored", "skipped"})
    runner = test_list[0]["runner"] if test_list else None
    threads = env.get("RUST_TEST_THREADS") or env.get("SPOR_TEST_THREADS")
    attribution = "none"
    if test_list:
        attribution = "test-boundary" if snaps_copy else "stdio-time"
        joined_cmd = " ".join(command)
        looks_parallel_runner = any(
            tok in joined_cmd for tok in ("cargo", "pytest", "vitest", "swift")
        )
        if looks_parallel_runner and threads != "1" and len(test_list) > 1:
            attribution = attribution + "+parallel-best-effort"

    generated_hits = []
    for ev in fs_events:
        p = ev.get("path")
        if p and looks_generated_name(p):
            generated_hits.append(p)

    report = {
        "tool": "spoor",
        "version": VERSION,
        "mode": "run",
        "command": command,
        "cwd": cwd,
        "started_at": iso(t0_wall),
        "exit_code": child.returncode,
        "timed_out": timed_out,
        "duration_ms": int(round(t_end * 1000)),
        "waitpid_ms": int(round(waitpid_t * 1000)),
        "settle_ms": int(round((t_end - waitpid_t) * 1000)),
        "watch_backend": watch_backend if watch_paths else "git-bookend",
        "waitpid_wall": waitpid_wall,
        "sandbox_tmp": sandbox,
        "tmp_roots": tmp_roots,
        "watch_paths": watch_paths,
        "late_writes": late,
        "leaked_processes": leaked,
        "git_residue": {
            "introduced": introduced,
            "cleared": cleared,
            "before_count": len(git_before),
            "after_count": len(git_after),
        },
        "tmp_residue": tmp_residue[:200],
        "fs_diff": {
            "created": fs_diff.get("created", [])[:200],
            "updated": fs_diff.get("updated", [])[:200],
            "deleted": fs_diff.get("deleted", [])[:200],
        },
        "tests": {
            "count": len(test_list),
            "passed": passed,
            "failed": failed,
            "ignored": ignored,
            "runner": runner,
            "attribution": attribution,
            "events": test_list[:500],
        },
        "collisions": collisions,
        "test_snapshot_count": len(snaps_copy),
        "per_test_fs": {
            name: [
                {"t": e.get("t"), "path": e.get("path"), "flags": e.get("flags")}
                for e in evs[:50]
            ]
            for name, evs in list(by_test.items())[:100]
        },
        "generated_writes": sorted(set(generated_hits))[:100],
        "timeline_events": len(events),
        "timeline_dropped": timeline.dropped,
        "timeline": events if args.include_timeline else None,
    }

    if args.kill_leaked and leaked:
        kill_pids([p["pid"] for p in leaked])
        report["killed_leaked"] = [p["pid"] for p in leaked]

    if sandbox and not args.keep_tmp:
        try:
            shutil.rmtree(sandbox, ignore_errors=True)
        except OSError:
            pass

    return report


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="spoor",
        description="Waitpid is a lie. Record the wake a command leaves on disk and the process table.",
    )
    p.add_argument("--version", action="version", version=f"spoor {VERSION}")
    sub = p.add_subparsers(dest="mode")

    run = sub.add_parser("run", help="run a command and record its wake")
    add_run_args(run)

    ins = sub.add_parser(
        "inspect",
        help="without running anything: generated-artifact staleness + mtime write-bursts",
    )
    ins.add_argument("root", nargs="?", default=".", help="directory to inspect")
    ins.add_argument("--json", action="store_true")
    ins.add_argument("--include-caches", action="store_true")
    ins.add_argument("--out", help="write JSON report to PATH")
    return p


def add_run_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("command", nargs=argparse.REMAINDER, help="command after --")
    p.add_argument("--json", action="store_true", help="JSON report on stdout (child stdio quiet)")
    p.add_argument("--out", help="write JSON report to PATH")
    p.add_argument("--quiet", action="store_true", help="do not tee child stdio")
    p.add_argument("--cwd", help="working directory")
    p.add_argument("--settle-ms", type=int, default=350, help="stillness window after last fs event")
    p.add_argument("--settle-timeout-ms", type=int, default=2500, help="max wait after waitpid")
    p.add_argument("--poll-ms", type=int, default=50)
    p.add_argument("--timeout", type=float, default=None, help="kill command after SEC")
    p.add_argument("--sandbox-tmp", action="store_true", help="give the command a private TMPDIR")
    p.add_argument("--keep-tmp", action="store_true")
    p.add_argument("--kill-leaked", action="store_true", help="SIGTERM leftovers after the report")
    p.add_argument("--include-caches", action="store_true", help="watch target/ and node_modules/")
    p.add_argument("--snapshot-tree", action="store_true", help="bookend-walk cwd (slow on big trees)")
    p.add_argument("--watch", action="append", default=[], help="extra path to watch (repeatable)")
    p.add_argument("--watch-cwd", action="store_true", help="fswatch/poll the whole cwd (noisy, slow to arm)")
    p.add_argument("--watch-tmp", action="store_true", help="fswatch/poll the process TMPDIR")
    p.add_argument("--poll", action="store_true", help="force poll backend even if fswatch exists")
    p.add_argument("--include-timeline", action="store_true")
    p.add_argument("--max-events", type=int, default=20000)
    p.add_argument("--forward-exit", action="store_true", help="exit with the child's status")


def strip_command(command: list[str]) -> list[str]:
    if command and command[0] == "--":
        return command[1:]
    return command


def emit_report(report: dict[str, Any], args: argparse.Namespace, human_fn) -> None:
    out_path = getattr(args, "out", None)
    as_json = getattr(args, "json", False) or bool(out_path)
    payload = {k: v for k, v in report.items() if v is not None}
    text = json.dumps(payload, indent=2, default=str)
    if out_path:
        Path(out_path).write_text(text + "\n", encoding="utf-8")
    if getattr(args, "json", False) and not out_path:
        sys.stdout.write(text + "\n")
    else:
        sys.stderr.write(human_fn(report))
        if not getattr(args, "json", False) and not out_path:
            pass


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # implicit run: `spoor -- cmd` or `spoor run -- cmd`
    if argv and argv[0] not in {"run", "inspect", "-h", "--help", "--version"}:
        argv = ["run", *argv]
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.mode:
        parser.print_help()
        return 2
    if args.mode == "inspect":
        report = inspect_tree(args.root, include_caches=args.include_caches)
        emit_report(report, args, human_inspect)
        return 0
    args.command = strip_command(args.command)
    if not args.command:
        print("usage: spoor run [options] -- COMMAND [ARGS...]", file=sys.stderr)
        return 2
    report = run_command(args)
    emit_report(report, args, human_run)
    if args.forward_exit:
        if report.get("timed_out"):
            return 124
        return int(report.get("exit_code") or 0)
    if report.get("timed_out"):
        return 124
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
