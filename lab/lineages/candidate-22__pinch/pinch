# run
# ---------------------------------------------------------------------------


def build_pipeline_script(
    stages: list[list[str]],
    meter_logs: list[str],
    wrap_logs: list[str],
    bufsize: int,
) -> str:
    self = pinch_self()
    chunks: list[str] = []
    for i, argv in enumerate(stages):
        wrap = (
            self
            + ["--wrap", "--log", wrap_logs[i], "--"]
            + argv
        )
        chunks.append(" ".join(shell_quote(a) for a in wrap))
        if i < len(stages) - 1:
            meter = self + [
                "--meter",
                "--log",
                meter_logs[i],
                "--buf-size",
                str(bufsize),
            ]
            chunks.append(" ".join(shell_quote(a) for a in meter))
    return "set -o pipefail; " + " | ".join(chunks)


def load_json(path: str) -> dict[str, Any]:
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}


def run_pipeline(
    stages: list[list[str]],
    *,
    json_out: bool,
    report_path: Optional[str],
    sample_ms: int,
    bufsize: int,
    labels: dict[int, str],
) -> int:
    if not stages:
        print("pinch: no command", file=sys.stderr)
        return 2

    tmp = tempfile.mkdtemp(prefix="pinch-")
    meter_logs = [os.path.join(tmp, f"m{i}.json") for i in range(max(0, len(stages) - 1))]
    wrap_logs = [os.path.join(tmp, f"s{i}.json") for i in range(len(stages))]
    script = build_pipeline_script(stages, meter_logs, wrap_logs, bufsize)

    samples: list[dict[str, Any]] = []
    stop = [False]
    sampler = None

    t0 = time.monotonic()
    proc = subprocess.Popen(
        ["bash", "-c", script],
        stdin=sys.stdin,
        stdout=sys.stdout,
        stderr=sys.stderr,
        start_new_session=True,
    )
    pgid = os.getpgid(proc.pid)

    if sample_ms > 0:
        import threading

        sampler = threading.Thread(
            target=sample_loop,
            args=(pgid, sample_ms / 1000.0, samples, stop),
            daemon=True,
        )
        sampler.start()

    try:
        rc = proc.wait()
    except KeyboardInterrupt:
        try:
            os.killpg(pgid, signal.SIGTERM)
        except OSError:
            pass
        rc = 130
    finally:
        stop[0] = True
        if sampler is not None:
            sampler.join(timeout=0.5)
    wall_s = time.monotonic() - t0

    # harvest
    harvested_stages: list[dict[str, Any]] = []
    for i, argv in enumerate(stages):
        wrap = load_json(wrap_logs[i])
        label = labels.get(i) or default_label(argv)
        cpu = float(wrap.get("ru_utime") or 0) + float(wrap.get("ru_stime") or 0)
        st_wall = ns_to_s(wrap.get("wall_ns"))
        harvested_stages.append(
            {
                "i": i,
                "argv": argv,
                "label": label,
                "exit": wrap.get("exit"),
                "pid": wrap.get("pid"),
                "wall_s": st_wall,
                "ru_utime": wrap.get("ru_utime"),
                "ru_stime": wrap.get("ru_stime"),
                "ru_maxrss": wrap.get("ru_maxrss"),
                "cpu_s": cpu,
                "cpu_frac": (cpu / st_wall) if st_wall > 0 else None,
            }
        )

    links: list[dict[str, Any]] = []
    for i, path in enumerate(meter_logs):
        m = load_json(path)
        wall = ns_to_s(m.get("wall_ns"))
        rs = ns_to_s(m.get("read_stall_ns"))
        ws = ns_to_s(m.get("write_stall_ns"))
        bs = ns_to_s(m.get("both_stall_ns"))
        links.append(
            {
                "from": i,
                "to": i + 1,
                "bytes": int(m.get("bytes") or 0),
                "reads": int(m.get("reads") or 0),
                "writes": int(m.get("writes") or 0),
                "read_stall_s": rs,
                "write_stall_s": ws,
                "both_stall_s": bs,
                "copy_s": ns_to_s(m.get("copy_ns")),
                "wall_s": wall,
                "epipe": bool(m.get("epipe")),
                "read_eof": bool(m.get("read_eof")),
            }
        )

    sample_summary = fold_samples(samples, wall_s)
    inner = analyze_inner(samples)
    sample_summary["inner"] = {
        "workers": inner.get("workers"),
        "busy_frac": inner.get("busy_frac"),
        "phases": inner.get("phases"),
    }
    # Single-command busy should ignore meter/wrap sleepers.
    if inner.get("busy_frac") is not None and len(harvested_stages) == 1:
        harvested_stages[0]["sample_busy_frac"] = inner["busy_frac"]

    pinch = classify(harvested_stages, links, wall_s)
    apply_inner(pinch, inner, harvested_stages)
    report = {
        "tool": "pinch",
        "version": VERSION,
        "wall_s": wall_s,
        "exit": rc,
        "stages": harvested_stages,
        "links": links,
        "pinch": pinch,
        "samples": sample_summary,
        "tmpdir": tmp,
    }

    text = render_report(report)
    raw = json.dumps(report, indent=2, sort_keys=False) + "\n" if json_out else text
    write_report(raw if json_out else text, report_path)
    if json_out and report_path is None:
        # already written to stderr via write_report
        pass
    return rc if rc is not None else 1


def write_report(text: str, report_path: Optional[str]) -> None:
    if report_path is None:
        sys.stderr.write(text)
        if not text.endswith("\n"):
            sys.stderr.write("\n")
        return
    if report_path == "-":
        sys.stdout.write(text)
        if not text.endswith("\n"):
            sys.stdout.write("\n")
        return
    with open(report_path, "w", encoding="utf-8") as fh:
        fh.write(text)
        if not text.endswith("\n"):
            fh.write("\n")


def fmt_bytes(n: int) -> str:
    if n < 1024:
        return f"{n}B"
    if n < 1024 ** 2:
        return f" {n / 1024:.1f}KB"
    if n < 1024 ** 3:
        return f"{n / 1024 ** 2:.2f}MB"
    return f"{n / 1024 ** 3:.2f}GB"


def bar(frac: float, width: int = 12) -> str:
    frac = max(0.0, min(1.0, frac))
    filled = int(round(frac * width))
    return "█" * filled + "░" * (width - filled)


def render_report(report: dict[str, Any]) -> str:
    wall = report["wall_s"]
    rc = report["exit"]
    stages = report["stages"]
    links = report["links"]
    pinch = report["pinch"]
    lines: list[str] = []
    lines.append(f"pinch {VERSION}   wall {wall:.3f}s   exit {rc}   stages {len(stages)}")
    lines.append("")
    for i, st in enumerate(stages):
        cpu = st.get("cpu_s") or 0.0
        cpu_frac = st.get("cpu_frac")
        if cpu_frac is None and st.get("wall_s"):
            cpu_frac = cpu / st["wall_s"]
        cpu_frac = cpu_frac or 0.0
        mark = ""
        if pinch.get("stage") == i and pinch.get("kind") not in {"balanced", "none"}:
            mark = f"   ◀ PINCH ({pinch.get('kind')})"
        lines.append(
            f"  [{i}] {st['label']:<42} cpu {cpu:6.3f}s  {bar(cpu_frac)} {cpu_frac:5.0%}{mark}"
        )
        if i < len(links):
            lk = links[i]
            rel = lk.get("relation") or "?"
            rs, ws = lk["read_stall_s"], lk["write_stall_s"]
            who = ""
            if rel == "blocked-on-write":
                who = f"  stage {i} waited on stage {i + 1}"
            elif rel == "blocked-on-read":
                who = f"  stage {i + 1} waited on stage {i}"
            lines.append(
                f"       │ {fmt_bytes(lk['bytes']):>8}   "
                f"read-stall {rs:6.3f}s   write-stall {ws:6.3f}s   {rel}{who}"
            )
            lines.append("       ▼")
    if links:
        # drop trailing arrow visual: last ▼ sits under last non-final stage, ok
        if lines[-1].strip() == "▼":
            lines.pop()
    lines.append("")
    lines.append("who waited for whom:")
    waits = pinch.get("wait_for") or []
    if not waits:
        lines.append("  (no blocking relationship above noise)")
    else:
        for w in sorted(waits, key=lambda x: -x["waited_s"]):
            a, b = w["waiter"], w["on"]
            la = stages[a]["label"] if a < len(stages) else str(a)
            lb = stages[b]["label"] if b < len(stages) else str(b)
            lines.append(f"  [{a}] {la}  waited {w['waited_s']:.3f}s  ({w['reason']})  on  [{b}] {lb}")
    lines.append("")
    reason = pinch.get("reason") or ""
    if pinch.get("kind") == "balanced":
        lines.append(f"verdict: balanced — {reason}")
    elif pinch.get("stage") is None:
        lines.append(f"verdict: {reason}")
    else:
        i = pinch["stage"]
        lines.append(f"verdict: pinch is [{i}] {stages[i]['label']} ({pinch.get('kind')}) — {reason}")
    samp = report.get("samples") or {}
    inner = (samp.get("inner") or {})
    workers = inner.get("workers") or {}
    if workers:
        lines.append("inner tree (wrappers omitted):")
        named = (pinch.get("inner") or {}).get("comm")
        for comm, w in sorted(workers.items(), key=lambda kv: -kv[1].get("run", 0)):
            tot = (w.get("run") or 0) + (w.get("sleep") or 0) + (w.get("other") or 0)
            frac = w.get("run_frac") or 0.0
            mark = "   ◀ inner pinch" if comm == named else ""
            lines.append(
                f"  {comm:<22} {bar(frac)} {frac:5.0%} run  "
                f"{w.get('run', 0)}/{tot}{mark}"
            )
        phases = inner.get("phases") or []
        shown = [p for p in phases if (p.get("t1", 0) - p.get("t0", 0)) >= 0.04][:8]
        if shown:
            lines.append("phases:")
            for p in shown:
                run = ",".join(p.get("run") or ["(idle)"])
                sl = ",".join(p.get("sleep") or [])
                extra = f"   {sl} SLEEP" if sl else ""
                lines.append(f"  {p['t0']:5.2f}-{p['t1']:5.2f}s  {run} RUN{extra}")
    elif samp.get("n"):
        bf = samp.get("busy_frac")
        bf_s = f"{bf:.0%}" if bf is not None else "?"
        lines.append(
            f"tree samples: {samp['n']} over {samp.get('span_s', 0):.2f}s   "
            f"slots busy {bf_s}   run={samp.get('run_slots')} sleep={samp.get('sleep_slots')}"
        )
    lines.append("")
    return "\n".join(lines)


