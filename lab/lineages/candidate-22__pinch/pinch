def parse_label_opt(values: list[str] | None) -> dict[int, str]:
    out: dict[int, str] = {}
    for raw in values or []:
        if "=" not in raw:
            raise SystemExit(f"pinch: --label expects I=NAME, got {raw!r}")
        idx, name = raw.split("=", 1)
        try:
            out[int(idx)] = name
        except ValueError:
            raise SystemExit(f"pinch: --label index must be int, got {idx!r}") from None
    return out


def split_stages_from_argv(rest: list[str]) -> list[list[str]]:
    """Split remaining args on standalone `+` into stages.

    `--` is reserved for end-of-options (so `cargo test -- --list` stays
    one command). A lone `+` is the stage separator.
    """
    stages: list[list[str]] = []
    cur: list[str] = []
    for tok in rest:
        if tok == "+":
            if cur:
                stages.append(cur)
                cur = []
            continue
        cur.append(tok)
    if cur:
        stages.append(cur)
    return stages


HELP = """pinch — name who waited for whom in a Unix pipeline

USAGE
  pinch [opts] --sh 'cmd1 | cmd2 | cmd3'
  pinch [opts] -- cmd1 + cmd2 + cmd3
  pinch [opts] cmd [args...]              single command: wait vs work

OPTIONS
  --json              report as JSON
  --report PATH       write report to PATH ('-' = stdout). default: stderr
  --sample-ms N       process-group sample interval (default 20; 0=off)
  --buf-size N        meter buffer bytes (default 65536)
  --label I=NAME      name stage I in the report (repeatable)
  --sh SCRIPT         quote-aware split SCRIPT on |
  --meter / --wrap    internal; inserted into the pipeline
  -h, --help          this help
  --version           print version

PRIMITIVE
  A pipeline is a conversation of blocking. Each inserted meter times
  poll() waits on an empty pipe (upstream slow) vs a full pipe
  (downstream slow). The pinch point is the stage that neighbors
  waited for. A single command is also a pipeline: process-group
  samples name the inner child the wrapper waited on (pkl, rustc).

EXAMPLES
  pinch --sh 'cat big | gzip | wc -c'
  pinch -- python3 prod.py + python3 cons.py
  pinch --json --report pinch.json -- cargo test -- --list
"""


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    # internal modes first, so they don't go through argparse
    if argv and argv[0] == "--meter":
        p = argparse.ArgumentParser(add_help=False)
        p.add_argument("--meter", action="store_true")
        p.add_argument("--log", required=True)
        p.add_argument("--buf-size", type=int, default=DEFAULT_BUF)
        ns, _ = p.parse_known_args(argv)
        return run_meter(ns.log, ns.buf_size)

    if argv and argv[0] == "--wrap":
        p = argparse.ArgumentParser(add_help=False)
        p.add_argument("--wrap", action="store_true")
        p.add_argument("--log", required=True)
        p.add_argument("--buf-size", type=int, default=DEFAULT_BUF)
        ns, rest = p.parse_known_args(argv)
        if rest and rest[0] == "--":
            rest = rest[1:]
        return run_wrap(ns.log, rest)

    if not argv or argv[0] in {"-h", "--help"}:
        sys.stdout.write(HELP)
        return 0
    if argv[0] == "--version":
        print(VERSION)
        return 0

    json_out = False
    report_path: Optional[str] = None
    sample_ms = DEFAULT_SAMPLE_MS
    bufsize = DEFAULT_BUF
    labels: dict[int, str] = {}
    sh_script: Optional[str] = None
    rest: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            json_out = True
        elif a == "--report":
            i += 1
            if i >= len(argv):
                print("pinch: --report needs a path", file=sys.stderr)
                return 2
            report_path = argv[i]
        elif a.startswith("--report="):
            report_path = a.split("=", 1)[1]
        elif a == "--sample-ms":
            i += 1
            sample_ms = int(argv[i])
        elif a.startswith("--sample-ms="):
            sample_ms = int(a.split("=", 1)[1])
        elif a == "--buf-size":
            i += 1
            bufsize = int(argv[i])
        elif a.startswith("--buf-size="):
            bufsize = int(a.split("=", 1)[1])
        elif a == "--label":
            i += 1
            labels.update(parse_label_opt([argv[i]]))
        elif a.startswith("--label="):
            labels.update(parse_label_opt([a.split("=", 1)[1]]))
        elif a == "--sh":
            i += 1
            if i >= len(argv):
                print("pinch: --sh needs a script", file=sys.stderr)
                return 2
            sh_script = argv[i]
        elif a.startswith("--sh="):
            sh_script = a.split("=", 1)[1]
        elif a == "--":
            rest.extend(argv[i:])
            break
        elif a.startswith("-"):
            print(f"pinch: unknown option {a}", file=sys.stderr)
            return 2
        else:
            rest.extend(argv[i:])
            break
        i += 1

    if sh_script is not None:
        parts = split_pipeline(sh_script)
        if not parts:
            print("pinch: empty --sh script", file=sys.stderr)
            return 2
        stages = [stage_from_sh(p) for p in parts]
        return run_pipeline(
            stages,
            json_out=json_out,
            report_path=report_path,
            sample_ms=sample_ms,
            bufsize=bufsize,
            labels=labels,
        )

    if rest and rest[0] == "--":
        rest = rest[1:]
    stages = split_stages_from_argv(rest)
    if not stages:
        print("pinch: no command", file=sys.stderr)
        return 2
    return run_pipeline(
        stages,
        json_out=json_out,
        report_path=report_path,
        sample_ms=sample_ms,
        bufsize=bufsize,
        labels=labels,
    )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except OSError:
            pass
        sys.exit(0)
