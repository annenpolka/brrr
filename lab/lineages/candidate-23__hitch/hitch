def write_report(rep: dict[str, Any], as_json: bool, dest: Optional[str], default_stdout: bool) -> None:
    body = json.dumps(rep, indent=2, ensure_ascii=False) + "\n" if as_json else render_human(rep)
    if dest == "-" or (dest is None and default_stdout):
        sys.stdout.write(body)
        return
    if dest:
        Path(dest).write_text(body, encoding="utf-8")
        if not as_json:
            sys.stderr.write(body)
        else:
            sys.stderr.write(f"hitch: wrote {dest}\n")
        return
    sys.stderr.write(body)


def cmd_run(args: argparse.Namespace) -> int:
    command: list[str] = list(args.command)
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        print("hitch: missing command", file=sys.stderr)
        return 2
    backend = pick_backend(args.backend, not args.no_lsof)
    try:
        proc = subprocess.Popen(command, start_new_session=True)
    except FileNotFoundError:
        print(f"hitch: not found: {command[0]}", file=sys.stderr)
        return 127
    root = proc.pid

    def poll() -> Optional[int]:
        return proc.poll()

    def terminate() -> None:
        try:
            os.killpg(root, signal.SIGTERM)
        except OSError:
            try:
                proc.terminate()
            except OSError:
                pass

    samples: list[Sample] = []
    leftovers: list[Proc] = []
    timed_out = False
    try:
        samples, leftovers = sample_until(
            backend,
            root,
            args.interval,
            args.timeout,
            Path(args.samples) if args.samples else None,
            poll,
        )
        if proc.poll() is None and args.timeout:
            timed_out = True
            terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(root, signal.SIGKILL)
                except OSError:
                    proc.kill()
                proc.wait(timeout=1)
    except KeyboardInterrupt:
        terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
        raise
    exit_code = proc.poll()
    if exit_code is None:
        exit_code = 124 if timed_out else 1
    meta = {
        "command": command,
        "exit_code": exit_code,
        "root_pid": root,
        "interval": args.interval,
        "min_idle": args.min_idle,
        "min_block": args.min_block,
        "leftovers": [
            {"pid": p.pid, "cmd": p.cmd, "state": p.state, "ppid": p.ppid} for p in leftovers
        ],
    }
    rep = fold_samples(samples, meta)
    write_report(rep, args.json, args.output, default_stdout=False)
    if args.expect_kind:
        kinds = {s.get("wait", {}).get("kind") for s in rep.get("snags") or []}
        kinds |= {g.get("kind") for g in rep.get("graph") or []}
        missing = [k for k in args.expect_kind if k not in kinds]
        if missing:
            print(f"hitch: expected wait kind {missing} not observed; saw {sorted(kinds)}", file=sys.stderr)
            return 2
    return 0 if args.ignore_exit else (124 if timed_out else int(exit_code))


def cmd_snap(args: argparse.Namespace) -> int:
    backend = pick_backend(args.backend, not args.no_lsof)
    root = args.pid
    if args.follow:
        def poll() -> Optional[int]:
            try:
                os.kill(root, 0)
                return None
            except OSError:
                return 0

        samples, leftovers = sample_until(
            backend,
            root,
            args.interval,
            args.timeout,
            Path(args.samples) if args.samples else None,
            poll,
        )
        meta = {
            "command": f"pid {root}",
            "root_pid": root,
            "interval": args.interval,
            "min_idle": args.min_idle,
            "min_block": args.min_block,
            "leftovers": [{"pid": p.pid, "cmd": p.cmd, "state": p.state} for p in leftovers],
        }
        rep = fold_samples(samples, meta)
    else:
        known: set[int] = {root}
        s = take_sample(backend, root, known, time.time(), True)
        if not s:
            print(f"hitch: pid {root} not found", file=sys.stderr)
            return 1
        meta = {
            "command": f"pid {root}",
            "root_pid": root,
            "interval": 0,
            "min_idle": 0,
            "min_block": 0,
        }
        # give the single snapshot a synthetic duration so blocked_s > 0
        s.t = 0.0
        s2 = Sample(t=max(args.interval, 0.2), procs=s.procs, edges=s.edges)
        rep = fold_samples([s, s2], meta)
        rep["wall_s"] = 0.0
        rep["snapshot"] = True
    write_report(rep, args.json, args.output, default_stdout=True)
    if args.expect_kind:
        kinds = {s.get("wait", {}).get("kind") for s in rep.get("snags") or []}
        kinds |= {g.get("kind") for g in rep.get("graph") or []}
        missing = [k for k in args.expect_kind if k not in kinds]
        if missing:
            print(f"hitch: expected wait kind {missing} not observed; saw {sorted(kinds)}", file=sys.stderr)
            return 2
    return 0


def cmd_fold(args: argparse.Namespace) -> int:
    src = args.command[1] if len(args.command) > 1 else (args.samples or "-")
    if src == "-":
        text = sys.stdin.read()
    else:
        text = Path(src).read_text(encoding="utf-8")
    samples = samples_from_jsonl(text)
    meta = {
        "command": "fold",
        "interval": args.interval,
        "min_idle": args.min_idle,
        "min_block": args.min_block,
    }
    rep = fold_samples(samples, meta)
    write_report(rep, args.json, args.output, default_stdout=True)
    return 0


