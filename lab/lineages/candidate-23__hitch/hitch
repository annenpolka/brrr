_SHORTENERS = [
    (re.compile(r"^/opt/homebrew/Cellar/python@[\d.]+/\S+?/(?:Python|python3[\d.]*)\s+"), "python3 "),
    (re.compile(r"^/usr/local/Cellar/python@[\d.]+/\S+?/(?:Python|python3[\d.]*)\s+"), "python3 "),
    (re.compile(r"^/usr/bin/python3\s+"), "python3 "),
    (re.compile(r"^/Users/\S+?/\.rustup/toolchains/\S+?/bin/"), ""),
    (re.compile(r"^/opt/homebrew/opt/node@?[\d]*/bin/"), ""),
    (re.compile(r"^/opt/homebrew/bin/"), ""),
    (re.compile(r"^/Users/\S+?/target/(debug|release)/deps/"), r"./target/\1/deps/"),
]


def short_cmd(cmd: str, n: int = 78) -> str:
    cmd = " ".join(cmd.split())
    cmd = re.sub(r"^\(([^)]+)\)\s*", r"\1 ", cmd)
    for rx, repl in _SHORTENERS:
        cmd = rx.sub(repl, cmd, count=1)
    bits = cmd.split()
    if bits and "rustc" in bits[0]:
        m = re.search(r"--crate(?:-name)?\s+(\S+)", cmd)
        if m:
            cmd = f"rustc --crate {m.group(1)}"
        else:
            rs = re.findall(r"(\S+\.rs)", cmd)
            if rs:
                cmd = f"rustc {Path(rs[-1]).name}"
    if len(cmd) <= n:
        return cmd
    return cmd[: n - 1] + "…"


def fold_samples(samples: list[Sample], meta: dict[str, Any]) -> dict[str, Any]:
    if not samples:
        return {
            "version": __version__,
            "wall_s": 0.0,
            "samples": 0,
            "snags": [],
            "graph": [],
            "idle_windows": [],
            "procs": [],
            **meta,
        }
    t0 = samples[0].t
    tN = samples[-1].t
    wall = max(tN - t0, 0.0)
    per: dict[int, dict[str, Any]] = {}
    edge_w: dict[tuple[int, int, str], dict[str, Any]] = {}
    idle_windows: list[dict[str, Any]] = []
    idle_open: Optional[dict[str, Any]] = None
    last_running_t = t0
    last_desc_t = t0
    saw_running = False
    saw_desc = False
    root_pid = meta.get("root_pid")
    alive_last: set[int] = set()

    def bucket(pid: int, proc: Proc) -> dict[str, Any]:
        b = per.get(pid)
        if not b:
            b = {
                "pid": pid,
                "ppid": proc.ppid,
                "cmd": proc.cmd,
                "comm": proc.comm,
                "running_s": 0.0,
                "blocked_s": 0.0,
                "alive_s": 0.0,
                "last_state": proc.state,
                "last_wait": None,
                "wait_s": {},
                "wait_of": {},
            }
            per[pid] = b
        b["cmd"] = proc.cmd or b["cmd"]
        b["comm"] = proc.comm or b["comm"]
        b["last_state"] = proc.state
        return b

    for i, s in enumerate(samples):
        dt = (s.t - samples[i - 1].t) if i else 0.0
        if dt < 0:
            dt = 0.0
        idle = True
        for p in s.procs:
            b = bucket(p.pid, p)
            b["alive_s"] += dt
            if p.running:
                b["running_s"] += dt
                idle = False
            elif not p.zombie:
                b["blocked_s"] += dt
        if any(p.running for p in s.procs):
            last_running_t = s.t
            saw_running = True
            idle = False
        if any((p.pid != root_pid) and not p.zombie for p in s.procs):
            last_desc_t = s.t
            saw_desc = True
        for e in s.edges:
            key = (e.src, e.dst, e.kind)
            w = edge_w.get(key)
            if not w:
                w = {
                    "src": e.src,
                    "dst": e.dst,
                    "kind": e.kind,
                    "detail": e.detail,
                    "peer_cmd": e.peer_cmd,
                    "s": 0.0,
                    "hits": 0,
                }
                edge_w[key] = w
            w["s"] += dt
            w["hits"] += 1
            w["detail"] = e.detail or w["detail"]
            w["peer_cmd"] = e.peer_cmd or w["peer_cmd"]
            if e.src in per:
                wait = {"kind": e.kind, "dst": e.dst, "detail": e.detail, "peer_cmd": e.peer_cmd}
                per[e.src]["last_wait"] = wait
                per[e.src]["wait_of"][e.kind] = wait
                per[e.src]["wait_s"][e.kind] = per[e.src]["wait_s"].get(e.kind, 0.0) + dt
        # idle window
        if idle and s.procs:
            if idle_open is None:
                idle_open = {
                    "t0": s.t,
                    "t1": s.t,
                    "edges": _edges_dump(s.edges),
                    "states": [
                        {
                            "pid": p.pid,
                            "state": p.state,
                            "cmd": short_cmd(p.cmd, 60),
                        }
                        for p in s.procs
                        if not p.zombie
                    ],
                }
            else:
                idle_open["t1"] = s.t
                idle_open["edges"] = _edges_dump(s.edges)
        else:
            if idle_open is not None:
                idle_open["dur"] = round(idle_open["t1"] - idle_open["t0"], 3)
                idle_windows.append(idle_open)
                idle_open = None
        alive_last = {p.pid for p in s.procs if not p.zombie}

    if idle_open is not None:
        idle_open["dur"] = round(idle_open["t1"] - idle_open["t0"], 3)
        idle_windows.append(idle_open)

    min_idle = float(meta.get("min_idle", 0.25))
    idle_windows = [w for w in idle_windows if w.get("dur", 0) >= min_idle]

    graph = sorted(edge_w.values(), key=lambda x: -x["s"])
    min_block = float(meta.get("min_block", 0.15))
    snags = []
    for b in per.values():
        wait_s = b.get("wait_s") or {}
        wait = b.get("last_wait") or {}
        blocked = b["blocked_s"]
        if blocked < min_block:
            continue
        specific = {k: v for k, v in wait_s.items() if k not in {"sleep", "wchan", "child-wait"}}
        if specific and max(specific.values()) >= 0.2 * max(blocked, 1e-6):
            kind = max(specific, key=specific.get)
        elif wait_s:
            kind = max(wait_s, key=wait_s.get)
        else:
            kind = wait.get("kind") or ("sleep" if blocked > b["running_s"] else "")
        if not kind:
            continue
        wait = (b.get("wait_of") or {}).get(kind) or wait
        score = blocked
        if kind in {"pipe-read", "tcp", "tcp-orphan", "fifo", "fifo-orphan", "pipe-orphan"}:
            score *= 1.6
        if kind == "child-wait":
            score *= 0.35
        if wait.get("dst") in (0, None) and kind.startswith("tcp"):
            score *= 1.4
        snags.append(
            {
                "pid": b["pid"],
                "cmd": short_cmd(b["cmd"], 120),
                "comm": b["comm"],
                "blocked_s": round(blocked, 3),
                "running_s": round(b["running_s"], 3),
                "score": round(score, 3),
                "wait": wait,
            }
        )
    snags.sort(key=lambda x: -x["score"])
    leftovers = meta.get("leftovers") or []
    running_s = sum(b["running_s"] for b in per.values())
    blocked_s = sum(b["blocked_s"] for b in per.values())
    if saw_desc:
        coda_s = max(0.0, tN - last_desc_t)
    elif saw_running:
        coda_s = max(0.0, tN - last_running_t)
    else:
        coda_s = 0.0
    # wall-clock idle is more honest than summing per-proc blocked
    idle_s = sum(w["dur"] for w in idle_windows)
    return {
        "version": __version__,
        "command": meta.get("command"),
        "exit_code": meta.get("exit_code"),
        "root_pid": meta.get("root_pid"),
        "wall_s": round(wall, 3),
        "active_s": round(max(0.0, last_running_t - t0), 3),
        "coda_s": round(coda_s, 3),
        "idle_s": round(idle_s, 3),
        "tree_running_s": round(running_s, 3),
        "tree_blocked_s": round(blocked_s, 3),
        "samples": len(samples),
        "interval_s": meta.get("interval"),
        "snags": snags[:20],
        "graph": [
            {
                "src": g["src"],
                "dst": g["dst"],
                "kind": g["kind"],
                "s": round(g["s"], 3),
                "hits": g["hits"],
                "detail": g["detail"],
                "peer_cmd": g["peer_cmd"],
                "src_cmd": short_cmd(per.get(g["src"], {}).get("cmd", "")),
                "dst_cmd": short_cmd(per.get(g["dst"], {}).get("cmd", "")) or g["peer_cmd"],
            }
            for g in graph[:40]
        ],
        "idle_windows": [
            {
                "t0": round(w["t0"] - t0, 3),
                "t1": round(w["t1"] - t0, 3),
                "dur": w["dur"],
                "edges": w["edges"][:8],
                "states": w["states"][:12],
            }
            for w in idle_windows[:12]
        ],
        "procs": [
            {
                "pid": b["pid"],
                "ppid": b["ppid"],
                "comm": b["comm"],
                "cmd": short_cmd(b["cmd"]),
                "running_s": round(b["running_s"], 3),
                "blocked_s": round(b["blocked_s"], 3),
                "last_state": b["last_state"],
                "last_wait": b["last_wait"],
            }
            for b in sorted(per.values(), key=lambda x: -(x["blocked_s"] + x["running_s"]))[:40]
        ],
        "leftovers": leftovers,
    }


def _edges_dump(edges: list[Edge]) -> list[dict[str, Any]]:
    return [
        {
            "src": e.src,
            "dst": e.dst,
            "kind": e.kind,
            "detail": e.detail,
            "peer_cmd": e.peer_cmd,
        }
        for e in edges
    ]


def samples_from_jsonl(text: str) -> list[Sample]:
    samples: list[Sample] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        raw = json.loads(line)
        procs = []
        for p in raw.get("procs", []):
            fds = [Fd(**{k: v for k, v in fd.items() if k in Fd.__dataclass_fields__}) for fd in p.get("fds", [])]
            procs.append(
                Proc(
                    pid=int(p["pid"]),
                    ppid=int(p.get("ppid") or 0),
                    pgid=int(p.get("pgid") or 0),
                    state=p.get("state") or "",
                    wchan=p.get("wchan") or "",
                    cmd=p.get("cmd") or "",
                    comm=p.get("comm") or "",
                    fds=fds,
                )
            )
        edges = [
            Edge(
                src=int(e["src"]),
                dst=int(e.get("dst") or 0),
                kind=e["kind"],
                detail=e.get("detail") or "",
                peer_cmd=e.get("peer_cmd") or "",
            )
            for e in raw.get("edges", [])
        ]
        if not edges:
            edges = infer_edges(procs)
        samples.append(Sample(t=float(raw["t"]), procs=procs, edges=edges))
    return samples


def sample_to_jsonl(sample: Sample) -> str:
    def fd_d(fd: Fd) -> dict[str, Any]:
        d = asdict(fd)
        return {k: v for k, v in d.items() if v}

    payload = {
        "t": round(sample.t, 4),
        "procs": [
            {
                "pid": p.pid,
                "ppid": p.ppid,
                "pgid": p.pgid,
                "state": p.state,
                "wchan": p.wchan,
                "cmd": p.cmd,
                "comm": p.comm,
                "fds": [fd_d(fd) for fd in p.fds],
            }
            for p in sample.procs
        ],
        "edges": _edges_dump(sample.edges),
    }
    return json.dumps(payload, ensure_ascii=False)


