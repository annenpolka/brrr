class Backend:
    def __init__(self, kind: str, use_fds: bool) -> None:
        self.kind = kind
        self.use_fds = use_fds

    def procs(self) -> list[Proc]:
        if self.kind == "proc":
            return run_procfs_procs()
        return run_ps()

    def fds(self, pids: list[int]) -> dict[int, list[Fd]]:
        if not self.use_fds or not pids:
            return {}
        if self.kind == "proc":
            got = run_procfs_fds(pids)
            # merge lsof if sockets look empty and lsof exists
            if not any(fd.is_net() for fds in got.values() for fd in fds):
                extra = run_lsof(pids)
                for pid, fds in extra.items():
                    if pid in got:
                        # prefer procfs pipes, add lsof nets
                        nets = [fd for fd in fds if fd.is_net()]
                        got[pid].extend(nets)
                    else:
                        got[pid] = fds
            return got
        return run_lsof(pids)


def pick_backend(name: str, use_fds: bool) -> Backend:
    if name == "auto":
        name = "proc" if procfs_available() else "ps"
    return Backend(name, use_fds)


def take_sample(
    backend: Backend,
    root_pid: int,
    known: set[int],
    t0: float,
    want_fds: bool,
) -> Optional[Sample]:
    all_procs = backend.procs()
    if not all_procs:
        return None
    tree = expand_tree(all_procs, root_pid, known)
    if not tree:
        return None
    if want_fds:
        fdmap = backend.fds([p.pid for p in tree])
        for p in tree:
            p.fds = fdmap.get(p.pid, [])
    edges = infer_edges(tree)
    return Sample(t=time.time() - t0, procs=tree, edges=edges)


def sample_until(
    backend: Backend,
    root_pid: int,
    interval: float,
    timeout: Optional[float],
    samples_path: Optional[Path],
    poll,
) -> tuple[list[Sample], list[Proc]]:
    known: set[int] = {root_pid}
    samples: list[Sample] = []
    t0 = time.time()
    last_lsof = -1.0
    lsof_every = max(0.28, interval)
    sample_fh = None
    if samples_path:
        sample_fh = samples_path.open("w", encoding="utf-8")
    leftovers: list[Proc] = []
    try:
        while True:
            now = time.time() - t0
            if timeout is not None and now >= timeout:
                break
            alive = poll()
            idle_guess = False
            if samples and samples[-1].procs:
                idle_guess = not any(p.running for p in samples[-1].procs)
            prev_n = len(samples[-1].procs) if samples else 0
            want_fds = (
                prev_n <= 12
                or idle_guess
                or not samples
                or (now - last_lsof >= lsof_every)
            )
            s = take_sample(backend, root_pid, known, t0, want_fds)
            if s:
                if want_fds:
                    last_lsof = now
                samples.append(s)
                if sample_fh:
                    sample_fh.write(sample_to_jsonl(s) + "\n")
                    sample_fh.flush()
            if alive is not None:
                # one leftover snapshot
                time.sleep(min(0.05, interval))
                extra = take_sample(backend, root_pid, known, t0, True)
                if extra:
                    leftovers = [p for p in extra.procs if p.pid != root_pid and not p.zombie]
                    extra.t = time.time() - t0
                    samples.append(extra)
                    if sample_fh:
                        sample_fh.write(sample_to_jsonl(extra) + "\n")
                break
            time.sleep(interval)
    finally:
        if sample_fh:
            sample_fh.close()
    return samples, leftovers


