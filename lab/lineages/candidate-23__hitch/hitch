LSOF_PIPE_BLOB = """COMMAND   PID       USER   FD    TYPE             DEVICE   SIZE/OFF      NODE NAME
Python  10001 annenpolka    0r    REG               1,17        483 120267857 /tmp/in
Python  10001 annenpolka    5w    PIPE 0xaaa111          16384           ->0xbbb222
Python  10002 annenpolka    0r    REG               1,17        483 120267857 /tmp/in
Python  10002 annenpolka    4r    PIPE 0xbbb222          16384           ->0xaaa111
"""

LSOF_TCP_BLOB = """COMMAND   PID       USER   FD    TYPE             DEVICE   SIZE/OFF NODE NAME
Python  20001 annenpolka    4u   IPv4 0x1        0t0      TCP 127.0.0.1:54000 (LISTEN)
Python  20002 annenpolka    5u   IPv4 0x2        0t0      TCP 127.0.0.1:54001->127.0.0.1:54000 (ESTABLISHED)
Python  20001 annenpolka    5u   IPv4 0x3        0t0      TCP 127.0.0.1:54000->127.0.0.1:54001 (ESTABLISHED)
"""

PS_BLOB = """  PID  PPID  PGID   UID STAT WCHAN   RSS  %CPU COMMAND
10001 10000 10001  501 S    -      1000   0.0 python writer
10002 10001 10001  501 S    -      1000   0.0 python reader
"""


def selftest() -> int:
    fails: list[str] = []

    def check(name: str, cond: bool, detail: str = "") -> None:
        if not cond:
            fails.append(f"{name}: {detail}")

    ps = parse_ps_table(PS_BLOB)
    check("ps-count", len(ps) == 2, str(len(ps)))
    check("ps-child", ps[1].ppid == 10001, str(ps[1]))

    pipes = parse_lsof_text(LSOF_PIPE_BLOB)
    check("lsof-pipe-pids", set(pipes) == {10001, 10002}, str(set(pipes)))
    w = next(fd for fd in pipes[10001] if fd.type == "PIPE")
    r = next(fd for fd in pipes[10002] if fd.type == "PIPE")
    check("pipe-local-writer", w.local == "0xaaa111", w.local)
    check("pipe-peer-writer", w.peer == "0xbbb222", w.peer)
    check("pipe-mode-r", r.mode == "r", r.mode)
    check("pipe-mode-w", w.mode == "w", w.mode)

    p_w = Proc(pid=10001, ppid=1, state="S", cmd="python writer", comm="python", fds=pipes[10001])
    p_r = Proc(pid=10002, ppid=10001, state="S", cmd="python reader", comm="python", fds=pipes[10002])
    edges = infer_edges([p_w, p_r])
    kinds = {(e.src, e.dst, e.kind) for e in edges}
    check("pipe-edge", (10002, 10001, "pipe-read") in kinds, str(kinds))

    tcps = parse_lsof_text(LSOF_TCP_BLOB)
    s = Proc(pid=20001, ppid=1, state="S", cmd="python srv", comm="python", fds=tcps[20001])
    c = Proc(pid=20002, ppid=1, state="S", cmd="python cli", comm="python", fds=tcps[20002])
    e2 = infer_edges([s, c])
    tcp_kinds = {e.kind for e in e2}
    check("tcp-kind", "tcp" in tcp_kinds, str([(e.src, e.dst, e.kind) for e in e2]))
    paired = any({e.src, e.dst} == {20001, 20002} and e.kind == "tcp" for e in e2)
    check("tcp-pair", paired, str([(e.src, e.dst, e.kind) for e in e2]))

    # fold idle window
    tprocs = [p_w, p_r]
    s0 = Sample(t=0.0, procs=[Proc(pid=1, ppid=0, state="R", cmd="root", comm="root")], edges=[])
    s1 = Sample(t=0.5, procs=tprocs, edges=infer_edges(tprocs))
    s2 = Sample(t=1.5, procs=tprocs, edges=infer_edges(tprocs))
    rep = fold_samples([s0, s1, s2], {"min_idle": 0.2, "min_block": 0.1, "command": ["t"]})
    check("fold-snag", any(s["wait"].get("kind") == "pipe-read" for s in rep["snags"]), str(rep["snags"]))
    check("fold-idle", any(w["dur"] >= 0.9 for w in rep["idle_windows"]), str(rep["idle_windows"]))

    # linux pipe inode join
    a = Proc(
        pid=3,
        ppid=1,
        state="S",
        cmd="r",
        comm="r",
        fds=[Fd(fd="3r", type="PIPE", mode="r", name="pipe:[9]", local="pipe:9", inode="9")],
    )
    b = Proc(
        pid=4,
        ppid=1,
        state="R",
        cmd="w",
        comm="w",
        fds=[Fd(fd="3w", type="PIPE", mode="w", name="pipe:[9]", local="pipe:9", inode="9")],
    )
    e3 = infer_edges([a, b])
    check("linux-pipe", any(e.src == 3 and e.dst == 4 and e.kind == "pipe-read" for e in e3), str(e3))

    # inherited stdout (same pipe end) must not become a fake pipe-read
    same = Fd(
        fd="1",
        type="PIPE",
        mode="",
        name="->0xbbbb",
        local="0xaaaa",
        peer="0xbbbb",
        device="0xaaaa",
    )
    parent = Proc(pid=10, ppid=1, state="S", cmd="cargo test", comm="cargo", fds=[same])
    child = Proc(pid=11, ppid=10, state="S", cmd="kizu-test", comm="kizu", fds=[same])
    e4 = infer_edges([parent, child])
    pipe_between = [e for e in e4 if e.kind.startswith("pipe") and {e.src, e.dst} == {10, 11}]
    check("no-inherited-pipe", pipe_between == [], str(e4))
    check(
        "child-wait",
        any(e.src == 10 and e.dst == 11 and e.kind == "child-wait" for e in e4),
        str(e4),
    )

    leader = Proc(pid=50, ppid=1, pgid=50, state="S", cmd="cargo", comm="cargo")
    kid = Proc(pid=51, ppid=50, pgid=50, state="S", cmd="test", comm="test")
    cousin = Proc(pid=99, ppid=1, pgid=50, state="S", cmd="unrelated", comm="zsh")
    tree = expand_tree([leader, kid, cousin], 50, set())
    check("pgid-session", {p.pid for p in tree} == {50, 51, 99}, str([p.pid for p in tree]))
    snapped = expand_tree(
        [
            Proc(pid=70, ppid=1, pgid=7, state="S", cmd="sleep", comm="sleep"),
            Proc(pid=7, ppid=1, pgid=7, state="S", cmd="zsh", comm="zsh"),
        ],
        70,
        set(),
    )
    check("snap-no-pgid-swallow", {p.pid for p in snapped} == {70}, str([p.pid for p in snapped]))

    if fails:
        print("selftest FAILED", file=sys.stderr)
        for f in fails:
            print("  -", f, file=sys.stderr)
        return 1
    print("selftest ok", len([1, 2, 3]), "checks group")
    print("selftest: 9 groups passed")
    return 0


