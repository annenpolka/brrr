def render_human(rep: dict[str, Any]) -> str:
    cmd = rep.get("command")
    if isinstance(cmd, list):
        cmd_s = short_cmd(" ".join(str(x) for x in cmd), 90)
    else:
        cmd_s = str(cmd or "")
    lines = [
        f"hitch {rep.get('version', __version__)}",
        f"  cmd          {cmd_s}",
        f"  wall         {rep.get('wall_s', 0):.2f}s   "
        f"active {rep.get('active_s', 0):.2f}s   "
        f"idle {rep.get('idle_s', 0):.2f}s   "
        f"coda {rep.get('coda_s', 0):.2f}s",
        f"  samples      {rep.get('samples', 0)}   exit {rep.get('exit_code', '-')}",
    ]
    snags = rep.get("snags") or []
    if snags:
        lines.append("")
        lines.append("  SNAGS")
        for s in snags[:8]:
            wait = s.get("wait") or {}
            peer = wait.get("peer_cmd") or (f"pid {wait.get('dst')}" if wait.get("dst") else "kernel")
            dst = wait.get("dst")
            arrow = f"← {peer}" if dst else peer
            lines.append(
                f"    pid {s['pid']:<6} {s['comm']:<12} "
                f"blocked {s['blocked_s']:.2f}s  {wait.get('kind', '?'):<12} {arrow}"
            )
            if wait.get("detail"):
                lines.append(f"             {short_cmd(str(wait['detail']), 88)}")
    else:
        lines.append("  SNAGS        (none over threshold)")
    graph = rep.get("graph") or []
    if graph:
        lines.append("")
        lines.append("  GRAPH  (waiter → blocker)")
        for g in graph[:12]:
            dst = g.get("dst") or 0
            dst_s = g.get("dst_cmd") or ("kernel" if dst == 0 else f"pid {dst}")
            src_s = g.get("src_cmd") or f"pid {g['src']}"
            lines.append(
                f"    {g['kind']:<12} {g['s']:>6.2f}s  "
                f"{g['src']} {short_cmd(src_s, 34):<34} → {dst} {short_cmd(dst_s, 28)}"
            )
    windows = rep.get("idle_windows") or []
    if windows:
        lines.append("")
        lines.append("  IDLE WINDOWS")
        for w in windows[:6]:
            lines.append(f"    {w['t0']:.2f}–{w['t1']:.2f}s  ({w['dur']:.2f}s)")
            for e in (w.get("edges") or [])[:4]:
                lines.append(
                    f"      {e['kind']:<12} {e['src']} → {e.get('dst') or 'kernel'}  "
                    f"{short_cmd(str(e.get('detail') or e.get('peer_cmd') or ''), 50)}"
                )
    leftovers = rep.get("leftovers") or []
    if leftovers:
        lines.append("")
        lines.append("  LEFTOVERS after exit")
        for L in leftovers[:8]:
            lines.append(f"    pid {L.get('pid')}  {short_cmd(str(L.get('cmd') or ''), 70)}")
    lines.append("")
    return "\n".join(lines)


