#!/usr/bin/env python3
"""hitch — wait-for graph of a process tree.

Join OS sleep state to pipe / socket / fifo / file peers so a hung
build or test answers 'on what?' instead of a pid list.
"""
from __future__ import annotations

import argparse
import json
import os
import platform
import re
import signal
import subprocess
import sys
import time
from collections import defaultdict
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Any, Iterable, Iterator, Optional

__version__ = "0.2.0"

SKIP_FD_NAMES = {"cwd", "txt", "rtd", "mem", "NOFD", "DEL"}
PIPE_HEX = re.compile(r"0x[0-9a-fA-F]+")
TCP_NAME = re.compile(
    r"(?:TCP|UDP)\s+(\S+?)(?:->(\S+))?(?:\s+\(([^)]+)\))?", re.I
)
ENDPOINT = re.compile(r"^(?:\[[^\]]+\]|[^:]+):(\d+|\*)$")


# ---------------------------------------------------------------------------
# data
# ---------------------------------------------------------------------------


@dataclass
class Fd:
    fd: str = ""
    type: str = ""
    mode: str = ""  # r, w, u, or ""
    name: str = ""
    local: str = ""
    peer: str = ""
    net_state: str = ""
    inode: str = ""
    path: str = ""
    device: str = ""

    def is_pipeish(self) -> bool:
        t = self.type.upper()
        return t in {"PIPE", "FIFO"} or self.name.startswith("pipe:") or t == "FIFO"

    def is_net(self) -> bool:
        t = self.type.upper()
        return t in {"IPv4", "IPv6", "TCP", "UDP", "unix", "UNIX", "sock", "SOCKET"} or (
            self.name.startswith("socket:") or self.name.startswith("TCP ")
        )


@dataclass
class Proc:
    pid: int
    ppid: int
    pgid: int = 0
    uid: int = 0
    state: str = ""
    wchan: str = ""
    rss: int = 0
    cpu: float = 0.0
    cmd: str = ""
    comm: str = ""
    fds: list[Fd] = field(default_factory=list)

    @property
    def running(self) -> bool:
        return bool(self.state) and self.state[0] in "R"

    @property
    def zombie(self) -> bool:
        return bool(self.state) and self.state[0] in "Z"

    @property
    def sleeping(self) -> bool:
        return bool(self.state) and self.state[0] in "SUIDT"


@dataclass
class Edge:
    src: int
    dst: int  # 0 = kernel / outside tree
    kind: str
    detail: str = ""
    peer_cmd: str = ""


@dataclass
class Sample:
    t: float
    procs: list[Proc]
    edges: list[Edge]


# ---------------------------------------------------------------------------
# parsing: ps
# ---------------------------------------------------------------------------


def _decode(blob: bytes) -> str:
    return blob.decode("utf-8", "replace")


def parse_ps_table(text: str) -> list[Proc]:
    """Parse `ps -axo pid,ppid,pgid,uid,state,wchan,rss,%cpu,command`."""
    procs: list[Proc] = []
    lines = text.splitlines()
    if not lines:
        return procs
    start = 1 if "PID" in lines[0].upper() and "PPID" in lines[0].upper() else 0
    for line in lines[start:]:
        if not line.strip():
            continue
        parts = line.split(None, 8)
        if len(parts) < 8:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
            pgid = int(parts[2])
            uid = int(parts[3])
        except ValueError:
            continue
        state = parts[4]
        wchan = parts[5]
        try:
            rss = int(float(parts[6]))
        except ValueError:
            rss = 0
        try:
            cpu = float(parts[7])
        except ValueError:
            cpu = 0.0
        cmd = parts[8] if len(parts) > 8 else ""
        comm = Path(cmd.split(None, 1)[0]).name if cmd.strip() else ""
        if comm.endswith(":"):
            comm = comm[:-1]
        if comm.startswith("(") and comm.endswith(")") and len(comm) > 2:
            comm = comm[1:-1]
        procs.append(
            Proc(
                pid=pid,
                ppid=ppid,
                pgid=pgid,
                uid=uid,
                state=state,
                wchan="" if wchan == "-" else wchan,
                rss=rss,
                cpu=cpu,
                cmd=cmd,
                comm=comm or f"pid{pid}",
            )
        )
    return procs


def run_ps() -> list[Proc]:
    cmd = [
        "ps",
        "-axo",
        "pid=,ppid=,pgid=,uid=,state=,wchan=,rss=,%cpu=,command=",
    ]
    try:
        out = subprocess.run(
            cmd, capture_output=True, timeout=2.0, check=False
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    text = _decode(out.stdout)
    if not text.strip():
        # some ps reject trailing = on every column
        try:
            out = subprocess.run(
                [
                    "ps",
                    "-axo",
                    "pid,ppid,pgid,uid,state,wchan,rss,%cpu,command",
                ],
                capture_output=True,
                timeout=2.0,
                check=False,
            )
        except subprocess.TimeoutExpired:
            return []
        text = _decode(out.stdout)
    return parse_ps_table(text)


# ---------------------------------------------------------------------------
# parsing: lsof
# ---------------------------------------------------------------------------


def _col_starts(header: str, names: list[str]) -> list[int]:
    starts: list[int] = []
    pos = 0
    for name in names:
        i = header.find(name, pos)
        if i < 0:
            return []
        starts.append(i)
        pos = i + 1
    return starts


def _slice_cols(line: str, starts: list[int]) -> list[str]:
    vals = []
    for i, s in enumerate(starts):
        e = starts[i + 1] if i + 1 < len(starts) else len(line)
        vals.append(line[s:e].strip())
    return vals


_LSOF_LINE = re.compile(
    r"^(?P<cmd>\S+)\s+(?P<pid>\d+)\s+(?P<user>\S+)\s+(?P<fd>\S+)\s+"
    r"(?P<type>\S+)\s+(?P<device>\S+)\s+(?P<size>\S+)(?:\s+(?P<rest>.*))?$"
)


def _fd_mode(fdname: str) -> tuple[str, str]:
    """Return (bare_fd, mode) for lsof FD cells like 4u / 1w / cwd."""
    if fdname[-1:] in "rwu" and fdname[:-1].isdigit():
        return fdname[:-1], fdname[-1]
    return fdname, ""


def _split_node_name(rest: str) -> tuple[str, str]:
    rest = (rest or "").strip()
    if not rest:
        return "", ""
    parts = rest.split()
    head = parts[0]
    if head in {"TCP", "UDP"} or head.startswith("->") or head.startswith("*"):
        return "", rest
    if re.match(r"^\d+$", head) and len(parts) > 1:
        return head, " ".join(parts[1:])
    return "", rest


def parse_lsof_text(text: str) -> dict[int, list[Fd]]:
    """Parse `lsof -nP` text. Whitespace-first; columns as fallback."""
    by_pid: dict[int, list[Fd]] = defaultdict(list)
    lines = [ln.rstrip("\n") for ln in text.splitlines() if ln.strip()]
    if not lines:
        return {}
    start = 1 if lines[0].lstrip().startswith("COMMAND") else 0
    parsed_any = False
    for line in lines[start:]:
        m = _LSOF_LINE.match(line.strip())
        if not m:
            continue
        pid = int(m.group("pid"))
        fdname = m.group("fd")
        bare, mode = _fd_mode(fdname)
        if bare.lower() in SKIP_FD_NAMES or fdname.lower() in SKIP_FD_NAMES:
            continue
        inode, name = _split_node_name(m.group("rest") or "")
        fd = Fd(
            fd=fdname,
            type=m.group("type"),
            mode=mode,
            name=name,
            inode=inode,
            device=m.group("device"),
        )
        _enrich_fd(fd)
        by_pid[pid].append(fd)
        parsed_any = True
    if parsed_any:
        return dict(by_pid)
    return _parse_lsof_columns(lines)


def _parse_lsof_columns(lines: list[str]) -> dict[int, list[Fd]]:
    header = lines[0]
    if "PID" not in header or "NAME" not in header:
        return {}
    names = ["COMMAND", "PID", "USER", "FD", "TYPE", "DEVICE", "SIZE/OFF", "NODE", "NAME"]
    starts = _col_starts(header, names)
    if len(starts) != 9:
        return {}
    by_pid: dict[int, list[Fd]] = defaultdict(list)
    for line in lines[1:]:
        if len(line) < starts[1]:
            continue
        cols = _slice_cols(line, starts)
        if len(cols) < 9:
            continue
        try:
            pid = int(cols[1])
        except ValueError:
            continue
        fdname = cols[3]
        bare, mode = _fd_mode(fdname)
        if bare.lower() in SKIP_FD_NAMES or fdname.lower() in SKIP_FD_NAMES:
            continue
        fd = Fd(
            fd=fdname,
            type=cols[4],
            mode=mode,
            name=cols[8],
            inode=cols[7],
            device=cols[5],
        )
        _enrich_fd(fd)
        by_pid[pid].append(fd)
    return dict(by_pid)


def _enrich_fd(fd: Fd) -> None:
    name = fd.name.strip()
    typ = fd.type.upper()
    if typ in {"PIPE", "FIFO"} or name.startswith("pipe:"):
        peer_m = re.search(r"->(0x[0-9a-fA-F]+)", name)
        if peer_m:
            fd.peer = peer_m.group(1).lower()
        if fd.device.lower().startswith("0x"):
            fd.local = fd.device.lower()
        m_pipe = re.search(r"pipe:\[(\d+)\]", name)
        if m_pipe:
            fd.inode = m_pipe.group(1)
            fd.local = fd.local or f"pipe:{fd.inode}"
        if typ == "FIFO" or name.startswith("/"):
            fd.path = name.split()[0] if name else ""
        return
    if typ in {"IPv4", "IPv6"} or name.startswith("TCP") or name.startswith("UDP"):
        body = re.sub(r"^(?:TCP|UDP)\s+", "", name, flags=re.I).strip()
        st = re.search(r"\(([^)]+)\)\s*$", body)
        if st:
            fd.net_state = st.group(1).upper()
            body = body[: st.start()].strip()
        if "->" in body:
            a, b = body.split("->", 1)
            fd.local, fd.peer = a.strip(), b.strip()
        else:
            fd.local = body
        return
    if typ in {"unix", "UNIX"} or "unix" in name.lower():
        fd.local = name
        return
    if typ in {"REG", "DIR", "CHR", "VDIR", "VREG"}:
        fd.path = name.split()[0] if name else ""


def run_lsof(pids: list[int]) -> dict[int, list[Fd]]:
    if not pids:
        return {}
    merged: dict[int, list[Fd]] = {}
    chunk = 40
    for i in range(0, len(pids), chunk):
        group = pids[i : i + chunk]
        spec = ",".join(str(p) for p in group)
        try:
            out = subprocess.run(
                ["lsof", "-nP", "-w", "-p", spec],
                capture_output=True,
                timeout=3.0,
                check=False,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        parsed = parse_lsof_text(_decode(out.stdout))
        merged.update(parsed)
    return merged


# ---------------------------------------------------------------------------
# parsing: Linux /proc
# ---------------------------------------------------------------------------


def procfs_available() -> bool:
    return os.path.exists("/proc/self/stat") and os.path.isdir("/proc/self/fd")


def parse_proc_stat_line(pid: int, stat: str, cmdline: str, wchan: str) -> Optional[Proc]:
    lpar = stat.find("(")
    rpar = stat.rfind(")")
    if lpar < 0 or rpar < 0:
        return None
    comm = stat[lpar + 1 : rpar]
    rest = stat[rpar + 2 :].split()
    if len(rest) < 5:
        return None
    state = rest[0]
    try:
        ppid = int(rest[1])
        pgid = int(rest[2])
        rss = int(rest[21]) * 4 if len(rest) > 21 else 0  # pages→kb-ish
    except ValueError:
        return None
    cmd = cmdline.strip() or f"[{comm}]"
    return Proc(
        pid=pid,
        ppid=ppid,
        pgid=pgid,
        state=state,
        wchan="" if wchan in {"0", ""} else wchan,
        rss=rss,
        cmd=cmd,
        comm=comm,
    )


def run_procfs_procs() -> list[Proc]:
    procs: list[Proc] = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return []
    for ent in entries:
        if not ent.isdigit():
            continue
        pid = int(ent)
        try:
            with open(f"/proc/{pid}/stat", "r", encoding="utf-8", errors="replace") as f:
                stat = f.read()
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    raw = f.read()
                cmdline = raw.replace(b"\x00", b" ").decode("utf-8", "replace")
            except OSError:
                cmdline = ""
            try:
                with open(f"/proc/{pid}/wchan", "r", encoding="utf-8", errors="replace") as f:
                    wchan = f.read().strip()
            except OSError:
                wchan = ""
        except OSError:
            continue
        p = parse_proc_stat_line(pid, stat, cmdline, wchan)
        if p:
            procs.append(p)
    return procs


def _linux_fd_mode(pid: int, fdname: str) -> str:
    try:
        with open(f"/proc/{pid}/fdinfo/{fdname}", "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("flags:"):
                    flags = int(line.split()[1], 8)
                    acc = flags & 0x3
                    if acc == 0:
                        return "r"
                    if acc == 1:
                        return "w"
                    return "u"
    except OSError:
        return ""
    return ""


def run_procfs_fds(pids: list[int]) -> dict[int, list[Fd]]:
    by_pid: dict[int, list[Fd]] = {}
    sock_map = _linux_socket_map()
    for pid in pids:
        fds: list[Fd] = []
        fd_dir = f"/proc/{pid}/fd"
        try:
            names = os.listdir(fd_dir)
        except OSError:
            continue
        for name in names:
            path = f"{fd_dir}/{name}"
            try:
                target = os.readlink(path)
            except OSError:
                continue
            mode = _linux_fd_mode(pid, name)
            fd = Fd(fd=name + mode, type="REG", mode=mode, name=target)
            if target.startswith("pipe:"):
                fd.type = "PIPE"
                m = re.search(r"\[(\d+)\]", target)
                if m:
                    fd.inode = m.group(1)
                    fd.local = f"pipe:{m.group(1)}"
            elif target.startswith("socket:"):
                fd.type = "sock"
                m = re.search(r"\[(\d+)\]", target)
                ino = m.group(1) if m else ""
                fd.inode = ino
                info = sock_map.get(ino)
                if info:
                    fd.type = info.get("type", "sock")
                    fd.local = info.get("local", "")
                    fd.peer = info.get("peer", "")
                    fd.net_state = info.get("state", "")
                    fd.name = info.get("name", target)
            elif target.startswith("anon_inode:"):
                fd.type = "anon"
            else:
                fd.path = target
                fd.type = "FIFO" if target.startswith("/") and _is_fifo(target) else "REG"
            fds.append(fd)
        by_pid[pid] = fds
    return by_pid


def _is_fifo(path: str) -> bool:
    try:
        import stat as statmod

        return statmod.S_ISFIFO(os.stat(path).st_mode)
    except OSError:
        return False


_TCP_STATE = {
    "01": "ESTABLISHED",
    "02": "SYN_SENT",
    "03": "SYN_RECV",
    "0A": "LISTEN",
    "06": "TIME_WAIT",
    "08": "CLOSE_WAIT",
}


def _hex_ip_port(field: str) -> str:
    # IPv4: AABBCCDD:PPPP little-endian
    try:
        ip_h, port_h = field.split(":")
        port = int(port_h, 16)
        if len(ip_h) == 8:
            b = bytes.fromhex(ip_h)
            ip = ".".join(str(x) for x in reversed(b))
            return f"{ip}:{port}"
        return f"{ip_h}:{port}"
    except (ValueError, IndexError):
        return field


def _linux_socket_map() -> dict[str, dict[str, str]]:
    out: dict[str, dict[str, str]] = {}
    for fname, proto in (("/proc/net/tcp", "TCP"), ("/proc/net/tcp6", "TCP")):
        try:
            with open(fname, "r", encoding="utf-8", errors="replace") as f:
                next(f, None)
                for line in f:
                    parts = line.split()
                    if len(parts) < 10:
                        continue
                    local = _hex_ip_port(parts[1])
                    rem = _hex_ip_port(parts[2])
                    st = _TCP_STATE.get(parts[3].upper(), parts[3])
                    ino = parts[9]
                    if rem.endswith(":0") or rem.startswith("0.0.0.0"):
                        name = f"{proto} {local} ({st})"
                        peer = ""
                    else:
                        name = f"{proto} {local}->{rem} ({st})"
                        peer = rem
                    out[ino] = {
                        "type": "IPv4",
                        "local": local,
                        "peer": peer,
                        "state": st,
                        "name": name,
                    }
        except OSError:
            continue
    return out


# ---------------------------------------------------------------------------
# tree + edges
# ---------------------------------------------------------------------------


def expand_tree(all_procs: list[Proc], root_pid: int, known: set[int]) -> list[Proc]:
    known.add(root_pid)
    by_pid = {p.pid: p for p in all_procs}
    root = by_pid.get(root_pid)
    # Only walk a process group when root is the session leader (the
    # `hitch -- cmd` case with start_new_session). Snapshots of a random
    # pid must not swallow the whole login shell's group.
    root_pgid = root.pgid if root and root.pgid == root_pid else 0
    self_pid = os.getpid()
    changed = True
    while changed:
        changed = False
        for p in all_procs:
            if p.pid in known or p.pid <= 1 or p.pid == self_pid:
                continue
            if p.ppid in known or (root_pgid and p.pgid == root_pgid):
                known.add(p.pid)
                changed = True
    return [p for p in all_procs if p.pid in known]


def infer_edges(procs: list[Proc]) -> list[Edge]:
    by_pid = {p.pid: p for p in procs}
    edges: list[Edge] = []
    edges.extend(_pipe_edges(procs, by_pid))
    edges.extend(_net_edges(procs, by_pid))
    edges.extend(_fifo_file_edges(procs, by_pid))
    edges.extend(_orphan_fd_edges(procs, edges))
    edges.extend(_child_wait_edges(procs, edges))
    for p in procs:
        if not p.sleeping or p.zombie:
            continue
        if any(e.src == p.pid for e in edges):
            continue
        kind = "sleep"
        detail = p.wchan or "timer"
        if p.wchan and p.wchan.lower() not in {"-", "0"}:
            kind = "wchan"
            detail = p.wchan
        edges.append(Edge(src=p.pid, dst=0, kind=kind, detail=detail, peer_cmd="kernel"))
    return edges


def _pipe_edges(procs: list[Proc], by_pid: dict[int, Proc]) -> list[Edge]:
    locals_: dict[str, list[tuple[Proc, Fd]]] = defaultdict(list)
    peers: dict[str, list[tuple[Proc, Fd]]] = defaultdict(list)
    inodes: dict[str, list[tuple[Proc, Fd]]] = defaultdict(list)
    items: list[tuple[Proc, Fd]] = []
    for p in procs:
        for fd in p.fds:
            if not fd.is_pipeish():
                continue
            items.append((p, fd))
            if fd.local:
                locals_[fd.local].append((p, fd))
            if fd.peer:
                peers[fd.peer].append((p, fd))
            if fd.inode:
                inodes[fd.inode].append((p, fd))
    seen: set[tuple[int, int]] = set()
    edges: list[Edge] = []

    def add(a: Proc, afd: Fd, b: Proc, bfd: Fd) -> None:
        if a.pid == b.pid:
            return
        # Same local hex address = same pipe end inherited across fork, not a wait.
        if afd.local and afd.local == bfd.local and afd.local.startswith("0x"):
            return
        key = (min(a.pid, b.pid), max(a.pid, b.pid))
        if key in seen:
            return
        seen.add(key)
        a_read = afd.mode == "r"
        b_read = bfd.mode == "r"
        a_write = afd.mode == "w"
        b_write = bfd.mode == "w"
        if a_read and not b_read:
            src, dst, sfd, kind = a, b, afd, "pipe-read"
        elif b_read and not a_read:
            src, dst, sfd, kind = b, a, bfd, "pipe-read"
        elif a_write and not b_write:
            src, dst, sfd, kind = a, b, afd, "pipe-write"
        elif b_write and not a_write:
            src, dst, sfd, kind = b, a, bfd, "pipe-write"
        else:
            # macOS often omits r/w on pipes. Prefer the child as waiter:
            # parent created the pipe, child is usually blocked on it.
            if a.pid == b.ppid:
                src, dst, sfd = b, a, bfd
            elif b.pid == a.ppid:
                src, dst, sfd = a, b, afd
            elif a.sleeping and not b.sleeping:
                src, dst, sfd = a, b, afd
            elif b.sleeping and not a.sleeping:
                src, dst, sfd = b, a, bfd
            else:
                src, dst, sfd = a, b, afd
            kind = "pipe-read"
        edges.append(
            Edge(
                src=src.pid,
                dst=dst.pid,
                kind=kind,
                detail=sfd.name or sfd.local or sfd.peer,
                peer_cmd=short_cmd(dst.cmd),
            )
        )

    for p, fd in items:
        partners: list[tuple[Proc, Fd]] = []
        if fd.peer:
            partners.extend(locals_.get(fd.peer, []))
        if fd.local:
            partners.extend(peers.get(fd.local, []))
        if fd.inode:
            partners.extend(inodes.get(fd.inode, []))
        for q, qfd in partners:
            add(p, fd, q, qfd)
    return edges


def _net_edges(procs: list[Proc], by_pid: dict[int, Proc]) -> list[Edge]:
    listens: dict[str, Proc] = {}
    established: list[tuple[Proc, Fd]] = []
    connecting: list[tuple[Proc, Fd]] = []
    for p in procs:
        for fd in p.fds:
            if not fd.is_net():
                continue
            st = fd.net_state
            if st == "LISTEN" and fd.local:
                listens[fd.local] = p
                # also index by port
                port = _port_of(fd.local)
                if port:
                    listens[f"*:{port}"] = p
                    listens[port] = p
            elif st in {"SYN_SENT", "SYN_RECV"}:
                connecting.append((p, fd))
            elif fd.peer or st == "ESTABLISHED":
                established.append((p, fd))

    edges: list[Edge] = []
    paired: set[tuple[int, int]] = set()

    def match_peer(p: Proc, fd: Fd) -> Optional[Proc]:
        if fd.peer:
            # reverse endpoint may be held by someone as local
            for q in procs:
                if q.pid == p.pid:
                    continue
                for qfd in q.fds:
                    if not qfd.is_net():
                        continue
                    if qfd.local == fd.peer or (
                        qfd.peer == fd.local and qfd.local == fd.peer
                    ):
                        return q
                    if qfd.net_state == "LISTEN" and _same_listen(qfd.local, fd.peer):
                        return q
        port = _port_of(fd.peer)
        if port and (port in listens or f"*:{port}" in listens):
            return listens.get(fd.peer) or listens.get(port) or listens.get(f"*:{port}")
        return None

    for p, fd in established + connecting:
        peer = match_peer(p, fd)
        if peer:
            key = (min(p.pid, peer.pid), max(p.pid, peer.pid))
            if key in paired:
                continue
            paired.add(key)
            waiter = p if p.sleeping or not peer.sleeping else peer
            other = peer if waiter is p else p
            edges.append(
                Edge(
                    src=waiter.pid,
                    dst=other.pid,
                    kind="tcp",
                    detail=fd.name,
                    peer_cmd=short_cmd(other.cmd),
                )
            )
        else:
            kind = "tcp-orphan" if fd.net_state in {"SYN_SENT", ""} and not fd.peer else "tcp-external"
            if fd.net_state == "SYN_SENT":
                kind = "tcp-orphan"
            if p.sleeping or kind == "tcp-orphan":
                edges.append(
                    Edge(
                        src=p.pid,
                        dst=0,
                        kind=kind,
                        detail=fd.name,
                        peer_cmd=fd.peer or "no-listener",
                    )
                )
    return edges


def _port_of(endpoint: str) -> str:
    if not endpoint:
        return ""
    if endpoint.startswith("["):
        m = re.search(r"\]:(\d+)$", endpoint)
        return m.group(1) if m else ""
    if ":" in endpoint:
        return endpoint.rsplit(":", 1)[-1]
    return ""


def _same_listen(listen_local: str, peer: str) -> bool:
    if not listen_local or not peer:
        return False
    if listen_local == peer:
        return True
    lp, pp = _port_of(listen_local), _port_of(peer)
    if not lp or lp != pp:
        return False
    host = listen_local.rsplit(":", 1)[0]
    return host in {"*", "0.0.0.0", "::", "[::]", "127.0.0.1", "::1"}


def _orphan_fd_edges(procs: list[Proc], existing: list[Edge]) -> list[Edge]:
    """Sleeping reader of a pipe/fifo whose other end is not in the tree."""
    paired: set[int] = set()
    for e in existing:
        if e.kind.startswith(("pipe", "fifo", "tcp", "file")):
            paired.add(e.src)
            if e.dst:
                paired.add(e.dst)
    edges: list[Edge] = []
    for p in procs:
        if not p.sleeping or p.zombie or p.pid in paired:
            continue
        for fd in p.fds:
            if not fd.is_pipeish():
                continue
            bare = fd.fd.rstrip("rwu")
            if bare in {"0", "1", "2"}:
                continue
            if fd.mode == "w":
                continue
            is_fifo = fd.type.upper() == "FIFO" or (fd.path and "fifo" in fd.path.lower())
            # macOS leaves pipe r/w blank; unpaired blank pipes are usually
            # inherited stdio or runtime plumbing, not a hitch.
            if not is_fifo and fd.mode != "r":
                continue
            kind = "fifo-orphan" if is_fifo else "pipe-orphan"
            edges.append(
                Edge(
                    src=p.pid,
                    dst=0,
                    kind=kind,
                    detail=fd.path or fd.name or fd.local,
                    peer_cmd="missing-peer",
                )
            )
            break
    return edges


def _child_wait_edges(procs: list[Proc], existing: list[Edge]) -> list[Edge]:
    """Sleeping parent with live children → waitpid/child-wait, not a generic sleep."""
    already = {e.src for e in existing}
    kids_of: dict[int, list[Proc]] = defaultdict(list)
    for p in procs:
        if not p.zombie:
            kids_of[p.ppid].append(p)
    edges: list[Edge] = []
    for p in procs:
        if p.pid in already or not p.sleeping or p.zombie:
            continue
        kids = kids_of.get(p.pid) or []
        if not kids:
            continue
        running = [k for k in kids if k.running]
        target = running[0] if running else kids[0]
        edges.append(
            Edge(
                src=p.pid,
                dst=target.pid,
                kind="child-wait",
                detail=f"{len(kids)} child" + ("ren" if len(kids) != 1 else ""),
                peer_cmd=short_cmd(target.cmd),
            )
        )
    return edges


def _fifo_file_edges(procs: list[Proc], by_pid: dict[int, Proc]) -> list[Edge]:
    by_path: dict[str, list[tuple[Proc, Fd]]] = defaultdict(list)
    for p in procs:
        for fd in p.fds:
            path = fd.path
            if not path or path.startswith("/dev/") or path.startswith("/System/"):
                continue
            if fd.type.upper() in {"REG", "FIFO"} or path:
                by_path[path].append((p, fd))
    edges: list[Edge] = []
    for path, holders in by_path.items():
        writers = [(p, fd) for p, fd in holders if fd.mode in {"w", "u"}]
        readers = [(p, fd) for p, fd in holders if fd.mode == "r"]
        if not writers or not readers:
            continue
        fifo = any(fd.type.upper() == "FIFO" for _, fd in holders)
        kind = "fifo" if fifo else "file-handoff"
        for rp, rfd in readers:
            if not rp.sleeping and not fifo:
                continue
            for wp, wfd in writers:
                if rp.pid == wp.pid:
                    continue
                edges.append(
                    Edge(
                        src=rp.pid,
                        dst=wp.pid,
                        kind=kind,
                        detail=path,
                        peer_cmd=short_cmd(wp.cmd),
                    )
                )
    return edges


