def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="hitch",
        description="Wait-for graph of a process tree (pipes, sockets, sleeps).",
    )
    p.add_argument("-V", "--version", action="version", version=f"hitch {__version__}")
    p.add_argument("-p", "--pid", type=int, help="snapshot this pid's tree")
    p.add_argument("--follow", action="store_true", help="with -p, sample until it exits")
    p.add_argument("--json", action="store_true", help="report JSON")
    p.add_argument("-o", "--output", help="report path (`-` = stdout)")
    p.add_argument("--interval", type=float, default=0.12, help="sample interval seconds")
    p.add_argument("--samples", help="write JSONL samples to FILE")
    p.add_argument("--min-idle", type=float, default=0.25, help="idle window threshold")
    p.add_argument("--min-block", type=float, default=0.15, help="snag blocked-time threshold")
    p.add_argument("--expect-kind", action="append", default=[], help="exit 2 if kind absent")
    p.add_argument("--timeout", type=float, help="seconds to supervise before SIGTERM")
    p.add_argument("--no-lsof", action="store_true", help="skip fd joining")
    p.add_argument("--backend", choices=["auto", "ps", "proc"], default="auto")
    p.add_argument(
        "--ignore-exit",
        action="store_true",
        help="return 0 even if the child failed (report still written)",
    )
    p.add_argument("command", nargs=argparse.REMAINDER, help="command to run (`--` then argv)")
    return p


def main(argv: Optional[list[str]] = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    args = parser.parse_args(argv)
    command = list(args.command)
    if command[:1] == ["--"]:
        # keep -- so cmd_run can strip; but detect builtins first
        rest = command[1:]
        if rest[:1] in (["fold"], ["selftest"]):
            command = rest
            args.command = command
    if command[:1] == ["selftest"]:
        return selftest()
    if command[:1] == ["fold"]:
        return cmd_fold(args)
    if args.pid:
        return cmd_snap(args)
    if command:
        return cmd_run(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stderr.write("\nhitch: interrupted\n")
        sys.exit(130)
