#!/usr/bin/env python3
"""kiln — reconstruct generation lots; report whether their claims still hold.

A generated artifact is a claim about a source world (generator + declared
sources + imports). kiln groups artifacts that claim the same firing, then
says whether the world moved, whether siblings fired together have split,
and whether the header went blind to imports.

Rebuild reasons come from git/content, not from a Makefile you never wrote.
mtime is only consulted to catch CLOCK: the filesystem would have called
the artifact fresh.
"""
from __future__ import annotations

