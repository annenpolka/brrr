def _git_commit(root: Path, msg: str, date: str) -> None:
    env = os.environ.copy()
    env.update(
        {
            "GIT_AUTHOR_DATE": date,
            "GIT_COMMITTER_DATE": date,
            "GIT_AUTHOR_NAME": "kiln",
            "GIT_AUTHOR_EMAIL": "kiln@test",
            "GIT_COMMITTER_NAME": "kiln",
            "GIT_COMMITTER_EMAIL": "kiln@test",
        }
    )
    subprocess.run(["git", "add", "-A"], cwd=root, check=True, stdout=subprocess.DEVNULL)
    subprocess.run(
        ["git", "commit", "-m", msg, "--allow-empty"],
        cwd=root,
        check=True,
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def build_ugly_repo(root: Path) -> None:
    (root / "specs").mkdir()
    (root / "out").mkdir()
    (root / "docs").mkdir()
    (root / "gen.py").write_text(UGGLY_GEN)
    (root / "specs" / "root.pkl").write_text(UGGLY_ROOT_PKL)
    (root / "specs" / "hidden.pkl").write_text(UGGLY_HIDDEN)
    (root / "out" / "alpha.generated.ts").write_text(UGGLY_ALPHA)
    (root / "out" / "beta.generated.ts").write_text(UGGLY_BETA)
    (root / "out" / "clock.generated.ts").write_text(UGGLY_ALPHA.replace("n = 1", "n = 0"))
    (root / "docs" / "SPEC.md").write_text(UGGLY_SPEC)
    (root / "out" / "vanished.generated.ts").write_text(UGGLY_VANISHED)
    (root / "out" / "cluster.generated.ts").write_text(
        "// @generated by gen.py from specs/other.pkl — DO NOT EDIT\nexport const n = 1;\n"
    )
    (root / "specs" / "other.pkl").write_text("value = 1\n")
    (root / "extra").mkdir()
    (root / "extra" / "EPC-001.json").write_text('{"id":"EPC-001"}\n')
    (root / "forged.txt").write_text(UGGLY_FORGED)
    (root / "Cargo.lock").write_text(UGGLY_LOCK)
    subprocess.run(["git", "init", "-q"], cwd=root, check=True)
    subprocess.run(["git", "config", "user.email", "kiln@test"], cwd=root, check=True)
    subprocess.run(["git", "config", "user.name", "kiln"], cwd=root, check=True)
    _git_commit(root, "t0 fire together", "2026-01-01T00:00:00+00:00")
    (root / "specs" / "hidden.pkl").write_text("secret = 11\n")
    (root / "specs" / "other.pkl").write_text("value = 2\n")
    _git_commit(root, "t1 undeclared import moved", "2026-01-02T00:00:00+00:00")
    (root / "out" / "beta.generated.ts").write_text(
        UGGLY_BETA.replace("n = 1", "n = 2")
    )
    _git_commit(root, "t2 refire beta only", "2026-01-03T00:00:00+00:00")
    # Backdate the alpha world so CLOCK is distinguishable from a checkout cluster.
    past = time.time() - 3600
    for rel in ("specs/hidden.pkl", "specs/root.pkl", "gen.py"):
        os.utime(root / rel, (past, past))
    (root / "out" / "alpha.generated.ts").write_text(
        UGGLY_ALPHA.replace("n = 1", "n = 99")
    )
    os.utime(root / "out" / "clock.generated.ts", None)
    # clustered mtimes: DATED cluster should NOT be CLOCK (checkout-shaped)
    ts = time.time()
    os.utime(root / "out" / "cluster.generated.ts", (ts, ts))
    os.utime(root / "specs" / "other.pkl", (ts, ts))


def _member(lots: list[Lot], path: str) -> Member:
    for L in lots:
        for m in L.members:
            if m.path == path:
                return m
    raise AssertionError(f"missing member {path}")


def selftest() -> int:
    fails: list[str] = []

    def ok(name: str, cond: bool, detail: str = "") -> None:
        if cond:
            print(f"  ok  {name}")
        else:
            fails.append(name)
            print(f"  FAIL {name}  {detail}")

    with tempfile.TemporaryDirectory(prefix="kiln-ugly-") as td:
        root = Path(td)
        build_ugly_repo(root)
        repo = Repo(root)
        lots = analyze(repo)
        paths = sorted(m.path for L in lots for m in L.members)
        ok("found alpha", "out/alpha.generated.ts" in paths, str(paths))
        ok("found beta", "out/beta.generated.ts" in paths)
        ok("found spec", "docs/SPEC.md" in paths)
        ok("found vanished", "out/vanished.generated.ts" in paths)
        ok("found forged", "forged.txt" in paths)
        ok("skipped Cargo.lock", "Cargo.lock" not in paths, str(paths))

        alpha = _member(lots, "out/alpha.generated.ts")
        beta = _member(lots, "out/beta.generated.ts")
        vanished = _member(lots, "out/vanished.generated.ts")
        forged = _member(lots, "forged.txt")
        spec = _member(lots, "docs/SPEC.md")

        ok("alpha DATED", "DATED" in alpha.verdicts, str(alpha.verdicts))
        ok("alpha SPLIT", "SPLIT" in alpha.verdicts, str(alpha.verdicts))
        ok("alpha BLIND", "BLIND" in alpha.verdicts, str(alpha.verdicts))
        ok("alpha not CLOCK when dirty", "CLOCK" not in alpha.verdicts, str(alpha.verdicts))
        ok("alpha DIRTY", "DIRTY" in alpha.verdicts, str(alpha.verdicts))
        clock = _member(lots, "out/clock.generated.ts")
        ok("clock DATED", "DATED" in clock.verdicts, str(clock.verdicts))
        ok("clock CLOCK", "CLOCK" in clock.verdicts, str(clock.verdicts))
        ok("clock not DIRTY", "DIRTY" not in clock.verdicts, str(clock.verdicts))
        ok(
            "alpha sees hidden.pkl",
            "specs/hidden.pkl" in alpha.imports,
            str(alpha.imports),
        )
        ok("beta SPLIT", "SPLIT" in beta.verdicts, str(beta.verdicts))
        ok("beta not DATED", "DATED" not in beta.verdicts, str(beta.verdicts))
        ok("vanished ORPHAN", "ORPHAN" in vanished.verdicts, str(vanished.verdicts))
        ok("forged FORGED", "FORGED" in forged.verdicts, str(forged.verdicts))
        ok("spec same lot as alpha", spec.declared == ["specs/root.pkl"], str(spec.declared))
        lot = next(L for L in lots if any(m.path == alpha.path for m in L.members))
        ok("lot split flag", lot.split)
        ok("lot blind flag", lot.blind)
        why = format_human(lots, why_path="out/alpha.generated.ts")
        ok("why names hidden.pkl", "hidden.pkl" in why, why[:400])
        why_clock = format_human(lots, why_path="out/clock.generated.ts")
        ok("why names clock", "CLOCK" in why_clock or "clock" in why_clock, why_clock[:400])
        ok("why uses content reasons", "content" in why, why[:500])
        cluster = _member(lots, "out/cluster.generated.ts")
        ok("cluster DATED", "DATED" in cluster.verdicts, str(cluster.verdicts))
        ok("cluster not CLOCK", "CLOCK" not in cluster.verdicts, str(cluster.verdicts))
        extra_paths = [m.path for L in lots for m in L.members]
        ok("recipe pulled extra/EPC-001.json", "extra/EPC-001.json" in extra_paths, str(extra_paths))
        tsv = format_tsv(lots)
        ok("tsv has alpha", "out/alpha.generated.ts" in tsv)
        payload = json.loads(format_json(lots))
        ok("json lots", len(payload["lots"]) >= 1)

    # header parsers
    c = parse_claim(
        "x.ts",
        "// @generated by tools/spec-gen.ts from specs/tenaoshi.pkl — DO NOT EDIT\n",
    )
    ok(
        "parse by-from",
        c is not None
        and c["generator"] == "tools/spec-gen.ts"
        and c["sources"] == ["specs/tenaoshi.pkl"],
        str(c),
    )
    c = parse_claim("x.ts", "// Generated from specs/main.pkl. Do not edit.\n")
    ok("parse from", c is not None and c["sources"] == ["specs/main.pkl"], str(c))
    c = parse_claim(
        "SPEC.md",
        "# t\n\n> **生成物 — 手編集禁止。** 正本は `specs/notifier.pkl`。\n",
    )
    ok("parse seihon", c is not None and c["sources"] == ["specs/notifier.pkl"], str(c))

    if fails:
        print(f"selftest: {len(fails)} failed")
        return 1
    print("selftest: all passed")
    return 0


HELP = f"""kiln {VERSION} — were these generated artifacts fired together, and is the claim still true?

Usage:
  kiln [-C dir] [--json|--tsv|--porcelain] [--check] [scan]
  kiln [-C dir] why PATH
  kiln [-C dir] lots
  kiln --selftest

A generated file claims a source world. kiln reconstructs the firing lot
from headers, filename patterns, pkl imports, and git — then reports:

  FRESH   world has not moved since this artifact last changed
  DATED   a source, import, or generator is newer (commit or dirty)
  SPLIT   siblings that claim the same recipe have different fire times
  BLIND   a source import is not named in the @generated header
  CLOCK   mtime would call it fresh; git/content would rebuild
  DIRTY   the artifact itself has uncommitted changes
  ORPHAN  declared source is missing
  FORGED  DO NOT EDIT / generated-looking, no parseable recipe
  BOUND   oracle bakes an absolute path or a timezone offset

Rebuild reasons are content/git, not ninja -d explain. There is no
Makefile. The graph is recovered from the artifacts' own claims.

Exit: 0 ok, 1 --check findings, 2 usage.
"""


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-C", dest="root", default=".")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--tsv", action="store_true")
    parser.add_argument("--porcelain", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--selftest", action="store_true")
    parser.add_argument("--help", "-h", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("cmd", nargs="?", default="scan")
    parser.add_argument("path", nargs="?")
    args = parser.parse_args(argv)

    if args.help:
        sys.stdout.write(HELP)
        return 0
    if args.version:
        print(f"kiln {VERSION}")
        return 0
    if args.selftest or args.cmd == "selftest":
        return selftest()

    cmd = args.cmd
    why_path = None
    if cmd == "why":
        why_path = args.path
        if not why_path:
            sys.stderr.write("kiln: why requires PATH\n")
            return 2
    elif cmd in {"scan", "lots", None}:
        pass
    elif cmd not in {"scan", "lots"} and args.path is None and not cmd.startswith("-"):
        # kiln PATH  → why if it looks like a file, else treat as extra root
        maybe = Path(args.root) / cmd
        if maybe.is_file() or cmd.endswith((".ts", ".swift", ".rs", ".md", ".json", ".mbt")):
            why_path = cmd
            cmd = "why"
        else:
            sys.stderr.write(f"kiln: unknown command {cmd}\n")
            return 2

    root = Path(args.root).resolve()
    if not root.exists():
        sys.stderr.write(f"kiln: {root} does not exist\n")
        return 2
    repo = Repo(root)
    lots = analyze(repo)

    if cmd == "lots":
        for L in lots:
            flags = []
            if L.split:
                flags.append("SPLIT")
            if L.blind:
                flags.append("BLIND")
            print(
                f"{L.id}\t{len(L.members)}\t{','.join(flags)}\t{L.generator or '-'}\t{','.join(L.declared)}"
            )
        if args.check and any_check_fail(lots):
            return 1
        return 0

    fmt = "human"
    if args.json:
        fmt = "json"
    elif args.tsv or args.porcelain:
        fmt = "tsv"

    if cmd == "why" and why_path:
        # normalize to repo-relative
        wp = why_path
        p = Path(wp)
        if p.is_absolute():
            try:
                wp = str(p.resolve().relative_to(repo.root)).replace("\\", "/")
            except ValueError:
                wp = why_path
        if fmt == "json":
            # filter
            filtered = []
            for L in lots:
                ms = [m for m in L.members if m.path == wp or m.path.endswith(wp)]
                if ms:
                    L2 = Lot(id=L.id, generator=L.generator, declared=L.declared, members=ms, imports=L.imports, split=L.split, blind=L.blind)
                    filtered.append(L2)
            sys.stdout.write(format_json(filtered))
        elif fmt == "tsv":
            sys.stdout.write(format_tsv([L for L in lots if any(m.path == wp or m.path.endswith(wp) for m in L.members)]))
        else:
            sys.stdout.write(format_human(lots, why_path=wp))
        if args.check and any_check_fail(lots):
            return 1
        return 0

    if fmt == "json":
        sys.stdout.write(format_json(lots))
    elif fmt == "tsv":
        sys.stdout.write(format_tsv(lots))
    else:
        sys.stdout.write(format_human(lots))

    if args.check and any_check_fail(lots):
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
