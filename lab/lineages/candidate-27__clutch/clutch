def _git(cwd: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(cwd), *args],
        capture_output=True,
        text=True,
        check=check,
    )


def _commit(cwd: Path, msg: str, files: list[str]) -> None:
    _git(cwd, "add", "--", *files)
    _git(cwd, "commit", "-q", "-m", msg)


