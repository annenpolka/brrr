def selftest() -> int:
    fails = 0

    def expect(name: str, cond: bool, detail: str = "") -> None:
        nonlocal fails
        if cond:
            print(f"  ok  {name}")
        else:
            fails += 1
            print(f"  FAIL {name} {detail}", file=sys.stderr)

    # extraction unit checks
    rec = extract_receipt(
        "docs/generated/SPEC.md",
        "<!-- Generated from specs/main.pkl. Do not edit. -->\n"
        "- Source fingerprint: `sha256:" + "ab" * 32 + "`\n",
        "SPEC.md",
    )
    expect("strip trailing period in Generated from", rec is not None and rec.parent == "specs/main.pkl")
    expect("stamp from markdown", rec is not None and rec.stamp and rec.stamp.startswith("sha256:ab"))

    rec = extract_receipt(
        "Engine/Tests/OraclesGenerated.swift",
        "// @generated by tools/spec-gen.ts from specs/tenaoshi.pkl — DO NOT EDIT\n",
        "OraclesGenerated.swift",
    )
    expect(
        "swift @generated by/from",
        rec is not None
        and rec.parent == "specs/tenaoshi.pkl"
        and rec.generator == "tools/spec-gen.ts",
    )

    rec = extract_receipt(
        "docs/SPEC.md",
        "> **生成物 — 手編集禁止。** 正本は `specs/tenaoshi.pkl`。変更は正本を編集して `just spec-gen`。\n",
        "SPEC.md",
    )
    expect("japanese honban", rec is not None and rec.parent == "specs/tenaoshi.pkl")

    rec = extract_receipt(
        "x.json",
        json.dumps({"source": "specs/main.pkl", "sourceFingerprint": "sha256:" + "d" * 64}),
        "x.json",
    )
    expect("json sourceFingerprint", rec is not None and rec.parent == "specs/main.pkl" and rec.stamp)

    rec = extract_receipt("README.md", "# Hello\n\nDo not forget milk.\n", "README.md")
    expect("non-generated ignored", rec is None)

    rec = extract_receipt(
        "justfile",
        "# 開発タスク。仕様正本は specs/、生成物は docs/SPEC.md\nspec-gen:\n",
        "justfile",
    )
    expect("justfile prose is not a receipt", rec is None)
    expect("glob parent rejected", valid_parent("specs/*.pkl") is None)
    expect("jp-comma parent rejected", valid_parent("specs/、生成物は") is None)

    with tempfile.TemporaryDirectory(prefix="clutch-selftest-") as td:
        root = build_fixture(Path(td) / "repo").resolve()
        members = scan(root, [], include_locks=False)
        by_path = {m.receipt.path: m for m in members}

        expect("found a.md", "out/a.md" in by_path)
        expect("found b.md", "out/b.md" in by_path)
        if "out/a.md" in by_path and "out/b.md" in by_path:
            expect("a.md is FRESH (new die)", by_path["out/a.md"].verdict == "FRESH", by_path["out/a.md"].verdict)
            expect("b.md is STALE (old die)", by_path["out/b.md"].verdict == "STALE", by_path["out/b.md"].verdict)
            expect(
                "main clutch SPLIT on stamp",
                by_path["out/a.md"].clutch_verdict == "SPLIT",
                by_path["out/a.md"].clutch_verdict,
            )
            expect("IR stamp currency=die", by_path.get("out/manifest.json") and by_path["out/manifest.json"].stamp_currency == "die")
        expect("unicode path kept", "out/計画.md" in by_path)
        if "out/計画.md" in by_path:
            expect("unicode COLD or STALE after partial regen", by_path["out/計画.md"].verdict in {"COLD", "STALE", "FRESH"})
        expect("orphan missing.pkl", "ghost.md" in by_path and by_path["ghost.md"].verdict == "ORPHAN")
        expect("mute has no parent", "mute.md" in by_path and by_path["mute.md"].verdict == "MUTE")
        expect("honban parent", "jp/SPEC.md" in by_path and by_path["jp/SPEC.md"].receipt.parent == "specs/honban.pkl")
        expect("justfile skipped", "justfile" not in by_path)
        expect("AGENTS.md skipped", "AGENTS.md" not in by_path)
        if "out/caps.json" in by_path:
            expect(
                "stamp-join fills parent",
                by_path["out/caps.json"].receipt.parent == "specs/main.pkl",
                str(by_path["out/caps.json"].receipt.parent),
            )
        else:
            expect("stamp-join fills parent", False, "caps.json missing")
        if "pkg/foo.generated.ts" in by_path:
            expect(
                "GENERATED.md inherit",
                by_path["pkg/foo.generated.ts"].receipt.parent == "specs/main.pkl",
                str(by_path["pkg/foo.generated.ts"].receipt.parent),
            )
        else:
            expect("GENERATED.md inherit", False, "foo.generated.ts missing")

        (root / "specs" / "main.pkl").write_text("version = 2\ndirty\n", encoding="utf-8")
        dirty_members = scan(root, [], include_locks=False)
        dirty_by = {m.receipt.path: m for m in dirty_members}
        if "out/計画.md" in dirty_by:
            expect(
                "dirty parent does not mask COLD",
                dirty_by["out/計画.md"].verdict == "COLD",
                dirty_by["out/計画.md"].verdict,
            )
        if "out/a.md" in dirty_by:
            expect(
                "dirty parent age-0 is NOW not STALE-all",
                dirty_by["out/a.md"].verdict in {"NOW", "FRESH"},
                dirty_by["out/a.md"].verdict,
            )
        hosts = {by_path[p].receipt.machine for p in ("out/host-a.ts", "out/host-b.ts") if p in by_path}
        expect("machines extracted", hosts == {"builder-a", "builder-b"}, str(hosts))
        if "out/host-a.ts" in by_path:
            expect(
                "FOREIGN or RAGGED/SPLIT clutch includes hosts",
                by_path["out/host-a.ts"].clutch_verdict in {"FOREIGN", "SPLIT", "RAGGED", "STALE"},
                by_path["out/host-a.ts"].clutch_verdict,
            )

        # period-stripping against a real nested file with spaces
        space = root / "dir with spaces"
        space.mkdir()
        (space / "child.rs").write_text(
            "// Generated from specs/main.pkl. Do not edit.\nfn x() {}\n",
            encoding="utf-8",
        )
        rec = extract_receipt("dir with spaces/child.rs", (space / "child.rs").read_text(), "child.rs")
        expect("spaces path extract", rec is not None and rec.parent == "specs/main.pkl")

    if fails:
        eprint(f"selftest: {fails} failed")
        return 1
    print("selftest: all passed")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="clutch",
        description="Reconstruct generation lots from the testimony generated files already carry.",
    )
    p.add_argument("paths", nargs="*", help="files or directories (default: repo root)")
    p.add_argument("-C", "--chdir", default=None, help="act as if started in this directory")
    p.add_argument("--json", action="store_true", help="machine JSON (clutches + members)")
    p.add_argument("--tsv", action="store_true", help="TSV table of members")
    p.add_argument("--summary", action="store_true", help="clutch-level only")
    p.add_argument("-v", "--verbose", action="store_true", help="show FRESH members and notes")
    p.add_argument("--locks", action="store_true", help="include lockfiles as receipts")
    p.add_argument(
        "--ok-cold",
        action="store_true",
        help="exit 0 even when a clutch is COLD/RAGGED (stable output)",
    )
    p.add_argument("--explain", metavar="FILE", help="show receipt extraction for one file")
    p.add_argument("--selftest", action="store_true", help="run built-in fixture assertions")
    p.add_argument("--write-fixture", metavar="DIR", help="write the demo git fixture to DIR")
    p.add_argument("--version", action="version", version=f"clutch {VERSION}")
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.selftest:
        return selftest()
    if args.write_fixture:
        dest = Path(args.write_fixture).resolve()
        build_fixture(dest)
        print(dest)
        return 0

    start = Path(args.chdir).resolve() if args.chdir else Path.cwd()
    if not start.exists():
        eprint(f"clutch: no such directory: {start}")
        return 2
    root = start
    # climb to git root when present
    climb = start
    for _ in range(16):
        if (climb / ".git").exists():
            root = climb
            break
        if climb.parent == climb:
            break
        climb = climb.parent

    if args.explain:
        path = Path(args.explain)
        if not path.is_absolute():
            path = (start / path).resolve()
        return print_explain(root, path)

    paths = [Path(p) for p in args.paths]
    members = scan(root, paths, include_locks=args.locks)
    summaries = clutch_summaries(members)

    if args.json:
        print(
            json.dumps(
                {
                    "root": str(root),
                    "clutches": summaries,
                    "members": [m.row() for m in members],
                },
                indent=2,
                ensure_ascii=False,
            )
        )
    elif args.tsv:
        print_tsv(members)
    elif args.summary:
        if args.json:
            print(json.dumps(summaries, indent=2, ensure_ascii=False))
        else:
            for s in summaries:
                print(
                    f"{s['verdict']:<8} {s['size']:>4}  {s['clutch']}\t"
                    f"die={fmt_stamp(s['die'], 20)}  "
                    f"ages {s['age_min'] if s['age_min'] is not None else '-'}..{s['age_max'] if s['age_max'] is not None else '-'}"
                )
    else:
        print_pretty(members, summaries, verbose=args.verbose)

    status = 0
    for m in members:
        cv = m.clutch_verdict
        if cv in {"STALE", "SPLIT", "ORPHAN", "FOREIGN", "NOW"}:
            status = 1
            break
        if cv in {"COLD", "RAGGED"} and not args.ok_cold:
            status = 1
            break
        if m.verdict in {"STALE", "ORPHAN", "NOW"}:
            status = 1
            break
    return status


if __name__ == "__main__":
    sys.exit(main())
