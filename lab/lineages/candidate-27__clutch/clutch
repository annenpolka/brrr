# Testimony must show up early or the file is just talking about generation.
HEAD_BYTES = 8192
HEAD_LINES = 12

RE_MARK = re.compile(
    r"(?i)(@generated|auto-?generated|generated from|generated by|"
    r"do not edit|don't edit|not intended for manual editing|"
    r"hand[- ]?edit forbidden|手編集禁止|生成物)"
)
RE_BANNER = re.compile(
    r"(?i)("
    r"generated from\s+\S|"
    r"@generated\b|"
    r"this file is automatically @generated|"
    r"automatically @generated by\b|"
    r"生成物\s*[—–-]|"
    r"<!--\s*generated\b"
    r")"
)
RE_DO_NOT_EDIT = re.compile(
    r"(?i)do not edit|don't edit|not intended for manual editing|手編集禁止"
)

RE_FROM_BY = re.compile(
    r"(?i)@generated\s+by\s+(\S+)\s+from\s+[ `'\"]*([^\s`'\"]+)"
)
RE_GENERATED_FROM = re.compile(
    r"(?i)generated(?:\s+\w+){0,3}\s+from\s+[ `'\"]*([^\s`'\"]+)"
)
RE_GENERATED_BY = re.compile(
    r"(?i)(?:@generated|generated)\s+by\s+[ `'\"]*([^\s`'\"]+)"
)
RE_HONBAN = re.compile(r"正本は\s*[ `「『]*([^`」』\s]+)")
RE_SOURCE_FIELD = re.compile(
    r"(?i)(?:^|\n)\s*(?:[-*]\s*)?[\"']?(?:source|parent)[\"']?\s*:\s*[ `'\"]*([^\s`'\"]+)"
)
RE_STAMP = re.compile(
    r"(?i)[\"']?(?:source\s*fingerprint|sourcefingerprint|source_fingerprint)[\"']?"
    r"\s*[:=]\s*[ `'\"]*(sha256:[a-f0-9]{64})"
)
RE_HOST = re.compile(r"(?i)\bon host(?:name)?\s+([A-Za-z0-9._-]+)")
RE_WHEN = re.compile(r"(?i)\bat\s+(\d{4}-\d{2}-\d{2}(?:[T ][0-9:+-]+)?)")
RE_RECIPE = re.compile(
    r"(?i)(?:just|run|execute)\s+`?(spec-gen|spec:gen)[`']?"
    r"|再生(?:成)?は\s*`([^`]+)`"
)

TRAIL_PUNCT = re.compile(r"[.,;:…。、—–\-]+$")


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def clean_path(raw: str) -> str:
    raw = raw.strip().strip("`\"'")
    raw = TRAIL_PUNCT.sub("", raw)
    raw = raw.strip().strip("`\"'")
    if raw.startswith("./"):
        raw = raw[2:]
    return raw


def looks_generated_name(name: str) -> bool:
    lower = name.lower()
    if lower.endswith(".log") or lower.endswith(".proptest-regressions"):
        return False
    if ".generated." in lower or lower.endswith(".generated"):
        return True
    if "_generated." in lower or lower.endswith("_generated"):
        return True
    if "generated." in name and name[0].isupper():
        return True  # OraclesGenerated.swift
    return False


def skip_named(name: str) -> bool:
    if name in SKIP_NAMES:
        return True
    lower = name.lower()
    if lower.startswith("spec-gen.") or lower.startswith("spec-check."):
        return True
    if lower.endswith(".log") or lower.endswith(".proptest-regressions"):
        return True
    return False


def valid_parent(path: str | None) -> str | None:
    if not path:
        return None
    if any(ch in path for ch in "*?<>|、。；"):
        return None
    base = path.rsplit("/", 1)[-1]
    if "." not in base and "/" not in path:
        return None
    return path


def has_banner(text: str) -> bool:
    nonempty = [ln for ln in text.splitlines() if ln.strip()][:5]
    head = "\n".join(nonempty)
    if RE_BANNER.search(head):
        return True
    if RE_DO_NOT_EDIT.search(head) and re.search(r"(?i)generat", head):
        return True
    return False


@dataclass
class Receipt:
    path: str
    parent: str | None = None
    generator: str | None = None
    stamp: str | None = None
    machine: str | None = None
    generated_at: str | None = None
    recipe: str | None = None
    notice: bool = False
    how: str = "header"
    snippet: str = ""


@dataclass
class GitFact:
    commit: str | None = None
    unix: int | None = None
    subject: str | None = None
    dirty: bool = False
    untracked: bool = False


@dataclass
class Member:
    receipt: Receipt
    git: GitFact
    parent_git: GitFact | None = None
    age: int | None = None
    parent_sha256: str | None = None
    stamp_currency: str | None = None  # byte | die | none
    parent_missing: bool = False
    parent_dirty: bool = False
    verdict: str = "FRESH"
    clutch_id: str = ""
    die: str | None = None
    clutch_verdict: str = "FRESH"
    notes: list[str] = field(default_factory=list)

    def row(self) -> dict:
        r = self.receipt
        return {
            "verdict": self.verdict,
            "age": self.age,
            "path": r.path,
            "parent": r.parent,
            "stamp": r.stamp,
            "die": self.die,
            "stamp_currency": self.stamp_currency,
            "generator": r.generator,
            "machine": r.machine,
            "generated_at": r.generated_at,
            "how": r.how,
            "clutch": self.clutch_id,
            "clutch_verdict": self.clutch_verdict,
            "commit": self.git.commit,
            "parent_commit": self.parent_git.commit if self.parent_git else None,
            "parent_dirty": self.parent_dirty,
            "notes": self.notes,
        }


class Git:
    def __init__(self, root: Path):
        self.root = root
        self.ok = (root / ".git").exists()
        self._last: dict[str, GitFact] = {}
        self._age: dict[tuple[str, str], int | None] = {}
        self._dirty: set[str] | None = None
        self._untracked: set[str] | None = None

    def _run(self, args: list[str]) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["git", "-C", str(self.root), *args],
            capture_output=True,
            text=True,
        )

    def _load_status(self) -> None:
        if self._dirty is not None:
            return
        self._dirty, self._untracked = set(), set()
        if not self.ok:
            return
        proc = self._run(["status", "--porcelain", "-u", "--no-renames"])
        if proc.returncode != 0:
            return
        for line in proc.stdout.splitlines():
            if len(line) < 4:
                continue
            xy, path = line[:2], line[3:]
            if " -> " in path:
                path = path.split(" -> ", 1)[1]
            path = path.strip().strip('"')
            if xy == "??":
                self._untracked.add(path)
            else:
                self._dirty.add(path)

    def last(self, relpath: str) -> GitFact:
        if relpath in self._last:
            return self._last[relpath]
        fact = GitFact()
        self._load_status()
        if self._dirty is not None and relpath in self._dirty:
            fact.dirty = True
        if self._untracked is not None and relpath in self._untracked:
            fact.untracked = True
        if self.ok and not fact.untracked:
            proc = self._run(["log", "-1", "--format=%H%n%ct%n%s", "--", relpath])
            if proc.returncode == 0:
                lines = proc.stdout.splitlines()
                if len(lines) >= 2 and lines[0]:
                    fact.commit = lines[0]
                    try:
                        fact.unix = int(lines[1])
                    except ValueError:
                        fact.unix = None
                    fact.subject = lines[2] if len(lines) > 2 else None
        self._last[relpath] = fact
        return fact

    def age(self, artifact_commit: str | None, parent: str) -> int | None:
        if not self.ok or not artifact_commit or not parent:
            return None
        key = (artifact_commit, parent)
        if key in self._age:
            return self._age[key]
        proc = self._run(
            ["rev-list", "--count", f"{artifact_commit}..HEAD", "--", parent]
        )
        if proc.returncode != 0 or not proc.stdout.strip():
            self._age[key] = None
            return None
        try:
            n = int(proc.stdout.strip())
        except ValueError:
            n = None
        self._age[key] = n
        return n


def iter_files(root: Path, paths: list[Path]) -> Iterable[Path]:
    if not paths:
        paths = [root]

    def walk(base: Path) -> Iterable[Path]:
        if base.is_file():
            yield base
            return
        if not base.is_dir():
            return
        for dirpath, dirnames, filenames in os.walk(base, followlinks=False):
            rel_dir = Path(dirpath)
            # prune
            keep = []
            for d in dirnames:
                if d in SKIP_DIRS:
                    continue
                p = rel_dir / d
                try:
                    st = p.lstat()
                except OSError:
                    continue
                if stat.S_ISLNK(st.st_mode):
                    continue
                if d == ".git" or (p / ".git").exists():
                    # nested repository
                    if Path(dirpath) != root:
                        continue
                    keep.append(d)
                    continue
                keep.append(d)
            dirnames[:] = keep
            for name in filenames:
                p = rel_dir / name
                try:
                    st = p.lstat()
                except OSError:
                    continue
                if not stat.S_ISREG(st.st_mode):
                    continue
                yield p

    seen: set[Path] = set()
    for raw in paths:
        path = raw if raw.is_absolute() else (root / raw)
        path = path.resolve()
        try:
            path.relative_to(root)
        except ValueError:
            eprint(f"clutch: skip path outside root: {path}")
            continue
        for f in walk(path):
            rp = f.resolve()
            if rp not in seen:
                seen.add(rp)
                yield rp


def read_head(path: Path) -> tuple[str, bool]:
    try:
        data = path.read_bytes()[:HEAD_BYTES]
    except OSError:
        return "", True
    if b"\x00" in data:
        return "", True
    return data.decode("utf-8", errors="replace"), False


def extract_json_fields(text: str) -> dict:
    stripped = text.lstrip()
    if not stripped.startswith("{"):
        return {}
    # Parse only as far as we can; generated manifests put stamps at top.
    try:
        obj = json.loads(stripped)
    except json.JSONDecodeError:
        # truncated head: close enough to grab top keys with a regex already
        return {}
    if not isinstance(obj, dict):
        return {}
    out = {}
    for key in ("sourceFingerprint", "source_fingerprint", "source", "parent"):
        if key in obj and isinstance(obj[key], str):
            out[key] = obj[key]
    return out


def extract_receipt(relpath: str, text: str, name: str) -> Receipt | None:
    lines = text.splitlines()[:HEAD_LINES]
    prefix = "\n".join(lines)
    name_hit = looks_generated_name(name)
    j_early = extract_json_fields(text)
    json_hit = "sourceFingerprint" in j_early or "source_fingerprint" in j_early
    banner = has_banner(text)
    marked = banner or name_hit or json_hit
    if not marked:
        return None

    rec = Receipt(path=relpath, notice=bool(RE_MARK.search(prefix)), how="header")
    rec.snippet = prefix.split("\n", 1)[0][:160]

    m = RE_FROM_BY.search(prefix)
    if m:
        rec.generator = clean_path(m.group(1))
        rec.parent = clean_path(m.group(2))
        rec.how = "generated-by-from"

    if rec.parent is None:
        m = RE_GENERATED_FROM.search(prefix)
        if m:
            rec.parent = clean_path(m.group(1))
            rec.how = "generated-from"

    if rec.parent is None:
        m = RE_HONBAN.search(prefix)
        if m:
            rec.parent = clean_path(m.group(1))
            rec.how = "honban"

    if rec.parent is None:
        m = RE_SOURCE_FIELD.search(prefix)
        if m:
            rec.parent = clean_path(m.group(1))
            rec.how = "source-field"

    if rec.generator is None:
        m = RE_GENERATED_BY.search(prefix)
        if m:
            rec.generator = clean_path(m.group(1))

    m = RE_STAMP.search(prefix) or RE_STAMP.search(text[:2000])
    if m:
        rec.stamp = m.group(1).lower()

    j = extract_json_fields(text)
    if rec.stamp is None:
        fp = j.get("sourceFingerprint") or j.get("source_fingerprint")
        if fp:
            rec.stamp = fp.lower()
            rec.how = "json"
    if rec.parent is None:
        src = j.get("source") or j.get("parent")
        if src:
            rec.parent = clean_path(src)
            rec.how = "json"

    m = RE_HOST.search(prefix)
    if m:
        rec.machine = m.group(1)
    m = RE_WHEN.search(prefix)
    if m:
        rec.generated_at = m.group(1)
    m = RE_RECIPE.search(prefix)
    if m:
        rec.recipe = (m.group(1) or m.group(2) or "").strip()

    if name in LOCK_PARENTS:
        rec.how = "lock"
        if rec.parent is None:
            rec.parent = LOCK_PARENTS[name]
        if rec.generator is None:
            rec.generator = name.split(".")[0]

    if name_hit and rec.how == "header":
        rec.how = "filename"

    rec.parent = valid_parent(rec.parent)
    rec.generator = valid_parent(rec.generator) or rec.generator

    # A lockfile without --locks is filtered later.
    if not rec.parent and not rec.stamp and not rec.notice and not name_hit:
        return None
    return rec


def sha256_file(path: Path) -> str | None:
    try:
        h = hashlib.sha256()
        with path.open("rb") as fh:
            for chunk in iter(lambda: fh.read(1 << 16), b""):
                h.update(chunk)
        return "sha256:" + h.hexdigest()
    except OSError:
        return None


def resolve_parent(root: Path, rec: Receipt) -> tuple[str | None, bool]:
    """Return (normalized parent relpath or cited string, missing)."""
    if not rec.parent:
        return None, False
    cited = rec.parent.lstrip("/")
    candidates = [root / cited]
    file_dir = (root / rec.path).parent
    candidates.append(file_dir / cited)
    for cand in candidates:
        try:
            resolved = cand.resolve()
        except OSError:
            continue
        if resolved.exists() and resolved.is_file():
            try:
                rel = str(resolved.relative_to(root)).replace("\\", "/")
            except ValueError:
                rel = cited
            return rel, False
        if resolved.exists() and resolved.is_dir():
            try:
                rel = str(resolved.relative_to(root)).replace("\\", "/")
            except ValueError:
                rel = cited
            return rel, False
    return cited, True


def rel_of(root: Path, path: Path) -> str:
    return str(path.resolve().relative_to(root)).replace("\\", "/")


def score_clutches(members: list[Member]) -> None:
    groups: dict[str, list[Member]] = defaultdict(list)
    for m in members:
        key = m.receipt.parent or f"mute:{str(Path(m.receipt.path).parent)}"
        m.clutch_id = key
        groups[key].append(m)

    for key, group in groups.items():
        stamps = [m.receipt.stamp for m in group if m.receipt.stamp]
        stamp_counts = Counter(stamps)
        # Die = stamp of the current generation: prefer members whose parent
        # has not moved since they were written (age 0), newest first.
        stamped = [m for m in group if m.receipt.stamp]
        die: str | None = None
        if stamped:
            current = [m for m in stamped if (m.age or 0) == 0]
            pool = current or stamped
            pool_sorted = sorted(
                pool,
                key=lambda m: (m.git.unix or 0, m.receipt.path),
                reverse=True,
            )
            die = pool_sorted[0].receipt.stamp
        elif stamp_counts:
            die = stamp_counts.most_common(1)[0][0]

        machines = {m.receipt.machine for m in group if m.receipt.machine}
        ages = [m.age for m in group if m.age is not None]
        n_stale_stamp = 0
        n_cold = 0
        n_fresh = 0
        n_orphan = 0
        n_mute = 0
        n_dirty = 0

        for m in group:
            m.die = die
            notes = []
            parent_missing = m.parent_missing
            stamp = m.receipt.stamp
            age = m.age
            if parent_missing:
                m.verdict = "ORPHAN"
                n_orphan += 1
                notes.append("cited parent is not in the tree")
            elif m.receipt.parent is None:
                m.verdict = "MUTE"
                n_mute += 1
                notes.append("generated notice, no cited parent")
            elif stamp and die and stamp != die:
                m.verdict = "STALE"
                n_stale_stamp += 1
                notes.append("stamp is not the clutch die")
            elif age is not None and age > 0:
                m.verdict = "COLD"
                n_cold += 1
                notes.append(f"{age} parent commit(s) after this artifact")
                if m.parent_dirty and not m.git.dirty:
                    notes.append("parent is also dirty in the work tree")
            elif m.parent_dirty and not m.git.dirty:
                m.verdict = "NOW"
                n_dirty += 1
                notes.append("parent is dirty, artifact was not rewritten in the work tree")
            else:
                m.verdict = "FRESH"
                n_fresh += 1
            if m.stamp_currency == "die":
                notes.append("stamp is not sha256 of parent bytes (IR/other die)")
            elif m.stamp_currency == "byte":
                notes.append("stamp matches parent bytes")
            m.notes = notes

        distinct_stamps = len(set(stamps))
        if n_orphan and n_orphan == len(group):
            cv = "ORPHAN"
        elif n_mute and n_mute == len(group):
            cv = "MUTE"
        elif distinct_stamps > 1:
            cv = "SPLIT"
        elif len(machines) > 1:
            cv = "FOREIGN"
        elif n_stale_stamp and n_fresh:
            cv = "SPLIT"
        elif n_stale_stamp:
            cv = "STALE"
        elif n_cold and (n_fresh or n_dirty):
            cv = "RAGGED"
        elif n_dirty and n_fresh:
            cv = "RAGGED"
        elif n_dirty:
            cv = "NOW"
        elif n_cold:
            cv = "COLD"
        else:
            cv = "FRESH"
        for m in group:
            m.clutch_verdict = cv


def _parse_generated_md(text: str) -> str | None:
    m = RE_SOURCE_FIELD.search(text[:2000])
    if not m:
        return None
    return valid_parent(clean_path(m.group(1)))


def _inherit_parents(root: Path, recs: list[Receipt]) -> None:
    """Stamp-join and GENERATED.md directory maps fill in mute siblings."""
    stamp_parent: dict[str, str] = {}
    for rec in recs:
        if rec.stamp and rec.parent:
            parent, missing = resolve_parent(root, rec)
            if parent and not missing:
                stamp_parent[rec.stamp] = parent
    for rec in recs:
        if rec.parent is None and rec.stamp and rec.stamp in stamp_parent:
            rec.parent = stamp_parent[rec.stamp]
            rec.how = (rec.how or "header") + "+stamp-join"

    maps: list[tuple[str, str]] = []
    for rec in recs:
        name = Path(rec.path).name
        if name in {"GENERATED.md", "GENERATED.txt"} and rec.parent:
            parent, missing = resolve_parent(root, rec)
            if parent and not missing:
                maps.append((str(Path(rec.path).parent), parent))
    for rec in recs:
        if rec.parent:
            continue
        path = rec.path
        for directory, parent in maps:
            prefix = "" if directory in {".", ""} else directory + "/"
            if directory in {".", ""}:
                under = True
            else:
                under = path.startswith(prefix) or path == directory
            if not under:
                continue
            name = Path(path).name
            if looks_generated_name(name) or name.endswith(".schema.json"):
                rec.parent = parent
                rec.how = (rec.how or "header") + "+generated-md"
                break


def _member_from(root: Path, git: Git, rec: Receipt) -> Member:
    parent, missing = resolve_parent(root, rec)
    rec.parent = parent
    gfact = git.last(rec.path)
    pfact = git.last(parent) if parent and not missing else None
    age = git.age(gfact.commit, parent) if parent and not missing else None
    parent_sha = None
    currency = None
    if parent and not missing and (root / parent).is_file():
        parent_sha = sha256_file(root / parent)
        if rec.stamp and parent_sha:
            currency = "byte" if rec.stamp == parent_sha else "die"
        elif rec.stamp:
            currency = "die"
        else:
            currency = "none"
    elif rec.stamp:
        currency = "die"
    parent_dirty = bool(pfact and pfact.dirty and not gfact.dirty)
    return Member(
        receipt=rec,
        git=gfact,
        parent_git=pfact,
        age=age,
        parent_sha256=parent_sha,
        stamp_currency=currency,
        parent_missing=missing,
        parent_dirty=parent_dirty,
    )


def scan(
    root: Path,
    paths: list[Path],
    include_locks: bool,
) -> list[Member]:
    root = root.resolve()
    git = Git(root)
    recs: list[Receipt] = []
    extra_maps: list[Receipt] = []
    for path in iter_files(root, paths):
        name = path.name
        if skip_named(name):
            # still read GENERATED.md maps from skipped names? no, not skipped
            continue
        if name in LOCK_NAMES and not include_locks:
            continue
        rel = rel_of(root, path)
        text, binary = read_head(path)
        if binary:
            continue
        if name in {"GENERATED.md", "GENERATED.txt"}:
            src = _parse_generated_md(text)
            if src:
                extra_maps.append(
                    Receipt(path=rel, parent=src, how="generated-md", notice=True)
                )
        rec = extract_receipt(rel, text, name)
        if rec is None:
            continue
        recs.append(rec)
    # GENERATED.md may already be in recs; extra_maps covers a map that
    # extract_receipt ignored. Dedup by path.
    have = {r.path for r in recs}
    for extra in extra_maps:
        if extra.path not in have:
            recs.append(extra)
    _inherit_parents(root, recs)
    members = [_member_from(root, git, rec) for rec in recs]
    score_clutches(members)
    members.sort(
        key=lambda m: (m.clutch_id, m.verdict != "FRESH", -(m.age or 0), m.receipt.path)
    )
    return members


def clutch_summaries(members: list[Member]) -> list[dict]:
    groups: dict[str, list[Member]] = defaultdict(list)
    for m in members:
        groups[m.clutch_id].append(m)
    out = []
    for key, group in sorted(groups.items()):
        ages = [m.age for m in group if m.age is not None]
        stamps = sorted({m.receipt.stamp for m in group if m.receipt.stamp})
        machines = sorted({m.receipt.machine for m in group if m.receipt.machine})
        counts = Counter(m.verdict for m in group)
        out.append(
            {
                "clutch": key,
                "verdict": group[0].clutch_verdict,
                "size": len(group),
                "die": group[0].die,
                "stamps": stamps,
                "machines": machines,
                "age_min": min(ages) if ages else None,
                "age_max": max(ages) if ages else None,
                "counts": dict(counts),
                "generator": next((m.receipt.generator for m in group if m.receipt.generator), None),
                "parent_dirty": any(m.parent_dirty for m in group),
                "members": [m.receipt.path for m in group],
            }
        )
    return out


def fmt_age(age: int | None) -> str:
    return "-" if age is None else str(age)


def fmt_stamp(stamp: str | None, width: int = 18) -> str:
    if not stamp:
        return "-"
    if len(stamp) <= width:
        return stamp
    return stamp[: width - 1] + "…"


def print_pretty(members: list[Member], summaries: list[dict], verbose: bool) -> None:
    if not members:
        print("clutch: no generation receipts")
        return
    by = defaultdict(list)
    for m in members:
        by[m.clutch_id].append(m)
    for summary in summaries:
        key = summary["clutch"]
        group = by[key]
        ages = summary["age_min"], summary["age_max"]
        if ages[0] is None:
            age_s = "ages -"
        elif ages[0] == ages[1]:
            age_s = f"age {ages[0]}"
        else:
            age_s = f"ages {ages[0]}–{ages[1]}"
        die = fmt_stamp(summary["die"], 22)
        dirty = "  parent=dirty" if summary.get("parent_dirty") else ""
        print(
            f"clutch  {key}  {summary['size']} files  "
            f"die={die}  {age_s}  {summary['verdict']}{dirty}"
        )
        if summary["machines"]:
            print(f"        machines: {', '.join(summary['machines'])}")
        show = group
        if not verbose:
            interesting = [m for m in group if m.verdict != "FRESH"]
            if interesting and len(interesting) < len(group):
                show = interesting
                n_fresh = len(group) - len(interesting)
                print(f"  … {n_fresh} FRESH hidden (pass -v)")
        for m in show:
            stamp = fmt_stamp(m.receipt.stamp)
            extra = ""
            if m.stamp_currency == "die":
                extra = "  currency=die"
            elif m.stamp_currency == "byte":
                extra = "  currency=byte"
            if m.receipt.machine:
                extra += f"  host={m.receipt.machine}"
            print(
                f"  {m.verdict:<7} {fmt_age(m.age):>4}  {m.receipt.path}  "
                f"stamp={stamp}{extra}"
            )
            if verbose and m.notes:
                for n in m.notes:
                    print(f"           {n}")
        print()


def print_tsv(members: list[Member]) -> None:
    cols = [
        "verdict",
        "age",
        "path",
        "parent",
        "stamp",
        "die",
        "clutch_verdict",
        "stamp_currency",
        "generator",
        "machine",
        "commit",
    ]
    print("\t".join(cols))
    for m in members:
        row = m.row()
        out = []
        for c in cols:
            v = row.get(c)
            if v is None:
                v = ""
            out.append(str(v).replace("\t", " ").replace("\n", " "))
        print("\t".join(out))


def print_explain(root: Path, path: Path) -> int:
    if not path.exists():
        eprint(f"clutch: not found: {path}")
        return 2
    rel = rel_of(root, path.resolve())
    text, binary = read_head(path)
    if binary:
        print(f"{rel}: binary or unreadable")
        return 1
    rec = extract_receipt(rel, text, path.name)
    print(f"path: {rel}")
    print("--- head ---")
    print("\n".join(text.splitlines()[:HEAD_LINES]))
    print("--- receipt ---")
    if rec is None:
        print("(none)")
        return 1
    print(json.dumps(asdict(rec), indent=2, ensure_ascii=False))
    return 0


