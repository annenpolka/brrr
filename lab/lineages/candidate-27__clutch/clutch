#!/usr/bin/env python3
"""clutch — generation receipts as a Unix object.

A generated file testifies about its making (parent, stamp, generator,
machine). Files that cite the same parent are a clutch: one generation
event. Git never recorded the lot. clutch reconstructs it and reports
when the eggs were not re-laid together.
"""

from __future__ import annotations

