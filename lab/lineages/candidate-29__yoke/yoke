#!/usr/bin/env python3
"""yoke — clause-level slack between spec source-of-truth and generated artifacts.

The object is a *join* keyed by stable clause ids (EPF-001, FLT-001, BEM-001).
The verb is: say whether each id is taut, slack, hand, split, or riven,
without running the generator.

    taut   spec and generated witnesses agree
    slack  spec is ahead (generated missing or older body)
    hand   generated has no live spec parent (hand-edit or leftover)
    split  generated witnesses disagree with each other
    riven  a spec or generated witness still contains conflict markers

Exit 0 when nothing but taut remains (after filters). Exit 1 on slack/hand/split/riven.
Exit 2 on tool error.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import unicodedata
from collections import Counter, defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable, Iterator

CLAUSE_ID = re.compile(r"[A-Z][A-Z0-9]{2}-\d{3}")
# SHA-256 / MD5-128 etc. match the clause shape but are hash names, not clauses.
NOT_CLAUSE_PREFIX = {"SHA", "MD5", "CRC", "UTF", "ISO", "RFC", "CVE", "UUID"}
ID_ASSIGN = re.compile(
    r"""(?P<kw>id)\s*[:=]\s*["'`](?P<id>[A-Z][A-Z0-9]{2}-\d{3})["'`]""",
    re.I,
)
PKL_ID = re.compile(r'id\s*=\s*"(?P<id>[A-Z][A-Z0-9]{2}-\d{3})"')
SWIFT_TEST = re.compile(
    r'@Test\(\s*"(?P<id>[A-Z][A-Z0-9]{2}-\d{3})\s+(?P<desc>[^"]*)"'
)
RUST_DOC = re.compile(
    r"""///\s*(?P<id>[A-Z][A-Z0-9]{2}-\d{3})\s*:\s*(?P<desc>.+)"""
)
MD_ROW = re.compile(
    r"""^\|\s*`?(?P<id>[A-Z][A-Z0-9]{2}-\d{3})`?\s*\|(?P<rest>.*)\|\s*$""",
    re.M,
)
BANNER_HINT = re.compile(
    r"@generated|generated from|do not edit|手編集禁止|生成物|GENERATED",
    re.I,
)
BANNER_FROM = re.compile(
    r"""(?:from|正本は|Source:)\s*[`'" ]*([^\s`'"、。]+?\.(?:pkl|md))""",
    re.I,
)
CONFLICT_RE = re.compile(r"^<<<<<<< ", re.M)
WORK_ALIASES = {":", "WORK", "work", "working", ".", ""}

