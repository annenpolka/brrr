def orbit_to_json(o: Orbit) -> dict[str, Any]:
    return {
        "version": o.version,
        "requested": o.requested,
        "chosen": o.chosen,
        "real": o.real,
        "guise": o.guise,
        "payload": o.payload,
        "proxy": o.proxy,
        "kind": o.kind,
        "arch": o.arch,
        "interp": o.interp,
        "cwd": o.cwd,
        "restricted": o.restricted,
        "entry": o.entry,
        "entry_restricted": o.entry_restricted,
        "entry_sign": o.entry_sign,
        "sha": o.sha,
        "stat": o.stat,
        "sign": o.sign,
        "path_hits": o.path_hits,
        "chain": [asdict(h) for h in o.chain],
        "rpaths": o.rpaths,
        "dylibs": [asdict(d) for d in o.dylibs],
        "env": [asdict(e) for e in o.env],
        "configs": o.configs,
        "warnings": o.warnings,
        "scan_dylibs": o.scan_dylibs,
    }


def load_orbit_json(path: str) -> dict[str, Any]:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, dict) or "payload" not in data or "requested" not in data:
        raise OrbitError(f"not an orbit dump: {path}")
    return data


def canonical_records(data: dict[str, Any]) -> list[tuple[str, str]]:
    recs: list[tuple[str, str]] = []

    def add(k: str, v: object) -> None:
        if v is None or v == "":
            recs.append((k, "-"))
        elif isinstance(v, bool):
            recs.append((k, "yes" if v else "no"))
        else:
            recs.append((k, str(v)))

    add("requested", data.get("requested"))
    add("chosen", data.get("chosen"))
    add("guise", data.get("guise"))
    add("payload", data.get("payload"))
    add("proxy", data.get("proxy") or "-")
    add("kind", data.get("kind"))
    add("arch", data.get("arch"))
    add("interp", data.get("interp"))
    add("restricted", bool(data.get("restricted")))
    add("entry", data.get("entry"))
    add("entry_restricted", bool(data.get("entry_restricted")))
    add("sha", data.get("sha"))
    sign = data.get("sign") or {}
    add("sign.identifier", sign.get("identifier"))
    add("sign.adhoc", bool(sign.get("adhoc")))
    add("sign.platform", bool(sign.get("platform")))
    add("sign.runtime", bool(sign.get("runtime")))
    for i, hit in enumerate(data.get("path_hits") or []):
        add(f"path.hit.{i}", hit)
    for i, hop in enumerate(data.get("chain") or []):
        add(f"chain.{i}", f"{hop.get('kind')}:{hop.get('path')}->{hop.get('detail')}")
    for i, rp in enumerate(data.get("rpaths") or []):
        add(f"rpath.{i}", f"{rp.get('raw')}=>{rp.get('expanded')}")
    for d in data.get("dylibs") or []:
        key = "dylib." + (d.get("name") or "")
        stt = d.get("status") or ("missing" if d.get("missing") else "ok")
        if stt == "missing":
            add(key, "MISSING")
        elif stt == "shared":
            add(key, "shared-cache")
        else:
            add(key, d.get("resolved") or "-")
    for e in data.get("env") or []:
        name = e.get("name")
        named = "named" if e.get("named") else "unnamed"
        sip = e.get("sip") or "n/a"
        val = e.get("value")
        val_s = "(unset)" if val is None else val
        add(f"env.{name}", f"{named} sip={sip} value={val_s}")
        if e.get("sources"):
            add(f"env.{name}.from", ",".join(e["sources"]))
    for pth, stt in sorted((data.get("configs") or {}).items()):
        add("config." + pth, stt)
    for i, w in enumerate(data.get("warnings") or []):
        add(f"warn.{i}", w)
    recs.sort()
    return recs


def format_porcelain(data: dict[str, Any]) -> str:
    lines = [f"{k}\t{v}" for k, v in canonical_records(data)]
    return "\n".join(lines) + ("\n" if lines else "")


def _short(path: str, width: int = 72) -> str:
    home = os.path.expanduser("~")
    if path.startswith(home + os.sep):
        path = "~" + path[len(home) :]
    if len(path) <= width:
        return path
    return path[:20] + "…" + path[-(width - 21) :]


def format_human(data: dict[str, Any]) -> str:
    lines: list[str] = []
    req = data.get("requested")
    lines.append(f"orbit  {req}")
    lines.append(f"  chosen     {_short(str(data.get('chosen')))}")
    lines.append(f"  guise      {_short(str(data.get('guise')))}")
    lines.append(f"  payload    {_short(str(data.get('payload')))}")
    lines.append(f"  proxy      {data.get('proxy') or '-'}")
    kind = data.get("kind") or "-"
    arch = data.get("arch") or ""
    lines.append(f"  kind       {kind}  {arch}".rstrip())
    if data.get("interp"):
        lines.append(f"  interp     {data.get('interp')}")
    rest = "RESTRICTED" if data.get("restricted") else "unrestricted"
    sign = data.get("sign") or {}
    ident = sign.get("identifier") or "-"
    bits = []
    if sign.get("platform"):
        bits.append("platform")
    if sign.get("runtime"):
        bits.append("hardened")
    if sign.get("adhoc"):
        bits.append("adhoc")
    if sign.get("linker_signed"):
        bits.append("linker-signed")
    lines.append(f"  sign       {ident}  {rest}  {' '.join(bits)}".rstrip())
    entry = data.get("entry") or ""
    if entry and os.path.realpath(entry) != os.path.realpath(str(data.get("payload") or entry)):
        lines.append(
            f"  entry      {_short(str(entry))}  "
            f"{'RESTRICTED' if data.get('entry_restricted') else 'unrestricted'}"
        )
    hits = data.get("path_hits") or []
    if hits:
        lines.append("  PATH hits")
        for i, h in enumerate(hits):
            mark = "  ← chosen" if i == 0 and data.get("chosen") == h else ""
            shadow = "  (shadowed)" if i > 0 else mark
            lines.append(f"    {i} {_short(h)}{shadow}")
    chain = data.get("chain") or []
    if chain:
        lines.append("  chain")
        for hop in chain:
            lines.append(
                f"    {hop.get('kind'):<10} {_short(str(hop.get('path')))} → { _short(str(hop.get('detail') or ''))}"
            )
    dylibs = data.get("dylibs") or []

    def dstatus(d: dict[str, Any]) -> str:
        return str(d.get("status") or ("missing" if d.get("missing") else "ok"))

    missing = [d for d in dylibs if dstatus(d) == "missing"]
    shared = [d for d in dylibs if dstatus(d) == "shared"]
    first_party = [
        d
        for d in dylibs
        if dstatus(d) == "ok" and not d.get("system")
    ]
    lines.append(
        f"  dylibs     {len(dylibs)}  first-party {len(first_party)}  "
        f"missing {len(missing)}  shared-cache {len(shared)}"
    )
    for d in missing:
        lines.append(f"    MISSING   {d.get('name')}")
    for d in first_party[:12]:
        lines.append(f"    {_short(str(d.get('resolved') or d.get('name')))}")
    if len(first_party) > 12:
        lines.append(f"    … {len(first_party) - 12} more")
    rpaths = data.get("rpaths") or []
    if rpaths:
        lines.append("  rpath")
        for rp in rpaths:
            lines.append(f"    {rp.get('raw')}  =>  {_short(str(rp.get('expanded')))}")
    named = [e for e in (data.get("env") or []) if e.get("named")]
    stripped = [
        e
        for e in (data.get("env") or [])
        if e.get("sip") == "STRIP" and e.get("value") is not None
    ]
    lines.append(f"  env named  {len(named)}")
    for e in named[:20]:
        val = e.get("value")
        val_s = "(unset)" if val is None else _short(str(val), 40)
        sip = f"  sip={e.get('sip')}" if e.get("sip") in {"STRIP", "keep"} and e["name"].startswith("DYLD_") else ""
        lines.append(f"    {e['name']:<28} {val_s}{sip}")
    if len(named) > 20:
        lines.append(f"    … {len(named) - 20} more")
    if stripped:
        lines.append("  sip STRIP  (set in this environment, ignored for this binary)")
        for e in stripped:
            lines.append(f"    {e['name']}={_short(str(e.get('value')), 40)}")
    configs = data.get("configs") or {}
    if configs:
        lines.append("  config")
        for pth, stt in sorted(configs.items()):
            lines.append(f"    {stt:<8} {_short(pth)}")
    for w in data.get("warnings") or []:
        lines.append(f"  warn       {w}")
    lines.append(f"  verdict    {verdict(data)}")
    return "\n".join(lines) + "\n"


def verdict(data: dict[str, Any]) -> str:
    bits: list[str] = []
    proxy = data.get("proxy") or ""
    guise = data.get("guise")
    payload = data.get("payload")
    if proxy and guise != payload:
        bits.append(f"{proxy} guise→payload")
    if data.get("restricted"):
        bits.append("DYLD_* stripped")
    missing = sum(
        1
        for d in (data.get("dylibs") or [])
        if (d.get("status") or ("missing" if d.get("missing") else "ok")) == "missing"
    )
    if missing:
        bits.append(f"{missing} dylib missing — this copy will not load")
    hits = data.get("path_hits") or []
    if len(hits) > 1:
        bits.append(f"{len(hits)} PATH hits, first wins")
    named_set = [
        e["name"]
        for e in (data.get("env") or [])
        if e.get("named") and e.get("value") is not None
    ]
    named_unset = [
        e["name"]
        for e in (data.get("env") or [])
        if e.get("named") and e.get("value") is None
    ]
    if named_set:
        bits.append(f"{len(named_set)} named env set")
    elif named_unset:
        bits.append("names env vars but none of them are set")
    if not bits:
        bits.append("payload is the guise; no silent env filter")
    return "; ".join(bits)


def diff_records(
    left: dict[str, Any], right: dict[str, Any], *, ignore: set[str]
) -> list[tuple[str, str, str]]:
    lmap = dict(canonical_records(left))
    rmap = dict(canonical_records(right))

    def skip(k: str) -> bool:
        if k in ignore:
            return True
        for pref in ignore:
            if pref.endswith(".") and k.startswith(pref):
                return True
            if k == pref:
                return True
        if k in {"requested", "chosen"}:
            return True
        return False

    keys = sorted(set(lmap) | set(rmap))
    out: list[tuple[str, str, str]] = []
    for k in keys:
        if skip(k):
            continue
        lv = lmap.get(k, "∅")
        rv = rmap.get(k, "∅")
        if lv != rv:
            out.append((k, lv, rv))
    return out


def format_diff(
    left: dict[str, Any],
    right: dict[str, Any],
    rows: list[tuple[str, str, str]],
) -> str:
    lines = [
        f"orbit diff  {left.get('requested')}  vs  {right.get('requested')}",
        f"  L payload  {_short(str(left.get('payload')))}",
        f"  R payload  {_short(str(right.get('payload')))}",
        f"  L proxy    {left.get('proxy') or '-'}",
        f"  R proxy    {right.get('proxy') or '-'}",
        f"  diffs      {len(rows)}",
    ]
    if not rows:
        lines.append("  verdict    same orbit")
        return "\n".join(lines) + "\n"
    for k, lv, rv in rows:
        lines.append(f"  {k}")
        lines.append(f"    L  {_short(lv, 90)}")
        lines.append(f"    R  {_short(rv, 90)}")
    # summary
    kinds = set()
    for k, _, _ in rows:
        if k.startswith("dylib."):
            kinds.add("dylib")
        elif k.startswith("env."):
            kinds.add("env")
        elif k.startswith("sign.") or k == "restricted":
            kinds.add("sip")
        elif k in {"payload", "guise", "sha", "kind", "arch"}:
            kinds.add("identity")
        elif k == "proxy" or k.startswith("chain."):
            kinds.add("proxy")
    lines.append("  verdict    " + ", ".join(sorted(kinds)) + " differ")
    return "\n".join(lines) + "\n"


def operand_to_orbit(
    spec: str,
    *,
    cwd: str,
    environ: Mapping[str, str],
    scan_dylibs: bool,
    follow: bool,
    lookup_path: str | None = None,
) -> dict[str, Any]:
    p = Path(spec)
    if p.is_file():
        try:
            if p.stat().st_size < 4_000_000:
                head = p.read_text(encoding="utf-8", errors="ignore")[:32]
                if head.lstrip().startswith("{"):
                    return load_orbit_json(str(p))
        except OSError:
            pass
    o = snapshot(
        spec,
        cwd=cwd,
        environ=environ,
        scan_dylibs=scan_dylibs,
        follow=follow,
        lookup_path=lookup_path,
    )
    return orbit_to_json(o)


