def selftest() -> int:
    failures: list[str] = []

    def expect(cond: bool, msg: str) -> None:
        if not cond:
            failures.append(msg)

    # rpath expansion
    expect(
        expand_rpath("@loader_path/../lib", loader_dir="/opt/app/bin", exec_dir="/x")
        == "/opt/app/bin/../lib",
        "rpath expand",
    )
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        bin_a = root / "a"
        bin_b = root / "b"
        bin_a.mkdir()
        bin_b.mkdir()
        tool_a = bin_a / "tool"
        tool_b = bin_b / "tool"
        tool_a.write_text("#!/usr/bin/env python3\nprint('A')\n# TOOL_A_ENV_VAR\n")
        tool_b.write_text("#!/usr/bin/env python3\nprint('B')\n# TOOL_B_ENV_VAR\n")
        tool_a.chmod(0o755)
        tool_b.chmod(0o755)
        gamma = root / "gamma"
        gamma.write_text("#!/usr/bin/env python3\nprint('gamma')\n# ORBIT_FIXTURE_VAR\n")
        gamma.chmod(0o755)
        beta = root / "beta"
        beta.write_text("#!./gamma\nprint('beta')\n")
        beta.chmod(0o755)
        missing = root / "missing"
        missing.write_text("#!/no/such/orbit-interp\n")
        missing.chmod(0o755)

        env = dict(os.environ)
        env["PATH"] = str(bin_a) + os.pathsep + str(bin_b) + os.pathsep + env.get("PATH", "")
        left = snapshot("tool", cwd=td, environ=env, follow=True)
        expect(left.chosen == str(tool_a), f"PATH first wins: {left.chosen}")
        expect(len(left.path_hits) >= 2, "both PATH hits")
        env2 = dict(env)
        env2["PATH"] = str(bin_b) + os.pathsep + str(bin_a)
        right = snapshot("tool", cwd=td, environ=env2, follow=True)
        expect(right.chosen == str(tool_b), f"PATH reverse: {right.chosen}")
        rows = diff_records(orbit_to_json(left), orbit_to_json(right), ignore={"cwd"})
        expect(any(k == "payload" or k == "guise" for k, _, _ in rows), "diff sees PATH swap")

        names = extract_env_names(str(gamma))
        expect("ORBIT_FIXTURE_VAR" in names, f"extract env from script: {names[:8]}")

        chained = snapshot(str(beta), cwd=td, environ=env, follow=True)
        expect(
            chained.proxy.startswith("shebang"),
            f"relative shebang proxy: {chained.proxy}",
        )
        expect(
            Path(chained.payload).name in {"python3", "python3.14", "python", Path(sys.executable).name}
            or "python" in Path(chained.payload).name,
            f"shebang payload is python: {chained.payload}",
        )

        miss = snapshot(str(missing), cwd=td, environ=env, follow=True)
        expect(
            any("missing interpreter" in w for w in miss.warnings),
            f"missing interp warning: {miss.warnings}",
        )

        blob = root / "blob.bin"
        blob.write_bytes(b"\0PYTHONPATH\0DYLD_INSERT_LIBRARIES\0HTTP\0KIZU_SESSION_ID\0")
        extracted = extract_env_names(str(blob))
        expect("PYTHONPATH" in extracted, "PYTHONPATH")
        expect("DYLD_INSERT_LIBRARIES" in extracted, "DYLD_*")
        expect("KIZU_SESSION_ID" in extracted, "KIZU_*")
        expect("HTTP" not in extracted, "boring HTTP dropped")

        glued = explode_env_token("KIZU_CONFIGXDG_CONFIG_HOMEKIZU_STATE_DIR")
        expect("XDG_CONFIG_HOME" in glued, f"explode XDG: {glued}")
        expect("KIZU_STATE_DIR" in glued, f"explode KIZU_STATE: {glued}")
        expect(not interesting_env_name("DATA_CONST"), "DATA_CONST boring")
        expect(not interesting_env_name("R_CD"), "R_CD boring")
        _, stt, _ = classify_dylib("/usr/lib/libSystem.B.dylib", None)
        expect(stt == "shared", f"libSystem shared-cache not missing: {stt}")

        expect(
            any(e.name == "ORBIT_FIXTURE_VAR" for e in chained.env),
            "shebang hop env harvested",
        )

        same = diff_records(orbit_to_json(left), orbit_to_json(left), ignore={"cwd"})
        expect(same == [], f"self-diff empty: {same[:3]}")

        expect(interesting_env_name("PYTHONPATH"), "PYTHONPATH interesting")
        expect(not interesting_env_name("HTTP"), "HTTP boring")
        expect(
            expand_rpath("@executable_path/../lib/libx.dylib", loader_dir="/p/bin", exec_dir="/p/bin")
            == "/p/bin/../lib/libx.dylib",
            "executable_path",
        )

        sip_keep = is_restricted(
            "/tmp/not-a-system-bin",
            {"platform": False, "runtime": False},
            {"setuid": False, "setgid": False},
        )
        expect(not sip_keep, "tmp unrestricted")
        sip_bin = is_restricted(
            "/bin/ls",
            {"platform": True, "runtime": False},
            {"setuid": False, "setgid": False},
        )
        expect(sip_bin, "/bin/ls restricted")

    if failures:
        for f in failures:
            eprint("selftest FAIL:", f)
        return 1
    print("selftest: ok")
    return 0


# --- cli --------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="orbit",
        description="Dump or diff the effective world of *this* binary (guise, payload, dylibs, named env, SIP).",
    )
    p.add_argument("--version", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--json", action="store_true", help="JSON dump / JSON diff rows")
    p.add_argument("--porcelain", action="store_true", help="canonical key<TAB>value")
    p.add_argument("--cwd", default=None, help="cwd for rustup/xcrun/toolchain files")
    p.add_argument(
        "--path",
        default=None,
        help="PATH used to bind the *name* only; shebang/env still use the process PATH",
    )
    p.add_argument(
        "--env",
        action="append",
        default=[],
        metavar="KEY=VAL",
        help="overlay env (empty VAL unsets). Repeatable.",
    )
    p.add_argument(
        "--scan-dylibs",
        action="store_true",
        help="harvest env names from first-party dylibs (default on)",
    )
    p.add_argument(
        "--no-scan-dylibs",
        action="store_true",
        help="only scan the payload/guise images, not libpython/libnode/…",
    )
    p.add_argument("--no-proxy", action="store_true", help="do not follow rustup/xcselect/shebang")
    p.add_argument(
        "--ignore",
        action="append",
        default=[],
        help="diff: ignore key prefix (repeatable). cwd is ignored by default.",
    )
    p.add_argument(
        "words",
        nargs="*",
        help="dump NAME | diff LEFT RIGHT | paths NAME",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.version:
        print(VERSION)
        return 0
    if args.selftest:
        return selftest()

    cwd = os.path.abspath(args.cwd or os.getcwd())
    environ = overlay_env(os.environ, args.env)
    lookup_path = args.path
    scan_dylibs = not args.no_scan_dylibs

    words = list(args.words)
    if not words:
        parser.print_help()
        return 2

    cmd = words[0]
    rest = words[1:]
    if cmd not in {"dump", "diff", "paths"}:
        rest = words
        cmd = "dump"

    try:
        if cmd == "paths":
            if len(rest) != 1:
                raise OrbitError("usage: orbit paths NAME")
            name = rest[0]
            hits = path_hits(name, lookup_path or environ.get("PATH", ""))
            if not hits:
                raise OrbitError(f"not on PATH: {name}", 1)
            for i, h in enumerate(hits):
                print(f"{i}\t{h}\t{real_file(h)}")
            return 0

        if cmd == "dump":
            if len(rest) != 1:
                raise OrbitError("usage: orbit dump NAME")
            data = operand_to_orbit(
                rest[0],
                cwd=cwd,
                environ=environ,
                scan_dylibs=scan_dylibs,
                follow=not args.no_proxy,
                lookup_path=lookup_path,
            )
            if args.json:
                json.dump(data, sys.stdout, indent=2, sort_keys=True)
                sys.stdout.write("\n")
            elif args.porcelain:
                sys.stdout.write(format_porcelain(data))
            else:
                sys.stdout.write(format_human(data))
            return 0

        if cmd == "diff":
            if len(rest) != 2:
                raise OrbitError("usage: orbit diff LEFT RIGHT")
            left = operand_to_orbit(
                rest[0],
                cwd=cwd,
                environ=environ,
                scan_dylibs=scan_dylibs,
                follow=not args.no_proxy,
                lookup_path=lookup_path,
            )
            right = operand_to_orbit(
                rest[1],
                cwd=cwd,
                environ=environ,
                scan_dylibs=scan_dylibs,
                follow=not args.no_proxy,
                lookup_path=lookup_path,
            )
            ignore = set(args.ignore) | {"cwd"}
            rows = diff_records(left, right, ignore=ignore)
            if args.json:
                json.dump(
                    {
                        "left": left.get("requested"),
                        "right": right.get("requested"),
                        "n": len(rows),
                        "rows": [{"key": k, "left": lv, "right": rv} for k, lv, rv in rows],
                    },
                    sys.stdout,
                    indent=2,
                )
                sys.stdout.write("\n")
            elif args.porcelain:
                for k, lv, rv in rows:
                    print(f"{k}\t{lv}\t{rv}")
            else:
                sys.stdout.write(format_diff(left, right, rows))
            return 0 if not rows else 1

        raise OrbitError(f"unknown command {cmd}")
    except OrbitError as exc:
        eprint("orbit:", exc)
        return exc.code


if __name__ == "__main__":
    sys.exit(main())
