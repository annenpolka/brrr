@dataclass
class Hop:
    path: str
    kind: str
    detail: str = ""


@dataclass
class Dylib:
    name: str
    resolved: str | None
    status: str  # ok | missing | shared
    system: bool

    @property
    def missing(self) -> bool:
        return self.status == "missing"


@dataclass
class EnvFact:
    name: str
    named: bool
    sources: list[str]
    value: str | None
    sip: str  # keep | STRIP | n/a


@dataclass
class Orbit:
    requested: str
    chosen: str
    real: str
    payload: str
    guise: str
    proxy: str
    kind: str
    arch: str
    interp: str
    cwd: str
    path_used: str
    path_hits: list[str]
    chain: list[Hop]
    dylibs: list[Dylib]
    rpaths: list[dict[str, str]]
