class OrbitError(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def run(
    cmd: list[str],
    *,
    timeout: float = 8.0,
    cwd: str | None = None,
    env: Mapping[str, str] | None = None,
) -> tuple[int, str, str]:
    try:
        p = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=cwd,
            env=dict(env) if env is not None else None,
        )
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", "not found: " + cmd[0]
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"


def overlay_env(
    base: Mapping[str, str], extra: list[str] | None
) -> dict[str, str]:
    out = dict(base)
    for item in extra or []:
        if "=" not in item:
            raise OrbitError(f"--env expects KEY=VAL, got {item!r}")
        key, val = item.split("=", 1)
        if val == "" and item.endswith("="):
            out.pop(key, None)
        else:
            out[key] = val
    return out


def path_hits(name: str, path_var: str) -> list[str]:
    hits: list[str] = []
    seen: set[str] = set()
    for dir_ in path_var.split(os.pathsep):
        if not dir_:
            continue
        cand = Path(dir_) / name
        try:
            ok = cand.is_file() and os.access(cand, os.X_OK)
        except OSError:
            ok = False
        if not ok:
            continue
        resolved = str(cand)
        if resolved not in seen:
            seen.add(resolved)
            hits.append(resolved)
    return hits


def choose_command(requested: str, path_var: str) -> str:
    if "/" in requested or requested.startswith("."):
        p = Path(requested).expanduser()
        if not p.exists():
            raise OrbitError(f"not found: {requested}", 1)
        return str(p.absolute())
    hits = path_hits(requested, path_var)
    if not hits:
        raise OrbitError(f"not on PATH: {requested}", 1)
    return hits[0]


def symlink_chain(path: str) -> list[dict[str, str]]:
    hops: list[dict[str, str]] = []
    cur = Path(path)
    seen: set[str] = set()
    for _ in range(32):
        key = str(cur)
        if key in seen:
            hops.append({"path": key, "kind": "cycle", "target": ""})
            break
        seen.add(key)
        if not cur.is_symlink():
            break
        try:
            target = os.readlink(cur)
        except OSError as exc:
            hops.append({"path": str(cur), "kind": "symlink-error", "target": str(exc)})
            break
        hops.append({"path": str(cur), "kind": "symlink", "target": target})
        nxt = Path(target)
        if not nxt.is_absolute():
            nxt = cur.parent / nxt
        cur = nxt
    return hops


def real_file(path: str) -> str:
    try:
        return os.path.realpath(path)
    except OSError:
        return path


def parse_shebang(path: str) -> tuple[str, list[str]] | None:
    try:
        with open(path, "rb") as f:
            head = f.read(4096)
    except OSError:
        return None
    if not head.startswith(b"#!"):
        return None
    line = head.split(b"\n", 1)[0][2:].decode("utf-8", "replace").strip()
    if not line:
        return None
    parts = line.split()
    return parts[0], parts[1:]


def file_kind(path: str) -> str:
    code, out, err = run(["file", "-b", path])
    text = (out or err).strip()
    low = text.lower()
    if "mach-o" in low and "universal" in low:
        return "macho-universal"
    if "mach-o" in low:
        return "macho"
    if "elf" in low:
        return "elf"
    if parse_shebang(path):
        return "shebang"
    if "script" in low or "text" in low:
        return "text"
    return "other"


def sha_identity(path: str) -> str:
    try:
        st = os.stat(path)
    except OSError:
        return ""
    h = hashlib.sha256()
    h.update(str(st.st_size).encode())
    try:
        with open(path, "rb") as f:
            chunk = f.read(65536)
            h.update(chunk)
            if st.st_size > 65536:
                f.seek(max(0, st.st_size - 65536))
                h.update(f.read(65536))
    except OSError:
        pass
    return h.hexdigest()[:16]


def stat_brief(path: str) -> dict[str, Any]:
    try:
        st = os.stat(path)
    except OSError as exc:
        return {"error": str(exc)}
    mode = st.st_mode
    return {
        "size": st.st_size,
        "mode": oct(stat.S_IMODE(mode)),
        "uid": st.st_uid,
        "gid": st.st_gid,
        "mtime": int(st.st_mtime),
        "ino": st.st_ino,
        "dev": st.st_dev,
        "setuid": bool(mode & stat.S_ISUID),
        "setgid": bool(mode & stat.S_ISGID),
    }


# --- Mach-O via otool -------------------------------------------------------


def parse_otool_l(path: str) -> dict[str, Any]:
    code, out, err = run(["otool", "-l", path], timeout=20)
    if code != 0:
        return {"error": (err or out).strip() or f"otool exit {code}"}
    dylibs: list[str] = []
    rpaths: list[str] = []
    interp = ""
    cmd = ""
    for raw in out.splitlines():
        line = raw.strip()
        if line.startswith("cmd "):
            cmd = line.split(None, 1)[1]
            continue
        if cmd in {"LC_LOAD_DYLIB", "LC_LOAD_WEAK_DYLIB", "LC_REEXPORT_DYLIB"}:
            if line.startswith("name "):
                name = line[5:].strip()
                name = re.sub(r"\s*\(offset \d+\)\s*$", "", name)
                dylibs.append(name)
        elif cmd == "LC_RPATH":
            if line.startswith("path "):
                p = line[5:].strip()
                p = re.sub(r"\s*\(offset \d+\)\s*$", "", p)
                rpaths.append(p)
        elif cmd == "LC_LOAD_DYLINKER":
            if line.startswith("name "):
                interp = re.sub(r"\s*\(offset \d+\)\s*$", "", line[5:].strip())
    # fat binaries list each LC twice
    uniq_dylibs: list[str] = []
    seen_d: set[str] = set()
    for d in dylibs:
        if d not in seen_d:
            seen_d.add(d)
            uniq_dylibs.append(d)
    uniq_rpaths: list[str] = []
    seen_r: set[str] = set()
    for r in rpaths:
        if r not in seen_r:
            seen_r.add(r)
            uniq_rpaths.append(r)
    return {"dylibs": uniq_dylibs, "rpaths": uniq_rpaths, "interp": interp}


def expand_rpath(raw: str, *, loader_dir: str, exec_dir: str) -> str:
    out = raw
    out = out.replace("@loader_path", loader_dir)
    out = out.replace("@executable_path", exec_dir)
    return out


def resolve_dylib(
    name: str,
    *,
    loader: str,
    rpaths: list[str],
) -> str | None:
    loader_dir = str(Path(loader).parent)
    if name.startswith("@rpath/"):
        rest = name[len("@rpath/") :]
        for raw in rpaths:
            exp = expand_rpath(raw, loader_dir=loader_dir, exec_dir=loader_dir)
            cand = Path(exp) / rest
            if cand.is_file():
                return str(cand)
        return None
    if name.startswith("@loader_path/") or name.startswith("@executable_path/"):
        exp = expand_rpath(name, loader_dir=loader_dir, exec_dir=loader_dir)
        p = Path(exp)
        return str(p) if p.is_file() else None
    p = Path(name)
    if p.is_file():
        return str(p)
    # relative to loader, last chance
    cand = Path(loader_dir) / name
    if cand.is_file():
        return str(cand)
    return None


def is_system_lib(path: str) -> bool:
    return any(path.startswith(p) for p in SYSTEM_LIB_PREFIXES)


def classify_dylib(name: str, resolved: str | None) -> tuple[str | None, str, bool]:
    """Return (resolved, status, system) where status is ok|missing|shared."""
    if resolved:
        return resolved, "ok", is_system_lib(resolved)
    if is_system_lib(name) and name.startswith("/"):
        return name, "shared", True
    return None, "missing", is_system_lib(name)


# --- codesign / SIP ---------------------------------------------------------


def codesign_info(path: str) -> dict[str, Any]:
    code, out, err = run(["codesign", "-dv", path], timeout=12)
    text = err or out
    info: dict[str, Any] = {
        "ok": code == 0,
        "identifier": "",
        "adhoc": False,
        "platform": False,
        "runtime": False,
        "linker_signed": False,
        "flags_raw": "",
        "format": "",
    }
    for line in text.splitlines():
        if line.startswith("Identifier="):
            info["identifier"] = line.split("=", 1)[1].strip()
        elif line.startswith("Format="):
            info["format"] = line.split("=", 1)[1].strip()
        elif line.startswith("CodeDirectory"):
            m = re.search(r"flags=([0-9a-fx]+)\(([^)]*)\)", line)
            if m:
                info["flags_raw"] = m.group(1)
                flags = m.group(2).lower()
                info["adhoc"] = "adhoc" in flags
                info["runtime"] = "runtime" in flags
                info["linker_signed"] = "linker-signed" in flags
        elif line.startswith("Signature="):
            if "adhoc" in line.lower():
                info["adhoc"] = True
        elif line.startswith("Platform identifier="):
            info["platform"] = True
    return info


def path_restricted(path: str) -> bool:
    real = real_file(path)
    if real in {"/bin", "/sbin"} or real in ("/usr/bin", "/usr/sbin"):
        return True
    return any(real.startswith(p) for p in RESTRICTED_PREFIXES) and not real.startswith(
        "/usr/local/"
    )


def is_restricted(path: str, sign: Mapping[str, Any], st: Mapping[str, Any]) -> bool:
    if st.get("setuid") or st.get("setgid"):
        return True
    if sign.get("platform") or sign.get("runtime"):
        return True
    if path_restricted(path):
        return True
    return False


# --- env names from image ---------------------------------------------------


def interesting_env_name(name: str) -> bool:
    if not name or name in BORING_ENV:
        return False
    if name.endswith("_") or name.startswith("__") or name.endswith("__"):
        return False
    if any(
        s in name
        for s in (
            "BINDING",
            "CONTEXT_AWARE",
            "EXTERNAL_REFERENCE",
            "BUILTIN_MODULE",
        )
    ):
        return False
    if name in ALWAYS_ENV or name in DYLD_VARS:
        return True
    if name.startswith("DYLD_"):
        return False
    if name.startswith(NAMED_PREFIXES):
        return True
    return False


def explode_env_token(token: str) -> list[str]:
    token = token.strip("_")
    if not token:
        return []
    starts: list[int] = []
    i = 0
    while i < len(token):
        hit = None
        for p in GLUE_PREFIXES:
            if token.startswith(p, i):
                hit = p
                break
        if hit:
            starts.append(i)
            i += len(hit)
        else:
            i += 1
    if len(starts) <= 1:
        return [token] if interesting_env_name(token) else []
    parts: list[str] = []
    for a, b in zip(starts, starts[1:] + [len(token)]):
        part = token[a:b]
        if interesting_env_name(part):
            parts.append(part)
    return parts


def extract_env_names(path: str, *, limit: int = 80_000_000) -> list[str]:
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            data = f.read(limit if size > limit else size)
    except OSError:
        return []
    found: set[str] = set()
    for m in ENV_TOKEN_RE.finditer(data):
        token = m.group().decode("ascii")
        for part in explode_env_token(token):
            found.add(part)
    return sorted(found)


# --- proxies ----------------------------------------------------------------


def looks_like_rustup(real: str, requested_base: str) -> bool:
    return Path(real).name == "rustup" and requested_base not in {"rustup", "rustup-init"}


def looks_like_xcselect(sign: Mapping[str, Any], dylibs: list[str]) -> bool:
    ident = str(sign.get("identifier") or "")
    if "xcode_select" in ident or "xcselect" in ident:
        return True
    return any("libxcselect" in d for d in dylibs)


def follow_rustup(
    rustup_bin: str, tool: str, *, cwd: str, env: Mapping[str, str]
) -> str | None:
    code, out, err = run([rustup_bin, "which", tool], cwd=cwd, env=env)
    if code != 0:
        return None
    line = out.strip().splitlines()
    if not line:
        return None
    cand = line[-1].strip()
    return cand if cand and Path(cand).exists() else None


def follow_xcrun(tool: str, *, cwd: str, env: Mapping[str, str]) -> str | None:
    code, out, err = run(["xcrun", "--find", tool], cwd=cwd, env=env)
    if code != 0:
        return None
    cand = out.strip().splitlines()
    if not cand:
        return None
    path = cand[-1].strip()
    return path if path and Path(path).exists() else None


def env_interpreter_target(args: list[str]) -> str | None:
    """After #!/usr/bin/env, skip env(1) flags and return the command name."""
    i = 0
    while i < len(args):
        a = args[i]
        if a in {"-S", "--split-string", "-i", "--ignore-environment", "-P", "-v", "-0"}:
            i += 1
            if a in {"-P"} and i < len(args):
                i += 1
            continue
        if a.startswith("-"):
            i += 1
            continue
        return a
    return None


