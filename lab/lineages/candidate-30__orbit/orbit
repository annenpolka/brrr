    scan_dylibs: bool = True
    version: str = VERSION
    entry: str = ""
    entry_restricted: bool = False
    entry_sign: dict[str, Any] = field(default_factory=dict)

    def payload_kind(self) -> str:
        return file_kind(self.payload) if self.payload else self.kind


def lipo_archs(path: str) -> str:
    code, out, _ = run(["lipo", "-archs", path])
    if code == 0 and out.strip():
        return " ".join(out.split())
    return ""


def adjacent_configs(payload: str) -> dict[str, str]:
    found: dict[str, str] = {}
    p = Path(payload)
    venv_root = p.parent.parent if p.parent.name in {"bin", "Scripts"} else None
    if venv_root is not None:
        cfg = venv_root / "pyvenv.cfg"
        if cfg.is_file():
            found[str(cfg)] = "present"
    for extra in (
        p.parent / "python._pth",
        p.parent / (p.name + "._pth"),
        p.parent / "sitecustomize.py",
    ):
        if extra.is_file():
            found[str(extra)] = "present"
    return found


def entry_sip(path: str, shebang: tuple[str, list[str]] | None) -> tuple[str, dict[str, Any], bool]:
    """First Mach-O the kernel will load for this invocation."""
    candidates: list[str] = []
    if shebang:
        interp, _args = shebang
        ip = Path(interp)
        if not ip.is_absolute():
            ip = Path(path).parent / ip
        if ip.exists():
            candidates.append(str(ip))
    candidates.append(path)
    for c in candidates:
        k = file_kind(c)
        if k.startswith("macho"):
            sg = codesign_info(c)
            st = stat_brief(c)
            return c, sg, is_restricted(c, sg, st)
    return path, {}, False


def harvest_env(
    o: Orbit,
    environ: Mapping[str, str],
    *,
    scan_dylibs: bool,
    scan_limit: int,
) -> None:
    targets: list[tuple[str, str]] = [("payload", o.payload)]
    if o.guise and real_file(o.guise) != real_file(o.payload):
        targets.append(("guise", o.guise))
    for hop in o.chain:
        if hop.kind in {"shebang", "rustup", "xcselect"} and hop.path:
            targets.append((hop.kind, hop.path))
    if scan_dylibs:
        for d in o.dylibs:
            if d.status == "ok" and d.resolved and not d.system:
                targets.append(("dylib", d.resolved))
    sources: dict[str, list[str]] = {}
    seen: set[tuple[str, str]] = set()
    for label, path in targets:
        if not path or not Path(path).exists():
            continue
        real = real_file(path)
        key = (label, real)
        if key in seen:
            continue
        seen.add(key)
        src = label if label != "dylib" else "dylib:" + real
        for n in extract_env_names(path, limit=scan_limit):
            bucket = sources.setdefault(n, [])
            if src not in bucket:
                bucket.append(src)
    sip_on = o.restricted or o.entry_restricted
    watch = set(sources)
    for v in DYLD_VARS:
        if v in environ or sip_on:
            watch.add(v)
    for v in ("VIRTUAL_ENV", "RUSTUP_TOOLCHAIN", "DEVELOPER_DIR", "PYTHONPATH", "NODE_PATH"):
        if v in environ or v in sources:
            watch.add(v)
    facts: list[EnvFact] = []
    for name in sorted(watch):
        sip = "n/a"
        if name.startswith("DYLD_"):
            sip = "STRIP" if sip_on else "keep"
        facts.append(
            EnvFact(
                name=name,
                named=name in sources,
                sources=sources.get(name, []),
                value=environ.get(name),
                sip=sip,
            )
        )
    o.env = facts
    o.scan_dylibs = scan_dylibs


def adopt_proxy(
    inner: Orbit,
    *,
    requested: str,
    chosen: str,
    hits: list[str],
    guise: str,
    warnings: list[str],
    chain: list[Hop],
    proxy: str,
    depth: int,
    entry: str,
    entry_sign: dict[str, Any],
    entry_restricted: bool,
    environ: Mapping[str, str],
    scan_dylibs: bool,
    scan_limit: int,
) -> Orbit:
    if depth == 0:
        inner.requested = requested
        inner.chosen = chosen
        inner.path_hits = hits
        inner.real = real_file(chosen)
        inner.guise = guise
        inner.entry = entry
        inner.entry_sign = entry_sign
        inner.entry_restricted = entry_restricted
        inner.restricted = entry_restricted
        inner.configs = {**adjacent_configs(chosen), **inner.configs}
        inner.warnings = warnings + inner.warnings
        inner.proxy = proxy if not inner.proxy else f"{proxy}|{inner.proxy}"
        inner.chain = chain + [h for h in inner.chain if h not in chain]
        harvest_env(inner, environ, scan_dylibs=scan_dylibs, scan_limit=scan_limit)
        return inner
    inner.proxy = proxy if not inner.proxy else f"{proxy}|{inner.proxy}"
    inner.warnings = warnings + inner.warnings
    inner.chain = chain + [h for h in inner.chain if h not in chain]
    return inner


def snapshot(
    requested: str,
    *,
    cwd: str,
    environ: Mapping[str, str],
    scan_dylibs: bool = True,
    scan_limit: int = 80_000_000,
    follow: bool = True,
    depth: int = 0,
    chain: list[Hop] | None = None,
    lookup_path: str | None = None,
) -> Orbit:
    if depth > 10:
        raise OrbitError("proxy/shebang chain too deep")
    exec_path = environ.get("PATH", "")
    name_path = lookup_path if (lookup_path is not None and depth == 0) else exec_path
    path_var = name_path
    if depth == 0:
        chosen = choose_command(requested, name_path)
        hits = (
            path_hits(requested, name_path)
            if "/" not in requested and not requested.startswith(".")
            else [chosen]
        )
    else:
        chosen = requested
        if not Path(chosen).exists():
            raise OrbitError(f"not found: {chosen}", 1)
        hits = [chosen]
    chain = list(chain or [])
    for hop in symlink_chain(chosen):
        item = Hop(hop["path"], hop["kind"], hop.get("target", ""))
        if item not in chain:
            chain.append(item)
    guise = real_file(chosen)
    payload = guise
    proxy = ""
    warnings: list[str] = []
    kind = file_kind(guise)
    sign = codesign_info(guise) if kind.startswith("macho") else {}
    macho = parse_otool_l(guise) if kind.startswith("macho") else {}
    dylib_names: list[str] = list(macho.get("dylibs") or [])
    rpath_raw: list[str] = list(macho.get("rpaths") or [])
    interp = str(macho.get("interp") or "")

    shebang = parse_shebang(guise)
    entry, entry_sign, entry_restricted = entry_sip(guise, shebang)
    if shebang:
        interp_path, sargs = shebang
        chain.append(Hop(guise, "shebang", " ".join([interp_path, *sargs])))
        target: str | None
        base = Path(interp_path).name
        if base == "env":
            cmd_name = env_interpreter_target(sargs)
            if not cmd_name:
                warnings.append("shebang env with no command")
                target = None
            elif "/" in cmd_name:
                target = cmd_name
            else:
                try:
                    target = choose_command(cmd_name, exec_path)
                except OrbitError as exc:
                    warnings.append(str(exc))
                    target = None
        else:
            ip = Path(interp_path)
            if not ip.is_absolute():
                ip = Path(guise).parent / ip
            target = str(ip)
        if follow and target:
            if not Path(target).exists():
                warnings.append(f"missing interpreter: {target}")
            else:
                proxy = "shebang"
                inner = snapshot(
                    target,
                    cwd=cwd,
                    environ=environ,
                    scan_dylibs=scan_dylibs,
                    scan_limit=scan_limit,
                    follow=follow,
                    depth=depth + 1,
                    chain=chain,
                    lookup_path=lookup_path,
                )
                return adopt_proxy(
                    inner,
                    requested=requested,
                    chosen=chosen,
                    hits=hits,
                    guise=guise,
                    warnings=warnings,
                    chain=chain,
                    proxy="shebang",
                    depth=depth,
                    entry=entry,
                    entry_sign=entry_sign,
                    entry_restricted=entry_restricted,
                    environ=environ,
                    scan_dylibs=scan_dylibs,
                    scan_limit=scan_limit,
                )

    if follow and kind.startswith("macho") and looks_like_rustup(guise, Path(requested).name):
        tool = Path(chosen).name
        if tool == "rustup":
            tool = Path(requested).name
        nxt = follow_rustup(guise, tool, cwd=cwd, env=environ)
        if nxt:
            proxy = "rustup"
            chain.append(Hop(guise, "rustup", nxt))
            inner = snapshot(
                nxt,
                cwd=cwd,
                environ=environ,
                scan_dylibs=scan_dylibs,
                scan_limit=scan_limit,
                follow=follow,
                depth=depth + 1,
                chain=chain,
                lookup_path=lookup_path,
            )
            return adopt_proxy(
                inner,
                requested=requested,
                chosen=chosen,
                hits=hits,
                guise=guise,
                warnings=warnings,
                chain=chain,
                proxy="rustup",
                depth=depth,
                entry=entry,
                entry_sign=entry_sign,
                entry_restricted=entry_restricted,
                environ=environ,
                scan_dylibs=scan_dylibs,
                scan_limit=scan_limit,
            )
        warnings.append("rustup proxy but `rustup which` failed")

    if follow and kind.startswith("macho") and looks_like_xcselect(sign, dylib_names):
        tool = Path(requested).name if depth == 0 else Path(chosen).name
        nxt = follow_xcrun(tool, cwd=cwd, env=environ)
        if nxt:
            proxy = "xcselect"
            chain.append(Hop(guise, "xcselect", nxt))
            inner = snapshot(
                nxt,
                cwd=cwd,
                environ=environ,
                scan_dylibs=scan_dylibs,
                scan_limit=scan_limit,
                follow=follow,
                depth=depth + 1,
                chain=chain,
                lookup_path=lookup_path,
            )
            return adopt_proxy(
                inner,
                requested=requested,
                chosen=chosen,
                hits=hits,
                guise=guise,
                warnings=warnings,
                chain=chain,
                proxy="xcselect",
                depth=depth,
                entry=entry,
                entry_sign=entry_sign,
                entry_restricted=entry_restricted,
                environ=environ,
                scan_dylibs=scan_dylibs,
                scan_limit=scan_limit,
            )
        warnings.append("xcselect shim but xcrun --find failed")

    # facts about the payload image (guise, if no further proxy)
    payload = guise
    kind = file_kind(payload)
    sign = codesign_info(payload) if kind.startswith("macho") else sign
    macho = parse_otool_l(payload) if kind.startswith("macho") else macho
    dylib_names = list(macho.get("dylibs") or [])
    rpath_raw = list(macho.get("rpaths") or [])
    interp = str(macho.get("interp") or interp)
    rpaths = [
        {
            "raw": raw,
            "expanded": expand_rpath(
                raw, loader_dir=str(Path(payload).parent), exec_dir=str(Path(payload).parent)
            ),
        }
        for raw in rpath_raw
    ]
    dylibs: list[Dylib] = []
    for name in dylib_names:
        resolved = resolve_dylib(name, loader=payload, rpaths=rpath_raw)
        resolved, status, system = classify_dylib(name, resolved)
        dylibs.append(
            Dylib(name=name, resolved=resolved, status=status, system=system)
        )

    st = stat_brief(payload)
    payload_restricted = (
        is_restricted(payload, sign, st) if kind.startswith("macho") else False
    )
    restricted = entry_restricted if depth == 0 else payload_restricted

    arch = lipo_archs(payload) if kind.startswith("macho") else ""
    configs = adjacent_configs(payload)
    if chosen != payload:
        configs = {**adjacent_configs(chosen), **configs}

    o = Orbit(
        requested=requested,
        chosen=chosen,
        real=real_file(chosen),
        payload=payload,
        guise=real_file(chosen) if depth == 0 else guise,
        proxy=proxy,
        kind=kind,
        arch=arch,
        interp=interp,
        cwd=cwd,
        path_used=path_var,
        path_hits=hits,
        chain=chain,
        dylibs=dylibs,
        rpaths=rpaths,
        env=[],
        sign=sign or {},
        restricted=restricted,
        sha=sha_identity(payload),
        stat=st,
        configs=configs,
        warnings=warnings,
        scan_dylibs=scan_dylibs,
        entry=entry if depth == 0 else payload,
        entry_restricted=entry_restricted if depth == 0 else payload_restricted,
        entry_sign=entry_sign if depth == 0 else (sign or {}),
    )
    if depth == 0:
        harvest_env(o, environ, scan_dylibs=scan_dylibs, scan_limit=scan_limit)
    return o


