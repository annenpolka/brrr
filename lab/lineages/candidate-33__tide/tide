USAGE = """tide — test oracles as a time series

An oracle is the expected value a test claims: a literal in assert_eq! /
expect().toBe / #expect / assertEqual, or a scalar in an *expected*.json /
testcase JSON. tide walks first-parent history and classifies each claim:

  STABLE    one value
  DRIFT     several values, no pattern
  RATCHET   numeric or dotted-version, strictly mono
  FLIPFLOP  a value returned after leaving
  VANISH    the claim disappeared (lhs/key gone)
  BLESS     a value change in a commit that did not touch production

Usage:
  tide [-C repo] [path ...]
  tide --at REF [-C repo] [path ...]
  tide series KEY [-C repo]
  tide --selftest

Options:
  -C DIR         git repository (default .)
  --walk N       first-parent commits (default 250)
  --full         every reachable commit, not first-parent
  --at REF       extract oracles at REF; do not walk
  --all          include STABLE
  --kind K       inline | json | all (default all)
  --json         JSON
  --tsv          TSV
  --check        exit 1 if BLESS or FLIPFLOP
  --json-mode M  naive | roots (default roots; roots = expected-* subtree only)
  --selftest     parser/classifier checks
  -h, --help
"""


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv and ("-h" in sys.argv or "--help" in sys.argv):
        pass
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("-C", dest="repo", default=".")
    p.add_argument("--walk", type=int, default=250)
    p.add_argument("--full", action="store_true")
    p.add_argument("--at", dest="at_ref", default=None)
    p.add_argument("--all", action="store_true")
    p.add_argument("--kind", choices=("inline", "json", "all"), default="all")
    p.add_argument("--json", dest="as_json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--check", action="store_true")
    p.add_argument("--json-mode", choices=("naive", "roots"), default="roots")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("paths", nargs="*")
    # series subcommand
    if argv and argv[0] in {"series", "help"}:
        if argv[0] == "help":
            sys.stdout.write(USAGE)
            return 0
        # series KEY
        rest = argv[1:]
        key = None
        if rest and not rest[0].startswith("-"):
            key = rest[0]
            rest = rest[1:]
        ns = p.parse_args(rest)
        if ns.help:
            sys.stdout.write(USAGE)
            return 0
        repo = os.path.abspath(ns.repo)
        if not git_ok(repo, "rev-parse", "--is-inside-work-tree"):
            print("tide: not a git repository", file=sys.stderr)
            return 2
        series = walk_oracles(repo, ns.walk, ns.full, ns.paths, ns.json_mode)
        if key is None:
            print("tide series KEY", file=sys.stderr)
            return 2
        rec = series.get(key)
        if rec is None:
            # suffix match
            hits = [k for k in series if key in k]
            if len(hits) == 1:
                rec = series[hits[0]]
            elif hits:
                print("tide: ambiguous key, matches:", file=sys.stderr)
                for h in hits[:20]:
                    print(" ", h, file=sys.stderr)
                return 2
            else:
                print("tide: no such oracle", file=sys.stderr)
                return 1
        blob = {**rec, "info": classify(rec["events"])}
        sys.stdout.write(json.dumps(blob, ensure_ascii=False, indent=2) + "\n")
        return 0

    ns = p.parse_args(argv)
    if ns.help or (argv == []):
        # default with no args still runs, help only on -h
        if ns.help:
            sys.stdout.write(USAGE)
            return 0
    if ns.selftest:
        return _selftest()

    repo = os.path.abspath(ns.repo)
    if not git_ok(repo, "rev-parse", "--is-inside-work-tree"):
        print("tide: not a git repository", file=sys.stderr)
        return 2

    if ns.at_ref:
        found = extract_at(repo, ns.at_ref, ns.paths, ns.json_mode)
        if ns.as_json:
            sys.stdout.write(json.dumps(found, ensure_ascii=False, indent=2) + "\n")
        else:
            print(f"tide {VERSION}  at {ns.at_ref}  {repo}  oracles={len(found)}")
            for o in found:
                print(f"{o['kind']:<6} {o['path']}:{o['line']}  {o['test']}  {o['lhs']}  {o['value']}")
        return 0

    series = walk_oracles(repo, ns.walk if ns.walk > 0 else None, ns.full, ns.paths, ns.json_mode)
    if ns.as_json:
        sys.stdout.write(render_json(repo, series, ns.all, ns.kind))
    elif ns.tsv:
        sys.stdout.write(render_tsv(series, ns.all, ns.kind))
    else:
        sys.stdout.write(render_porcelain(repo, series, ns.all, ns.kind))

    if ns.check:
        bad = False
        for rec in series.values():
            info = classify(rec["events"])
            if info["bless"] or info["class"] == "FLIPFLOP":
                bad = True
                break
        return 1 if bad else 0
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except RuntimeError as e:
        print(f"tide: {e}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
