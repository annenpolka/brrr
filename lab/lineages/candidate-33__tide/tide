#!/usr/bin/env python3
"""tide — test oracles as a time series.

An oracle is a claimed expected value: the literal in assert_eq! / expect().toBe
/ #expect / unittest, or a scalar leaf in an *expected* / testcase JSON file.
tide walks git history and reports how those claims moved.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from typing import Any

VERSION = "0.2"

# ---------------------------------------------------------------------------
# git
# ---------------------------------------------------------------------------

def git(repo: str, *args: str, check: bool = True) -> str:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        errors="replace",
    )
    if check and r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"git {' '.join(args)} failed")
    return r.stdout


def git_ok(repo: str, *args: str) -> bool:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        errors="replace",
    )
    return r.returncode == 0


def git_show(repo: str, rev: str, path: str) -> str | None:
    r = subprocess.run(
        ["git", "-C", repo, "show", f"{rev}:{path}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        errors="replace",
    )
    if r.returncode != 0:
        return None
    return r.stdout


# ---------------------------------------------------------------------------
# path roles
# ---------------------------------------------------------------------------

_TEST_DIR = re.compile(
    r"(^|/)(tests?|spec|__tests__|testdata|fixtures|testcases|golden|oracles?)(/|$)",
    re.I,
)
_TEST_FILE = re.compile(
    r"(_test|\.test|\.spec|_spec|Tests?)\.",
)
_TEST_BASENAME = {
    "tests.rs",
    "test.rs",
    "tests.py",
    "test.py",
    "tests.swift",
    "test.swift",
    "tests.go",
    "tests.ts",
    "tests.js",
}
_LOCKISH = re.compile(r"(^|/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|Cargo\.lock|go\.sum)$")
_JSON_STIMULUS = re.compile(r"\.scenario\.json$|scenario-patch\.json$|\.experiment\.json$", re.I)
_EXCLUDE_JSON = {
    "package.json",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig.app.json",
    "compile_commands.json",
    ".eslintrc.json",
    "biome.json",
}


def norm_path(p: str) -> str:
    return p.replace("\\", "/").lstrip("./")


def is_test_path(path: str) -> bool:
    p = norm_path(path)
    b = p.rsplit("/", 1)[-1]
    if b.lower() in _TEST_BASENAME:
        return True
    if _TEST_DIR.search(p):
        return True
    if _TEST_FILE.search(b):
        return True
    return False


def is_json_oracle_path(path: str) -> bool:
    p = norm_path(path)
    if not p.lower().endswith(".json"):
        return False
    b = p.rsplit("/", 1)[-1]
    if b in _EXCLUDE_JSON:
        return False
    if _JSON_STIMULUS.search(p):
        return False
    low = p.lower()
    if any(s in low for s in ("expected", "oracle", "testcase", "testcases")):
        return True
    return False


def is_generated_path(path: str) -> bool:
    p = norm_path(path).lower()
    b = p.rsplit("/", 1)[-1]
    if ".generated." in b or b.endswith(".generated.json") or b.endswith(".generated.ts"):
        return True
    if "/generated/" in f"/{p}/":
        return True
    return False


def is_oracle_file(path: str) -> bool:
    p = norm_path(path)
    if _LOCKISH.search(p):
        return False
    if is_generated_path(p):
        return False
    if is_json_oracle_path(p):
        return True
    if is_test_path(p) and p.rsplit(".", 1)[-1].lower() in {
        "rs", "py", "ts", "tsx", "js", "jsx", "swift", "go", "java", "kt",
    }:
        return True
    return False


def is_prod_path(path: str) -> bool:
    p = norm_path(path)
    if is_oracle_file(p) or is_test_path(p):
        return False
    if p.endswith((".md", ".txt", ".rst", ".html")):
        return False
    if "/docs/" in f"/{p}/" or p.startswith("docs/"):
        return False
    if _LOCKISH.search(p):
        return False
    if p.startswith("."):
        return False
    return True


# ---------------------------------------------------------------------------
# source scan helpers
# ---------------------------------------------------------------------------

def skip_ws(s: str, i: int) -> int:
    n = len(s)
    while i < n and s[i] in " \t\r\n":
        i += 1
    return i


def parse_string(s: str, i: int) -> tuple[str, int] | None:
    n = len(s)
    if i >= n:
        return None
    # rust raw r#"..."# or r"..."
    if s[i] == "r" and i + 1 < n:
        j = i + 1
        hashes = 0
        while j < n and s[j] == "#":
            hashes += 1
            j += 1
        if j < n and s[j] == '"':
            j += 1
            close = '"' + "#" * hashes
            k = s.find(close, j)
            if k < 0:
                return None
            return s[j:k], k + len(close)
    q = s[i]
    if q not in "\"'":
        return None
    j = i + 1
    out = []
    while j < n:
        c = s[j]
        if c == "\\" and j + 1 < n:
            nxt = s[j + 1]
            esc = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", q: q, "0": "\0"}.get(nxt)
            if esc is not None:
                out.append(esc)
            else:
                out.append(nxt)
            j += 2
            continue
        if c == q:
            return "".join(out), j + 1
        out.append(c)
        j += 1
    return None


_NUM = re.compile(r"-?(?:\d+\.\d+|\d+)(?:[eE][+-]?\d+)?")
_IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
_ATOM = {
    "true": True,
    "false": False,
    "True": True,
    "False": False,
    "null": None,
    "None": None,
    "nil": None,
    "undefined": None,
    "Some": "SOME",  # handled as constructor
}


def canon(v: Any) -> str:
    return json.dumps(v, ensure_ascii=False, separators=(",", ":"), sort_keys=True)


def parse_literal_ish(s: str, i: int, depth: int = 0) -> tuple[Any, int, int] | None:
    """Return (value, new_index, complexity) or None.

    complexity: 0 primitive, 1 enum/const, 2 collection, 3 constructor.
    """
    if depth > 7:
        return None
    i = skip_ws(s, i)
    n = len(s)
    if i >= n:
        return None

    if s.startswith("vec!", i):
        j = skip_ws(s, i + 4)
        if j < n and s[j] == "[":
            inner = parse_literal_ish(s, j, depth + 1)
            if inner:
                return inner[0], inner[1], max(2, inner[2])
        return None

    got = parse_string(s, i)
    if got:
        return got[0], got[1], 0

    m = _NUM.match(s, i)
    if m and (m.end() == n or not s[m.end()].isalpha() and s[m.end()] != "_"):
        raw = m.group(0)
        val: Any
        if any(c in raw for c in ".eE"):
            val = float(raw)
        else:
            val = int(raw)
        return val, m.end(), 0

    # collections
    if s[i] == "[":
        items, j = _parse_list(s, i + 1, "]", depth)
        if items is None:
            return None
        return items, j, 2
    if s[i] == "(":
        # rust tuple or grouping
        items, j = _parse_list(s, i + 1, ")", depth)
        if items is None:
            return None
        if len(items) == 1:
            return items[0], j, 2
        return items, j, 2
    if s[i] == "{":
        obj, j = _parse_object(s, i + 1, depth)
        if obj is None:
            return None
        return obj, j, 2

    # ident / enum / constructor
    m = _IDENT.match(s, i)
    if not m:
        return None
    name = m.group(0)
    j = m.end()
    if name in ("true", "false", "True", "False", "null", "None", "nil", "undefined"):
        return _ATOM[name], j, 0

    # Path::Ident or Ident::Ident ...
    parts = [name]
    while True:
        j2 = skip_ws(s, j)
        if s.startswith("::", j2):
            j2 = skip_ws(s, j2 + 2)
            m2 = _IDENT.match(s, j2)
            if not m2:
                break
            parts.append(m2.group(0))
            j = m2.end()
            continue
        break
    j = skip_ws(s, j)
    # turbofish ignored
    if s.startswith("::<", j):
        k = s.find(">", j)
        if k < 0:
            return None
        j = skip_ws(s, k + 1)

    if j < n and s[j] == "(":
        args, j2 = _parse_list(s, j + 1, ")", depth)
        if args is None:
            return None
        label = "::".join(parts)
        return {label: args}, j2, 3
    # Enum/const must be qualified (AgentKind::ClaudeCode). A bare ident is an
    # expression, not an oracle literal.
    if len(parts) >= 2:
        return "::".join(parts), j, 1
    return None


def _parse_list(s: str, i: int, close: str, depth: int) -> tuple[list[Any] | None, int]:
    items: list[Any] = []
    n = len(s)
    i = skip_ws(s, i)
    if i < n and s[i] == close:
        return items, i + 1
    while i < n:
        i = skip_ws(s, i)
        if i < n and s[i] == close:
            return items, i + 1
        got = parse_literal_ish(s, i, depth + 1)
        if not got:
            return None, i
        items.append(got[0])
        i = skip_ws(s, got[1])
        if i < n and s[i] == ",":
            i += 1
            continue
        if i < n and s[i] == close:
            return items, i + 1
        return None, i
    return None, i


def _parse_object(s: str, i: int, depth: int) -> tuple[dict[str, Any] | None, int]:
    obj: dict[str, Any] = {}
    n = len(s)
    i = skip_ws(s, i)
    if i < n and s[i] == "}":
        return obj, i + 1
    while i < n:
        i = skip_ws(s, i)
        if i < n and s[i] == "}":
            return obj, i + 1
        key: str | None = None
        st = parse_string(s, i)
        if st:
            key, i = st
        else:
            m = _IDENT.match(s, i)
            if not m:
                return None, i
            key = m.group(0)
            i = m.end()
        i = skip_ws(s, i)
        if i >= n or s[i] not in ":=":
            return None, i
        i += 1
        got = parse_literal_ish(s, i, depth + 1)
        if not got:
            return None, i
        obj[key] = got[0]
        i = skip_ws(s, got[1])
        if i < n and s[i] == ",":
            i += 1
            continue
        if i < n and s[i] == "}":
            return obj, i + 1
        return None, i
    return None, i


def split_top_args(s: str, i: int, close: str = ")") -> tuple[list[str], int] | None:
    """Split arguments starting at the char AFTER the opening paren/bracket."""
    n = len(s)
    args: list[str] = []
    start = i
    depth = 0
    in_str: str | None = None
    raw_hashes: int | None = None
    while i < n:
        c = s[i]
        if in_str:
            if raw_hashes is not None:
                close_raw = '"' + "#" * raw_hashes
                if s.startswith(close_raw, i):
                    i += len(close_raw)
                    in_str = None
                    raw_hashes = None
                    continue
                i += 1
                continue
            if c == "\\" and i + 1 < n:
                i += 2
                continue
            if c == in_str:
                in_str = None
            i += 1
            continue
        if c == "r" and i + 1 < n and (s[i + 1] == '"' or s[i + 1] == "#"):
            j = i + 1
            h = 0
            while j < n and s[j] == "#":
                h += 1
                j += 1
            if j < n and s[j] == '"':
                in_str = '"'
                raw_hashes = h
                i = j + 1
                continue
        if c in "\"'":
            in_str = c
            i += 1
            continue
        if c in "([{":
            depth += 1
            i += 1
            continue
        if c in ")]}":
            if depth == 0 and c == close:
                args.append(s[start:i].strip())
                return [a for a in args if a != ""], i + 1
            depth -= 1
            i += 1
            continue
        if c == "," and depth == 0:
            args.append(s[start:i].strip())
            i += 1
            start = i
            continue
        i += 1
    return None


def find_matching(s: str, open_i: int) -> int | None:
    close_of = {"(": ")", "[": "]", "{": "}"}
    opener = s[open_i]
    closer = close_of[opener]
    got = split_top_args(s, open_i + 1, closer)
    if not got:
        return None
    # split_top_args returns index after closer; reconstruct end
    # We need the end index; split_top_args already consumed closer.
    # Re-scan to get end: use a simpler depth count.
    n = len(s)
    depth = 0
    i = open_i
    in_str: str | None = None
    raw_hashes: int | None = None
    while i < n:
        c = s[i]
        if in_str:
            if raw_hashes is not None:
                close_raw = '"' + "#" * raw_hashes
                if s.startswith(close_raw, i):
                    i += len(close_raw)
                    in_str = None
                    raw_hashes = None
                    continue
                i += 1
                continue
            if c == "\\" and i + 1 < n:
                i += 2
                continue
            if c == in_str:
                in_str = None
            i += 1
            continue
        if c == "r" and i + 1 < n and (s[i + 1] in '"#'):
            j = i + 1
            h = 0
            while j < n and s[j] == "#":
                h += 1
                j += 1
            if j < n and s[j] == '"':
                in_str = '"'
                raw_hashes = h
                i = j + 1
                continue
        if c in "\"'":
            in_str = c
            i += 1
            continue
        if c in "([{":
            depth += 1
        elif c in ")]}":
            depth -= 1
            if depth == 0:
                return i + 1
        i += 1
    return None


def strip_ws(s: str) -> str:
    return re.sub(r"\s+", " ", s).strip()


def enclosing_test(text: str, pos: int) -> str:
    line_start = text.rfind("\n", 0, pos) + 1
    before = text[:line_start].splitlines()[-80:]
    patterns = [
        re.compile(r"^\s*(?:pub\s+)?(?:async\s+)?fn\s+(\w+)"),
        re.compile(r"^\s*def\s+(\w+)"),
        re.compile(r"^\s*(?:async\s+)?function\s+(\w+)"),
        re.compile(r"^\s*func\s+(\w+)"),
        re.compile(r"^\s*(?:it|test|it\.only|test\.only)\(\s*([\'\"`])(.+?)\1"),
        re.compile(r"^\s*(?:it|test)\.each\b"),
    ]
    for line in reversed(before):
        for pat in patterns:
            m = pat.match(line)
            if m:
                if m.lastindex:
                    return m.group(m.lastindex)
                return "each"
    return ""


def pick_oracle(lhs_src: str, rhs_src: str) -> tuple[str, Any] | None:
    """Choose which side is the expected value. Prefer the more constant side."""
    L = parse_literal_ish(lhs_src, 0)
    R = parse_literal_ish(rhs_src, 0)
    # must consume the argument (allow trailing)
    def ok(src: str, g: tuple[Any, int, int] | None) -> tuple[Any, int] | None:
        if not g:
            return None
        rest = src[g[1] :].strip()
        if rest and rest not in {",", ""}:
            # allow trailing rust type ascription? no
            if rest.startswith("as ") or rest.startswith("!"):
                return g[0], g[2]
            # unmatched extra tokens → not a clean literal
            return None
        return g[0], g[2]

    l = ok(lhs_src, L)
    r = ok(rhs_src, R)
    if r and not l:
        return strip_ws(lhs_src), r[0]
    if l and not r:
        return strip_ws(rhs_src), l[0]
    if l and r:
        # lower complexity is the oracle; tie → rhs (conventional expected slot)
        if r[1] <= l[1]:
            return strip_ws(lhs_src), r[0]
        return strip_ws(rhs_src), l[0]
    return None


def split_eq(expr: str) -> tuple[str, str] | None:
    depth = 0
    in_str: str | None = None
    i = 0
    n = len(expr)
    while i < n:
        c = expr[i]
        if in_str:
            if c == "\\" and i + 1 < n:
                i += 2
                continue
            if c == in_str:
                in_str = None
            i += 1
            continue
        if c in "\"'":
            in_str = c
            i += 1
            continue
        if c in "([{":
            depth += 1
        elif c in ")]}":
            depth -= 1
        elif depth == 0 and expr.startswith("==", i) and not expr.startswith("===", i):
            return expr[:i].strip(), expr[i + 2 :].strip()
        elif depth == 0 and expr.startswith("!=", i):
            return expr[:i].strip(), expr[i + 2 :].strip()
        i += 1
    return None


