Oracle = dict[str, Any]


def _oracle(path: str, test: str, lhs: str, value: Any, line: int, kind: str, matcher: str) -> Oracle:
    lhs_n = strip_ws(lhs) or f"#{line}"
    test_n = test or "_"
    if kind == "json":
        key = f"{path}#{lhs_n}"
    else:
        key = f"{path}::{test_n}::{lhs_n}"
    return {
        "key": key,
        "path": path,
        "test": test_n,
        "lhs": lhs_n,
        "value": canon(value) if not isinstance(value, str) or kind == "json" else json.dumps(value, ensure_ascii=False),
        "raw": value,
        "line": line,
        "kind": kind,
        "matcher": matcher,
    }


def _line_of(text: str, pos: int) -> int:
    return text.count("\n", 0, pos) + 1


_RE_MACRO = re.compile(r"\bassert_(eq|ne)!\s*\(")
_RE_XCT = re.compile(r"\b(?:XCTAssertEqual|assertEqual|assertEquals|assert_equal)\s*\(")
_RE_TESTIFY = re.compile(r"\b(?:assert|require|assert)\.Equal\s*\(")
_RE_EXPECT_HASH = re.compile(r"#expect\s*\(")
_RE_JEST = re.compile(
    r"\bexpect\s*\("
)
_RE_JEST_MATCHER = re.compile(
    r"^\s*\)\s*\.\s*(toBe|toEqual|toStrictEqual|toHaveLength|toBeNull|toBeCloseTo)\s*\("
)
_RE_PY_ASSERT = re.compile(r"^\s*assert\s+", re.M)


def extract_inline(text: str, path: str) -> list[Oracle]:
    found: list[Oracle] = []
    seen_pos: set[int] = set()

    def add_pair(pos: int, a: str, b: str, matcher: str, test: str | None = None) -> None:
        picked = pick_oracle(a, b)
        if not picked:
            return
        lhs, val = picked
        t = test if test is not None else enclosing_test(text, pos)
        found.append(_oracle(path, t, lhs, val, _line_of(text, pos), "inline", matcher))

    for m in _RE_MACRO.finditer(text):
        open_i = m.end() - 1
        end = find_matching(text, open_i)
        if end is None:
            continue
        args = split_top_args(text, open_i + 1, ")")
        if not args or len(args[0]) < 2:
            continue
        add_pair(m.start(), args[0][0], args[0][1], "assert_" + m.group(1))
        seen_pos.add(m.start())

    for m in _RE_XCT.finditer(text):
        if m.start() in seen_pos:
            continue
        open_i = m.end() - 1
        args = split_top_args(text, open_i + 1, ")")
        if not args or len(args[0]) < 2:
            continue
        add_pair(m.start(), args[0][0], args[0][1], "assertEqual")

    for m in _RE_TESTIFY.finditer(text):
        open_i = m.end() - 1
        args = split_top_args(text, open_i + 1, ")")
        if not args or len(args[0]) < 3:
            continue
        # t, expected, actual
        add_pair(m.start(), args[0][2], args[0][1], "testify.Equal")

    for m in _RE_EXPECT_HASH.finditer(text):
        open_i = m.end() - 1
        end = find_matching(text, open_i)
        if end is None:
            continue
        inner = text[open_i + 1 : end - 1]
        sp = split_eq(inner)
        if not sp:
            continue
        add_pair(m.start(), sp[0], sp[1], "#expect")

    for m in _RE_JEST.finditer(text):
        # don't treat expected( as jest
        if m.start() > 0 and text[m.start() - 1 : m.start() + 6] == "expected":
            continue
        open_i = m.end() - 1
        end = find_matching(text, open_i)
        if end is None:
            continue
        inner = text[open_i + 1 : end - 1].strip()
        mm = _RE_JEST_MATCHER.match(text[end - 1 :])
        if not mm:
            continue
        matcher = mm.group(1)
        open2 = end - 1 + mm.end() - 1
        args = split_top_args(text, open2 + 1, ")")
        if not args or not args[0]:
            continue
        rhs = args[0][0]
        add_pair(m.start(), inner, rhs, matcher)

    for m in _RE_PY_ASSERT.finditer(text):
        # rest of line (simple)
        nl = text.find("\n", m.end())
        if nl < 0:
            nl = len(text)
        expr = text[m.end() : nl]
        if "#" in expr:
            expr = expr[: expr.index("#")]
        sp = split_eq(expr)
        if not sp:
            continue
        add_pair(m.start(), sp[0], sp[1], "assert")

    return found


_ORACLE_ROOTS = (
    "expectation",
    "expected",
    "expected_properties",
    "expectedResult",
    "expected_result",
    "oracle",
    "oracles",
)
_ID_KEYS = {"id", "scenarioId", "scenario_id", "uuid", "name", "description"}


def _flatten(obj: Any, prefix: str, out: list[tuple[str, Any]], collapse_arrays: bool) -> None:
    if isinstance(obj, dict):
        for k, v in obj.items():
            if prefix in ("$", "") and k in _ID_KEYS:
                continue
            if prefix in ("$", ""):
                child = f"$.{k}"
            else:
                child = f"{prefix}.{k}"
            _flatten(v, child, out, collapse_arrays)
    elif isinstance(obj, list):
        if collapse_arrays and all(not isinstance(x, (dict, list)) for x in obj):
            out.append((prefix, obj))
            return
        for i, v in enumerate(obj):
            _flatten(v, f"{prefix}[{i}]", out, collapse_arrays)
    else:
        if isinstance(obj, (str, int, float, bool)) or obj is None:
            out.append((prefix, obj))


def extract_json(text: str, path: str, oracle_roots_only: bool = False) -> list[Oracle]:
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return []
    found: list[Oracle] = []

    def emit(obj: Any, test: str) -> None:
        leaves: list[tuple[str, Any]] = []
        _flatten(obj, "$", leaves, collapse_arrays=True)
        for ptr, val in leaves:
            found.append(_oracle(path, test, ptr, val, 1, "json", "json"))

    test_id = ""
    if isinstance(data, dict) and isinstance(data.get("id"), str):
        test_id = data["id"]

    roots_present: list[str] = []
    if isinstance(data, dict):
        roots_present = [k for k in data.keys() if k in _ORACLE_ROOTS or str(k).startswith("expected")]

    # roots mode: if the object has an explicit expected-* subtree, that subtree
    # is the oracle and input/intent/stimulus keys are not. Goldens without those
    # keys still flatten the whole document.
    if oracle_roots_only and roots_present:
        for k in roots_present:
            emit(data[k], test_id or k)
        return found

    emit(data, test_id)
    return found


def extract_file(text: str, path: str, json_mode: str = "naive") -> list[Oracle]:
    p = norm_path(path)
    if len(text) > 2_000_000:
        return []
    if is_json_oracle_path(p):
        return extract_json(text, p, oracle_roots_only=(json_mode == "roots"))
    if is_oracle_file(p):
        return extract_inline(text, p)
    return []


# ---------------------------------------------------------------------------
# history walk
# ---------------------------------------------------------------------------

def parse_history(repo: str, walk: int | None, full: bool) -> list[dict[str, Any]]:
    cmd = [
        "log",
        "--name-status",
        "-M",
        "--pretty=format:COMMIT\t%H\t%ct\t%s",
    ]
    if not full:
        cmd.append("--first-parent")
    if walk:
        cmd.extend(["-n", str(walk)])
    out = git(repo, *cmd)
    commits: list[dict[str, Any]] = []
    cur: dict[str, Any] | None = None
    for line in out.splitlines():
        if line.startswith("COMMIT\t"):
            _, sha, ts, *rest = line.split("\t")
            cur = {
                "sha": sha,
                "ts": int(ts),
                "subject": rest[0] if rest else "",
                "changes": [],  # (status, old, new)
            }
            commits.append(cur)
            continue
        if not line.strip() or cur is None:
            continue
        # name-status: M\tpath / A\tpath / D\tpath / R100\told\tnew
        parts = line.split("\t")
        if not parts or not parts[0]:
            continue
        st = parts[0][0]
        if st == "R" and len(parts) >= 3:
            cur["changes"].append(("R", parts[1], parts[2]))
        elif st in "AMDCT" and len(parts) >= 2:
            cur["changes"].append((st, parts[1], parts[1]))
    return commits


def walk_oracles(
    repo: str,
    walk: int | None,
    full: bool,
    pathspecs: list[str],
    json_mode: str,
) -> dict[str, dict[str, Any]]:
    commits = parse_history(repo, walk, full)
    if not commits:
        return {}
    # oldest first
    commits = list(reversed(commits))
    # Seed the parent of the window so a first `M` still records the preimage.
    oldest = commits[0]
    r = subprocess.run(
        ["git", "-C", repo, "rev-parse", f"{oldest['sha']}^"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if r.returncode == 0:
        psha = r.stdout.strip()
        meta = git(repo, "log", "-1", "--pretty=format:%ct\t%s", psha)
        ts_s, _, subj = meta.partition("\t")
        files = git(repo, "ls-tree", "-r", "--name-only", psha)
        ch = []
        for f in files.splitlines():
            if not f:
                continue
            if is_oracle_file(f) and (not pathspecs or any(
                norm_path(f) == sp or norm_path(f).startswith(sp.rstrip("/") + "/") or norm_path(f).endswith(sp)
                for sp in pathspecs
            )):
                ch.append(("A", f, f))
        commits.insert(0, {"sha": psha, "ts": int(ts_s or "0"), "subject": subj, "changes": ch})
    series: dict[str, dict[str, Any]] = {}
    live: dict[str, str] = {}  # key -> canonical value
    file_keys: dict[str, set[str]] = defaultdict(set)  # path -> keys

    def restrict(path: str) -> bool:
        if not pathspecs:
            return True
        p = norm_path(path)
        return any(p == sp or p.startswith(sp.rstrip("/") + "/") or p.endswith(sp) for sp in pathspecs)

    for c in commits:
        sha, ts, subj = c["sha"], c["ts"], c["subject"]
        prod = any(is_prod_path(ch[2]) or (ch[0] != "R" and is_prod_path(ch[1])) for ch in c["changes"])
        # remaps
        refresh: list[tuple[str, str | None]] = []  # (path_at_commit, old_path or None)
        for st, old, new in c["changes"]:
            if st == "R":
                if old in file_keys:
                    keys = file_keys.pop(old)
                    # rewrite keys that start with old path
                    new_keys = set()
                    for k in keys:
                        rec = series.get(k)
                        if rec is None:
                            continue
                        new_k = k.replace(old, new, 1) if k.startswith(old) else k
                        rec["path"] = new
                        rec["key"] = new_k
                        if new_k != k:
                            series[new_k] = rec
                            del series[k]
                            if k in live:
                                live[new_k] = live.pop(k)
                        new_keys.add(new_k)
                    file_keys[new] = new_keys
                if is_oracle_file(new) and restrict(new):
                    refresh.append((new, old))
            elif st == "D":
                if is_oracle_file(old) and restrict(old):
                    refresh.append((old, old))
            else:
                if (is_oracle_file(new) or is_oracle_file(old)) and restrict(new):
                    refresh.append((new, None))

        for path, _old in refresh:
            text: str | None
            if any(st == "D" and oldp == path for st, oldp, _n in c["changes"]):
                text = None
            else:
                text = git_show(repo, sha, path)
            try:
                new_oracles = extract_file(text or "", path, json_mode=json_mode) if text is not None else []
            except Exception:
                new_oracles = []
            new_map = {o["key"]: o for o in new_oracles}
            prev_keys = set(file_keys.get(path, set()))
            # also keys that still point at this path
            prev_keys |= {k for k, rec in series.items() if rec.get("path") == path and k in live}

            for key, o in new_map.items():
                val = o["value"]
                rec = series.get(key)
                if rec is None:
                    rec = {
                        "key": key,
                        "path": o["path"],
                        "test": o["test"],
                        "lhs": o["lhs"],
                        "kind": o["kind"],
                        "matcher": o["matcher"],
                        "events": [],
                    }
                    series[key] = rec
                    rec["events"].append(_event(sha, ts, subj, val, "BORN", prod))
                    live[key] = val
                elif live.get(key) != val:
                    rec["events"].append(_event(sha, ts, subj, val, "SET", prod))
                    live[key] = val
            died = prev_keys - set(new_map)
            for key in died:
                if key in live:
                    rec = series.get(key)
                    if rec:
                        rec["events"].append(_event(sha, ts, subj, live[key], "DIED", prod))
                    live.pop(key, None)
            file_keys[path] = set(new_map)
            if not new_map:
                file_keys.pop(path, None)

    return series


def _event(sha: str, ts: int, subj: str, val: str, kind: str, prod: bool) -> dict[str, Any]:
    return {
        "commit": sha,
        "ts": ts,
        "date": dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%d"),
        "subject": subj,
        "value": val,
        "event": kind,
        "prod": "COUPLED" if prod else "BLESS",
    }


def _as_number(v: str) -> float | None:
    try:
        x = json.loads(v)
    except Exception:
        return None
    if isinstance(x, bool) or x is None:
        return None
    if isinstance(x, (int, float)):
        return float(x)
    return None


_VER = re.compile(r"^\d+(?:\.\d+)+$")


def _as_version(v: str) -> tuple[int, ...] | None:
    try:
        x = json.loads(v)
    except Exception:
        return None
    if not isinstance(x, str) or not _VER.fullmatch(x):
        return None
    return tuple(int(p) for p in x.split("."))


def classify(events: list[dict[str, Any]]) -> dict[str, Any]:
    sets = [e for e in events if e["event"] in ("BORN", "SET")]
    values = [e["value"] for e in sets]
    # collapse consecutive duplicates (shouldn't happen)
    uniq: list[str] = []
    for v in values:
        if not uniq or uniq[-1] != v:
            uniq.append(v)
    died = any(e["event"] == "DIED" for e in events)
    bless_set = any(e["event"] == "SET" and e["prod"] == "BLESS" for e in events)
    coupled_set = any(e["event"] == "SET" and e["prod"] == "COUPLED" for e in events)

    klass = "STABLE"
    if len(uniq) >= 2:
        nums = [_as_number(v) for v in uniq]
        vers = [_as_version(v) for v in uniq]
        seq: list[Any] | None = None
        if all(n is not None for n in nums):
            seq = [n for n in nums if n is not None]
        elif all(v is not None for v in vers):
            seq = [v for v in vers if v is not None]
        if seq is not None:
            inc = all(a < b for a, b in zip(seq, seq[1:]))
            dec = all(a > b for a, b in zip(seq, seq[1:]))
            if inc or dec:
                klass = "RATCHET"
            elif len(set(uniq)) < len(uniq):
                klass = "FLIPFLOP"
            else:
                klass = "DRIFT"
        elif len(set(uniq)) < len(uniq):
            klass = "FLIPFLOP"
        else:
            klass = "DRIFT"
        if klass != "RATCHET" and len(set(uniq)) < len(uniq):
            klass = "FLIPFLOP"

    if died and klass == "STABLE":
        klass = "VANISH"

    tags = [klass]
    if bless_set:
        tags.append("BLESS")
    if coupled_set:
        tags.append("COUPLED")
    if died:
        tags.append("DIED")
    if len(sets) == 1 and sets[0]["event"] == "BORN":
        tags.append("BORN")
    changed = klass != "STABLE"
    return {
        "class": klass,
        "tags": tags,
        "values": uniq,
        "changed": changed,
        "bless": bless_set,
        "n_events": len(sets),
    }


# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------

CLASS_ORDER = {"FLIPFLOP": 0, "RATCHET": 1, "DRIFT": 2, "VANISH": 3, "STABLE": 4}


def interesting(info: dict[str, Any], show_all: bool) -> bool:
    if show_all:
        return True
    # A vanished claim is a change in the suite's vows even if the last
    # value never mutated (tenaoshi dropping max_diff_ratio).
    return info["changed"] or info["bless"] or "DIED" in info["tags"]


def render_porcelain(repo: str, series: dict[str, dict[str, Any]], show_all: bool, kind: str) -> str:
    rows = []
    for rec in series.values():
        if kind != "all" and rec["kind"] != kind:
            continue
        info = classify(rec["events"])
        rec = {**rec, "info": info}
        if interesting(info, show_all):
            rows.append(rec)
    rows.sort(key=lambda r: (CLASS_ORDER.get(r["info"]["class"], 9), -r["info"]["n_events"], r["key"]))

    n_all = sum(1 for rec in series.values() if kind == "all" or rec["kind"] == kind)
    n_ch = sum(
        1
        for rec in series.values()
        if (kind == "all" or rec["kind"] == kind) and classify(rec["events"])["changed"]
    )
    n_bless = sum(
        1
        for rec in series.values()
        if (kind == "all" or rec["kind"] == kind) and classify(rec["events"])["bless"]
    )
    n_flip = sum(
        1
        for rec in series.values()
        if (kind == "all" or rec["kind"] == kind) and classify(rec["events"])["class"] == "FLIPFLOP"
    )
    n_ratchet = sum(
        1
        for rec in series.values()
        if (kind == "all" or rec["kind"] == kind) and classify(rec["events"])["class"] == "RATCHET"
    )

    lines = [
        f"tide {VERSION}  {repo}",
        f"oracles={n_all}  changed={n_ch}  bless={n_bless}  flipflop={n_flip}  ratchet={n_ratchet}  shown={len(rows)}",
        "",
    ]
    for rec in rows:
        info = rec["info"]
        tag = ",".join(t for t in info["tags"] if t in {info["class"], "BLESS", "DIED"})
        arrow = " → ".join(info["values"])
        head = f"{tag:<16} {rec['kind']:<6} {rec['path']}"
        lines.append(head)
        extra = f"  {rec['test']}  {rec['lhs']}"
        lines.append(extra)
        if arrow:
            lines.append(f"  {arrow}")
        for e in rec["events"]:
            if e["event"] == "DIED":
                lines.append(
                    f"  {e['commit'][:8]}  {e['date']}  {e['prod']:<8}  {e['event']}  {e['value']}"
                )
            elif e["event"] in ("BORN", "SET"):
                mark = e["prod"] if e["event"] == "SET" else "BORN"
                lines.append(
                    f"  {e['commit'][:8]}  {e['date']}  {mark:<8}  {e['value']}"
                )
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def render_json(repo: str, series: dict[str, dict[str, Any]], show_all: bool, kind: str) -> str:
    oracles = []
    for rec in series.values():
        if kind != "all" and rec["kind"] != kind:
            continue
        info = classify(rec["events"])
        if not interesting(info, show_all):
            continue
        oracles.append(
            {
                "key": rec["key"],
                "path": rec["path"],
                "test": rec["test"],
                "lhs": rec["lhs"],
                "kind": rec["kind"],
                "matcher": rec["matcher"],
                "class": info["class"],
                "tags": info["tags"],
                "values": info["values"],
                "bless": info["bless"],
                "events": rec["events"],
            }
        )
    oracles.sort(key=lambda o: (CLASS_ORDER.get(o["class"], 9), o["key"]))
    return json.dumps({"repo": repo, "version": VERSION, "oracles": oracles}, ensure_ascii=False, indent=2) + "\n"


def render_tsv(series: dict[str, dict[str, Any]], show_all: bool, kind: str) -> str:
    lines = ["class\ttags\tkind\tpath\ttest\tlhs\tvalues\tbless"]
    for rec in series.values():
        if kind != "all" and rec["kind"] != kind:
            continue
        info = classify(rec["events"])
        if not interesting(info, show_all):
            continue
        lines.append(
            "\t".join(
                [
                    info["class"],
                    ",".join(info["tags"]),
                    rec["kind"],
                    rec["path"],
                    rec["test"],
                    rec["lhs"],
                    " → ".join(info["values"]),
                    "1" if info["bless"] else "0",
                ]
            )
        )
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# extract-at
# ---------------------------------------------------------------------------

def extract_at(repo: str, rev: str, pathspecs: list[str], json_mode: str) -> list[Oracle]:
    out = git(repo, "ls-tree", "-r", "--name-only", rev)
    found: list[Oracle] = []
    for path in out.splitlines():
        if not path or not is_oracle_file(path):
            continue
        if pathspecs:
            p = norm_path(path)
            if not any(p == sp or p.startswith(sp.rstrip("/") + "/") or p.endswith(sp) for sp in pathspecs):
                continue
        text = git_show(repo, rev, path)
        if text is None:
            continue
        found.extend(extract_file(text, path, json_mode=json_mode))
    return found


