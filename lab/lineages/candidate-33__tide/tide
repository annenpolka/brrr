def _selftest() -> int:
    fails = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal fails
        if cond:
            print(f"  ok  {name}")
        else:
            print(f"  FAIL {name}  {detail}", file=sys.stderr)
            fails += 1

    rust = '''
#[test]
fn scan_scars_detects_real_scar_outside_fence_in_markdown() {
    assert_eq!(hits.len(), 1, "only the scar");
    assert_eq!(hits[0].message, "real scar outside fence -->");
    assert_eq!(
        input.file_paths,
        vec![PathBuf::from("/tmp/foo.rs")],
    );
}
'''
    rs = extract_inline(rust, "src/hook/tests.rs")
    keys = {o["lhs"]: o["raw"] for o in rs}
    check("rust message literal", keys.get("hits[0].message") == "real scar outside fence -->", str(keys))
    check("rust len literal", keys.get("hits.len()") == 1, str(keys))
    check(
        "rust vec path",
        "input.file_paths" in keys
        and isinstance(keys["input.file_paths"], list),
        str(keys.get("input.file_paths")),
    )

    swift = '''
    @Test("formatTime: 秒のみ")
    func formatTimeSecondsOnly() {
        #expect(formatTime(45) == "0:45")
        #expect(engine.driftSoundName == nil)
    }
'''
    sw = extract_inline(swift, "Tests/UILogicTests.swift")
    raws = {o["lhs"]: o["raw"] for o in sw}
    check("swift string oracle", raws.get("formatTime(45)") == "0:45", str(raws))
    check("swift nil oracle", "engine.driftSoundName" in raws and raws["engine.driftSoundName"] is None, str(raws))

    js = '''
describe("k", () => {
  it("version", () => {
    expect(outcome.result.fingerprint.engineVersion).toBe("0.21.0");
    expect(outcome.trace.decisions.map((decision) => decision.sequence)).toEqual([0, 1, 2, 3, 4]);
    expect(outcome.ok).toBe(true);
    expect(first).toEqual(second);
  });
});
'''
    je = extract_inline(js, "packages/kernel/src/evaluate.test.ts")
    jmap = {o["lhs"]: o["raw"] for o in je}
    check("jest toBe version", jmap.get("outcome.result.fingerprint.engineVersion") == "0.21.0", str(jmap))
    check("jest toEqual array", jmap.get("outcome.trace.decisions.map((decision) => decision.sequence)") == [0, 1, 2, 3, 4], str(list(jmap)))
    check("jest skip ident ident", "first" not in jmap, str(jmap))
    check("jest true", jmap.get("outcome.ok") is True, str(jmap))

    py = '''
class T:
    def test_sum(self):
        self.assertEqual(adder.add(2, 3), 5)
        assert app.TIMEOUT == 30
'''
    pe = extract_inline(py, "tests/test_app.py")
    pmap = {o["lhs"]: o["raw"] for o in pe}
    check("py assertEqual", pmap.get("adder.add(2, 3)") == 5, str(pmap))
    check("py assert ==", pmap.get("app.TIMEOUT") == 30, str(pmap))

    tc = json.dumps({
        "id": "CTR-008",
        "intent": "短くして",
        "input": "hello",
        "expected_properties": {
            "unchanged": False,
            "contains": ["2026年7月", "3件"],
            "max_length_ratio": 0.95,
        },
    }, ensure_ascii=False)
    naive = extract_json(tc, "contracts/testcases/CTR-008.json", oracle_roots_only=False)
    roots = extract_json(tc, "contracts/testcases/CTR-008.json", oracle_roots_only=True)
    naive_lhs = {o["lhs"] for o in naive}
    roots_lhs = {o["lhs"] for o in roots}
    check("json naive sees input", any("input" in x or x.endswith("input") for x in naive_lhs), str(naive_lhs))
    check("json roots hides input", not any(x.endswith(".input") or x == "$.input" for x in roots_lhs), str(roots_lhs))
    check(
        "json roots has ratio",
        any("max_length_ratio" in x for x in roots_lhs),
        str(roots_lhs),
    )
    check(
        "json array collapsed",
        any(o["lhs"].endswith("contains") and o["raw"] == ["2026年7月", "3件"] for o in roots),
        str([(o["lhs"], o["raw"]) for o in roots]),
    )

    def ev(vals: list[str], kinds: list[str], prods: list[str]) -> list[dict[str, Any]]:
        out = []
        for i, (v, k, p) in enumerate(zip(vals, kinds, prods)):
            out.append({"event": k, "value": v, "prod": p, "commit": str(i), "ts": i, "date": "2026-01-01", "subject": ""})
        return out

    c1 = classify(ev(["1", "2", "4"], ["BORN", "SET", "SET"], ["COUPLED"] * 3))
    check("ratchet", c1["class"] == "RATCHET", str(c1))
    c2 = classify(ev(["3", "5", "3"], ["BORN", "SET", "SET"], ["COUPLED", "BLESS", "COUPLED"]))
    check("flipflop", c2["class"] == "FLIPFLOP" and c2["bless"], str(c2))
    c3 = classify(ev(['"a"', '"b"'], ["BORN", "SET"], ["COUPLED", "COUPLED"]))
    check("drift", c3["class"] == "DRIFT", str(c3))
    c4 = classify(ev(['"x"'], ["BORN"], ["BLESS"]))
    check("stable born", c4["class"] == "STABLE" and not c4["changed"], str(c4))
    c5 = classify(ev(['"0.19.0"', '"0.20.0"', '"0.22.0"'], ["BORN", "SET", "SET"], ["COUPLED"] * 3))
    check("version ratchet", c5["class"] == "RATCHET", str(c5))
    c6 = classify(ev(['"x"', '"x"'], ["BORN", "DIED"], ["COUPLED", "COUPLED"]))
    check("vanish", c6["class"] == "VANISH" and "DIED" in c6["tags"], str(c6))
    check(
        "generated json is not an oracle file",
        not is_oracle_file("packages/spec-artifacts/src/conformance/engine.generated.json"),
    )

    check("test path rust", is_test_path("src/hook/tests.rs"))
    check("test path jest", is_test_path("packages/kernel/src/evaluate.test.ts"))
    check("test path swift", is_test_path("Tests/SitboneUITests/UILogicTests.swift"))
    check("json expected", is_json_oracle_path("data/fixtures/golden/x.expected.json"))
    check("json scenario skipped", not is_json_oracle_path("data/fixtures/golden/x.scenario.json"))
    check("prod src", is_prod_path("packages/kernel/src/evaluate.ts"))
    check("not prod test", not is_prod_path("packages/kernel/src/evaluate.test.ts"))
    each_src = "it.each([1,2])('n', (n) => {\n  expect(n).toBe(1);\n});\n"
    each_os = extract_inline(each_src, "x.test.ts")
    check("it.each does not crash", any(o["raw"] == 1 for o in each_os), str(each_os))

    print("selftest fails:", fails)
    return 1 if fails else 0


