HELP = """\
sate — occupancy of a patch in a tree

A patch is a set of before→after claims, not a boolean. git apply --check
says "does not apply". sate says APPLIED / PENDING / MIXED / DUPLEX /
SUPERSEDED per hunk.

Usage:
  sate PATCH                 classify PATCH against the worktree
  sate -                     classify a diff on stdin
  sate --git REV             classify `git show REV` (or A..B as diff)
  sate --log [N]             last N non-merge patches vs --against (HEAD)
  sate --log N --first-parent   GitHub merge-mainline walk
  sate --suggest FILE        review suggestions (JSON/JSONL) as 1-hunk patches
  sate --selftest

Tree:
  -C DIR           repository / tree root (default: cwd)
  --against REF    read files from git REF instead of the worktree
                   (--log defaults to HEAD)

Matching:
  --ignore-space   collapse horizontal whitespace
  --fuzz           accept windows with ≥0.85 line overlap (opt-in)
  --no-fuzz        exact/core/subseq only (default)

Output:
  --json / --tsv / --quiet
  --report-only    always exit 0
  --only FATE      hide other fates

Exit:
  0  unanimous APPLIED (or empty)
  1  unanimous PENDING
  2  SPLIT / MIXED / DUPLEX / SUPERSEDED
  3  error
"""


def emit(verdicts: list[Verdict], args: argparse.Namespace, extra: dict) -> int:
    if args.only:
        want = set(args.only.split(","))
        verdicts = [v for v in verdicts if v.fate in want or v.fate in SKIP_FATES]
    title = extra.get("title") or extra.get("patch") or extra.get("git") or "."
    if args.json:
        sys.stdout.write(
            format_json(verdicts, {k: v for k, v in extra.items() if k != "title"})
        )
    elif args.tsv:
        sys.stdout.write(format_tsv(verdicts))
    else:
        if not args.quiet:
            sys.stdout.write(format_human(verdicts, str(title)))
        else:
            uni = unanimous(verdicts)
            c = counted(verdicts)
            bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
            sys.stdout.write(f"{uni}\t{bits}\n")
    code = exit_for(unanimous(verdicts))
    if args.report_only:
        return 0
    return code


def cmd_patch_text(
    text: str, args: argparse.Namespace, extra: dict
) -> int:
    root = Path(args.C).resolve()
    files = parse_patch(text)
    if not files:
        print("sate: no hunks in patch", file=sys.stderr)
        return 0 if args.report_only else EXIT_APPLIED
    norm = space_norm if args.ignore_space else ident
    verdicts = classify_parsed(files, root, args.against, norm, fuzz=args.fuzz)
    extra.setdefault("tree", str(root))
    extra.setdefault("against", args.against)
    return emit(verdicts, args, extra)


def cmd_log(args: argparse.Namespace) -> int:
    root = Path(args.C).resolve()
    n = args.log if isinstance(args.log, int) and args.log > 0 else 15
    against = args.against if args.against is not None else "HEAD"
    revs = log_revs(
        root, n, include_merges=False, first_parent=args.first_parent
    )
    norm = space_norm if args.ignore_space else ident
    rows = []
    all_verdicts: list[Verdict] = []
    for h, ts, subj in revs:
        try:
            text = patch_of_rev(root, h)
        except RuntimeError as e:
            print(f"sate: skip {h[:8]}: {e}", file=sys.stderr)
            continue
        files = parse_patch(text)
        if not files:
            rows.append(
                {
                    "commit": h,
                    "subject": subj,
                    "unanimous": "EMPTY",
                    "counts": {},
                    "hunks": 0,
                }
            )
            continue
        # log classifies each historical patch against `against`
        saved = args.against
        args.against = against
        verdicts = classify_parsed(files, root, against, norm, fuzz=args.fuzz)
        args.against = saved
        all_verdicts.extend(verdicts)
        rows.append(
            {
                "commit": h,
                "subject": subj,
                "timestamp": ts,
                "unanimous": unanimous(verdicts),
                "counts": counted(verdicts),
                "hunks": len(material(verdicts)),
                "detail": [v.as_dict() for v in verdicts if v.fate != "SKIP"]
                if args.verbose
                else None,
            }
        )
    if args.json:
        sys.stdout.write(
            json.dumps(
                {"tree": str(root), "against": against, "n": n, "commits": rows},
                ensure_ascii=False,
                indent=2,
            )
            + "\n"
        )
    elif args.tsv:
        sys.stdout.write("unanimous\thunks\tcommit\tsubject\n")
        for r in rows:
            sys.stdout.write(
                f"{r['unanimous']}\t{r['hunks']}\t{r['commit'][:12]}\t{r['subject']}\n"
            )
    else:
        print(f"sate log  n={len(rows)}  against={against}  tree={root}")
        for r in rows:
            short = r["commit"][:8]
            c = r["counts"]
            bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
            print(f"{r['unanimous']:<11} {r['hunks']:>3}h  {short}  {r['subject']}")
            if bits and r["unanimous"] == "SPLIT":
                print(f"            {bits}")
            if args.verbose and r.get("detail"):
                for d in r["detail"]:
                    if d["fate"] in SKIP_FATES:
                        continue
                    print(f"            {d['fate']:<11} {d['path']}  #{d['hunk']}  {d['method']}")
    if args.report_only:
        return 0
    # log is a report; fail only if every commit split/superseded? too noisy.
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="sate",
        description="Occupancy of a patch in a tree",
        add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="See README.md. Exit 0 APPLIED, 1 PENDING, 2 SPLIT.",
    )
    p.add_argument("patch", nargs="?", help="unified diff file, or - for stdin")
    p.add_argument("-C", default=".", metavar="DIR", help="tree root")
    p.add_argument("--against", default=None, metavar="REF", help="git ref to read")
    p.add_argument("--git", metavar="REV", help="classify git show REV / git diff A..B")
    p.add_argument(
        "--log",
        nargs="?",
        const=15,
        type=int,
        metavar="N",
        help="last N non-merge commits vs --against (default HEAD)",
    )
    p.add_argument(
        "--first-parent",
        action="store_true",
        help="with --log, walk first-parent only (GitHub merge style)",
    )
    p.add_argument("--suggest", metavar="FILE", help="JSON/JSONL review suggestions")
    p.add_argument("--ignore-space", action="store_true")
    p.add_argument("--fuzz", dest="fuzz", action="store_true", default=False)
    p.add_argument("--no-fuzz", dest="fuzz", action="store_false")
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--verbose", "-v", action="store_true")
    p.add_argument("--report-only", action="store_true")
    p.add_argument("--only", metavar="FATE[,FATE]")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(HELP)
        return 0
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"sate {VERSION}")
        return 0
    if args.selftest:
        return selftest(fuzz=args.fuzz)

    try:
        if args.log is not None:
            return cmd_log(args)
        if args.suggest:
            text = Path(args.suggest).read_text(encoding="utf-8")
            fps = load_suggestions(text)
            root = Path(args.C).resolve()
            norm = space_norm if args.ignore_space else ident
            verdicts = classify_parsed(fps, root, args.against, norm, fuzz=args.fuzz)
            return emit(
                verdicts,
                args,
                {
                    "title": args.suggest,
                    "patch": args.suggest,
                    "kind": "suggest",
                    "tree": str(root),
                    "against": args.against,
                },
            )
        if args.git:
            root = Path(args.C).resolve()
            text = patch_of_rev(root, args.git)
            return cmd_patch_text(text, args, {"title": f"git:{args.git}", "git": args.git})
        if args.patch == "-" or (args.patch is None and not sys.stdin.isatty()):
            text = sys.stdin.read()
            return cmd_patch_text(text, args, {"title": "stdin", "patch": "-"})
        if args.patch:
            text = Path(args.patch).read_text(encoding="utf-8")
            return cmd_patch_text(text, args, {"title": args.patch, "patch": args.patch})
        sys.stdout.write(HELP)
        return EXIT_ERROR
    except BrokenPipeError:
        return 0
    except RuntimeError as e:
        print(f"sate: {e}", file=sys.stderr)
        return EXIT_ERROR
    except OSError as e:
        print(f"sate: {e}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
