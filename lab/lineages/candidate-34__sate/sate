# suggestions as patches
# ---------------------------------------------------------------------------

def suggestion_to_filepatch(obj: dict) -> FilePatch:
    path = obj.get("path") or obj.get("filename") or ""
    before = obj.get("before")
    after = obj.get("after")
    if isinstance(before, str):
        before = before.splitlines()
    if isinstance(after, str):
        after = after.splitlines()
    body = obj.get("body") or obj.get("comment") or ""
    if after is None and body:
        m = SUGGEST_RE.search(body)
        if m:
            after = m.group(1).rstrip("\n").splitlines()
    diff_hunk = obj.get("diff_hunk") or obj.get("diffHunk") or ""
    if before is None and diff_hunk:
        # comment on the new side: '+' lines are what the suggestion replaces
        plus = [ln[1:] for ln in diff_hunk.splitlines() if ln.startswith("+") and not ln.startswith("+++")]
        minus = [ln[1:] for ln in diff_hunk.splitlines() if ln.startswith("-") and not ln.startswith("---")]
        side = (obj.get("side") or "RIGHT").upper()
        before = plus if side in ("RIGHT", "NEW", "+") and plus else minus
    if before is None:
        before = []
    if after is None:
        after = []
    hunk = Hunk(old_start=int(obj.get("line") or obj.get("original_line") or 1),
                old_count=len(before) or 1,
                new_start=int(obj.get("line") or 1),
                new_count=len(after) or 1,
                header=f"@@ suggestion {obj.get('id') or obj.get('html_url') or path} @@")
    # fabricate tagged lines without shared context
    for L in before:
        hunk.tagged.append(("-", L))
    for L in after:
        hunk.tagged.append(("+", L))
    return FilePatch(old_path=path, new_path=path, kind="modify", hunks=[hunk])


def load_suggestions(text: str) -> list[FilePatch]:
    text = text.strip()
    objs: list[dict]
    if text.startswith("["):
        data = json.loads(text)
        if isinstance(data, dict) and "comments" in data:
            data = data["comments"]
        objs = list(data)
    else:
        objs = []
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            objs.append(json.loads(line))
    return [suggestion_to_filepatch(o) for o in objs if o.get("path") or o.get("filename")]


# ---------------------------------------------------------------------------
# reports
# ---------------------------------------------------------------------------

def counted(verdicts: list[Verdict]) -> dict[str, int]:
    c: dict[str, int] = {}
    for v in verdicts:
        c[v.fate] = c.get(v.fate, 0) + 1
    return c


def material(verdicts: list[Verdict]) -> list[Verdict]:
    return [v for v in verdicts if v.fate not in SKIP_FATES]


def unanimous(verdicts: list[Verdict]) -> str:
    s = {v.fate for v in material(verdicts)}
    if not s:
        return "EMPTY"
    if len(s) == 1:
        return next(iter(s))
    return "SPLIT"


def exit_for(uni: str) -> int:
    if uni in ("APPLIED", "EMPTY"):
        return EXIT_APPLIED
    if uni == "PENDING":
        return EXIT_PENDING
    return EXIT_SPLIT


def format_human(verdicts: list[Verdict], title: str) -> str:
    uni = unanimous(verdicts)
    c = counted(verdicts)
    bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
    lines = [f"sate  {title}  unanimous={uni}  {bits}"]
    for v in verdicts:
        if v.fate == "SKIP":
            continue
        loc = f"{v.path}" if v.hunk == 0 else f"{v.path}  #{v.hunk}"
        extra = f"  {v.method}"
        if v.fate in ("SUPERSEDED", "MIXED") and (v.near_before or v.near_after):
            extra += f"  near={v.near_line} before={v.near_before:.2f} after={v.near_after:.2f}"
        if v.note:
            extra += f"  {v.note}"
        hdr = f"  {v.header}" if v.header and not v.header.startswith("(suggestion") else ""
        lines.append(f"{v.fate:<11} {loc}{extra}{hdr}")
    return "\n".join(lines) + "\n"


def format_tsv(verdicts: list[Verdict]) -> str:
    rows = ["fate\tpath\thunk\tkind\tmethod\tnear_line\tnear_before\tnear_after\theader"]
    for v in verdicts:
        if v.fate == "SKIP":
            continue
        rows.append(
            "\t".join(
                [
                    v.fate,
                    v.path,
                    str(v.hunk),
                    v.kind,
                    v.method,
                    "" if v.near_line is None else str(v.near_line),
                    f"{v.near_before:.3f}",
                    f"{v.near_after:.3f}",
                    v.header.replace("\t", " "),
                ]
            )
        )
    return "\n".join(rows) + "\n"


def format_json(verdicts: list[Verdict], extra: dict) -> str:
    payload = {
        **extra,
        "unanimous": unanimous(verdicts),
        "counts": counted(verdicts),
        "hunks": [v.as_dict() for v in verdicts if v.fate != "SKIP"],
    }
    return json.dumps(payload, ensure_ascii=False, indent=2) + "\n"


# ---------------------------------------------------------------------------
# git helpers for --git / --log
# ---------------------------------------------------------------------------

def patch_of_rev(root: Path, rev: str) -> str:
    if ".." in rev:
        proc = git(["diff", "--find-renames", "--patch", rev], root)
    else:
        proc = git(["show", "--format=", "--patch", "--find-renames", rev], root)
    if proc.returncode != 0:
        err = proc.stderr.decode("utf-8", "replace").strip()
        raise RuntimeError(err or f"git show/diff failed for {rev}")
    return proc.stdout.decode("utf-8", "replace")


def log_revs(
    root: Path,
    n: int,
    include_merges: bool = False,
    first_parent: bool = False,
) -> list[tuple[str, int, str]]:
    fmt = "%H\t%ct\t%s"
    args = ["log", f"-n{n}", f"--pretty=format:{fmt}"]
    if first_parent:
        args.append("--first-parent")
    if not include_merges:
        args.append("--no-merges")
    proc = git(args, root)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.decode("utf-8", "replace"))
    out = []
    for line in proc.stdout.decode("utf-8", "replace").splitlines():
        if not line.strip():
            continue
        h, ts, subj = line.split("\t", 2)
        out.append((h, int(ts), subj))
    return out


# ---------------------------------------------------------------------------
# selftest
# ---------------------------------------------------------------------------

def _write_tree(root: Path, files: dict[str, str]) -> None:
    for rel, content in files.items():
        p = root / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content, encoding="utf-8")


def _patch(old: str, new: str, path: str) -> str:
    """Tiny unified diff from two file texts (path in both)."""
    import difflib

    a = old.splitlines(keepends=True)
    b = new.splitlines(keepends=True)
    if a and not a[-1].endswith("\n"):
        a[-1] += "\n"
    if b and not b[-1].endswith("\n"):
        b[-1] += "\n"
    lines = list(
        difflib.unified_diff(a, b, fromfile=f"a/{path}", tofile=f"b/{path}", n=3)
    )
    return "".join(lines)


def _assert_fate(verdicts: list[Verdict], want: str, label: str) -> None:
    mat = material(verdicts)
    got = unanimous(mat)
    if got != want:
        detail = ", ".join(f"{v.fate}:{v.method}" for v in mat) or "EMPTY"
        raise AssertionError(f"{label}: unanimous={got} want={want} ({detail})")


def selftest(fuzz: bool = True) -> int:
    failed = 0
    passed = 0

    def t(name: str, fn: Callable[[], None]) -> None:
        nonlocal failed, passed
        try:
            fn()
            passed += 1
            print(f"  ok  {name}")
        except Exception as e:
            failed += 1
            print(f"  FAIL {name}: {e}", file=sys.stderr)

    def run_mem(tree: dict[str, str], patch: str) -> list[Verdict]:
        with tempfile.TemporaryDirectory(prefix="sate-st-") as td:
            root = Path(td)
            _write_tree(root, tree)
            files = parse_patch(patch)
            if not files:
                raise AssertionError("parser produced no files")
            return classify_parsed(files, root, None, ident, fuzz=fuzz)

    # 1 exact PENDING / APPLIED
    old = "def add(a, b):\n    return a - b\n"
    new = "def add(a, b):\n    return a + b\n"
    p = _patch(old, new, "add.py")

    t("pending-exact", lambda: _assert_fate(run_mem({"add.py": old}, p), "PENDING", "pending"))
    t("applied-exact", lambda: _assert_fate(run_mem({"add.py": new}, p), "APPLIED", "applied"))

    def superseded():
        v = run_mem({"add.py": "def add(a, b):\n    return a + b + 1\n"}, p)
        _assert_fate(v, "SUPERSEDED", "superseded")

    t("superseded-neither", superseded)

    # mixed: one of two substitutions taken
    old_m = "def f():\n    a = 1\n    b = 2\n    return a + b\n"
    new_m = "def f():\n    a = 10\n    b = 20\n    return a + b\n"
    mid_m = "def f():\n    a = 10\n    b = 2\n    return a + b\n"
    pm = _patch(old_m, new_m, "m.py")

    t("mixed-partial", lambda: _assert_fate(run_mem({"m.py": mid_m}, pm), "MIXED", "mixed"))
    t("mixed-pending", lambda: _assert_fate(run_mem({"m.py": old_m}, pm), "PENDING", "mixed-pending"))
    t("mixed-applied", lambda: _assert_fate(run_mem({"m.py": new_m}, pm), "APPLIED", "mixed-applied"))

    # duplex: both images present
    def duplex():
        both = old + "\n" + new
        v = run_mem({"add.py": both}, p)
        _assert_fate(v, "DUPLEX", "duplex")

    t("duplex-both-images", duplex)

    def add_prefix_not_duplex():
        # 6 context lines + inserted body: before is a prefix of after.
        old = "a\nb\nc\nd\ne\nf\n"
        new = "a\nb\nc\nd\ne\nf\nNEW_LINE_ONE\nNEW_LINE_TWO\n"
        pa = _patch(old, new, "t.py")
        v = run_mem({"t.py": new}, pa)
        _assert_fate(v, "APPLIED", "add-prefix")
        if any(x.fate == "DUPLEX" for x in v):
            raise AssertionError("addition hunk must not DUPLEX on its own context")

    t("addition-prefix-is-applied-not-duplex", add_prefix_not_duplex)

    def del_prefix_not_duplex():
        old = "a\nb\nc\nGONE_LINE\n"
        new = "a\nb\nc\n"
        pd = _patch(old, new, "t.py")
        v = run_mem({"t.py": old}, pd)
        _assert_fate(v, "PENDING", "del-prefix")

    t("deletion-prefix-is-pending-not-duplex", del_prefix_not_duplex)

    # create
    create_patch = (
        "diff --git a/new.txt b/new.txt\n"
        "new file mode 100644\n"
        "--- /dev/null\n"
        "+++ b/new.txt\n"
        "@@ -0,0 +1,2 @@\n"
        "+hello\n"
        "+world\n"
    )

    t(
        "create-pending",
        lambda: _assert_fate(run_mem({}, create_patch), "PENDING", "create-pending"),
    )
    t(
        "create-applied",
        lambda: _assert_fate(
            run_mem({"new.txt": "hello\nworld\n"}, create_patch), "APPLIED", "create-applied"
        ),
    )
    t(
        "create-drift",
        lambda: _assert_fate(
            run_mem({"new.txt": "hello\nthere\n"}, create_patch), "SUPERSEDED", "create-drift"
        ),
    )

    # delete
    delete_patch = (
        "diff --git a/gone.txt b/gone.txt\n"
        "deleted file mode 100644\n"
        "--- a/gone.txt\n"
        "+++ /dev/null\n"
        "@@ -1,2 +0,0 @@\n"
        "-hello\n"
        "-world\n"
    )
    t(
        "delete-pending",
        lambda: _assert_fate(
            run_mem({"gone.txt": "hello\nworld\n"}, delete_patch), "PENDING", "delete-pending"
        ),
    )
    t(
        "delete-applied",
        lambda: _assert_fate(run_mem({}, delete_patch), "APPLIED", "delete-applied"),
    )

    # context drifted but change taken
    old_c = "def foo():\n    helper()\n    return 1\n    # end\n"
    new_c = "def foo():\n    helper()\n    return 2\n    # end\n"
    drifted = "def foo():\n    helper()\n    extra()\n    return 2\n    # end\n"
    pc = _patch(old_c, new_c, "c.py")

    def context_drift():
        v = run_mem({"c.py": drifted}, pc)
        _assert_fate(v, "APPLIED", "context-drift")

    t("core-applied-context-drift", context_drift)

    # split fates in one patch (two files)
    split_patch = p + _patch(old_m, new_m, "m.py")

    def split_fates():
        v = run_mem({"add.py": new, "m.py": old_m}, split_patch)
        uni = unanimous(v)
        if uni != "SPLIT":
            raise AssertionError(f"want SPLIT got {uni}")

    t("split-across-files", split_fates)

    # ignore-space: extra indent on after-image
    def ignore_space():
        spaced = "def add(a, b):\n        return a + b\n"
        with tempfile.TemporaryDirectory(prefix="sate-sp-") as td:
            root = Path(td)
            _write_tree(root, {"add.py": spaced})
            files = parse_patch(p)
            v_exact = classify_parsed(files, root, None, ident, fuzz=fuzz)
            v_sp = classify_parsed(files, root, None, space_norm, fuzz=fuzz)
            if unanimous(v_sp) != "APPLIED":
                raise AssertionError(f"ignore-space want APPLIED got {unanimous(v_sp)}")
            if unanimous(v_exact) == "APPLIED":
                # extra indent may still exact-match after fuzz; either is fine
                # as long as space_norm is APPLIED
                pass

    t("ignore-space", ignore_space)

    # japanese + spaces in path
    def weird_names():
        path = "docs/計画 (1).md"
        oldw = "alpha\n"
        neww = "beta\n"
        pw = _patch(oldw, neww, path)
        v = run_mem({path: neww}, pw)
        _assert_fate(v, "APPLIED", "weird-applied")
        parsed = parse_patch(pw)
        if parsed[0].path != path:
            raise AssertionError(f"parser path {parsed[0].path!r} != {path!r}")

    t("weird-path-spaces-japanese", weird_names)

    # suggestion JSONL
    def suggestions():
        with tempfile.TemporaryDirectory(prefix="sate-sg-") as td:
            root = Path(td)
            _write_tree(root, {"mod.py": "TIMEOUT = 60\n"})
            text = (
                '{"path":"mod.py","before":["TIMEOUT = 30"],'
                '"after":["TIMEOUT = 60"],"id":"r1"}\n'
            )
            fps = load_suggestions(text)
            v = classify_parsed(fps, root, None, ident, fuzz=fuzz)
            _assert_fate(v, "APPLIED", "suggest-taken")
            _write_tree(root, {"mod.py": "TIMEOUT = 30\n"})
            v2 = classify_parsed(fps, root, None, ident, fuzz=fuzz)
            _assert_fate(v2, "PENDING", "suggest-open")
            _write_tree(root, {"mod.py": "TIMEOUT = 45\n"})
            v3 = classify_parsed(fps, root, None, ident, fuzz=fuzz)
            _assert_fate(v3, "SUPERSEDED", "suggest-mutated")

    t("suggest-taken-open-mutated", suggestions)

    # GitHub-ish body
    def gh_body():
        obj = {
            "path": "x.py",
            "side": "RIGHT",
            "diff_hunk": "@@ -1,3 +1,3 @@\n def f():\n-    return 1\n+    return 2\n",
            "body": "use 3\n```suggestion\n    return 3\n```",
        }
        fp = suggestion_to_filepatch(obj)
        if fp.kind != "modify":
            raise AssertionError("kind")
        if fp.hunks[0].plus != ["    return 3"]:
            raise AssertionError(f"plus={fp.hunks[0].plus}")
        if fp.hunks[0].minus != ["    return 2"]:
            raise AssertionError(f"minus={fp.hunks[0].minus}")

    t("github-suggestion-extract", gh_body)

    # parser: rename header
    def parse_rename():
        text = (
            "diff --git a/old name.txt b/new name.txt\n"
            "similarity index 100%\n"
            "rename from old name.txt\n"
            "rename to new name.txt\n"
        )
        fps = parse_patch(text)
        if len(fps) != 1 or fps[0].kind != "rename":
            raise AssertionError(fps)
        if fps[0].old_path != "old name.txt" or fps[0].new_path != "new name.txt":
            raise AssertionError((fps[0].old_path, fps[0].new_path))

    t("parse-rename", parse_rename)

    def parse_git_spaces():
        text = "diff --git a/old name.txt b/new name.txt\n"
        got = parse_diff_git_paths(text.strip())
        if got != ("old name.txt", "new name.txt"):
            raise AssertionError(got)

    t("parse-diff-git-spaces", parse_git_spaces)

    # sandwich invariant in a real git repo
    def sandwich():
        with tempfile.TemporaryDirectory(prefix="sate-git-") as td:
            root = Path(td)
            git(["init", "-q", "-b", "main"], root)
            git(["config", "user.name", "sate"], root)
            git(["config", "user.email", "sate@test"], root)
            git(["config", "commit.gpgsign", "false"], root)
            (root / "app.py").write_text("x = 1\n", encoding="utf-8")
            git(["add", "app.py"], root)
            git(["commit", "-q", "-m", "t0"], root)
            (root / "app.py").write_text("x = 2\n", encoding="utf-8")
            git(["add", "app.py"], root)
            git(["commit", "-q", "-m", "t1 bump"], root)
            patch = patch_of_rev(root, "HEAD")
            files = parse_patch(patch)
            v_head = classify_parsed(files, root, "HEAD", ident, fuzz=fuzz)
            v_parent = classify_parsed(files, root, "HEAD^", ident, fuzz=fuzz)
            _assert_fate(v_head, "APPLIED", "sandwich-HEAD")
            _assert_fate(v_parent, "PENDING", "sandwich-parent")

    t("occupancy-sandwich", sandwich)

    # no-newline marker does not become a tagged line
    def nonewline():
        text = (
            "diff --git a/z b/z\n"
            "--- a/z\n"
            "+++ b/z\n"
            "@@ -1 +1 @@\n"
            "-old\n"
            "+new\n"
            "\\ No newline at end of file\n"
        )
        fps = parse_patch(text)
        tags = fps[0].hunks[0].tagged
        if any(t[1].startswith(" No newline") or t[0] == "\\" for t in tags):
            raise AssertionError(tags)
        if fps[0].hunks[0].plus != ["new"] or fps[0].hunks[0].minus != ["old"]:
            raise AssertionError(tags)

    t("no-newline-marker", nonewline)

    print(f"selftest  {passed} passed  {failed} failed")
    return 0 if failed == 0 else 1


