# roles
# ---------------------------------------------------------------------------

def path_role(path: str) -> str:
    """ignore | oracle | prod | source (needs line tags)."""
    if not path or looks_dev_null(path):
        return "ignore"
    norm = path.replace("\\", "/")
    if GENERATED_RE.search(norm):
        return "ignore"
    if IGNORE_DIR_RE.search(norm) or IGNORE_FILE_RE.search(norm) or IGNORE_EXT_RE.search(norm):
        return "ignore"
    if TEST_DIR_RE.search(norm) or TEST_FILE_RE.search(norm) or TEST_EXT_RE.search(norm) or SNAP_RE.search(norm):
        return "oracle"
    ext = Path(norm).suffix.lower()
    if ext in SOURCE_EXT or ext == "":
        return "source"
    # unknown extension: ignore (assets, lock-adjacent)
    return "ignore"


def tag_lines(path: str, lines: list[str]) -> list[str]:
    """Per-line role: oracle | prod | ignore."""
    role = path_role(path)
    n = len(lines)
    if n == 0:
        return []
    if role == "ignore":
        return ["ignore"] * n
    if role == "oracle":
        return ["oracle"] * n
    # source: default prod, paint in-file test regions
    tags = ["prod"] * n
    ext = Path(path).suffix.lower()
    if ext == ".rs":
        i = 0
        while i < n:
            if CFG_TEST_RE.match(lines[i]):
                j = i + 1
                while j < n and not lines[j].strip():
                    j += 1
                if j < n and MOD_TESTS_RE.match(lines[j]):
                    start = i
                    depth = 0
                    seen = False
                    k = j
                    end = n - 1
                    while k < n:
                        depth += lines[k].count("{") - lines[k].count("}")
                        if "{" in lines[k]:
                            seen = True
                        if seen and depth <= 0:
                            end = k
                            break
                        k += 1
                    for t in range(start, end + 1):
                        tags[t] = "oracle"
                    i = end + 1
                    continue
            i += 1
    elif ext == ".py":
        i = 0
        while i < n:
            m = PY_TEST_RE.match(lines[i])
            if m:
                indent = len(m.group(1))
                tags[i] = "oracle"
                i += 1
                while i < n:
                    raw = lines[i]
                    if not raw.strip():
                        tags[i] = "oracle"
                        i += 1
                        continue
                    lead = len(raw) - len(raw.lstrip(" \t"))
                    if lead <= indent and not raw.lstrip().startswith("#"):
                        break
                    tags[i] = "oracle"
                    i += 1
                continue
            i += 1
    elif ext == ".swift":
        i = 0
        while i < n:
            if SWIFT_XC_RE.match(lines[i]):
                for k in range(i, n):
                    tags[k] = "oracle"
                break
            i += 1
    elif ext == ".go":
        for i, line in enumerate(lines):
            if GO_TEST_RE.match(line):
                tags[i] = "oracle"
    elif ext in {".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"}:
        # path-based already caught *.test.ts; in-file describe is too greedy
        pass
    return tags


def reconstruct_after(before: list[str] | None, file_hunks: list[Hunk]) -> list[str]:
    """Apply hunks in file order onto before-image. Create → plus lines only."""
    if any(h.file_kind == "create" for h in file_hunks):
        out: list[str] = []
        for h in file_hunks:
            out.extend(h.after)
        return out
    if before is None:
        out = []
        for h in file_hunks:
            out.extend(h.after)
        return out
    # sequential apply; hunks should be in file order
    text = list(before)
    delta = 0
    for h in sorted(file_hunks, key=lambda x: x.old_start):
        start = h.old_start - 1 + delta
        old_n = sum(1 for op, _ in h.lines if op in " -")
        # if misaligned, still splice at recorded start
        start = max(0, min(start, len(text)))
        text[start : start + old_n] = h.after
        delta += len(h.after) - old_n
    return text


def _role_for_line(tags: list[str], idx: int, fallback: str) -> str:
    if 0 <= idx < len(tags):
        r = tags[idx]
        if r != "ignore":
            return r
    return fallback


def hunk_events(
    h: Hunk, tags_before: list[str], tags_after: list[str], fallback: str
) -> list[tuple[str, str, str]]:
    """(op, text, role) for each hunk line. Context is tagged from the after side."""
    out: list[tuple[str, str, str]] = []
    bi = h.old_start - 1
    ai = h.new_start - 1
    for op, text in h.lines:
        if op == "+":
            out.append((op, text, _role_for_line(tags_after, ai, fallback)))
            ai += 1
        elif op == "-":
            out.append((op, text, _role_for_line(tags_before, bi, fallback)))
            bi += 1
        else:
            role = _role_for_line(tags_after, ai, fallback)
            if role == fallback:
                role = _role_for_line(tags_before, bi, fallback)
            out.append((op, text, role))
            bi += 1
            ai += 1
    return out


def one_cut(seq: list[str]) -> bool:
    if not seq:
        return True
    i = 1
    while i < len(seq) and seq[i] == seq[0]:
        i += 1
    return all(x == seq[i] for x in seq[i:]) if i < len(seq) else True


def split_mixed_hunk(
    h: Hunk, tags_before: list[str], tags_after: list[str]
) -> list[tuple[Hunk, str]] | None:
    """If a mixed hunk is a single prod|oracle cut, return two virtual hunks.

    Interleaved changes stay SEAM (None).
    """
    pr = path_role(h.path)
    fallback = "oracle" if pr == "oracle" else "prod"
    events = hunk_events(h, tags_before, tags_after, fallback)
    change = [r for op, _t, r in events if op in "+-" and r in ("prod", "oracle")]
    roles = set(change)
    if roles <= {"prod"} or roles <= {"oracle"} or not roles:
        return None
    if not one_cut(change):
        return None
    split: list[tuple[Hunk, str]] = []
    for want in ("prod", "oracle"):
        lines = [(op, text) for op, text, r in events if r == want]
        if not any(op in "+-" for op, _t in lines):
            continue
        nh = Hunk(
            old_path=h.old_path,
            new_path=h.new_path,
            old_start=h.old_start,
            new_start=h.new_start,
            header=h.header + f" twain:{want}",
            lines=lines,
            file_kind=h.file_kind if want == "prod" or h.file_kind != "create" else "modify",
            binary=False,
            index=h.index,
        )
        split.append((nh, want))
    return split if len(split) == 2 else None


def hunk_changed_roles(h: Hunk, tags_before: list[str], tags_after: list[str]) -> set[str]:
    roles: set[str] = set()
    bi = h.old_start - 1
    ai = h.new_start - 1
    for op, _text in h.lines:
        if op == " ":
            bi += 1
            ai += 1
        elif op == "-":
            if 0 <= bi < len(tags_before):
                roles.add(tags_before[bi])
            bi += 1
        elif op == "+":
            if 0 <= ai < len(tags_after):
                roles.add(tags_after[ai])
            ai += 1
    roles.discard("ignore")
    if not roles:
        # no tagged change: treat by path
        r = path_role(h.path)
        if r == "source":
            r = "prod"
        if r != "ignore":
            roles.add(r)
    return roles


# ---------------------------------------------------------------------------
# occupancy
# ---------------------------------------------------------------------------

def find_all(hay: list[str], needle: list[str]) -> list[int]:
    if not needle:
        return []
    n = len(needle)
    hits: list[int] = []
    first = needle[0]
    start = 0
    length = len(hay)
    while start < length:
        try:
            j = hay.index(first, start)
        except ValueError:
            break
        if hay[j : j + n] == needle:
            hits.append(j)
        start = j + 1
    return hits


def is_subseq(hay: list[str], needle: list[str]) -> bool:
    if not needle:
        return False
    it = iter(hay)
    try:
        for x in needle:
            while next(it) != x:
                pass
        return True
    except StopIteration:
        return False


def significant(lines: list[str]) -> list[str]:
    out = []
    for L in lines:
        s = L.strip()
        if len(s) < 8:
            continue
        if GENERIC_RE.match(L) or GENERIC_RE.match(s):
            continue
        out.append(L)
    if out:
        return out
    return [L for L in lines if L.strip()]


def occupy_hunk(file_lines: list[str] | None, h: Hunk) -> tuple[str, str]:
    """Return (fate, method)."""
    if h.binary:
        return "SKIP", "binary"
    minus = h.minus
    plus = h.plus
    before = h.before
    after = h.after
    if not before and not after and not minus and not plus:
        if h.file_kind == "create":
            return ("PENDING", "missing-create") if file_lines is None else ("APPLIED", "exists")
        if h.file_kind == "delete":
            return ("APPLIED", "missing-delete") if file_lines is None else ("PENDING", "exists")
        return "SKIP", "empty"
    if file_lines is None:
        if plus and not minus:
            return "PENDING", "missing-create"
        if minus and not plus:
            return "APPLIED", "missing-delete"
        if h.file_kind == "create":
            return "PENDING", "missing-create"
        if h.file_kind == "delete":
            return "APPLIED", "missing-delete"
        return "SUPERSEDED", "missing-file"

    hay = file_lines
    before_hits = find_all(hay, before) if before else []
    after_hits = find_all(hay, after) if after else []
    sig_minus = significant(minus)
    sig_plus = significant(plus)

    # twain occupy: did this *half's after-image* land? Leftover befores
    # (sate DUPLEX) still mean the after occupies. Forced by voidtrace
    # sandwich: 2/110 prod hunks were DUPLEX against the commit that
    # introduced them.
    if after_hits:
        return "APPLIED", "exact-after"
    if plus and not minus:
        if before_hits:
            return "PENDING", "exact-before"
        if sig_plus and find_all(hay, sig_plus):
            return "APPLIED", "add-core"
        if sig_plus and is_subseq(hay, sig_plus):
            return "APPLIED", "add-subseq"
        return "SUPERSEDED", "add-neither"

    if minus and not plus:
        if before_hits:
            return "PENDING", "exact-before"
        if sig_minus and is_subseq(hay, sig_minus):
            return "PENDING", "del-subseq"
        return "APPLIED", "deleted"

    if before_hits:
        return "PENDING", "exact-before"

    plus_sub = is_subseq(hay, sig_plus) if sig_plus else False
    minus_sub = is_subseq(hay, sig_minus) if sig_minus else False
    if plus_sub and not minus_sub:
        return "APPLIED", "subseq-plus"
    if minus_sub and not plus_sub:
        return "PENDING", "subseq-minus"
    if plus_sub and minus_sub:
        return "MIXED", "subseq-both"
    return "SUPERSEDED", "neither"


def _is_prefix(small: list[str], big: list[str]) -> bool:
    if not small or len(small) >= len(big):
        return False
    return big[: len(small)] == small or find_all(big, small) != []


def half_fate(fates: list[str]) -> str:
    real = [f for f in fates if f not in ("SKIP", "EMPTY")]
    if not real:
        return "EMPTY"
    uniq = set(real)
    if uniq == {"APPLIED"}:
        return "APPLIED"
    if uniq == {"PENDING"}:
        return "PENDING"
    return "MIXED"


# ---------------------------------------------------------------------------
# bind
# ---------------------------------------------------------------------------

def tokens_of(lines: list[str]) -> set[str]:
    out: set[str] = set()
    for line in lines:
        for s in STRING_RE.findall(line):
            inner = s[1:-1]
            if len(inner) >= 3 and not inner.startswith("http"):
                out.add(inner)
        for ident in IDENT_RE.findall(line):
            if ident.isnumeric():
                continue
            if ident in KEYWORDS or ident.lower() in KEYWORDS:
                continue
            ascii_only = ident.isascii()
            if ascii_only and len(ident) < 3:
                continue
            if not ascii_only and len(ident) < 2:
                continue
            out.add(ident)
    return out


