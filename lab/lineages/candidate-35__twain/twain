HELP = f"""twain {VERSION} — a unified diff is two patches (oracle vs production)

Usage:
  twain [rev]                     occupy rev vs its parent (default HEAD)
  twain A...B                     occupy a range (merge-base)
  twain --patch FILE              occupy a unified diff
  git show | twain --patch -      stdin
  twain --emit oracle|prod [rev]  print that half as a unified diff
  twain --selftest

Occupies each half against --against (default HEAD, or :worktree with --worktree).

Statuses:
  LOCKED        both halves occupy the tree and the oracle binds production
  LOOSE         both occupy, bind empty (tests that do not mention the change)
  MUTE          production occupies, no oracle half
  HOLLOW        oracle occupies, no production half
  PROD_AHEAD    production occupies, oracle still PENDING
  ORACLE_AHEAD  oracle occupies, production still PENDING
  PENDING       neither half occupies
  SEAM          a hunk mixes oracle and production regions (not separable)
  SPLIT         mixed occupancy inside a half
  EMPTY         docs/ignore only

Exit: 0 LOCKED/EMPTY, 1 unlocked, 2 SEAM/SPLIT, 3 error.
      --report-only forces 0. --check is default exit.
"""


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="twain", add_help=False)
    p.add_argument("rev", nargs="?", default=None)
    p.add_argument("-C", "--repo", default=".")
    p.add_argument("--against", default=None)
    p.add_argument("--worktree", action="store_true")
    p.add_argument("--patch", default=None)
    p.add_argument("--emit", choices=("oracle", "prod", "ignore"))
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--porcelain", action="store_true")
    p.add_argument("--explain", action="store_true")
    p.add_argument("--report-only", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--help", "-h", action="store_true")
    p.add_argument("--version", action="store_true")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    ns = parse_args(argv if argv is not None else sys.argv[1:])
    if ns.help:
        sys.stdout.write(HELP)
        return 0
    if ns.version:
        print(VERSION)
        return 0
    if ns.selftest:
        return selftest()

    root = Path(ns.repo).resolve()
    try:
        if ns.patch == "-":
            text = sys.stdin.read()
            rev = None
        elif ns.patch:
            text = Path(ns.patch).read_text(encoding="utf-8")
            rev = None
        else:
            if not is_git_repo(root):
                print("twain: not a git repository (pass --patch)", file=sys.stderr)
                return EXIT_ERROR
            rev = ns.rev or "HEAD"
            text = patch_of_rev(root, rev)
    except Exception as e:
        print(f"twain: {e}", file=sys.stderr)
        return EXIT_ERROR

    hunks = parse_patch(text)
    against: str | None
    if ns.worktree:
        against = None
    elif ns.against:
        against = ns.against
    elif is_git_repo(root):
        against = "HEAD"
    else:
        against = None

    try:
        rep, tagged = analyze(hunks, root, against, rev)
    except Exception as e:
        print(f"twain: {e}", file=sys.stderr)
        return EXIT_ERROR

    if ns.emit:
        keep = [h for h, r, _ in tagged if r == ns.emit]
        sys.stdout.write(emit_patch(keep))
        code = 0 if keep or ns.report_only else EXIT_UNLOCKED
        return 0 if ns.report_only else code

    if ns.json:
        sys.stdout.write(json.dumps(rep.as_dict(), indent=2, ensure_ascii=False) + "\n")
    elif ns.tsv:
        sys.stdout.write(format_tsv(rep))
    elif ns.porcelain:
        sys.stdout.write(format_porcelain(rep))
    else:
        sys.stdout.write(format_human(rep, ns.explain))

    if ns.report_only:
        return 0
    return status_exit(rep.status)


if __name__ == "__main__":
    sys.exit(main())
