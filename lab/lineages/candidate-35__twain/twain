            "header": self.header,
            "plus": self.plus_n,
            "minus": self.minus_n,
            "roles": self.roles,
        }


@dataclass
class Report:
    status: str
    kind: str
    prod_fate: str
    oracle_fate: str
    bound: bool
    bind: list[str]
    prod_tokens: list[str]
    oracle_tokens: list[str]
    hunks: list[HunkReport]
    against: str | None
    rev: str | None
    n_prod: int
    n_oracle: int
    n_seam: int
    n_ignore: int

    def as_dict(self) -> dict:
        return {
            "status": self.status,
            "kind": self.kind,
            "prod": {"fate": self.prod_fate, "n": self.n_prod},
            "oracle": {"fate": self.oracle_fate, "n": self.n_oracle},
            "seam": self.n_seam,
            "ignore": self.n_ignore,
            "bound": self.bound,
            "bind": self.bind,
            "prod_tokens": self.prod_tokens,
            "oracle_tokens": self.oracle_tokens,
            "against": self.against,
            "rev": self.rev,
            "hunks": [h.as_dict() for h in self.hunks],
        }


def classify_hunks(
    hunks: list[Hunk],
    root: Path,
    against: str | None,
    rev: str | None,
) -> list[tuple[Hunk, str, list[str]]]:
    """role, contributing line-roles."""
    by_file: dict[str, list[Hunk]] = {}
    for h in hunks:
        by_file.setdefault(h.path, []).append(h)

    # after-image: prefer rev blob; else reconstruct from against + hunks
    after_cache: dict[str, list[str]] = {}
    before_cache: dict[str, list[str] | None] = {}
    for path, fh in by_file.items():
        before_cache[path] = read_tree_file(root, path, against)
        after_lines = None
        if rev and ".." not in rev and is_git_repo(root):
            after_lines = read_tree_file(root, path, rev)
        if after_lines is None:
            # worktree as after when occupying a dirty diff against HEAD
            if against is not None:
                wt = read_tree_file(root, path, None)
                # only use worktree if it looks like the after-image
                after_lines = reconstruct_after(before_cache[path], fh)
                if wt is not None and fh:
                    after_lines = wt if any(h.file_kind != "delete" for h in fh) else after_lines
            else:
                after_lines = reconstruct_after(before_cache[path], fh)
        after_cache[path] = after_lines or []

    tagged: list[tuple[Hunk, str, list[str]]] = []
    for h in hunks:
        path = h.path
        tags_after = tag_lines(path, after_cache.get(path, []))
        tags_before = tag_lines(path, before_cache.get(path) or [])
        if h.binary:
            tagged.append((h, "ignore", ["ignore"]))
            continue
        split = split_mixed_hunk(h, tags_before, tags_after)
        if split:
            for nh, role in split:
                tagged.append((nh, role, [role]))
            continue
        roles = hunk_changed_roles(h, tags_before, tags_after)
        if roles <= {"ignore"} or not roles:
            pr = path_role(path)
            if pr == "oracle":
                tagged.append((h, "oracle", ["oracle"]))
            elif pr == "source":
                tagged.append((h, "prod", ["prod"]))
            else:
                tagged.append((h, "ignore", ["ignore"]))
            continue
        if roles == {"oracle"}:
            tagged.append((h, "oracle", sorted(roles)))
        elif roles == {"prod"}:
            tagged.append((h, "prod", sorted(roles)))
        elif "oracle" in roles and "prod" in roles:
            tagged.append((h, "seam", sorted(roles)))
        elif "oracle" in roles:
            tagged.append((h, "oracle", sorted(roles)))
        elif "prod" in roles:
            tagged.append((h, "prod", sorted(roles)))
        else:
            tagged.append((h, "ignore", sorted(roles)))
    return tagged


def decide_status(
    kind: str,
    prod_fate: str,
    oracle_fate: str,
    bound: bool,
    n_seam: int,
) -> str:
    if n_seam:
        return "SEAM"
    if prod_fate == "EMPTY" and oracle_fate == "EMPTY":
        return "EMPTY"
    if prod_fate == "APPLIED" and oracle_fate == "APPLIED":
        return "LOCKED" if bound else "LOOSE"
    if prod_fate == "APPLIED" and oracle_fate == "EMPTY":
        return "MUTE"
    if prod_fate == "APPLIED" and oracle_fate == "PENDING":
        return "PROD_AHEAD"
    if oracle_fate == "APPLIED" and prod_fate == "EMPTY":
        return "HOLLOW"
    if oracle_fate == "APPLIED" and prod_fate == "PENDING":
        return "ORACLE_AHEAD"
    if prod_fate == "PENDING" and oracle_fate in ("PENDING", "EMPTY"):
        return "PENDING"
    if oracle_fate == "PENDING" and prod_fate == "EMPTY":
        return "PENDING"
    return "SPLIT"


def analyze(
    hunks: list[Hunk],
    root: Path,
    against: str | None,
    rev: str | None,
) -> tuple[Report, list[tuple[Hunk, str, list[str]]]]:
    tagged = classify_hunks(hunks, root, against, rev)
    reports: list[HunkReport] = []
    prod_fates: list[str] = []
    oracle_fates: list[str] = []
    prod_tok: set[str] = set()
    oracle_tok: set[str] = set()
    n_seam = n_ignore = 0

    file_cache: dict[tuple[str, str | None], list[str] | None] = {}

    def hay_of(path: str) -> list[str] | None:
        key = (path, against)
        if key not in file_cache:
            file_cache[key] = read_tree_file(root, path, against)
        return file_cache[key]

    for h, role, roles in tagged:
        fate, method = occupy_hunk(hay_of(h.path), h)
        reports.append(
            HunkReport(
                path=h.path,
                index=h.index,
                role=role,
                fate=fate,
                method=method,
                header=h.header,
                plus_n=len(h.plus),
                minus_n=len(h.minus),
                roles=list(roles),
            )
        )
        if role == "prod":
            prod_fates.append(fate)
            prod_tok |= tokens_of(h.core_lines)
        elif role == "oracle":
            oracle_fates.append(fate)
            oracle_tok |= tokens_of(h.core_lines)
        elif role == "seam":
            n_seam += 1
            prod_fates.append(fate)
            oracle_fates.append(fate)
            prod_tok |= tokens_of(h.core_lines)
            oracle_tok |= tokens_of(h.core_lines)
        else:
            n_ignore += 1

    pf = half_fate(prod_fates)
    of = half_fate(oracle_fates)
    bind = sorted(prod_tok & oracle_tok)
    # seam hunks share their own tokens; require a bind across halves
    # even if seam: still report intersection
    bound = bool(bind)
    n_prod = sum(1 for _, r, _ in tagged if r == "prod")
    n_oracle = sum(1 for _, r, _ in tagged if r == "oracle")
    if n_prod and n_oracle:
        kind = "TWAIN"
    elif n_seam and not n_prod and not n_oracle:
        kind = "SEAM"
    elif n_prod:
        kind = "PROD"
    elif n_oracle:
        kind = "ORACLE"
    else:
        kind = "EMPTY"
    if n_seam and kind == "TWAIN":
        kind = "TWAIN"
    status = decide_status(kind, pf, of, bound, n_seam)
    # MUTE vs unbound TWAIN already handled; if only prod+seam with bind inside seam, SEAM wins
    rep = Report(
        status=status,
        kind=kind,
        prod_fate=pf,
        oracle_fate=of,
        bound=bound,
        bind=bind[:40],
        prod_tokens=sorted(prod_tok)[:40],
        oracle_tokens=sorted(oracle_tok)[:40],
        hunks=reports,
        against=against if against is not None else ":worktree",
        rev=rev,
        n_prod=n_prod,
        n_oracle=n_oracle,
        n_seam=n_seam,
        n_ignore=n_ignore,
    )
    return rep, tagged


def status_exit(status: str) -> int:
    if status in ("LOCKED", "EMPTY"):
        return EXIT_LOCKED
    if status in ("SEAM", "SPLIT"):
        return EXIT_SPLIT
    return EXIT_UNLOCKED


# ---------------------------------------------------------------------------
# format
# ---------------------------------------------------------------------------

def format_human(rep: Report, explain: bool) -> str:
    lines = [
        f"twain  {rep.status}  kind={rep.kind}  "
        f"prod={rep.prod_fate}({rep.n_prod})  "
        f"oracle={rep.oracle_fate}({rep.n_oracle})  "
        f"seam={rep.n_seam}  bind={len(rep.bind)}  against={rep.against}"
    ]
    if rep.bind:
        lines.append("  bind  " + "  ".join(rep.bind[:12]))
    elif rep.n_prod and rep.n_oracle:
        lines.append("  bind  (none)")
    if explain:
        if rep.prod_tokens:
            lines.append("  prod_tokens  " + " ".join(rep.prod_tokens[:16]))
        if rep.oracle_tokens:
            lines.append("  oracle_tokens  " + " ".join(rep.oracle_tokens[:16]))
    for h in rep.hunks:
        if h.role == "ignore" and not explain:
            continue
        lines.append(
            f"  {h.role:<7} {h.fate:<11} {h.path} #{h.index}  {h.method}"
        )
    return "\n".join(lines) + "\n"


def format_tsv(rep: Report) -> str:
    rows = [
        "\t".join(
            [
                "status",
                "kind",
                "role",
                "fate",
                "path",
                "index",
                "method",
                "bind",
            ]
        )
    ]
    bind = ",".join(rep.bind)
    for h in rep.hunks:
        rows.append(
            "\t".join(
                [
                    rep.status,
                    rep.kind,
                    h.role,
                    h.fate,
                    h.path,
                    str(h.index),
                    h.method,
                    bind,
                ]
            )
        )
    return "\n".join(rows) + "\n"


def format_porcelain(rep: Report) -> str:
    return (
        f"status {rep.status}\n"
        f"kind {rep.kind}\n"
        f"prod {rep.prod_fate} {rep.n_prod}\n"
        f"oracle {rep.oracle_fate} {rep.n_oracle}\n"
        f"seam {rep.n_seam}\n"
        f"bound {int(rep.bound)}\n"
        f"bind {len(rep.bind)}\n"
    )


