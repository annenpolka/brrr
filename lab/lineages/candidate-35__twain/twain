# patch parse
# ---------------------------------------------------------------------------

@dataclass
class Hunk:
    old_path: str
    new_path: str
    old_start: int
    new_start: int
    header: str
    lines: list[tuple[str, str]]  # op, text without +/- prefix
    file_kind: str = "modify"
    binary: bool = False
    index: int = 0

    @property
    def path(self) -> str:
        return self.new_path if self.new_path and not looks_dev_null(self.new_path) else self.old_path

    @property
    def plus(self) -> list[str]:
        return [t for op, t in self.lines if op == "+"]

    @property
    def minus(self) -> list[str]:
        return [t for op, t in self.lines if op == "-"]

    @property
    def context(self) -> list[str]:
        return [t for op, t in self.lines if op == " "]

    @property
    def before(self) -> list[str]:
        return [t for op, t in self.lines if op in " -"]

    @property
    def after(self) -> list[str]:
        return [t for op, t in self.lines if op in " +"]

    @property
    def core_lines(self) -> list[str]:
        return [t for op, t in self.lines if op in "+-"]


def parse_patch(text: str) -> list[Hunk]:
    hunks: list[Hunk] = []
    old_path = new_path = ""
    file_kind = "modify"
    binary = False
    pending_header = ""
    hunk: Hunk | None = None
    per_file = 0

    def flush_hunk() -> None:
        nonlocal hunk
        if hunk is not None:
            hunks.append(hunk)
            hunk = None

    for raw in text.splitlines():
        if raw.startswith("diff --git "):
            flush_hunk()
            paths = parse_diff_git_paths(raw)
            old_path = paths[0] if paths else ""
            new_path = paths[1] if paths else ""
            file_kind = "modify"
            binary = False
            pending_header = raw
            per_file = 0
            continue
        if raw.startswith("old mode ") or raw.startswith("new mode "):
            continue
        if raw.startswith("similarity index") or raw.startswith("dissimilarity index"):
            continue
        if raw.startswith("rename from "):
            file_kind = "rename"
            old_path = strip_ab_prefix(raw[len("rename from ") :])
            continue
        if raw.startswith("rename to "):
            file_kind = "rename"
            new_path = strip_ab_prefix(raw[len("rename to ") :])
            continue
        if raw.startswith("copy from ") or raw.startswith("copy to "):
            continue
        if raw.startswith("index "):
            continue
        if raw.startswith("Binary files ") or raw.startswith("GIT binary patch"):
            binary = True
            flush_hunk()
            per_file += 1
            hunks.append(
                Hunk(
                    old_path=old_path,
                    new_path=new_path,
                    old_start=0,
                    new_start=0,
                    header=pending_header or "binary",
                    lines=[],
                    file_kind="binary",
                    binary=True,
                    index=per_file,
                )
            )
            hunk = None
            continue
        if raw.startswith("--- "):
            rhs = raw[4:]
            old_path = "/dev/null" if looks_dev_null(rhs) else strip_ab_prefix(rhs)
            if looks_dev_null(rhs):
                file_kind = "create"
            continue
        if raw.startswith("+++ "):
            rhs = raw[4:]
            new_path = "/dev/null" if looks_dev_null(rhs) else strip_ab_prefix(rhs)
            if looks_dev_null(rhs):
                file_kind = "delete"
            continue
        m = HUNK_RE.match(raw)
        if m:
            flush_hunk()
            per_file += 1
            hunk = Hunk(
                old_path=old_path,
                new_path=new_path,
                old_start=int(m.group(1)),
                new_start=int(m.group(3)),
                header=raw,
                lines=[],
                file_kind=file_kind,
                binary=binary,
                index=per_file,
            )
            continue
        if hunk is None:
            continue
        if raw.startswith("\\"):  # "\ No newline at end of file"
            continue
        if raw.startswith("+"):
            hunk.lines.append(("+", raw[1:]))
        elif raw.startswith("-"):
            hunk.lines.append(("-", raw[1:]))
        elif raw.startswith(" "):
            hunk.lines.append((" ", raw[1:]))
        elif raw == "":
            hunk.lines.append((" ", ""))
        else:
            # stray line; treat as context
            hunk.lines.append((" ", raw))
    flush_hunk()
    return hunks


def emit_patch(hunks: list[Hunk]) -> str:
    out: list[str] = []
    current = None
    for h in hunks:
        if h.binary:
            continue
        key = (h.old_path, h.new_path, h.file_kind)
        if key != current:
            current = key
            live = h.path
            a = h.old_path if h.old_path and not looks_dev_null(h.old_path) else live
            b = h.new_path if h.new_path and not looks_dev_null(h.new_path) else live
            out.append(f"diff --git a/{a} b/{b}")
            if h.file_kind == "create":
                out.append("new file mode 100644")
                out.append("--- /dev/null")
                out.append(f"+++ b/{b}")
            elif h.file_kind == "delete":
                out.append("deleted file mode 100644")
                out.append(f"--- a/{a}")
                out.append("+++ /dev/null")
            else:
                out.append(f"--- a/{a}")
                out.append(f"+++ b/{b}")
        old_n = sum(1 for op, _ in h.lines if op in " -")
        new_n = sum(1 for op, _ in h.lines if op in " +")
        out.append(f"@@ -{h.old_start},{old_n} +{h.new_start},{new_n} @@")
        for op, text in h.lines:
            out.append(op + text)
    return "\n".join(out) + ("\n" if out else "")


