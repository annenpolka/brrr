def _git_init(td: Path) -> None:
    git(["init", "-q"], td)
    git(["config", "user.email", "twain@test"], td)
    git(["config", "user.name", "twain"], td)


def _commit(td: Path, msg: str) -> str:
    git(["add", "-A"], td)
    git(["commit", "-q", "-m", msg], td)
    proc = git(["rev-parse", "HEAD"], td)
    return proc.stdout.decode().strip()


def selftest() -> int:
    fails = 0
    passed = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal fails, passed
        if cond:
            passed += 1
            print(f"  PASS  {name}")
        else:
            fails += 1
            print(f"  FAIL  {name}" + (f"  {detail}" if detail else ""))

    # parser + roles on a synthetic patch (no git)
    patch = """diff --git a/app.py b/app.py
--- a/app.py
+++ b/app.py
@@ -1,3 +1,4 @@
 def add(a, b):
-    return a + b
+    return a + b + bias()
+
diff --git a/tests/test_add.py b/tests/test_add.py
new file mode 100644
--- /dev/null
+++ b/tests/test_add.py
@@ -0,0 +1,3 @@
+from app import add, bias
+def test_bias():
+    assert add(1, 1) == 2 + bias()
"""
    hunks = parse_patch(patch)
    check("parse two files", len(hunks) == 2, str(len(hunks)))
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "app.py").write_text("def add(a, b):\n    return a + b + bias()\n\n")
        (td / "tests").mkdir()
        (td / "tests/test_add.py").write_text(
            "from app import add, bias\ndef test_bias():\n    assert add(1, 1) == 2 + bias()\n"
        )
        rep, _ = analyze(hunks, td, against=None, rev=None)
        check("fixture LOCKED", rep.status == "LOCKED", rep.status)
        check("fixture TWAIN", rep.kind == "TWAIN", rep.kind)
        check("bind bias", "bias" in rep.bind, str(rep.bind))
        check("prod applied", rep.prod_fate == "APPLIED", rep.prod_fate)
        check("oracle applied", rep.oracle_fate == "APPLIED", rep.oracle_fate)

    # MUTE: prod only
    mute = """diff --git a/app.py b/app.py
--- a/app.py
+++ b/app.py
@@ -1,2 +1,2 @@
 def add(a, b):
-    return a + b
+    return a + b + 1
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "app.py").write_text("def add(a, b):\n    return a + b + 1\n")
        rep, _ = analyze(parse_patch(mute), td, None, None)
        check("MUTE", rep.status == "MUTE", rep.status)

    # HOLLOW: tests only
    hollow = """diff --git a/tests/test_add.py b/tests/test_add.py
new file mode 100644
--- /dev/null
+++ b/tests/test_add.py
@@ -0,0 +1,2 @@
+def test_add():
+    assert add(1, 1) == 2
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "tests").mkdir()
        (td / "tests/test_add.py").write_text("def test_add():\n    assert add(1, 1) == 2\n")
        rep, _ = analyze(parse_patch(hollow), td, None, None)
        check("HOLLOW", rep.status == "HOLLOW", rep.status)

    # LOOSE: both halves, no shared tokens
    loose = """diff --git a/app.py b/app.py
--- a/app.py
+++ b/app.py
@@ -1,2 +1,2 @@
 def add(a, b):
-    return a + b
+    return a - b
diff --git a/tests/test_add.py b/tests/test_add.py
--- a/tests/test_add.py
+++ b/tests/test_add.py
@@ -1,2 +1,2 @@
 def test_ok():
-    assert True
+    assert not False
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "app.py").write_text("def add(a, b):\n    return a - b\n")
        (td / "tests").mkdir()
        (td / "tests/test_add.py").write_text("def test_ok():\n    assert not False\n")
        rep, _ = analyze(parse_patch(loose), td, None, None)
        check("LOOSE", rep.status == "LOOSE", f"{rep.status} bind={rep.bind}")

    # v0.2: a cfg(test) suffix in the same hunk is a cut, not SEAM.
    suffix = """diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1,6 +1,11 @@
 pub fn add(a: i32, b: i32) -> i32 {
-    a + b
+    a + b + bias()
 }
 
 #[cfg(test)]
 mod tests {
-    use super::*;
+    use super::*;
+    #[test]
+    fn bias_is_wired() {
+        assert_eq!(add(1, 1), 2 + bias());
+    }
 }
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "src").mkdir()
        (td / "src/lib.rs").write_text(
            "pub fn add(a: i32, b: i32) -> i32 {\n    a + b + bias()\n}\n\n"
            "#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n"
            "    fn bias_is_wired() {\n        assert_eq!(add(1, 1), 2 + bias());\n    }\n}\n"
        )
        rep, tagged = analyze(parse_patch(suffix), td, None, None)
        check("suffix cut LOCKED", rep.status == "LOCKED", f"{rep.status} tagged={[t[1] for t in tagged]}")
        check("suffix split halves", rep.n_prod == 1 and rep.n_oracle == 1 and rep.n_seam == 0,
              f"prod={rep.n_prod} oracle={rep.n_oracle} seam={rep.n_seam}")
        check("suffix bind bias", "bias" in rep.bind, str(rep.bind))

    # true SEAM: interleaved prod / oracle / prod in one hunk
    seam = """diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1,9 +1,12 @@
 pub fn add(a: i32, b: i32) -> i32 {
-    a
+    a + bias()
 }
 #[cfg(test)]
 mod tests {
     use super::*;
+    #[test]
+    fn t() { assert_eq!(add(0, 0), bias()); }
 }
 pub fn other() -> i32 {
-    1
+    2
 }
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "src").mkdir()
        (td / "src/lib.rs").write_text(
            "pub fn add(a: i32, b: i32) -> i32 {\n    a + bias()\n}\n"
            "#[cfg(test)]\nmod tests {\n    use super::*;\n"
            "    #[test]\n    fn t() { assert_eq!(add(0, 0), bias()); }\n}\n"
            "pub fn other() -> i32 {\n    2\n}\n"
        )
        rep, tagged = analyze(parse_patch(seam), td, None, None)
        check("interleaved SEAM", rep.status == "SEAM", f"{rep.status} tagged={[t[1] for t in tagged]}")
        check("SEAM hunk", rep.n_seam == 1, str(rep.n_seam))

    # sandwich in a real git repo
    with tempfile.TemporaryDirectory(prefix="twain-git-") as tmp:
        td = Path(tmp)
        _git_init(td)
        (td / "app.py").write_text("def add(a, b):\n    return a + b\n")
        (td / "tests").mkdir()
        (td / "tests/test_add.py").write_text("def test_add():\n    assert add(1,1)==2\n")
        c1 = _commit(td, "base")
        (td / "app.py").write_text("def add(a, b):\n    return a + b + bias()\n")
        (td / "tests/test_add.py").write_text(
            "def test_add():\n    assert add(1,1)==2 + bias()\n"
        )
        c2 = _commit(td, "wire bias")
        patch = patch_of_rev(td, c2)
        hunks = parse_patch(patch)
        rep_head, _ = analyze(hunks, td, against=c2, rev=c2)
        rep_par, _ = analyze(hunks, td, against=c1, rev=c2)
        check("sandwich LOCKED at HEAD", rep_head.status == "LOCKED", rep_head.status)
        check("sandwich PENDING at parent", rep_par.status == "PENDING", rep_par.status)
        check("bind bias in git", "bias" in rep_head.bind, str(rep_head.bind))

        # --emit oracle applied onto parent → ORACLE_AHEAD
        tagged = classify_hunks(hunks, td, against=c2, rev=c2)
        oracle_h = [h for h, r, _ in tagged if r == "oracle"]
        emitted = emit_patch(oracle_h)
        check("emit oracle nonempty", "test_add.py" in emitted and "app.py" not in emitted, emitted[:200])

    # addition prefix is APPLIED not DUPLEX
    addp = """diff --git a/app.py b/app.py
--- a/app.py
+++ b/app.py
@@ -1,2 +1,4 @@
 def add(a, b):
     return a + b
+def bias():
+    return 1
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "app.py").write_text("def add(a, b):\n    return a + b\ndef bias():\n    return 1\n")
        rep, _ = analyze(parse_patch(addp), td, None, None)
        fate = rep.hunks[0].fate if rep.hunks else "?"
        check("addition not DUPLEX", fate == "APPLIED", fate)

    # ugly path with spaces + unicode
    ugly = """diff --git a/src/file with spaces.rs b/src/file with spaces.rs
--- a/src/file with spaces.rs
+++ b/src/file with spaces.rs
@@ -1,3 +1,6 @@
 pub fn add(a: i32, b: i32) -> i32 { a + b }
+pub fn 加算(a: i32, b: i32) -> i32 {
+    a + b
+}
diff --git a/tests/加算_test.rs b/tests/加算_test.rs
new file mode 100644
--- /dev/null
+++ b/tests/加算_test.rs
@@ -0,0 +1,2 @@
+#[test]
+fn 加算_works() { assert_eq!(加算(1,1), 2); }
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "src").mkdir()
        (td / "tests").mkdir()
        (td / "src/file with spaces.rs").write_text(
            "pub fn add(a: i32, b: i32) -> i32 { a + b }\n"
            "pub fn 加算(a: i32, b: i32) -> i32 {\n    a + b\n}\n"
        )
        (td / "tests/加算_test.rs").write_text(
            "#[test]\nfn 加算_works() { assert_eq!(加算(1,1), 2); }\n"
        )
        rep, _ = analyze(parse_patch(ugly), td, None, None)
        check("ugly LOCKED", rep.status == "LOCKED", f"{rep.status} {[h.path for h in rep.hunks]}")
        check("unicode bind", any("加算" in b for b in rep.bind), str(rep.bind))

    # docs-only → EMPTY
    docs = """diff --git a/README.md b/README.md
--- a/README.md
+++ b/README.md
@@ -1 +1 @@
-old
+new
"""
    with tempfile.TemporaryDirectory(prefix="twain-st-") as tmp:
        td = Path(tmp)
        (td / "README.md").write_text("new\n")
        rep, _ = analyze(parse_patch(docs), td, None, None)
        check("docs EMPTY", rep.status == "EMPTY", rep.status)

    # goldens are oracles
    check("golden path", path_role("data/fixtures/golden/x.expected.json") == "oracle")
    check("tests.rs path", path_role("src/hook/tests.rs") == "oracle")
    check("e2e path", path_role("tests/e2e/jsx-tsx.test.ts") == "oracle")
    check("prod path", path_role("src/language/js_ts.rs") == "source")
    check("plans ignore", path_role("plans/foo.md") == "ignore")
    check("OraclesGenerated", path_role("Tests/TenaoshiEngineTests/OraclesGenerated.swift") == "oracle")
    check("experiment fixture oracle", path_role("data/fixtures/experiments/x.experiment.json") == "oracle")
    check("generated ignore", path_role("packages/spec-artifacts/src/ids.generated.ts") == "ignore")
    check("scenario json oracle", path_role("data/fixtures/golden/foo.scenario.json") == "oracle")

    print(f"selftest: {passed} passed, {fails} failed")
    return 0 if fails == 0 else 1


