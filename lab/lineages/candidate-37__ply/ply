#!/usr/bin/env python3
"""ply — a patch as a bag of syntactic ply-edits.

A unified diff is a superposition. Project it onto one syntactic class
(number, string, comment, ident, key, kw, punct, import, text, space)
and emit the edit script of that projection.

Not a pretty-printer. Not difftastic. The object is the ply-edit:
(path, line, class, op, old, new).
"""
from __future__ import annotations

import argparse
import json
import re
import signal
import subprocess
import sys
import tempfile
import unicodedata
import unittest
from dataclasses import dataclass, field
from difflib import SequenceMatcher
from pathlib import Path
from typing import Sequence

VERSION = "0.2"

CLASSES = (
    "ident",
    "kw",
    "number",
    "string",
    "comment",
    "key",
    "import",
    "text",
    "punct",
    "space",
)
DEFAULT_CLASSES = ("ident", "kw", "number", "string", "comment", "key", "import", "text")
LOCK_BASENAMES = frozenset(
    {
        "Cargo.lock",
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "go.sum",
        "composer.lock",
        "Gemfile.lock",
        "poetry.lock",
        "Pipfile.lock",
        "flake.lock",
        "bun.lock",
        "bun.lockb",
    }
)
CLASS_SET = set(CLASSES)
OPS = ("chg", "del", "ins", "mov")

KEYWORDS = frozenset(
    """
    if else elif for while do return break continue yield
    fn def function class struct enum impl trait union
    let var const mut pub async await static
    import from use export include require package module mod
    true false none null nil True False None
    try except catch finally throw raise
    in is not and or
    match case switch default
    type interface where self Self this
    public private protected internal
    new delete sizeof typeof instanceof
    with as of from
    pass lambda
    crate super
    """.split()
)

PREPROCESSOR = frozenset(
    "include define undef ifdef ifndef endif pragma once line error warning".split()
)


# ---------------------------------------------------------------------------
# dialects
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class Dialect:
    name: str
    line_comment: tuple[str, ...] = ()
    block_comment: tuple[tuple[str, str], ...] = ()
    json_keys: bool = False
    hash_ok: bool = False
    triple: bool = False


def dialect_for(path: str) -> Dialect:
    name = path.replace("\\", "/").rsplit("/", 1)[-1]
    ext = name.lower()
    if "." in ext:
        ext = ext.rsplit(".", 1)[-1]
    else:
        ext = ext.lower()
    if name in {"Makefile", "makefile", "GNUmakefile", "Dockerfile"}:
        return Dialect("hash", line_comment=("#",), hash_ok=True)
    if ext in {"py", "pyi"}:
        return Dialect("python", line_comment=("#",), hash_ok=True, triple=True)
    if ext in {"sh", "bash", "zsh", "rb", "r", "pl", "ps1", "toml", "yml", "yaml", "mak", "mk", "cfg", "ini", "env", "gitignore", "dockerignore"}:
        return Dialect("hash", line_comment=("#",), hash_ok=True)
    if ext == "hs":
        return Dialect("haskell", line_comment=("--",), block_comment=(("{-", "-}"),))
    if ext in {"lua", "sql"}:
        return Dialect("dash", line_comment=("--",), block_comment=(("/*", "*/"),))
    if ext in {"html", "xml", "svg", "xhtml"}:
        return Dialect("html", block_comment=(("<!--", "-->"),))
    if ext in {"md", "markdown", "rst"}:
        return Dialect("md", block_comment=(("<!--", "-->"),))
    if ext in {"json"}:
        return Dialect("json", json_keys=True)
    if ext in {"jsonc", "json5"}:
        return Dialect("jsonc", line_comment=("//",), block_comment=(("/*", "*/"),), json_keys=True)
    if ext in {"rs", "c", "h", "cc", "hh", "cpp", "hpp", "go", "java", "js", "mjs", "cjs", "ts", "tsx", "jsx", "css", "scss", "swift", "kt", "kts", "scala", "cs", "m", "mm"}:
        return Dialect("c", line_comment=("//",), block_comment=(("/*", "*/"),))
    return Dialect("c", line_comment=("//",), block_comment=(("/*", "*/"),))


# ---------------------------------------------------------------------------
# lexer
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class Token:
    cls: str
    value: str
    line: int
    col: int


_IDENT = re.compile(r"[A-Za-z_$@][A-Za-z0-9_$@]*")
_NUMBER = re.compile(
    r"(?:"
    r"0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*"
    r"|0[bB][01](?:_?[01])*"
    r"|0[oO][0-7](?:_?[0-7])*"
    r"|\d+(?:_\d+)*(?:\.\d+(?:_\d+)*)?(?:[eE][+-]?\d+)?"
    r")"
)


def _starts(src: str, i: int, needle: str) -> bool:
    return src.startswith(needle, i)


def lex(src: str, dialect: Dialect, start_line: int = 1) -> list[Token]:
    out: list[Token] = []
    i = 0
    n = len(src)
    line = start_line
    col = 1
    line_start = True

    def emit(cls: str, val: str, at_line: int, at_col: int) -> None:
        if val == "":
            return
        out.append(Token(cls, val, at_line, at_col))

    def bump(k: int) -> None:
        nonlocal i, line, col, line_start
        for ch in src[i : i + k]:
            if ch == "\n":
                line += 1
                col = 1
                line_start = True
            else:
                col += 1
                if not ch.isspace():
                    line_start = False
        i += k

    while i < n:
        ch = src[i]
        sl, sc = line, col

        # newline / whitespace
        if ch.isspace():
            j = i
            while j < n and src[j].isspace():
                j += 1
            emit("space", src[i:j], sl, sc)
            bump(j - i)
            continue

        # block comments
        consumed = False
        for open_, close in dialect.block_comment:
            if _starts(src, i, open_):
                j = src.find(close, i + len(open_))
                if j < 0:
                    val = src[i:]
                    emit("comment", _comment_body(val, open_, close), sl, sc)
                    bump(len(val))
                else:
                    val = src[i : j + len(close)]
                    emit("comment", _comment_body(val, open_, close), sl, sc)
                    bump(len(val))
                consumed = True
                break
        if consumed:
            continue

        # line comments (not inside ident)
        for mark in dialect.line_comment:
            if _starts(src, i, mark):
                # C preprocessor: #include
                if mark == "#" and not dialect.hash_ok:
                    break
                j = src.find("\n", i)
                if j < 0:
                    j = n
                raw = src[i:j]
                emit("comment", raw[len(mark) :].strip(), sl, sc)
                bump(j - i)
                consumed = True
                break
        if consumed:
            continue

        # hash comments when dialect allows, already handled. C preprocessor:
        if ch == "#" and not dialect.hash_ok:
            # treat #ident as punct '#' + later ident, so include stays ident
            emit("punct", "#", sl, sc)
            bump(1)
            continue

        # triple / ordinary strings
        if dialect.triple and _starts(src, i, '"""'):
            tok, k = _read_triple(src, i, '"""')
            emit("string", tok, sl, sc)
            bump(k)
            continue
        if dialect.triple and _starts(src, i, "'''"):
            tok, k = _read_triple(src, i, "'''")
            emit("string", tok, sl, sc)
            bump(k)
            continue

        if ch in ("'", '"', "`"):
            tok, k = _read_string(src, i, ch)
            emit("string", tok, sl, sc)
            bump(k)
            continue

        # numbers (not glued to ident)
        m = _NUMBER.match(src, i)
        if m and not (i > 0 and (src[i - 1].isalnum() or src[i - 1] in "_$")):
            emit("number", m.group(0), sl, sc)
            bump(m.end() - i)
            continue

        # idents / keywords
        m = _IDENT.match(src, i)
        if m:
            val = m.group(0)
            cls = "kw" if val in KEYWORDS else "ident"
            emit(cls, val, sl, sc)
            bump(m.end() - i)
            continue

        # prose / CJK: letters that are not ASCII identifiers
        if ord(ch) > 127 and unicodedata.category(ch).startswith("L"):
            j = i + 1
            while j < n:
                cj = unicodedata.category(src[j])
                if cj.startswith("L") or cj in {"Mn", "Mc", "Lm"} or src[j] in "ー々〆ゝゞ":
                    j += 1
                else:
                    break
            emit("text", src[i:j], sl, sc)
            bump(j - i)
            continue

        # punctuation (group common multi-char ops as one punct)
        multi = (">>=", "<<=", "&&=", "||=", "...", "..=", "==", "!=", "<=", ">=",
                 "&&", "||", "->", "=>", "::", "<<", ">>", "++", "--", "+=", "-=",
                 "*=", "/=", "%=", "&=", "|=", "^=", "//")
        hit = None
        for op in multi:
            if _starts(src, i, op):
                # '//' is comment in c dialect and already handled; keep as punct otherwise
                if op == "//" and "//" in dialect.line_comment:
                    continue
                hit = op
                break
        if hit:
            emit("punct", hit, sl, sc)
            bump(len(hit))
            continue
        emit("punct", ch, sl, sc)
        bump(1)

    tagged = _tag_imports(out)
    if dialect.json_keys:
        tagged = _tag_json_keys(tagged)
    return tagged


def _comment_body(raw: str, open_: str, close: str) -> str:
    s = raw
    if s.startswith(open_):
        s = s[len(open_) :]
    if close and s.endswith(close):
        s = s[: -len(close)]
    return s.strip()


def _read_string(src: str, i: int, quote: str) -> tuple[str, int]:
    n = len(src)
    j = i + 1
    out = []
    while j < n:
        c = src[j]
        if c == "\\":
            if j + 1 < n:
                out.append(src[j : j + 2])
                j += 2
                continue
            out.append(c)
            j += 1
            continue
        if c == quote:
            body = "".join(out)
            return body, (j + 1 - i)
        if c == "\n" and quote != "`":
            # unterminated; take to newline (not including it)
            body = "".join(out)
            return body, (j - i)
        out.append(c)
        j += 1
    return "".join(out), (n - i)


def _read_triple(src: str, i: int, quote: str) -> tuple[str, int]:
    j = i + len(quote)
    k = src.find(quote, j)
    if k < 0:
        return src[j:], (len(src) - i)
    return src[j:k], (k + len(quote) - i)


_IMPORT_HEADS = frozenset({"import", "from", "use", "require", "include", "export", "mod"})


def _tag_imports(tokens: Sequence[Token]) -> list[Token]:
    """Retag string tokens on an import-shaped line as class 'import'."""
    # group by line
    by_line: dict[int, list[int]] = {}
    for idx, t in enumerate(tokens):
        by_line.setdefault(t.line, []).append(idx)
    out = list(tokens)
    for idxs in by_line.values():
        heads = [tokens[i] for i in idxs if tokens[i].cls != "space"]
        if not heads:
            continue
        h0 = heads[0]
        is_import = (h0.cls in {"kw", "ident"} and h0.value in _IMPORT_HEADS) or (
            h0.cls == "punct" and h0.value == "#" and len(heads) > 1 and heads[1].value in PREPROCESSOR
        )
        if not is_import:
            continue
        for i in idxs:
            if out[i].cls == "string":
                out[i] = Token("import", out[i].value, out[i].line, out[i].col)
    return out


def _tag_json_keys(tokens: Sequence[Token]) -> list[Token]:
    """A string immediately followed (ignoring space) by ':' is a JSON/YAML key."""
    out = list(tokens)
    n = len(out)
    for i, t in enumerate(out):
        if t.cls != "string":
            continue
        j = i + 1
        while j < n and out[j].cls == "space":
            j += 1
        if j < n and out[j].cls == "punct" and out[j].value == ":":
            out[i] = Token("key", t.value, t.line, t.col)
    return out


# ---------------------------------------------------------------------------
# unified diff parser
# ---------------------------------------------------------------------------

@dataclass
class Hunk:
    old_start: int
    new_start: int
    rows: list[tuple[str, str]]  # (' ','-','+','\\'), text without marker


@dataclass
class FileDiff:
    path: str  # new path, or old if deleted
    old_path: str
    hunks: list[Hunk] = field(default_factory=list)
    status: str = "modified"  # modified, added, deleted, binary


_HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def parse_unified(text: str) -> list[FileDiff]:
    files: list[FileDiff] = []
    cur: FileDiff | None = None
    hunk: Hunk | None = None
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("diff --git "):
            hunk = None
            parts = line.split()
            old = parts[2][2:] if len(parts) > 2 and parts[2].startswith("a/") else (parts[2] if len(parts) > 2 else "")
            new = parts[3][2:] if len(parts) > 3 and parts[3].startswith("b/") else (parts[3] if len(parts) > 3 else old)
            cur = FileDiff(path=new or old, old_path=old or new)
            files.append(cur)
            i += 1
            continue
        if line.startswith("Binary files ") or line.startswith("GIT binary patch"):
            if cur:
                cur.status = "binary"
            hunk = None
            i += 1
            continue
        if line.startswith("--- "):
            oldp = _strip_ab(line[4:])
            if cur is None:
                cur = FileDiff(path=oldp, old_path=oldp)
                files.append(cur)
            else:
                cur.old_path = oldp if oldp != "/dev/null" else cur.old_path
            if oldp == "/dev/null" and cur:
                cur.status = "added"
            i += 1
            continue
        if line.startswith("+++ "):
            newp = _strip_ab(line[4:])
            if cur is None:
                cur = FileDiff(path=newp, old_path=newp)
                files.append(cur)
            else:
                if newp != "/dev/null":
                    cur.path = newp
            if newp == "/dev/null" and cur:
                cur.status = "deleted"
            i += 1
            continue
        m = _HUNK_RE.match(line)
        if m:
            if cur is None:
                cur = FileDiff(path="?", old_path="?")
                files.append(cur)
            hunk = Hunk(old_start=int(m.group(1)), new_start=int(m.group(3)), rows=[])
            cur.hunks.append(hunk)
            i += 1
            continue
        if hunk is not None and line[:1] in {" ", "-", "+", "\\"}:
            tag = line[:1]
            body = line[1:] if tag != "\\" else line
            if tag == "\\":
                i += 1
                continue
            hunk.rows.append((tag, body))
            i += 1
            continue
        i += 1
    return files


def _strip_ab(s: str) -> str:
    s = s.strip()
    # timestamps after tab
    if "\t" in s:
        s = s.split("\t", 1)[0]
    if s.startswith("a/") or s.startswith("b/"):
        return s[2:]
    return s


def hunk_side(hunk: Hunk, minus: bool) -> tuple[str, int]:
    """Reconstruct one side of a hunk. Returns (text, start_line)."""
    parts: list[str] = []
    want = "-" if minus else "+"
    for tag, body in hunk.rows:
        if tag == " " or tag == want:
            parts.append(body)
    start = hunk.old_start if minus else hunk.new_start
    return "\n".join(parts), start


# ---------------------------------------------------------------------------
# ply-edits
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class Edit:
    path: str
    line: int
    cls: str
    op: str  # chg|del|ins|mov
    old: str
    new: str
    new_line: int = 0  # for mov, destination


def project_edits(old: Sequence[Token], new: Sequence[Token], path: str, classes: Sequence[str]) -> list[Edit]:
    edits: list[Edit] = []
    for cls in classes:
        a = [t for t in old if t.cls == cls]
        b = [t for t in new if t.cls == cls]
        edits.extend(_script(a, b, path, cls))
    return _collapse_moves(edits)


def _script(a: Sequence[Token], b: Sequence[Token], path: str, cls: str) -> list[Edit]:
    if not a and not b:
        return []
    sm = SequenceMatcher(a=[t.value for t in a], b=[t.value for t in b], autojunk=False)
    out: list[Edit] = []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            continue
        if tag == "delete":
            for t in a[i1:i2]:
                out.append(Edit(path, t.line, cls, "del", t.value, "", 0))
        elif tag == "insert":
            for t in b[j1:j2]:
                out.append(Edit(path, t.line, cls, "ins", "", t.value, t.line))
        elif tag == "replace":
            olds = list(a[i1:i2])
            news = list(b[j1:j2])
            n = min(len(olds), len(news))
            one_slot = len(olds) == 1 and len(news) == 1
            for k in range(n):
                if olds[k].value == news[k].value:
                    continue
                # 1-to-1 is a slot mutation (rename, magnitude). n-to-m
                # positional pairing of unrelated tokens is a rewrite: del+ins
                # unless the values actually look like the same entity.
                if cls == "number" or one_slot or _similar(olds[k].value, news[k].value, cls):
                    out.append(Edit(path, news[k].line, cls, "chg", olds[k].value, news[k].value, news[k].line))
                else:
                    out.append(Edit(path, olds[k].line, cls, "del", olds[k].value, "", 0))
                    out.append(Edit(path, news[k].line, cls, "ins", "", news[k].value, news[k].line))
            for t in olds[n:]:
                out.append(Edit(path, t.line, cls, "del", t.value, "", 0))
            for t in news[n:]:
                out.append(Edit(path, t.line, cls, "ins", "", t.value, t.line))
    return out


def _similar(a: str, b: str, cls: str) -> bool:
    if cls in {"kw", "punct", "space"}:
        return False
    if a == b:
        return True
    al, bl = a.lower(), b.lower()
    if al in bl or bl in al:
        return True
    if min(len(a), len(b)) >= 4 and SequenceMatcher(None, al, bl).ratio() >= 0.55:
        return True
    return False


def _collapse_moves(edits: list[Edit]) -> list[Edit]:
    """Pair equal-valued del+ins of the same class/path into mov."""
    kept: list[Edit] = []
    # index unused ins by (path, cls, value)
    unused_ins: dict[tuple[str, str, str], list[int]] = {}
    ins_list = [e for e in edits if e.op == "ins"]
    for idx, e in enumerate(ins_list):
        unused_ins.setdefault((e.path, e.cls, e.new), []).append(idx)
    used_ins = [False] * len(ins_list)
    consumed_del = [False] * len(edits)

    result: list[Edit] = []
    for i, e in enumerate(edits):
        if e.op != "del":
            continue
        key = (e.path, e.cls, e.old)
        bucket = unused_ins.get(key) or []
        found = None
        while bucket:
            j = bucket.pop(0)
            if not used_ins[j]:
                found = j
                break
        if found is None:
            continue
        used_ins[found] = True
        consumed_del[i] = True
        dest = ins_list[found]
        result.append(Edit(e.path, e.line, e.cls, "mov", e.old, dest.new, dest.line))

    used_ins_ids = {id(ins_list[j]) for j, u in enumerate(used_ins) if u}
    # id() of dataclasses is fine (not frozen equality)
    ins_used_idx = set(j for j, u in enumerate(used_ins) if u)

    for i, e in enumerate(edits):
        if e.op == "del":
            if not consumed_del[i]:
                result.append(e)
        elif e.op == "ins":
            # find which ins_list index this is — match by walking
            continue
        elif e.op in {"chg", "mov"}:
            result.append(e)

    # append unused ins, preserving order
    ins_cursor = 0
    for e in edits:
        if e.op != "ins":
            continue
        # this e corresponds to ins_list[ins_cursor]
        if ins_cursor not in ins_used_idx:
            result.append(e)
        ins_cursor += 1
    return result


def is_lock_path(path: str) -> bool:
    base = path.replace("\\", "/").rsplit("/", 1)[-1]
    if base in LOCK_BASENAMES:
        return True
    if base.endswith(".lock") or base.endswith("-lock.json") or base.endswith(".lockb"):
        return True
    return False


def edits_from_diff(
    files: Sequence[FileDiff],
    classes: Sequence[str],
    *,
    new_tokens: bool = False,
    locks: bool = False,
) -> list[Edit]:
    out: list[Edit] = []
    for fd in files:
        if fd.status == "binary":
            continue
        if not locks and is_lock_path(fd.path or fd.old_path):
            continue
        if not new_tokens and fd.status in {"added", "deleted"}:
            continue
        dialect = dialect_for(fd.path if fd.path != "/dev/null" else fd.old_path)
        for h in fd.hunks:
            old_txt, old_start = hunk_side(h, True)
            new_txt, new_start = hunk_side(h, False)
            old_toks = lex(old_txt, dialect, old_start)
            new_toks = lex(new_txt, dialect, new_start)
            out.extend(project_edits(old_toks, new_toks, fd.path, classes))
    return _collapse_moves(out)


def edits_from_texts(old: str, new: str, path: str, classes: Sequence[str]) -> list[Edit]:
    dialect = dialect_for(path)
    return project_edits(lex(old, dialect, 1), lex(new, dialect, 1), path, classes)


# ---------------------------------------------------------------------------
# filtering / checks
# ---------------------------------------------------------------------------

def parse_classes(spec: str | None) -> list[str]:
    if not spec:
        return list(DEFAULT_CLASSES)
    out = []
    for part in spec.split(","):
        p = part.strip().lower()
        if not p:
            continue
        if p in {"all"}:
            out.extend(CLASSES)
            continue
        if p in {"code", "src"}:
            out.extend(["ident", "kw", "number", "string", "key", "import", "punct"])
            continue
        if p in {"docs", "prose"}:
            out.extend(["comment", "text", "string"])
            continue
        if p not in CLASS_SET:
            raise SystemExit(f"ply: unknown class {p!r} (want {', '.join(CLASSES)}, all, code, docs)")
        out.append(p)
    # unique, original order
    seen = set()
    uniq = []
    for c in out:
        if c not in seen:
            seen.add(c)
            uniq.append(c)
    return uniq


_OP_RANK = {"chg": 0, "del": 1, "ins": 2, "mov": 3}


def visible(
    edits: Sequence[Edit],
    *,
    show_moves: bool,
    classes: Sequence[str],
    ops: Sequence[str] | None = None,
) -> list[Edit]:
    want = set(classes)
    want_ops = set(ops) if ops else {"chg", "del", "ins"}
    if show_moves:
        want_ops.add("mov")
    out = []
    for e in edits:
        if e.cls not in want:
            continue
        if e.op not in want_ops:
            continue
        out.append(e)
    out.sort(key=lambda e: (_OP_RANK.get(e.op, 9), e.path, e.line, e.cls))
    return out


# ---------------------------------------------------------------------------
# rendering
# ---------------------------------------------------------------------------

def _esc(s: str, width: int = 48) -> str:
    s = s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
    if len(s) > width:
        return s[: width - 1] + "…"
    return s


def render_human(
    edits: Sequence[Edit],
    counts: dict[str, int],
    origin: str,
    extra: Sequence[str] | None = None,
) -> str:
    n = len(edits)
    bits = [f"edits={n}"]
    for c in CLASSES:
        if counts.get(c):
            bits.append(f"{c}={counts[c]}")
    ops = {}
    for e in edits:
        ops[e.op] = ops.get(e.op, 0) + 1
    for op in OPS:
        if ops.get(op):
            bits.append(f"{op}={ops[op]}")
    if extra:
        bits.extend(extra)
    header = f"ply  {origin}  " + "  ".join(bits)
    if not edits:
        return header + "\n"
    path_w = max(4, max(len(e.path) for e in edits))
    rows = [header, f"{'PATH'.ljust(path_w)}  LINE  CLASS    OP   OLD  NEW"]
    for e in edits:
        old = _esc(e.old) if e.op != "ins" else ""
        new = _esc(e.new) if e.op != "del" else ""
        if e.op == "mov":
            new = f"→{e.new_line}"
            old = _esc(e.old)
        line = e.line
        rows.append(
            f"{e.path.ljust(path_w)}  {str(line).rjust(4)}  {e.cls.ljust(8)} {e.op.ljust(4)} {old}  {new}".rstrip()
        )
    return "\n".join(rows) + "\n"


def render_tsv(edits: Sequence[Edit]) -> str:
    rows = ["path\tline\tclass\top\told\tnew\tnew_line"]
    for e in edits:
        rows.append(
            "\t".join(
                [
                    e.path,
                    str(e.line),
                    e.cls,
                    e.op,
                    e.old.replace("\t", "\\t").replace("\n", "\\n"),
                    e.new.replace("\t", "\\t").replace("\n", "\\n"),
                    str(e.new_line),
                ]
            )
        )
    return "\n".join(rows) + "\n"


def render_json(edits: Sequence[Edit], counts: dict[str, int], origin: str) -> str:
    return json.dumps(
        {
            "origin": origin,
            "counts": counts,
            "edits": [
                {
                    "path": e.path,
                    "line": e.line,
                    "class": e.cls,
                    "op": e.op,
                    "old": e.old,
                    "new": e.new,
                    "new_line": e.new_line,
                }
                for e in edits
            ],
        },
        indent=2,
        ensure_ascii=False,
    ) + "\n"


def count_classes(edits: Sequence[Edit]) -> dict[str, int]:
    c = {k: 0 for k in CLASSES}
    for e in edits:
        c[e.cls] = c.get(e.cls, 0) + 1
    return c


def filter_diff_text(raw: str, files: Sequence[FileDiff], edits: Sequence[Edit]) -> str:
    """Keep hunks that contain at least one visible ply-edit (by new or old line)."""
    hit: dict[str, set[int]] = {}
    for e in edits:
        hit.setdefault(e.path, set()).add(e.line)
        if e.new_line:
            hit.setdefault(e.path, set()).add(e.new_line)
    # Also index old_path
    keep_files = set(hit)
    out_lines: list[str] = []
    # Re-emit from parsed structure (lossy for git headers, enough for apply-ish reading)
    for fd in files:
        lines_needed = hit.get(fd.path) or hit.get(fd.old_path)
        if not lines_needed:
            continue
        out_lines.append(f"diff --git a/{fd.old_path} b/{fd.path}")
        out_lines.append(f"--- a/{fd.old_path}")
        out_lines.append(f"+++ b/{fd.path}")
        for h in fd.hunks:
            old_ln = h.old_start
            new_ln = h.new_start
            interesting = False
            rebuilt: list[str] = []
            for tag, body in h.rows:
                if tag == " ":
                    if old_ln in lines_needed or new_ln in lines_needed:
                        interesting = True
                    rebuilt.append(" " + body)
                    old_ln += 1
                    new_ln += 1
                elif tag == "-":
                    if old_ln in lines_needed:
                        interesting = True
                    rebuilt.append("-" + body)
                    old_ln += 1
                elif tag == "+":
                    if new_ln in lines_needed:
                        interesting = True
                    rebuilt.append("+" + body)
                    new_ln += 1
            if interesting:
                out_lines.append(f"@@ -{h.old_start} +{h.new_start} @@")
                out_lines.extend(rebuilt)
    return "\n".join(out_lines) + ("\n" if out_lines else "")


# ---------------------------------------------------------------------------
# git / io
# ---------------------------------------------------------------------------

def git_diff(repo: str, args: list[str]) -> str:
    cmd = ["git", "-C", repo, "diff", "--no-color", "--no-ext-diff", *args]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode not in (0, 1):
        sys.stderr.write(p.stderr)
        raise SystemExit(p.returncode)
    return p.stdout


def read_input(path: str | None) -> str:
    if path and path != "-":
        return Path(path).read_text(encoding="utf-8", errors="replace")
    return sys.stdin.read()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="ply",
        description="Project a unified diff onto syntactic classes (ply-edits).",
    )
    p.add_argument("input", nargs="?", help="unified diff file, or - for stdin")
    p.add_argument("--git", nargs="*", metavar="ARG", help="run git diff ARG… (default: unstaged)")
    p.add_argument("--files", nargs=2, metavar=("OLD", "NEW"), help="compare two files")
    p.add_argument("-C", "--repo", default=".", help="git repo for --git")
    p.add_argument(
        "--class",
        dest="classes",
        default="",
        help="comma classes (default: ident,kw,number,string,comment,key,import,text). Also: code, docs, all",
    )
    p.add_argument("--op", default="", help="comma ops (default: chg,del,ins)")
    p.add_argument("--moves", action="store_true", help="show MOVE (same token, different line)")
    p.add_argument("--locks", action="store_true", help="include lockfiles (Cargo.lock, package-lock.json, …)")
    p.add_argument("--new-tokens", action="store_true", help="tokenize added/deleted files (default: skip bodies)")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--diff", action="store_true", help="emit a unified diff of only matching ply lines")
    p.add_argument("--check", action="store_true", help="exit 1 if any non-move matching edit exists")
    p.add_argument("--only", default="", help="with --check: fail if any non-move edit outside these classes")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="version", version=f"ply {VERSION}")
    return p


def run(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # Allow `ply --git` with no args, and `ply --git HEAD~1` without argparse eating input
    p = build_parser()
    args = p.parse_args(argv)
    if args.selftest:
        return 0 if _selftest() else 1

    classes = parse_classes(args.classes or None)
    ops = [x.strip() for x in args.op.split(",") if x.strip()] if args.op else None
    origin = "stdin"
    raw = ""
    file_edits: list[Edit] | None = None
    files: list[FileDiff] = []
    extra: list[str] = []

    if args.files:
        old = Path(args.files[0]).read_text(encoding="utf-8", errors="replace")
        new = Path(args.files[1]).read_text(encoding="utf-8", errors="replace")
        path = args.files[1]
        file_edits = edits_from_texts(old, new, path, CLASSES)
        origin = f"files {args.files[0]} {args.files[1]}"
        raw = ""
    elif args.git is not None:
        repo = args.repo
        gargs = list(args.git)
        raw = git_diff(repo, gargs)
        origin = "git " + (" ".join(gargs) if gargs else "(unstaged)")
        files = parse_unified(raw)
        file_edits = edits_from_diff(files, CLASSES, new_tokens=args.new_tokens, locks=args.locks)
    else:
        if args.input is None and sys.stdin.isatty():
            p.print_help()
            return 2
        raw = read_input(args.input)
        origin = args.input or "stdin"
        files = parse_unified(raw)
        file_edits = edits_from_diff(files, CLASSES, new_tokens=args.new_tokens, locks=args.locks)

    assert file_edits is not None
    if files:
        n_added = sum(1 for f in files if f.status == "added")
        n_deleted = sum(1 for f in files if f.status == "deleted")
        n_lock = sum(1 for f in files if is_lock_path(f.path or f.old_path))
        if n_added:
            extra.append(f"added={n_added}")
        if n_deleted:
            extra.append(f"deleted={n_deleted}")
        if n_lock and not args.locks:
            extra.append(f"skipped_lock={n_lock}")
    shown = visible(file_edits, show_moves=args.moves, classes=classes, ops=ops)
    counts = count_classes(shown)

    check_rc = 0
    if args.check:
        only = parse_classes(args.only) if args.only else None
        meaningful = [e for e in file_edits if e.op != "mov"]
        if only is not None:
            leaked = [e for e in meaningful if e.cls not in set(only)]
            check_rc = 1 if leaked else 0
        else:
            matched = [e for e in meaningful if e.cls in set(classes)]
            check_rc = 1 if matched else 0
        extra.append("FAIL" if check_rc else "OK")

    dump_rows = (not args.check) or args.json or args.tsv or args.diff
    if args.diff:
        if args.files:
            sys.stderr.write("ply: --diff needs a unified diff input\n")
            return 2
        sys.stdout.write(filter_diff_text(raw, files, shown))
    elif args.json:
        sys.stdout.write(render_json(shown, counts, origin))
    elif args.tsv:
        sys.stdout.write(render_tsv(shown))
    else:
        sys.stdout.write(render_human(shown if dump_rows else [], counts, origin, extra))
    return check_rc if args.check else 0


