def _selftest() -> bool:
    loader = unittest.TestLoader()
    suite = loader.loadTestsFromTestCase(PlyTests)
    result = unittest.TextTestRunner(verbosity=1).run(suite)
    return result.wasSuccessful()


def _edits(old: str, new: str, path: str = "x.rs", classes: Sequence[str] | None = None) -> list[Edit]:
    return edits_from_texts(old, new, path, list(classes or [c for c in CLASSES if c != "space"]))


def _ops(edits: Sequence[Edit], cls: str) -> list[tuple[str, str, str]]:
    return [(e.op, e.old, e.new) for e in edits if e.cls == cls and e.op != "mov"]


class PlyTests(unittest.TestCase):
    def test_number_only_change(self) -> None:
        e = _edits("timeout = 30\n", "timeout = 60\n")
        self.assertEqual(_ops(e, "number"), [("chg", "30", "60")])
        self.assertEqual(_ops(e, "ident"), [])
        self.assertEqual(_ops(e, "comment"), [])

    def test_comment_only_change(self) -> None:
        e = _edits("x = 1  // old default\n", "x = 1  // new default\n")
        self.assertEqual(_ops(e, "comment"), [("chg", "old default", "new default")])
        self.assertEqual(_ops(e, "number"), [])

    def test_mixed_line_splits_plies(self) -> None:
        e = _edits("timeout = 30  // seconds\n", "timeout = 60  // secs\n")
        self.assertEqual(_ops(e, "number"), [("chg", "30", "60")])
        self.assertEqual(_ops(e, "comment"), [("chg", "seconds", "secs")])
        self.assertEqual(_ops(e, "ident"), [])

    def test_ident_rename(self) -> None:
        e = _edits("fn foo() {}\n", "fn bar() {}\n")
        self.assertEqual(_ops(e, "ident"), [("chg", "foo", "bar")])
        self.assertEqual(_ops(e, "kw"), [])

    def test_string_not_comment(self) -> None:
        e = _edits('s = "// not a comment"\n', 's = "// still"\n', "x.js")
        self.assertEqual(_ops(e, "comment"), [])
        self.assertEqual(_ops(e, "string"), [("chg", "// not a comment", "// still")])

    def test_number_inside_string_is_string(self) -> None:
        e = _edits('s = "v30"\n', 's = "v60"\n')
        self.assertEqual(_ops(e, "number"), [])
        self.assertEqual(_ops(e, "string"), [("chg", "v30", "v60")])

    def test_whitespace_only_hidden(self) -> None:
        e = _edits("a=1\n", "a = 1\n")
        self.assertEqual(_ops(e, "ident"), [])
        self.assertEqual(_ops(e, "number"), [])
        self.assertEqual(_ops(e, "punct"), [])

    def test_hash_comment_python(self) -> None:
        e = _edits("x = 1  # old\n", "x = 1  # new\n", "x.py")
        self.assertEqual(_ops(e, "comment"), [("chg", "old", "new")])

    def test_c_hash_is_not_comment(self) -> None:
        e = _edits("#include <a.h>\n", "#include <b.h>\n", "x.c")
        self.assertEqual(_ops(e, "comment"), [])
        # <a.h> is punct + idents; at least include stays
        self.assertTrue(any(x.cls == "ident" and x.op == "chg" for x in e) or _ops(e, "ident") or _ops(e, "punct"))

    def test_json_key_vs_string(self) -> None:
        old = '{"timeout": 30, "msg": "a"}\n'
        new = '{"timeout": 60, "msg": "b"}\n'
        e = _edits(old, new, "c.json")
        self.assertEqual(_ops(e, "key"), [])
        self.assertEqual(_ops(e, "number"), [("chg", "30", "60")])
        self.assertEqual(_ops(e, "string"), [("chg", "a", "b")])

    def test_json_key_rename(self) -> None:
        e = _edits('{"a": 1}\n', '{"b": 1}\n', "c.json")
        self.assertEqual(_ops(e, "key"), [("chg", "a", "b")])
        self.assertEqual(_ops(e, "number"), [])

    def test_import_string_class(self) -> None:
        e = _edits('import "old/pkg"\n', 'import "new/pkg"\n', "x.go")
        self.assertEqual(_ops(e, "import"), [("chg", "old/pkg", "new/pkg")])
        self.assertEqual(_ops(e, "string"), [])

    def test_python_from_import(self) -> None:
        e = _edits("from foo import bar\n", "from foo import baz\n", "x.py")
        self.assertEqual(_ops(e, "ident"), [("chg", "bar", "baz")])

    def test_kw_insert_async(self) -> None:
