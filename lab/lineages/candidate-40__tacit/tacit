HELP = """tacit — who rides a default, who restates it, who overrides it.

  tacit -C <tree> [filter...]
  tacit -C <tree> --summary [filter...]
  tacit -C <tree> --git OLD NEW [filter...]
  tacit --selftest

Verdicts: TACIT (omitted) SHADOW (passed == default) OVERRIDE BOUND
Diff why: BLAST (tacit on a moved default) FOSSIL (still the old literal)
          PRE (already the new default) LOCK (other literal)

Exit: 0 ok, 1 --check found TACIT/BLAST, 2 error.
"""


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="tacit",
        description="Call-site relation to a default (TACIT/SHADOW/OVERRIDE/BOUND).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=HELP,
    )
    p.add_argument("-C", "--directory", default=".", help="tree to scan")
    p.add_argument("--git", nargs="+", metavar="REV", help="compare signatures OLD NEW (NEW defaults to worktree)")
    p.add_argument("--summary", action="store_true", help="counts per slot")
    p.add_argument("--json", action="store_true", help="JSON array")
    p.add_argument("--header", action="store_true", help="TSV header")
    p.add_argument(
        "--all",
        action="store_true",
        help="include OVERRIDE and BOUND (default: TACIT+SHADOW)",
    )
    p.add_argument(
        "--only",
        default="",
        help="comma verdicts (tacit,shadow,override,bound)",
    )
    p.add_argument("--why", default="", help="comma diff tags (blast,fossil,pre,lock,bound)")
    p.add_argument("--no-unfold", action="store_true", help="do not expand Foo() defaults")
    p.add_argument("--check", action="store_true", help="exit 1 if TACIT/BLAST remains")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("filter", nargs="*", help="AND substrings against callee/param/path")
    return p.parse_args(argv)


def kinds_from(ns: argparse.Namespace) -> set[str]:
    if ns.only:
        m = {
            "tacit": "TACIT",
            "shadow": "SHADOW",
            "override": "OVERRIDE",
            "bound": "BOUND",
        }
        out = set()
        for part in ns.only.split(","):
            part = part.strip().lower()
            if part in m:
                out.add(m[part])
            else:
                out.add(part.upper())
        return out
    if ns.all or ns.summary:
        return set()
    return {"TACIT", "SHADOW"}


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv and argv[0] in {"selftest", "--self-test"}:
        argv = ["--selftest"]
    ns = parse_args(argv)
    if ns.version:
        print(f"tacit {VERSION}")
        return 0
    if ns.selftest:
        return _selftest()

    root = str(Path(ns.directory).resolve())
    unfold = not ns.no_unfold
    diff_mode = False
    try:
        if ns.git is not None:
            if len(ns.git) == 0:
                print("tacit: --git needs OLD [NEW]", file=sys.stderr)
                return 2
            old_rev = ns.git[0]
            new_rev = ns.git[1] if len(ns.git) > 1 else None
            old_h = harvest_rev(root, old_rev)
            if new_rev:
                new_h = harvest_rev(root, new_rev)
            else:
                new_h = harvest_root(Path(root))
            rows = diff_rows(old_h, new_h, unfold=unfold)
            diff_mode = True
        else:
            h = harvest_root(Path(root))
            rows = classify_harvest(h, unfold=unfold)
    except RuntimeError as e:
        print(f"tacit: {e}", file=sys.stderr)
        return 2

    # relativize paths
    for r in rows:
        r.path = relpath(r.path, root)

    why = set()
    if ns.why:
        why = {w.strip().upper() for w in ns.why.split(",") if w.strip()}
    kinds = kinds_from(ns)
    rows = filter_rows(rows, ns.filter, kinds, why)
    rows.sort(key=lambda r: (r.callee, r.param, r.path, r.line, r.verdict))

    if ns.json:
        emit_json(rows, diff_mode)
    elif ns.summary:
        emit_summary(rows, diff_mode)
    else:
        emit_tsv(rows, ns.header, diff_mode)

    if ns.check:
        if diff_mode:
            if any(r.why == "BLAST" for r in rows):
                return 1
        elif any(r.verdict == "TACIT" for r in rows):
            return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
