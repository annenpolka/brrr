# ---------------------------------------------------------------------------
# signature extraction
# ---------------------------------------------------------------------------

def enclosing_type(prefix: str, lang: str) -> str | None:
    if lang == "swift":
        pat = rf"(?:struct|class|enum|actor|extension|protocol)\s+({IDENT})"
    elif lang == "py":
        pat = rf"class\s+({IDENT})"
    elif lang == "rs":
        pat = rf"(?:struct|enum|impl(?:\s*<[^>]*>)?)\s+({IDENT})"
    else:
        pat = rf"(?:class|interface|type|enum)\s+({IDENT})"
    last = None
    for m in re.finditer(pat, prefix):
        last = m.group(1)
    return last


def enclosing_variant(prefix: str) -> str | None:
    """Last Ident {{ before here — clap lives on enum variants, not the enum name."""
    last = None
    for m in re.finditer(rf"({IDENT})\s*\{{", prefix):
        last = m.group(1)
    if last in {
        "enum",
        "struct",
        "impl",
        "mod",
        "match",
        "if",
        "else",
        "for",
        "while",
        "unsafe",
        "pub",
    }:
        return None
    return last


def parse_swift_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk)
    if not chunk or chunk.startswith("@"):
        # attributes like @escaping may prefix; keep going
        chunk = re.sub(r"^(@[A-Za-z_]\w*(?:\([^)]*\))?\s*)+", "", chunk).strip()
    if not chunk:
        return None
    default = None
    # split default at depth-0 '='
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    # name: Type   or  ext int: Type  or  _ int: Type
    m = re.match(
        rf"(?:({IDENT}|_)\s+)?({IDENT})\s*:",
        chunk,
    )
    if not m:
        return None
    ext, name = m.group(1), m.group(2)
    if ext and ext != "_" and name:
        # external internal:  the *call* uses external label
        call_name = ext
    else:
        call_name = name
    if call_name == "_":
        call_name = name
    return Param(name=call_name, default=default, index=index)


def parse_py_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk).strip()
    if not chunk:
        return None
    if chunk.startswith("**") or chunk.startswith("*"):
        return None
    if chunk in {"self", "cls", "/", "*"}:
        return None
    if chunk.startswith("/") or chunk == "*":
        return None
    default = None
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    # drop annotation
    if ":" in chunk:
        name = chunk.split(":", 1)[0].strip()
    else:
        name = chunk.strip()
    if not re.fullmatch(IDENT, name) or name in {"self", "cls"}:
        return None
    return Param(name=name, default=default, index=index)


def parse_ts_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk).strip()
    if not chunk or chunk.startswith("..."):
        return None
    default = None
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    chunk = re.sub(r"[?:].*$", "", chunk).strip()
    chunk = chunk.lstrip("{").strip()
    if not re.fullmatch(IDENT, chunk):
        return None
    return Param(name=chunk, default=default, index=index)


def parse_params(inner: str, lang: str) -> list[Param]:
    out: list[Param] = []
    idx = 0
    for chunk in split_top(inner):
        if lang == "swift":
            p = parse_swift_param(chunk, idx)
        elif lang == "py":
            p = parse_py_param(chunk, idx)
        else:
            p = parse_ts_param(chunk, idx)
        if p:
            out.append(p)
            idx += 1
    return out


def extract_swift_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pat = re.compile(
        rf"{SWIFT_MOD}(func|init)\s*(?:<[^>\n]*>)?\s*({IDENT})?\s*\(",
        re.M,
    )
    for m in pat.finditer(masked):
        kind, name = m.group(1), m.group(2)
        open_idx = m.end() - 1
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = parse_params(inner, "swift")
        if kind == "init":
            callee = enclosing_type(masked[: m.start()], "swift")
            if not callee:
                continue
            skind = "init"
        else:
            callee = name
            if not callee:
                continue
            skind = "func"
        if not any(p.default is not None for p in params):
            continue
        sigs.append(
            Sig(
                callee=callee,
                params=params,
                path=path,
                line=line_at(src, m.start()),
                lang="swift",
                kind=skind,
                open_idx=open_idx,
            )
        )
    return sigs


def extract_py_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pat = re.compile(rf"(?:async\s+)?def\s+({IDENT})\s*\(", re.M)
    for m in pat.finditer(masked):
        name = m.group(1)
        open_idx = m.end() - 1
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = parse_params(inner, "py")
        kind = "func"
        callee = name
        if name == "__init__":
            cls = enclosing_type(masked[: m.start()], "py")
            if not cls:
                continue
            callee = cls
            kind = "init"
        if not any(p.default is not None for p in params):
            continue
        sigs.append(
            Sig(
                callee=callee,
                params=params,
                path=path,
                line=line_at(src, m.start()),
                lang="py",
                kind=kind,
                open_idx=open_idx,
            )
        )
    # dataclass fields
    for m in re.finditer(
        rf"@dataclass(?:\([^)]*\))?\s*\nclass\s+({IDENT})\s*(?:\([^)]*\))?\s*:",
        masked,
    ):
        cls = m.group(1)
        # body: until next class/def at column 0
        rest = src[m.end() :]
        params: list[Param] = []
        idx = 0
        for line in rest.splitlines():
            if re.match(r"^(class|def|async def)\b", line):
                break
            fm = re.match(
                rf"\s+({IDENT})\s*:\s*[^=\n]+?=\s*(.+?)\s*$",
                line,
            )
            if not fm:
                continue
            default = strip_line_comment(fm.group(2))
            params.append(Param(name=fm.group(1), default=default, index=idx))
            idx += 1
        if params:
            sigs.append(
                Sig(
                    callee=cls,
                    params=params,
                    path=path,
                    line=line_at(src, m.start()),
                    lang="py",
                    kind="class",
                )
            )
    return sigs


def extract_ts_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pats = [
        re.compile(rf"(?:export\s+)?(?:async\s+)?function\s+({IDENT})\s*(?:<[^>]*>)?\s*\("),
        re.compile(rf"(?:export\s+)?(?:const|let|var)\s+({IDENT})\s*=\s*(?:async\s+)?(?:<[^>]*>)?\("),
        re.compile(
            rf"(?:(?:public|private|protected|static|async|readonly)\s+)*(constructor)\s*\("
        ),
        # class/object methods with a default, but not every ident(
        re.compile(
            rf"(?:(?:public|private|protected|static|async|readonly)\s+)+({IDENT})\s*(?:<[^>]*>)?\s*\("
        ),
    ]
    seen_opens: set[int] = set()
    for pat in pats:
        for m in pat.finditer(masked):
            open_idx = m.end() - 1
            if open_idx in seen_opens:
                continue
            # constructor / method: skip control keywords
            name = m.group(1)
            if name in {
                "if",
                "for",
                "while",
                "switch",
                "catch",
                "function",
                "return",
                "await",
                "new",
            }:
                continue
            close = match_paren(src, open_idx)
            if close is None:
                continue
            inner = src[open_idx + 1 : close]
            params = parse_params(inner, "ts")
            if not any(p.default is not None for p in params):
                continue
            seen_opens.add(open_idx)
            callee = name
            kind = "func"
            if name == "constructor":
                cls = enclosing_type(masked[: m.start()], "ts")
                if not cls:
                    continue
                callee = cls
                kind = "init"
            sigs.append(
                Sig(
                    callee=callee,
                    params=params,
                    path=path,
                    line=line_at(src, m.start()),
                    lang="ts",
                    kind=kind,
                    open_idx=open_idx,
                )
            )
    return sigs


def extract_clap_sigs(src: str, masked: str, path: str) -> list[Sig]:
    """Rust clap #[arg(default_value = ...)] field → a defaulted slot.

    Structure is matched on the masked file (strings are spaces); the
    default *value* is read from the original, because it lives in a string.
    """
    sigs: list[Sig] = []
    pat = re.compile(
        r"#\[arg\((.*?)\)\]\s*(?:pub\s+)?(" + IDENT + r")\s*:",
        re.S,
    )
    for m in pat.finditer(masked):
        orig = src[m.start() : m.end()]
        field = m.group(2)
        dm = re.search(
            r'default_value(?:_t)?\s*=\s*("(?:\\.|[^"])*"|[A-Za-z0-9_.]+)',
            orig,
        )
        if not dm:
            continue
        default = dm.group(1)
        callee = enclosing_variant(masked[: m.start()]) or enclosing_type(
            masked[: m.start()], "rs"
        ) or field
        sigs.append(
            Sig(
                callee=callee,
                params=[Param(name=field, default=default, index=0)],
                path=path,
                line=line_at(src, m.start()),
                lang="rs",
                kind="clap",
            )
        )
    return sigs


def extract_sigs(src: str, path: str, lang: str) -> list[Sig]:
    masked = mask(src, lang)
    if lang == "swift":
        return extract_swift_sigs(src, masked, path)
    if lang == "py":
        return extract_py_sigs(src, masked, path)
    if lang == "rs":
        return extract_clap_sigs(src, masked, path)
    return extract_ts_sigs(src, masked, path)


# ---------------------------------------------------------------------------
# call extraction
# ---------------------------------------------------------------------------

def parse_call_args(inner: str, lang: str, params: list[Param]) -> tuple[dict[str, str], set[str]]:
    """Return (passed, bound)."""
    passed: dict[str, str] = {}
    bound: set[str] = set()
    chunks = split_top(inner)
    positional_names = [p.name for p in params]
    pos_i = 0
    for chunk in chunks:
        chunk = strip_line_comment(chunk)
        if not chunk:
            continue
        # keyword: name: value  (swift) or name = value (py/ts)
        kw = None
        val = None
        if lang == "swift":
            m = re.match(rf"({IDENT})\s*:\s*(.*)$", chunk, re.S)
            if m:
                kw, val = m.group(1), m.group(2).strip()
        else:
            m = re.match(rf"({IDENT})\s*=\s*(.*)$", chunk, re.S)
            if m:
                kw, val = m.group(1), m.group(2).strip()
        if kw is None:
            # positional
            if pos_i >= len(positional_names):
                continue
            # swift inits are labeled; a positional unlabeled arg is
            # almost always a comment residue or type-cast, not a call.
            if lang == "swift":
                continue
            kw = positional_names[pos_i]
            val = chunk
            pos_i += 1
        else:
            # keyword: consume this name; positional index skips past it
            if kw in positional_names:
                ni = positional_names.index(kw)
                if ni >= pos_i:
                    pos_i = ni + 1
        passed[kw] = val
        if not is_literal(val):
            bound.add(kw)
    return passed, bound


def find_calls(
    src: str,
    path: str,
    lang: str,
    callees: set[str],
    merged: dict[str, list[Param]],
    sig_opens: set[int] | None = None,
) -> list[Call]:
    if not callees:
        return []
    masked = mask(src, lang)
    names = sorted(callees, key=len, reverse=True)
    # longest-first so PresenceArbiter wins over Arbiter if both exist
    pat = re.compile(r"\b(" + "|".join(re.escape(n) for n in names) + r")\s*\(")
    role = role_of(path)
    calls: list[Call] = []
    opens = sig_opens or set()
    for m in pat.finditer(masked):
        name = m.group(1)
        open_idx = m.end() - 1
        if open_idx in opens:
            continue  # this paren belongs to the signature, not a call
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = merged.get(name, [])
        passed, bound = parse_call_args(inner, lang, params)
        # swift: require at least one labeled arg OR empty ()
        # unlabeled-only was filtered; empty is a real call (Thresholds())
        if lang == "swift" and inner.strip() and not passed:
            continue
        calls.append(
            Call(
                callee=name,
                passed=passed,
                bound=bound,
                path=path,
                line=line_at(src, m.start()),
                role=role,
            )
        )
    return calls


def kebab(name: str) -> str:
    return re.sub(r"(?<!^)(?=[A-Z])", "-", name).replace("_", "-").lower()


def clap_bound_token(val: str) -> bool:
    """Format/interpolation/path-expr tokens are BOUND, not OVERRIDE."""
    if not val:
        return True
    if val[0] in "{$\\":
        return True
    if "{" in val or "}" in val or "$" in val:
        return True
    if val.endswith("\\n") or "\\n" in val:
        return True
    return False


def pick_clap_callees(line: str, sigs: list[Sig]) -> list[Sig]:
    """Bind --flag on a line to the subcommand named on that line."""
    hits = []
    for s in sigs:
        kb = kebab(s.callee)
        if kb and kb in line.lower():
            hits.append(s)
    if hits:
        return hits
    if len(sigs) == 1:
        return sigs
    return []  # ambiguous: two clap slots share the flag, line names neither


def find_clap_uses(src: str, path: str, flags: dict[str, list[Sig]]) -> list[Call]:
    """Find --flag value mentions for clap slots."""
    if not flags:
        return []
    role = role_of(path)
    calls: list[Call] = []
    lines = src.splitlines()
    for field, sigs in flags.items():
        flag = field.replace("_", "-")
        pat = re.compile(
            rf"--{re.escape(flag)}(?:\s+|=)([^\s,;\"'`)\]}}]+)"
        )
        for m in pat.finditer(src):
            val = m.group(1).rstrip("\"',")
            if val.endswith("\\n") or val.endswith("\\t"):
                val = val[:-2]
            if not val or val.startswith(("'", '"')):
                continue
            line_no = line_at(src, m.start())
            line_txt = lines[line_no - 1] if 0 < line_no <= len(lines) else ""
            chosen = pick_clap_callees(line_txt, sigs)
            if not chosen:
                continue
            bound: set[str] = set()
            if clap_bound_token(val):
                passed_val = val
                bound.add(field)
            else:
                passed_val = val if val.startswith(("'", '"')) else f'"{val}"'
            for sig in chosen:
                calls.append(
                    Call(
                        callee=sig.callee,
                        passed={field: passed_val},
                        bound=set(bound),
                        path=path,
                        line=line_no,
                        role=role,
                    )
                )
        for sig in sigs:
            kb = kebab(sig.callee)
            tacit_pat = re.compile(
                rf"\b{re.escape(kb)}\b(?![^\n]*--{re.escape(flag)}\b)"
            )
            for m in tacit_pat.finditer(src):
                line = src.count("\n", 0, m.start())
                line_txt = lines[line] if line < len(lines) else ""
                # command-shaped only
                if "command:" not in line_txt and "kizu " not in line_txt.lower() and "$ " not in line_txt:
                    continue
                calls.append(
                    Call(
                        callee=sig.callee,
                        passed={},
                        bound=set(),
                        path=path,
                        line=line + 1,
                        role=role,
                    )
                )
    return calls


