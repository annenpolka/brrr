# ---------------------------------------------------------------------------

def _needle_is_path(n: str) -> bool:
    if "/" in n or n.startswith("."):
        return True
    lower = n.lower()
    return any(lower.endswith(ext) for ext in CODE_EXTS)


def filter_rows(rows: list[Row], needles: list[str], kinds: set[str], why: set[str]) -> list[Row]:
    out = []
    for r in rows:
        if kinds and r.verdict not in kinds:
            continue
        if why and r.why not in why:
            continue
        ok = True
        for n in needles:
            nl = n.lower()
            if _needle_is_path(n):
                if nl not in r.path.lower():
                    ok = False
                    break
            else:
                if nl not in r.callee.lower() and nl not in r.param.lower():
                    ok = False
                    break
        if not ok:
            continue
        out.append(r)
    return out


def emit_tsv(rows: list[Row], header: bool, diff: bool) -> None:
    cols = ["verdict", "role", "callee", "param", "default", "passed", "file", "line"]
    if diff:
        cols = ["why"] + cols
    if header:
        print("\t".join(cols))
    for r in rows:
        rec = [
            r.verdict,
            r.role,
            r.callee,
            r.param,
            r.default.replace("\t", " ").replace("\n", " "),
            r.passed.replace("\t", " ").replace("\n", " "),
            r.path,
            str(r.line),
        ]
        if diff:
            rec = [r.why or ""] + rec
        print("\t".join(rec))


def emit_json(rows: list[Row], diff: bool) -> None:
    payload = []
    for r in rows:
        d = {
            "verdict": r.verdict,
            "role": r.role,
            "callee": r.callee,
            "param": r.param,
            "default": r.default,
            "passed": None if r.passed == "—" else r.passed,
            "file": r.path,
            "line": r.line,
        }
        if diff:
            d["why"] = r.why
        payload.append(d)
    json.dump(payload, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")


def emit_summary(rows: list[Row], diff: bool) -> None:
    from collections import Counter

    if diff:
        c = Counter(r.why for r in rows)
        print("why\tcount")
        for k in ("BLAST", "FOSSIL", "PRE", "LOCK", "BOUND", "DIED"):
            if c[k]:
                print(f"{k}\t{c[k]}")
        # per-slot
        slot: dict[tuple[str, str], Counter] = {}
        for r in rows:
            slot.setdefault((r.callee, r.param), Counter())[r.why] += 1
        if slot:
            print("callee\tparam\tBLAST\tFOSSIL\tPRE\tLOCK\tBOUND")
            for (callee, param), cc in sorted(slot.items()):
                print(
                    f"{callee}\t{param}\t{cc['BLAST']}\t{cc['FOSSIL']}\t"
                    f"{cc['PRE']}\t{cc['LOCK']}\t{cc['BOUND']}"
                )
        return
    slot = {}
    for r in rows:
        key = (r.callee, r.param, r.default)
        slot.setdefault(key, Counter())[r.verdict] += 1
    print("callee\tparam\tdefault\tTACIT\tSHADOW\tOVERRIDE\tBOUND")
    for (callee, param, default), cc in sorted(slot.items()):
        print(
            f"{callee}\t{param}\t{default.replace(chr(9), ' ')}\t"
            f"{cc['TACIT']}\t{cc['SHADOW']}\t{cc['OVERRIDE']}\t{cc['BOUND']}"
        )


