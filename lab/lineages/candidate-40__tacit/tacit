def classify_call(call: Call, params: list[Param]) -> list[Row]:
    rows: list[Row] = []
    defaultable = [p for p in params if p.default is not None]
    for p in defaultable:
        default = p.default or ""
        if p.name not in call.passed:
            verdict = "TACIT"
            passed = "—"
        elif p.name in call.bound:
            verdict = "BOUND"
            passed = call.passed[p.name]
        elif values_equal(call.passed[p.name], default):
            verdict = "SHADOW"
            passed = call.passed[p.name]
        else:
            verdict = "OVERRIDE"
            passed = call.passed[p.name]
        rows.append(
            Row(
                verdict=verdict,
                role=call.role,
                callee=call.callee,
                param=p.name,
                default=default,
                passed=passed,
                path=call.path,
                line=call.line,
            )
        )
    return rows


def unfold_rows(rows: list[Row], merged: dict[str, list[Param]]) -> list[Row]:
    """A TACIT slot whose default is Foo() also rides Foo's defaults."""
    extra: list[Row] = []
    for r in rows:
        if r.verdict != "TACIT":
            continue
        ctor = ctor_name(r.default)
        if not ctor or ctor not in merged:
            continue
        for p in merged[ctor]:
            if p.default is None:
                continue
            extra.append(
                Row(
                    verdict="TACIT",
                    role=r.role,
                    callee=r.callee,
                    param=f"{r.param}.{p.name}",
                    default=p.default,
                    passed="—",
                    path=r.path,
                    line=r.line,
                )
            )
    return rows + extra


def classify_harvest(h: Harvest, unfold: bool) -> list[Row]:
    merged = h.merged_params()
    rows: list[Row] = []
    for c in h.calls:
        params = merged.get(c.callee, [])
        if not params:
            continue
        rows.extend(classify_call(c, params))
    if unfold:
        rows = unfold_rows(rows, merged)
    return rows


def pair_renames(old: list[Param], new: list[Param]) -> dict[str, str]:
    """Map new-param-name → old-param-name when a defaulted slot kept its
    position but changed identity (threshold → presentThreshold)."""
    mapping: dict[str, str] = {}
    old_by_i = {p.index: p for p in old}
    new_names = {p.name for p in new}
    old_names = {p.name for p in old}
    for p in new:
        if p.name in old_names:
            mapping[p.name] = p.name
            continue
        cand = old_by_i.get(p.index)
        if (
            cand
            and cand.name not in new_names
            and cand.default is not None
            and p.default is not None
        ):
            mapping[p.name] = cand.name
    return mapping


def diff_rows(
    old_h: Harvest,
    new_h: Harvest,
    unfold: bool,
) -> list[Row]:
    old_m = old_h.merged_params()
    new_m = new_h.merged_params()
    rows = classify_harvest(new_h, unfold=unfold)
    # defaults per (callee, param)
    def defmap(m: dict[str, list[Param]]) -> dict[tuple[str, str], str | None]:
        out: dict[tuple[str, str], str | None] = {}
        for callee, params in m.items():
            for p in params:
                out[(callee, p.name)] = p.default
        return out

    old_d = defmap(old_m)
    new_d = defmap(new_m)
    rename: dict[tuple[str, str], str] = {}  # (callee, new_name) -> old_name
    for callee, params in new_m.items():
        if callee not in old_m:
            continue
        mapping = pair_renames(old_m[callee], params)
        for new_n, old_n in mapping.items():
            if new_n != old_n:
                rename[(callee, new_n)] = old_n

    tagged: list[Row] = []
    for r in rows:
        # unfold params: look at the leaf ctor? treat as nested; skip rename
        key = (r.callee, r.param.split(".")[0] if "." in r.param else r.param)
        # for unfolded, why follows the parent slot's default change only
        # if the parent ctor default itself moved. Usually Thresholds() is stable.
        param = r.param
        leaf = param.split(".")[-1]
        old_name = rename.get((r.callee, param), param)
        if "." in param:
            old_val = old_d.get((ctor_name(r.default) or "", leaf))
            # unfolded: compare inner default across trees
            parent = param.split(".")[0]
            ctor = ctor_name(
                next(
                    (
                        p.default
                        for p in new_m.get(r.callee, [])
                        if p.name == parent
                    ),
                    r.default,
                )
                or r.default
            )
            old_val = old_d.get((ctor or "", leaf)) if ctor else None
            new_val = new_d.get((ctor or "", leaf)) if ctor else r.default
        else:
            old_val = old_d.get((r.callee, old_name))
            if old_val is None and old_name != param:
                old_val = old_d.get((r.callee, old_name))
            new_val = new_d.get((r.callee, param))

        changed = (old_val is not None and new_val is not None and not values_equal(str(old_val), str(new_val)))
        born = old_val is None and new_val is not None
        died = old_val is not None and new_val is None
        if not (changed or born or died) and old_name == param:
            continue  # stable slot: omit from diff view
        why = ""
        if r.verdict == "TACIT" and (changed or born):
            why = "BLAST"
        elif r.verdict in {"SHADOW", "OVERRIDE"} and old_val is not None and values_equal(r.passed, str(old_val)):
            why = "FOSSIL"
        elif r.verdict == "SHADOW" and (changed or born):
            why = "PRE"
        elif r.verdict == "OVERRIDE" and (changed or born):
            why = "LOCK"
        elif r.verdict == "BOUND" and (changed or born):
            why = "BOUND"
        elif died:
            why = "DIED"
        else:
            why = "BLAST" if r.verdict == "TACIT" else r.verdict
        rr = Row(**{**r.__dict__, "why": why})
        if changed and old_val is not None:
            rr.default = f"{old_val}→{new_val}"
        tagged.append(rr)
    return tagged


