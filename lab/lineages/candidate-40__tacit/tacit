def _selftest() -> int:
    import tempfile

    fails: list[str] = []

    def check(name: str, cond: bool, detail: str = "") -> None:
        if cond:
            print(f"  ok  {name}")
        else:
            fails.append(name)
            print(f"  FAIL {name} {detail}", file=sys.stderr)

    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        (root / "arbiter.swift").write_text(SWIFT_FIX)
        (root / "box.py").write_text(PY_FIX)
        (root / "cli.rs").write_text(RS_FIX)
        (root / "retry.ts").write_text(TS_FIX)
        h = harvest_root(root)
        rows = classify_harvest(h, unfold=True)
        def sel(callee, param, verdict=None):
            out = [
                r
                for r in rows
                if r.callee == callee and r.param == param and (verdict is None or r.verdict == verdict)
            ]
            return out

        # swift TACIT omitted presentThreshold
        check(
            "swift tacit presentThreshold",
            any(r.verdict == "TACIT" and r.line > 0 for r in sel("PresenceArbiter", "presentThreshold")),
        )
        # SHADOW restates 0.45
        check(
            "swift shadow presentThreshold 0.45",
            any(r.verdict == "SHADOW" for r in sel("PresenceArbiter", "presentThreshold")),
        )
        # OVERRIDE 0.50
        check(
            "swift override presentThreshold 0.50",
            any(r.verdict == "OVERRIDE" and "0.50" in r.passed for r in sel("PresenceArbiter", "presentThreshold")),
        )
        # BOUND frameProvider
        check(
            "swift bound frameProvider",
            any(r.verdict == "BOUND" for r in sel("PresenceArbiter", "frameProvider")),
        )
        # comment residue is not a call
        comment_hits = [
            r
            for r in rows
            if r.callee == "PresenceArbiter" and "SitboneCore" in (r.passed or "")
        ]
        check("swift ignores comment residue", not comment_hits)
        # Thresholds() all tacit
        check(
            "swift Thresholds() tacit driftDelay",
            any(r.verdict == "TACIT" for r in sel("Thresholds", "driftDelay")),
        )
        check(
            "swift Thresholds(driftDelay: 15) shadow",
            any(r.verdict == "SHADOW" for r in sel("Thresholds", "driftDelay")),
        )
        check(
            "swift Thresholds(driftDelay: 20) override",
            any(r.verdict == "OVERRIDE" for r in sel("Thresholds", "driftDelay")),
        )
        # unfold SessionProfile → thresholds.driftDelay
        check(
            "unfold SessionProfile.thresholds.driftDelay tacit",
            any(
                r.param == "thresholds.driftDelay" and r.verdict == "TACIT"
                for r in rows
                if r.callee == "SessionProfile"
            ),
        )
        check(
            "shadow colorHue 0.45 on make-like call",
            any(r.verdict == "SHADOW" for r in sel("SessionProfile", "colorHue")),
        )
        check(
            "tacit colorHue on SessionProfile(name:)",
            any(r.verdict == "TACIT" for r in sel("SessionProfile", "colorHue")),
        )

        # python
        check("py greet tacit greeting", any(r.verdict == "TACIT" for r in sel("greet", "greeting")))
        check("py greet override greeting", any(r.verdict == "OVERRIDE" for r in sel("greet", "greeting")))
        check("py greet override times", any(r.verdict == "OVERRIDE" and r.passed.strip() == "2" for r in sel("greet", "times")))
        check("py Box shadow height", any(r.verdict == "SHADOW" for r in sel("Box", "height")))
        check("py Box override height", any(r.verdict == "OVERRIDE" for r in sel("Box", "height")))
        check("py Cfg tacit timeout", any(r.verdict == "TACIT" for r in sel("Cfg", "timeout")))
        check("py Cfg shadow timeout", any(r.verdict == "SHADOW" for r in sel("Cfg", "timeout")))
        check("py Cfg override timeout", any(r.verdict == "OVERRIDE" for r in sel("Cfg", "timeout")))

        # clap: two variants share --agent; bind by subcommand on the line
        check(
            "clap shadow claude-code on HookPostTool",
            any(r.verdict == "SHADOW" for r in sel("HookPostTool", "agent")),
        )
        check(
            "clap override cursor on HookStop not PostTool",
            any(r.verdict == "OVERRIDE" for r in sel("HookStop", "agent"))
            and not any(r.verdict == "OVERRIDE" for r in sel("HookPostTool", "agent")),
        )
        check(
            "clap interpolation is BOUND",
            any(r.verdict == "BOUND" for r in sel("HookPostTool", "agent")),
        )

        # signature is not a call (returningToFinal: Bool = true)
        check(
            "signature of reopenUnit is not a call",
            not any("Bool" in r.passed for r in sel("reopenUnit", "returningToFinal")),
        )
        check(
            "reopenUnit tacit at call site",
            any(r.verdict == "TACIT" for r in sel("reopenUnit", "returningToFinal")),
        )
        check(
            "reopenUnit shadow at call site",
            any(r.verdict == "SHADOW" for r in sel("reopenUnit", "returningToFinal")),
        )

        # filter matches callee/param, not path (SensorReading lives in same file)
        filtered = filter_rows(rows, ["PresenceArbiter"], set(), set())
        check(
            "filter PresenceArbiter ignores SensorReading in same file",
            not any(r.callee == "SensorReading" for r in filtered)
            and any(r.callee == "PresenceArbiter" for r in filtered),
        )

        # ts
        check("ts retry tacit attempts", any(r.verdict == "TACIT" for r in sel("retry", "attempts")))
        check("ts retry shadow attempts", any(r.verdict == "SHADOW" for r in sel("retry", "attempts")))
        check("ts retry override attempts", any(r.verdict == "OVERRIDE" for r in sel("retry", "attempts")))

        # diff: presentThreshold 0.45 → 0.50 should BLAST tacit callers
        old = SWIFT_FIX
        new = SWIFT_FIX.replace(
            "presentThreshold: Double = 0.45",
            "presentThreshold: Double = 0.50",
        )
        old_h = harvest_texts([("a.swift", old, "swift")])
        new_h = harvest_texts([("a.swift", new, "swift")])
        drows = diff_rows(old_h, new_h, unfold=True)
        blast = [r for r in drows if r.why == "BLAST" and r.param == "presentThreshold"]
        fossil = [
            r
            for r in drows
            if r.why == "FOSSIL" and r.param == "presentThreshold"
        ]
        check("diff BLAST tacit riders", len(blast) >= 1)
        check(
            "diff FOSSIL restated 0.45",
            any("0.45" in r.passed for r in fossil),
        )

        # rename threshold → presentThreshold at same index
        old_r = """
public final class PresenceArbiter {
    public init(sensors: [String], threshold: Double = 0.4, emaAlpha: Double = 0.3) {}
}
public func seed() {
    let a = PresenceArbiter(sensors: ["camera"])
    let b = PresenceArbiter(sensors: ["camera"], threshold: 0.4)
}
"""
        new_r = """
public final class PresenceArbiter {
    public init(sensors: [String], presentThreshold: Double = 0.45, emaAlpha: Double = 0.3) {}
}
public func seed() {
    let a = PresenceArbiter(sensors: ["camera"])
    let b = PresenceArbiter(sensors: ["camera"], presentThreshold: 0.4)
}
"""
        d2 = diff_rows(
            harvest_texts([("a.swift", old_r, "swift")]),
            harvest_texts([("a.swift", new_r, "swift")]),
            unfold=True,
        )
        check(
            "rename BLAST tacit on presentThreshold",
            any(r.why == "BLAST" and r.param == "presentThreshold" for r in d2),
        )
        check(
            "rename FOSSIL still passes 0.4",
            any(r.why == "FOSSIL" and r.param == "presentThreshold" for r in d2),
        )

    if fails:
        print(f"selftest: {len(fails)} failed", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


