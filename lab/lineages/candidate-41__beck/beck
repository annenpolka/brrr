# ---------------------------------------------------------------------------
# Pipeline cuts
# ---------------------------------------------------------------------------


def peel_merge_stderr(cmd: str) -> tuple[str, bool]:
    """Strip trailing `2>&1` (repeatable). Leave quoted occurrences alone."""
    s = cmd.strip()
    merge = False
    while True:
        t = s.rstrip()
        if t.endswith("2>&1") and (len(t) == 4 or t[-5].isspace()):
            s = t[:-4].rstrip()
            merge = True
            continue
        break
    return s, merge


def split_pipeline(src: str) -> list[tuple[str, bool]]:
    """Cut on top-level `|` and `|&`. Do not cut `||`, quoted `|`, or `|` inside $() ${} () ``."""
    s = src.strip()
    if not s:
        raise ValueError("empty pipeline")
    stages: list[tuple[str, bool]] = []
    buf: list[str] = []
    i = 0
    n = len(s)
    quote: str | None = None
    paren = 0
    brace = 0
    backtick = False

    def peek(k: int = 1) -> str:
        j = i + k
        return s[j] if j < n else ""

    while i < n:
        c = s[i]
        if quote:
            buf.append(c)
            if quote == "'" and c == "'":
                quote = None
            elif quote == '"':
                if c == "\\" and i + 1 < n:
                    buf.append(s[i + 1])
                    i += 2
                    continue
                if c == '"':
                    quote = None
            i += 1
            continue
        if backtick:
            buf.append(c)
            if c == "\\" and i + 1 < n:
                buf.append(s[i + 1])
                i += 2
                continue
            if c == "`":
                backtick = False
            i += 1
            continue
        if c in "'\"":
            quote = c
            buf.append(c)
            i += 1
            continue
        if c == "`":
            backtick = True
            buf.append(c)
            i += 1
            continue
        if c == "$" and peek() == "(":
            paren += 1
            buf.append("$(")
            i += 2
            continue
        if c == "$" and peek() == "{":
            brace += 1
            buf.append("${")
            i += 2
            continue
        if c == "(":
            paren += 1
            buf.append(c)
            i += 1
            continue
        if c == ")" and paren:
            paren -= 1
            buf.append(c)
            i += 1
            continue
        if c == "{":
            buf.append(c)
            i += 1
            continue
        if c == "}" and brace:
            brace -= 1
            buf.append(c)
            i += 1
            continue
        nested = paren or brace
        if not nested and c == "|":
            nxt = peek()
            if nxt == "|":
                buf.append("||")
                i += 2
                continue
            cmd = "".join(buf).strip()
            if not cmd:
                raise ValueError("empty pipeline stage")
            if nxt == "&":
                stages.append((cmd, True))
                buf = []
                i += 2
                continue
            stages.append((cmd, False))
            buf = []
            i += 1
            continue
        buf.append(c)
        i += 1

    if quote:
        raise ValueError("unclosed quote in pipeline")
    if backtick:
        raise ValueError("unclosed backtick in pipeline")
    cmd = "".join(buf).strip()
    if cmd:
        stages.append((cmd, False))
    if not stages:
        raise ValueError("empty pipeline")

    out: list[tuple[str, bool]] = []
    for cmd, amp in stages:
        cmd2, merge = peel_merge_stderr(cmd)
        if not cmd2:
            raise ValueError("empty pipeline stage after peeling 2>&1")
        out.append((cmd2, amp or merge))
    return out


def split_plus(args: list[str]) -> list[str] | None:
    if "+" not in args:
        return None
    stages: list[str] = []
    cur: list[str] = []
    for a in args:
        if a == "+":
            cmd = " ".join(cur).strip()
            if not cmd:
                raise ValueError("empty + stage")
            stages.append(cmd)
            cur = []
        else:
            cur.append(a)
    cmd = " ".join(cur).strip()
    if not cmd:
        raise ValueError("empty + stage")
    stages.append(cmd)
    return stages


