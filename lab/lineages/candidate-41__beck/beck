# Run / record
# ---------------------------------------------------------------------------


@dataclass
class StageRec:
    i: int
    argv: str
    merge_stderr: bool
    stdout: bytes = b""
    stderr: bytes = b""
    piped: bytes = b""
    exit: int | None = None
    duration_s: float = 0.0


class _Closer:
    def __init__(self, fp: BinaryIO | None, n: int) -> None:
        self.fp = fp
        self.n = n
        self.lock = threading.Lock()

    def done(self) -> None:
        with self.lock:
            self.n -= 1
            if self.n <= 0 and self.fp is not None:
                try:
                    self.fp.close()
                except OSError:
                    pass
                self.fp = None


def _pump(
    src: BinaryIO | None,
    records: list[bytearray],
    record_lock: threading.Lock,
    writes: list[BinaryIO],
    closer: _Closer | None,
) -> None:
    try:
        if src is None:
            return
        while True:
            chunk = src.read(65536)
            if not chunk:
                break
            with record_lock:
                for rec in records:
                    rec.extend(chunk)
            dead: list[BinaryIO] = []
            for w in writes:
                try:
                    w.write(chunk)
                    w.flush()
                except BrokenPipeError:
                    dead.append(w)
                except OSError:
                    dead.append(w)
            for w in dead:
                writes.remove(w)
    finally:
        try:
            if src is not None:
                src.close()
        except OSError:
            pass
        if closer is not None:
            closer.done()


def _kill_pg(p: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            p.kill()
        except OSError:
            pass


def _feed_stdin(fp: BinaryIO, data: bytes) -> None:
    try:
        fp.write(data)
        fp.flush()
    except BrokenPipeError:
        pass
    finally:
        try:
            fp.close()
        except OSError:
            pass


def run_pipeline(
    specs: list[tuple[str, bool]],
    *,
    cwd: str | None = None,
    timeout: float | None = 60.0,
    passthrough: bool = False,
    stdin_data: bytes | None = None,
    forward_stderr: bool = True,
) -> list[StageRec]:
    n = len(specs)
    if n == 0:
        raise ValueError("no stages")
    procs: list[subprocess.Popen[bytes]] = []
    try:
        for i, (cmd, _merge) in enumerate(specs):
            use_stdin = i > 0 or stdin_data is not None
            p = subprocess.Popen(
                ["bash", "-c", cmd],
                stdin=subprocess.PIPE if use_stdin else subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                cwd=cwd,
                start_new_session=True,
            )
            procs.append(p)
    except OSError:
        for p in procs:
            try:
                p.kill()
            except OSError:
                pass
        raise

    rec_out = [bytearray() for _ in range(n)]
    rec_err = [bytearray() for _ in range(n)]
    rec_pipe = [bytearray() for _ in range(n)]
    locks = [threading.Lock() for _ in range(n)]
    threads: list[threading.Thread] = []
    t0 = time.monotonic()

    try:
        for i, p in enumerate(procs):
            merge = specs[i][1]
            next_in = procs[i + 1].stdin if i + 1 < n else None
            stdout_writes: list[BinaryIO] = []
            stderr_writes: list[BinaryIO] = []
            n_writers = 0
            if next_in is not None:
                stdout_writes.append(next_in)
                n_writers += 1
                if merge:
                    stderr_writes.append(next_in)
                    n_writers += 1
            elif passthrough:
                stdout_writes.append(sys.stdout.buffer)
                if merge:
                    stderr_writes.append(sys.stdout.buffer)
            if not merge and forward_stderr:
                stderr_writes.append(sys.stderr.buffer)

            closer = _Closer(next_in, n_writers) if next_in is not None else None
            out_recs: list[bytearray] = [rec_out[i], rec_pipe[i]]
            err_recs: list[bytearray] = [rec_err[i]]
            if merge:
                err_recs.append(rec_pipe[i])

            threads.append(
                threading.Thread(
                    target=_pump,
                    args=(p.stdout, out_recs, locks[i], stdout_writes, closer),
                    daemon=True,
                )
            )
            threads.append(
                threading.Thread(
                    target=_pump,
                    args=(p.stderr, err_recs, locks[i], stderr_writes, closer if merge else None),
                    daemon=True,
                )
            )

        for t in threads:
            t.start()

        if stdin_data is not None and procs[0].stdin is not None:
            feed = threading.Thread(
                target=_feed_stdin, args=(procs[0].stdin, stdin_data), daemon=True
            )
            feed.start()
            threads.append(feed)

        deadline = None if timeout is None else (t0 + timeout)
        for p in procs:
            remain = None if deadline is None else max(0.01, deadline - time.monotonic())
            try:
                p.wait(timeout=remain)
            except subprocess.TimeoutExpired:
                for q in procs:
                    _kill_pg(q)
                raise TimeoutError(f"pipeline exceeded {timeout}s") from None
        for t in threads:
            t.join(timeout=5.0)
    finally:
        for p in procs:
            if p.poll() is None:
                _kill_pg(p)

    dt = time.monotonic() - t0
    recs: list[StageRec] = []
    for i, (cmd, merge) in enumerate(specs):
        recs.append(
            StageRec(
                i=i,
                argv=cmd,
                merge_stderr=merge,
                stdout=bytes(rec_out[i]),
                stderr=bytes(rec_err[i]),
                piped=bytes(rec_pipe[i]),
                exit=procs[i].returncode,
                duration_s=dt,
            )
        )
    return recs


