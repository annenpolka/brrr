CARGO_PASS = """
running 3 tests
test app::tests::alpha ... ok
test app::tests::beta ... ok
test app::tests::skippy ... ignored
test result: ok. 2 passed; 0 failed; 1 ignored
"""

SWIFT_XCTEST = """
Test Case '-[SitboneCoreTests.SessionProfileTests testDefaultProfile]' passed (0.000 seconds).
Test Case '-[SitboneCoreTests.FocusStateMachineTests testFlowStaysWhenIdleBelowT1]' failed (0.010 seconds).
"""

SWIFT_TESTING = """
◇ Suite UILogicTests started.
◇ Test "formatTime: ゼロ" started.
✔ Test "formatTime: ゼロ" passed after 0.001 seconds.
✔ Suite UILogicTests passed after 0.001 seconds.
✔ Test run with 1 test in 1 suite passed after 0.001 seconds.
"""

GHA_CARGO = """
ubuntu-latest / stable\tcargo test\t2026-04-16T06:40:47.000Z test kizu::scar::undo ... FAILED
ubuntu-latest / stable\tcargo test\t2026-04-16T06:41:12.000Z test kizu::hook::parse ... ok
macos-latest / stable\tcargo test\t2026-05-04T12:46:38.100Z test kizu::scar::undo ... ok
macos-latest / stable\tcargo test\t2026-05-04T12:46:38.200Z test kizu::hook::parse ... ok
"""


def _selftest() -> int:
    failed: list[str] = []
    n_ok = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal n_ok
        if cond:
            n_ok += 1
            print(f"  ok  {name}")
        else:
            failed.append(name)
            print(f"  FAIL {name} {detail}", file=sys.stderr)

    fail_obs = parse_bytes(JUNIT_FAIL, "run-2019.xml", "2019", "2019-06-01T12:00:00Z", False)
    green_obs = parse_bytes(JUNIT_GREEN, "run-2024.xml", "2024", "2024-08-01T12:00:00Z", False)
    all_obs = fail_obs + green_obs
    rows = {r.id: r for r in fold(all_obs, None)}
    check("junit ids", set(rows) == {"pkg.T::alpha", "pkg.T::beta", "pkg.T::gamma", "pkg.T::delta"})
    check("alpha scarred", rows["pkg.T::alpha"].verdict == SCARRED and rows["pkg.T::alpha"].n_fail == 1)
    check("beta maiden", rows["pkg.T::beta"].verdict == MAIDEN and rows["pkg.T::beta"].n_pass == 2)
    check("gamma skipped not maiden", rows["pkg.T::gamma"].verdict == SKIPPED)
    check("delta maiden", rows["pkg.T::delta"].verdict == MAIDEN)
    check("empty is unknown", fold([], {"never.ran"} )[0].verdict == UNKNOWN)

    sk = {r.id: r for r in skeptic_rows(all_obs)}
    check("skeptic catches alpha", "pkg.T::alpha" in sk)
    check("skeptic ignores beta", "pkg.T::beta" not in sk)
    check("skeptic ignores delta", "pkg.T::delta" not in sk)
    latest = {r.id: r for r in fold(filter_latest(all_obs), None)}
    check(
        "latest-only would maiden alpha",
        latest["pkg.T::alpha"].verdict == MAIDEN and latest["pkg.T::alpha"].n_fail == 0,
    )

    cargo = parse_bytes(CARGO_FAIL + "\n" + CARGO_PASS, "cargo.log", "c", "2020-01-01T00:00:00Z", False)
    crows = {r.id: r for r in fold(cargo, None)}
    check("cargo alpha scarred", crows["app::tests::alpha"].verdict == SCARRED)
    check("cargo skippy skipped", crows["app::tests::skippy"].verdict == SKIPPED)
    check("cargo beta maiden", crows["app::tests::beta"].verdict == MAIDEN)

    xct = parse_bytes(SWIFT_XCTEST, "xctest.log", "s", "2026-01-01T00:00:00Z", False)
    xids = {o.id: o.status for o in xct}
    check(
        "xctest canonical",
        "SitboneCoreTests.SessionProfileTests/testDefaultProfile" in xids
        and xids["SitboneCoreTests.FocusStateMachineTests/testFlowStaysWhenIdleBelowT1"] == FAIL,
    )
    st = parse_bytes(SWIFT_TESTING, "swift.log", "s", "2026-01-01T00:00:00Z", False)
    check("swift testing display", any(o.id == "formatTime: ゼロ" and o.status == PASS for o in st))
    check("swift suite is not a test", all("Suite" not in o.id for o in st))

    gha = parse_bytes(GHA_CARGO, "gha.log", "g", None, False)
    grows = {r.id: r for r in fold(gha, None)}
    check("gha prefix stripped + scarred", grows.get("kizu::scar::undo") and grows["kizu::scar::undo"].verdict == SCARRED)
    check("gha skeptic currently-green scar", "kizu::scar::undo" in {r.id for r in skeptic_rows(gha)})
    check("gha hook never-red", grows["kizu::hook::parse"].verdict == MAIDEN)

    roster = parse_bytes(
        "app::tests::alpha: test\napp::tests::newborn: test\n",
        "list.txt",
        "list",
        None,
        True,
    )
    check("roster seen", {o.id for o in roster} == {"app::tests::alpha", "app::tests::newborn"})
    mixed = fold(cargo + roster, {o.id for o in roster if o.status == SEEN})
    by = {r.id: r for r in mixed}
    check("roster unknown", by["app::tests::newborn"].verdict == UNKNOWN)
    check("orphan cargo skippy", by["app::tests::skippy"].verdict == ORPHAN)

    sl = parse_bytes(
        "SitboneUITests.UILogicTests/formatTimeZero()\n"
        "SitboneCoreTests.SessionProfileTests/testDefaultProfile\n"
        "SitboneCoreTests.PresenceArbiterTests/EMASmoothing/firstReadingNoSmoothing()\n"
        "SitboneCoreTests.SystemSleepTests/ウェイク処理/cameraRestartsAfterWake()\n",
        "swift.list",
        "list",
        None,
        True,
    )
    check(
        "swift list parens stripped",
        {o.id for o in sl} == {
            "SitboneUITests.UILogicTests/formatTimeZero",
            "SitboneCoreTests.SessionProfileTests/testDefaultProfile",
            "SitboneCoreTests.PresenceArbiterTests/EMASmoothing/firstReadingNoSmoothing",
            "SitboneCoreTests.SystemSleepTests/ウェイク処理/cameraRestartsAfterWake",
        },
    )
    check(
        "nested swift specifier kept",
        "SitboneCoreTests.PresenceArbiterTests/EMASmoothing/firstReadingNoSmoothing" in {o.id for o in sl},
    )

    # skip-only is not maiden even with roster
    skip_only = parse_bytes(
        """<?xml version="1.0"?><testsuite><testcase name="never"><skipped/></testcase></testsuite>""",
        "s.xml",
        "s",
        "2020-01-01T00:00:00Z",
        False,
    )
    check("skip-only not maiden", fold(skip_only, None)[0].verdict == SKIPPED)

    here = Path(__file__).resolve().parent
    tree = here / "fixtures" / "tree"
    if tree.is_dir():
        aliases = swift_display_aliases(tree)
        check(
            "alias display → specifier",
            aliases.get("formatTime: ゼロ") == "SitboneUITests.UILogicTests/formatTimeZero",
        )
        check(
            "nested suite alias",
            aliases.get("初回読み取りはEMAなし（raw scoreがそのまま使われる）")
            == "SitboneCoreTests.PresenceArbiterTests/EMASmoothing/firstReadingNoSmoothing",
        )
        mapped = apply_aliases(st, aliases)
        check(
            "alias rewrites log id",
            any(o.id == "SitboneUITests.UILogicTests/formatTimeZero" for o in mapped),
        )
    print(f"{n_ok} passed, {len(failed)} failed")
    return 1 if failed else 0


