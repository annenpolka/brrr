  <testcase classname="pkg.T" name="alpha"/>
  <testcase classname="pkg.T" name="beta"/>
  <testcase classname="pkg.T" name="gamma"><skipped/></testcase>
  <testcase classname="pkg.T" name="delta"/>
</testsuite>
"""

CARGO_FAIL = """
running 3 tests
