def summary(rows: list[Row]) -> dict[str, int]:
    c: dict[str, int] = defaultdict(int)
    for r in rows:
        c[r.verdict] += 1
    return dict(c)


def format_tsv(rows: list[Row], header: bool) -> str:
    lines: list[str] = []
    show_aka = any(r.aka for r in rows)
    cols = ["verdict", "n_pass", "n_fail", "n_skip", "first", "last", "latest", "id"]
    if show_aka:
        cols.append("aka")
    if header:
        lines.append("\t".join(cols))
    for r in rows:
        cells = [
            r.verdict,
            str(r.n_pass),
            str(r.n_fail),
            str(r.n_skip),
            r.first or "—",
            r.last or "—",
            r.latest or "—",
            r.id,
        ]
        if show_aka:
            cells.append(",".join(r.aka) if r.aka else "—")
        lines.append("\t".join(cells))
    return "\n".join(lines) + ("\n" if lines else "")


def _row_dict(r: Row) -> dict:
    d = asdict(r)
    d["class"] = d.pop("classname")
    return d


def format_json(rows: list[Row], extra: dict | None = None) -> str:
    payload = {
        "version": VERSION,
        "summary": summary(rows),
        "tests": [_row_dict(r) for r in rows],
    }
    if extra:
        payload.update(extra)
    return json.dumps(payload, ensure_ascii=False, indent=2) + "\n"


def format_why(obs: list[Obs], tid: str, aka_map: dict[str, list[str]] | None = None) -> str:
    want = {canonical_id(tid), tid}
    if aka_map:
        for canon, olds in aka_map.items():
            if tid in olds or canonical_id(tid) in olds or tid == canon:
                want.add(canon)
                want.update(olds)
    recs = [o for o in obs if o.id in want or o.id == canonical_id(tid)]
    if not recs:
        return f"badge: no records for {tid}\n"
    recs = sorted(recs, key=lambda o: o.t or "")
    sample = recs[-1]
    lines = [
        f"# {sample.id}  n={len(recs)}  suite={sample.suite or '—'}  "
        f"class={sample.classname or '—'}  method={sample.method or '—'}"
    ]
    if aka_map and sample.id in aka_map:
        lines.append(f"# aka  {', '.join(aka_map[sample.id])}")
    for o in recs:
        lines.append(f"{o.status:4}  {o.t or '—':20}  run={o.run or '—'}  src={o.src}")
    return "\n".join(lines) + "\n"


