def gather(
    files: list[Path],
    ledger: Path | None,
    roster_flag: bool,
    use_ledger: bool,
) -> list[Obs]:
    obs: list[Obs] = []
    if use_ledger and ledger and ledger.exists():
        loaded, _ = load_ledger(ledger)
        obs.extend(loaded)
    for p in files:
        if str(p) == "-":
            text = sys.stdin.read()
            obs.extend(parse_bytes(text, "-", None, iso_utc(), roster_flag))
        else:
            obs.extend(parse_path(p, run=None, roster=roster_flag))
    return obs


def cmd_ingest(args: argparse.Namespace, files: list[Path], ledger: Path) -> int:
    if not files:
        print("badge ingest: no files", file=sys.stderr)
        return 2
    total = 0
    for p in files:
        if str(p) == "-":
            text = sys.stdin.read()
            src = "-"
            sha = sha256_text(text)
            obs = parse_bytes(text, src, args.run, iso_utc(), args.roster)
        else:
            text = p.read_text(encoding="utf-8", errors="replace") if p.is_file() else ""
            src = str(p)
            sha = sha256_text(text) if p.is_file() else None
            obs = parse_path(p, run=args.run or p.name, roster=args.roster)
        n = append_ledger(ledger, obs, src, sha)
        total += n
        if not args.quiet:
            print(f"ingested {n}  src={src}  ledger={ledger}")
    if args.json:
        print(json.dumps({"added": total, "ledger": str(ledger)}))
    return 0


def filter_only(rows: list[Row], only: str | None) -> list[Row]:
    if not only:
        return rows
    want = {v.strip().upper() for v in only.split(",")}
    return [r for r in rows if r.verdict in want]


def cmd_classify(args: argparse.Namespace, files: list[Path], ledger: Path | None, root: Path) -> int:
    if args.latest and args.skeptic:
        print("badge: --skeptic cannot compose with --latest (that is rg PASS)", file=sys.stderr)
        return 2
    obs = gather(files, ledger, args.roster, use_ledger=not args.no_ledger)
    aliases = {} if args.no_alias_swift else swift_display_aliases(root)
    if aliases:
        obs = apply_aliases(obs, aliases)
    aka_map: dict[str, list[str]] = {}
    do_unify = UNIFY and not args.no_unify
    if do_unify:
        obs, aka_map = unify_identities(obs)
    seen_ids = {o.id for o in obs if o.status == SEEN}
    roster_ids: set[str] | None = seen_ids or None
    if args.latest:
        obs = filter_latest(obs)
        roster_ids = None
    if args.why:
        tid = canonical_id(args.why)
        if aliases:
            tid = aliases.get(tid, tid)
        if aka_map:
            for canon, olds in aka_map.items():
                if tid == canon or tid in olds:
                    tid = canon
                    break
        sys.stdout.write(format_why(obs, tid, aka_map))
        recs = [o for o in obs if o.id == tid]
        return 0 if recs else 1
    if args.skeptic:
        rows = skeptic_rows(obs, aka_map)
        extra = {"kind": "skeptic", "note": "latest run PASS but history has fail — not rg PASS"}
    else:
        rows = fold(obs, roster_ids, aka_map)
        extra = None
    rows = filter_only(rows, args.only)
    if args.json:
        sys.stdout.write(format_json(rows, extra))
    else:
        if args.summary or args.counts or not rows:
            s = summary(rows if not args.skeptic else fold(obs, roster_ids, aka_map))
            if args.skeptic:
                print(
                    f"# SKEPTIC {len(rows)}  (latest PASS ∩ history FAIL)  "
                    f"SCARRED={s.get(SCARRED, 0)} MAIDEN={s.get(MAIDEN, 0)} "
                    f"SKIPPED={s.get(SKIPPED, 0)} UNKNOWN={s.get(UNKNOWN, 0)}"
                )
            else:
                print(
                    f"# SCARRED {s.get(SCARRED, 0)}  MAIDEN {s.get(MAIDEN, 0)}  "
                    f"SKIPPED {s.get(SKIPPED, 0)}  UNKNOWN {s.get(UNKNOWN, 0)}  "
                    f"ORPHAN {s.get(ORPHAN, 0)}"
                )
        if rows and not args.counts:
            sys.stdout.write(format_tsv(rows, header=args.header))
    if args.check:
        want = {v.strip().upper() for v in args.check.split(",")}
        if args.skeptic or "SKEPTIC" in want:
            hit = bool(skeptic_rows(obs, aka_map) if not args.skeptic else rows)
        else:
            hit = any(r.verdict in want for r in rows)
        return 1 if hit else 0
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="badge",
        description="Never-red tests keyed by (suite, class, method) — not a spelling, not rg PASS.",
    )
    p.add_argument("-C", dest="root", default=".", help="root (ledger, aliases)")
    p.add_argument("--ledger", help="ledger jsonl (default: ROOT/.badge/ledger.jsonl)")
    p.add_argument("--no-ledger", action="store_true", help="ignore on-disk ledger")
    p.add_argument("--roster", action="store_true", help="treat inputs as runner --list (status=seen)")
    p.add_argument(
        "--no-alias-swift",
        action="store_true",
        help="do not map Swift Testing display names to list specifiers",
    )
    p.add_argument("--no-unify", action="store_true", help="do not join class-moves / method-renames")
    p.add_argument("--latest", action="store_true", help="fold only the newest run (the rg PASS lie)")
    p.add_argument("--skeptic", action="store_true", help="latest PASS but history FAIL")
    p.add_argument("--only", help="MAIDEN,SCARRED,SKIPPED,UNKNOWN,ORPHAN")
    p.add_argument("--check", help="exit 1 if any row has this verdict (or SKEPTIC)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--header", action="store_true")
    p.add_argument("--summary", action="store_true")
    p.add_argument("--counts", action="store_true", help="print the summary line only")
    p.add_argument("--why", metavar="ID")
    p.add_argument("--run", help="run id to stamp on ingest")
    p.add_argument("--quiet", "-q", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("words", nargs="*", help="ingest | files | why-id")
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args, extra = parser.parse_known_args(argv)
    if extra:
        # ingest --run ID FILE  leaves FILE in extra under argparse *
        args.words = list(args.words) + extra
    if args.version:
        print(f"badge {VERSION}")
        return 0
    if args.selftest:
        return _selftest()
    root = Path(args.root).resolve()
    ledger = Path(args.ledger).resolve() if args.ledger else default_ledger(root)
    words = list(args.words)
    sub = words[0] if words and words[0] in {"ingest", "why"} else None
    if sub == "why":
        args.why = " ".join(words[1:]) if len(words) > 1 else args.why
        files: list[Path] = []
        if not args.why:
            print("badge why: missing id", file=sys.stderr)
            return 2
        return cmd_classify(args, files, ledger, root)
    if sub == "ingest":
        files = [Path(w) if w != "-" else Path("-") for w in words[1:]]
        return cmd_ingest(args, files, ledger)
    files = [Path(w) if w != "-" else Path("-") for w in words]
    return cmd_classify(args, files, None if args.no_ledger else ledger, root)


if __name__ == "__main__":
    sys.exit(main())
