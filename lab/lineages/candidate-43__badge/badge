#!/usr/bin/env python3
"""badge — never-red keyed by (suite, class, method), not a spelling.

A currently green test is not maiden. SKIP-only is not maiden.
No records is UNKNOWN, not maiden. <flakyFailure> / <rerunFailure> /
status="failed" are red. A renamed method or moved class is one identity.
One fail in 2019 is SCARRED forever in this ledger.
"""
from __future__ import annotations

