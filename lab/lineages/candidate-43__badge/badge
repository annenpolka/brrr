def _times(recs: list[Obs]) -> list[str]:
    return [o.t for o in recs if o.t]


def classify_id(recs: list[Obs], in_roster: bool | None) -> Row:
    n_pass = sum(1 for o in recs if o.status == PASS)
    n_fail = sum(1 for o in recs if o.status == FAIL)
    n_skip = sum(1 for o in recs if o.status == SKIP)
    outcomes = [o for o in recs if o.status in {PASS, FAIL, SKIP}]
    ts = _times(outcomes)
    first = min(ts) if ts else None
    last = max(ts) if ts else None
    reds = _times([o for o in recs if o.status == FAIL])
    first_red = min(reds) if reds else None
    latest = None
    if outcomes:
        if last:
            at_last = [o for o in outcomes if o.t == last]
            if not at_last:
                at_last = outcomes
        else:
            at_last = outcomes
        rank = {FAIL: 0, SKIP: 1, PASS: 2}
        latest = sorted(at_last, key=lambda o: rank.get(o.status, 9))[0].status
    if n_fail:
        verdict = SCARRED
    elif n_pass:
        verdict = MAIDEN
    elif n_skip:
        verdict = SKIPPED
    else:
        verdict = UNKNOWN
    if in_roster is False and verdict != UNKNOWN:
        verdict = ORPHAN
    sample = recs[0] if recs else None
    return Row(
        id=sample.id if sample else "",
        verdict=verdict,
        n_pass=n_pass,
        n_fail=n_fail,
        n_skip=n_skip,
        first=first,
        last=last,
        first_red=first_red,
        latest=latest,
        n_obs=len(outcomes),
        suite=sample.suite if sample else "",
        classname=sample.classname if sample else "",
        method=sample.method if sample else "",
    )


def fold(obs: list[Obs], roster: set[str] | None, aka_map: dict[str, list[str]] | None = None) -> list[Row]:
    by: dict[str, list[Obs]] = defaultdict(list)
    for o in obs:
        by[o.id].append(o)
    ids = set(by)
    if roster is not None:
        ids |= roster
    rows: list[Row] = []
    for i in ids:
        recs = by.get(i, [])
        if not recs:
            recs = [Obs(id=i, status=SEEN, t=None, src="roster", run=None)]
        in_roster: bool | None
        if roster is None:
            in_roster = None
        else:
            in_roster = i in roster
        row = classify_id(recs, in_roster)
        row.id = i
        if aka_map:
            row.aka = sorted(set(aka_map.get(i, [])) - {i})
        if recs:
            # prefer the latest spelling's triple
            dated = [o for o in recs if o.t]
            pick = max(dated, key=lambda o: o.t or "") if dated else recs[-1]
            row.suite = pick.suite
            row.classname = pick.classname
            row.method = pick.method
        rows.append(row)
    rows.sort(key=lambda r: (VERDICT_ORDER.get(r.verdict, 9), r.id))
    return rows


def filter_latest(obs: list[Obs]) -> list[Obs]:
    """Keep each test's newest outcome(s). The rg PASS snapshot."""
    by: dict[str, list[Obs]] = defaultdict(list)
    for o in obs:
        if o.status == SEEN:
            continue
        by[o.id].append(o)
    out: list[Obs] = []
    for recs in by.values():
        ts = [o.t for o in recs if o.t]
        if ts:
            last = max(ts)
            at = [o for o in recs if o.t == last]
        else:
            at = recs[-1:]
        out.extend(at)
    return out


def skeptic_rows(obs: list[Obs], aka_map: dict[str, list[str]] | None = None) -> list[Row]:
    """Newest outcome is PASS but recorded history has a fail — not rg PASS."""
    hist = fold(obs, roster=None, aka_map=aka_map)
    hits = [r for r in hist if r.verdict == SCARRED and r.latest == PASS]
    hits.sort(key=lambda r: (r.first_red or "", r.id))
    return hits


# ---------------------------------------------------------------------------
# unify — (suite, class, method) across class-move / method-rename
# ---------------------------------------------------------------------------

UNIFY = True


class _UF:
    def __init__(self, items: list[str]) -> None:
        self.p = {i: i for i in items}
        self.m: dict[str, list[str]] = {i: [i] for i in items}

    def find(self, x: str) -> str:
        while self.p[x] != x:
            self.p[x] = self.p[self.p[x]]
            x = self.p[x]
        return x

    def members(self, x: str) -> list[str]:
        return self.m[self.find(x)]

    def union(self, a: str, b: str) -> None:
        ra, rb = self.find(a), self.find(b)
        if ra == rb:
            return
        if len(self.m[ra]) < len(self.m[rb]):
            ra, rb = rb, ra
        self.p[rb] = ra
        self.m[ra].extend(self.m[rb])
        del self.m[rb]


def _cooccur_pairs(obs: list[Obs]) -> set[tuple[str, str]]:
    by: dict[tuple[str, str], set[str]] = defaultdict(set)
    for o in obs:
        by[(o.src, o.run or "")].add(o.id)
    pairs: set[tuple[str, str]] = set()
    for ids in by.values():
        uniq = sorted(ids)
        for i, a in enumerate(uniq):
            for b in uniq[i + 1 :]:
                pairs.add((a, b))
                pairs.add((b, a))
    return pairs


def unify_identities(obs: list[Obs]) -> tuple[list[Obs], dict[str, list[str]]]:
    """Fold class-moves and method-renames onto one (suite, class, method) badge.

    Class move: same suite + same method, class last-segment changed, shared package prefix.
    Method rename: same suite + same class, method token-subset (min 2 tokens), never co-occur.
    Co-occurrence in the same src/run is a hard barrier (roster of 213 stays 213).
    """
    if not obs:
        return obs, {}
    keys = sorted({o.id for o in obs})
    # representative triple per spelling (latest obs)
    by_id: dict[str, list[Obs]] = defaultdict(list)
    for o in obs:
        by_id[o.id].append(o)

    def latest_triple(i: str) -> tuple[str, str, str]:
        recs = by_id[i]
        dated = [x for x in recs if x.t]
        pick = max(dated, key=lambda x: x.t or "") if dated else recs[-1]
        return pick.suite, pick.classname, pick.method

    triples = {i: latest_triple(i) for i in keys}
    uf = _UF(keys)
    forbidden = _cooccur_pairs(obs)

    def can_union(a: str, b: str) -> bool:
        if a == b:
            return False
        ra, rb = uf.find(a), uf.find(b)
        if ra == rb:
            return False
        for x in uf.members(ra):
            for y in uf.members(rb):
                if (x, y) in forbidden:
                    return False
        return True

    candidates: list[tuple[int, str, str]] = []
    for i, a in enumerate(keys):
        sa, ca, ma = triples[a]
        for b in keys[i + 1 :]:
            sb, cb, mb = triples[b]
            if (a, b) in forbidden:
                continue
            score = 0
            if sa and sa == sb and ma and ma == mb and ca != cb:
                pa, pb = pkg_prefix(ca), pkg_prefix(cb)
                if pa and pa == pb:
                    score = 3  # class move
            elif sa == sb and ca and ca == cb and method_rename_pair(ma, mb):
                score = 2  # method rename
            if score:
                candidates.append((score, a, b))
    candidates.sort(key=lambda x: (-x[0], x[1], x[2]))
    for _, a, b in candidates:
        if can_union(a, b):
            uf.union(a, b)

    def last_t(i: str) -> str:
        ts = [o.t for o in by_id[i] if o.t]
        return max(ts) if ts else ""

    canon: dict[str, str] = {}
    aka_map: dict[str, list[str]] = defaultdict(list)
    for root, members in list(uf.m.items()):
        group = uf.members(root)
        # newest spelling, then longest method (rename target), then id
        def rank(i: str) -> tuple:
            _, _, meth = triples[i]
            return (last_t(i), len(meth), i)

        chosen = sorted(group, key=rank)[-1]
        for i in group:
            canon[i] = chosen
            if i != chosen:
                aka_map[chosen].append(i)

    if not any(k != v for k, v in canon.items()):
        return obs, {}

    out: list[Obs] = []
    for o in obs:
        new_id = canon.get(o.id, o.id)
        if new_id == o.id:
            out.append(o)
            continue
        ns, nc, nm = triples.get(new_id, triple_of(o))
        out.append(
            Obs(
                id=new_id,
                status=o.status,
                t=o.t,
                src=o.src,
                run=o.run,
                suite=ns or o.suite,
                classname=nc or o.classname,
                method=nm or o.method,
            )
        )
    return out, {k: sorted(set(v)) for k, v in aka_map.items()}


# ---------------------------------------------------------------------------
# aliases (Swift Testing display → specifier)
# ---------------------------------------------------------------------------

SKIP_DIRS = {
    ".git",
    "node_modules",
    "target",
    ".build",
    "dist",
    "vendor",
    "__pycache__",
    ".venv",
    "venv",
    ".swiftpm",
    "DerivedData",
    ".maiden",
    ".badge",
}

RE_SWIFT_TEST_FUNC = re.compile(r"^\s*func\s+(test\w*)\s*\(")
RE_SWIFT_ATTEST = re.compile(r'@Test\s*\(\s*"((?:[^"\\]|\\.)*)"')
RE_SWIFT_TYPE = re.compile(
    r"^\s*(?:(?:public|private|internal|fileprivate|final)\s+)*(?:struct|class|enum|actor)\s+(\w+)"
)


def _swift_test_roots(root: Path) -> list[Path]:
    tests = root / "Tests"
    return [tests] if tests.is_dir() else []


def swift_display_aliases(root: Path) -> dict[str, str]:
    """Map Swift Testing display name → Module.Type[/Nested]/func."""
    aliases: dict[str, str] = {}
    ambiguous: set[str] = set()
    for walk_root in _swift_test_roots(root):
        for dirpath, dirnames, filenames in os.walk(walk_root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
            for fn in filenames:
                if not fn.endswith(".swift"):
                    continue
                path = Path(dirpath) / fn
                try:
                    text = path.read_text(encoding="utf-8", errors="replace")
                except OSError:
                    continue
                try:
                    rel = path.relative_to(root)
                except ValueError:
                    rel = path
                parts = rel.parts
                module = path.stem
                if "Tests" in parts:
                    i = parts.index("Tests")
                    if i + 1 < len(parts):
                        module = parts[i + 1]
                stack: list[tuple[int, str]] = []
                depth = 0
                lines = text.splitlines()
                for i, ln in enumerate(lines):
                    tm = RE_SWIFT_TYPE.match(ln)
                    if tm:
                        stack.append((depth, tm.group(1)))
                    am = RE_SWIFT_ATTEST.search(ln)
                    if am:
                        display = am.group(1)
                        func = None
                        for nxt in lines[i : i + 8]:
                            fm = re.search(r"func\s+(\w+)\s*\(", nxt)
                            if fm:
                                func = fm.group(1)
                                break
                        types = [name for _, name in stack]
                        if func and types:
                            spec = canonical_id(
                                f"{module}.{types[0]}/" + "/".join(types[1:] + [func])
                            )
                            if display in aliases and aliases[display] != spec:
                                ambiguous.add(display)
                            else:
                                aliases[display] = spec
                    depth += ln.count("{") - ln.count("}")
                    if depth < 0:
                        depth = 0
                    stack = [(d, n) for d, n in stack if d < depth]
    for key in ambiguous:
        aliases.pop(key, None)
    return aliases


def apply_aliases(obs: list[Obs], aliases: dict[str, str]) -> list[Obs]:
    if not aliases:
        return obs
    out: list[Obs] = []
    for o in obs:
        mapped = aliases.get(o.id)
        if mapped and mapped != o.id:
            suite, cls, method = split_swift_spec(mapped)
            out.append(
                Obs(
                    id=mapped,
                    status=o.status,
                    t=o.t,
                    src=o.src,
                    run=o.run,
                    suite=suite or o.suite,
                    classname=cls or o.classname,
                    method=method or o.method,
                )
            )
        else:
            out.append(o)
    return out


