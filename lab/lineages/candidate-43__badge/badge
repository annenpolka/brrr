def default_ledger(root: Path) -> Path:
    return root / ".badge" / "ledger.jsonl"


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest()


def load_ledger(path: Path) -> tuple[list[Obs], set[str]]:
    if not path.exists():
        return [], set()
    text = path.read_text(encoding="utf-8", errors="replace")
    shas: set[str] = set()
    for ln in text.splitlines():
        s = ln.strip()
        if not s.startswith("{"):
            continue
        try:
            obj = json.loads(s)
        except json.JSONDecodeError:
            continue
        if obj.get("kind") == "source" and obj.get("sha256"):
            shas.add(obj["sha256"])
    return parse_ledger_text(text, str(path)), shas


def append_ledger(path: Path, obs: list[Obs], src: str, sha: str | None) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    existing, shas = load_ledger(path)
    if sha and sha in shas:
        return 0
    seen = {(o.id, o.status, o.t, o.src, o.run) for o in existing}
    added = 0
    with path.open("a", encoding="utf-8") as f:
        if sha:
            f.write(json.dumps({"kind": "source", "src": src, "sha256": sha}, ensure_ascii=False) + "\n")
        for o in obs:
            key = (o.id, o.status, o.t, o.src, o.run)
            if key in seen:
                continue
            seen.add(key)
            rec = {
                "id": o.id,
                "status": o.status,
                "t": o.t,
                "src": o.src,
                "run": o.run,
                "suite": o.suite,
                "class": o.classname,
                "method": o.method,
            }
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
            added += 1
    return added


