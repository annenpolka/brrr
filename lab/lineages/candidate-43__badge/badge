    check("status=failed is red", srows["pkg.T::alpha"].verdict == SCARRED)
    check("status=passed is maiden", srows["pkg.T::beta"].verdict == MAIDEN)

    rename = parse_bytes(JUNIT_RENAME_FAIL, "rf.xml", "2019", "2019-06-01T12:00:00Z", False) + parse_bytes(
        JUNIT_RENAME_PASS, "rp.xml", "2024", "2024-08-01T12:00:00Z", False
    )
    if UNIFY:
        rename, aka = unify_identities(rename)
        rrows = {r.id: r for r in fold(rename, None, aka)}
        check("rename is one identity", len(rrows) == 1)
        only = next(iter(rrows.values()))
        check("rename folded is SCARRED", only.verdict == SCARRED and only.n_fail == 1 and only.n_pass == 1)
        check("rename aka keeps old spelling", "pkg.T::compute_diff" in (only.aka + [only.id]))
    else:
        rrows = {r.id: r for r in fold(rename, None)}
        check(
            "v0.1 rename still splits (string method)",
            set(rrows) == {"pkg.T::compute_diff", "pkg.T::compute_operation_diff"},
        )
        check("v0.1 old spelling SCARRED", rrows["pkg.T::compute_diff"].verdict == SCARRED)
        check("v0.1 new spelling MAIDEN", rrows["pkg.T::compute_operation_diff"].verdict == MAIDEN)

    moved = parse_bytes(JUNIT_CLASS_FAIL, "cf.xml", "2019", "2019-06-01T12:00:00Z", False) + parse_bytes(
        JUNIT_CLASS_PASS, "cp.xml", "2024", "2024-08-01T12:00:00Z", False
    )
    if UNIFY:
        moved, aka2 = unify_identities(moved)
        mrows = {r.id: r for r in fold(moved, None, aka2)}
        check("class move is one identity", len(mrows) == 1 and next(iter(mrows.values())).verdict == SCARRED)
    else:
        mrows = {r.id: r for r in fold(moved, None)}
        check("v0.1 class move still splits", set(mrows) == {"pkg.Old::alpha", "pkg.New::alpha"})

    check("token rename detects compute_diff", method_rename_pair("compute_diff", "compute_operation_diff"))
    check("token rename ignores alpha/beta", not method_rename_pair("alpha", "beta"))
    gold_u, _ = unify_identities(all_obs)
    check("unify does not collapse gold 4-id fold", len({r.id for r in fold(gold_u, None)}) == 4)
    if UNIFY:
        check(
            "skeptic of unified rename is the scar",
            "pkg.T::compute_operation_diff" in {r.id for r in skeptic_rows(rename, aka)},
        )

    here = Path(__file__).resolve().parent
    tree = here / "fixtures" / "tree"
    if tree.is_dir():
        aliases = swift_display_aliases(tree)
        check(
            "alias display → specifier",
            aliases.get("formatTime: ゼロ") == "SitboneUITests.UILogicTests/formatTimeZero",
        )
        check(
            "nested suite alias",
            aliases.get("初回読み取りはEMAなし（raw scoreがそのまま使われる）")
            == "SitboneCoreTests.PresenceArbiterTests/EMASmoothing/firstReadingNoSmoothing",
        )
        mapped = apply_aliases(st, aliases)
        check(
            "alias rewrites log id",
            any(o.id == "SitboneUITests.UILogicTests/formatTimeZero" for o in mapped),
        )
    roster_path = here / "fixtures" / "roster" / "sitbone-list.txt"
    if roster_path.is_file():
        n_list = parse_bytes(roster_path.read_text(encoding="utf-8"), str(roster_path), "list", None, True)
        check("sitbone roster 213 UNKNOWN shape", len(n_list) == 213)
        check("sitbone roster not maiden", all(o.status == SEEN for o in n_list))
        unified_list, _ = unify_identities(n_list)
        check("unify does not collapse sitbone 213", len({o.id for o in unified_list}) == 213)

    print(f"{n_ok} passed, {len(failed)} failed")
    return 1 if failed else 0


