def git(root: Path, args: list[str], check: bool = True) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
    )


def git_ok(root: Path, args: list[str]) -> Optional[str]:
    try:
        cp = git(root, args, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    return cp.stdout.decode("utf-8", "surrogateescape")


def discover_repo(start: Path) -> Optional[Path]:
    cur = start.resolve()
    if cur.is_file():
        cur = cur.parent
    for p in [cur, *cur.parents]:
        if (p / ".git").exists():
            return p
    return None


def posix_rel(path: str) -> str:
    return path.replace("\\", "/").lstrip("./")


def should_skip_path(path: str) -> bool:
    parts = path.replace("\\", "/").split("/")
    if any(part in SKIP_DIRS for part in parts):
        return True
    lower = path.lower()
    return any(lower.endswith(suf) for suf in SKIP_SUFFIXES)


def normalize(line: str) -> str:
    return re.sub(r"\s+", " ", line.strip())


def tokens(line: str) -> list[str]:
    out = []
    for m in IDENT_RE.findall(line):
        if m.lower() in STOPWORDS or len(m) < 2:
            continue
        out.append(m)
    return out


def decode_bytes(data: bytes) -> Optional[str]:
    if b"\x00" in data[:4096]:
        return None
    if len(data) > MAX_TEMPLATE_FILE_BYTES:
        return None
    for enc in ("utf-8", "utf-8-sig", "latin-1"):
        try:
            return data.decode(enc)
        except UnicodeDecodeError:
            continue
    return data.decode("utf-8", "replace")


def split_lines(text: str) -> list[str]:
    if text == "":
        return []
    return text.splitlines()


def lang_for(path: str | Path, default: str | None = None) -> str | None:
    suf = Path(str(path)).suffix.lower()
    return SOURCE_EXTS.get(suf, default)


def is_test_path(path: str) -> bool:
    return bool(TEST_PATH_RE.search(path.replace("\\", "/")))


def walk_dir_files(root: Path) -> Iterator[str]:
    root = root.resolve()
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
        for name in filenames:
            full = Path(dirpath) / name
            try:
                rel = full.relative_to(root).as_posix()
            except ValueError:
                continue
            if should_skip_path(rel):
                continue
            yield rel


def read_dir_file(root: Path, path: str) -> Optional[list[str]]:
    fp = root / path
    try:
        data = fp.read_bytes()
    except OSError:
        return None
    text = decode_bytes(data)
    if text is None:
        return None
    return split_lines(text)


def load_git_archive(root: Path, ref: str) -> dict[str, list[str]]:
    files: dict[str, list[str]] = {}
    try:
        cp = git(root, ["archive", "--format=tar", ref], check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return files
    try:
        tf = tarfile.open(fileobj=io.BytesIO(cp.stdout), mode="r:")
    except tarfile.TarError:
        return files
    for m in tf.getmembers():
        if not m.isfile():
            continue
        path = posix_rel(m.name)
        if should_skip_path(path):
            continue
        f = tf.extractfile(m)
        if f is None:
            continue
        data = f.read()
        if m.size > MAX_TEMPLATE_FILE_BYTES:
            continue
        text = decode_bytes(data)
        if text is None:
            continue
        files[path] = split_lines(text)
    return files


def load_worktree_files(root: Path, untracked: bool) -> dict[str, list[str]]:
    files: dict[str, list[str]] = {}
    raw = git_ok(root, ["ls-files", "-z"]) or ""
    paths = [posix_rel(p) for p in raw.split("\0") if p and not should_skip_path(p)]
    if untracked:
        extra = git_ok(root, ["ls-files", "-o", "--exclude-standard", "-z"]) or ""
        for p in extra.split("\0"):
            if p and not should_skip_path(p):
                paths.append(posix_rel(p))
    for path in paths:
        fp = root / path
        try:
            data = fp.read_bytes()
        except OSError:
            continue
        text = decode_bytes(data)
        if text is None:
            continue
        files[path] = split_lines(text)
    return files


def load_snapshot(
    *,
    git_root: Optional[Path],
    ref: Optional[str],
    directory: Optional[Path],
    untracked: bool,
    label: str,
) -> Snapshot:
    files: dict[str, list[str]] = {}
    if directory is not None:
        for path in walk_dir_files(directory):
            lines = read_dir_file(directory, path)
            if lines is not None:
                files[path] = lines
    elif git_root is None:
        raise SystemExit("moor: not a git repository (use --repo or --from-dir/--to-dir)")
    elif ref is None:
        files = load_worktree_files(git_root, untracked=untracked)
    else:
        files = load_git_archive(git_root, ref)
    snap = Snapshot(label=label, files=files)
    snap.index()
    snap.extract_templates()
    return snap


def rename_map(root: Path, src_ref: Optional[str], dst_ref: Optional[str]) -> dict[str, str]:
    if src_ref is None or dst_ref is None:
        return {}
    raw = git_ok(root, ["diff", "-M", "-C", "--name-status", "--diff-filter=R", src_ref, dst_ref])
    if not raw:
        return {}
    out: dict[str, str] = {}
    for line in raw.splitlines():
        parts = line.split("\t")
        if len(parts) >= 3 and parts[0].startswith("R"):
            out[posix_rel(parts[1])] = posix_rel(parts[2])
    return out


def resolve_ref(root: Path, ref: str) -> Optional[str]:
    raw = git_ok(root, ["rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"])
    if raw is None:
        raw = git_ok(root, ["rev-parse", "--verify", "--quiet", ref])
    if raw is None:
        return None
    return raw.strip()


