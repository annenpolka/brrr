@dataclass
class Locator:
    path: str
    line: int
    col: Optional[int] = None
    ref: Optional[str] = None
    span: Optional[tuple[int, int]] = None
    form: str = "colon"
    quote: str = '"'


@dataclass
class Resolution:
    locator: Locator
    status: str
    dest_path: Optional[str] = None
    dest_line: Optional[int] = None
    score: float = 0.0
    note: str = ""
    dest_text: str = ""


@dataclass(frozen=True)
class Template:
    path: str
    line: int
    col: int
    lang: str
    raw: str
    parts: tuple[str, ...]
    holes: tuple[str, ...]

    @property
    def n_holes(self) -> int:
        return len(self.holes)

    @property
    def static_len(self) -> int:
        return sum(len(p) for p in self.parts)

    @property
    def display(self) -> str:
        out: list[str] = []
        for i, p in enumerate(self.parts):
            if i:
                name = self.holes[i - 1] if i - 1 < len(self.holes) else ""
                out.append("{}" if name.isdigit() else "{" + name + "}")
            out.append(p.replace("\n", "\\n").replace("\t", "\\t"))
        return "".join(out)


@dataclass
class THit:
    template: Template
    score: float
    variant: str
    prefix: str
    suffix: str
    values: tuple[str, ...]


