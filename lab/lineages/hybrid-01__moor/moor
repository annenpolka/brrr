def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="moor",
        description=(
            "Bind a log instance to a current locator and a source hole. "
            "Input is a log stream plus two snapshots; output rewrites "
            "stale path:line and unpacks format-string holes in one pass."
        ),
    )
    p.add_argument("inputs", nargs="*", help="log lines, path:line, or log files (omit to filter stdin)")
    p.add_argument("--from", dest="from_ref", default=None, help="source git ref (default: worktree)")
    p.add_argument("--to", dest="to_ref", default=None, help="destination git ref (default: worktree)")
    p.add_argument("--from-dir", type=Path, default=None, help="source snapshot as a directory")
    p.add_argument("--to-dir", type=Path, default=None, help="destination snapshot as a directory")
    p.add_argument("--repo", type=Path, default=None, help="git repository (default: discover from cwd)")
    p.add_argument("--json", action="store_true", help="NDJSON bindings")
    p.add_argument("--porcelain", action="store_true", help="TSV bindings")
    p.add_argument("--rewrite", action="store_true", help="emit rewritten log lines (stdin/files)")
    p.add_argument(
        "--annotate",
        action="store_true",
        default=None,
        help="append ⟦locator tmpl holes⟧ to rewritten lines (default on with --rewrite)",
    )
    p.add_argument("--no-annotate", action="store_true", help="rewrite locators only")
    p.add_argument("--map", action="store_true", help="print bindings even when rewriting")
    p.add_argument("--records", choices=("auto", "line"), default="auto", help="group rustc/panic/traceback")
    p.add_argument("--strict", action="store_true", help="exit 1 if any record is a miss/unresolved")
    p.add_argument("--context", type=int, default=3, help="neighbor window for fingerprints")
    p.add_argument("--min-score", type=float, default=DEFAULT_MIN_SCORE, help="minimum template score")
    p.add_argument("--cached-only", action="store_true", help="do not include untracked dest files")
    p.add_argument("--selftest", action="store_true", help="run built-in tests")
    p.add_argument("--version", action="version", version=f"moor {VERSION}")
    return p


def run_selftest() -> int:
    failures: list[str] = []

    def expect(cond: bool, msg: str) -> None:
        if not cond:
            failures.append(msg)

    parts, holes = tokenize_template("git diff single file failed: {}")
    expect(holes == ("0",) and parts == ("git diff single file failed: ", ""), f"rust {{}}: {parts} {holes}")

    parts, holes = tokenize_template("user {uid} not found")
    expect(holes == ("uid",) and parts == ("user ", " not found"), f"named: {parts} {holes}")

    parts, holes = tokenize_template("Duplicate event ID: ${snapshot.id}")
    expect(holes == ("snapshot.id",) and parts[0] == "Duplicate event ID: ", f"js: {parts} {holes}")

    parts, holes = tokenize_template(
        "session started profile=\\(self.activeProfile.name, privacy: .private)"
    )
    expect(
        holes == ("self.activeProfile.name",) and parts[0] == "session started profile=",
        f"swift: {parts} {holes}",
    )

    parts, holes = tokenize_template("open %s: %v")
    expect(holes == ("0", "1") and parts == ("open ", ": ", ""), f"printf: {parts} {holes}")

    parts, holes = tokenize_template('{"ok": true}')
    expect(holes == (), f"json braces should not be holes: {parts} {holes}")

    t = Template("a.rs", 1, 1, "rust", "git diff single file failed: {}", ("git diff single file failed: ", ""), ("0",))
    hit = score_query(t, "git diff single file failed: fatal: not a git repository")
    expect(hit is not None and hit.score >= 0.5 and hit.values == ("fatal: not a git repository",), f"bind filled: {hit}")

    t2 = Template("u.py", 2, 1, "py", "user {uid} not found", ("user ", " not found"), ("uid",))
    hit = score_query(t2, "user 42 not found")
    expect(hit is not None and hit.values == ("42",), f"uid bind: {hit}")

    t3 = Template("o.go", 1, 1, "go", "open %s: %v", ("open ", ": ", ""), ("0", "1"))
    hit = score_query(t3, "open /tmp/x: permission denied")
    expect(hit is not None and hit.values == ("/tmp/x", "permission denied"), f"printf bind: {hit}")

    rust = 'return Err(anyhow!("git diff single file failed: {}", stderr.trim()));\n'
    tmpls = extract_templates(rust, "rust", "diff.rs")
    expect(any(t.display == "git diff single file failed: {}" for t in tmpls), f"extract rust: {[t.display for t in tmpls]}")

    py = 'raise KeyError(f"user {uid} not found")\n'
    tmpls = extract_templates(py, "py", "u.py")
    expect(any(t.n_holes == 1 and t.parts[0] == "user " for t in tmpls), f"py f: {[t.raw for t in tmpls]}")

    swift_src = (
        'Logger.dataStore.error("""\n'
        "            cumulative save failed path=\\(path) \\\n"
        "            error=\\(err)\n"
        '            """)\n'
    )
    tmpls = extract_templates(swift_src, "swift", "JSONSessionStore.swift")
    expect(
        any("cumulative save failed path=" in t.display and t.n_holes == 2 for t in tmpls),
        f"swift flatten: {[t.display for t in tmpls]}",
    )

    # Joint scoring: an exact test literal must lose to a production template
    # sitting on a slipped locator.
    prod = Template("src/users/lookup.py", 8, 1, "py", "user {uid} not found", ("user ", " not found"), ("uid",))
    decoy = Template("tests/test_auth.py", 3, 1, "py", "user 42 not found", ("user 42 not found",), ())
    h_prod = score_query(prod, "user 42 not found")
    h_decoy = score_query(decoy, "user 42 not found")
    expect(h_decoy is not None and h_prod is not None, "both templates match")
    expect(h_decoy.score > h_prod.score, f"decoy should be a better raw match: {h_decoy.score} vs {h_prod.score}")
    res = Resolution(
        locator=Locator(path="src/auth.py", line=5),
        status="moved",
        dest_path="src/users/lookup.py",
        dest_line=8,
        score=0.9,
    )
    prox_p = proximity(res, prod)
    prox_d = proximity(res, decoy)
    joint_p = 0.50 * h_prod.score + 0.30 * prox_p + 0.20 * 0.9 + 0.12
    joint_d = 0.50 * h_decoy.score + 0.30 * prox_d + 0.20 * 0.9 - 0.06
    expect(joint_p > joint_d, f"joint should prefer production: {joint_p:.3f} vs {joint_d:.3f}")

    expect(path_score("src/app.rs", "src/app/layout.rs") >= 0.35, "stem-split affinity")

    dest_res = Resolution(
        locator=Locator(path="src/app/layout.rs", line=17),
        status="same",
        dest_path="src/app/layout.rs",
        dest_line=17,
        score=1.0,
        dest_text="pub fn seen_hunk_fingerprint(",
    )
    fake_dst = Snapshot(label="t", files={"src/app/layout.rs": ["", "", "pub fn seen_hunk_fingerprint("]})
    # line 17 is out of range in this stub; ident_bind falls back to dest_text
    fake_dst.files["src/app/layout.rs"] = ["x"] * 16 + ["pub fn seen_hunk_fingerprint("]
    got = ident_bind("error[E0599]: no method named seen_hunk_fingerprint", dest_res, fake_dst)
    expect(got is not None and got[1] == ("seen_hunk_fingerprint",), f"ident bind rustc: {got}")
    expect(got is not None and got[0].display == "no method named {}", f"ident tmpl: {got}")

    if failures:
        for f in failures:
            print(f"selftest FAIL: {f}", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


def collect_input_lines(args: argparse.Namespace) -> tuple[list[str], bool]:
    """Return (lines, from_files_or_stdin)."""
    if args.inputs:
        # If every arg is an existing file, read them as a log stream.
        if all(Path(a).is_file() for a in args.inputs):
            lines: list[str] = []
            for a in args.inputs:
                text = Path(a).read_text(encoding="utf-8", errors="replace")
                lines.extend(text.splitlines())
            return lines, True
        return list(args.inputs), False
    if sys.stdin.isatty():
        return [], False
    return sys.stdin.read().splitlines(), True


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    if args.selftest:
        return run_selftest()

    cwd = Path.cwd()
    git_root = None
    if args.from_dir is None or args.to_dir is None:
        start = args.repo if args.repo is not None else cwd
        git_root = discover_repo(start)
        if args.repo is not None:
            git_root = args.repo.resolve()
            if not (git_root / ".git").exists() and not (git_root / ".git").is_file():
                print(f"moor: {git_root} is not a git repo", file=sys.stderr)
                return 2

    src = load_snapshot(
        git_root=git_root,
        ref=None if args.from_dir is not None else args.from_ref,
        directory=args.from_dir,
        untracked=not args.cached_only,
        label=str(args.from_dir or args.from_ref or "worktree"),
    )
    dst = load_snapshot(
        git_root=git_root,
        ref=None if args.to_dir is not None else args.to_ref,
        directory=args.to_dir,
        untracked=not args.cached_only,
        label=str(args.to_dir or args.to_ref or "worktree"),
    )
    renames: dict[str, str] = {}
    if git_root is not None and args.from_dir is None and args.to_dir is None:
        if args.from_ref and args.to_ref:
            renames = rename_map(git_root, args.from_ref, args.to_ref)
        elif args.from_ref:
            renames = rename_map(git_root, args.from_ref, "HEAD")

    lines, stream_mode = collect_input_lines(args)
    if not lines:
        if sys.stdin.isatty() and not args.inputs:
            build_parser().print_help()
            return 2
        return 0

    known = union_paths(src, dst)
    recs = parse_records(lines, known, args.records)
    slip_cache: dict[tuple[str, int], Resolution] = {}
    bindings = [
        joint_bind(rec, src, dst, args.context, renames, args.min_score, slip_cache) for rec in recs
    ]

    annotate = args.annotate
    if annotate is None:
        annotate = bool(args.rewrite) and not args.no_annotate
    if args.no_annotate:
        annotate = False

    rewrite = args.rewrite or (stream_mode and not args.json and not args.porcelain and not args.map)

    if rewrite:
        # Rebuild the stream, record by record.
        for rec, b in zip(recs, bindings):
            rewritten_lines = []
            for line in rec.lines:
                locs = [r for r in b.resolutions if r.locator.span is not None]
                # Only apply resolutions whose span belongs to this line: we stored
                # spans against the line that produced them, so match by identity
                # of the locator objects that came from this record.
                line_locs = find_stdin_locators(line, known)
                line_res: list[Resolution] = []
                for loc in line_locs:
                    match = next(
                        (
                            r
                            for r in b.resolutions
                            if r.locator.path == loc.path and r.locator.line == loc.line
                        ),
                        None,
                    )
                    if match is None:
                        continue
                    line_res.append(
                        Resolution(
                            locator=loc,
                            status=match.status,
                            dest_path=match.dest_path,
                            dest_line=match.dest_line,
                            score=match.score,
                            note=match.note,
                            dest_text=match.dest_text,
                        )
                    )
                rewritten_lines.append(rewrite_line(line, line_res))
            if annotate:
                trailer = annotate_trailer(b)
                if trailer:
                    rewritten_lines[-1] = rewritten_lines[-1] + trailer
            for rl in rewritten_lines:
                print(rl)
        if args.map or args.json or args.porcelain:
            for b in bindings:
                if SKIP_STDIN_RE.match(b.message) and b.status == "miss":
                    continue
                if args.json:
                    print_json(b)
                elif args.porcelain:
                    print_porcelain(b)
                else:
                    print_human(b)
    else:
        for rec, b in zip(recs, bindings):
            raw = rec.lines[0] if rec.lines else ""
            if SKIP_STDIN_RE.match(strip_ansi(raw).rstrip()) and b.status == "miss" and not b.resolutions:
                continue
            if args.json:
                print_json(b)
            elif args.porcelain:
                print_porcelain(b)
            else:
                print_human(b)

    if args.strict:
        bad = any(b.status in {"miss"} or any(r.status == "unresolved" for r in b.resolutions) for b in bindings)
        if bad:
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
