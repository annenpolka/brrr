# inverse printf (unfmt kernel) + hole binding
# ---------------------------------------------------------------------------

def strip_ansi(s: str) -> str:
    return ANSI_RE.sub("", s)


def normalize_query(s: str) -> str:
    s = strip_ansi(s).replace("\r\n", "\n").replace("\r", "\n").strip()
    changed = True
    while changed and s:
        changed = False
        for rx in LOG_PREFIX_RES:
            n = rx.sub("", s)
            if n != s:
                s = n.lstrip()
                changed = True
    return s


def query_variants(q: str) -> list[tuple[str, float, str]]:
    q = normalize_query(q)
    if not q:
        return []
    out = [(q, 0.0, "full")]
    parts = re.split(r": ", q)
    if len(parts) > 1:
        for i in range(1, len(parts)):
            suf = ": ".join(parts[i:])
            if len(suf) >= MIN_STATIC_HOLE:
                out.append((suf, 0.04 * i, f"suffix:{i}"))
    for sep, name in ((" — ", "emdash"), (" - ", "dash")):
        if sep in q:
            suf = q.split(sep, 1)[1]
            if len(suf) >= MIN_STATIC_HOLE:
                out.append((suf, 0.05, name))
    seen: set[str] = set()
    uniq = []
    for item in out:
        if item[0] in seen:
            continue
        seen.add(item[0])
        uniq.append(item)
    return uniq


def unescape_basic(s: str) -> str:
    out = []
    i = 0
    n = len(s)
    escapes = {"n": "\n", "t": "\t", "r": "\r", "0": "\0", "\\": "\\", '"': '"', "'": "'", "`": "`"}
    while i < n:
        if s[i] == "\\" and i + 1 < n:
            nxt = s[i + 1]
            if nxt == "(":
                out.append("\\(")
                i += 2
                continue
            if nxt in escapes:
                out.append(escapes[nxt])
                i += 2
                continue
            if nxt == "x" and i + 3 < n:
                try:
                    out.append(chr(int(s[i + 2 : i + 4], 16)))
                    i += 4
                    continue
                except ValueError:
                    pass
            out.append(nxt)
            i += 2
            continue
        out.append(s[i])
        i += 1
    return "".join(out)


def _matching_brace(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return i
        elif ch in {'"', "'"}:
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _matching_paren(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
        elif ch in {'"', "'"}:
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _is_format_hole(s: str, i: int) -> tuple[int, str] | None:
    if i >= len(s) or s[i] != "{":
        return None
    n = len(s)
    j = i + 1
    if j < n and s[j] in '{"[ \n\t':
        return None
    if j < n and s[j] == "}":
        return j + 1, ""
    if j < n and s[j].isdigit():
        while j < n and s[j].isdigit():
            j += 1
    elif j < n and (s[j].isalpha() or s[j] == "_"):
        while j < n and (s[j].isalnum() or s[j] in "_."):
            j += 1
    name = s[i + 1 : j]
    if j < n and s[j] == ":":
        k = s.find("}", j)
        if k < 0:
            return None
        return k + 1, name
    if j < n and s[j] == "}":
        return j + 1, name
    return None


def swift_hole_name(inner: str) -> str:
    inner = inner.strip()
    if "," in inner:
        inner = inner.split(",", 1)[0].strip()
    return inner or "expr"


def swift_string_value(raw: str) -> str:
    s = SWIFT_CONTINUATION_RE.sub("", raw)
    if "\n" not in s:
        return s
    if s.startswith("\n"):
        s = s[1:]
    lines = s.split("\n")
    while lines and not lines[-1].strip():
        lines.pop()
    while lines and not lines[0].strip():
        lines.pop(0)
    nonempty = [ln for ln in lines if ln.strip()]
    if nonempty:
        cut = min(len(ln) - len(ln.lstrip(" \t")) for ln in nonempty)
        lines = [ln[cut:] if len(ln) >= cut else ln for ln in lines]
    return "\n".join(lines).strip()


def looks_like_data_literal(body: str, holes: int) -> bool:
    if holes:
        return False
    s = body.strip()
    if len(s) >= MAX_NOHOLE_CHARS:
        return True
    if DATA_LITERAL_RE.match(s) and (":" in s or "," in s):
        return True
    return False


def tokenize_template(s: str) -> tuple[tuple[str, ...], tuple[str, ...]]:
    buf: list[str] = []
    parts: list[str] = []
    holes: list[str] = []
    unnamed = 0
    i = 0
    n = len(s)

    def flush() -> None:
        parts.append("".join(buf))
        buf.clear()

    def next_unnamed() -> str:
        nonlocal unnamed
        name = str(unnamed)
        unnamed += 1
        return name

    while i < n:
        if s.startswith("{{", i):
            buf.append("{")
            i += 2
            continue
        if s.startswith("}}", i):
            buf.append("}")
            i += 2
            continue
        if s.startswith("%%", i):
            buf.append("%")
            i += 2
            continue
        if s.startswith("${", i):
            end = _matching_brace(s, i + 1)
            if end is not None:
                flush()
                inner = s[i + 2 : end]
                holes.append(inner.strip() or next_unnamed())
                i = end + 1
                continue
        if s.startswith("\\(", i):
            end = _matching_paren(s, i + 1)
            if end is not None:
                flush()
                inner = s[i + 2 : end]
                holes.append(swift_hole_name(inner))
                i = end + 1
                continue
        if s[i] == "{":
            got = _is_format_hole(s, i)
            if got is not None:
                end, name = got
                flush()
                holes.append(name if name else next_unnamed())
                i = end
                continue
        m = PRINTF_RE.match(s, i)
        if m:
            if m.group(0) == "%%":
                buf.append("%")
                i = m.end()
                continue
            flush()
            holes.append(next_unnamed())
            i = m.end()
            continue
        buf.append(s[i])
        i += 1
    flush()
    return tuple(parts), tuple(holes)


def _line_starts(text: str) -> list[int]:
    starts = [0]
    for i, ch in enumerate(text):
        if ch == "\n":
            starts.append(i + 1)
    return starts


def _linecol(starts: list[int], index: int) -> tuple[int, int]:
    lo, hi = 0, len(starts) - 1
    while lo <= hi:
        mid = (lo + hi) // 2
        if starts[mid] <= index:
            lo = mid + 1
        else:
            hi = mid - 1
    line_idx = hi
    return line_idx + 1, index - starts[line_idx] + 1


def _skip_line_comment(text: str, i: int) -> int:
    n = len(text)
    while i < n and text[i] != "\n":
        i += 1
    return i


def _skip_block_comment(text: str, i: int) -> int:
    n = len(text)
    i += 2
    while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
        i += 1
    return min(n, i + 2)


def _read_quoted(text: str, i: int, quote: str) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    start = i
    while i < n:
        ch = text[i]
        if ch == "\\":
            i += 2
            continue
        if ch == quote:
            return i + 1, text[start:i]
        if ch == "\n" and quote != "`":
            return None
        i += 1
    return None


def _read_raw_hash(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    hashes = 0
    while i < n and text[i] == "#":
        hashes += 1
        i += 1
    if i >= n or text[i] != '"':
        return None
    i += 1
    start = i
    close = '"' + ("#" * hashes)
    while i < n:
        if text.startswith(close, i):
            return i + len(close), text[start:i]
        i += 1
    return None


def _read_triple(text: str, i: int, quote: str) -> tuple[int, str] | None:
    delim = quote * 3
    if not text.startswith(delim, i):
        return None
    i += 3
    start = i
    n = len(text)
    while i + 2 < n:
        if text.startswith(delim, i):
            return i + 3, text[start:i]
        i += 1
    return None


def _read_js_template(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    chunks: list[str] = []
    last = i
    depth_expr = 0
    in_expr = False
    while i < n:
        ch = text[i]
        if not in_expr:
            if ch == "\\":
                i += 2
                continue
            if ch == "`":
                chunks.append(text[last:i])
                return i + 1, "".join(chunks)
            if ch == "$" and i + 1 < n and text[i + 1] == "{":
                chunks.append(text[last:i])
                chunks.append("${")
                i += 2
                last = i
                in_expr = True
                depth_expr = 1
                continue
            i += 1
            continue
        if ch == "{":
            depth_expr += 1
        elif ch == "}":
            depth_expr -= 1
            if depth_expr == 0:
                chunks.append(text[last:i])
                chunks.append("}")
                i += 1
                last = i
                in_expr = False
                continue
        elif ch in {'"', "'", "`"}:
            q = ch
            i += 1
            while i < n:
                if text[i] == "\\":
                    i += 2
                    continue
                if text[i] == q:
                    i += 1
                    break
                i += 1
            continue
        i += 1
    return None


def extract_templates(text: str, lang: str, path: str) -> list[Template]:
    starts = _line_starts(text)
    n = len(text)
    i = 0
    out: list[Template] = []
    any_lang = lang in {"any", ""}
    rustish = lang == "rust" or any_lang
    pyish = lang == "py" or any_lang
    jsish = lang == "js" or any_lang
    goish = lang == "go" or any_lang
    hash_comment = lang in {"py", "sh", "rb"}

    def emit(raw_inner: str, at: int, unesc: bool) -> None:
        body = raw_inner
        if lang == "swift" or (any_lang and ("\\(" in body or "\\\n" in body)):
            body = swift_string_value(body)
        if unesc:
            body = unescape_basic(body)
        if not body or body.isspace():
            return
        if body.endswith("\r\n"):
            body = body[:-2]
        elif body.endswith("\n"):
            body = body[:-1]
        if len(body.strip()) < MIN_STATIC_EXACT:
            return
        parts, holes = tokenize_template(body)
        if looks_like_data_literal(body, len(holes)):
            return
        if not holes and sum(len(p) for p in parts) < MIN_STATIC_EXACT:
            return
        line, col = _linecol(starts, at)
        out.append(
            Template(
                path=path,
                line=line,
                col=col,
                lang=lang if lang and lang != "any" else (lang_for(path) or "any"),
                raw=body,
                parts=parts,
                holes=holes,
            )
        )

    while i < n:
        ch = text[i]
        if hash_comment and ch == "#":
            i = _skip_line_comment(text, i)
            continue
        if lang != "py" and ch == "/" and i + 1 < n:
            if text[i + 1] == "/":
                i = _skip_line_comment(text, i)
                continue
            if text[i + 1] == "*":
                i = _skip_block_comment(text, i)
                continue
        if rustish and ch in {"r", "b", "c"}:
            j = i
            if text[j] in {"b", "c"}:
                j += 1
            if j < n and text[j] == "r":
                j += 1
                got = _read_raw_hash(text, j)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=False)
                    i = end
                    continue
        if pyish and ch.isalpha():
            j = i
            while j < n and text[j] in "rRfFbBuU":
                j += 1
            if j > i and j < n and text[j] in {'"', "'"}:
                is_raw = any(c in "rR" for c in text[i:j])
                if text.startswith(text[j] * 3, j):
                    got = _read_triple(text, j, text[j])
                else:
                    got = _read_quoted(text, j, text[j])
                if got:
                    end, inner = got
                    emit(inner, i, unesc=not is_raw)
                    i = end
                    continue
        if (goish or jsish) and ch == "`":
            if jsish or "${" in text[i : i + 400]:
                got = _read_js_template(text, i)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=True)
                    i = end
                    continue
            if goish:
                j = text.find("`", i + 1)
                if j >= 0:
                    emit(text[i + 1 : j], i, unesc=False)
                    i = j + 1
                    continue
        if ch in {'"', "'"} and text.startswith(ch * 3, i):
            got = _read_triple(text, i, ch)
            if got:
                end, inner = got
                emit(inner, i, unesc=True)
                i = end
                continue
        if ch == '"' or (ch == "'" and lang in {"js", "py", "sh", "rb", "go", "java", "kt", "c", "any", ""}):
            got = _read_quoted(text, i, ch)
            if got:
                end, inner = got
                emit(inner, i, unesc=True)
                i = end
                continue
        i += 1
    return out


def match_template(tmpl: Template, query: str) -> tuple[float, str, str, tuple[str, ...]] | None:
    parts = tmpl.parts
    static = tmpl.static_len
    n_holes = tmpl.n_holes
    if n_holes == 0:
        body = parts[0] if parts else ""
        if body == query:
            return 1.0, "", "", ()
        if query.startswith(body) and static >= MIN_STATIC_PREFIX:
            return min(0.93, 0.55 + static / max(len(query), 1) * 0.4), "", query[len(body) :], ()
        idx = query.find(body)
        if idx >= 0 and static >= MIN_STATIC_INFIX:
            prefix = query[:idx]
            suffix = query[idx + len(body) :]
            coverage = static / max(len(query), 1)
            if coverage < 0.25 and static < 24:
                return None
            return min(0.88, 0.4 + coverage * 0.5), prefix, suffix, ()
        return None

    min_static = MIN_STATIC_HOLE
    if n_holes >= 2 and any(len(p) >= 4 for p in parts):
        min_static = 5
    if static < min_static:
        return None

    values: list[str] = []
    prefix = ""
    pos = 0
    first_static = True
    for i, part in enumerate(parts):
        is_last = i == len(parts) - 1
        if part == "":
            if is_last:
                values.append(query[pos:])
                pos = len(query)
            continue
        idx = query.find(part, pos)
        if idx < 0:
            return None
        if first_static:
            prefix = query[:idx]
            if len(part) < 4 and static < 16:
                return None
            first_static = False
            if i > 0:
                values.append(query[pos:idx])
        else:
            values.append(query[pos:idx])
        pos = idx + len(part)
    suffix = query[pos:] if pos <= len(query) else ""
    if parts and parts[-1] and len(suffix) > max(24, static):
        return None
    if len(values) != n_holes:
        if len(values) < n_holes and parts[-1] == "":
            pass
        elif len(values) != n_holes:
            return None

    coverage = static / max(len(query), 1)
    explained = static / max(static + len(prefix) + (0 if parts[-1] == "" else len(suffix)), 1)
    score = 0.42 * min(coverage, 1.0) + 0.38 * explained + 0.20 * min(static / 40.0, 1.0)
    if parts[-1] == "":
        score += 0.04
    if len(prefix) > static * 2 and len(prefix) > 20:
        score -= 0.12
    return min(score, 0.99), prefix, suffix, tuple(values)


def score_query(tmpl: Template, query: str) -> THit | None:
    best: THit | None = None
    for variant, penalty, tag in query_variants(query):
        got = match_template(tmpl, variant)
        if got is None:
            continue
        score, prefix, suffix, values = got
        score = max(0.0, score - penalty)
        if best is None or score > best.score:
            best = THit(
                template=tmpl,
                score=score,
                variant=tag,
                prefix=prefix,
                suffix=suffix,
                values=values,
            )
    return best


def search_templates(
    templates: list[Template],
    query: str,
    min_score: float,
    limit: int,
) -> list[THit]:
    q = normalize_query(query)
    if not q:
        return []
    hits: list[THit] = []
    for tmpl in templates:
        hit = score_query(tmpl, q)
        if hit is None or hit.score < min_score:
            continue
        hits.append(hit)
    hits.sort(
        key=lambda h: (
            -h.score,
            is_test_path(h.template.path),
            -h.template.static_len,
            h.template.path,
            h.template.line,
        )
    )
    return hits[:limit]


