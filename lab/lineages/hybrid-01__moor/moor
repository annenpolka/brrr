# records + joint bind
# ---------------------------------------------------------------------------

def payload_after_locators(text: str, locators: list[Locator]) -> str:
    if not locators:
        return normalize_query(text)
    chars = list(text)
    for loc in sorted([l for l in locators if l.span], key=lambda l: l.span[0], reverse=True):  # type: ignore[index]
        s, e = loc.span  # type: ignore[misc]
        chars[s:e] = []
    leftover = "".join(chars)
    leftover = re.sub(r"^[\s:.\->#]*", "", leftover)
    leftover = re.sub(r"[\s:]+$", "", leftover)
    return normalize_query(leftover)


def parse_records(lines: list[str], known: Iterable[str], mode: str) -> list[LogRecord]:
    if mode == "line":
        recs = []
        for i, line in enumerate(lines):
            locs = find_stdin_locators(line, known)
            recs.append(
                LogRecord(
                    lines=[line],
                    start=i,
                    locators=locs,
                    message=payload_after_locators(line, locs),
                )
            )
        return recs

    recs: list[LogRecord] = []
    i = 0
    n = len(lines)
    known_list = list(known)
    while i < n:
        line = lines[i]
        pm = PANIC_AT_RE.search(strip_ansi(line))
        if pm:
            rec = LogRecord(lines=[line], start=i, locators=find_stdin_locators(line, known_list))
            if i + 1 < n and lines[i + 1].strip() and not PANIC_AT_RE.search(strip_ansi(lines[i + 1])):
                rec.lines.append(lines[i + 1])
                rec.message = normalize_query(lines[i + 1])
                i += 2
            else:
                rec.message = payload_after_locators(line, rec.locators)
                i += 1
            recs.append(rec)
            continue
        if PY_TB_RE.search(line):
            rec = LogRecord(lines=[line], start=i, locators=find_stdin_locators(line, known_list))
            j = i + 1
            while j < n and (
                lines[j].startswith(" ")
                or lines[j].startswith("\t")
                or PY_TB_RE.search(lines[j])
            ):
                rec.lines.append(lines[j])
                rec.locators.extend(find_stdin_locators(lines[j], known_list))
                j += 1
            if j < n:
                em = EXC_RE.match(strip_ansi(lines[j]).strip())
                if em:
                    rec.lines.append(lines[j])
                    rec.message = normalize_query(em.group(2) or lines[j])
                    j += 1
            if not rec.message:
                rec.message = payload_after_locators(" ".join(rec.lines), rec.locators)
            recs.append(rec)
            i = j
            continue
        stripped = strip_ansi(line).lstrip()
        if ERROR_START_RE.match(stripped) or stripped.startswith("error["):
            rec = LogRecord(lines=[line], start=i, locators=find_stdin_locators(line, known_list))
            rec.message = payload_after_locators(line, rec.locators) or normalize_query(line)
            j = i + 1
            while j < n:
                nxt = lines[j]
                ns = strip_ansi(nxt)
                if ns.strip() == "":
                    break
                if ERROR_START_RE.match(ns.lstrip()) or ns.lstrip().startswith("error["):
                    break
                lead = ns.lstrip()
                if lead.startswith("-->") or lead.startswith("|") or lead.startswith("..."):
                    rec.lines.append(nxt)
                    rec.locators.extend(find_stdin_locators(nxt, known_list))
                    j += 1
                    continue
                break
            recs.append(rec)
            i = j
            continue
        locs = find_stdin_locators(line, known_list)
        recs.append(
            LogRecord(
                lines=[line],
                start=i,
                locators=locs,
                message=payload_after_locators(line, locs),
            )
        )
        i += 1
    return recs


def proximity(res: Resolution, tmpl: Template) -> float:
    if res.status in {"deleted", "unresolved"} or not res.dest_path or res.dest_line is None:
        return 0.0
    if res.dest_path == tmpl.path:
        d = abs(res.dest_line - tmpl.line)
        if d == 0:
            return 1.0
        if d <= 2:
            return 0.88
        if d <= 8:
            return 0.62
        return 0.38
    return 0.28 * path_score(res.dest_path, tmpl.path)


def src_proximity(loc: Locator, tmpl: Template) -> float:
    if loc.path != tmpl.path:
        return 0.28 * path_score(loc.path, tmpl.path)
    d = abs(loc.line - tmpl.line)
    if d == 0:
        return 1.0
    if d <= 2:
        return 0.88
    if d <= 8:
        return 0.62
    return 0.38


def dest_line_text(res: Optional[Resolution], dst: Snapshot) -> Optional[str]:
    if res is None or not res.dest_path or res.dest_line is None:
        return None
    lines = dst.files.get(res.dest_path)
    if not lines or res.dest_line < 1 or res.dest_line > len(lines):
        return None
    return lines[res.dest_line - 1]


def ident_bind(
    message: str,
    res: Resolution,
    dst: Snapshot,
) -> Optional[tuple[Template, tuple[str, ...]]]:
    """Bind a compiler-diagnostic name to the dest line it now lives on."""
    if res.status in {"deleted", "unresolved"} or not res.dest_path or res.dest_line is None:
        return None
    line = dest_line_text(res, dst) or res.dest_text
    if not line:
        return None
    line_toks = set(tokens(line))
    q = normalize_query(message)
    if not q:
        return None
    for rx, display in DIAG_HOLE_RES:
        m = rx.search(q)
        if not m:
            continue
        name = m.group(1)
        if name not in line_toks and name not in line:
            continue
        parts, holes = tokenize_template(display)
        tmpl = Template(
            path=res.dest_path,
            line=res.dest_line,
            col=res.locator.col or 1,
            lang="diag",
            raw=display,
            parts=parts,
            holes=holes,
        )
        return tmpl, (name,)
    # Rare shared identifier: message names a token that lives on the dest line.
    msg_toks = [t for t in tokens(q) if len(t) >= 6]
    shared = [t for t in msg_toks if t in line_toks]
    if len(shared) != 1:
        return None
    name = shared[0]
    tmpl = Template(
        path=res.dest_path,
        line=res.dest_line,
        col=res.locator.col or 1,
        lang="diag",
        raw="{}",
        parts=("", ""),
        holes=("0",),
    )
    return tmpl, (name,)


def format_holes(tmpl: Template, values: tuple[str, ...]) -> str:
    bits = []
    for i, name in enumerate(tmpl.holes):
        val = values[i] if i < len(values) else ""
        bits.append(f"{name}={val}")
    return " ".join(bits)


def joint_bind(
    rec: LogRecord,
    src: Snapshot,
    dst: Snapshot,
    ctx: int,
    renames: dict[str, str],
    min_score: float,
    slip_cache: dict[tuple[str, int], Resolution],
) -> Binding:
    resolutions: list[Resolution] = []
    for loc in rec.locators:
        key = (loc.path, loc.line)
        if key in slip_cache:
            base = slip_cache[key]
            resolutions.append(
                Resolution(
                    locator=loc,
                    status=base.status,
                    dest_path=base.dest_path,
                    dest_line=base.dest_line,
                    score=base.score,
                    note=base.note,
                    dest_text=base.dest_text,
                )
            )
        else:
            res = resolve_locator(loc, src, dst, ctx, renames)
            slip_cache[key] = res
            resolutions.append(res)

    msg = rec.message
    if not msg:
        for line in rec.lines:
            if SKIP_STDIN_RE.match(strip_ansi(line).rstrip()):
                continue
            p = payload_after_locators(line, find_stdin_locators(line, src.paths))
            if p:
                msg = p
                break

    dest_hits = search_templates(dst.templates, msg, min_score, limit=24) if msg else []
    src_hits = search_templates(src.templates, msg, min_score, limit=16) if msg else []

    best: Optional[tuple[float, THit, str, Optional[Resolution]]] = None

    def consider(hit: THit, via: str, res: Optional[Resolution], extra: float) -> None:
        nonlocal best
        slip_s = res.score if res and res.status not in {"deleted", "unresolved"} else 0.0
        prox = proximity(res, hit.template) if res else 0.0
        test_pen = 0.06 if is_test_path(hit.template.path) else 0.0
        joint = 0.50 * hit.score + 0.30 * prox + 0.20 * slip_s + extra - test_pen
        # A locator that agrees with the template is the hybrid signal.
        if prox >= 0.85:
            joint += 0.12
        if best is None or joint > best[0]:
            best = (joint, hit, via, res)

    for hit in dest_hits:
        if resolutions:
            for res in resolutions:
                consider(hit, "joint", res, 0.0)
        else:
            consider(hit, "template", None, 0.0)

    # Source templates near the original locator, then slip that berth.
    for hit in src_hits:
        for loc in rec.locators:
            sp = src_proximity(loc, hit.template)
            if sp < 0.5:
                continue
            key = (hit.template.path, hit.template.line)
            if key in slip_cache:
                res = slip_cache[key]
            else:
                tloc = Locator(path=hit.template.path, line=hit.template.line)
                res = resolve_locator(tloc, src, dst, ctx, renames)
                slip_cache[key] = res
            consider(hit, "src-slip", res, 0.08 * sp)

    loc_res = next(
        (r for r in resolutions if r.status not in {"deleted", "unresolved"} and r.dest_path),
        None,
    )
    del_res = next((r for r in resolutions if r.status == "deleted"), None)

    if best is None:
        if loc_res:
            ident = ident_bind(msg, loc_res, dst)
            if ident:
                tmpl, values = ident
                return Binding(
                    status="bound",
                    from_path=loc_res.locator.path,
                    from_line=loc_res.locator.line,
                    dest_path=loc_res.dest_path,
                    dest_line=loc_res.dest_line,
                    dest_col=loc_res.locator.col,
                    slip_status=loc_res.status,
                    slip_score=loc_res.score,
                    tmpl=tmpl,
                    match_score=0.8,
                    joint_score=min(1.2, 0.55 + 0.45 * loc_res.score),
                    via="ident",
                    values=values,
                    message=msg,
                    note=loc_res.note,
                    resolutions=resolutions,
                )
            return Binding(
                status="relocated",
                from_path=loc_res.locator.path,
                from_line=loc_res.locator.line,
                dest_path=loc_res.dest_path,
                dest_line=loc_res.dest_line,
                dest_col=loc_res.locator.col,
                slip_status=loc_res.status,
                slip_score=loc_res.score,
                joint_score=loc_res.score,
                via="locator",
                message=msg,
                note=loc_res.note,
                resolutions=resolutions,
            )
        if del_res:
            return Binding(
                status="deleted",
                from_path=del_res.locator.path,
                from_line=del_res.locator.line,
                slip_status="deleted",
                slip_score=del_res.score,
                via="locator",
                message=msg,
                note=del_res.note,
                resolutions=resolutions,
            )
        return Binding(status="miss", message=msg, via="", resolutions=resolutions)

    joint, hit, via, res = best
    dest_path = hit.template.path
    dest_line = hit.template.line
    dest_col = hit.template.col
    from_path = rec.locators[0].path if rec.locators else None
    from_line = rec.locators[0].line if rec.locators else None
    slip_st = ""
    slip_sc = 0.0
    if res and res.status not in {"deleted", "unresolved"}:
        # Prefer the template's own current berth; keep slipped site if different.
        if res.dest_path:
            slip_st = res.status
            slip_sc = res.score
            if via == "src-slip" and res.dest_path:
                dest_path = res.dest_path
                dest_line = res.dest_line or dest_line
        from_path = res.locator.path
        from_line = res.locator.line
    elif loc_res:
        slip_st = loc_res.status
        slip_sc = loc_res.score
        from_path = loc_res.locator.path
        from_line = loc_res.locator.line

    status = "bound" if (via in {"joint", "src-slip"} or loc_res) else "matched"
    if not rec.locators:
        status = "matched"
    if via == "joint" and loc_res:
        status = "bound"

    return Binding(
        status=status,
        from_path=from_path,
        from_line=from_line,
        dest_path=dest_path,
        dest_line=dest_line,
        dest_col=dest_col,
        slip_status=slip_st,
        slip_score=slip_sc,
        tmpl=hit.template,
        match_score=hit.score,
        joint_score=joint,
        via=via,
        values=hit.values,
        message=msg,
        note=hit.variant if hit.variant != "full" else "",
        resolutions=resolutions,
    )


# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------

def holes_text(b: Binding) -> str:
    if not b.tmpl:
        return ""
    return format_holes(b.tmpl, b.values)


def format_from(b: Binding) -> str:
    if b.from_path is None or b.from_line is None:
        return "-"
    return f"{b.from_path}:{b.from_line}"


def format_to(b: Binding) -> str:
    if b.dest_path is None or b.dest_line is None:
        return "-"
    col = f":{b.dest_col}" if b.dest_col else ""
    return f"{b.dest_path}:{b.dest_line}{col}"


def print_human(b: Binding) -> None:
    src = format_from(b)
    dst = format_to(b)
    arrow = "→"
    extra = f"  {b.note}" if b.note else ""
    print(f"{src:40} {arrow} {dst:40} {b.status:10} {b.joint_score:5.2f} via={b.via or '-'}{extra}")
    if b.tmpl:
        print(f"  tmpl:  {b.tmpl.display}")
        ht = holes_text(b)
        if ht:
            print(f"  holes: {ht}")
    if b.message:
        print(f"  log:   {b.message}")


def print_porcelain(b: Binding) -> None:
    tmpl = b.tmpl.display if b.tmpl else ""
    holes = holes_text(b).replace("\t", " ")
    note = (b.note or "").replace("\t", " ").replace("\n", " ")
    print(
        f"{b.status}\t{format_from(b)}\t{format_to(b)}\t{tmpl}\t{holes}\t"
        f"{b.joint_score:.3f}\t{b.via}\t{note}"
    )


def print_json(b: Binding) -> None:
    obj = {
        "status": b.status,
        "from": None if b.from_path is None else {"path": b.from_path, "line": b.from_line},
        "to": None if b.dest_path is None else {"path": b.dest_path, "line": b.dest_line, "col": b.dest_col},
        "template": b.tmpl.display if b.tmpl else None,
        "holes": (
            {name: (b.values[i] if i < len(b.values) else "") for i, name in enumerate(b.tmpl.holes)}
            if b.tmpl
            else {}
        ),
        "match_score": round(b.match_score, 4),
        "slip_score": round(b.slip_score, 4),
        "joint_score": round(b.joint_score, 4),
        "via": b.via,
        "slip_status": b.slip_status,
        "message": b.message,
        "note": b.note,
    }
    print(json.dumps(obj, ensure_ascii=False))


def annotate_trailer(b: Binding) -> str:
    if not b.tmpl or b.dest_path is None:
        return ""
    holes = holes_text(b)
    loc = format_to(b)
    if holes:
        return f"  ⟦{loc}  {b.tmpl.display}  {holes}⟧"
    return f"  ⟦{loc}  {b.tmpl.display}⟧"


