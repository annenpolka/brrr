HELP = """knot — wait-for conversation of a command line

A command line is both a pipeline and a process tree. One verb
reports who waited for whom across pipes AND child-wait / sleep /
fifo, then names the knot: the wait-source of the whole tree.

USAGE
  knot [opts] --sh 'cmd1 | cmd2 | cmd3'
  knot [opts] -- cmd1 + cmd2 + cmd3
  knot [opts] -- cmd [args...]
  knot selftest

OPTIONS
  --json              report as JSON
  --report PATH       write report to PATH ('-' = stdout). default: stderr
  --interval S        tree sample interval (default 0.08)
  --buf-size N        meter buffer bytes (default 65536)
  --label I=NAME      name stage I (repeatable)
  --sh SCRIPT         quote-aware split SCRIPT on |
  --timeout S         SIGTERM the tree after S seconds
  --ignore-exit       return 0 even if the child failed
  --expect-kind KIND  exit 2 if KIND absent from the conversation
  --expect-comm COMM  exit 2 if the knot's comm/cmd lacks COMM
  --no-lsof           skip fd joining
  --backend auto|ps|proc
  --meter / --wrap    internal
  -h, --help
  --version

`--` ends options (so `cargo test -- --list` stays one command).
A lone `+` separates pipeline stages.

EXAMPLES
  knot -- python3 fixtures/pipe_block.py 0.6
  knot -- python3 prod.py + python3 cons.py
  knot --json --report knot.json --sh 'cargo metadata --format-version 1 | jq .packages'
  knot -- cargo test --lib -- --list
"""


def parse_label_opt(raw: str) -> dict[int, str]:
    if "=" not in raw:
        raise SystemExit(f"knot: --label expects I=NAME, got {raw!r}")
    idx, name = raw.split("=", 1)
    try:
        return {int(idx): name}
    except ValueError:
        raise SystemExit(f"knot: --label index must be int, got {idx!r}") from None


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "--meter":
        p = argparse.ArgumentParser(add_help=False)
        p.add_argument("--meter", action="store_true")
        p.add_argument("--log", required=True)
        p.add_argument("--buf-size", type=int, default=DEFAULT_BUF)
        ns, _ = p.parse_known_args(argv)
        return run_meter(ns.log, ns.buf_size)
    if argv and argv[0] == "--wrap":
        p = argparse.ArgumentParser(add_help=False)
        p.add_argument("--wrap", action="store_true")
        p.add_argument("--log", required=True)
        p.add_argument("--buf-size", type=int, default=DEFAULT_BUF)
        ns, rest = p.parse_known_args(argv)
        if rest and rest[0] == "--":
            rest = rest[1:]
        return run_wrap(ns.log, rest)
    if not argv or argv[0] in {"-h", "--help"}:
        sys.stdout.write(HELP)
        return 0
    if argv[0] in {"--version", "-V"}:
        print(__version__)
        return 0
    if argv[0] == "selftest" or (argv[:2] in (["--", "selftest"],)):
        return selftest()

    json_out = False
    report_path: Optional[str] = None
    interval = DEFAULT_INTERVAL
    bufsize = DEFAULT_BUF
    labels: dict[int, str] = {}
    sh_script: Optional[str] = None
    timeout: Optional[float] = None
    ignore_exit = False
    expect_kind: list[str] = []
    expect_comm: list[str] = []
    use_fds = True
    backend_name = "auto"
    rest: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            json_out = True
        elif a == "--report":
            i += 1
            report_path = argv[i]
        elif a.startswith("--report="):
            report_path = a.split("=", 1)[1]
        elif a in {"-o", "--output"}:
            i += 1
            report_path = argv[i]
        elif a == "--interval":
            i += 1
            interval = float(argv[i])
        elif a.startswith("--interval="):
            interval = float(a.split("=", 1)[1])
        elif a == "--buf-size":
            i += 1
            bufsize = int(argv[i])
        elif a.startswith("--buf-size="):
            bufsize = int(a.split("=", 1)[1])
        elif a == "--label":
            i += 1
            labels.update(parse_label_opt(argv[i]))
        elif a.startswith("--label="):
            labels.update(parse_label_opt(a.split("=", 1)[1]))
        elif a == "--sh":
            i += 1
            sh_script = argv[i]
        elif a.startswith("--sh="):
            sh_script = a.split("=", 1)[1]
        elif a == "--timeout":
            i += 1
            timeout = float(argv[i])
        elif a.startswith("--timeout="):
            timeout = float(a.split("=", 1)[1])
        elif a == "--ignore-exit":
            ignore_exit = True
        elif a == "--expect-kind":
            i += 1
            expect_kind.append(argv[i])
        elif a.startswith("--expect-kind="):
            expect_kind.append(a.split("=", 1)[1])
        elif a == "--expect-comm":
            i += 1
            expect_comm.append(argv[i])
        elif a.startswith("--expect-comm="):
            expect_comm.append(a.split("=", 1)[1])
        elif a == "--no-lsof":
            use_fds = False
        elif a == "--backend":
            i += 1
            backend_name = argv[i]
        elif a == "--":
            rest.extend(argv[i:])
            break
        elif a.startswith("-"):
            print(f"knot: unknown option {a}", file=sys.stderr)
            return 2
        else:
            rest.extend(argv[i:])
            break
        i += 1

    backend = pick_backend(backend_name, use_fds)
    common = dict(
        json_out=json_out,
        report_path=report_path,
        interval=interval,
        timeout=timeout,
        backend=backend,
        ignore_exit=ignore_exit,
        expect_kind=expect_kind,
        expect_comm=expect_comm,
    )
    if sh_script is not None:
        parts = split_pipeline(sh_script)
        if not parts:
            print("knot: empty --sh script", file=sys.stderr)
            return 2
        stages = [stage_from_sh(p) for p in parts]
        return run_pipeline(stages, bufsize=bufsize, labels=labels, **common)
    if rest and rest[0] == "--":
        rest = rest[1:]
    stages = split_stages_from_argv(rest)
    if not stages:
        print("knot: no command", file=sys.stderr)
        return 2
    if len(stages) == 1:
        return run_single(stages[0], **common)
    return run_pipeline(stages, bufsize=bufsize, labels=labels, **common)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stderr.write("\nknot: interrupted\n")
        sys.exit(130)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except OSError:
            pass
        sys.exit(0)
