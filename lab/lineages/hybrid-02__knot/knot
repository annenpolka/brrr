def load_json(path: str) -> dict[str, Any]:
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}


def build_pipeline_script(stages: list[list[str]], meter_logs: list[str], wrap_logs: list[str], bufsize: int) -> str:
    self = knot_self()
    chunks: list[str] = []
    for i, argv in enumerate(stages):
        wrap = self + ["--wrap", "--log", wrap_logs[i], "--"] + argv
        chunks.append(" ".join(shell_quote(a) for a in wrap))
        if i < len(stages) - 1:
            meter = self + ["--meter", "--log", meter_logs[i], "--buf-size", str(bufsize)]
            chunks.append(" ".join(shell_quote(a) for a in meter))
    return "set -o pipefail; " + " | ".join(chunks)


def supervise(
    proc: subprocess.Popen,
    backend: Backend,
    interval: float,
    timeout: Optional[float],
) -> tuple[list[Sample], int]:
    root = proc.pid
    known: set[int] = {root}
    samples: list[Sample] = []
    stop = [False]
    sampler = threading.Thread(
        target=sample_loop,
        args=(backend, root, interval, known, samples, stop),
        daemon=True,
    )
    sampler.start()
    timed_out = False
    try:
        if timeout:
            try:
                proc.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                timed_out = True
                try:
                    os.killpg(root, signal.SIGTERM)
                except OSError:
                    proc.terminate()
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(root, signal.SIGKILL)
                    except OSError:
                        proc.kill()
                    proc.wait(timeout=1)
        else:
            proc.wait()
    except KeyboardInterrupt:
        try:
            os.killpg(root, signal.SIGTERM)
        except OSError:
            proc.terminate()
        raise
    finally:
        stop[0] = True
        sampler.join(timeout=0.6)
    rc = proc.poll()
    if rc is None:
        rc = 124 if timed_out else 1
    return samples, rc


def annotate_from_stages(per: dict[int, dict[str, Any]], stages: list[dict[str, Any]]) -> None:
    """Recover names macOS ps drops (`Python`, `<defunct>`) from wrap argv."""
    stage_label: dict[int, str] = {}
    stage_comm: dict[int, str] = {}
    for st in stages:
        pid = st.get("pid")
        if not pid:
            continue
        argv_s = " ".join(st.get("argv") or [])
        label = st.get("label") or argv_s
        comm = Path((st.get("argv") or ["?"])[0]).name
        stage_label[pid] = label
        stage_comm[pid] = comm
        if pid in per and weak_name(per[pid].get("cmd") or ""):
            per[pid]["cmd"] = argv_s or label
            per[pid]["comm"] = comm
    ppid_of = {b["pid"]: int(b.get("ppid") or 0) for b in per.values()}
    for pid, b in per.items():
        if pid in stage_label:
            continue
        if not weak_name(b.get("cmd") or ""):
            continue
        cur = int(b.get("ppid") or 0)
        seen = {pid}
        while cur and cur not in seen:
            seen.add(cur)
            if cur in stage_label:
                b["cmd"] = f"{stage_label[cur]} [child]"
                if weak_name(b.get("comm") or ""):
                    b["comm"] = stage_comm.get(cur) or b.get("comm")
                break
            cur = ppid_of.get(cur) or 0


def assemble_report(
    *,
    samples: list[Sample],
    stages: list[dict[str, Any]],
    links: list[dict[str, Any]],
    wall_s: float,
    rc: int,
    command: Any,
    instrument_pids: Optional[set[int]] = None,
) -> dict[str, Any]:
    tree_edges, per = fold_tree(samples)
    for pid in instrument_pids or ():
        if pid in per:
            per[pid]["instrument"] = True
    # attach stage pids to per if wrap saw them but samples missed
    for st in stages:
        pid = st.get("pid")
        if pid and pid not in per:
            per[pid] = {
                "pid": pid,
                "ppid": 0,
                "cmd": " ".join(st.get("argv") or []) or st.get("label") or "",
                "comm": default_label(st.get("argv") or []).split()[0] if st.get("argv") else st.get("label"),
                "running_s": 0.0,
                "blocked_s": float(st.get("wall_s") or 0),
                "alive_s": float(st.get("wall_s") or 0),
                "last_state": "?",
                "instrument": False,
                "user_wrapper": False,
            }
        elif pid and pid in per:
            if weak_name(per[pid].get("cmd") or "") and st.get("argv"):
                per[pid]["cmd"] = " ".join(st["argv"])
                per[pid]["comm"] = Path(st["argv"][0]).name
    annotate_from_stages(per, stages)
    conv = merge_conversation(tree_edges, per, stages, links)
    conv = retarget_stage_roots(conv, per, stages)
    knot = find_knot(conv, per, stages, wall_s)
    conversation = [edge_dict(e, per) for e in sorted(conv, key=lambda x: -x.s)]
    procs = [
        {
            "pid": b["pid"],
            "ppid": b["ppid"],
            "comm": b["comm"],
            "cmd": short_cmd(b["cmd"]),
            "running_s": round(b["running_s"], 3),
            "blocked_s": round(b["blocked_s"], 3),
            "instrument": bool(b.get("instrument")),
            "user_wrapper": bool(b.get("user_wrapper")),
        }
        for b in sorted(per.values(), key=lambda x: -(x["blocked_s"] + x["running_s"]))[:40]
    ]
    return {
        "tool": "knot",
        "version": __version__,
        "command": command,
        "wall_s": round(wall_s, 3),
        "exit": rc,
        "samples": len(samples),
        "knot": knot,
        "conversation": conversation,
        "graph": conversation,
        "stages": stages,
        "links": links,
        "procs": procs,
    }


def run_pipeline(
    stages_argv: list[list[str]],
    *,
    json_out: bool,
    report_path: Optional[str],
    interval: float,
    bufsize: int,
    labels: dict[int, str],
    timeout: Optional[float],
    backend: Backend,
    ignore_exit: bool,
    expect_kind: list[str],
    expect_comm: list[str],
) -> int:
    tmp = tempfile.mkdtemp(prefix="knot-")
    meter_logs = [os.path.join(tmp, f"m{i}.json") for i in range(max(0, len(stages_argv) - 1))]
    wrap_logs = [os.path.join(tmp, f"s{i}.json") for i in range(len(stages_argv))]
    script = build_pipeline_script(stages_argv, meter_logs, wrap_logs, bufsize)
    t0 = time.monotonic()
    proc = subprocess.Popen(
        ["bash", "-c", script],
        stdin=sys.stdin,
        stdout=sys.stdout,
        stderr=sys.stderr,
        start_new_session=True,
    )
    samples, rc = supervise(proc, backend, interval, timeout)
    wall_s = time.monotonic() - t0
    harvested: list[dict[str, Any]] = []
    instrument_pids: set[int] = set()
    for i, argv in enumerate(stages_argv):
        wrap = load_json(wrap_logs[i])
        if wrap.get("wrap_pid"):
            instrument_pids.add(int(wrap["wrap_pid"]))
        label = labels.get(i) or default_label(argv)
        cpu = float(wrap.get("ru_utime") or 0) + float(wrap.get("ru_stime") or 0)
        st_wall = ns_to_s(wrap.get("wall_ns"))
        harvested.append(
            {
                "i": i,
                "argv": argv,
                "label": label,
                "exit": wrap.get("exit"),
                "pid": wrap.get("pid"),
                "wall_s": st_wall,
                "ru_utime": wrap.get("ru_utime"),
                "ru_stime": wrap.get("ru_stime"),
                "cpu_s": cpu,
                "cpu_frac": (cpu / st_wall) if st_wall > 0 else None,
            }
        )
    links: list[dict[str, Any]] = []
    for i, path in enumerate(meter_logs):
        m = load_json(path)
        if m.get("meter_pid"):
            instrument_pids.add(int(m["meter_pid"]))
        links.append(
            {
                "from": i,
                "to": i + 1,
                "bytes": int(m.get("bytes") or 0),
                "reads": int(m.get("reads") or 0),
                "writes": int(m.get("writes") or 0),
                "read_stall_s": ns_to_s(m.get("read_stall_ns")),
                "write_stall_s": ns_to_s(m.get("write_stall_ns")),
                "both_stall_s": ns_to_s(m.get("both_stall_ns")),
                "copy_s": ns_to_s(m.get("copy_ns")),
                "wall_s": ns_to_s(m.get("wall_ns")),
                "epipe": bool(m.get("epipe")),
                "read_eof": bool(m.get("read_eof")),
            }
        )
    report = assemble_report(
        samples=samples,
        stages=harvested,
        links=links,
        wall_s=wall_s,
        rc=rc,
        command=[" | ".join(" ".join(a) for a in stages_argv)],
        instrument_pids=instrument_pids,
    )
    body = json.dumps(report, indent=2) + "\n" if json_out else render_human(report)
    write_report(body, report_path, json_out)
    return _finish(report, rc, ignore_exit, expect_kind, expect_comm)


def run_single(
    argv: list[str],
    *,
    json_out: bool,
    report_path: Optional[str],
    interval: float,
    timeout: Optional[float],
    backend: Backend,
    ignore_exit: bool,
    expect_kind: list[str],
    expect_comm: list[str],
) -> int:
    t0 = time.monotonic()
    try:
        proc = subprocess.Popen(argv, start_new_session=True)
    except FileNotFoundError:
        print(f"knot: not found: {argv[0]}", file=sys.stderr)
        return 127
    samples, rc = supervise(proc, backend, interval, timeout)
    wall_s = time.monotonic() - t0
    stages = [
        {
            "i": 0,
            "argv": argv,
            "label": default_label(argv),
            "exit": rc,
            "pid": proc.pid,
            "wall_s": wall_s,
            "cpu_s": None,
            "cpu_frac": None,
        }
    ]
    report = assemble_report(
        samples=samples,
        stages=stages,
        links=[],
        wall_s=wall_s,
        rc=rc,
        command=argv,
    )
    body = json.dumps(report, indent=2) + "\n" if json_out else render_human(report)
    write_report(body, report_path, json_out)
    return _finish(report, rc, ignore_exit, expect_kind, expect_comm)


def _finish(report: dict[str, Any], rc: int, ignore_exit: bool, expect_kind: list[str], expect_comm: list[str]) -> int:
    kinds = {e.get("kind") for e in report.get("conversation") or []}
    kinds |= {e.get("kind") for e in report.get("graph") or []}
    kinds |= set(report.get("knot", {}).get("via") or [])
    if expect_kind:
        missing = [k for k in expect_kind if k not in kinds]
        if missing:
            print(f"knot: expected kind {missing} not observed; saw {sorted(kinds)}", file=sys.stderr)
            return 2
    if expect_comm:
        comm = (report.get("knot") or {}).get("comm") or ""
        cmd = (report.get("knot") or {}).get("cmd") or ""
        blob = f"{comm} {cmd}".lower()
        for c in expect_comm:
            if c.lower() not in blob:
                print(f"knot: expected comm {c!r} not in knot {comm!r} {cmd!r}", file=sys.stderr)
                return 2
    return 0 if ignore_exit else int(rc if rc is not None else 1)


