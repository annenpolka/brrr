def fold_tree(samples: list[Sample]) -> tuple[list[Edge], dict[int, dict[str, Any]]]:
    per: dict[int, dict[str, Any]] = {}
    edge_w: dict[tuple[int, int, str], Edge] = {}
    if not samples:
        return [], per

    def bucket(p: Proc) -> dict[str, Any]:
        b = per.get(p.pid)
        if not b:
            b = {
                "pid": p.pid,
                "ppid": p.ppid,
                "cmd": p.cmd,
                "comm": p.comm,
                "running_s": 0.0,
                "blocked_s": 0.0,
                "alive_s": 0.0,
                "last_state": p.state,
                "instrument": is_instrument(p),
                "user_wrapper": is_user_wrapper(p),
            }
            per[p.pid] = b
        b["cmd"] = prefer_cmd(b["cmd"], p.cmd)
        if not weak_name(p.comm) and (weak_name(b["comm"]) or len(p.comm or "") >= len(b["comm"] or "")):
            b["comm"] = p.comm or b["comm"]
        b["last_state"] = p.state
        b["instrument"] = b["instrument"] or is_instrument(p)
        b["user_wrapper"] = b["user_wrapper"] or is_user_wrapper(p)
        return b

    for i, s in enumerate(samples):
        dt = (s.t - samples[i - 1].t) if i else 0.0
        if dt < 0:
            dt = 0.0
        for p in s.procs:
            b = bucket(p)
            b["alive_s"] += dt
            if p.running:
                b["running_s"] += dt
            elif not p.zombie:
                b["blocked_s"] += dt
        for e in s.edges:
            key = (e.src, e.dst, e.kind)
            w = edge_w.get(key)
            if not w:
                w = Edge(src=e.src, dst=e.dst, kind=e.kind, detail=e.detail, peer_cmd=e.peer_cmd, s=0.0, source="tree")
                edge_w[key] = w
            w.s += dt
            w.detail = e.detail or w.detail
            w.peer_cmd = e.peer_cmd or w.peer_cmd
    return list(edge_w.values()), per


def classify_link(link: dict[str, Any]) -> None:
    rs, ws = link["read_stall_s"], link["write_stall_s"]
    if ws >= rs and ws > 0.005:
        link["relation"] = "blocked-on-write"
        link["toward"] = link["to"]
    elif rs > ws and rs > 0.005:
        link["relation"] = "blocked-on-read"
        link["toward"] = link["from"]
    else:
        link["relation"] = "flowing"
        link["toward"] = None


def merge_conversation(
    tree_edges: list[Edge],
    per: dict[int, dict[str, Any]],
    stages: list[dict[str, Any]],
    links: list[dict[str, Any]],
) -> list[Edge]:
    """Meters and tree edges become one wait-for graph.

    A meter stall is a pipe conversation with real seconds. Tree edges
    add child-wait / fifo / tcp / hidden pipes. Instrument processes
    (--wrap/--meter) are contracted so a stage's wait lands on the
    command, not on our scaffolding.
    """
    instrument = {pid for pid, b in per.items() if b.get("instrument")}
    out: list[Edge] = []
    meter_pairs: set[tuple[int, int]] = set()

    def cmd_of(pid: int) -> str:
        if pid == 0:
            return "kernel"
        b = per.get(pid)
        if b:
            return short_cmd(b.get("cmd") or b.get("comm") or "", 42)
        for st in stages:
            if st.get("pid") == pid:
                return st.get("label") or ""
        return f"pid {pid}"

    for lk in links:
        classify_link(lk)
        sp = stages[lk["from"]].get("pid") if lk["from"] < len(stages) else None
        dp = stages[lk["to"]].get("pid") if lk["to"] < len(stages) else None
        if not sp or not dp:
            continue
        rel = lk.get("relation")
        if rel == "blocked-on-write":
            src, dst, kind, s = sp, dp, "pipe-full", float(lk["write_stall_s"])
        elif rel == "blocked-on-read":
            src, dst, kind, s = dp, sp, "pipe-empty", float(lk["read_stall_s"])
        else:
            continue
        if s < 0.005:
            continue
        out.append(
            Edge(
                src=src,
                dst=dst,
                kind=kind,
                s=s,
                detail=f"{lk.get('bytes', 0)}B",
                peer_cmd=cmd_of(dst),
                source="meter",
            )
        )
        meter_pairs.add((min(src, dst), max(src, dst)))

    for e in tree_edges:
        if e.src in instrument or (e.dst and e.dst in instrument):
            continue
        if e.kind.startswith("pipe") and (min(e.src, e.dst), max(e.src, e.dst)) in meter_pairs:
            continue
        if e.s < 0.02 and e.kind in {"sleep", "wchan"}:
            continue
        e.peer_cmd = e.peer_cmd or cmd_of(e.dst)
        e.source = e.source or "tree"
        out.append(e)
    return out


def _kids(per: dict[int, dict[str, Any]]) -> dict[int, list[int]]:
    kids: dict[int, list[int]] = defaultdict(list)
    for pid, b in per.items():
        kids[int(b.get("ppid") or 0)].append(pid)
    return kids


def retarget_stage_roots(
    edges: list[Edge],
    per: dict[int, dict[str, Any]],
    stages: list[dict[str, Any]],
) -> list[Edge]:
    """A meter names a stage pid. If that pid only child-waits, the
    wait-source of the pipe is the descendant — retarget dst/src.
    """
    by_src: dict[int, list[Edge]] = defaultdict(list)
    for e in edges:
        by_src[e.src].append(e)
    stage_pids = {st.get("pid") for st in stages if st.get("pid")}

    def sink_pid(pid: int) -> int:
        return walk_blocker(pid, by_src, per, set())

    rewritten: list[Edge] = []
    for e in edges:
        src, dst = e.src, e.dst
        note = e.detail
        if e.source == "meter":
            if dst in stage_pids:
                sunk = sink_pid(dst) or dst
                if sunk != dst:
                    note = ((note + " ") if note else "") + "via child-wait"
                dst = sunk
            if src in stage_pids:
                src_sink = sink_pid(src)
                outs = [x for x in by_src.get(src, []) if x.kind == "child-wait" and x.dst]
                if outs and src_sink and src_sink != src:
                    src = src_sink
                    note = ((note + " ") if note else "") + "via child-wait"
        rewritten.append(
            Edge(
                src=src,
                dst=dst,
                kind=e.kind,
                s=e.s,
                detail=note,
                peer_cmd=e.peer_cmd,
                source=e.source,
            )
        )
    return rewritten


def walk_blocker(
    pid: int,
    by_src: dict[int, list[Edge]],
    per: dict[int, dict[str, Any]],
    seen: set[int],
) -> int:
    if pid in seen or pid == 0:
        return pid
    seen = seen | {pid}
    outs = [e for e in by_src.get(pid, []) if e.dst and e.dst != pid]
    if not outs:
        return pid
    b = per.get(pid) or {}
    # A running process is a wait-source even if it also has child-wait
    # edges from a brief fork. Prefer compute unless the only outgoing
    # tree wait is child-wait *and* the process is mostly blocked.
    running = float(b.get("running_s") or 0)
    blocked = float(b.get("blocked_s") or 0)
    specific = [e for e in outs if e.kind in SPECIFIC_KINDS]
    child = [e for e in outs if e.kind == "child-wait"]
    if specific:
        pool = specific
    elif child:
        best_c = max(child, key=lambda e: e.s)
        ch = per.get(best_c.dst) or {}
        ch_run = float(ch.get("running_s") or 0)
        ch_blk = float(ch.get("blocked_s") or 0)
        comm = (b.get("comm") or "")
        inner = (
            b.get("user_wrapper")
            or b.get("instrument")
            or comm in INNER_WRAPPERS
            or comm in USER_WRAPPER_COMMS
            or blocked >= running
            or (ch_run > 0 and ch_run >= running * 0.4)
            or (ch_run + ch_blk) >= (running + blocked) * 0.55
        )
        if inner:
            pool = child
        else:
            return pid
    else:
        return pid
    best = max(pool, key=lambda e: e.s)
    nxt = best.dst
    if nxt in seen:
        return _cycle_pick(seen | {nxt}, by_src)
    return walk_blocker(nxt, by_src, per, seen)


def _cycle_pick(members: set[int], by_src: dict[int, list[Edge]]) -> int:
    specific: list[Edge] = []
    for pid in members:
        for e in by_src.get(pid, []):
            if e.dst in members and e.kind in SPECIFIC_KINDS:
                specific.append(e)
    if specific:
        return max(specific, key=lambda e: e.s).dst
    return next(iter(members))


def find_knot(
    edges: list[Edge],
    per: dict[int, dict[str, Any]],
    stages: list[dict[str, Any]],
    wall_s: float,
) -> dict[str, Any]:
    by_src: dict[int, list[Edge]] = defaultdict(list)
    incoming: dict[int, float] = defaultdict(float)
    for e in edges:
        by_src[e.src].append(e)
        if e.dst:
            incoming[e.dst] += e.s * KIND_WEIGHT.get(e.kind, 1.0)
        else:
            incoming[e.src] += e.s * KIND_WEIGHT.get(e.kind, 1.0) * 0.5

    skip = {pid for pid, b in per.items() if b.get("instrument")}
    waiters = [e.src for e in edges if e.src not in skip]
    if not waiters and per:
        waiters = [pid for pid, b in per.items() if not b.get("instrument")]

    sinks: dict[int, float] = defaultdict(float)
    paths: dict[int, list[dict[str, Any]]] = {}
    for w in waiters:
        sink = walk_blocker(w, by_src, per, set())
        if sink in skip or sink == 0:
            continue
        sinks[sink] += incoming.get(sink, 0.0) + 0.01
        if sink not in paths:
            paths[sink] = _path_from(w, sink, by_src, per)

    if not sinks:
        # single sleeper / compute process
        cands = [b for b in per.values() if not b.get("instrument")]
        if not cands:
            return {"pid": None, "comm": None, "kind": "none", "reason": "no processes sampled", "path": []}
        top = max(cands, key=lambda b: (b["running_s"] + b["blocked_s"], b["running_s"]))
        kind = "compute" if top["running_s"] >= 0.35 * max(top["running_s"] + top["blocked_s"], 1e-9) else "wait"
        return {
            "pid": top["pid"],
            "comm": top["comm"],
            "cmd": short_cmd(top["cmd"], 80),
            "kind": kind,
            "incoming_s": 0.0,
            "reason": f"lone process looks {kind}-bound",
            "path": [{"pid": top["pid"], "cmd": short_cmd(top["cmd"], 50), "kind": None}],
            "via": [],
        }

    knot_pid = max(sinks, key=lambda p: (sinks[p], incoming.get(p, 0.0), -p))
    node = per.get(knot_pid) or {"pid": knot_pid, "comm": f"pid{knot_pid}", "cmd": "", "running_s": 0.0, "blocked_s": 0.0}
    run, blk = float(node.get("running_s") or 0), float(node.get("blocked_s") or 0)
    kind = "compute" if run >= 0.35 * max(run + blk, wall_s * 0.2, 1e-9) else "wait"
    path = paths.get(knot_pid) or [{"pid": knot_pid, "cmd": short_cmd(node.get("cmd") or "", 50), "kind": None}]
    via = [p["kind"] for p in path if p.get("kind")]
    waiters_on = [e for e in edges if e.dst == knot_pid]
    waited = sorted({short_cmd((per.get(e.src) or {}).get("cmd") or e.peer_cmd or "", 32) for e in waiters_on})
    who = ", ".join(waiters_on_s for waiters_on_s in waited if waiters_on_s)[:80]
    reason = f"wait-source of the tree ({kind}"
    if who:
        reason += f"; {who} waited here"
    if via:
        reason += f"; via {' · '.join(via)}"
    reason += ")"
    label = None
    for st in stages:
        if st.get("pid") == knot_pid:
            label = st.get("label")
    return {
        "pid": knot_pid,
        "comm": node.get("comm"),
        "cmd": short_cmd(node.get("cmd") or "", 80),
        "label": label,
        "kind": kind,
        "incoming_s": round(sum(e.s for e in waiters_on), 3),
        "running_s": round(run, 3),
        "blocked_s": round(blk, 3),
        "reason": reason,
        "path": path,
        "via": via,
    }


def _path_from(start: int, sink: int, by_src: dict[int, list[Edge]], per: dict[int, dict[str, Any]]) -> list[dict[str, Any]]:
    path = [{"pid": start, "cmd": short_cmd((per.get(start) or {}).get("cmd") or "", 50), "kind": None}]
    seen = {start}
    cur = start
    for _ in range(16):
        if cur == sink:
            break
        outs = [e for e in by_src.get(cur, []) if e.dst and e.dst not in seen]
        if not outs:
            break
        specific = [e for e in outs if e.kind in SPECIFIC_KINDS]
        e = max(specific or outs, key=lambda x: x.s)
        path.append(
            {
                "pid": e.dst,
                "cmd": short_cmd((per.get(e.dst) or {}).get("cmd") or "", 50),
                "kind": e.kind,
                "s": round(e.s, 3),
            }
        )
        seen.add(e.dst)
        cur = e.dst
    if path[-1]["pid"] != sink:
        path.append({"pid": sink, "cmd": short_cmd((per.get(sink) or {}).get("cmd") or "", 50), "kind": "walk"})
    return path


def edge_dict(e: Edge, per: dict[int, dict[str, Any]]) -> dict[str, Any]:
    src_cmd = short_cmd((per.get(e.src) or {}).get("cmd") or "", 42)
    if e.dst:
        dst_cmd = short_cmd((per.get(e.dst) or {}).get("cmd") or e.peer_cmd or "", 42)
    else:
        dst_cmd = "kernel"
    return {
        "src": e.src,
        "dst": e.dst,
        "kind": e.kind,
        "s": round(e.s, 3),
        "detail": e.detail,
        "src_cmd": src_cmd,
        "dst_cmd": dst_cmd,
        "source": e.source,
    }


