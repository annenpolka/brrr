def fmt_bytes(n: int) -> str:
    if n < 1024:
        return f"{n}B"
    if n < 1024**2:
        return f"{n / 1024:.1f}KB"
    if n < 1024**3:
        return f"{n / 1024 ** 2:.2f}MB"
    return f"{n / 1024 ** 3:.2f}GB"


def bar(frac: float, width: int = 12) -> str:
    frac = max(0.0, min(1.0, frac))
    filled = int(round(frac * width))
    return "█" * filled + "░" * (width - filled)


def render_human(rep: dict[str, Any]) -> str:
    wall = rep.get("wall_s") or 0.0
    rc = rep.get("exit")
    knot = rep.get("knot") or {}
    lines = [
        f"knot {rep.get('version', __version__)}   wall {wall:.3f}s   exit {rc}",
        "",
    ]
    if knot.get("pid"):
        name = knot.get("label") or knot.get("cmd") or knot.get("comm") or f"pid {knot['pid']}"
        lines.append(f"KNOT  {name}")
        lines.append(
            f"      {knot.get('kind')} · incoming {knot.get('incoming_s', 0):.2f}s"
            f" · run {knot.get('running_s', 0):.2f}s  blocked {knot.get('blocked_s', 0):.2f}s"
        )
        if knot.get("reason"):
            lines.append(f"      {knot['reason']}")
        path = knot.get("path") or []
        if len(path) >= 2:
            bits = []
            for i, p in enumerate(path):
                lab = p.get("cmd") or f"pid {p.get('pid')}"
                if i == 0:
                    bits.append(lab)
                else:
                    bits.append(f"--{p.get('kind')} {p.get('s', 0):.2f}s--> {lab}")
            lines.append("      " + " ".join(bits))
    else:
        lines.append(f"KNOT  (none)  {knot.get('reason', '')}")
    conv = rep.get("conversation") or []
    lines.append("")
    lines.append("CONVERSATION  (waiter → blocker)")
    shown = [e for e in conv if e.get("kind") not in {"sleep", "wchan"} or e.get("s", 0) >= 0.12]
    if not shown:
        shown = conv[:8]
    if not shown:
        lines.append("  (no blocking relationship above noise)")
    else:
        for e in shown[:14]:
            dst = e.get("dst_cmd") or ("kernel" if not e.get("dst") else f"pid {e.get('dst')}")
            src = e.get("src_cmd") or f"pid {e.get('src')}"
            tag = "meter" if e.get("source") == "meter" else "tree"
            lines.append(
                f"  {e.get('kind', '?'):<12} {e.get('s', 0):6.2f}s  "
                f"{short_cmd(src, 28):<28} → {short_cmd(dst, 28)}  [{tag}]"
            )
    stages = rep.get("stages") or []
    links = rep.get("links") or []
    if len(stages) >= 2:
        lines.append("")
        lines.append("STAGES")
        knot_pid = knot.get("pid")
        for i, st in enumerate(stages):
            mark = "   ◀ contains knot" if knot_pid and st.get("pid") == knot_pid else ""
            cpu = st.get("cpu_s") or 0.0
            lines.append(f"  [{i}] {st.get('label', '?'):<40} cpu {cpu:6.3f}s{mark}")
            if i < len(links):
                lk = links[i]
                rel = lk.get("relation") or "?"
                who = ""
                if rel == "blocked-on-write":
                    who = f"  [{i}] waited on [{i + 1}]"
                elif rel == "blocked-on-read":
                    who = f"  [{i + 1}] waited on [{i}]"
                lines.append(
                    f"       │ {fmt_bytes(int(lk.get('bytes') or 0)):>8}  "
                    f"empty {lk.get('read_stall_s', 0):6.3f}s  "
                    f"full {lk.get('write_stall_s', 0):6.3f}s  {rel}{who}"
                )
    procs = [
        p
        for p in (rep.get("procs") or [])
        if not p.get("instrument") and "set -o pipefail" not in (p.get("cmd") or "")
    ]
    if procs:
        lines.append("")
        lines.append("TREE")
        named = knot.get("pid")
        for p in procs[:10]:
            tot = (p.get("running_s") or 0) + (p.get("blocked_s") or 0)
            frac = (p.get("running_s") or 0) / tot if tot else 0.0
            mark = "   ◀ knot" if p.get("pid") == named else ""
            lines.append(
                f"  {p.get('comm', '?'):<18} {bar(frac)} {frac:5.0%} run  "
                f"{short_cmd(p.get('cmd') or '', 36)}{mark}"
            )
    lines.append("")
    return "\n".join(lines)


def write_report(text: str, report_path: Optional[str], as_json: bool) -> None:
    if report_path is None:
        sys.stderr.write(text)
        if not text.endswith("\n"):
            sys.stderr.write("\n")
        return
    if report_path == "-":
        sys.stdout.write(text)
        if not text.endswith("\n"):
            sys.stdout.write("\n")
        return
    Path(report_path).write_text(text if text.endswith("\n") else text + "\n", encoding="utf-8")
    if as_json:
        sys.stderr.write(f"knot: wrote {report_path}\n")
    else:
        sys.stderr.write(text if text.endswith("\n") else text + "\n")


