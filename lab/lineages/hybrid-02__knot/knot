LSOF_PIPE_BLOB = """COMMAND   PID       USER   FD    TYPE             DEVICE   SIZE/OFF      NODE NAME
Python  10001 annenpolka    0r    REG               1,17        483 120267857 /tmp/in
Python  10001 annenpolka    5w    PIPE 0xaaa111          16384           ->0xbbb222
Python  10002 annenpolka    0r    REG               1,17        483 120267857 /tmp/in
Python  10002 annenpolka    4r    PIPE 0xbbb222          16384           ->0xaaa111
"""

PS_BLOB = """  PID  PPID  PGID   UID STAT WCHAN   RSS  %CPU COMMAND
10001 10000 10001  501 S    -      1000   0.0 python writer
10002 10001 10001  501 S    -      1000   0.0 python reader
"""


def selftest() -> int:
    fails: list[str] = []

    def check(name: str, cond: bool, detail: str = "") -> None:
        if not cond:
            fails.append(f"{name}: {detail}")

    ps = parse_ps_table(PS_BLOB)
    check("ps-count", len(ps) == 2, str(len(ps)))

    pipes = parse_lsof_text(LSOF_PIPE_BLOB)
    w = next(fd for fd in pipes[10001] if fd.type == "PIPE")
    r = next(fd for fd in pipes[10002] if fd.type == "PIPE")
    check("pipe-mode-w", w.mode == "w", w.mode)
    check("pipe-mode-r", r.mode == "r", r.mode)
    p_w = Proc(pid=10001, ppid=1, state="S", cmd="python writer", comm="python", fds=pipes[10001])
    p_r = Proc(pid=10002, ppid=10001, state="S", cmd="python reader", comm="python", fds=pipes[10002])
    edges = infer_edges([p_w, p_r])
    kinds = {(e.src, e.dst, e.kind) for e in edges}
    check("pipe-edge", (10002, 10001, "pipe-read") in kinds, str(kinds))

    same = Fd(fd="1", type="PIPE", mode="", name="->0xbbbb", local="0xaaaa", peer="0xbbbb", device="0xaaaa")
    parent = Proc(pid=10, ppid=1, state="S", cmd="cargo test", comm="cargo", fds=[same])
    child = Proc(pid=11, ppid=10, state="S", cmd="kizu-test", comm="kizu", fds=[same])
    e4 = infer_edges([parent, child])
    pipe_between = [e for e in e4 if e.kind.startswith("pipe") and {e.src, e.dst} == {10, 11}]
    check("no-inherited-pipe", pipe_between == [], str(e4))
    check("child-wait", any(e.src == 10 and e.dst == 11 and e.kind == "child-wait" for e in e4), str(e4))

    snapped = expand_tree(
        [
            Proc(pid=70, ppid=1, pgid=7, state="S", cmd="sleep", comm="sleep"),
            Proc(pid=7, ppid=1, pgid=7, state="S", cmd="zsh", comm="zsh"),
        ],
        70,
        set(),
    )
    check("snap-no-pgid-swallow", {p.pid for p in snapped} == {70}, str([p.pid for p in snapped]))

    # knot walk: just → cargo → rustc (sleep). knot is rustc, not cargo.
    just = Proc(pid=1, ppid=0, state="S", cmd="just spec-check", comm="just")
    cargo = Proc(pid=2, ppid=1, state="S", cmd="cargo test", comm="cargo")
    rustc = Proc(pid=3, ppid=2, state="S", cmd="rustc --crate kizu", comm="rustc")
    s0 = Sample(t=0.0, procs=[just, cargo, rustc], edges=[])
    s1 = Sample(
        t=1.0,
        procs=[just, cargo, rustc],
        edges=[
            Edge(src=1, dst=2, kind="child-wait", s=0),
            Edge(src=2, dst=3, kind="child-wait", s=0),
            Edge(src=3, dst=0, kind="sleep", s=0),
        ],
    )
    te, per = fold_tree([s0, s1])
    conv = merge_conversation(te, per, [], [])
    k = find_knot(conv, per, [], 1.0)
    check("walk-rustc", k.get("comm") == "rustc", str(k))
    check("via-child-wait", "child-wait" in (k.get("via") or []), str(k.get("via")))

    # jq pipe-empty on running cargo: knot is cargo (compute source)
    jq = Proc(pid=20, ppid=1, state="S", cmd="jq .packages", comm="jq")
    cargo_r = Proc(pid=21, ppid=1, state="R", cmd="cargo metadata", comm="cargo")
    s2 = Sample(t=0.0, procs=[jq, cargo_r], edges=[])
    s3 = Sample(t=2.0, procs=[jq, cargo_r], edges=[Edge(src=20, dst=21, kind="pipe-read")])
    te2, per2 = fold_tree([s2, s3])
    k2 = find_knot(merge_conversation(te2, per2, [], []), per2, [], 2.0)
    check("pipe-cargo", k2.get("comm") == "cargo", str(k2))

    # meter + child-wait: jq waited on cargo, cargo waited on rustc → knot rustc
    stages = [
        {"i": 0, "pid": 21, "label": "cargo metadata", "argv": ["cargo"]},
        {"i": 1, "pid": 20, "label": "jq", "argv": ["jq"]},
    ]
    links = [
        {
            "from": 0,
            "to": 1,
            "bytes": 100,
            "read_stall_s": 1.8,
            "write_stall_s": 0.0,
        }
    ]
    rustc2 = Proc(pid=22, ppid=21, state="R", cmd="rustc --crate foo", comm="rustc")
    cargo_s = Proc(pid=21, ppid=1, state="S", cmd="cargo metadata", comm="cargo")
    jq_s = Proc(pid=20, ppid=1, state="S", cmd="jq", comm="jq")
    s4 = Sample(t=0.0, procs=[cargo_s, jq_s, rustc2], edges=[])
    s5 = Sample(
        t=2.0,
        procs=[cargo_s, jq_s, rustc2],
        edges=[Edge(src=21, dst=22, kind="child-wait")],
    )
    te3, per3 = fold_tree([s4, s5])
    conv3 = merge_conversation(te3, per3, stages, links)
    conv3 = retarget_stage_roots(conv3, per3, stages)
    k3 = find_knot(conv3, per3, stages, 2.0)
    check("joint-rustc", k3.get("comm") == "rustc", str(k3))
    check("joint-via-pipe", any(e.kind in {"pipe-empty", "pipe-read"} for e in conv3), str([e.kind for e in conv3]))

    # cpu middle: both neighbors wait on it
    prod = Proc(pid=30, ppid=1, state="S", cmd="producer", comm="prod")
    cpu = Proc(pid=31, ppid=1, state="R", cmd="cpu_stage", comm="cpu_stage")
    cons = Proc(pid=32, ppid=1, state="S", cmd="consumer", comm="cons")
    stg = [
        {"i": 0, "pid": 30, "label": "prod", "argv": ["p"]},
        {"i": 1, "pid": 31, "label": "cpu_stage", "argv": ["c"]},
        {"i": 2, "pid": 32, "label": "cons", "argv": ["k"]},
    ]
    lks = [
        {"from": 0, "to": 1, "bytes": 10, "read_stall_s": 0.0, "write_stall_s": 0.8},
        {"from": 1, "to": 2, "bytes": 10, "read_stall_s": 0.7, "write_stall_s": 0.0},
    ]
    s6 = Sample(t=0.0, procs=[prod, cpu, cons], edges=[])
    s7 = Sample(t=1.0, procs=[prod, cpu, cons], edges=[])
    te4, per4 = fold_tree([s6, s7])
    conv4 = merge_conversation(te4, per4, stg, lks)
    k4 = find_knot(conv4, per4, stg, 1.0)
    check("cpu-middle", k4.get("comm") == "cpu_stage", str(k4))

    # node ran AND slept; pkl ran. Inner-wrapper walk names pkl.
    node_p = Proc(pid=40, ppid=1, state="R", cmd="node tools/spec-check", comm="node")
    pkl_p = Proc(pid=41, ppid=40, state="R", cmd="pkl eval spec.pkl", comm="pkl")
    sn0 = Sample(t=0.0, procs=[node_p, pkl_p], edges=[])
    node_s = Proc(pid=40, ppid=1, state="S", cmd="node tools/spec-check", comm="node")
    sn1 = Sample(t=0.5, procs=[node_p, pkl_p], edges=[Edge(src=40, dst=41, kind="child-wait")])
    sn2 = Sample(t=1.0, procs=[node_s, pkl_p], edges=[Edge(src=40, dst=41, kind="child-wait")])
    te5, per5 = fold_tree([sn0, sn1, sn2])
    k5 = find_knot(merge_conversation(te5, per5, [], []), per5, [], 1.0)
    check("inner-pkl", k5.get("comm") == "pkl", str(k5))

    # later <defunct> must not wipe cargo's name
    live = Proc(pid=50, ppid=1, state="S", cmd="cargo test --lib", comm="cargo")
    dead = Proc(pid=50, ppid=1, state="Z", cmd="<defunct>", comm="<defunct>")
    kid = Proc(pid=51, ppid=50, state="S", cmd="kizu-test", comm="kizu")
    sf0 = Sample(t=0.0, procs=[live, kid], edges=[])
    sf1 = Sample(
        t=1.0,
        procs=[dead, kid],
        edges=[Edge(src=50, dst=51, kind="child-wait")],
    )
    te6, per6 = fold_tree([sf0, sf1])
    check("keep-cargo-name", "cargo" in (per6[50]["cmd"] or ""), str(per6[50]))

    bash_wrap = Proc(
        pid=60,
        ppid=1,
        state="S",
        cmd="bash -c set -o pipefail; python3 knot --wrap --log /tmp/s0 -- cargo",
        comm="bash",
    )
    check("bash-not-instrument", not is_instrument(bash_wrap), bash_wrap.cmd)
    wrap_py = Proc(pid=61, ppid=60, state="S", cmd="python3 knot --wrap --log /tmp/s0 -- cargo", comm="python3")
    check("wrap-is-instrument", is_instrument(wrap_py), wrap_py.cmd)

    parts = split_pipeline("cat 'a | b' | gzip | wc -c")
    check("sh-split", parts == ["cat 'a | b'", "gzip", "wc -c"], str(parts))
    stg_argv = split_stages_from_argv(["cargo", "test", "--", "--list", "+", "jq"])
    check("plus-split", stg_argv == [["cargo", "test", "--", "--list"], ["jq"]], str(stg_argv))

    if fails:
        print("selftest FAILED", file=sys.stderr)
        for f in fails:
            print("  -", f, file=sys.stderr)
        return 1
    print("selftest ok")
    return 0


