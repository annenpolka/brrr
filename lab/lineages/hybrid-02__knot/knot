class Backend:
    def __init__(self, kind: str, use_fds: bool) -> None:
        self.kind = kind
        self.use_fds = use_fds

    def procs(self) -> list[Proc]:
        if self.kind == "proc":
            return run_procfs_procs()
        return run_ps()

    def fds(self, pids: list[int]) -> dict[int, list[Fd]]:
        if not self.use_fds or not pids:
            return {}
        if self.kind == "proc":
            got = run_procfs_fds(pids)
            extra = run_lsof(pids)
            for pid, fds in extra.items():
                if pid in got:
                    nets = [fd for fd in fds if fd.is_net()]
                    got[pid].extend(nets)
                else:
                    got[pid] = fds
            return got
        return run_lsof(pids)


def pick_backend(name: str, use_fds: bool) -> Backend:
    if name == "auto":
        name = "proc" if procfs_available() else "ps"
    return Backend(name, use_fds)


def take_sample(backend: Backend, root_pid: int, known: set[int], t0: float, want_fds: bool) -> Optional[Sample]:
    all_procs = backend.procs()
    if not all_procs:
        return None
    tree = expand_tree(all_procs, root_pid, known)
    if not tree:
        return None
    if want_fds:
        fdmap = backend.fds([p.pid for p in tree])
        for p in tree:
            p.fds = fdmap.get(p.pid, [])
    return Sample(t=time.monotonic() - t0, procs=tree, edges=infer_edges(tree))


def sample_loop(
    backend: Backend,
    root_pid: int,
    interval: float,
    known: set[int],
    sink: list[Sample],
    stop: list[bool],
) -> None:
    t0 = time.monotonic()
    last_lsof = -1.0
    lsof_every = max(0.28, interval)
    while not stop[0]:
        now = time.monotonic() - t0
        idle_guess = bool(sink) and sink[-1].procs and not any(p.running for p in sink[-1].procs)
        prev_n = len(sink[-1].procs) if sink else 0
        want_fds = prev_n <= 12 or idle_guess or not sink or (now - last_lsof >= lsof_every)
        s = take_sample(backend, root_pid, known, t0, want_fds)
        if s:
            if want_fds:
                last_lsof = now
            sink.append(s)
        time.sleep(interval)


