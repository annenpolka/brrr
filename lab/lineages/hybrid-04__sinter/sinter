def _member(firings: list[Firing], path: str) -> Member:
    for F in firings:
        for m in F.members:
            if m.path == path:
                return m
    raise AssertionError(f"missing member {path}")


def _firing(firings: list[Firing], parent: str) -> Firing:
    for F in firings:
        if F.id == parent or F.id.endswith(parent):
            return F
    raise AssertionError(f"missing firing {parent}: {[F.id for F in firings]}")


def selftest() -> int:
    fails: list[str] = []

    def ok(name: str, cond: bool, detail: str = "") -> None:
        if cond:
            print(f"  ok  {name}")
        else:
            fails.append(name)
            print(f"  FAIL {name}  {detail}")

    rec = extract_receipt(
        "docs/generated/SPEC.md",
        "<!-- Generated from specs/main.pkl. Do not edit. -->\n"
        "- Source fingerprint: `sha256:" + "ab" * 32 + "`\n",
        "SPEC.md",
    )
    ok(
        "strip trailing period in Generated from",
        rec is not None and rec.parent == "specs/main.pkl",
        str(rec),
    )
    rec = extract_receipt(
        "Engine/Tests/OraclesGenerated.swift",
        "// @generated by tools/spec-gen.ts from specs/tenaoshi.pkl — DO NOT EDIT\n",
        "OraclesGenerated.swift",
    )
    ok(
        "parse by-from",
        rec is not None
        and rec.generator == "tools/spec-gen.ts"
        and rec.parent == "specs/tenaoshi.pkl",
        str(rec),
    )
    rec = extract_receipt(
        "justfile",
        "# 仕様正本は specs/、生成物は docs/SPEC.md\n",
        "justfile",
    )
    ok("justfile is not a receipt", rec is None or rec.parent is None)

    with tempfile.TemporaryDirectory(prefix="sinter-ugly-") as td:
        root = Path(td)
        build_fixture(root)
        repo = Repo(root)
        members = assemble(repo)
        firings = assay(repo, members)
        paths = sorted(m.path for F in firings for m in F.members)
        ok("found a.md", "out/a.md" in paths, str(paths))
        ok("found b.md", "out/b.md" in paths)
        ok("found spec", "docs/SPEC.md" in paths)
        ok("unicode 計画.md", "out/計画.md" in paths)
        ok("recipe pulled extra/EPC-001.json", "extra/EPC-001.json" in paths, str(paths))
        ok("stamp-join caps.json", "out/caps.json" in paths, str(paths))
        ok("generated-md foo.generated.ts", "pkg/foo.generated.ts" in paths, str(paths))
        ok("skipped Cargo.lock", "Cargo.lock" not in paths, str(paths))
        ok("skipped justfile", "justfile" not in paths, str(paths))
        ok("skipped AGENTS.md", "AGENTS.md" not in paths, str(paths))

        a = _member(firings, "out/a.md")
        b = _member(firings, "out/b.md")
        extra = _member(firings, "extra/EPC-001.json")
        spec = _member(firings, "docs/SPEC.md")
        vanished = _member(firings, "out/vanished.generated.ts")
        lot = _firing(firings, "specs/root.pkl")

        ok("a.md CLEAN (refired)", a.verdict == "CLEAN", f"{a.verdict} {a.why}")
        ok("b.md STALE", b.verdict == "STALE", f"{b.verdict} {b.why}")
        ok("b.md why content or clock", b.why in {"content", "clock"}, b.why)
        ok("recipe-only via", extra.via == "recipe", extra.via)
        ok("recipe-only same firing as a.md", extra.firing == a.firing, extra.firing)
        ok("extra STALE with a CLEAN → lot RAGGED", lot.verdict == "RAGGED", lot.verdict)
        ok("lot why content", lot.why == "content", lot.why)
        ok("spec same parent", spec.parent == "specs/root.pkl", str(spec.parent))
        ok("a.md sees hidden.pkl", "specs/hidden.pkl" in a.imports, str(a.imports))
        ok("b.md content names hidden or root", any("hidden.pkl" in r.path or "root.pkl" in r.path for r in b.reasons), str(b.reasons))
        ok("vanished STALE (missing parent)", vanished.verdict == "STALE", vanished.verdict)
        ok("a.md via both or testimony", a.via in {"both", "testimony"}, a.via)

        why = format_human(firings, why_path="out/b.md")
        ok("why names hidden.pkl or root.pkl", "hidden.pkl" in why or "root.pkl" in why, why[:500])
        ok("why names siblings", "out/a.md" in why, why[:400])
        ok("tsv has recipe member", "extra/EPC-001.json" in format_tsv(firings))
        payload = json.loads(format_json(firings))
        ok("json firings", len(payload["firings"]) >= 1)

        # CLOCK on b.md: world mtimes backdated, b.md touched, content dated, not dirty
        ok("b.md clock or content (mtime may cluster)", b.why in {"clock", "content"}, b.why)
        # cluster should not be CLOCK (clustered mtimes with other.pkl)
        cluster = _member(firings, "out/cluster.generated.ts")
        ok("cluster STALE", cluster.verdict == "STALE", str(cluster.verdict))
        ok("cluster not why=clock", cluster.why != "clock", cluster.why)

    with tempfile.TemporaryDirectory(prefix="sinter-dirty-") as td:
        root = Path(td)
        subprocess.run(["git", "init", "-q", "-b", "main"], cwd=root, check=True)
        subprocess.run(["git", "config", "user.email", "sinter@test"], cwd=root, check=True)
        subprocess.run(["git", "config", "user.name", "sinter"], cwd=root, check=True)
        subprocess.run(["git", "config", "commit.gpgsign", "false"], cwd=root, check=True)
        (root / "specs").mkdir()
        (root / "out").mkdir()
        (root / "gen.py").write_text("# outputs:\n#   - out/a.md\n#   - out/b.md\n", encoding="utf-8")
        (root / "specs" / "root.pkl").write_text("value = 1\n", encoding="utf-8")
        (root / "out" / "a.md").write_text(
            "<!-- Generated from specs/root.pkl. Do not edit. -->\nA\n", encoding="utf-8"
        )
        (root / "out" / "b.md").write_text(
            "<!-- Generated from specs/root.pkl. Do not edit. -->\nB\n", encoding="utf-8"
        )
        _git_commit(root, "together", "2026-01-01T00:00:00+00:00")
        (root / "specs" / "root.pkl").write_text("value = 2\n", encoding="utf-8")
        repo = Repo(root)
        firings = assay(repo, assemble(repo))
        lot = _firing(firings, "specs/root.pkl")
        a = _member(firings, "out/a.md")
        ok("dirty-parent does not STALE members", a.verdict == "CLEAN", f"{a.verdict} {a.why} {a.reasons}")
        ok("dirty-parent lots RAGGED", lot.verdict == "RAGGED", lot.verdict)
        ok("dirty-parent why", lot.why == "dirty-parent", lot.why)
        ok("member why dirty-parent", a.why == "dirty-parent", a.why)

    if fails:
        print(f"selftest: {len(fails)} failed")
        return 1
    print("selftest: all passed")
    return 0


HELP = f"""sinter {VERSION} — fuse testimony + recipe, assay the firing.

A generated file claims a parent (receipt) and belongs to a firing (recipe).
sinter joins those two witnesses, then reports:

  CLEAN   one firing; world bytes match; parent not dirty
  RAGGED  siblings of one firing did not stay together (or regen is in flight)
  STALE   the claim does not hold for anyone in the lot

  why=content       parent / import / generator bytes moved since fire
  why=clock         mtime would call it fresh; content would rebuild
  why=dirty-parent  parent is dirty in the work tree; artifacts were not rewritten

Usage:
  sinter [-C dir] [-v] [--json|--tsv] [--check]
  sinter [-C dir] why PATH
  sinter --selftest
  sinter --write-fixture DIR

Exit: 0 ok, 1 --check findings, 2 usage.
"""


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-C", dest="root", default=".")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--tsv", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--selftest", action="store_true")
    parser.add_argument("--write-fixture", dest="fixture")
    parser.add_argument("--help", "-h", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("cmd", nargs="?", default="scan")
    parser.add_argument("path", nargs="?")
    args = parser.parse_args(argv)

    if args.help:
        sys.stdout.write(HELP)
        return 0
    if args.version:
        print(f"sinter {VERSION}")
        return 0
    if args.selftest or args.cmd == "selftest":
        return selftest()
    if args.fixture:
        dest = Path(args.fixture).resolve()
        build_fixture(dest)
        print(dest)
        return 0

    cmd = args.cmd
    why_path = None
    if cmd == "why":
        why_path = args.path
        if not why_path:
            eprint("sinter: why requires PATH")
            return 2
    elif cmd not in {"scan", "lots", None}:
        maybe = Path(args.root) / cmd
        if maybe.is_file() or cmd.endswith(
            (".ts", ".swift", ".rs", ".md", ".json", ".mbt")
        ):
            why_path = cmd
            cmd = "why"
        else:
            eprint(f"sinter: unknown command {cmd}")
            return 2

    root = Path(args.root).resolve()
    if not root.exists():
        eprint(f"sinter: {root} does not exist")
        return 2
    repo = Repo(root)
    firings = assay(repo, assemble(repo))

    if args.json:
        sys.stdout.write(format_json(firings))
    elif args.tsv:
        sys.stdout.write(format_tsv(firings))
    else:
        sys.stdout.write(format_human(firings, why_path=why_path, verbose=args.verbose))

    if args.check and any_check_fail(firings):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
