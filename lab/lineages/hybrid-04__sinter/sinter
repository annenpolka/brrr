    firing_verdict: str = "CLEAN"
    firing_why: str = "-"


@dataclass
class Firing:
    id: str
    parent: str | None
    generator: str | None
    members: list[Member] = field(default_factory=list)
    imports: list[str] = field(default_factory=list)
    verdict: str = "CLEAN"
    why: str = "-"
    parent_dirty: bool = False
    die: str | None = None


class Repo:
    def __init__(self, scan_root: Path):
        self.scan_root = scan_root.resolve()
        self.git_root = git_toplevel(self.scan_root)
        self.root = self.git_root or self.scan_root
        self.status = git_status_map(self.root) if self.git_root else {}
        self._blob_now: dict[str, str | None] = {}
        self._blob_at: dict[tuple[str, str], str | None] = {}

    def current_blob(self, rel: str) -> str | None:
        if rel not in self._blob_now:
            self._blob_now[rel] = git_hash_object(self.root, rel)
        return self._blob_now[rel]

    def blob_at(self, commit: str, rel: str) -> str | None:
        key = (commit, rel)
        if key not in self._blob_at:
            self._blob_at[key] = git_blob_at(self.root, commit, rel)
        return self._blob_at[key]


def collect_files(repo: Repo) -> list[str]:
    files: list[str] = []
    if repo.git_root is not None:
        rel_scan = "."
        try:
            rel_scan = str(repo.scan_root.resolve().relative_to(repo.root)).replace("\\", "/")
        except ValueError:
            rel_scan = "."
        prefix = "" if rel_scan in {".", ""} else rel_scan.rstrip("/") + "/"
        for rel in git_ls_files(repo.root):
            if prefix and not rel.startswith(prefix):
                continue
            if any(part in SKIP_DIRS for part in Path(rel).parts):
                continue
            if skip_named(Path(rel).name):
                continue
            files.append(rel)
        return files
    for dirpath, dirnames, filenames in os.walk(repo.scan_root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
        for name in filenames:
            if skip_named(name):
                continue
            p = Path(dirpath) / name
            try:
                rel = str(p.resolve().relative_to(repo.scan_root.resolve())).replace("\\", "/")
            except ValueError:
                continue
            files.append(rel)
    return files


def discover_receipts(repo: Repo) -> list[Receipt]:
    recs: list[Receipt] = []
    extra_maps: list[Receipt] = []
    for rel in collect_files(repo):
        if looks_generator(rel):
            continue
        path = repo.root / rel
        if not path.is_file():
            continue
        ext = path.suffix.lower()
        name_hit = looks_generated_name(rel)
        if not name_hit and ext not in HEADER_EXTS:
            continue
        try:
            if path.stat().st_size > 4_000_000:
                continue
        except OSError:
            continue
        head = decode_head(path)
        if Path(rel).name in {"GENERATED.md", "GENERATED.txt"}:
            m = RE_SOURCE_FIELD.search(head[:2000])
            if m:
                src = valid_parent(clean_path(m.group(1)))
                if src:
                    extra_maps.append(
                        Receipt(path=rel, parent=src, how="generated-md")
                    )
        rec = extract_receipt(rel, head, Path(rel).name)
        if rec is None:
            continue
        recs.append(rec)
    have = {r.path for r in recs}
    for extra in extra_maps:
        if extra.path not in have:
            recs.append(extra)
    return recs


def inherit_parents(root: Path, recs: list[Receipt]) -> None:
    stamp_parent: dict[str, str] = {}
    for rec in recs:
        if rec.stamp and rec.parent:
            parent, missing = resolve_parent(root, rec.parent, rec.path)
            if parent and not missing:
                stamp_parent[rec.stamp] = parent
    for rec in recs:
        if rec.parent is None and rec.stamp and rec.stamp in stamp_parent:
            rec.parent = stamp_parent[rec.stamp]
            rec.how = (rec.how or "header") + "+stamp-join"

    maps: list[tuple[str, str]] = []
    for rec in recs:
        if Path(rec.path).name in {"GENERATED.md", "GENERATED.txt"} and rec.parent:
            parent, missing = resolve_parent(root, rec.parent, rec.path)
            if parent and not missing:
                maps.append((str(Path(rec.path).parent), parent))
    for rec in recs:
        if rec.parent:
            continue
        for directory, parent in maps:
            prefix = "" if directory in {".", ""} else directory + "/"
            under = rec.path.startswith(prefix) or rec.path == directory or directory in {".", ""}
            if not under:
                continue
            name = Path(rec.path).name
            if looks_generated_name(rec.path) or name.endswith(".schema.json"):
                rec.parent = parent
                rec.how = (rec.how or "header") + "+generated-md"
                break


def infer_generators(root: Path, recs: list[Receipt]) -> list[str]:
    gens: list[str] = []
    for rec in recs:
        if rec.generator:
            gens.append(rec.generator)
    for extra in KNOWN_GENERATORS:
        if (root / extra).is_file():
            gens.append(extra)
    if (root / "tools/spec-gen").is_dir():
        gens.append("tools/spec-gen.ts" if (root / "tools/spec-gen.ts").is_file() else "tools/spec-gen")
    return unique(gens)


def build_world(root: Path, parent: str | None, generator: str | None) -> tuple[list[str], list[str], list[str]]:
    declared: list[str] = []
    imports: list[str] = []
    world: list[str] = []
    seen: set[str] = set()

    def wadd(p: str | None) -> None:
        if not p or p in seen:
            return
        seen.add(p)
        world.append(p)

    if parent:
        existing = resolve_existing(root, parent) or parent
        declared.append(existing)
        if (root / existing).is_file():
            for imp in walk_imports(root, existing):
                if imp != existing:
                    imports.append(imp)
                wadd(imp)
        else:
            wadd(existing)
    for g in expand_generator(root, generator):
        wadd(g)
    for imp in imports:
        wadd(imp)
    return unique(declared), unique(imports), world


def assemble(repo: Repo) -> list[Member]:
    recs = discover_receipts(repo)
    inherit_parents(repo.root, recs)
    gens = infer_generators(repo.root, recs)
    recipes = {g: scrape_recipe(repo.root, g) for g in gens}

    by_path: dict[str, Receipt] = {r.path: r for r in recs}
    recipe_of: dict[str, str] = {}
    recipe_sources: dict[str, list[str]] = {}
    for g, rec in recipes.items():
        srcs = [s for s in rec["sources"] if valid_parent(s)]
        recipe_sources[g] = srcs
        for o in rec["outputs"]:
            if looks_generator(o) or skip_named(Path(o).name):
                continue
            recipe_of[o] = g

    def parents_for_gen(g: str) -> list[str]:
        found: list[str] = []
        for rec in recs:
            if not rec.parent:
                continue
            if rec.generator == g or recipe_of.get(rec.path) == g:
                found.append(rec.parent)
        found.extend(recipe_sources.get(g) or [])
        return found

    # recipe-only members (headerless outputs: tenaoshi JSON cases).
    # A generator may serve more than one firing (gen.py → root.pkl and other.pkl);
    # attach mute outputs to the majority testimony parent, not the first sibling.
    have = set(by_path)
    for o, g in list(recipe_of.items()):
        if o in have:
            continue
        if not (repo.root / o).is_file():
            continue
        srcs = recipe_sources.get(g) or []
        parent = srcs[0] if len(set(srcs)) == 1 else None
        if parent is None:
            votes = parents_for_gen(g)
            if votes:
                parent = Counter(votes).most_common(1)[0][0]
        by_path[o] = Receipt(
            path=o,
            parent=parent,
            generator=g,
            how="recipe",
        )
        have.add(o)

    members: list[Member] = []
    for path, rec in by_path.items():
        gen = rec.generator
        if not gen:
            gen = recipe_of.get(path)
        parent = rec.parent
        recipe_src = None
        if gen and recipe_sources.get(gen):
            recipe_src = recipe_sources[gen][0]
            if parent is None:
                parent = recipe_src
        if parent:
            resolved, missing = resolve_parent(repo.root, parent, path)
            parent, parent_missing = resolved, missing
        else:
            parent_missing = False
        mismatch = None
        if parent and recipe_src:
            r_resolved, _m = resolve_parent(repo.root, recipe_src, path)
            if r_resolved != parent and valid_parent(recipe_src):
                mismatch = r_resolved
        via = "testimony"
        if rec.how == "recipe":
            via = "recipe"
        elif "stamp-join" in rec.how:
            via = "stamp-join"
        elif "generated-md" in rec.how:
            via = "generated-md"
        elif path in recipe_of:
            via = "both"
        declared, imports, world = build_world(repo.root, parent, gen)
        st = repo.status.get(path)
        untracked = st == "??"
        dirty = bool(st and st not in {""})
        if rec.conflicted:
            dirty = True
        members.append(
            Member(
                path=path,
                parent=parent,
                generator=gen,
                stamp=rec.stamp,
                how=rec.how,
                via=via,
                conflicted=rec.conflicted,
                untracked=untracked,
                parent_missing=parent_missing,
                mismatch=mismatch,
                declared=declared,
                imports=imports,
                world=world,
                mtime=file_mtime(repo.root / path),
                dirty=dirty,
            )
        )
    return members


def age_of(commits: dict[str, tuple[str, int]], artifact_sha: str | None, parent: str | None) -> int | None:
    """Parent commits after the artifact's fire. Cheap approximation: compare timestamps via log count later."""
    if not artifact_sha or not parent or parent not in commits:
        return None
    # filled in assay with git rev-list when needed
    return None


def assay(repo: Repo, members: list[Member]) -> list[Firing]:
    if not members:
        return []
    needed: set[str] = set()
    for m in members:
        needed.add(m.path)
        needed.update(m.world)
        if m.parent:
            needed.add(m.parent)
    commits = last_commits_batch(repo.root, needed) if repo.git_root else {}

    for m in members:
        if m.path in commits:
            m.fire_sha, m.fire_ct = commits[m.path]
        if m.parent and m.parent in repo.status and repo.status[m.parent] not in {"", "??"}:
            m.parent_dirty = True
        if m.parent and m.fire_sha and repo.git_root:
            p = run_git(
                repo.root,
                ["rev-list", "--count", f"{m.fire_sha}..HEAD", "--", m.parent],
            )
            if p.returncode == 0 and p.stdout.strip().isdigit():
                m.age = int(p.stdout.strip())

        parent_sha = None
        if m.parent and (repo.root / m.parent).is_file():
            parent_sha = hashlib.sha256((repo.root / m.parent).read_bytes()).hexdigest()
            parent_sha = "sha256:" + parent_sha
        if m.stamp and parent_sha:
            m.stamp_currency = "byte" if m.stamp == parent_sha else "die"
        elif m.stamp:
            m.stamp_currency = "die"

        reasons: list[Reason] = []
        dated = False
        world_mtimes: list[int] = []
        newest_world = None
        newest_ct = -1
        for wp in m.world:
            mt = file_mtime(repo.root / wp)
            if mt is not None:
                world_mtimes.append(mt)
            if wp in commits:
                _sha, ct = commits[wp]
                if ct >= newest_ct:
                    newest_ct = ct
                    newest_world = wp
            old = repo.blob_at(m.fire_sha, wp) if m.fire_sha else None
            new = repo.current_blob(wp)
            st = repo.status.get(wp)
            wp_dirty = bool(st and st not in {""})
            if m.fire_sha:
                if old != new:
                    if wp_dirty and (m.parent == wp or wp in m.declared):
                        if m.dirty:
                            detail = f"work tree {st or 'dirty'}; member also dirty"
                        else:
                            detail = f"work tree {st or 'dirty'}; artifact not rewritten"
                        reasons.append(Reason("dirty-parent", wp, detail))
                        m.parent_dirty = True
                    elif old is None and new:
                        dated = True
                        reasons.append(Reason("content", wp, "appeared since fire"))
                    elif new is None:
                        dated = True
                        reasons.append(Reason("content", wp, "gone since fire"))
                    elif wp_dirty:
                        reasons.append(
                            Reason("dirty-parent", wp, f"git {st}; bytes differ")
                        )
                        m.parent_dirty = True
                    else:
                        dated = True
                        reasons.append(Reason("content", wp, "bytes changed since fire"))
            else:
                if wp_dirty:
                    reasons.append(Reason("dirty-parent", wp, f"git {st or '??'}"))
                    m.parent_dirty = True
                elif wp in commits and m.fire_ct is not None and commits[wp][1] > m.fire_ct:
                    dated = True
                    reasons.append(
                        Reason(
                            "content",
                            wp,
                            f"source {fmt_ct(commits[wp][1])} after fire {fmt_ct(m.fire_ct)}",
                        )
                    )
        if m.parent_missing:
            dated = True
            reasons.append(Reason("content", m.parent or m.path, "cited parent is not in the tree"))

        art_mt = m.mtime
        max_wmt = max(world_mtimes) if world_mtimes else None
        clustered = (
            art_mt is not None
            and max_wmt is not None
            and abs(art_mt - max_wmt) <= CLOCK_SLACK
        )
        mtime_fresh = (
            art_mt is not None and max_wmt is not None and art_mt >= max_wmt - 1
        )
        clock = dated and mtime_fresh and not clustered and not m.dirty
        if clock:
            reasons.append(
                Reason(
                    "clock",
                    newest_world or (m.world[0] if m.world else m.path),
                    "mtime would call this fresh; content would rebuild",
                )
            )

        m.reasons = reasons
        if dated or m.parent_missing:
            m.verdict = "STALE"
            if clock:
                m.why = "clock"
            else:
                m.why = "content"
        else:
            m.verdict = "CLEAN"
            if m.parent_dirty:
                m.why = "dirty-parent"
            else:
                m.why = "-"

    groups: dict[str, list[Member]] = defaultdict(list)
    for m in members:
        key = m.parent or f"mute:{Path(m.path).parent}"
        m.firing = key
        groups[key].append(m)

    firings: list[Firing] = []
    for key, group in groups.items():
        group.sort(key=lambda x: (x.verdict != "STALE", x.path))
        stamps = [m.stamp for m in group if m.stamp]
        die = None
        if stamps:
            current = [m for m in group if m.stamp and m.verdict == "CLEAN"]
            pool = current or [m for m in group if m.stamp]
            pool_sorted = sorted(pool, key=lambda m: (m.fire_ct or 0, m.path), reverse=True)
            die = pool_sorted[0].stamp if pool_sorted else stamps[0]
        for m in group:
            m.die = die
            if (
                m.stamp
                and die
                and m.stamp != die
                and not m.conflicted
                and m.verdict == "CLEAN"
            ):
                m.verdict = "STALE"
                m.why = "content"
                m.reasons.append(Reason("content", m.path, "stamp is not the firing die"))

        n_stale = sum(1 for m in group if m.verdict == "STALE")
        n_clean = sum(1 for m in group if m.verdict == "CLEAN")
        parent_dirty = any(m.parent_dirty for m in group)
        fire_times = {m.fire_ct for m in group if m.fire_ct is not None}
        split = len(fire_times) > 1
        has_content = any(r.kind == "content" for m in group for r in m.reasons)
        has_clock = any(r.kind == "clock" for m in group for r in m.reasons)
        has_dirty = any(r.kind == "dirty-parent" for m in group for r in m.reasons)

        def pick_why() -> str:
            # clock is a member-level lie on top of content dating; the firing
            # why prefers the world (content) unless that is not the story.
            if has_content:
                return "content"
            if has_clock:
                return "clock"
            if has_dirty:
                return "dirty-parent"
            return "content"

        if n_stale and n_clean:
            fv, fw = "RAGGED", pick_why()
        elif n_stale:
            fv, fw = "STALE", pick_why()
        elif parent_dirty:
            fv, fw = "RAGGED", "dirty-parent"
        elif split:
            # git timestamps split but world bytes still match: inert siblings
            fv, fw = "RAGGED", "content"
        else:
            fv, fw = "CLEAN", "-"

        gens = [m.generator for m in group if m.generator]
        imports = unique([i for m in group for i in m.imports])
        firing = Firing(
            id=key,
            parent=None if key.startswith("mute:") else key,
            generator=gens[0] if gens else None,
            members=group,
            imports=imports,
            verdict=fv,
            why=fw,
            parent_dirty=parent_dirty,
            die=die,
        )
        for m in group:
            m.firing_verdict = fv
            m.firing_why = fw
        firings.append(firing)
    firings.sort(key=lambda f: (f.verdict == "CLEAN", f.id))
    return firings


