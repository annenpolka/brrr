def _is_primary_world(m: Member, path: str) -> bool:
    if path in m.declared or path == m.parent:
        return True
    gen = m.generator
    if not gen:
        return False
    if path == gen:
        return True
    stem_dir = str(Path(gen).with_suffix(""))
    if path.startswith(stem_dir.rstrip("/") + "/"):
        return True
    if Path(path).name == Path(gen).name:
        return True
    return False


def _common_dir(paths: list[str]) -> str:
    if not paths:
        return ""
    parts = [Path(p).parts[:-1] for p in paths]
    n = min((len(p) for p in parts), default=0)
    i = 0
    while i < n and all(p[i] == parts[0][i] for p in parts):
        i += 1
    return "/".join(parts[0][:i]) if i else str(Path(paths[0]).parent).replace("\\", "/")


def summarize_reasons(m: Member) -> list[str]:
    content = [r for r in m.reasons if r.kind == "content"]
    dirty = [r for r in m.reasons if r.kind == "dirty-parent"]
    clock = [r for r in m.reasons if r.kind == "clock"]
    primary_c = [r for r in content if _is_primary_world(m, r.path)]
    import_c = [r for r in content if r not in primary_c]
    primary_d = [r for r in dirty if _is_primary_world(m, r.path)]
    other_d = [r for r in dirty if r not in primary_d]
    gen_c, other_primary = [], []
    for r in primary_c:
        if m.generator and r.path != m.parent and r.path not in m.declared:
            gen_c.append(r)
        else:
            other_primary.append(r)
    out: list[str] = []
    for r in other_primary[:4]:
        out.append(f"           {r.kind} {r.path}  {r.detail}")
    if gen_c:
        if len(gen_c) == 1:
            out.append(f"           {gen_c[0].kind} {gen_c[0].path}  {gen_c[0].detail}")
        else:
            out.append(
                f"           content generator {m.generator} ({len(gen_c)} files) bytes changed since fire"
            )
    if import_c:
        ex = ", ".join(unique([r.path for r in import_c])[:2])
        out.append(f"           content {len(import_c)} undeclared import(s) (e.g. {ex})")
    for r in primary_d[:2]:
        out.append(f"           {r.kind} {r.path}  {r.detail}")
    if other_d and not primary_d:
        out.append(f"           dirty-parent {other_d[0].path}  {other_d[0].detail}")
    elif other_d:
        out.append(f"           dirty-parent {len(other_d)} more world file(s)")
    for r in clock[:1]:
        out.append(f"           {r.kind} {r.path}  {r.detail}")
    return out


def _fired_label(m: Member) -> str:
    if m.untracked or (m.fire_sha is None and m.dirty):
        return "untracked"
    return fmt_ct(m.fire_ct)


def _member_line(m: Member) -> str:
    extra = ""
    if m.via != "both":
        extra += f"  via={m.via}"
    if m.untracked:
        extra += "  untracked"
    elif m.dirty:
        extra += "  dirty"
    if m.conflicted:
        extra += "  conflicted"
    if m.mismatch:
        extra += f"  mismatch={m.mismatch}"
    return f"  {m.verdict:<6} {m.why:<13} {m.path}  fired {_fired_label(m)}{extra}"


def _emit_recipe_group(lines: list[str], ms: list[Member], verbose: bool) -> None:
    if not ms:
        return
    if len(ms) <= 2:
        for m in ms:
            lines.append(_member_line(m))
            if verbose:
                lines.extend(summarize_reasons(m))
        return
    d = _common_dir([m.path for m in ms]) or "."
    n_un = sum(1 for m in ms if m.untracked)
    u = f", {n_un} untracked" if n_un else ""
    lines.append(
        f"  {ms[0].verdict:<6} {ms[0].why:<13} {len(ms)} via=recipe under {d}/{u}"
    )
    lines.append(f"           e.g. {ms[0].path}")


def format_human(firings: list[Firing], why_path: str | None = None, verbose: bool = False) -> str:
    lines: list[str] = []
    if why_path:
        hit = None
        firing = None
        for F in firings:
            for m in F.members:
                if (
                    m.path == why_path
                    or m.path.endswith("/" + why_path)
                    or why_path.endswith(m.path)
                ):
                    hit, firing = m, F
                    break
            if hit:
                break
        if not hit or not firing:
            return f"sinter: no generated claim for {why_path}\n"
        lines.append(f"{hit.verdict}  {hit.path}  why={hit.why}")
        lines.append(f"  firing   {firing.verdict} why={firing.why}  {firing.id}")
        lines.append(f"  via      {hit.via}  how={hit.how}")
        lines.append(f"  parent   {hit.parent or '-'}")
        lines.append(f"  recipe   {hit.generator or '-'}")
        if hit.mismatch:
            lines.append(f"  mismatch testimony={hit.parent} recipe={hit.mismatch}")
        lines.append(f"  stamp    {hit.stamp or '-'}  die={hit.die or '-'}  currency={hit.stamp_currency or '-'}")
        lines.append(f"  fired    {fmt_ct(hit.fire_ct)}  {(hit.fire_sha or '-')[:12]}")
        lines.append(f"  dirty    artifact={str(hit.dirty).lower()}  parent={str(hit.parent_dirty).lower()}")
        if hit.imports:
            preview = ", ".join(hit.imports[:6])
            extra = f" (+{len(hit.imports) - 6} more)" if len(hit.imports) > 6 else ""
            lines.append(f"  imports  {len(hit.imports)}  {preview}{extra}")
        lines.append("  why:")
        shown = summarize_reasons(hit)
        if not shown:
            lines.append("    (none — claim holds)")
        else:
            for row in shown:
                lines.append("    " + row.strip())
        sibs = [x for x in firing.members if x.path != hit.path]
        if sibs:
            lines.append("  siblings:")
            other = [s for s in sibs if s.via != "recipe"]
            recipe = [s for s in sibs if s.via == "recipe"]
            for s in other:
                lines.append(
                    f"    {s.verdict:<6} {s.why:<13} {s.path}  via={s.via}  fired {_fired_label(s)}"
                )
            if recipe:
                if len(recipe) > 3:
                    d = _common_dir([s.path for s in recipe]) or "."
                    lines.append(
                        f"    … {len(recipe)} via=recipe under {d}/  e.g. {recipe[0].path}"
                    )
                else:
                    for s in recipe:
                        lines.append(
                            f"    {s.verdict:<6} {s.why:<13} {s.path}  via={s.via}  fired {_fired_label(s)}"
                        )
        return "\n".join(lines) + "\n"

    n_mem = sum(len(F.members) for F in firings)
    n_bad = sum(1 for F in firings if F.verdict != "CLEAN")
    lines.append(f"sinter: {len(firings)} firing(s), {n_mem} members, {n_bad} not CLEAN")
    for F in firings:
        fires = [m.fire_ct for m in F.members if m.fire_ct]
        span = ""
        if fires:
            span = f"  fire {fmt_ct(min(fires))}"
            if max(fires) != min(fires):
                span += f" .. {fmt_ct(max(fires))}"
        dirty = "  parent=dirty" if F.parent_dirty else ""
        ages = [m.age for m in F.members if m.age is not None]
        age_s = ""
        if ages:
            if min(ages) == max(ages):
                age_s = f"  age {min(ages)}"
            else:
                age_s = f"  ages {min(ages)}–{max(ages)}"
        via_c = Counter(m.via for m in F.members)
        via_s = " ".join(f"{k}={v}" for k, v in sorted(via_c.items()))
        lines.append(
            f"\n[{F.verdict} why={F.why}] {F.id}  {len(F.members)} files{span}{age_s}{dirty}"
        )
        if F.generator:
            lines.append(f"  recipe   {F.generator}")
        if F.parent:
            lines.append(f"  parent   {F.parent}")
        if F.die:
            die = F.die if len(F.die) < 22 else F.die[:18] + "…"
            lines.append(f"  die      {die}")
        lines.append(f"  via      {via_s}")
        if F.imports:
            if len(F.imports) > 6:
                lines.append(
                    f"  imports  {len(F.imports)} undeclared (e.g. {', '.join(F.imports[:3])}, …)"
                )
            else:
                lines.append(f"  imports  {', '.join(F.imports)}")
        rest = [m for m in F.members if m.via != "recipe"]
        recipe = [m for m in F.members if m.via == "recipe"]
        if not verbose:
            show = [m for m in rest if m.verdict != "CLEAN"]
            n_hide = len(rest) - len(show)
            if n_hide:
                lines.append(f"  … {n_hide} CLEAN hidden (pass -v)")
        else:
            show = rest
        for m in show:
            lines.append(_member_line(m))
            lines.extend(summarize_reasons(m))
        recipe_stale = [m for m in recipe if m.verdict != "CLEAN"]
        recipe_clean = [m for m in recipe if m.verdict == "CLEAN"]
        _emit_recipe_group(lines, recipe_stale, verbose)
        if verbose or recipe_stale:
            _emit_recipe_group(lines, recipe_clean, verbose)
        elif recipe_clean:
            d = _common_dir([m.path for m in recipe_clean]) or "."
            lines.append(
                f"  … {len(recipe_clean)} via=recipe under {d}/ (pass -v)"
            )
    return "\n".join(lines) + "\n"


def format_tsv(firings: list[Firing]) -> str:
    cols = [
        "verdict",
        "firing_verdict",
        "why",
        "firing_why",
        "path",
        "parent",
        "via",
        "stamp",
        "die",
        "generator",
        "fire_ct",
        "age",
        "reason_paths",
    ]
    rows = ["\t".join(cols)]
    for F in firings:
        for m in F.members:
            rpaths = ",".join(unique([r.path for r in m.reasons]))
            row = [
                m.verdict,
                F.verdict,
                m.why,
                F.why,
                m.path,
                m.parent or "",
                m.via,
                m.stamp or "",
                m.die or "",
                m.generator or "",
                str(m.fire_ct or ""),
                "" if m.age is None else str(m.age),
                rpaths,
            ]
            rows.append("\t".join(c.replace("\t", " ").replace("\n", " ") for c in row))
    return "\n".join(rows) + "\n"


def format_json(firings: list[Firing]) -> str:
    payload = {
        "tool": "sinter",
        "version": VERSION,
        "firings": [
            {
                "id": F.id,
                "verdict": F.verdict,
                "why": F.why,
                "parent": F.parent,
                "generator": F.generator,
                "die": F.die,
                "parent_dirty": F.parent_dirty,
                "imports": F.imports,
                "members": [
                    {
                        "path": m.path,
                        "verdict": m.verdict,
                        "why": m.why,
                        "via": m.via,
                        "how": m.how,
                        "parent": m.parent,
                        "generator": m.generator,
                        "stamp": m.stamp,
                        "die": m.die,
                        "stamp_currency": m.stamp_currency,
                        "fire_sha": m.fire_sha,
                        "fire_ct": m.fire_ct,
                        "age": m.age,
                        "dirty": m.dirty,
                        "parent_dirty": m.parent_dirty,
                        "conflicted": m.conflicted,
                        "mismatch": m.mismatch,
                        "imports": m.imports,
                        "world": m.world,
                        "reasons": [
                            {"kind": r.kind, "path": r.path, "detail": r.detail}
                            for r in m.reasons
                        ],
                    }
                    for m in F.members
                ],
            }
            for F in firings
        ],
    }
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def any_check_fail(firings: list[Firing]) -> bool:
    return any(F.verdict != "CLEAN" for F in firings)


