RE_BANNER = re.compile(
    r"(?i)("
    r"generated from\s+\S|"
    r"@generated\b|"
    r"this file is automatically @generated|"
    r"automatically @generated by\b|"
    r"生成物\s*[—–-]|"
    r"<!--\s*generated\b"
    r")"
)
RE_DO_NOT_EDIT = re.compile(
    r"(?i)do not edit|don't edit|not intended for manual editing|手編集禁止"
)
RE_FROM_BY = re.compile(
    r"(?i)@generated\s+by\s+(\S+)\s+from\s+[ `'\"]*([^\s`'\"]+)"
)
RE_GENERATED_FROM = re.compile(
    r"(?i)generated(?:\s+\w+){0,3}\s+from\s+[ `'\"]*([^\s`'\"]+)"
)
RE_GENERATED_BY = re.compile(
    r"(?i)(?:@generated|generated)\s+by\s+[ `'\"]*([^\s`'\"]+)"
)
RE_HONBAN = re.compile(r"正本は\s*[ `「『]*([^`」』\s]+)")
RE_SOURCE_FIELD = re.compile(
    r"(?i)(?:^|\n)\s*(?:[-*]\s*)?[\"']?(?:source|parent)[\"']?\s*:\s*[ `'\"]*([^\s`'\"]+)"
)
RE_STAMP = re.compile(
    r"(?i)[\"']?(?:source\s*fingerprint|sourcefingerprint|source_fingerprint)[\"']?"
    r"\s*[:=]\s*[ `'\"]*(sha256:[a-f0-9]{64})"
)
RE_PKL_IMPORT = re.compile(r'^\s*(?:import|amends)\s+"([^"]+)"', re.M)
RE_COMMENT_OUT = re.compile(
    r"^\s*(?://|#|--)\s*-\s+`?([A-Za-z0-9_./\-*\.]+\.[A-Za-z0-9.*]+)`?",
    re.M,
)
RE_PATH_LIT = re.compile(
    r"""path\s*:\s*["']([A-Za-z0-9_./\-]+\.[A-Za-z0-9.]+)["']"""
)
RE_ROOT_JOIN = re.compile(r"""ROOT\s*/\s*["']([^"']+)["']""")
RE_FROM_PKL = re.compile(r"(?:from|join\([^,]+,\s*)[^\n]{0,40}(specs/[A-Za-z0-9_./\-]+\.pkl)")
RE_PKL_ANY = re.compile(r"(specs/[A-Za-z0-9_./\-]+\.pkl)")
RE_CONTROLLED_ROOTS = re.compile(
    r"CONTROLLED_GENERATED_ROOTS\s*=\s*\[([^\]]+)\]"
)
TRAIL_PUNCT = re.compile(r"[.,;:…。、—–\-]+$")
RE_CONFLICT = re.compile(r"^<<<<<<< ", re.M)


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def unique(xs: list[str]) -> list[str]:
    seen: set[str] = set()
    out: list[str] = []
    for x in xs:
        if x and x not in seen:
            seen.add(x)
            out.append(x)
    return out


def clean_path(raw: str) -> str:
    raw = raw.strip().strip("`\"'")
    raw = TRAIL_PUNCT.sub("", raw)
    raw = raw.strip().strip("`\"'")
    raw = raw.replace("\\", "/")
    if raw.startswith("./"):
        raw = raw[2:]
    return raw


def valid_parent(path: str | None) -> str | None:
    if not path:
        return None
    if any(ch in path for ch in "*?<>|、。；"):
        return None
    base = path.rsplit("/", 1)[-1]
    if "." not in base and "/" not in path:
        return None
    return path


def skip_named(name: str) -> bool:
    lower = name.lower()
    if lower in SKIP_NAMES:
        return True
    if Path(lower).suffix in SKIP_SUFFIX:
        return True
    if lower.startswith("spec-gen.") or lower.startswith("spec-check."):
        return True
    if lower.endswith(".log") or lower.endswith(".proptest-regressions"):
        return True
    if lower.endswith(".snap"):
        return True
    return False


def looks_generator(rel: str) -> bool:
    parts = Path(rel).parts
    name = Path(rel).name.lower()
    stem = Path(rel).stem.lower()
    if "spec-gen" in parts or stem in {"spec-gen", "codegen", "generate", "gen"}:
        return True
    if name.startswith("generate_") or name.startswith("gen_"):
        return True
    if rel in KNOWN_GENERATORS:
        return True
    return False


def looks_generated_name(rel: str) -> bool:
    if looks_generator(rel):
        return False
    name = Path(rel).name
    lower = name.lower()
    if lower.endswith(".log") or lower.endswith(".proptest-regressions"):
        return False
    if ".generated." in lower or lower.endswith(".generated"):
        return True
    if "_generated." in lower or lower.endswith("_generated"):
        return True
    if "generated." in name and name[0].isupper():
        return True
    parts = {p.lower() for p in Path(rel).parts[:-1]}
    if "generated" in parts or "codegen" in parts:
        return True
    return False


def has_banner(text: str) -> bool:
    nonempty = [ln for ln in text.splitlines() if ln.strip()][:5]
    head = "\n".join(nonempty)
    if RE_BANNER.search(head):
        return True
    if RE_DO_NOT_EDIT.search(head) and re.search(r"(?i)generat|生成", head):
        return True
    return False


def decode_head(path: Path, n: int = HEAD_BYTES) -> str:
    try:
        raw = path.read_bytes()[:n]
    except OSError:
        return ""
    if b"\0" in raw[:512]:
        return ""
    return raw.decode("utf-8", errors="replace")


def run_git(root: Path, args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def git_toplevel(start: Path) -> Path | None:
    p = run_git(start, ["rev-parse", "--show-toplevel"])
    if p.returncode != 0:
        return None
    return Path(p.stdout.strip()).resolve()


def git_ls_files(root: Path) -> list[str]:
    p = run_git(root, ["ls-files", "-z", "-c", "-o", "--exclude-standard"])
    if p.returncode != 0:
        return []
    return [x for x in p.stdout.split("\0") if x]


def git_status_map(root: Path) -> dict[str, str]:
    p = run_git(root, ["status", "--porcelain", "-uall", "-z"])
    out: dict[str, str] = {}
    if p.returncode != 0 or not p.stdout:
        return out
    parts = p.stdout.split("\0")
    i = 0
    while i < len(parts):
        chunk = parts[i]
        i += 1
        if not chunk:
            continue
        if len(chunk) < 3:
            continue
        code = chunk[:2].strip() or chunk[0]
        path = chunk[3:] if chunk[2:3] == " " else chunk[2:].lstrip()
        if code.startswith("R") or code.startswith("C"):
            if i < len(parts):
                path = parts[i]
                i += 1
        if path:
            out[path] = code
    return out


def last_commits_batch(root: Path, paths: set[str]) -> dict[str, tuple[str, int]]:
    wanted = set(paths)
    found: dict[str, tuple[str, int]] = {}
    if not wanted:
        return found
    p = run_git(
        root,
        ["log", "--pretty=format:%H\t%ct", "--name-only", "--", *sorted(wanted)],
    )
    if p.returncode != 0:
        p = run_git(root, ["log", "--pretty=format:%H\t%ct", "--name-only"])
        if p.returncode != 0:
            return found
    sha = None
    ct = None
    for line in p.stdout.splitlines():
        if not wanted:
            break
        if not line:
            sha = None
            ct = None
            continue
        if sha is None and "\t" in line and len(line.split("\t")[0]) >= 16:
            a, b = line.split("\t", 1)
            try:
                sha, ct = a, int(b)
            except ValueError:
                sha = None
            continue
        if sha is not None and line in wanted and line not in found:
            found[line] = (sha, ct or 0)
            wanted.discard(line)
    return found


def git_blob_at(root: Path, commit: str, rel: str) -> str | None:
    p = run_git(root, ["rev-parse", "--verify", "-q", f"{commit}:{rel}"])
    if p.returncode != 0:
        return None
    h = p.stdout.strip()
    return h or None


def git_hash_object(root: Path, rel: str) -> str | None:
    path = root / rel
    if not path.is_file():
        return None
    p = run_git(root, ["hash-object", "--", rel])
    if p.returncode != 0:
        try:
            data = path.read_bytes()
        except OSError:
            return None
        return hashlib.sha1(
            b"blob %d\0" % len(data) + data, usedforsecurity=False
        ).hexdigest()
    return p.stdout.strip() or None


def file_mtime(path: Path) -> int | None:
    try:
        return int(path.stat().st_mtime)
    except OSError:
        return None


def fmt_ct(ct: int | None) -> str:
    if not ct:
        return "-"
    return datetime.fromtimestamp(ct, tz=timezone.utc).astimezone().strftime(
        "%Y-%m-%d %H:%M"
    )


def resolve_existing(root: Path, rel: str) -> str | None:
    rel = rel.lstrip("/")
    cand = (root / rel)
    try:
        cand = cand.resolve()
        cand.relative_to(root)
    except (OSError, ValueError):
        return None
    if cand.is_file():
        return str(cand.relative_to(root)).replace("\\", "/")
    return None


def resolve_parent(root: Path, cited: str, from_file: str | None = None) -> tuple[str, bool]:
    cited = cited.lstrip("/")
    candidates = [root / cited]
    if from_file:
        candidates.append((root / from_file).parent / cited)
    for cand in candidates:
        try:
            resolved = cand.resolve()
            resolved.relative_to(root)
        except (OSError, ValueError):
            continue
        if resolved.is_file() or resolved.is_dir():
            return str(resolved.relative_to(root)).replace("\\", "/"), False
    return cited, True


