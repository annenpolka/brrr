@dataclass
class Receipt:
    path: str
    parent: str | None = None
    generator: str | None = None
    stamp: str | None = None
    stamps: list[str] = field(default_factory=list)
    how: str = "header"
    conflicted: bool = False
    snippet: str = ""


def extract_receipt(relpath: str, text: str, name: str) -> Receipt | None:
    lines = text.splitlines()[:HEAD_LINES]
    prefix = "\n".join(lines)
    name_hit = looks_generated_name(relpath)
    stamps = [m.group(1).lower() for m in RE_STAMP.finditer(text[:4000])]
    json_hit = bool(stamps)
    banner = has_banner(text)
    if not (banner or name_hit or json_hit):
        return None

    rec = Receipt(
        path=relpath,
        how="header",
        conflicted=bool(RE_CONFLICT.search(text[:4000])),
        snippet=(prefix.split("\n", 1)[0] if prefix else "")[:160],
        stamps=unique(stamps),
    )
    if rec.stamps:
        rec.stamp = rec.stamps[0]
        if rec.conflicted and len(rec.stamps) > 1:
            rec.stamp = None  # unusable until resolved

    m = RE_FROM_BY.search(prefix)
    if m:
        rec.generator = clean_path(m.group(1))
        rec.parent = clean_path(m.group(2))
        rec.how = "generated-by-from"

    if rec.parent is None:
        m = RE_GENERATED_FROM.search(prefix)
        if m:
            rec.parent = clean_path(m.group(1))
            rec.how = "generated-from"

    if rec.parent is None:
        m = RE_HONBAN.search(prefix)
        if m:
            rec.parent = clean_path(m.group(1))
            rec.how = "honban"

    if rec.parent is None:
        m = RE_SOURCE_FIELD.search(prefix)
        if m:
            rec.parent = clean_path(m.group(1))
            rec.how = "source-field"

    if rec.generator is None:
        m = RE_GENERATED_BY.search(prefix)
        if m:
            rec.generator = clean_path(m.group(1))

    if rec.parent is None:
        msrc = RE_SOURCE_FIELD.search(text[:2000])
        if msrc:
            rec.parent = clean_path(msrc.group(1))
            rec.how = "source-field"

    if name_hit and rec.how == "header":
        rec.how = "filename"

    rec.parent = valid_parent(rec.parent)
    rec.generator = valid_parent(rec.generator) or rec.generator
    if rec.generator and looks_generator(relpath):
        return None
    if not rec.parent and not rec.stamp and not name_hit and not banner:
        return None
    return rec


