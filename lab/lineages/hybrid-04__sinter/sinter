def walk_imports(root: Path, start_rel: str) -> list[str]:
    seen: set[str] = set()
    out: list[str] = []
    stack = [start_rel]

    def add(rel: str) -> None:
        rel = rel.replace("\\", "/")
        if rel in seen:
            return
        seen.add(rel)
        out.append(rel)

    while stack:
        rel = stack.pop()
        if rel in seen:
            continue
        path = root / rel
        if not path.is_file():
            add(rel)
            continue
        add(rel)
        if path.suffix != ".pkl":
            continue
        text = decode_head(path, n=256_000)
        parent = str(Path(rel).parent).replace("\\", "/")
        if parent == ".":
            parent = ""
        for m in RE_PKL_IMPORT.finditer(text):
            spec = m.group(1)
            if ":" in spec or spec.startswith("pkl:"):
                continue
            if spec.startswith("."):
                joined = (Path(parent) / spec) if parent else Path(spec)
            else:
                joined = (Path(parent) / spec) if parent else Path(spec)
            joined_s = Path(os.path.normpath(str(joined))).as_posix()
            if joined_s.startswith("../"):
                continue
            candidates = [joined_s]
            if not Path(joined_s).suffix:
                candidates.extend([joined_s + ".pkl"])
            hit = next((c for c in candidates if (root / c).is_file()), None)
            stack.append(hit or joined_s)
    return out


def expand_generator(root: Path, gen: str | None) -> list[str]:
    if not gen:
        return []
    rel = resolve_existing(root, gen) or (gen if (root / gen).exists() else None)
    def keep_gen(p: Path) -> bool:
        if p.suffix not in {".ts", ".js", ".mjs", ".py"}:
            return False
        name = p.name.lower()
        if ".test." in name or name.endswith("_test.py") or name.endswith(".spec.ts"):
            return False
        return True

    if rel is None:
        d = root / gen
        if d.is_dir():
            files = []
            for p in sorted(d.rglob("*")):
                if p.is_file() and keep_gen(p):
                    files.append(str(p.relative_to(root)).replace("\\", "/"))
            return files[:80]
        return [gen]
    path = root / rel
    files = [rel] if path.is_file() else []
    sibling = path.parent / path.stem if path.is_file() else path
    if sibling.is_dir():
        for p in sorted(sibling.rglob("*")):
            if p.is_file() and keep_gen(p):
                files.append(str(p.relative_to(root)).replace("\\", "/"))
    return unique(files)[:80]


def expand_glob(root: Path, pattern: str) -> list[str]:
    hits = []
    for p in sorted(root.glob(pattern)):
        if p.is_file():
            try:
                hits.append(str(p.resolve().relative_to(root)).replace("\\", "/"))
            except ValueError:
                continue
    return hits


def scrape_recipe(root: Path, gen: str) -> dict:
    outputs: list[str] = []
    sources: list[str] = []
    for rel in expand_generator(root, gen):
        path = root / rel
        if not path.is_file():
            continue
        try:
            if path.stat().st_size > 2_000_000:
                continue
        except OSError:
            continue
        text = decode_head(path, n=500_000)
        for m in RE_COMMENT_OUT.finditer(text):
            outputs.append(clean_path(m.group(1)))
        for m in RE_PATH_LIT.finditer(text):
            outputs.append(clean_path(m.group(1)))
        for m in RE_ROOT_JOIN.finditer(text):
            outputs.append(clean_path(m.group(1)))
        for m in RE_FROM_PKL.finditer(text):
            sources.append(clean_path(m.group(1)))
        for m in RE_HONBAN.finditer(text):
            sources.append(clean_path(m.group(1)))
        for m in RE_CONTROLLED_ROOTS.finditer(text):
            for raw in re.findall(r'["\']([^"\']+)["\']', m.group(1)):
                outputs.append(raw.rstrip("/") + "/**")
        for m in RE_PKL_ANY.finditer(text[:8000]):
            s = clean_path(m.group(1))
            if "*" not in s:
                sources.append(s)
    expanded: list[str] = []
    for o in outputs:
        o = o.lstrip("./")
        if any(part in SKIP_DIRS for part in Path(o).parts):
            continue
        if o.endswith("/**"):
            base = o[:-3]
            d = root / base
            if d.is_dir():
                for p in sorted(d.rglob("*")):
                    if not p.is_file():
                        continue
                    rel = str(p.relative_to(root)).replace("\\", "/")
                    if skip_named(p.name) or looks_generator(rel):
                        continue
                    if looks_generated_name(rel) or p.suffix in {".md", ".json", ".ts", ".swift", ".rs"}:
                        expanded.append(rel)
            continue
        if "*" in o or "?" in o:
            expanded.extend(expand_glob(root, o))
        elif (root / o).is_file() or looks_generated_name(o) or o.endswith(".md"):
            expanded.append(o)
    return {"outputs": unique(expanded), "sources": unique(sources)}


