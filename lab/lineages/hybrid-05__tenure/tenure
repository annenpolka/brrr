class TenureError(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


@dataclass(frozen=True)
class Sample:
    sha: str
    timestamp: int
    iso: str
    subject: str
    kind: str = "commit"  # commit | worktree | index

    @property
    def short(self) -> str:
        if self.kind != "commit":
            return self.sha
        return self.sha[:7]


@dataclass
class Era:
    value: bool
    start: Sample
    end: Sample
    count: int
    witnesses_start: list[str] = field(default_factory=list)
