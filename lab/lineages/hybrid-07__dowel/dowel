def origins_match(a: Optional[str], b: Optional[str]) -> bool:
    if not a or not b:
        return True
    return a == b


def git_root_from_args(args: argparse.Namespace, need_git: bool) -> Optional[Path]:
    if not need_git:
        return None
    cwd = Path.cwd()
    start = args.repo if getattr(args, "repo", None) is not None else cwd
    git_root = discover_repo(start)
    if git_root is None:
        die("dowel: not a git repository (use --repo or --from-dir/--to-dir)")
    return git_root


def add_common(p: argparse.ArgumentParser) -> None:
    p.add_argument("--repo", type=Path, default=None, help="git repository root")
    p.add_argument("--porcelain", action="store_true", help="stable tab-separated output")
    p.add_argument("--json", action="store_true", help="JSON object per result")
    p.add_argument("--strict", action="store_true", help="exit 1 on unbound/gone/ambiguous")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="dowel", description=HINT, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"dowel {VERSION}")
    p.add_argument("--selftest", action="store_true", help="run internal checks and exit")
    sub = p.add_subparsers(dest="cmd")

    m = sub.add_parser("mint", help="capture path:line + instance as a dowel token")
    add_common(m)
    m.add_argument("location", help="path:line of the template")
    m.add_argument("instance", nargs="?", default=None, help="runtime string that binds the holes")
    m.add_argument("-e", "--instance", dest="instance_flag", default=None, help="runtime instance (use for dashed strings)")
    m.add_argument("--from", dest="from_ref", default=None, help="source git ref")
    m.add_argument("--from-dir", type=Path, default=None, help="source snapshot as a directory")

    r = sub.add_parser("resolve", help="seat a stored dowel on --to / --to-dir; no path:line")
    add_common(r)
    r.add_argument("tokens", nargs="*", help="dowel1.… tokens")
    r.add_argument("--to", dest="to_ref", default=None, help="destination git ref (must exist if given)")
    r.add_argument("--to-dir", type=Path, default=None, help="destination snapshot as a directory")
    r.add_argument("--instance", dest="rebind", default=None, help="re-bind a new runtime string against dest")
    r.add_argument("--any-repo", action="store_true", help="allow a foreign repository origin")

    s = sub.add_parser("show", help="decode a dowel without resolving")
    s.add_argument("tokens", nargs="+", help="dowel1.… tokens")
    s.add_argument("--json", action="store_true", help="JSON payload")

    sub.add_parser("selftest", help="internal checks")
    return p


def cmd_mint(args: argparse.Namespace) -> int:
    inst = args.instance_flag if args.instance_flag is not None else args.instance
    if inst is None:
        die("dowel mint: instance required (path:line INSTANCE)")
    if args.from_dir is None and args.from_ref is None:
        die("dowel mint: --from REF or --from-dir DIR is required")
    need_git = args.from_dir is None
    git_root = git_root_from_args(args, need_git)
    if need_git and git_root is not None and args.from_ref:
        verify_git_ref(git_root, args.from_ref)
    src = load_snapshot(
        git_root=git_root,
        ref=None if args.from_dir is not None else args.from_ref,
        directory=args.from_dir,
        label=str(args.from_dir or args.from_ref or "worktree"),
        empty_ok=True,
    )
    path, line, col = parse_locator(args.location, src.paths)
    if canon_path(path) not in src.files:
        die(f"dowel mint: source path not in snapshot: {path}")
    try:
        c = mint_contract(src, path, line, col, inst)
    except SystemExit as e:
        msg = str(e)
        if msg and msg not in {"1", "2"}:
            print(msg if msg.startswith("dowel") else f"dowel mint: {msg}", file=sys.stderr)
        return 1 if msg not in {"2"} else 2
    token = encode_dowel(c)
    if args.json:
        print(
            json.dumps(
                {
                    "dowel": token,
                    "from": {"path": c.path, "line": c.line, "col": c.col},
                    "tmpl": c.display,
                    "bound": list(c.bound),
                    "bindings": [{"name": n, "value": v} for n, v in c.bindings],
                    "instance": c.instance,
                    "origin": c.origin,
                    "truncated": c.truncated,
                },
                ensure_ascii=False,
            )
        )
    elif args.porcelain:
        print(f"minted\t-\t{format_from(c)}\t{token}")
    else:
        print(token)
    return 0


def cmd_resolve(args: argparse.Namespace) -> int:
    raws = list(args.tokens)
    if not raws:
        if sys.stdin.isatty():
            build_parser().parse_args(["resolve", "-h"])
            return 2
        raws = [ln.strip() for ln in sys.stdin.read().splitlines() if ln.strip() and not ln.startswith("#")]
    if args.to_dir is None and args.to_ref is None:
        die("dowel resolve: --to REF or --to-dir DIR is required")
    contracts: list[Contract] = []
    for raw in raws:
        if re.search(r":\d+$", raw) and not is_dowel_token(raw):
            print(
                f"dowel resolve: {raw} is a locator; dowels are minted tokens, not path:line",
                file=sys.stderr,
            )
            return 2
        if not is_dowel_token(raw):
            print(f"dowel resolve: not a dowel token: {raw}", file=sys.stderr)
            return 2
        try:
            contracts.append(decode_dowel(raw))
        except ValueError as e:
            print(f"dowel resolve: corrupt dowel: {e}", file=sys.stderr)
            return 1

    need_git = args.to_dir is None
    git_root = git_root_from_args(args, need_git)
    if need_git and git_root is not None and args.to_ref:
        verify_git_ref(git_root, args.to_ref)
    dst = load_snapshot(
        git_root=git_root,
        ref=None if args.to_dir is not None else args.to_ref,
        directory=args.to_dir,
        label=str(args.to_dir or args.to_ref or "worktree"),
    )
    rc = 0
    for c in contracts:
        if not args.any_repo and not origins_match(c.origin, dst.origin):
            print(
                f"dowel belongs to a different repository "
                f"({c.origin or '-'} vs {dst.origin or '-'})",
                file=sys.stderr,
            )
            return 1
        hit = resolve_contract(c, dst, instance=args.rebind)
        if args.json:
            print_json(hit)
        elif args.porcelain:
            print_porcelain(hit)
        else:
            print_human(hit)
        if args.strict and hit.status in {"unbound", "gone", "ambiguous"}:
            rc = 1
    return rc


def cmd_show(args: argparse.Namespace) -> int:
    for raw in args.tokens:
        try:
            c = decode_dowel(raw)
        except ValueError as e:
            print(f"dowel show: corrupt dowel: {e}", file=sys.stderr)
            return 1
        if args.json:
            print(json.dumps(c.payload(), ensure_ascii=False))
        else:
            print_show(c, raw)
    return 0


