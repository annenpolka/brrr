def unescape_basic(s: str) -> str:
    out: list[str] = []
    i = 0
    n = len(s)
    escapes = {"n": "\n", "t": "\t", "r": "\r", "0": "\0", "\\": "\\", '"': '"', "'": "'", "`": "`"}
    while i < n:
        if s[i] == "\\" and i + 1 < n:
            nxt = s[i + 1]
            if nxt == "(":
                out.append("\\(")
                i += 2
                continue
            if nxt in escapes:
                out.append(escapes[nxt])
                i += 2
                continue
            if nxt == "x" and i + 3 < n:
                try:
                    out.append(chr(int(s[i + 2 : i + 4], 16)))
                    i += 4
                    continue
                except ValueError:
                    pass
            out.append(nxt)
            i += 2
            continue
        out.append(s[i])
        i += 1
    return "".join(out)


def _matching_brace(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return i
        elif ch in {'"', "'"}:
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _matching_paren(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
        elif ch in {'"', "'"}:
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _is_format_hole(s: str, i: int) -> int | None:
    if i >= len(s) or s[i] != "{":
        return None
    n = len(s)
    j = i + 1
    if j < n and s[j] in '{"[ \n\t':
        return None
    if j < n and s[j] == "}":
        return j + 1
    if j < n and s[j].isdigit():
        while j < n and s[j].isdigit():
            j += 1
    elif j < n and (s[j].isalpha() or s[j] == "_"):
        while j < n and (s[j].isalnum() or s[j] in "_."):
            j += 1
    if j < n and s[j] == "!":
        j += 1
        while j < n and s[j].isalpha():
            j += 1
    if j < n and s[j] == ":":
        k = s.find("}", j)
        if k < 0:
            return None
        return k + 1
    if j < n and s[j] == "}":
        return j + 1
    return None


def _brace_hole_name(inner: str) -> str:
    inner = inner.strip()
    if not inner:
        return ""
    if "!" in inner:
        inner = inner.split("!", 1)[0]
    if ":" in inner:
        inner = inner.split(":", 1)[0]
    return inner.strip()


def _swift_hole_name(inner: str) -> str:
    s = inner.strip()
    if not s:
        return ""
    m = re.match(
        r"((?:self\.)?[A-Za-z_][A-Za-z0-9_]*|(?:\#)[A-Za-z_][A-Za-z0-9_]*)"
        r"(?:[.#][A-Za-z_][A-Za-z0-9_]*)*",
        s,
    )
    if m:
        return m.group(0)
    return s.split(",", 1)[0].strip()[:48]


def _dollar_hole_name(inner: str) -> str:
    return inner.strip()


def _assign_hole_names(raw: list[str]) -> tuple[str, ...]:
    n = 1
    out: list[str] = []
    for name in raw:
        if name:
            out.append(name)
        else:
            out.append(str(n))
            n += 1
    return tuple(out)


def swift_string_value(raw: str) -> str:
    s = SWIFT_CONTINUATION_RE.sub("", raw)
    if "\n" not in s:
        return s
    if s.startswith("\n"):
        s = s[1:]
    lines = s.split("\n")
    while lines and not lines[-1].strip():
        lines.pop()
    while lines and not lines[0].strip():
        lines.pop(0)
    nonempty = [ln for ln in lines if ln.strip()]
    if nonempty:
        cut = min(len(ln) - len(ln.lstrip(" \t")) for ln in nonempty)
        lines = [ln[cut:] if len(ln) >= cut else ln for ln in lines]
    return "\n".join(lines).strip()


def looks_like_data_literal(body: str, holes: int) -> bool:
    if holes:
        return False
    s = body.strip()
    if len(s) >= 280:
        return True
    if DATA_LITERAL_RE.match(s) and (":" in s or "," in s):
        return True
    return False


def tokenize_named(s: str) -> tuple[tuple[str, ...], tuple[str, ...]]:
    buf: list[str] = []
    parts: list[str] = []
    raw_names: list[str] = []
    i = 0
    n = len(s)

    def flush() -> None:
        parts.append("".join(buf))
        buf.clear()

    while i < n:
        if s.startswith("{{", i):
            buf.append("{")
            i += 2
            continue
        if s.startswith("}}", i):
            buf.append("}")
            i += 2
            continue
        if s.startswith("%%", i):
            buf.append("%")
            i += 2
            continue
        if s.startswith("${", i):
            end = _matching_brace(s, i + 1)
            if end is not None:
                flush()
                raw_names.append(_dollar_hole_name(s[i + 2 : end]))
                i = end + 1
                continue
        if s.startswith("\\(", i):
            end = _matching_paren(s, i + 1)
            if end is not None:
                flush()
                raw_names.append(_swift_hole_name(s[i + 2 : end]))
                i = end + 1
                continue
        if s[i] == "{":
            end = _is_format_hole(s, i)
            if end is not None:
                flush()
                raw_names.append(_brace_hole_name(s[i + 1 : end - 1]))
                i = end
                continue
        m = PRINTF_RE.match(s, i)
        if m:
            if m.group(0) == "%%":
                buf.append("%")
                i = m.end()
                continue
            flush()
            raw_names.append("")
            i = m.end()
            continue
        buf.append(s[i])
        i += 1
    flush()
    return tuple(parts), _assign_hole_names(raw_names)


def template_of(
    path: str,
    line: int,
    col: int,
    lang: str,
    raw: str,
    parts: tuple[str, ...] | None = None,
    names: tuple[str, ...] | None = None,
) -> Template:
    if parts is None or names is None:
        parts, names = tokenize_named(raw)
    return Template(
        path=path,
        line=line,
        col=col,
        lang=lang,
        raw=raw,
        parts=parts,
        holes=len(names),
        names=names,
    )


def _line_starts(text: str) -> list[int]:
    starts = [0]
    for i, ch in enumerate(text):
        if ch == "\n":
            starts.append(i + 1)
    return starts


def _linecol(starts: list[int], index: int) -> tuple[int, int]:
    lo, hi = 0, len(starts) - 1
    while lo <= hi:
        mid = (lo + hi) // 2
        if starts[mid] <= index:
            lo = mid + 1
        else:
            hi = mid - 1
    line_idx = hi
    return line_idx + 1, index - starts[line_idx] + 1


def _skip_line_comment(text: str, i: int) -> int:
    n = len(text)
    while i < n and text[i] != "\n":
        i += 1
    return i


def _skip_block_comment(text: str, i: int) -> int:
    n = len(text)
    i += 2
    while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
        i += 1
    return min(n, i + 2)


def _read_quoted(
    text: str, i: int, quote: str, interpolations: bool = False
) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    start = i
    while i < n:
        if interpolations and text.startswith("\\(", i):
            end = _matching_paren(text, i + 1)
            if end is None:
                return None
            i = end + 1
            continue
        ch = text[i]
        if ch == "\\":
            i += 2
            continue
        if ch == quote:
            return i + 1, text[start:i]
        if ch == "\n" and quote != "`":
            return None
        i += 1
    return None


def _read_raw_hash(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    hashes = 0
    while i < n and text[i] == "#":
        hashes += 1
        i += 1
    if i >= n or text[i] != '"':
        return None
    i += 1
    start = i
    close = '"' + ("#" * hashes)
    while i < n:
        if text.startswith(close, i):
            return i + len(close), text[start:i]
        i += 1
    return None


def _read_triple(
    text: str, i: int, quote: str, interpolations: bool = False
) -> tuple[int, str] | None:
    delim = quote * 3
    if not text.startswith(delim, i):
        return None
    i += 3
    start = i
    n = len(text)
    while i + 2 < n:
        if interpolations and text.startswith("\\(", i):
            end = _matching_paren(text, i + 1)
            if end is None:
                return None
            i = end + 1
            continue
        if text.startswith(delim, i):
            return i + 3, text[start:i]
        if text[i] == "\\":
            i += 2
            continue
        i += 1
    return None


def _read_js_template(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    chunks: list[str] = []
    last = i
    depth_expr = 0
    in_expr = False
    while i < n:
        ch = text[i]
        if not in_expr:
            if ch == "\\":
                i += 2
                continue
            if ch == "`":
                chunks.append(text[last:i])
                return i + 1, "".join(chunks)
            if ch == "$" and i + 1 < n and text[i + 1] == "{":
                chunks.append(text[last:i])
                chunks.append("${")
                i += 2
                last = i
                in_expr = True
                depth_expr = 1
                continue
            i += 1
            continue
        if ch == "{":
            depth_expr += 1
        elif ch == "}":
            depth_expr -= 1
            if depth_expr == 0:
                chunks.append(text[last:i])
                chunks.append("}")
                i += 1
                last = i
                in_expr = False
                continue
        elif ch in {'"', "'", "`"}:
            q = ch
            i += 1
            while i < n:
                if text[i] == "\\":
                    i += 2
                    continue
                if text[i] == q:
                    i += 1
                    break
                i += 1
            continue
        i += 1
    return None


def lang_for(path: str | Path, default: str = "any") -> str:
    suf = Path(str(path)).suffix.lower()
    return SOURCE_EXTS.get(suf, default)


def extract_templates(text: str, lang: str, path: str) -> list[Template]:
    starts = _line_starts(text)
    n = len(text)
    i = 0
    out: list[Template] = []
    any_lang = lang in {"any", ""}
    rustish = lang == "rust" or any_lang
    pyish = lang == "py" or any_lang
    jsish = lang == "js" or any_lang
    goish = lang == "go" or any_lang
    swiftish = lang == "swift" or any_lang
    hash_comment = lang in {"py", "sh", "rb"}

    def emit(raw_inner: str, at: int, unesc: bool) -> None:
        body = raw_inner
        if lang == "swift" or (any_lang and ("\\(" in body or "\\\n" in body)):
            body = swift_string_value(body)
        if unesc:
            body = unescape_basic(body)
        if not body or body.isspace():
            return
        if body.endswith("\r\n"):
            body = body[:-2]
        elif body.endswith("\n"):
            body = body[:-1]
        if len(body.strip()) < MIN_STATIC_EXACT:
            return
        parts, names = tokenize_named(body)
        holes = len(names)
        if looks_like_data_literal(body, holes):
            return
        if holes == 0 and sum(len(p) for p in parts) < MIN_STATIC_EXACT:
            return
        line, col = _linecol(starts, at)
        out.append(
            template_of(
                path=path,
                line=line,
                col=col,
                lang=lang if lang and lang != "any" else lang_for(path),
                raw=body,
                parts=parts,
                names=names,
            )
        )

    while i < n:
        ch = text[i]
        if hash_comment and ch == "#":
            i = _skip_line_comment(text, i)
            continue
        if lang != "py" and ch == "/" and i + 1 < n:
            if text[i + 1] == "/":
                i = _skip_line_comment(text, i)
                continue
            if text[i + 1] == "*":
                i = _skip_block_comment(text, i)
                continue
        if rustish and ch in {"r", "b", "c"}:
            j = i
            if text[j] in {"b", "c"}:
                j += 1
            if j < n and text[j] == "r":
                j += 1
                got = _read_raw_hash(text, j)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=False)
                    i = end
                    continue
        if pyish and ch.isalpha():
            j = i
            while j < n and text[j] in "rRfFbBuU":
                j += 1
            if j > i and j < n and text[j] in {'"', "'"}:
                is_raw = any(c in "rR" for c in text[i:j])
                if text.startswith(text[j] * 3, j):
                    got = _read_triple(text, j, text[j], interpolations=False)
                else:
                    got = _read_quoted(text, j, text[j], interpolations=False)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=not is_raw)
                    i = end
                    continue
        if (goish or jsish) and ch == "`":
            if jsish or "${" in text[i : i + 400]:
                got = _read_js_template(text, i)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=True)
                    i = end
                    continue
            if goish:
                j = text.find("`", i + 1)
                if j >= 0:
                    emit(text[i + 1 : j], i, unesc=False)
                    i = j + 1
                    continue
        if ch in {'"', "'"} and text.startswith(ch * 3, i):
            got = _read_triple(text, i, ch, interpolations=swiftish or "\\(" in text[i : i + 80])
            if got:
                end, inner = got
                emit(inner, i, unesc=True)
                i = end
                continue
        if ch == '"' or (ch == "'" and lang in {"js", "py", "sh", "rb", "go", "java", "kt", "c", "any", ""}):
            got = _read_quoted(
                text, i, ch, interpolations=swiftish or text.startswith("\\(", i + 1)
            )
            if got:
                end, inner = got
                emit(inner, i, unesc=True)
                i = end
                continue
        i += 1
    return out


def _longest_prefix_as_suffix(part: str, rest: str) -> int:
    if not part or not rest:
        return 0
    max_k = min(len(part) - 1, len(rest))
    for k in range(max_k, 0, -1):
        if rest.endswith(part[:k]):
            return k
    return 0


def _align_parts(
    parts: tuple[str, ...], query: str, allow_truncated: bool = True
) -> tuple[str, str, list[tuple[int, int]], bool, int] | None:
    loc: list[tuple[int, int]] = [(-1, -1)] * len(parts)
    pos = 0
    first = True
    prefix = ""
    truncated = False
    stop_at = len(parts)

    for i, part in enumerate(parts):
        if part == "":
            continue
        idx = query.find(part, pos)
        if idx >= 0:
            if first:
                prefix = query[:idx]
                first = False
            loc[i] = (idx, idx + len(part))
            pos = idx + len(part)
            continue
        if not allow_truncated:
            return None
        rest = query[pos:]
        if first:
            min_k = MIN_STATIC_PREFIX
            max_k = min(len(part) - 1, len(query))
            found_k = 0
            found_idx = -1
            for cand in range(max_k, min_k - 1, -1):
                frag = part[:cand]
                fidx = query.rfind(frag)
                if fidx >= 0 and fidx + cand == len(query):
                    found_k = cand
                    found_idx = fidx
                    break
            if found_k:
                loc[i] = (found_idx, found_idx + found_k)
                prefix = query[:found_idx]
                first = False
                truncated = True
                stop_at = i
                pos = len(query)
                break
            return None
        k = _longest_prefix_as_suffix(part, rest)
        if k > 0:
            loc[i] = (pos + len(rest) - k, pos + len(rest))
            truncated = True
            stop_at = i
            pos = len(query)
            break
        truncated = True
        stop_at = i
        pos = len(query)
        break

    if first:
        return None
    if parts and parts[0] == "":
        prefix = ""
    suffix = "" if truncated else (query[pos:] if pos <= len(query) else "")
    return prefix, suffix, loc, truncated, stop_at


def _remainder_of(tmpl: Template, loc: list[tuple[int, int]], stop_at: int) -> str:
    """Unmatched template tail. Do not re-emit a hole that was already bound.

    A prefix match on a later literal (`s` of `s deserted=`) is not a
    bound hole. The hole *after* that literal is still outstanding.
    """
    names = tmpl.hole_names
    parts = tmpl.parts
    if stop_at >= len(parts):
        return ""
    out: list[str] = []
    i = stop_at
    if i < len(parts) and loc[i][0] >= 0:
        matched = loc[i][1] - loc[i][0]
        tail = parts[i][matched:]
        if tail:
            out.append(tail)
        # prefix of this literal: the following hole was not consumed
        if matched < len(parts[i]) and i < len(names):
            out.append("{" + names[i] + "}")
        i += 1
    while i < len(parts):
        if i > 0:
            prev = loc[i - 1]
            prev_full = (
                prev[0] >= 0
                and (i - 1 >= len(parts) or prev[1] - prev[0] == len(parts[i - 1]))
            ) or parts[i - 1] == ""
            if not prev_full:
                name = names[i - 1] if i - 1 < len(names) else ""
                if not out or out[-1] != "{" + name + "}":
                    out.append("{" + name + "}")
        out.append(parts[i])
        i += 1
    return "".join(out)


def match_template(tmpl: Template, query: str, allow_truncated: bool = True) -> Bind | None:
    parts = tmpl.parts
    names = tmpl.hole_names
    static = tmpl.static_len
    if tmpl.holes == 0:
        body = parts[0] if parts else ""
        if not body or body.isspace():
            return None
        if body == query:
            return Bind(1.0, "", "", ())
        if query.startswith(body) and static >= MIN_STATIC_PREFIX:
            return None
        idx = query.find(body)
        if idx >= 0 and static >= 16:
            return None
        return None

    if static < MIN_STATIC_HOLE and tmpl.holes < 2:
        return None

    aligned = _align_parts(parts, query, allow_truncated=allow_truncated)
    if aligned is None:
        return None
    prefix, suffix, loc, truncated, stop_at = aligned

    bindings: list[tuple[str, str]] = []
    n_holes = len(parts) - 1
    for j in range(n_holes):
        name = names[j] if j < len(names) else str(j + 1)
        left = loc[j]
        right = loc[j + 1]
        if left[0] >= 0:
            hole_start = left[1]
        elif j == 0:
            hole_start = 0
        else:
            hole_start = loc[j - 1][1] if loc[j - 1][0] >= 0 else 0
        if right[0] >= 0:
            hole_end = right[0]
        else:
            hole_end = len(query)
        if hole_start > hole_end:
            continue
        # skip holes that sit after a truncation stop
        if truncated and j >= stop_at:
            continue
        if left[0] < 0 and right[0] < 0 and truncated:
            continue
        bindings.append((name, query[hole_start:hole_end]))

    if not bindings:
        return None

    leftover = len(prefix) + len(suffix)
    qn = max(len(query), 1)
    explained = max(qn - leftover, 0) / qn
    uniqueness = min(static / qn, 1.0)
    hole_reward = 0.03 * min(len(bindings), 7)
    score = 0.55 * explained + 0.32 * uniqueness + hole_reward + 0.10 * min(static / 40.0, 1.0)
    if truncated:
        score = max(0.0, score - 0.04)
    rem = ""
    if truncated:
        rem = _remainder_of(tmpl, loc, stop_at)
    return Bind(min(score, 1.25), prefix, suffix, tuple(bindings), truncated, rem)


