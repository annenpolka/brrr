@dataclass
class Contract:
    """The minted object: template fingerprint + bound holes + locus."""

    path: str
    line: int
    col: Optional[int]
    text: str
    parts: tuple[str, ...]
    names: tuple[str, ...]
    bound: tuple[str, ...]
    instance: str
    bindings: tuple[tuple[str, str], ...]
    tokens: list[str] = field(default_factory=list)
    unique: list[str] = field(default_factory=list)
    before: list[str] = field(default_factory=list)
    after: list[str] = field(default_factory=list)
    lang: str = ""
    origin: Optional[str] = None
    truncated: bool = False
    remainder: str = ""

    @property
    def display(self) -> str:
        return template_of(self.path, self.line, self.col or 1, self.lang or "any", "", self.parts, self.names).display

    def payload(self) -> dict:
        d: dict = {
            "v": 1,
            "p": self.path,
            "n": self.line,
            "t": self.text,
            "parts": list(self.parts),
            "names": list(self.names),
            "bound": list(self.bound),
            "inst": self.instance,
            "bind": [list(x) for x in self.bindings],
        }
        if self.col is not None:
            d["c"] = self.col
        if self.tokens:
            d["k"] = self.tokens
        if self.unique:
            d["u"] = self.unique
        if self.before:
            d["b"] = self.before
        if self.after:
            d["a"] = self.after
        if self.lang:
            d["lang"] = self.lang
        if self.origin:
            d["o"] = self.origin
        if self.truncated:
            d["trunc"] = True
        if self.remainder:
            d["rem"] = self.remainder
        return d

    @classmethod
    def from_payload(cls, d: dict) -> "Contract":
        if not isinstance(d, dict) or d.get("v") != 1:
            raise ValueError("unsupported dowel version")
        path = d.get("p")
        line = d.get("n")
        text = d.get("t")
        parts = d.get("parts")
        names = d.get("names")
        inst = d.get("inst")
        if not isinstance(path, str) or not isinstance(line, int) or not isinstance(text, str):
            raise ValueError("dowel missing path/line/text")
        if not isinstance(parts, list) or not isinstance(names, list) or not isinstance(inst, str):
            raise ValueError("dowel missing template fingerprint")
        bound = d.get("bound")
        if not isinstance(bound, list) or not bound:
            raise ValueError("dowel missing bound holes")
        raw_bind = d.get("bind") or []
        bindings: list[tuple[str, str]] = []
        if isinstance(raw_bind, list):
            for item in raw_bind:
                if isinstance(item, (list, tuple)) and len(item) == 2:
                    bindings.append((str(item[0]), str(item[1])))
        origin = d.get("o")
        return cls(
            path=canon_path(path),
            line=line,
            col=d.get("c") if isinstance(d.get("c"), int) else None,
            text=text,
            parts=tuple(str(x) for x in parts),
            names=tuple(str(x) for x in names),
            bound=tuple(str(x) for x in bound),
            instance=inst,
            bindings=tuple(bindings),
            tokens=_str_list(d.get("k")),
            unique=_str_list(d.get("u")),
            before=_str_list(d.get("b")),
            after=_str_list(d.get("a")),
            lang=d.get("lang") if isinstance(d.get("lang"), str) else "",
            origin=origin if isinstance(origin, str) and origin else None,
            truncated=bool(d.get("trunc")),
            remainder=d.get("rem") if isinstance(d.get("rem"), str) else "",
        )


