@dataclass(frozen=True)
class Template:
    path: str
    line: int
    col: int
    lang: str
    raw: str
    parts: tuple[str, ...]
    holes: int
    names: tuple[str, ...] = ()

    @property
    def static_len(self) -> int:
        return sum(len(p) for p in self.parts)

    @property
    def hole_names(self) -> tuple[str, ...]:
        if self.names and len(self.names) == self.holes:
            return self.names
        return tuple(str(i + 1) for i in range(self.holes))

    @property
    def display(self) -> str:
        names = self.hole_names
        out: list[str] = []
        for i, p in enumerate(self.parts):
            if i:
                name = names[i - 1] if i - 1 < len(names) else ""
                out.append("{" + name + "}")
            out.append(p.replace("\n", "\\n").replace("\t", "\\t"))
        return "".join(out)

    @property
    def static_blob(self) -> str:
        return "".join(self.parts)


