def indent_of(line: str) -> int:
    return len(line) - len(line.lstrip(" \t"))


def is_def_line(line: str) -> bool:
    stripped = line.lstrip()
    if not stripped or stripped.startswith(("#", "//", "/*", "*", "///", "--", "!", "{", "}")):
        return False
    return bool(DEF_RE.match(line.rstrip()))


def is_comment_or_attr(line: str) -> bool:
    s = line.lstrip()
    return s.startswith(("#", "//", "/*", "*", "///", "--", "@", "#[", "#[derive"))


def collect_neighbors(lines: list[str], idx: int, ctx: int = 3) -> tuple[list[str], list[str]]:
    here = lines[idx - 1]
    here_indent = indent_of(here)
    here_is_def = is_def_line(here)
    before: list[str] = []
    j = idx - 1
    while j >= 1 and len(before) < ctx:
        raw = lines[j - 1]
        if normalize(raw) in TRIVIAL_NORMS:
            j -= 1
            continue
        if here_is_def and is_def_line(raw) and indent_of(raw) <= here_indent:
            break
        if here_is_def and indent_of(raw) > here_indent and not is_comment_or_attr(raw):
            j -= 1
            continue
        before.append(clip(raw, MAX_NEIGHBOR_CHARS))
        j -= 1
    before.reverse()
    after: list[str] = []
    j = idx + 1
    while j <= len(lines) and len(after) < ctx:
        raw = lines[j - 1]
        if normalize(raw) in TRIVIAL_NORMS:
            j += 1
            continue
        if is_def_line(raw) and indent_of(raw) <= here_indent:
            break
        after.append(clip(raw, MAX_NEIGHBOR_CHARS))
        j += 1
    return before, after


def lookup_lines(src: Snapshot, path: str) -> tuple[str, list[str]]:
    nfc = canon_path(path)
    if nfc in src.files:
        return nfc, src.files[nfc]
    for form in path_forms(path):
        key = canon_path(form)
        if key in src.files:
            return key, src.files[key]
    hits = [p for p in src.files if p == nfc or p.endswith("/" + nfc)]
    if len(hits) == 1:
        return hits[0], src.files[hits[0]]
    if not hits:
        raise SystemExit(f"dowel mint: source path not in snapshot: {path}")
    raise SystemExit(f"dowel mint: source path ambiguous: {path}")


def is_stem_split(src: str, dst: str) -> bool:
    src, dst = canon_path(src), canon_path(dst)
    stem, _ = os.path.splitext(src)
    return dst.startswith(stem + "/")


def path_score(src: str, dst: str) -> float:
    src, dst = canon_path(src), canon_path(dst)
    if src == dst:
        return 1.0
    s_parts = src.split("/")
    d_parts = dst.split("/")
    s_base = s_parts[-1]
    d_base = d_parts[-1]
    s_stem, s_ext = os.path.splitext(src)
    score = 0.0
    if dst.startswith(s_stem + "/") or is_stem_split(src, dst):
        score += 0.88
    elif s_base == d_base:
        score += 0.42
    else:
        s_stem_base = os.path.splitext(s_base)[0]
        if s_stem_base and os.path.splitext(d_base)[0] == s_stem_base:
            score += 0.28
    if s_ext and s_ext == os.path.splitext(dst)[1]:
        score += 0.04
    s_set, d_set = set(s_parts[:-1]), set(d_parts[:-1])
    if s_set and d_set:
        score += 0.12 * len(s_set & d_set) / len(s_set | d_set)
    return min(1.0, score)


def neighbor_window_score(c: Contract, dst_lines: list[str], dst_i: int, ctx: int = 4) -> float:
    neigh = c.before + c.after
    if not neigh or ctx <= 0 or not dst_lines:
        return 0.0
    lo = max(1, dst_i - ctx)
    hi = min(len(dst_lines), dst_i + ctx)
    window = {normalize(dst_lines[k - 1]) for k in range(lo, hi + 1) if k != dst_i}
    hits = sum(1 for n in neigh if normalize(n) in window)
    return hits / len(neigh)


def distinctive_needles(parts: tuple[str, ...]) -> list[str]:
    needles = [p for p in parts if len(p) >= 8]
    needles.sort(key=len, reverse=True)
    return needles[:4]


def static_ratio(a: str, b: str) -> float:
    if a == b:
        return 1.0
    if not a or not b:
        return 0.0
    return difflib.SequenceMatcher(None, a, b).ratio()


# ---------------------------------------------------------------------------
# mint
# ---------------------------------------------------------------------------


def file_templates(path: str, lines: list[str]) -> list[Template]:
    text = "\n".join(lines)
    if lines and not text.endswith("\n"):
        # keep extract line numbers aligned with original
        text = "\n".join(lines) + ("\n" if False else "")
    return extract_templates("\n".join(lines) + "\n", lang_for(path), path)


def pick_template_for_mint(
    tmpls: list[Template], path: str, line: int, instance: str
) -> tuple[Template, Bind]:
    near = [t for t in tmpls if abs(t.line - line) <= LOCUS_WINDOW]
    pool = near or tmpls
    ranked: list[tuple[float, Template, Bind]] = []
    for t in pool:
        if t.holes < 1:
            continue
        got = match_template(t, instance, allow_truncated=True)
        if got is None:
            continue
        dist = abs(t.line - line)
        prox = 0.08 if dist == 0 else (0.04 if dist < 8 else 0.0)
        ranked.append((got.score + prox + 0.02 * min(t.holes, 7), t, got))
    if not ranked and near:
        for t in tmpls:
            if t.holes < 1:
                continue
            got = match_template(t, instance, allow_truncated=True)
            if got is None:
                continue
            ranked.append((got.score, t, got))
    if not ranked:
        raise SystemExit(
            f"dowel mint: instance does not bind a holed template at {path}:{line}"
        )
    ranked.sort(key=lambda x: (-x[0], x[1].line, x[1].path))
    _, tmpl, bind = ranked[0]
    return tmpl, bind


def mint_contract(
    src: Snapshot, path: str, line: int, col: Optional[int], instance: str
) -> Contract:
    instance = normalize_query(instance)
    if not instance:
        raise SystemExit("dowel mint: empty instance")
    if is_compiler_locator(instance):
        raise SystemExit(f"dowel mint: rustc locator, not an instance: {instance}")
    path, src_lines = lookup_lines(src, path)
    if line < 1 or line > len(src_lines):
        raise SystemExit(f"dowel mint: line {line} out of range ({path} has {len(src_lines)} lines)")
    raw = src_lines[line - 1]
    tmpls = file_templates(path, src_lines)
    tmpl, bind = pick_template_for_mint(tmpls, path, line, instance)
    bound_names = tuple(n for n, _ in bind.bindings)
    if not bound_names:
        raise SystemExit(f"dowel mint: no holes bound at {path}:{line}")
    toks = tokens(raw)
    ranked = sorted(set(toks), key=lambda t: (-len(t), t.lower()))[:8]
    before, after = collect_neighbors(src_lines, tmpl.line, 3)
    return Contract(
        path=path,
        line=tmpl.line,
        col=col if col is not None else tmpl.col,
        text=clip(raw if abs(tmpl.line - line) <= 1 else src_lines[tmpl.line - 1], MAX_TEXT_CHARS),
        parts=tmpl.parts,
        names=tmpl.hole_names,
        bound=bound_names,
        instance=instance,
        bindings=bind.bindings,
        tokens=ranked,
        unique=[],
        before=before,
        after=after,
        lang=tmpl.lang,
        origin=src.origin,
        truncated=bind.truncated,
        remainder=bind.remainder,
    )


# ---------------------------------------------------------------------------
# resolve: seat by template fingerprint + locus, then assay holes
# ---------------------------------------------------------------------------


def candidate_files(dst: Snapshot, c: Contract) -> list[str]:
    files: set[str] = set()
    nfc = canon_path(c.path)
    if nfc in dst.files:
        files.add(nfc)
    stem, _ = os.path.splitext(nfc)
    base = os.path.basename(nfc)
    for p in dst.files:
        if p.startswith(stem + "/") or p.endswith("/" + base):
            files.add(p)
    needles = distinctive_needles(c.parts)
    if needles:
        primary = needles[0]
        hits = []
        for p, lines in dst.files.items():
            blob = "\n".join(lines)
            if primary in blob:
                hits.append(p)
        if len(hits) <= 40:
            files.update(hits)
        elif len(needles) > 1:
            files.update(p for p in hits if needles[1] in "\n".join(dst.files[p]))
        else:
            files.update(hits[:40])
    return sorted(files)


def score_seat(c: Contract, tmpl: Template, dst: Snapshot) -> tuple[float, float, bool]:
    static = static_ratio(c.display.split("{")[0] and "".join(c.parts), tmpl.static_blob)
    # prefer exact static parts over fuzzy wrap
    if c.parts == tmpl.parts:
        static = 1.0
    else:
        static = static_ratio("".join(c.parts), tmpl.static_blob)
    ns = neighbor_window_score(c, dst.files.get(tmpl.path, []), tmpl.line)
    ps = path_score(c.path, tmpl.path)
    exact = c.parts == tmpl.parts or static >= 0.995
    # Seating does not use hole names. Names are the contract, after the seat.
    score = 0.56 * static + 0.28 * ps + 0.16 * ns
    if exact:
        score = max(score, 0.56 + 0.28 * ps + 0.16 * ns)
    return min(1.0, score), ns, exact


def _pick_exact_seat(c: Contract, exacts: list[ScoredTmpl]) -> Optional[ScoredTmpl]:
    if not exacts:
        return None
    if len(exacts) == 1:
        return exacts[0]
    # Stem-split before neighbors. A rename at the extracted body
    # (`uid` → `user_id`) changes neighbor identifiers; the clone that
    # kept the old names would otherwise win on ns and hide `renamed`.
    splits = [s for s in exacts if is_stem_split(c.path, s.tmpl.path)]
    if len(splits) == 1:
        return splits[0]
    best_ns = max(s.ns for s in exacts)
    strong = [s for s in exacts if s.ns >= best_ns - EXACT_NS_KEEP]
    if best_ns >= STRONG_NS_FLOOR:
        strong = [s for s in strong if s.ns >= STRONG_NS_FLOOR]
    if len(strong) == 1:
        return strong[0]
    pool = strong or exacts
    same = [s for s in pool if canon_path(s.tmpl.path) == canon_path(c.path) and s.ns >= 0.5]
    if len(same) == 1:
        return same[0]
    if len(pool) > 1:
        return None
    return max(pool, key=lambda s: (s.ns, s.score, -len(s.tmpl.path)))


def find_seat(
    c: Contract, dst: Snapshot
) -> tuple[Optional[Template], float, list[tuple[str, int]], str]:
    files = candidate_files(dst, c)
    scored: list[ScoredTmpl] = []
    nohole_hits: list[ScoredTmpl] = []
    for path in files:
        lines = dst.files.get(path) or []
        for tmpl in file_templates(path, lines):
            static = 1.0 if c.parts == tmpl.parts else static_ratio("".join(c.parts), tmpl.static_blob)
            if static < SEAT_STATIC_FLOOR and c.parts != tmpl.parts:
                continue
            sc, ns, exact = score_seat(c, tmpl, dst)
            item = ScoredTmpl(sc, tmpl, ns, exact)
            if tmpl.holes < 1:
                nohole_hits.append(item)
                continue
            scored.append(item)

    # A holed seat always beats a specialized (no-hole) copy of the static.
    if not scored and nohole_hits:
        nohole_hits.sort(key=lambda s: (-s.score, s.tmpl.path, s.tmpl.line))
        return nohole_hits[0].tmpl, nohole_hits[0].score, [], "nohole"

    if not scored:
        return None, 0.0, [], ""

    exacts = [s for s in scored if s.exact]
    picked: Optional[ScoredTmpl] = None
    ambiguous: list[ScoredTmpl] = []
    if len(exacts) > 1:
        picked = _pick_exact_seat(c, exacts)
        if picked is None:
            best_ns = max(s.ns for s in exacts)
            ambiguous = [
                s
                for s in exacts
                if s.ns >= best_ns - EXACT_NS_KEEP
                and (best_ns < STRONG_NS_FLOOR or s.ns >= STRONG_NS_FLOOR)
            ]
            if len(ambiguous) < 2:
                ambiguous = exacts
    if picked is None and not ambiguous:
        scored.sort(key=lambda s: (-s.score, s.tmpl.path, s.tmpl.line))
        top = scored[0].score
        ties = [s for s in scored if abs(s.score - top) <= TIE_EPS and s.score >= RESOLVE_THRESHOLD]
        if len(ties) > 1:
            ambiguous = ties
        else:
            picked = scored[0]

    skipped = ""
    if picked is not None and exacts and len(exacts) > 1:
        bits: list[str] = []
        for s in exacts:
            if s.tmpl.path == picked.tmpl.path and s.tmpl.line == picked.tmpl.line:
                continue
            if canon_path(s.tmpl.path) == canon_path(c.path) and s.ns < STRONG_NS_FLOOR:
                bits.append(f"leftover stub {s.tmpl.path}:{s.tmpl.line}")
            elif os.path.basename(s.tmpl.path) == os.path.basename(c.path):
                bits.append(f"basename bait {s.tmpl.path}:{s.tmpl.line}")
            else:
                bits.append(f"{s.tmpl.path}:{s.tmpl.line}")
        if bits:
            skipped = "skipped " + "; ".join(bits[:4])
    # Same-path leftover with no holed template never enters exacts.
    # Name it when dest still has the old path as a non-seat.
    if picked is not None and canon_path(picked.tmpl.path) != canon_path(c.path):
        if canon_path(c.path) in dst.files and "leftover stub" not in skipped:
            old_has = any(
                t.holes and (c.parts == t.parts or static_ratio("".join(c.parts), t.static_blob) >= 0.995)
                for t in file_templates(c.path, dst.files[c.path])
            )
            if not old_has:
                stub = f"leftover stub {c.path}"
                skipped = (skipped + "; " if skipped else "skipped ") + stub

    if ambiguous:
        ambiguous.sort(key=lambda s: (s.tmpl.path, s.tmpl.line))
        alts = [(s.tmpl.path, s.tmpl.line) for s in ambiguous]
        return None, max(s.score for s in ambiguous), alts, skipped

    assert picked is not None
    return picked.tmpl, picked.score, [], skipped


def assay_holes(
    c: Contract, tmpl: Template, instance: str
) -> tuple[str, Bind | None, list[tuple[str, str]], list[str], list[str], list[str]]:
    """Return (kind, bind, rename, dropped, extra, drifted).

    kind is bind | renamed | unbound. Seating already happened.
    The contract is the names that bound at mint, not every template hole.
    """
    got = match_template(tmpl, instance, allow_truncated=True)
    dest_names = list(tmpl.hole_names)
    mint_bound = list(c.bound)
    mint_map = {n: v for n, v in c.bindings}

    if got is None:
        return "unbound", None, [], mint_bound, dest_names, []

    dest_map = {n: v for n, v in got.bindings}
    dest_bound = [n for n, _ in got.bindings]
    dropped = [n for n in mint_bound if n not in dest_names]
    extra = [n for n in dest_names if n not in mint_bound]
    drifted: list[str] = []
    for n in mint_bound:
        if n in dest_map and n in mint_map and dest_map[n] != mint_map[n]:
            drifted.append(n)

    rename: list[tuple[str, str]] = []
    # Same static parts, same arity: names drifted in place.
    # Match by position, not by stored values — a rebound instance
    # (`user 99`) must still report uid→user_id.
    if tuple(c.parts) == tuple(tmpl.parts) and len(mint_bound) == len(dest_names) and mint_bound != dest_names:
        rename = list(zip(mint_bound, dest_names))
        if all(a != b for a, b in rename):
            return "renamed", got, rename, [], [], []
        rename = [(a, b) for a, b in rename if a != b]
        if rename and not dropped:
            return "renamed", got, rename, [], [], []
    if dropped and extra:
        unused = list(extra)
        for old in list(dropped):
            val = mint_map.get(old)
            match = None
            for new in unused:
                if dest_map.get(new) == val:
                    match = new
                    break
            if match is not None:
                rename.append((old, match))
                unused.remove(match)
        if rename and len(rename) == len(dropped) and not unused:
            return "renamed", got, rename, [], [], []

    # contracted names still present and still bind the same values
    still = [n for n in mint_bound if n in dest_bound]
    if still == mint_bound and not drifted:
        return "bind", got, [], [], extra if extra and not c.truncated else [], []

    if still == mint_bound and drifted:
        return "unbound", got, rename, dropped, extra, drifted

    return "unbound", got, rename, dropped, extra, drifted


def classify_status(
    c: Contract,
    tmpl: Optional[Template],
    kind: str,
    nohole: bool,
) -> str:
    if tmpl is None:
        return "gone"
    if nohole or tmpl.holes < 1:
        return "unbound"
    if kind == "unbound":
        return "unbound"
    if kind == "renamed":
        return "renamed"
    if canon_path(c.path) == canon_path(tmpl.path) and c.line == tmpl.line:
        return "seated"
    return "shifted"


def resolve_contract(c: Contract, dst: Snapshot, instance: Optional[str] = None) -> Hit:
    token = encode_dowel(c)
    inst = normalize_query(instance) if instance else c.instance
    if is_compiler_locator(inst):
        return Hit(
            contract=c,
            token=token,
            status="gone",
            note="rustc locator, not an instance",
            score=0.0,
        )
    tmpl, score, alts, skipped = find_seat(c, dst)
    if alts:
        return Hit(
            contract=c,
            token=token,
            status="ambiguous",
            score=score,
            note=(f"{len(alts)} copies: " + "; ".join(f"{p}:{n}" for p, n in alts[:8])),
            alts=alts,
        )
    if tmpl is None:
        note = "no matching template"
        if skipped:
            note = note + "; " + skipped
        return Hit(contract=c, token=token, status="gone", score=0.0, note=note)

    nohole = tmpl.holes < 1
    kind, got, rename, dropped, extra, drifted = assay_holes(c, tmpl, inst)
    status = classify_status(c, tmpl, kind, nohole)
    bits: list[str] = []
    if rename:
        bits.append(" ".join(f"{{{a}}}→{{{b}}}" for a, b in rename))
    if dropped:
        bits.append("dropped " + ",".join("{" + n + "}" for n in dropped))
    if extra and status == "unbound":
        bits.append("extra " + ",".join("{" + n + "}" for n in extra))
    if drifted:
        bits.append("drifted " + ",".join("{" + n + "}" for n in drifted))
    if skipped:
        bits.append(skipped)
    if status == "shifted":
        if canon_path(c.path) != canon_path(tmpl.path):
            bits.insert(0, "path or surrounding file changed")
        else:
            bits.insert(0, "same file, line number drifted")
    if status == "seated" and not bits:
        bits.append("holes=" + ",".join(c.bound))
    if status == "unbound" and nohole:
        bits.insert(0, "template lost its holes")
    dest_bind = got.bindings if got else ()
    return Hit(
        contract=c,
        token=token,
        status=status,
        dest_path=tmpl.path,
        dest_line=tmpl.line,
        dest_tmpl=tmpl.display,
        dest_names=tmpl.hole_names,
        dest_bindings=dest_bind,
        score=score,
        note="; ".join(bits),
        rename=rename,
        dropped=dropped,
        extra=extra,
        drifted=drifted,
        truncated=bool(got and got.truncated),
    )


# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------


def format_from(c: Contract) -> str:
    col = f":{c.col}" if c.col is not None else ""
    return f"{c.path}:{c.line}{col}"


def format_to(hit: Hit) -> str:
    if hit.status == "ambiguous" and hit.alts:
        return ",".join(f"{p}:{n}" for p, n in hit.alts)
    if hit.dest_path is None or hit.dest_line is None or hit.status == "gone":
        return "-"
    return f"{hit.dest_path}:{hit.dest_line}"


def print_human(hit: Hit) -> None:
    src = format_from(hit.contract)
    dst = format_to(hit)
    if hit.status == "gone":
        dst = "(gone)"
    extra = f"  {hit.note}" if hit.note else ""
    print(f"{hit.status:10} {src:40} → {dst:40} {hit.score:5.3f}{extra}")
    print(f"  tmpl:  {hit.dest_tmpl or hit.contract.display}")
    shown = False
    if hit.rename:
        mint_map = {n: v for n, v in hit.contract.bindings}
        dest_map = {n: v for n, v in hit.dest_bindings}
        for old, new in hit.rename:
            val = dest_map.get(new, mint_map.get(old, ""))
            print(f"  {{{old}}} → {{{new}}} = {val}")
            shown = True
    if not shown:
        if hit.dest_bindings:
            for n, v in hit.dest_bindings:
                print(f"  {{{n}}} = {v}")
        else:
            for n, v in hit.contract.bindings:
                print(f"  {{{n}}} = {v}  (mint)")
    if hit.contract.truncated and hit.contract.remainder:
        print(f"  truncated: {hit.contract.remainder}")


def print_porcelain(hit: Hit) -> None:
    note = hit.note.replace("\t", " ").replace("\n", " ")
    holes = ",".join(hit.contract.bound)
    if hit.rename:
        holes = ",".join(f"{a}→{b}" for a, b in hit.rename)
    print(
        f"{hit.status}\t-\t{format_from(hit.contract)}\t{format_to(hit)}\t"
        f"{hit.score:.3f}\t{holes}\t{note}"
    )


def print_json(hit: Hit) -> None:
    obj = {
        "dowel": hit.token,
        "from": {"path": hit.contract.path, "line": hit.contract.line, "col": hit.contract.col},
        "to": (
            None
            if hit.dest_path is None or hit.status in {"gone", "ambiguous"}
            else {"path": hit.dest_path, "line": hit.dest_line}
        ),
        "status": hit.status,
        "score": round(hit.score, 4),
        "note": hit.note,
        "tmpl": hit.dest_tmpl or hit.contract.display,
        "bound": list(hit.contract.bound),
        "dest_names": list(hit.dest_names),
        "bindings": [{"name": n, "value": v} for n, v in (hit.dest_bindings or hit.contract.bindings)],
        "rename": [{"from": a, "to": b} for a, b in hit.rename],
        "dropped": hit.dropped,
        "extra": hit.extra,
        "drifted": hit.drifted,
        "origin": hit.contract.origin,
        "instance": hit.contract.instance,
    }
    if hit.alts:
        obj["candidates"] = [{"path": p, "line": n} for p, n in hit.alts]
    print(json.dumps(obj, ensure_ascii=False))


def print_show(c: Contract, token: str, file=sys.stdout) -> None:
    print(token, file=file)
    print(f"  minted: {format_from(c)}", file=file)
    print(f"  tmpl:   {c.display}", file=file)
    print(f"  bound:  {', '.join('{' + n + '}' for n in c.bound)}", file=file)
    for n, v in c.bindings:
        print(f"    {{{n}}} = {v}", file=file)
    print(f"  inst:   {c.instance}", file=file)
    print(f"  text:   {c.text}", file=file)
    if c.origin:
        print(f"  origin: {c.origin}", file=file)
    if c.truncated:
        print(f"  truncated: {c.remainder}", file=file)


