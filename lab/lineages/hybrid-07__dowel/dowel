def cmd_selftest() -> int:
    errors: list[str] = []

    def expect(cond: object, msg: str) -> None:
        if not cond:
            errors.append(msg)

    parts, names = tokenize_named("user {uid} not found")
    expect(names == ("uid",), f"named uid: {names}")
    expect(parts == ("user ", " not found"), f"parts: {parts}")

    parts, names = tokenize_named("cannot reach {host}:{port} after {n} retries")
    expect(names == ("host", "port", "n"), f"three names: {names}")

    parts, names = tokenize_named("failed to spawn `{cmd}`")
    expect(names == ("cmd",), f"cmd name: {names}")

    parts, names = tokenize_named(r"camera presence \(self.isCameraEnabled ? " + '"enabled"' + r" : " + '"disabled"' + ", privacy: .public)")
    # tokenize on already-extracted body with \(
    body = 'camera presence \\(self.isCameraEnabled ? "enabled" : "disabled", privacy: .public)'
    parts, names = tokenize_named(body)
    expect(names == ("self.isCameraEnabled",), f"swift camera: {names}")

    seven = (
        "transition \\(oldPhase.rawValue, privacy: .public) → \\(newPhase.rawValue, privacy: .public) "
        "reason=\\(reason.name, privacy: .public) idle=\\(idle, privacy: .public)s "
        "deserted=\\(counters.deserted.value, privacy: .public) "
        "driftRecovered=\\(counters.driftRecovered.value, privacy: .public) "
        "awayRecovered=\\(counters.awayRecovered.value, privacy: .public)"
    )
    parts, names = tokenize_named(seven)
    expect(len(names) == 7, f"7-hole names {len(names)}: {names}")
    expect("oldPhase.rawValue" in names and "idle" in names, f"7-hole contents: {names}")

    expect(is_compiler_locator("   --> src/git/revert.rs:46:18".strip()), "--> locator")
    expect(is_compiler_locator("error[E0308]: mismatched types"), "E0308")
    expect(not is_compiler_locator("failed to spawn `git apply --reverse`"), "spawn not locator")

    t = template_of("u.py", 1, 1, "py", "user {uid} not found")
    got = match_template(t, "user 42 not found")
    expect(got is not None and dict(got.bindings).get("uid") == "42", f"bind uid: {got}")
    trunc = match_template(t, "user 42 not")
    expect(trunc is not None and trunc.truncated and dict(trunc.bindings).get("uid") == "42", f"trunc: {trunc}")
    expect(trunc is not None and "found" in (trunc.remainder or ""), f"user remainder: {trunc.remainder if trunc else None}")

    seven_t = template_of("log.swift", 554, 1, "swift", seven)
    seven_q = "transition focused → idle reason=timeout idle=12s"
    seven_hit = match_template(seven_t, seven_q)
    expect(
        seven_hit is not None
        and seven_hit.truncated
        and dict(seven_hit.bindings).get("idle") == "12"
        and "{counters.deserted.value}" in (seven_hit.remainder or ""),
        f"7-hole remainder must name the next hole: {seven_hit.remainder if seven_hit else None}",
    )

    decoy = template_of("p.rs", 3, 1, "rust", "2026-08-19T23:50:01Z ERROR failed to spawn")
    expect(match_template(decoy, "2026-08-19T23:50:01Z ERROR failed to spawn `git apply --reverse`") is None, "no-hole prefix decoy")

    rust = template_of("p.rs", 7, 1, "rust", "failed to spawn `{cmd}`")
    spawn = match_template(rust, "2026-08-19T23:50:01Z ERROR failed to spawn `git apply --reverse`")
    expect(spawn is not None and dict(spawn.bindings).get("cmd") == "git apply --reverse", f"spawn span: {spawn}")

    import tempfile

    tmp = Path(tempfile.mkdtemp(prefix="dowel-self-"))
    try:
        src = tmp / "from"
        dst = tmp / "to"
        (src / "src").mkdir(parents=True)
        (src / "src" / "user.py").write_text(
            "def report(uid):\n    raise Error(f\"user {uid} not found\")\n\n"
            "def reach(host, port, n):\n"
            '    raise Error(f"cannot reach {host}:{port} after {n} retries")\n',
            encoding="utf-8",
        )
        snap = load_snapshot(git_root=None, ref=None, directory=src, label="from")
        c = mint_contract(snap, "src/user.py", 2, None, "user 42 not found")
        expect(c.bound == ("uid",), f"mint bound: {c.bound}")
        token = encode_dowel(c)
        expect(token.startswith(PREFIX), token)
        back = decode_dowel(token)
        expect(back.bound == ("uid",) and back.instance == "user 42 not found", "roundtrip")

        # dest: leftover stub + renamed body + basename bait
        (dst / "src" / "user").mkdir(parents=True)
        (dst / "src" / "legacy").mkdir(parents=True)
        (dst / "src" / "user.py").write_text(
            "def report(uid):\n    from src.user.messages import report as impl\n    return impl(uid)\n",
            encoding="utf-8",
        )
        (dst / "src" / "user" / "messages.py").write_text(
            "def report(user_id):\n    raise Error(f\"user {user_id} not found\")\n\n"
            "def reach(host, n):\n"
            '    raise Error(f"cannot reach {host} after {n} retries")\n',
            encoding="utf-8",
        )
        (dst / "src" / "legacy" / "user.py").write_text(
            "def report(uid):\n    raise Error(f\"user {uid} not found\")\n",
            encoding="utf-8",
        )
        dest = load_snapshot(git_root=None, ref=None, directory=dst, label="to")
        hit = resolve_contract(c, dest)
        expect(hit.status == "renamed", f"expected renamed, got {hit.status} {hit.dest_path} {hit.note}")
        expect(hit.dest_path == "src/user/messages.py", f"seat {hit.dest_path}")
        expect(hit.rename == [("uid", "user_id")], f"rename {hit.rename}")
        hit_new = resolve_contract(c, dest, instance="user 99 not found")
        expect(hit_new.status == "renamed", f"rebind renamed: {hit_new.status} {hit_new.note}")
        expect(dict(hit_new.dest_bindings).get("user_id") == "99", f"rebind val {hit_new.dest_bindings}")
        expect("legacy" not in (hit.dest_path or ""), "basename bait stole seat")
        expect("user.py" != os.path.basename(hit.dest_path or "") or "messages" in (hit.dest_path or ""), "leftover?")
        expect("leftover stub" in hit.note, f"note leftover: {hit.note}")
        expect("basename bait" in hit.note, f"note bait: {hit.note}")

        # same holes still bind after a move (no rename)
        (dst / "src" / "user" / "messages.py").write_text(
            "def report(uid):\n    raise Error(f\"user {uid} not found\")\n",
            encoding="utf-8",
        )
        dest2 = load_snapshot(git_root=None, ref=None, directory=dst, label="to2")
        hit2 = resolve_contract(c, dest2)
        expect(hit2.status == "shifted", f"moved same holes: {hit2.status} {hit2.note}")
        expect(hit2.dest_path == "src/user/messages.py", f"shifted seat {hit2.dest_path}")

        # identity
        hit3 = resolve_contract(c, snap)
        expect(hit3.status == "seated", f"identity {hit3.status}")

        # hole dropped
        c_reach = mint_contract(snap, "src/user.py", 5, None, "cannot reach db.internal:5432 after 3 retries")
        expect(set(c_reach.bound) == {"host", "port", "n"}, f"reach bound {c_reach.bound}")
        (dst / "src" / "user" / "messages.py").write_text(
            "def reach(host, n):\n"
            '    raise Error(f"cannot reach {host} after {n} retries")\n',
            encoding="utf-8",
        )
        dest3 = load_snapshot(git_root=None, ref=None, directory=dst, label="to3")
        hit4 = resolve_contract(c_reach, dest3)
        expect(hit4.status == "unbound", f"dropped port should unbound: {hit4.status} {hit4.note}")
        expect("port" in hit4.dropped, f"dropped {hit4.dropped}")

        # gone
        empty = tmp / "empty"
        empty.mkdir()
        (empty / "README").write_text("nothing\n", encoding="utf-8")
        dest_e = load_snapshot(git_root=None, ref=None, directory=empty, label="empty")
        hit5 = resolve_contract(c, dest_e)
        expect(hit5.status == "gone", f"empty dest {hit5.status}")

        # truncated token
        try:
            decode_dowel(token[:24])
            errors.append("truncated token decoded")
        except ValueError:
            pass

        # rustc locator mint
        try:
            mint_contract(snap, "src/user.py", 2, None, "   --> src/git/revert.rs:46:18")
            errors.append("locator mint succeeded")
        except SystemExit:
            pass

        # no-hole refuse: instance that is the whole static
        (src / "src" / "plain.py").write_text('MSG = "hello world"\n', encoding="utf-8")
        snap_p = load_snapshot(git_root=None, ref=None, directory=src, label="plain")
        try:
            mint_contract(snap_p, "src/plain.py", 1, None, "hello world")
            errors.append("no-hole mint succeeded")
        except SystemExit:
            pass

        # canonical mint
        again = mint_contract(snap, "src/user.py", 2, None, "user 42 not found")
        expect(encode_dowel(c) == encode_dowel(again), "canonical mint")

        # NFD path
        cafe = src / "src" / ("caf" + "\u00e9" + ".py")
        cafe.write_text('def cafe_fn(uid):\n    raise Error(f"café user {uid} gone")\n', encoding="utf-8")
        snap_c = load_snapshot(git_root=None, ref=None, directory=src, label="cafe")
        nfd = unicodedata.normalize("NFD", "src/café.py")
        c_cafe = mint_contract(snap_c, nfd, 2, None, "café user 7 gone")
        expect("uid" in c_cafe.bound, f"cafe bound {c_cafe.bound}")
        dest_c = load_snapshot(git_root=None, ref=None, directory=src, label="cafe-d")
        hit_c = resolve_contract(c_cafe, dest_c)
        expect(hit_c.status == "seated", f"cafe seated {hit_c.status} {hit_c.dest_path}")
    finally:
        import shutil

        shutil.rmtree(tmp, ignore_errors=True)

    if errors:
        print("selftest: FAILED", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in {"-h", "--help"}:
        build_parser().print_help()
        print()
        print(HINT)
        return 0
    # bare token implies resolve, flags on either side
    if argv and any(is_dowel_token(a) for a in argv) and not any(
        a in {"mint", "resolve", "show", "selftest", "--selftest"} for a in argv
    ):
        argv = ["resolve", *argv]
    args = build_parser().parse_args(argv)
    if args.selftest or args.cmd == "selftest":
        return cmd_selftest()
    if args.cmd == "mint":
        return cmd_mint(args)
    if args.cmd == "resolve":
        return cmd_resolve(args)
    if args.cmd == "show":
        return cmd_show(args)
    build_parser().print_help()
    print()
    print(HINT)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
