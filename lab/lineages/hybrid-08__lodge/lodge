#!/usr/bin/env python3
"""lodge — occupancy of mixed image-claims (git range + review stream).

sate occupies a unified diff. plea occupies a review-suggestion stream.
Concatenating them is two reports and two vocabularies (TAKEN/OPEN vs
APPLIED/PENDING). lodge ingests both as the same object: a before→after
image claim. Cross-origin equal cores fuse into one occupancy (via=both).
One status vocabulary: APPLIED / PENDING / MIXED / DUPLEX / SUPERSEDED.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Iterator

VERSION = "0.2.0"  # 0.1 exact-core fuse; 0.2 range path-rewrite + subset via=both

FATES = ("APPLIED", "PENDING", "MIXED", "DUPLEX", "SUPERSEDED")
SKIP_FATES = ("SKIP", "BINARY", "EMPTY", "NOFILE")
VIA = ("hunk", "plea", "both")

EXIT_APPLIED = 0
EXIT_PENDING = 1
EXIT_SPLIT = 2
EXIT_ERROR = 3

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@(.*)$")
SUGGEST_RE = re.compile(r"```suggestion[^\n]*\n(.*?)```", re.S)
GENERIC_RE = re.compile(
    r"^[\s{}\[\]().,:;]*$"
    r"|^\s*(else:?|end|pass|break|continue|return|fi|then|do|done|"
    r"end\.?|\);?|//|/\*|\*/|#)\s*$",
    re.I,
)
PATH_LINE_RE = re.compile(
    r"^(?:(?:path|file|filename)\s*:\s*)?+"
    r"(?P<path>(?:[\w./-]+/)*[\w./-]+\.[A-Za-z0-9+]+)"
    r"(?::(?P<a>\d+)(?:-(?P<b>\d+))?)?\s*$"
)
HEADING_PATH_RE = re.compile(
    r"^#{1,6}\s+`?(?P<path>(?:[\w./-]+/)*[\w./-]+\.[A-Za-z0-9+]+)`?"
    r"(?::(?P<a>\d+)(?:-(?P<b>\d+))?)?"
)
HTML_PATH_RE = re.compile(
    r"""<!--\s*(?:filepath|path|file)\s*:\s*([^\s>]+)""",
    re.I,
)
IN_TICK_PATH_RE = re.compile(
    r"""(?:commented on|in)\s+`([^`]+\.[A-Za-z0-9+]+)`""",
    re.I,
)

Norm = Callable[[str], str]
FUZZ_RATIO = 0.85


