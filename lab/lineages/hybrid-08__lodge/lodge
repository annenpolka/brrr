                recon="explicit",
            )
            fused = fuse_claims(hunks + [plea])
            if not (len(fused) == 1 and fused[0].origin == "both"):
                raise AssertionError([c.origin for c in fused])
            against = default_against(root, None, worktree=False)
            if against != "HEAD":
                raise AssertionError(against)
            now = classify_stream(fused, root, against, ident)
            if unanimous(now) != "APPLIED":
                raise AssertionError(f"HEAD occupancy {now[0].fate} (dirty leaked)")
            wt = classify_stream(fused, root, None, ident)
            if unanimous(wt) != "PENDING":
                raise AssertionError(wt[0].fate)
            sandwich_claim(fused[0], root, now[0], ident, False)
            if now[0].sandwich != "PENDING":
                raise AssertionError(now[0].sandwich)
            parent = classify_stream(fused, root, "HEAD^", ident)
            if unanimous(parent) != "PENDING":
                raise AssertionError(parent[0].fate)

    t("fused-sandwich-HEAD-not-worktree", sandwich_git)

    def weird_path():
        c = Claim(
            id="jp",
            path="docs/計画 (1).md",
            before=["alpha"],
            after=["beta"],
            origin="plea",
        )
        v = occupy({"docs/計画 (1).md": "beta\n"}, [c])
        if unanimous(v) != "APPLIED":
            raise AssertionError(v[0].fate)

    t("weird-path-spaces-japanese", weird_path)

    def json_has_no_alias():
        v = Verdict(
            fate="APPLIED",
            path="a.py",
            claim="c",
            method="exact-after",
            via="both",
        )
        d = v.as_dict()
        if "alias" in d:
            raise AssertionError(d)
        if d["via"] != "both" or d["fate"] != "APPLIED":
            raise AssertionError(d)

    t("json-one-vocabulary-no-alias", json_has_no_alias)

    print(f"selftest  {passed} passed  {failed} failed")
    return 0 if failed == 0 else 1


