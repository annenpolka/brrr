@dataclass
class Claim:
    id: str
    path: str
    before: list[str]
    after: list[str]
    minus: list[str] = field(default_factory=list)
    plus: list[str] = field(default_factory=list)
    origin: str = "plea"  # hunk | plea | both
    file_kind: str = "modify"  # modify | create | delete | rename
    side: str = "RIGHT"
    start: int | None = None
    end: int | None = None
    commit_id: str | None = None
    original_commit_id: str | None = None
    in_reply_to: str | None = None
    body: str = ""
    recon: str = ""
    source: str = ""
    header: str = ""
    witnesses: list[str] = field(default_factory=list)
    covers: list[str] = field(default_factory=list)
    tagged: list[tuple[str, str]] = field(default_factory=list)
    old_path: str = ""
    moved_from: str = ""

    def __post_init__(self) -> None:
        if not self.witnesses:
            self.witnesses = [self.id]


