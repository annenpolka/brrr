def material(verdicts: list[Verdict]) -> list[Verdict]:
    return [v for v in verdicts if v.fate not in SKIP_FATES]


def counted(verdicts: list[Verdict]) -> dict[str, int]:
    c: dict[str, int] = {}
    for v in verdicts:
        c[v.fate] = c.get(v.fate, 0) + 1
    return c


def via_counted(verdicts: list[Verdict]) -> dict[str, int]:
    c: dict[str, int] = {}
    for v in material(verdicts):
        c[v.via] = c.get(v.via, 0) + 1
    return c


def unanimous(verdicts: list[Verdict]) -> str:
    s = {v.fate for v in material(verdicts)}
    if not s:
        return "EMPTY"
    if len(s) == 1:
        return next(iter(s))
    return "SPLIT"


def exit_for(uni: str) -> int:
    if uni in ("APPLIED", "EMPTY"):
        return EXIT_APPLIED
    if uni == "PENDING":
        return EXIT_PENDING
    return EXIT_SPLIT


def format_human(verdicts: list[Verdict], title: str) -> str:
    uni = unanimous(verdicts)
    c = counted(verdicts)
    vc = via_counted(verdicts)
    bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
    vbits = " ".join(f"{k}={v}" for k, v in sorted(vc.items()) if v)
    n = len(material(verdicts))
    lines = [
        f"lodge  {title}  n={n}  unanimous={uni}  {bits}  via {vbits}".rstrip()
    ]
    for v in verdicts:
        if v.fate in SKIP_FATES:
            continue
        loc = f"{v.path}  #{v.claim}"
        extra = f"  via={v.via}  {v.method}"
        if v.recon:
            extra += f"  recon={v.recon}"
        if v.witnesses and v.via == "both":
            extra += "  witnesses=" + ",".join(v.witnesses[:4])
        if v.covers:
            extra += "  covers=" + ",".join(v.covers[:4])
        if v.sandwich:
            extra += f"  then={v.sandwich}"
        if v.moved_from:
            extra += f"  from={v.moved_from}"
        if v.note:
            extra += f"  {v.note}"
        lines.append(f"{v.fate:<11} {loc}{extra}")
    return "\n".join(lines) + "\n"


def format_tsv(verdicts: list[Verdict]) -> str:
    rows = [
        "fate\tvia\tpath\tclaim\tmethod\trecon\twitnesses\tcollide\techo\tcovers\tmoved_from\tnear_line"
    ]
    for v in verdicts:
        if v.fate in SKIP_FATES:
            continue
        rows.append(
            "\t".join(
                [
                    v.fate,
                    v.via,
                    v.path,
                    str(v.claim),
                    v.method,
                    v.recon,
                    ",".join(v.witnesses),
                    ",".join(v.collide),
                    ",".join(v.echo),
                    ",".join(v.covers),
                    v.moved_from,
                    "" if v.near_line is None else str(v.near_line),
                ]
            )
        )
    return "\n".join(rows) + "\n"


def format_json(verdicts: list[Verdict], extra: dict) -> str:
    payload = {
        **extra,
        "unanimous": unanimous(verdicts),
        "counts": counted(verdicts),
        "via": via_counted(verdicts),
        "claims": [v.as_dict() for v in verdicts if v.fate not in SKIP_FATES],
    }
    return json.dumps(payload, ensure_ascii=False, indent=2) + "\n"


