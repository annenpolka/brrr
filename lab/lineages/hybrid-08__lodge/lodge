HELP = """\
lodge — occupancy of mixed image-claims (git range + review stream)

A hunk and a review suggestion are the same object: a before→after image
claim. sate occupies a patch. plea occupies a stream. Piping them is two
reports (and plea's TAKEN/OPEN/STALE aliases). lodge sniffs each input,
occupies every claim with one kernel, and fuses equal cores from opposite
origins into one occupancy (via=both).

Usage:
  lodge --git REV FILE       git range + review stream (the joint)
  lodge FILE [FILE ...]      patch and/or JSON/JSONL/markdown, sniffed
  lodge --git REV            range only (still the same kernel)
  lodge -                    stdin, sniffed
  gh api …/comments | lodge --git main...HEAD -C repo
  lodge --selftest

Tree:
  -C DIR           tree root (default: cwd)
  --against REF    read files from git REF (default: HEAD if git, else worktree)
  --worktree       occupy the dirty worktree, not HEAD

Matching:
  --ignore-space   collapse horizontal whitespace
  --fuzz           accept windows with ≥0.85 line overlap
  --sandwich       also classify plea claims against original_commit_id
  --no-fuse        keep hunk and plea as separate rows (debug concatenation)

Join:
  Equal cores collapse to via=both. A suggestion that is a plus-subset of a
  hunk is via=both without dropping the hunk (covers/echo, not collide).
  A review on a deleted path fuses with the create/rename the range landed.

Output:
  --json / --tsv / --quiet
  --report-only    always exit 0
  --only / --pick FATE[,FATE]   APPLIED,PENDING,MIXED,DUPLEX,SUPERSEDED
  --via hunk|plea|both

Exit:
  0  unanimous APPLIED (or empty)
  1  unanimous PENDING
  2  SPLIT / MIXED / DUPLEX / SUPERSEDED
  3  error
"""


def resolve_only(s: str | None) -> set[str] | None:
    if not s:
        return None
    out = set()
    for part in s.split(","):
        p = part.strip().upper()
        if not p:
            continue
        out.add(p)
    return out or None


def emit(verdicts: list[Verdict], args: argparse.Namespace, extra: dict) -> int:
    only = resolve_only(args.only or args.pick)
    if only:
        verdicts = [v for v in verdicts if v.fate in only or v.fate in SKIP_FATES]
    if args.via:
        want = {x.strip().lower() for x in args.via.split(",") if x.strip()}
        verdicts = [v for v in verdicts if v.via in want or v.fate in SKIP_FATES]
    title = extra.get("title") or "stdin"
    if args.json:
        sys.stdout.write(
            format_json(verdicts, {k: v for k, v in extra.items() if k != "title"})
        )
    elif args.tsv:
        sys.stdout.write(format_tsv(verdicts))
    else:
        if not args.quiet:
            sys.stdout.write(format_human(verdicts, str(title)))
        else:
            uni = unanimous(verdicts)
            c = counted(verdicts)
            vc = via_counted(verdicts)
            bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
            vbits = " ".join(f"{k}={v}" for k, v in sorted(vc.items()) if v)
            sys.stdout.write(f"{uni}\t{bits}\tvia {vbits}\n")
    code = exit_for(unanimous(verdicts))
    if args.report_only:
        return 0
    return code


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="lodge",
        description="Occupancy of mixed image-claims (git range + review stream)",
        add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("files", nargs="*", help="patch and/or review stream, or -")
    p.add_argument("-C", default=".", metavar="DIR", help="tree root")
    p.add_argument("--against", default=None, metavar="REF", help="git ref (default HEAD)")
    p.add_argument("--worktree", action="store_true", help="read dirty worktree files")
    p.add_argument("--git", metavar="REV", help="ingest git show REV / git diff A..B as claims")
    p.add_argument("--ignore-space", action="store_true")
    p.add_argument("--fuzz", dest="fuzz", action="store_true", default=False)
    p.add_argument("--no-fuzz", dest="fuzz", action="store_false")
    p.add_argument("--sandwich", action="store_true")
    p.add_argument("--no-fuse", action="store_true", help="do not collapse equal cores")
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--report-only", action="store_true")
    p.add_argument("--only", metavar="FATE[,FATE]")
    p.add_argument("--pick", metavar="FATE[,FATE]")
    p.add_argument("--via", metavar="hunk|plea|both")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(HELP)
        return 0
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"lodge {VERSION}")
        return 0
    if args.selftest:
        return selftest(fuzz=args.fuzz)

    root = Path(args.C).resolve()
    claims: list[Claim] = []
    sources: list[str] = []

    if args.git:
        try:
            text = patch_of_rev(root, args.git)
        except RuntimeError as e:
            print(f"lodge: {e}", file=sys.stderr)
            return EXIT_ERROR
        hunks = claims_from_patch(text, source=f"git:{args.git}", rev=args.git)
        claims.extend(hunks)
        sources.append(f"git:{args.git}")

    texts: list[tuple[str, str]] = []
    files = list(args.files)
    if files == ["-"] or (not files and not args.git and not sys.stdin.isatty()):
        texts.append(("stdin", sys.stdin.read()))
        files = [f for f in files if f != "-"]
    elif "-" in files:
        texts.append(("stdin", sys.stdin.read()))
        files = [f for f in files if f != "-"]
    for f in files:
        try:
            texts.append((f, Path(f).read_text(encoding="utf-8")))
        except OSError as e:
            print(f"lodge: {e}", file=sys.stderr)
            return EXIT_ERROR

    for src, text in texts:
        got = ingest_text(text, source=src)
        claims.extend(got)
        sources.append(src)

    if not claims:
        if not args.git and not texts:
            sys.stdout.write(HELP)
            return EXIT_ERROR
        print("lodge: no image claims in input", file=sys.stderr)
        return 0 if args.report_only else EXIT_APPLIED

    if not args.no_fuse:
        claims = fuse_claims(claims)

    against = default_against(root, args.against, args.worktree)
    norm = space_norm if args.ignore_space else ident
    verdicts = classify_stream(claims, root, against, norm, fuzz=args.fuzz)
    if args.sandwich:
        cmap = {c.id: c for c in claims}
        for v in verdicts:
            c = cmap.get(v.claim)
            if c:
                sandwich_claim(c, root, v, norm, args.fuzz)

    title = "+".join(sources) if sources else "stdin"
    try:
        return emit(
            verdicts,
            args,
            {
                "title": title,
                "tree": str(root),
                "against": against if against is not None else ":worktree",
                "n": len(material(verdicts)),
                "fused": not args.no_fuse,
            },
        )
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
