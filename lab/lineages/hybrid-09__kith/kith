def keep_ident(w: str) -> bool:
    if SHORT_NATAL.match(w):
        return True
    if len(w) < 3:
        return False
    if w.lower() in STOP:
        return not looks_like_symbol(w)
    if len(w) == 40 and all(c in "0123456789abcdefABCDEF" for c in w):
        return False
    return True


def looks_like_symbol(tok: str) -> bool:
    if not tok or len(tok) < 2:
        return False
    if "_" in tok or "-" in tok or "/" in tok or "." in tok:
        return True
    if re.search(r"[a-z][A-Z]", tok):
        return True
    if re.fullmatch(r"[A-Z]{2,}[A-Z0-9]*", tok):
        return True
    if re.search(r"\d", tok) and re.search(r"[A-Za-z]", tok):
        return True
    return False


def ident_parts(name: str) -> tuple[str, ...]:
    s = name.replace("-", "_")
    parts: list[str] = []
    for chunk in s.split("_"):
        if not chunk:
            continue
        bits = re.findall(
            r"[A-Z]+(?=[A-Z][a-z0-9])|[A-Z]?[a-z]+|[A-Z]+|\d+", chunk
        )
        if bits:
            parts.extend(b.lower() for b in bits if b)
        else:
            parts.append(chunk.lower())
    return tuple(parts) if parts else (name.lower(),)


def surfaces(name: str) -> set[str]:
    parts = list(ident_parts(name))
    if not parts:
        return {name}
    camel = parts[0] + "".join(p.capitalize() for p in parts[1:])
    pascal = "".join(p.capitalize() for p in parts)
    snake = "_".join(parts)
    kebab = "-".join(parts)
    const = "_".join(p.upper() for p in parts)
    out = {name, name.lower(), name.upper(), camel, pascal, snake, kebab, const}
    if SHORT_NATAL.match(name):
        out.add(name.lower())
        out.add(name.upper())
    return {s for s in out if s}


def same_inflection(a: str, b: str) -> bool:
    return ident_parts(a) == ident_parts(b)


def stem_related(a: str, b: str) -> bool:
    pa, pb = ident_parts(a), ident_parts(b)
    if not pa or not pb:
        return False
    if pa == pb:
        return True
    if pa == pb[-len(pa) :]:
        extra = pb[: -len(pa)]
        word = "".join(pa)
        if extra and all(p in STEM_NOISE for p in extra):
            return False
        return len(pa) > 1 or len(word) >= 6
    if pb == pa[-len(pb) :]:
        extra = pa[: -len(pb)]
        word = "".join(pb)
        if extra and all(p in STEM_NOISE for p in extra):
            return False
        return len(pb) > 1 or len(word) >= 6
    return False


def distinctive_ident(name: str) -> bool:
    if SHORT_NATAL.match(name):
        return True
    parts = ident_parts(name)
    if len(parts) >= 2:
        return True
    if name.lower() in GENERIC_NAMES:
        return False
    return len(name) >= 8


def slot_idents(text: str) -> list[str]:
    found: list[str] = []
    seen: set[str] = set()
    for m in SLOT_RE.finditer(text):
        w = m.group(1)
        if not keep_ident(w):
            continue
        if w.lower() in seen:
            continue
        seen.add(w.lower())
        found.append(w)
    return found


def extract_idents(line: str) -> list[str]:
    found: list[str] = []
    seen: set[str] = set()
    for m in IDENT_RE.finditer(line):
        tok = m.group(0)
        if m.start() > 0 and line[m.start() - 1].isalpha():
            continue
        if not keep_ident(tok):
            continue
        if tok.isnumeric():
            continue
        key = tok.lower()
        if key in seen:
            continue
        seen.add(key)
        found.append(tok)
    for m in KEBAB_RE.finditer(line):
        tok = m.group(0)
        if tok.lower() in STOP:
            continue
        if tok.lower() not in seen:
            seen.add(tok.lower())
            found.append(tok)
    return found


def pair_idents(
    old_ids: Iterable[str],
    new_ids: Iterable[str],
    *,
    one_to_one: bool = True,
    stem: bool = True,
) -> list[tuple[str, str]]:
    old = list(dict.fromkeys(old_ids))
    new = list(dict.fromkeys(new_ids))
    new_l = {n.lower() for n in new}
    abandoned = [o for o in old if o.lower() not in new_l]
    adopted = [n for n in new if n.lower() not in {o.lower() for o in old}]
    pairs: list[tuple[str, str]] = []
    used_o: set[str] = set()
    used_n: set[str] = set()

    def take(o: str, n: str) -> None:
        used_o.add(o.lower())
        used_n.add(n.lower())
        pairs.append((o, n))

    for o in abandoned:
        cands = [
            n
            for n in adopted
            if n.lower() not in used_n and same_inflection(o, n) and o.lower() != n.lower()
        ]
        if len(cands) == 1:
            take(o, cands[0])

    if stem:
        for o in abandoned:
            if o.lower() in used_o:
                continue
            cands = [
                n for n in adopted if n.lower() not in used_n and stem_related(o, n)
            ]
            if len(cands) == 1:
                take(o, cands[0])

    if one_to_one:
        left_o = [o for o in abandoned if o.lower() not in used_o]
        left_n = [n for n in adopted if n.lower() not in used_n]
        if len(left_o) == 1 and len(left_n) == 1 and distinctive_ident(left_o[0]):
            take(left_o[0], left_n[0])
    return pairs


def pair_line_idents(old_text: str, new_text: str) -> list[tuple[str, str]]:
    slots = pair_idents(slot_idents(old_text), slot_idents(new_text), one_to_one=True)
    if slots:
        return slots
    return pair_idents(
        extract_idents(old_text),
        extract_idents(new_text),
        one_to_one=False,
        stem=False,
    )


def pair_value(m: re.Match[str]) -> str:
    if m.group("someint") is not None:
        return m.group("someint")
    if m.group("str") is not None:
        return m.group("str")
    if m.group("ver") is not None:
        return m.group("ver")
    if m.group("float") is not None:
        return m.group("float")
    if m.group("int") is not None:
        return m.group("int")
    if m.group("bool") is not None:
        return m.group("bool")
    return ""


def extract_pairs(line: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    for m in PAIR_RE.finditer(line):
        key = m.group("key")
        val = pair_value(m)
        if key and val != "" and keep_ident(key):
            out.append((key, val))
    return out


def value_type(val: str) -> str:
    if not val:
        return "empty"
    if val in POLARITY:
        return "polarity"
    if VERSION_RE.fullmatch(val) or re.fullmatch(
        r"v?\d+\.\d+\.\d+(?:-[A-Za-z0-9.]+)?", val
    ):
        return "version"
    if re.fullmatch(r"\d+", val):
        return "integer"
    if re.fullmatch(r"\d+\.\d+", val):
        return "float"
    return "other"


def mask_calendar(text: str) -> str:
    return CALENDAR_RE.sub(lambda m: " " * len(m.group(0)), text)


def stem_in_text(stem: str, text: str) -> bool:
    if not stem:
        return False
    if not stem.isascii():
        return stem in text
    return (
        re.search(
            r"(?<![A-Za-z0-9_])" + re.escape(stem) + r"(?![A-Za-z0-9_])",
            text,
            re.I,
        )
        is not None
    )


def needle_value(needle: str, line: str, vtype: str) -> bool:
    if not needle:
        return False
    hay = line
    if vtype == "integer" or (vtype == "other" and re.fullmatch(r"\d+", needle)):
        hay = mask_calendar(line)
    if vtype == "polarity" or needle in POLARITY:
        return stem_in_text(needle, hay)
    if re.fullmatch(r"v?\d+(?:\.\d+)+", needle) or re.fullmatch(r"\d+", needle):
        # 0.3 is not 0.3.0 (dot then digit). "0.4." as a sentence is 0.4.
        pat = r"(?<![\d.])" + re.escape(needle) + r"(?!\.\d)(?!\d)"
        return re.search(pat, hay) is not None
    return needle in hay


def needle_ident(needle: str, line: str) -> bool:
    if not needle:
        return False
    pat = r"(?<![A-Za-z0-9_])" + re.escape(needle) + r"(?![A-Za-z0-9_])"
    if re.search(pat, line) is not None:
        return True
    if needle.lower() != needle:
        return re.search(pat, line, re.I) is not None
    return False


def quoted_only_hold(text: str, name: str) -> bool:
    if any(needle_ident(s, text) for s in surfaces(name) if s):
        # quoted-only means NOT present as a bare ident
        spans = [(m.start(), m.end()) for m in STRING_RE.finditer(text)]

        def in_span(pos: int) -> bool:
            return any(a <= pos < b for a, b in spans)

        for s in surfaces(name):
            pat = re.compile(r"(?<![A-Za-z0-9_])" + re.escape(s) + r"(?![A-Za-z0-9_])")
            for m in pat.finditer(text):
                if not in_span(m.start()):
                    return False
        return any(re.search(rf"""['"]{re.escape(s)}['"]""", text) for s in surfaces(name))
    return any(re.search(rf"""['"]{re.escape(s)}['"]""", text) for s in surfaces(name))


def similar(a: str, b: str) -> float:
    if a == b:
        return 1.0
    if not a or not b:
        return 0.0
    al, bl = a.lower(), b.lower()
    ratio = difflib.SequenceMatcher(None, al, bl).ratio()
    tok_a = {t for t in re.split(r"[_\-./\s]+", al) if t}
    tok_b = {t for t in re.split(r"[_\-./\s]+", bl) if t}
    tok_a.update(x.lower() for x in CAMEL_RE.findall(a))
    tok_b.update(x.lower() for x in CAMEL_RE.findall(b))
    jacc = len(tok_a & tok_b) / (len(tok_a | tok_b) or 1)
    return max(ratio, (ratio + jacc) / 2, jacc)


def is_distinctive_value(val: str) -> bool:
    if not val:
        return False
    if VERSION_RE.fullmatch(val):
        return True
    if re.fullmatch(r"\d+\.\d+", val):
        return True
    if val in POLARITY:
        return True
    if len(val) >= 4 and not val.isdigit():
        return True
    if val.isdigit() and val not in COMMON_NUMBERS:
        return True
    return False


