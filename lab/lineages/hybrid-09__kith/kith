        )
        check(
            "split natal keeps presentThreshold as adopted",
            any(a == "presentThreshold" for a in sn[0].adopted),
            str(sn[0].adopted[:8]),
        )

    cafe = """diff --git a/x.py b/x.py
--- a/x.py
+++ b/x.py
@@ -1 +1 @@
-café_timeout = 10
+café_timeout = 30
"""
    cn = extract_natals(parse_unified_diff(cafe))
    check(
        "do not mint _timeout from café_timeout",
        not any(any(x == "_timeout" for x in n.names) for n in cn),
        str([n.names for n in cn]),
    )
    check("timeout stem is not settimeout", not stem_in_text("timeout", "settimeout(10)"))

    # Fuse proof: claim+kin at one line become both
    fake_n = Natal(
        names=("t1", "T1"),
        adopted=("driftDelay",),
        old="15",
        new="15",
        kind="rename",
        vtype="integer",
        origin=Origin("core.py", 1, "t1 = 15"),
        pairs=("t1↔driftDelay",),
    )
    h_claim = Hit(fake_n, "docs/a.md", 3, "docs", "T1 is 15 seconds.", 70, ("old-value",), "claim")
    h_kin = Hit(fake_n, "docs/a.md", 3, "docs", "T1 is 15 seconds.", 80, ("same-line-name",), "kin")
    fused = fuse_hits([h_claim, h_kin], fuse=True)
    check("fuse claim+kin → via=both", len(fused) == 1 and fused[0].via == "both", str(fused))
    split = fuse_hits([h_claim, h_kin], fuse=False)
    check("no-fuse is the concatenation (2 rows)", len(split) == 2, str(len(split)))

    return 1 if failures else 0


