def obtain_diff(
    root: Path, args: argparse.Namespace
) -> tuple[str, str, str, str | None]:
    """Return (diff_text, from_label, to_label, search_rev)."""
    if args.diff is not None:
        if args.diff == "-":
            raw = sys.stdin.buffer.read()
            src = "stdin"
        else:
            p = Path(args.diff)
            try:
                raw = p.read_bytes()
            except OSError as e:
                die(f"cannot read {p}: {e}")
            src = str(p)
        if b"\0" in raw[:8192]:
            die(f"binary diff ({src})")
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError as e:
            die(f"binary diff ({src}): {e}")
        return text, "diff" if src == "stdin" else src, "worktree", None

    if not git_ok(root):
        die(f"not a git repository: {root} (pass --diff or run inside a repo)")

    specs = [s for s in (args.spec, args.spec2) if s]
    if specs and looks_like_location(specs[0]):
        die(
            "pass a commit or a diff, not FILE:LINE "
            "(kith starts from a change; leftovers are the natal record speaking)"
        )

    if args.staged:
        raw = git(["diff", "--cached", "--no-color", "--no-ext-diff"], root)
        return raw.decode("utf-8", "replace"), "HEAD", "index", None

    if args.wt or (not specs):
        if not specs:
            # default: HEAD → worktree
            raw = git(["diff", "HEAD", "--no-color", "--no-ext-diff"], root)
            return raw.decode("utf-8", "replace"), "HEAD", "worktree", None
        if specs[0] in {"wt", "WORKTREE", "working-tree"}:
            raw = git(["diff", "HEAD", "--no-color", "--no-ext-diff"], root)
            return raw.decode("utf-8", "replace"), "HEAD", "worktree", None

    if len(specs) == 1 and (".." in specs[0]):
        left, right = specs[0].split("..", 1)
        right = right.lstrip(".")
        left = left or "HEAD"
        right = right or "HEAD"
        raw = git(["diff", "--no-color", "--no-ext-diff", left, right], root)
        return raw.decode("utf-8", "replace"), left, right, right

    if len(specs) == 2:
        a, b = specs
        raw = git(["diff", "--no-color", "--no-ext-diff", a, b], root)
        return raw.decode("utf-8", "replace"), a, b, b

    spec = specs[0]
    if not is_commit_ish(root, spec):
        die(f"not a commit: {spec}")
    full = git_text(root, ["rev-parse", spec]).strip()
    proc = subprocess.run(
        ["git", "-C", str(root), "rev-parse", f"{full}^"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    parent = proc.stdout.decode().strip() if proc.returncode == 0 else None
    if parent:
        raw = git(["diff", "--no-color", "--no-ext-diff", parent, full], root)
        frm = parent[:12]
    else:
        raw = git(["show", "--format=", "--no-color", "--no-ext-diff", full], root)
        frm = "empty"
    # leftovers at HEAD: what the tree still owes after this change
    search = "HEAD"
    if args.at:
        search = args.at
    return raw.decode("utf-8", "replace"), frm, full[:12], search


