def classify_claim(path: str, line: str) -> str:
    p = path.replace("\\", "/").lower()
    stripped = line.lstrip()
    if any(part in p.split("/") for part in ("test", "tests", "spec", "specs")) or any(
        h in p for h in TEST_HINTS
    ):
        if "assert" in stripped or "expect(" in stripped or "XCT" in stripped:
            return "assert"
        return "test"
    suffix = Path(path).suffix.lower()
    if suffix in DOC_SUFFIXES or "/docs/" in p or "/adr/" in p or p.endswith("readme"):
        return "docs"
    if suffix in CONFIG_SUFFIXES:
        return "config"
    if stripped.startswith(("//", "#", "///", "//!", "--", "*", "/*", "<!--")):
        return "comment"
    if "assert" in stripped or "expect(" in stripped:
        return "assert"
    if STRING_RE.search(line) and not PAIR_RE.search(line):
        return "string"
    return "code"


def path_is_doc_or_test(path: str) -> bool:
    low = path.replace("\\", "/").lower()
    base = low.rsplit("/", 1)[-1]
    if low.endswith(tuple(DOC_SUFFIXES)) or "/docs/" in f"/{low}" or "/adr/" in f"/{low}":
        return True
    if "test" in base or "/test" in f"/{low}" or "/tests/" in f"/{low}":
        return True
    return False


def should_skip_path(rel: str) -> bool:
    parts = Path(rel).parts
    if any(p in SKIP_DIRS for p in parts):
        return True
    suffix = Path(rel).suffix.lower()
    if suffix in SKIP_SUFFIXES:
        return True
    name = Path(rel).name
    if name.startswith(".") and name not in {".gitignore", ".env.example"}:
        if suffix not in {".md", ".toml", ".yml", ".yaml", ".json", ".txt"}:
            return True
    return False


def list_tree_files(root: Path, rev: str | None) -> list[str]:
    files: list[str] = []
    if git_ok(root):
        if rev is None:
            out = git(["ls-files", "-z", "-c", "-o", "--exclude-standard"], root)
        else:
            out = git(["ls-tree", "-r", "--name-only", "-z", rev], root)
        files = [p for p in out.decode("utf-8", "replace").split("\0") if p]
    else:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            for name in filenames:
                full = Path(dirpath) / name
                files.append(str(full.relative_to(root)))

    if rev is None:
        nested: list[str] = []
        for dirpath, dirnames, _filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            here = Path(dirpath)
            if here == root:
                continue
            if (here / ".git").exists():
                rel_base = here.relative_to(root)
                for inner in list_tree_files(here, None):
                    nested.append(str(rel_base / inner))
                dirnames[:] = []
        files.extend(nested)

    seen: set[str] = set()
    out: list[str] = []
    for p in files:
        if p in seen or should_skip_path(p):
            continue
        seen.add(p)
        out.append(p)
    return out


def read_tree_file(root: Path, rel: str, rev: str | None) -> str | None:
    if rev is None:
        path = root / rel
        if not path.is_file():
            return None
        try:
            if path.stat().st_size > 1_500_000:
                return None
            data = path.read_bytes()
        except OSError:
            return None
    else:
        proc = subprocess.run(
            ["git", "-C", str(root), "show", f"{rev}:{rel}"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if proc.returncode != 0:
            return None
        data = proc.stdout
        if len(data) > 1_500_000:
            return None
    if b"\0" in data[:4096]:
        return None
    return data.decode("utf-8", "replace")


def name_hit(natal: Natal, text: str) -> tuple[bool, str]:
    """Return (hit, how) for inflected natal names."""
    for n in natal.names:
        if needle_ident(n, text):
            return True, "ident"
        if n.lower() != n and n.lower() in text.lower() and needle_ident(n, text):
            return True, "ident"
    # surfaces already expanded into natal.names; aliases next
    primary = natal.names[0] if natal.names else ""
    for alias in STEM_ALIASES.get(primary.lower(), ()):
        if stem_in_text(alias, text) or (not alias.isascii() and alias in text):
            return True, "alias"
    for n in natal.names:
        for st in ident_parts(n):
            if len(st) >= 4 and st not in STOP and stem_in_text(st, text):
                # do not treat adopted ident as old stem (presentThreshold holds threshold)
                if any(needle_ident(a, text) for a in natal.adopted):
                    if not needle_ident(n, text):
                        continue
                return True, "stem"
        for alias in STEM_ALIASES.get(n.lower(), ()) + STEM_ALIASES.get(
            ident_parts(n)[-1] if ident_parts(n) else "", ()
        ):
            if stem_in_text(alias, text) or (not alias.isascii() and alias in text):
                return True, "alias"
    return False, ""


def adopted_pays(natal: Natal, text: str) -> bool:
    return any(needle_ident(a, text) for a in natal.adopted if a)


def leftover_pairs_on(line: str) -> dict[str, str]:
    return dict(extract_pairs(line))


def is_homonym(natal: Natal, line: str) -> bool:
    pairs = leftover_pairs_on(line)
    for n in natal.names:
        if n in pairs:
            bound = pairs[n]
            if natal.old and bound != natal.old and bound != natal.new:
                return True
            if not natal.old and natal.new and bound != natal.new:
                return True
    return False


def score_hit(
    natal: Natal,
    path: str,
    line: str,
    claim: str,
    *,
    via: str,
    nearby: str = "",
    file_has_new: bool = False,
) -> tuple[int, list[str]]:
    why: list[str] = []
    score = 0
    if path == natal.origin.path:
        score += 12
        why.append("same-file")

    has_name, how = name_hit(natal, line)
    if has_name:
        score += 40 if how == "ident" else 18
        why.append("same-line-name" if how == "ident" else f"name-{how}")
    elif nearby:
        n_has, n_how = name_hit(natal, nearby)
        if n_has and natal.kind != "polarity":
            score += 14
            why.append("nearby-name")
            has_name = True
            how = n_how

    if natal.kind == "polarity" and how != "ident":
        # polarity leftovers require a same-line name, not a nearby stem
        if not (has_name and how == "ident"):
            return 0, []

    if via in {"claim", "both"} and natal.old:
        vt = natal.vtype if natal.vtype != "empty" else value_type(natal.old)
        if needle_value(natal.old, line, vt):
            score += 28
            why.append("old-value")
        if natal.new and natal.new != natal.old and needle_value(
            natal.new, line, value_type(natal.new)
        ):
            score -= 20
            why.append("also-new-value")

    if via in {"kin", "both"}:
        if adopted_pays(natal, line) and not has_name:
            score -= 15
            why.append("also-new-ident")

    generic = any(n.lower() in GENERIC_NAMES for n in natal.names[:4])
    if generic and claim in {"docs", "code", "comment", "string"}:
        backticked = any(f"`{n}`" in line for n in natal.names[:6])
        if not backticked and via == "kin" and natal.old:
            if not needle_value(natal.old, line, natal.vtype or value_type(natal.old)):
                if not path_is_doc_or_test(path):
                    score -= 28
                    why.append("generic-ident")

    score += {
        "comment": 18,
        "docs": 16,
        "assert": 22,
        "test": 12,
        "config": 20,
        "string": 10,
        "code": 4,
    }.get(claim, 0)
    why.append(f"claim:{claim}")

    if HISTORICAL_RE.search(line.lstrip()):
        score -= 25
        why.append("historical")
    # File-level "already has the new value" is true of migration docs
    # (ADR-0019 names both 0.4 and 0.45). Only punish code that moved on.
    if file_has_new and natal.new and claim in {"code", "config"}:
        score -= 32
        why.append("file-has-new")
    if via == "both":
        score += 16
        why.append("via-both")
    if (
        via == "claim"
        and natal.vtype in {"float", "version"}
        and (path_is_doc_or_test(path) or claim in {"docs", "test", "assert", "comment"})
    ):
        score += 22
        why.append("natal-literal")
    if any(n.lower() == "version" for n in natal.names) and claim == "config":
        score += 15
        why.append("version-config")
    return max(score, 0), why


def decide_via(natal: Natal, path: str, line: str, claim: str) -> str | None:
    """Joint classifier: claim / kin / both / None."""
    has_name, how = name_hit(natal, line)
    has_val = False
    if natal.old:
        vt = natal.vtype if natal.vtype != "empty" else value_type(natal.old)
        has_val = needle_value(natal.old, line, vt)
        # Style-domain floats (opacity 0.4, yaw: 0.4) are not this threshold.
        if (
            has_val
            and vt == "float"
            and STYLE_LINE.search(line)
            and not THRESHOLD_LINE.search(line)
            and how != "ident"
        ):
            has_val = False

    paid = adopted_pays(natal, line) and not has_name
    if paid:
        # The dest line already holds the adopted ident. Unchanged natal
        # values (t1=15 → driftDelay=15) are not leftover claims.
        return None

    if natal.kind == "polarity":
        if has_name and how == "ident" and has_val:
            return "both"
        if has_name and how == "ident":
            return "kin"
        return None

    if quoted_only_hold(line, natal.names[0] if natal.names else "") and ADAPTER_RE.search(
        line
    ):
        # CodingKeys adapter: not unpaid docs
        if not has_val:
            return None

    generic = any(n.lower() in GENERIC_NAMES for n in natal.names[:3])
    in_docs = path_is_doc_or_test(path) or claim in {"docs", "test", "assert", "comment"}

    if has_name and has_val:
        if generic and how == "stem" and not in_docs:
            # presentThreshold contains threshold; that's the new ident paying
            if adopted_pays(natal, line):
                return None
        return "both"

    if has_name:
        if generic and not in_docs and how != "ident":
            return None
        if generic and not in_docs and how == "ident" and natal.old:
            # SiteObserver.threshold = 0.7 — generic ident in code, wrong literal
            if is_homonym(natal, line):
                return None
            # ident present but bound to a different value, or unbound
            pairs = leftover_pairs_on(line)
            bound = None
            for n in natal.names:
                if n in pairs:
                    bound = pairs[n]
                    break
            if bound is not None and natal.old and bound != natal.old:
                return None
            if not has_val:
                return None
        if adopted_pays(natal, line) and how != "ident":
            return None
        return "kin"

    if has_val:
        # value-only: docs/tests/config, or same-line distinctive name nearby handled later
        if in_docs or claim in {"config", "string"}:
            return "claim"
        # code: only if the natal value is distinctive (version, float, uncommon int)
        if natal.vtype in {"version", "float"} or is_distinctive_value(natal.old):
            # still skip random floats in style/opacity lines without natal name
            if generic or natal.names and natal.names[0].lower() in GENERIC_NAMES:
                return None
            return "claim"
        return None
    return None


def scan(
    root: Path,
    rev: str | None,
    natals: Sequence[Natal],
    min_score: int,
    skip_lines: Mapping[str, set[int]],
) -> list[Hit]:
    if not natals:
        return []
    files = list_tree_files(root, rev)
    hits: list[Hit] = []
    seen: set[tuple[str, int, tuple[str, ...]]] = set()

    cheap: list[tuple[Natal, list[str]]] = []
    for n in natals:
        needles = [s for s in n.names if s]
        if n.old:
            needles.append(n.old)
        cheap.append((n, needles))

    for rel in files:
        text = read_tree_file(root, rel, rev)
        if text is None:
            continue
        skip = skip_lines.get(rel, set())
        lines = text.splitlines()
        file_new: dict[tuple[str, ...], bool] = {}
        low = text.lower()
        for natal, needles in cheap:
            if not any(
                (nd.lower() in low) if nd.isascii() else (nd in text) for nd in needles if nd
            ):
                continue
            for i, line in enumerate(lines, start=1):
                if i in skip or not line.strip():
                    continue
                via = decide_via(natal, rel, line, classify_claim(rel, line))
                if via is None:
                    continue
                if is_homonym(natal, line) and via != "kin":
                    # homonym kills a claim on a different binding; kin-only
                    # of a distinctive name may still stand
                    if via == "claim":
                        continue
                    if via == "both":
                        via = "kin"
                claim = classify_claim(rel, line)
                fk = natal.key()
                if fk not in file_new:
                    if natal.new:
                        file_new[fk] = needle_value(
                            natal.new, text, value_type(natal.new)
                        ) or any(needle_ident(a, text) for a in natal.adopted)
                    else:
                        file_new[fk] = False
                nearby = "\n".join(lines[max(0, i - 3) : i - 1] + lines[i : i + 2])
                score, why = score_hit(
                    natal,
                    rel,
                    line,
                    claim,
                    via=via,
                    nearby=nearby,
                    file_has_new=file_new[fk],
                )
                if score < min_score:
                    continue
                key = (rel, i, natal.key())
                if key in seen:
                    continue
                seen.add(key)
                excerpt = line.strip()
                if len(excerpt) > 220:
                    excerpt = excerpt[:217] + "..."
                hits.append(
                    Hit(
                        natal=natal,
                        path=rel,
                        line=i,
                        claim_kind=claim,
                        excerpt=excerpt,
                        score=score,
                        why=tuple(why),
                        via=via,
                    )
                )
    hits.sort(key=lambda h: (-h.score, h.path, h.line))
    return hits


def fuse_hits(hits: Sequence[Hit], *, fuse: bool) -> list[Leftover]:
    if not fuse:
        return [
            Leftover(
                path=h.path,
                line=h.line,
                claim_kind=h.claim_kind,
                excerpt=h.excerpt,
                score=h.score,
                via=h.via,
                why=list(h.why),
                natals=[h.natal],
            )
            for h in hits
        ]
    buckets: dict[tuple[str, int], Leftover] = {}
    order: list[tuple[str, int]] = []
    for h in hits:
        k = (h.path, h.line)
        if k not in buckets:
            buckets[k] = Leftover(
                path=h.path,
                line=h.line,
                claim_kind=h.claim_kind,
                excerpt=h.excerpt,
                score=h.score,
                via=h.via,
                why=list(h.why),
                natals=[h.natal],
            )
            order.append(k)
            continue
        b = buckets[k]
        if h.natal not in b.natals:
            b.natals.append(h.natal)
        vias = {b.via, h.via}
        if "both" in vias or ({"claim", "kin"} <= vias):
            b.via = "both"
            if "via-both" not in b.why:
                b.why.append("via-both")
                b.score += 8
        elif h.via == "both":
            b.via = "both"
        if h.score > b.score:
            b.score = h.score
            b.excerpt = h.excerpt
            b.claim_kind = h.claim_kind
        for w in h.why:
            if w not in b.why:
                b.why.append(w)
    out = [buckets[k] for k in order]
    out.sort(key=lambda L: (-L.score, L.path, L.line))
    return out


