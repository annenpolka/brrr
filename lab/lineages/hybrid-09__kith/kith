def color_enabled(args: argparse.Namespace, stream: TextIO) -> bool:
    if args.no_color:
        return False
    if os.environ.get("NO_COLOR"):
        return False
    return stream.isatty()


def paint(text: str, code: str, on: bool) -> str:
    if not on:
        return text
    return f"\033[{code}m{text}\033[0m"


def print_human(
    leftovers: Sequence[Leftover],
    natals: Sequence[Natal],
    *,
    frm: str,
    to: str,
    root: Path,
    explain: bool,
    color: bool,
) -> None:
    n = len(leftovers)
    both = sum(1 for L in leftovers if L.via == "both")
    claim = sum(1 for L in leftovers if L.via == "claim")
    kin = sum(1 for L in leftovers if L.via == "kin")
    header = (
        f"{NAME}: {n} leftover{'s' if n != 1 else ''}  {frm} → {to}  "
        f"both={both} claim={claim} kin={kin}"
    )
    print(paint(header, "1", color))
    if not leftovers:
        if natals:
            print(f"  {len(natals)} natal record(s); none still speaking (min-score gated).")
        else:
            print("  no natal records in this change.")
        return

    grouped: dict[tuple[str, ...], list[Leftover]] = {}
    order: list[tuple[str, ...]] = []
    ungrouped: list[Leftover] = []
    for L in leftovers:
        if len(L.natals) == 1:
            k = L.natals[0].key()
            if k not in grouped:
                grouped[k] = []
                order.append(k)
            grouped[k].append(L)
        else:
            ungrouped.append(L)

    def dump(L: Leftover) -> None:
        loc = f"{L.path}:{L.line}"
        via = f"{L.via:<5}"
        claim = f"{L.claim_kind:<7}"
        score = f"{L.score:>3}"
        via_code = "33" if L.via == "both" else ("31" if L.via == "claim" else "35")
        print(
            f"  {paint(via, via_code, color)} "
            f"{paint(score, '36', color)} {paint(claim, '35', color)} "
            f"{paint(loc, '32', color):<42} {L.excerpt}"
        )
        if explain:
            print(paint(f"         why: {', '.join(L.why)}", "2", color))

    for k in order:
        group = grouped[k]
        natal = group[0].natals[0]
        kind = natal.kind.upper()
        print()
        print(
            paint("NATAL", "33;1", color),
            paint(natal.label(), "1", color),
            paint(f"  {natal.origin.path}:{natal.origin.line}", "2", color),
            paint(kind, "2", color),
        )
        for L in group:
            dump(L)

    if ungrouped:
        print()
        print(paint("NATAL  (fused across records)", "33;1", color))
        for L in ungrouped:
            labels = "; ".join(n.label() for n in L.natals[:3])
            print(paint(f"       {labels}", "2", color))
            dump(L)


def print_tsv(leftovers: Sequence[Leftover]) -> None:
    print("score\tvia\tclaim\tpath\tline\tnames\told\tnew\texcerpt")
    for L in leftovers:
        n = L.natals[0]
        names = ",".join(n.names[:4])
        excerpt = L.excerpt.replace("\t", " ").replace("\n", " ")
        print(
            f"{L.score}\t{L.via}\t{L.claim_kind}\t{L.path}\t{L.line}\t"
            f"{names}\t{n.old}\t{n.new}\t{excerpt}"
        )


def print_json(
    leftovers: Sequence[Leftover],
    natals: Sequence[Natal],
    *,
    frm: str,
    to: str,
    root: Path,
) -> None:
    def natal_d(n: Natal) -> dict[str, object]:
        return {
            "names": list(n.names),
            "adopted": list(n.adopted),
            "old": n.old,
            "new": n.new,
            "kind": n.kind,
            "vtype": n.vtype,
            "pairs": list(n.pairs),
            "origin": {
                "path": n.origin.path,
                "line": n.origin.line,
                "excerpt": n.origin.excerpt,
            },
        }

    payload = {
        "from": frm,
        "to": to,
        "root": str(root),
        "version": VERSION,
        "natals": [natal_d(n) for n in natals],
        "leftovers": [
            {
                "path": L.path,
                "line": L.line,
                "claim": L.claim_kind,
                "excerpt": L.excerpt,
                "score": L.score,
                "via": L.via,
                "why": L.why,
                "natals": [natal_d(n) for n in L.natals],
            }
            for L in leftovers
        ],
    }
    print(json.dumps(payload, indent=2, ensure_ascii=False))


