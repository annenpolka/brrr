def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=NAME,
        description=(
            "Print leftovers of a change's natal record: typed leftover claims "
            "and unpaid inflected kin, fused at path:line."
        ),
    )
    p.add_argument("spec", nargs="?", help="commit, range, or old rev")
    p.add_argument("spec2", nargs="?", help="new rev (search this tree)")
    p.add_argument("-C", "--root", default=".", help="repository root")
    p.add_argument("--diff", metavar="FILE", help="unified diff FILE or '-'")
    p.add_argument("--staged", action="store_true")
    p.add_argument("--wt", action="store_true", help="HEAD → worktree")
    p.add_argument("--at", metavar="REV", help="search this tree (default HEAD for a commit)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--facts-only", action="store_true", help="print natal records and stop")
    p.add_argument("--explain", action="store_true")
    p.add_argument("--min-score", type=int, default=55)
    p.add_argument("--no-fuse", action="store_true", help="concatenation: one row per (line, natal, via)")
    p.add_argument("--no-color", action="store_true")
    p.add_argument("--check", action="store_true", help="exit 1 if any leftover")
    p.add_argument("--version", action="store_true")
    return p


def main(argv: Sequence[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in {"self-test", "--self-test", "selftest", "--selftest"}:
        return cmd_self_test()
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.version:
        print(f"{NAME} {VERSION}")
        return 0

    root = Path(args.root).resolve()
    if not root.exists():
        die(f"root not found: {root}")

    diff_text, frm, to, search_rev = obtain_diff(root, args)
    files = parse_unified_diff(diff_text)
    natals = extract_natals(files)

    if args.facts_only:
        if args.json:
            print_json([], natals, frm=frm, to=to, root=root)
        else:
            print(f"{NAME}: {len(natals)} natal record(s)  {frm} → {to}")
            for n in natals:
                print(f"  {n.kind:<8} {n.label()}  ({n.origin.path}:{n.origin.line})")
        return 0

    if search_rev in {None, "worktree", "index"}:
        rev: str | None = None
    else:
        rev = search_rev

    hits = scan(
        root,
        rev,
        natals,
        min_score=args.min_score,
        skip_lines=changed_new_lines(files),
    )
    leftovers = fuse_hits(hits, fuse=not args.no_fuse)

    if args.json:
        print_json(leftovers, natals, frm=frm, to=to, root=root)
    elif args.tsv:
        print_tsv(leftovers)
    else:
        print_human(
            leftovers,
            natals,
            frm=frm,
            to=to,
            root=root,
            explain=args.explain,
            color=color_enabled(args, sys.stdout),
        )
    if leftovers:
        return 1
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
