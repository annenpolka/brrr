def parse_unified_diff(text: str) -> list[FileDiff]:
    files: list[FileDiff] = []
    current: FileDiff | None = None
    hunk: Hunk | None = None
    old_ln = 0
    new_ln = 0
    pending_old: str | None = None

    def flush_hunk() -> None:
        nonlocal hunk
        if current is not None and hunk is not None:
            if hunk.deleted or hunk.added:
                current.hunks.append(hunk)
        hunk = None

    for raw in text.splitlines():
        if raw.startswith("diff --git "):
            flush_hunk()
            current = None
            hunk = None
            pending_old = None
            parts = raw.split()
            old_p = parts[2][2:] if len(parts) > 2 and parts[2].startswith("a/") else ""
            new_p = parts[3][2:] if len(parts) > 3 and parts[3].startswith("b/") else old_p
            current = FileDiff(path=new_p or old_p, status="modify", old_path=old_p or None)
            files.append(current)
            continue
        if raw.startswith("rename from ") and current is not None:
            current.old_path = raw[len("rename from ") :]
            current.status = "rename"
            continue
        if raw.startswith("rename to ") and current is not None:
            current.path = raw[len("rename to ") :]
            current.status = "rename"
            continue
        if raw.startswith("deleted file") and current is not None:
            current.status = "delete"
            continue
        if raw.startswith("new file") and current is not None:
            current.status = "add"
            continue
        if raw.startswith("--- "):
            rest = raw[4:]
            if rest.startswith("a/"):
                pending_old = rest[2:]
            elif rest == "/dev/null":
                pending_old = None
            continue
        if raw.startswith("+++ "):
            rest = raw[4:]
            if current is None:
                path = rest[2:] if rest.startswith("b/") else rest
                current = FileDiff(path=path, status="modify", old_path=pending_old)
                files.append(current)
            elif rest.startswith("b/"):
                current.path = rest[2:]
            elif rest == "/dev/null":
                current.status = "delete"
            continue
        if raw.startswith("@@"):
            flush_hunk()
            m = HUNK_RE.match(raw)
            if not m:
                continue
            old_ln = int(m.group(1))
            new_ln = int(m.group(3))
            hunk = Hunk(old_start=old_ln, new_start=new_ln)
            continue
        if hunk is None or current is None:
            continue
        if raw.startswith("\\"):
            continue
        if raw.startswith("-"):
            hunk.deleted.append((old_ln, raw[1:]))
            old_ln += 1
        elif raw.startswith("+"):
            hunk.added.append((new_ln, raw[1:]))
            new_ln += 1
        elif raw.startswith(" ") or raw == "":
            old_ln += 1
            new_ln += 1
    flush_hunk()
    return [f for f in files if f.path and f.path != "/dev/null"]


def align_lines(
    deleted: Sequence[tuple[int, str]], added: Sequence[tuple[int, str]]
) -> list[tuple[tuple[int, str] | None, tuple[int, str] | None]]:
    used_add = [False] * len(added)
    pairs: list[tuple[tuple[int, str] | None, tuple[int, str] | None]] = []
    add_by_body: dict[str, list[int]] = {}
    for i, (_, body) in enumerate(added):
        add_by_body.setdefault(body, []).append(i)

    matched_del = [False] * len(deleted)
    for di, (_dln, dbody) in enumerate(deleted):
        bucket = add_by_body.get(dbody)
        if bucket:
            ai = bucket.pop(0)
            used_add[ai] = True
            matched_del[di] = True
            pairs.append((deleted[di], added[ai]))
            if not bucket:
                add_by_body.pop(dbody, None)

    for di, (_dln, dbody) in enumerate(deleted):
        if matched_del[di]:
            continue
        best_i = -1
        best = 0.38
        dstrip = dbody.strip()
        dkeys = {k for k, _ in extract_pairs(dbody)}
        dslots = slot_idents(dbody) or extract_idents(dbody)
        for ai, (_aln, abody) in enumerate(added):
            if used_add[ai]:
                continue
            score = similar(dstrip, abody.strip())
            akeys = {k for k, _ in extract_pairs(abody)}
            if dkeys & akeys:
                score += 0.25
            aslots = slot_idents(abody) or extract_idents(abody)
            if any(
                same_inflection(a, b) or stem_related(a, b)
                for a in dslots
                for b in aslots
            ):
                score += 0.22
            if score > best:
                best = score
                best_i = ai
        if best_i >= 0:
            used_add[best_i] = True
            matched_del[di] = True
            pairs.append((deleted[di], added[best_i]))
        else:
            pairs.append((deleted[di], None))

    for ai, a in enumerate(added):
        if not used_add[ai]:
            pairs.append((None, a))
    return pairs


def natal_name_set(name: str) -> tuple[str, ...]:
    surf = surfaces(name)
    surf.add(name)
    return tuple(sorted(surf, key=lambda s: (-len(s), s)))


def extract_natals(files: Sequence[FileDiff]) -> list[Natal]:
    out: list[Natal] = []
    seen: set[tuple[str, ...]] = set()

    def emit(
        names: Sequence[str],
        adopted: Sequence[str],
        old: str,
        new: str,
        kind: str,
        origin: Origin,
        pairs: Sequence[str],
    ) -> None:
        names_t = tuple(dict.fromkeys(n for n in names if n))
        adopted_t = tuple(dict.fromkeys(a for a in adopted if a))
        if not names_t and not old:
            return
        if old == new and not adopted_t:
            return
        vt = value_type(old) if old else "empty"
        if kind == "value" and vt == "polarity" and new in POLARITY:
            kind = "polarity"
            vt = "polarity"
        natal = Natal(
            names=names_t,
            adopted=adopted_t,
            old=old,
            new=new,
            kind=kind,
            vtype=vt,
            origin=origin,
            pairs=tuple(pairs),
        )
        k = natal.key()
        if k in seen:
            return
        seen.add(k)
        out.append(natal)

    for fd in files:
        if fd.status == "add":
            continue
        for h in fd.hunks:
            for d, a in align_lines(h.deleted, h.added):
                if d is None:
                    continue
                dln, dbody = d
                origin = Origin(fd.old_path or fd.path, dln, dbody.strip()[:200])
                if a is None:
                    # Unpaired deletions are not natal records. A lint commit
                    # that also renamed t1→driftDelay would otherwise mint
                    # PUBLIC/IMPORT/ADR leftovers from every dropped line.
                    continue

                _aln, abody = a
                dpairs = extract_pairs(dbody)
                apair_list = extract_pairs(abody)
                apairs = dict(apair_list)
                id_pairs = pair_line_idents(dbody, abody)
                pair_labels = [f"{o}↔{n}" for o, n in id_pairs]
                pair_map = {o.lower(): n for o, n in id_pairs}

                consumed_keys: set[str] = set()

                for key, old in dpairs:
                    new_val = apairs.get(key)
                    adopted_name = pair_map.get(key.lower())
                    if adopted_name is None and key not in apairs and len(id_pairs) == 1:
                        adopted_name = id_pairs[0][1]
                    if new_val is None and adopted_name:
                        new_val = apairs.get(adopted_name, old)
                    if new_val is None:
                        continue
                    names = natal_name_set(key)
                    adopted = natal_name_set(adopted_name) if adopted_name else ()
                    if adopted_name and adopted_name.lower() != key.lower():
                        kind = "record" if old != new_val else "rename"
                    else:
                        if old == new_val:
                            continue
                        kind = "value"
                    # Common integers need a real name (timeout=10 stays).
                    if (
                        kind == "value"
                        and old in COMMON_NUMBERS
                        and key.lower() not in VALUE_NAMES
                        and not looks_like_symbol(key)
                    ):
                        continue
                    if kind == "value" and not (
                        is_distinctive_value(old)
                        or is_distinctive_value(new_val)
                        or key.lower() in VALUE_NAMES
                    ):
                        if not (old.isdigit() or re.fullmatch(r"\d+\.\d+", old)):
                            continue
                    emit(names, adopted, old, new_val, kind, origin, pair_labels)
                    consumed_keys.add(key.lower())
                    if adopted_name:
                        consumed_keys.add(adopted_name.lower())

                # renamed binding whose keys already paired: MAX_RETRIES=3 → MAX_ATTEMPTS=8
                if len(dpairs) == 1 and len(apair_list) == 1:
                    (dk, dv), (ak, av) = dpairs[0], apair_list[0]
                    if dk.lower() != ak.lower() and dk.lower() not in consumed_keys:
                        if similar(dk, ak) >= 0.45 or distinctive_ident(dk):
                            kind = "record" if dv != av else "rename"
                            emit(
                                natal_name_set(dk),
                                natal_name_set(ak),
                                dv,
                                av,
                                kind,
                                origin,
                                [f"{dk}↔{ak}"],
                            )
                            consumed_keys.add(dk.lower())
                            consumed_keys.add(ak.lower())

                for old_n, new_n in id_pairs:
                    if old_n.lower() in consumed_keys:
                        continue
                    # Pure rename, value may be unchanged and still natal.
                    dval = dict(dpairs).get(old_n, "")
                    aval = apairs.get(new_n, dval)
                    if not dval:
                        # steal a lone number from the line
                        dnums = NUMBER_RE.findall(dbody)
                        anums = NUMBER_RE.findall(abody)
                        if len(dnums) == 1:
                            dval = dnums[0]
                            aval = anums[0] if len(anums) == 1 else dval
                    kind = "record" if dval and aval and dval != aval else "rename"
                    emit(
                        natal_name_set(old_n),
                        natal_name_set(new_n),
                        dval,
                        aval if aval else dval,
                        kind,
                        origin,
                        [f"{old_n}↔{new_n}"],
                    )
                    consumed_keys.add(old_n.lower())

                if not dpairs and not apair_list and not id_pairs:
                    dnums = NUMBER_RE.findall(dbody)
                    anums = NUMBER_RE.findall(abody)
                    if len(dnums) == 1 and len(anums) == 1 and dnums[0] != anums[0]:
                        shared = [
                            s
                            for s in extract_idents(dbody)
                            if s.lower() not in STOP and len(s) >= 4
                        ]
                        name = shared[0] if shared else "value"
                        emit(
                            natal_name_set(name),
                            (),
                            dnums[0],
                            anums[0],
                            "value",
                            origin,
                            (),
                        )
    return merge_natals(out)


def merge_natals(natals: list[Natal]) -> list[Natal]:
    """A 1-to-N split is one natal record, not two competing renames.

    sitbone e9b0f75: `self.threshold = threshold` greedy-pairs with
    `self.absentThreshold = absentThreshold` while the init line correctly
    records threshold↔presentThreshold 0.4→0.45. Concatenation would keep
    both. The joint object is one record whose adopted set is the split.
    """
    if len(natals) <= 1:
        return natals
    groups: dict[tuple[str, ...], list[Natal]] = {}
    order: list[tuple[str, ...]] = []
    for n in natals:
        raw = n.pairs[0].split("↔")[0] if n.pairs else (n.names[0] if n.names else n.old)
        key = ident_parts(raw) or (raw.lower(),)
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append(n)
    out: list[Natal] = []
    for key in order:
        group = groups[key]
        if len(group) == 1:
            out.append(group[0])
            continue
        valued = [n for n in group if n.old and n.new and n.old != n.new]
        primary = valued[0] if valued else group[0]
        adopted = list(primary.adopted)
        pairs = list(primary.pairs)
        names = list(primary.names)
        for n in group:
            if n is primary:
                continue
            for a in n.adopted:
                if a not in adopted:
                    adopted.append(a)
            for p in n.pairs:
                if p not in pairs:
                    pairs.append(p)
            for nm in n.names:
                if nm not in names:
                    names.append(nm)
        kind = primary.kind
        if primary.old and primary.new and primary.old != primary.new and pairs:
            kind = "record"
        out.append(
            Natal(
                names=tuple(names),
                adopted=tuple(adopted),
                old=primary.old,
                new=primary.new,
                kind=kind,
                vtype=primary.vtype,
                origin=primary.origin,
                pairs=tuple(pairs),
            )
        )
    return out


def changed_new_lines(files: Sequence[FileDiff]) -> dict[str, set[int]]:
    out: dict[str, set[int]] = {}
    for fd in files:
        acc = out.setdefault(fd.path, set())
        for h in fd.hunks:
            for ln, _ in h.added:
                acc.add(ln)
    return out


