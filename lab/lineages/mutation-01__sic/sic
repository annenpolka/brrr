# Double-quoted strings are the JSON / Swift / TS wire dialect.
DQ_RE = re.compile(r'"(?:\\.|[^"\\])*"')
# Single quotes only in languages that actually use them for strings.
SQ_RE = re.compile(r"'(?:\\.|[^'\\])*'")
STRING_RE = re.compile(
    r"""(?P<dq>"(?:\\.|[^"\\])*")|(?P<sq>'(?:\\.|[^'\\])*')"""
)

# dict["key"] / obj['key'] — Swift/JS subscript is a wire-key witness.
SUBSCRIPT_RE = re.compile(
    r"""\[\s*(?P<q>["'])(?P<key>(?:\\.|[^"'\\]){1,80})(?P=q)\s*\]"""
)
# tool_input.get("file_path")
GET_RE = re.compile(
    r"""\.get\(\s*(?P<q>["'])(?P<key>(?:\\.|[^"'\\]){1,80})(?P=q)"""
)
# CodingKeys / serde rename: case hasMore = "has_more"
ASSIGN_STR_RE = re.compile(
    r"""=\s*(?P<q>["'])(?P<key>(?:\\.|[^"'\\]){1,80})(?P=q)"""
)

SINGLE_QUOTE_EXTS = {".py", ".rb", ".yaml", ".yml", ".toml", ".sh", ".bash", ".zsh"}

# Object-key position: "key":
JSON_KEY_RE = re.compile(r'"(?P<key>(?:\\.|[^"\\]){1,80})"\s*:')

# YAML mapping keys. Do not swallow `http://`.
YAML_KEY_RE = re.compile(
    r"^[ \t]{0,32}(?:"
    r"(?P<bare>[A-Za-z_][A-Za-z0-9_-]{0,80})|"
    r'["\'](?P<quoted>[^"\']{1,80})["\']'
    r")[ \t]*:(?!/)",
    re.MULTILINE,
)

TOML_KEY_RE = re.compile(
    r"^[ \t]{0,16}(?:"
    r"(?P<bare>[A-Za-z_][A-Za-z0-9_-]{0,80})|"
    r'["\'](?P<quoted>[^"\']{1,80})["\']'
    r")[ \t]*=",
    re.MULTILINE,
)

TOML_TABLE_RE = re.compile(
    r"^[ \t]{0,8}\[{1,2}[ \t]*(?P<body>[^\]\n]{1,120})[ \t]*\]{1,2}",
    re.MULTILINE,
)

HEADER_LINE_RE = re.compile(
    r"^[ \t]*(?P<h>[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)+)[ \t]*:",
    re.MULTILINE,
)

BACKTICK_RE = re.compile(r"`([A-Za-z_$][A-Za-z0-9_.$-]{1,80})`")

CAMEL_RE = re.compile(r"^[a-z][a-z0-9]*[A-Z][A-Za-z0-9]+$")
PASCAL_RE = re.compile(r"^[A-Z][a-z0-9]+[A-Z][A-Za-z0-9]+$")
SNAKE_RE = re.compile(r"^[a-z][a-z0-9]*_[a-z0-9_]+$")
CONST_RE = re.compile(r"^[A-Z][A-Z0-9]*_[A-Z0-9_]+$")
KEBAB_RE = re.compile(r"^[a-z][a-z0-9]*-[a-z0-9-]+$")
DOTTED_RE = re.compile(r"^[A-Za-z][A-Za-z0-9]*[.][A-Za-z0-9._-]+$")
URN_RE = re.compile(r"^urn:[A-Za-z0-9][A-Za-z0-9:._/-]{2,80}$")
DOLLAR_RE = re.compile(r"^\$[A-Za-z][A-Za-z0-9_-]{1,40}$")

SPLIT_CAMEL_1 = re.compile(r"([a-z0-9])([A-Z])")
SPLIT_CAMEL_2 = re.compile(r"([A-Z]+)([A-Z][a-z])")
SEP_RE = re.compile(r"[_\-./:]+")

