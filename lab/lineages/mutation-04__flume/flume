IDENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
PY_TB_RE = re.compile(
    r"""File\s+(?P<q>["'])(?P<path>.*?)(?P=q),\s+line\s+(?P<line>\d+)""",
    re.IGNORECASE,
)
ARROW_RE = re.compile(
    r"""-->\s+(?P<path>\S+?):(?P<line>\d+)(?::(?P<col>\d+))?"""
)
COLON_NUM_RE = re.compile(r":(\d+)(?::(\d+))?(?!\d)")
# rustc/clang snippet gutters: "529 |     code" / "  12 | int x"
GUTTER_RE = re.compile(r"^([ \t]*)(\d+)([ \t]*\|)(.*)$")
GUTTER_TTL = 16
GUTTER_SPAN = 24
STOPWORDS = {
    "a", "an", "and", "as", "at", "be", "by", "class", "const", "crate",
    "def", "else", "enum", "false", "fn", "for", "from", "func", "function",
    "i", "if", "impl", "import", "in", "int", "let", "mod", "mut", "n",
    "none", "not", "of", "or", "pub", "return", "self", "static", "str",
    "struct", "t", "the", "this", "to", "true", "type", "use", "var",
    "void", "where", "with", "guard", "async", "await", "throws", "some",
    "nil", "func",
}
TRIVIAL_NORMS = {
    "", "{", "}", "};", "[", "]", "(", ")", "else", "else:", "pass",
    "break", "continue", "end", "end;", "//", "#", "*/", "/*", "try",
    "catch", "do", "then",
}
# Bare names that look like locators in logs but almost never are files.
BASENAME_DENY = {
    "error", "warning", "note", "info", "debug", "fatal", "help", "line",
    "file", "http", "https", "http", "tcp", "udp", "ws", "wss", "ftp",
    "version", "port", "host", "time", "date", "pid", "exit", "code",
    "status", "thread", "frame", "stack", "trace", "column", "row",
    "test", "ok", "fail", "failed", "passed", "skip", "skipping",
    "expected", "actual", "cause", "reason", "module", "package",
}
