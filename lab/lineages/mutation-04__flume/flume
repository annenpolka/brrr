#!/usr/bin/env python3
"""flume — rewrite stale file:line locators in a log stream.

A pure Unix filter. Never talks to git. Never takes a locator as an
argument. stdin (or log files) in, the same stream out with addresses
rewritten from --from-dir onto --to-dir by content fingerprint.
"""
from __future__ import annotations

import argparse
import difflib
import os
import re
import sys
from collections import defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterator, Optional, TextIO

VERSION = "0.2.0"

SKIP_DIRS = {
    ".git",
    ".hg",
    ".svn",
    ".venv",
    "venv",
    "node_modules",
    "target",
    "dist",
    "build",
    "__pycache__",
    ".build",
    "vendor",
    "coverage",
    ".cargo",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    "DerivedData",
    ".swiftpm",
}
SKIP_SUFFIXES = {
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
    ".zip",
    ".gz",
    ".tar",
    ".bz2",
    ".xz",
    ".7z",
    ".pdf",
    ".mp4",
    ".mp3",
