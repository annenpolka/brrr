def _self_check(cond: bool, msg: str) -> None:
    if not cond:
        raise AssertionError(msg)


def _kw(**extra):
    base = dict(
        allow_common=False,
        extra_ignore=(),
        no_ignore=False,
        strict=False,
        kinds=KINDS_DEFAULT,
        hidden_only=False,
        horizon="base",
        horizon_name="HEAD~1",
        head="HEAD",
        work_label="worktree",
        work_mode="worktree",
    )
    base.update(extra)
    return base


def self_test() -> None:
    files = parse_unified_diff(DIFF_DEF_HIST)
    _self_check(len(files) == 1, "parse one file")
    _self_check(files[0].path == "src/parse.rs", files[0].path)

    weird = parse_unified_diff(DIFF_WEIRD_H)
    _self_check(len(weird) == 1, "weird file parsed")
    _self_check("weird file-" in weird[0].path, weird[0].path)
    _self_check("文" in weird[0].path, f"unicode in path: {weird[0].path!r}")

    syn = synthesize_new_file_diff(
        "src/weird file-文.rs", "pub fn weird_ident_zzz() {}\n"
    )
    parsed = parse_unified_diff(syn)
    _self_check(len(parsed) == 1, "synthesize parse")
    _self_check("weird file-" in parsed[0].path, parsed[0].path)
    _self_check(any(ln[0] == "+" for ln in parsed[0].lines), "plus lines")

    r = analyze_diffs(DIFF_DEF_HIST, DIFF_USE_WORK, **_kw())
    _self_check(len(r.zures) == 1, f"stale-use count {r.zures}")
    _self_check(r.zures[0].ident == "parse_config", r.zures[0].ident)
    _self_check(r.zures[0].kind == "stale-use", r.zures[0].kind)
    _self_check(r.zures[0].hidden is True, "hidden when hist file not dirty")

    r = analyze_diffs(DIFF_BREAK_HIST_USE, DIFF_BREAK_WORK_DEF, **_kw())
    _self_check(len(r.zures) == 1, f"break-use count {r.zures}")
    _self_check(r.zures[0].kind == "break-use", r.zures[0].kind)
    _self_check(r.zures[0].ident == "parse_config", r.zures[0].ident)
    _self_check(r.zures[0].lead == "work", r.zures[0].lead)

    r = analyze_diffs(DIFF_DELETE_HIST, DIFF_NEW_USE_WORK, **_kw())
    _self_check(
        any(x.kind == "stale-use" and x.ident == "parse_config" for x in r.zures),
        f"delete then new use: {r.zures}",
    )

    r = analyze_diffs(DIFF_BREAK_HIST_USE, DIFF_DELETE_WORK, **_kw())
    _self_check(
        any(x.kind == "break-use" and x.ident == "parse_config" for x in r.zures),
        f"delete in work vs hist use: {r.zures}",
    )

    r = analyze_diffs(DIFF_UNRELATED_H, DIFF_UNRELATED_W, **_kw())
    _self_check(r.zures == [], f"unrelated produced {r.zures}")

    r = analyze_diffs(DIFF_PARAM_HIST, DIFF_USE_WORK, **_kw())
    _self_check(
        any(x.ident == "parse_config" for x in r.zures),
        f"hunk-header def missed: {r.zures}",
    )

    r = analyze_diffs(DIFF_WEIRD_H, DIFF_WEIRD_W, **_kw())
    _self_check(
        any(x.ident == "weird_ident_zzz" for x in r.zures),
        f"weird name: {r.zures}",
    )

    r = analyze_diffs(DIFF_DUP_H, DIFF_DUP_W, **_kw())
    _self_check(
        any(x.kind == "dup-def" and x.ident == "shared_helper_zzz" for x in r.zures),
        f"dup-def: {r.zures}",
    )

    r = analyze_diffs(DIFF_LOCK_H, DIFF_LOCK_W, **_kw())
    _self_check(r.zures == [], f"lockfile should be ignored: {r.zures}")

    r = analyze_diffs(DIFF_CLASS_H, DIFF_CLASS_W, **_kw())
    idents = {x.ident for x in r.zures}
    _self_check("saveCumulative" in idents, f"swift method missed: {r.zures}")
    _self_check(
        "JSONSessionStore" not in idents,
        f"enclosing class false positive: {idents}",
    )

    r = analyze_diffs(DIFF_MOVE_HIST, DIFF_MOVE_WORK, **_kw())
    idents = {x.ident: x.kind for x in r.zures}
    _self_check(
        idents.get("scan_scars") == "break-use",
        f"file-move + later signature should be break-use, got {idents}",
    )
    _self_check("ScarHit" not in idents, f"return-type mention leaked: {idents}")
    _self_check("paths" not in idents, f"param name leaked: {idents}")

    r = analyze_diffs(DIFF_ONELINE_HIST, DIFF_ONELINE_WORK, **_kw())
    _self_check(
        any(x.kind == "stale-use" and x.ident == "doomed_symbol" for x in r.zures),
        f"one-liner call on def line missed: {r.zures}",
    )

    r = analyze_diffs(
        DIFF_DEF_HIST, DIFF_USE_WORK, **_kw(hidden_only=True)
    )
    _self_check(r.zures and r.zures[0].hidden, "hidden-only keeps hidden")

    # same-file: work also edits the hist file → not hidden
    combined_work = DIFF_DEF_HIST + DIFF_USE_WORK
    r = analyze_diffs(DIFF_DEF_HIST, combined_work, **_kw())
    _self_check(r.zures, "same-file still a zure")
    _self_check(r.zures[0].hidden is False, "in-diff when work touches hist file")

    sys.stdout.write("zure --self-test: ok\n")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="zure",
        description=(
            "Detect identifier-level conflicts between recent committed history "
            "and the uncommitted working tree (staged, unstaged, untracked). "
            "No second branch: this is a pre-commit semantic merge with yourself."
        ),
        epilog="Exit 0 if clean, 1 if zures exist, 2 on usage/git error.",
    )
    p.add_argument("-C", "--repo", default=None, help="git -C directory")
    p.add_argument(
        "--since",
        metavar="REV",
        help="left edge of committed history (default: upstream/main/HEAD~10)",
    )
    p.add_argument(
        "--horizon",
        type=int,
        metavar="N",
        help=f"compare against HEAD~N (default auto, fallback {DEFAULT_HORIZON})",
    )
    p.add_argument(
        "--staged",
        action="store_true",
        help="index only (what `git commit` would record); skip unstaged/untracked",
    )
    p.add_argument(
        "--no-untracked",
        action="store_true",
        help="do not treat untracked files as part of the working-tree changeset",
    )
    p.add_argument(
        "--replay",
        nargs="?",
        const="20",
        metavar="N",
        help="treat each of the last N non-merge commits as a former worktree",
    )
    p.add_argument(
        "--diffs",
        nargs=2,
        metavar=("HIST.diff", "WORK.diff"),
        help="compare two unified diffs (hist, work) with no git required",
    )
    p.add_argument("-o", "--format", choices=("text", "json", "tsv"), default="text")
    p.add_argument("-q", "--quiet", action="store_true", help="no stdout; exit status only")
    p.add_argument("--all", action="store_true", help="include use-use zures")
    p.add_argument("--common", action="store_true", help="do not filter generic identifiers")
    p.add_argument(
        "--strict",
        action="store_true",
        help="only count definition lines in +/- hunks, not hunk headers",
    )
    p.add_argument(
        "--also-visible",
        action="store_true",
        help="include zures whose history files are also dirty in the worktree",
    )
    p.add_argument(
        "--hidden",
        action="store_true",
        help="only zures whose history files are absent from git diff (default: all)",
    )
    p.add_argument(
        "--blame",
        action="store_true",
        help="annotate history-side hits with git blame (commit + subject)",
    )
    p.add_argument("--ignore", action="append", default=[], metavar="GLOB")
    p.add_argument("--no-ignore", action="store_true")
    p.add_argument("--no-snippets", action="store_true")
    p.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    p.add_argument("--self-test", action="store_true")
    p.add_argument("--version", action="version", version=f"zure {__version__}")
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.self_test:
        try:
            self_test()
        except AssertionError as e:
            sys.stderr.write(f"zure --self-test FAILED: {e}\n")
            return 2
        return 0

    kinds = KINDS_DEFAULT + (("use-use",) if args.all else ())
    hidden_only = bool(args.hidden) and not args.also_visible
    analyze_kwargs = dict(
        allow_common=args.common,
        extra_ignore=tuple(args.ignore),
        no_ignore=args.no_ignore,
        strict=args.strict,
        kinds=kinds,
        hidden_only=hidden_only,
    )
    color = color_enabled(args.color)
    snippets = not args.no_snippets
    cwd = args.repo

    try:
        if args.diffs:
            with open(args.diffs[0], encoding="utf-8", errors="surrogateescape") as f:
                diff_h = f.read()
            with open(args.diffs[1], encoding="utf-8", errors="surrogateescape") as f:
                diff_w = f.read()
            report = analyze_diffs(
                diff_h,
                diff_w,
                horizon=None,
                horizon_name=args.diffs[0],
                head=None,
                work_label=args.diffs[1],
                work_mode="diffs",
                **analyze_kwargs,
            )
        elif args.replay is not None:
            n = int(args.replay)
            return run_replay(
                cwd,
                n,
                analyze_kwargs,
                since=args.since,
                horizon=args.horizon,
                fmt=args.format,
                color=color,
                snippets=snippets,
                quiet=args.quiet,
                blame=args.blame,
            )
        else:
            report = run_repo(
                cwd,
                analyze_kwargs,
                since=args.since,
                horizon=args.horizon,
                staged_only=args.staged,
                include_untracked=not args.no_untracked,
                blame=args.blame,
            )
    except GitError as e:
        sys.stderr.write(f"zure: {e}\n")
        return 2
    except OSError as e:
        sys.stderr.write(f"zure: {e}\n")
        return 2

    if not args.quiet:
        if args.format == "json":
            sys.stdout.write(format_json(report))
        elif args.format == "tsv":
            sys.stdout.write(format_tsv(report))
        else:
            sys.stdout.write(format_text(report, color=color, snippets=snippets))

    if report.one_sided:
        return 0
    return 1 if report.zures else 0


if __name__ == "__main__":
    sys.exit(main())
