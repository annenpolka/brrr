def unquote_git_path(raw: str) -> str:
    raw = raw.strip()
    if len(raw) >= 2 and raw[0] == '"' and raw[-1] == '"':
        inner = raw[1:-1]
        out = bytearray()
        i = 0
        while i < len(inner):
            if inner[i] == "\\" and i + 1 < len(inner):
                nxt = inner[i + 1]
                if nxt == "n":
                    out.append(0x0A)
                    i += 2
                elif nxt == "t":
                    out.append(0x09)
                    i += 2
                elif nxt == "r":
                    out.append(0x0D)
                    i += 2
                elif nxt == "\\":
                    out.append(0x5C)
                    i += 2
                elif nxt == '"':
                    out.append(0x22)
                    i += 2
                elif nxt in "01234567":
                    j = i + 1
                    digits = []
                    while j < len(inner) and len(digits) < 3 and inner[j] in "01234567":
                        digits.append(inner[j])
                        j += 1
                    out.append(int("".join(digits), 8))
                    i = j
                else:
                    out.extend(nxt.encode("utf-8"))
                    i += 2
            else:
                out.extend(inner[i].encode("utf-8"))
                i += 1
        return out.decode("utf-8", errors="surrogateescape")
    return raw


def strip_ab_prefix(path: str) -> str:
    if path.startswith("a/") or path.startswith("b/"):
        return path[2:]
    return path


def parse_diff_paths(line: str) -> tuple[str | None, str | None]:
    if not line.startswith("diff --git "):
        return None, None
    rest = line[len("diff --git ") :].rstrip("\n")
    if rest.startswith('"'):
        parts: list[str] = []
        buf = []
        in_q = False
        i = 0
        while i < len(rest):
            ch = rest[i]
            if ch == '"' and not in_q:
                in_q = True
                buf = ['"']
            elif ch == '"' and in_q:
                buf.append('"')
                parts.append(unquote_git_path("".join(buf)))
                in_q = False
                buf = []
            elif in_q:
                buf.append(ch)
            i += 1
        if len(parts) >= 2:
            return strip_ab_prefix(parts[0]), strip_ab_prefix(parts[1])
        return None, None
    marker = " b/"
    idx = rest.find(marker)
    if idx == -1:
        bits = rest.split()
        if len(bits) >= 2:
            return strip_ab_prefix(unquote_git_path(bits[0])), strip_ab_prefix(
                unquote_git_path(bits[1])
            )
        return None, None
    a = strip_ab_prefix(unquote_git_path(rest[:idx]))
    b = strip_ab_prefix(unquote_git_path(rest[idx + 1 :]))
    return a, b


def parse_unified_diff(text: str) -> list[FileHunks]:
    files: list[FileHunks] = []
    current: FileHunks | None = None
    old_ln = 0
    new_ln = 0
    skip_binary = False
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("diff --git "):
            skip_binary = False
            a_path, b_path = parse_diff_paths(line)
            path = b_path or a_path or ""
            current = FileHunks(path=path)
            files.append(current)
            i += 1
            continue
        if line.startswith("Binary files ") or line.startswith("GIT binary patch"):
            skip_binary = True
            i += 1
            continue
        if skip_binary:
            i += 1
            continue
        if line.startswith("+++ "):
            rhs = unquote_git_path(line[4:])
            if rhs != "/dev/null" and current is not None:
                current.path = strip_ab_prefix(rhs)
            i += 1
            continue
        if line.startswith("--- "):
            lhs = unquote_git_path(line[4:])
            if current is not None and current.path in ("", "/dev/null"):
                if lhs != "/dev/null":
                    current.path = strip_ab_prefix(lhs)
            i += 1
            continue
        m = HUNK_RE.match(line)
        if m and current is not None:
            old_ln = int(m.group(1))
            new_ln = int(m.group(3))
            trailer = m.group(5) or ""
            current.headers.append(trailer.lstrip())
            i += 1
            continue
        if current is None:
            i += 1
            continue
        if line.startswith("+"):
            current.lines.append(("+", new_ln, line[1:]))
            new_ln += 1
        elif line.startswith("-"):
            current.lines.append(("-", old_ln, line[1:]))
            old_ln += 1
        elif line.startswith("\\"):
            pass
        elif line.startswith(" "):
            current.lines.append((" ", new_ln, line[1:]))
            old_ln += 1
            new_ln += 1
        i += 1
    return [f for f in files if f.path]


def is_comment_line(text: str) -> bool:
    return bool(COMMENT_LINE_RE.match(text))


def defs_on_line(text: str) -> set[str]:
    if is_comment_line(text):
        return set()
    found: set[str] = set()
    for m in INTRO_RE.finditer(text):
        found.add(m.group(2))
    for m in IMPL_RE.finditer(text):
        if m.group(1):
            found.add(m.group(1))
        found.add(m.group(2))
    for m in BINDING_RE.finditer(text):
        found.add(m.group(1))
    return found


def header_defs_on_line(text: str) -> set[str]:
    found: set[str] = set()
    for m in INTRO_RE.finditer(text):
        if m.group(1) in HEADER_CALLABLE_KWS:
            found.add(m.group(2))
    return found


def idents_on_line(text: str) -> list[str]:
    return IDENT_RE.findall(text)


def call_shaped(ident: str, text: str) -> bool:
    """True if ident is invoked as a call/constructor on this line."""
    return re.search(r"\b" + re.escape(ident) + r"\s*\(", text) is not None


def interesting(ident: str, *, allow_common: bool) -> bool:
    if len(ident) < 3:
        return False
    if ident in KEYWORDS or ident.lower() in KEYWORDS:
        return False
    if ident in STDLIB:
        return False
    if not allow_common and (ident in COMMON or ident.lower() in COMMON):
        return False
    return True


def ignored_path(path: str, extra_ignore: Sequence[str], no_ignore: bool) -> bool:
    if no_ignore:
        return False
    posix = path.replace("\\", "/")
    parts = [p for p in posix.split("/") if p]
    if any(p in IGNORE_DIRS for p in parts):
        return True
    base = parts[-1] if parts else posix
    for g in (*IGNORE_GLOBS, *extra_ignore):
        if fnmatch.fnmatch(posix, g) or fnmatch.fnmatch(base, g):
            return True
        if g.endswith("/") and posix.startswith(g.rstrip("/") + "/"):
            return True
    return False


def extract_hits(
    files: Iterable[FileHunks],
    *,
    allow_common: bool,
    extra_ignore: Sequence[str],
    no_ignore: bool,
    strict: bool,
) -> list[Hit]:
    hits: list[Hit] = []
    for fh in files:
        if ignored_path(fh.path, extra_ignore, no_ignore):
            continue
        changed = [ln for ln in fh.lines if ln[0] in "+-"]
        if not changed:
            continue
        header_defs: set[str] = set()
        for hdr in fh.headers:
            header_defs |= header_defs_on_line(hdr)
        if not strict:
            for ident in header_defs:
                if interesting(ident, allow_common=allow_common):
                    hits.append(
                        Hit(
                            path=fh.path,
                            line=changed[0][1],
                            sign="~",
                            role="def",
                            ident=ident,
                            text=fh.headers[0] if fh.headers else "",
                        )
                    )
        for sign, ln, text in changed:
            defs = defs_on_line(text)
            seen: set[str] = set()
            for ident in idents_on_line(text):
                if ident in seen:
                    continue
                seen.add(ident)
                if not interesting(ident, allow_common=allow_common):
                    continue
                if ident in defs:
                    role = "def"
                else:
                    # A signature line defines one name and *mentions* types
                    # and parameters. Those mentions are not callsites.
                    # Keep only call-shaped uses so `fn extra() { foo(); }`
                    # still counts `foo`, while `fn f(x: T) -> U` does not
                    # count T/U/x.
                    if defs and not call_shaped(ident, text):
                        continue
                    role = "use"
                hits.append(
                    Hit(
                        path=fh.path,
                        line=ln,
                        sign=sign,
                        role=role,
                        ident=ident,
                        text=text.strip(),
                    )
                )
    return hits


def index_side(hits: Iterable[Hit]) -> dict[str, SideIdent]:
    out: dict[str, SideIdent] = defaultdict(SideIdent)
    for h in hits:
        s = out[h.ident]
        if h.role == "def":
            if h.sign == "+":
                s.defs_added.append(h)
            elif h.sign == "-":
                s.defs_removed.append(h)
            else:
                s.defs_touched.append(h)
        else:
            if h.sign == "+":
                s.uses_added.append(h)
            elif h.sign == "-":
                s.uses_removed.append(h)
    return out


def classify_kind(hist: SideIdent, work: SideIdent) -> tuple[str, str] | None:
    """Return (kind, lead) where lead is which side changed the definition.

    Sequential self-merge: both sides editing an existing def is not
    split-brain (that's a file move + a later signature tweak). dup-def
    only fires when both *introduce* the name.
    """
    hist_del = hist.deleted_def()
    work_del = work.deleted_def()
    if hist_del and work.uses_added:
        return "stale-use", "hist"
    if work_del and hist.changed_use():
        return "break-use", "work"
    if hist.added_def() and work.added_def():
        return "dup-def", "both"
    if work.changed_def() and hist.changed_use():
        return "break-use", "work"
    if hist.changed_def() and work.changed_use():
        return "stale-use", "hist"
    if hist.changed_use() and work.changed_use():
        return "use-use", "none"
    return None


def find_zures(
    hits_hist: Sequence[Hit],
    hits_work: Sequence[Hit],
    work_files: Sequence[str],
    *,
    kinds: Sequence[str],
    hidden_only: bool,
) -> list[Zure]:
    ih = index_side(hits_hist)
    iw = index_side(hits_work)
    work_set = set(work_files)
    out: list[Zure] = []
    for ident in sorted(set(ih) | set(iw)):
        h = ih.get(ident, SideIdent())
        w = iw.get(ident, SideIdent())
        classified = classify_kind(h, w)
        if classified is None:
            continue
        kind, lead = classified
        if kind not in kinds:
            continue
        files = sorted(
            {hit.path for hit in h.all_hits()} | {hit.path for hit in w.all_hits()}
        )
        hist_only = [p for p in files if p not in work_set]
        hidden = bool(hist_only)
        if hidden_only and not hidden:
            continue
        out.append(
            Zure(
                kind=kind,
                ident=ident,
                hidden=hidden,
                hist=h.all_hits(),
                work=w.all_hits(),
                files=files,
                lead=lead,
            )
        )
    out.sort(key=lambda z: (KIND_ORDER.get(z.kind, 9), z.ident))
    return out


def git(
    args: Sequence[str],
    cwd: str | None = None,
    *,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes]:
    proc = subprocess.run(
        ["git", "-c", "core.quotepath=false", "-c", "diff.noprefix=false", *args],
        cwd=cwd,
        capture_output=True,
        check=False,
        env=env,
    )
    if check and proc.returncode != 0:
        err = proc.stderr.decode("utf-8", errors="replace")
        raise GitError(args, err, proc.returncode)
    return proc


def git_text(
    args: Sequence[str],
    cwd: str | None = None,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> str:
    proc = git(args, cwd=cwd, check=check, env=env)
    return proc.stdout.decode("utf-8", errors="surrogateescape")


def repo_root(cwd: str | None) -> str:
    return git_text(["rev-parse", "--show-toplevel"], cwd=cwd).strip()


def short(rev: str | None) -> str:
    if not rev:
        return "-"
    if re.fullmatch(r"[0-9a-f]{40}", rev):
        return rev[:8]
    return rev


def rev_count(cwd: str | None, rev: str = "HEAD") -> int:
    try:
        return int(git_text(["rev-list", "--count", rev], cwd=cwd).strip())
    except GitError:
        return 0


def rev_parse(rev: str, cwd: str | None) -> str:
    return git_text(["rev-parse", "--verify", rev], cwd=cwd).strip()


def is_ancestor(anc: str, desc: str, cwd: str | None) -> bool:
    proc = git(["merge-base", "--is-ancestor", anc, desc], cwd=cwd, check=False)
    return proc.returncode == 0


def collect_diff(left: str, right: str, cwd: str | None) -> str:
    return git_text(
        ["diff", "--no-color", "--no-ext-diff", "-U0", "-M", left, right, "--"],
        cwd=cwd,
    )


def quote_diff_path(path: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9._/+-]+", path):
        return path
    escaped = (
        path.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\t", "\\t")
    )
    encoded = escaped.encode("utf-8")
    # git C-quotes non-ascii as octal
    out = []
    for b in encoded:
        if b < 32 or b > 126 or b in (0x22, 0x5C):
            out.append(f"\\{b:03o}" if b > 126 or b < 32 else ("\\\"" if b == 0x22 else "\\\\"))
        else:
            out.append(chr(b))
    # Simpler: wrap utf-8 path; parser accepts quoted unicode.
    return '"' + path.replace("\\", "\\\\").replace('"', '\\"') + '"'


def synthesize_new_file_diff(path: str, text: str, *, mode: str = "100644") -> str:
    header = (
        f"diff --git {quote_diff_path('a/' + path)} {quote_diff_path('b/' + path)}\n"
    )
    plus_path = quote_diff_path("b/" + path)
    plus = f"+++ {plus_path if plus_path.startswith(chr(34)) else 'b/' + path}\n"
    if plus_path.startswith('"'):
        plus = f'+++ "b/{path}"\n'
    else:
        plus = f"+++ b/{path}\n"
    minus = "--- /dev/null\n"
    prefix = header + f"new file mode {mode}\n" + minus + plus
    if not text:
        return prefix
    newline_at_end = text.endswith("\n")
    body = text[:-1] if newline_at_end else text
    lines = body.split("\n") if body else ([""] if newline_at_end else [])
    n = len(lines)
    hunk = f"@@ -0,0 +1,{n} @@\n" if n != 1 else "@@ -0,0 +1 @@\n"
    payload = "".join("+" + ln + "\n" for ln in lines)
    extra = "" if newline_at_end else "\\ No newline at end of file\n"
    return prefix + hunk + payload + extra


def collect_untracked_diff(
    cwd: str | None,
    extra_ignore: Sequence[str],
    no_ignore: bool,
) -> str:
    root = repo_root(cwd)
    proc = git(["ls-files", "-z", "--others", "--exclude-standard"], cwd=cwd)
    paths = [
        p.decode("utf-8", errors="surrogateescape")
        for p in proc.stdout.split(b"\0")
        if p
    ]
    chunks: list[str] = []
    for path in paths:
        if ignored_path(path, extra_ignore, no_ignore):
            continue
        full = os.path.join(root, path)
        try:
            st = os.lstat(full)
        except OSError:
            continue
        if stat.S_ISLNK(st.st_mode) or stat.S_ISDIR(st.st_mode):
            continue
        if st.st_size > UNTRACKED_MAX_BYTES:
            continue
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            continue
        if b"\0" in data[:8192]:
            continue
        text = data.decode("utf-8", errors="surrogateescape")
        mode = "100755" if st.st_mode & 0o111 else "100644"
        chunks.append(synthesize_new_file_diff(path, text, mode=mode))
    return "".join(chunks)


def collect_work_diff(
    cwd: str | None,
    *,
    staged_only: bool,
    include_untracked: bool,
    extra_ignore: Sequence[str],
    no_ignore: bool,
) -> str:
    if staged_only:
        return git_text(
            ["diff", "--no-color", "--no-ext-diff", "-U0", "-M", "--cached", "--"],
            cwd=cwd,
        )
    diff = git_text(
        ["diff", "--no-color", "--no-ext-diff", "-U0", "-M", "HEAD", "--"],
        cwd=cwd,
    )
    if include_untracked:
        diff += collect_untracked_diff(cwd, extra_ignore, no_ignore)
    return diff


def try_rev(rev: str, cwd: str | None) -> str | None:
    proc = git(["rev-parse", "--verify", rev], cwd=cwd, check=False)
    if proc.returncode != 0:
        return None
    return proc.stdout.decode("utf-8", errors="replace").strip()


def head_tilde(cwd: str | None, n: int, start: str = "HEAD") -> str | None:
    count = rev_count(cwd, start)
    n = min(n, max(count - 1, 0))
    if n <= 0:
        return None
    return try_rev(f"{start}~{n}", cwd)


def resolve_horizon(
    cwd: str | None,
    *,
    since: str | None,
    horizon: int | None,
    start: str = "HEAD",
) -> tuple[str | None, str | None]:
    """Return (sha, display-name) for the left edge of committed history."""
    start_sha = try_rev(start, cwd)
    if start_sha is None:
        return None, None
    if since:
        sha = try_rev(since, cwd)
        if sha is None:
            raise GitError(["rev-parse", since], f"unknown revision {since}", 128)
        if sha == start_sha:
            return None, since
        if not is_ancestor(sha, start_sha, cwd):
            mb = git_text(["merge-base", sha, start_sha], cwd=cwd).strip()
            return mb, f"merge-base({since},{start})"
        return sha, since
    if horizon is not None:
        sha = head_tilde(cwd, horizon, start=start)
        if sha is None:
            return None, f"{start}~{horizon}"
        return sha, f"{start}~{min(horizon, max(rev_count(cwd, start) - 1, 0))}"
    # Auto: unique commits vs upstream, else vs mainline, else last N.
    for cand, name in (
        ("@{upstream}", "@{upstream}"),
        ("@{u}", "@{u}"),
    ):
        sha = try_rev(cand, cwd)
        if sha and sha != start_sha:
            if is_ancestor(sha, start_sha, cwd):
                return sha, name
            mb = git_text(["merge-base", sha, start_sha], cwd=cwd).strip()
            if mb != start_sha:
                return mb, f"merge-base({name},{start})"
    for name in ("main", "master", "trunk", "develop", "origin/main", "origin/master"):
        sha = try_rev(name, cwd)
        if not sha:
            continue
        try:
            mb = git_text(["merge-base", sha, start_sha], cwd=cwd).strip()
        except GitError:
            continue
        if mb != start_sha:
            return mb, name
    sha = head_tilde(cwd, DEFAULT_HORIZON, start=start)
    if sha is None:
        return None, f"{start}~{DEFAULT_HORIZON}"
    n = min(DEFAULT_HORIZON, max(rev_count(cwd, start) - 1, 0))
    return sha, f"{start}~{n}"


def color_enabled(args_color: str) -> bool:
    if args_color == "always":
        return True
    if args_color == "never":
        return False
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


def paint(text: str, code: str, on: bool) -> str:
    if not on:
        return text
    return f"\033[{code}m{text}\033[0m"


def format_text(report: Report, *, color: bool, snippets: bool) -> str:
    if report.one_sided:
        return f"zure: {report.one_sided}\n"
    hname = report.horizon_name or short(report.horizon)
    head = short(report.head)
    left = short(report.horizon)
    header = (
        f"zure: {report.work_label} vs history {hname}..{head}"
        f"  ({left}..{head})\n"
    )
    header += (
        f"hist {len(report.hist_files)} file(s), "
        f"work {len(report.work_files)} file(s)  [{report.work_mode}]\n"
    )
    if report.note:
        header += report.note + "\n"
    if not report.zures:
        header += "no identifier conflicts with recent history\n"
        return header
    header += f"{len(report.zures)} zure(s)\n\n"
    blocks = [header]
    kind_color = {
        "break-use": "31",
        "stale-use": "35",
        "dup-def": "33",
        "use-use": "34",
    }
    for z in report.zures:
        tag = paint(z.kind, kind_color.get(z.kind, "36"), color)
        vis = "hidden" if z.hidden else "in-diff"
        blocks.append(f"{tag}  {paint(z.ident, '1', color)}  {vis}\n")
        for side, hits in (("hist", z.hist), ("work", z.work)):
            seen: set[tuple] = set()
            shown = 0
            extra = 0
            for h in hits:
                key = (h.path, h.line, h.role, h.sign, h.origin)
                if key in seen:
                    continue
                seen.add(key)
                if shown >= 12:
                    extra += 1
                    continue
                shown += 1
                loc = f"{h.path}:{h.line}"
                origin = f"  {h.origin}" if h.origin else ""
                line = f"  {side:<4} {h.role:<3} {h.sign} {loc}{origin}"
                if snippets and h.text:
                    clip = h.text.replace("\t", " ")
                    if len(clip) > 100:
                        clip = clip[:97] + "..."
                    line += f"  {clip}"
                blocks.append(line + "\n")
            if extra:
                blocks.append(f"  {side:<4} … {extra} more\n")
        blocks.append("\n")
    return "".join(blocks)


def format_tsv(report: Report) -> str:
    rows = ["kind\tident\thidden\tlead\tside\trole\tsign\tpath\tline\torigin\ttext"]
    for z in report.zures:
        for side, hits in (("hist", z.hist), ("work", z.work)):
            for h in hits:
                text = h.text.replace("\t", " ").replace("\n", " ")
                origin = h.origin or ""
                rows.append(
                    f"{z.kind}\t{z.ident}\t{int(z.hidden)}\t{z.lead}\t"
                    f"{side}\t{h.role}\t{h.sign}\t{h.path}\t{h.line}\t{origin}\t{text}"
                )
    return "\n".join(rows) + ("\n" if rows else "")


def format_json(report: Report) -> str:
    payload = {
        "horizon": report.horizon,
        "horizon_name": report.horizon_name,
        "head": report.head,
        "work_label": report.work_label,
        "work_mode": report.work_mode,
        "hist_files": report.hist_files,
        "work_files": report.work_files,
        "one_sided": report.one_sided,
        "note": report.note,
        "zures": [
            {
                "kind": z.kind,
                "ident": z.ident,
                "hidden": z.hidden,
                "lead": z.lead,
                "files": z.files,
                "hist": [asdict(h) for h in z.hist],
                "work": [asdict(h) for h in z.work],
            }
            for z in report.zures
        ],
    }
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def file_paths(files: Sequence[FileHunks]) -> list[str]:
    return sorted({fh.path for fh in files if fh.path})


def analyze_diffs(
    diff_hist: str,
    diff_work: str,
    *,
    allow_common: bool,
    extra_ignore: Sequence[str],
    no_ignore: bool,
    strict: bool,
    kinds: Sequence[str],
    hidden_only: bool,
    horizon: str | None,
    horizon_name: str | None,
    head: str | None,
    work_label: str,
    work_mode: str,
    note: str | None = None,
) -> Report:
    files_h = parse_unified_diff(diff_hist)
    files_w = parse_unified_diff(diff_work)
    hits_h = extract_hits(
        files_h,
        allow_common=allow_common,
        extra_ignore=extra_ignore,
        no_ignore=no_ignore,
        strict=strict,
    )
    hits_w = extract_hits(
        files_w,
        allow_common=allow_common,
        extra_ignore=extra_ignore,
        no_ignore=no_ignore,
        strict=strict,
    )
    work_files = file_paths(files_w)
    hist_files = file_paths(files_h)
    zures = find_zures(
        hits_h, hits_w, work_files, kinds=kinds, hidden_only=hidden_only
    )
    return Report(
        horizon=horizon,
        horizon_name=horizon_name,
        head=head,
        work_label=work_label,
        work_mode=work_mode,
        hist_files=hist_files,
        work_files=work_files,
        zures=zures,
        note=note,
    )


def attach_hist_origin(hits: list[Hit], cwd: str | None, head: str) -> list[Hit]:
    """Annotate history-side hits with the commit that last touched the line."""
    annotated: list[Hit] = []
    cache: dict[tuple[str, int], str | None] = {}
    for h in hits:
        key = (h.path, h.line)
        if key not in cache:
            proc = git(
                [
                    "blame",
                    "--porcelain",
                    "-L",
                    f"{h.line},{h.line}",
                    head,
                    "--",
                    h.path,
                ],
                cwd=cwd,
                check=False,
            )
            origin = None
            if proc.returncode == 0:
                first = proc.stdout.decode("utf-8", errors="replace").splitlines()
                sha = first[0].split()[0] if first else ""
                summary = ""
                for line in first:
                    if line.startswith("summary "):
                        summary = line[len("summary ") :]
                        break
                if sha:
                    origin = f"{sha[:8]} {summary}".rstrip()
            cache[key] = origin
        annotated.append(
            Hit(
                path=h.path,
                line=h.line,
                sign=h.sign,
                role=h.role,
                ident=h.ident,
                text=h.text,
                origin=cache[key],
            )
        )
    return annotated


def run_repo(
    cwd: str | None,
    analyze_kwargs: dict,
    *,
    since: str | None,
    horizon: int | None,
    staged_only: bool,
    include_untracked: bool,
    blame: bool,
) -> Report:
    head = try_rev("HEAD", cwd)
    if head is None:
        return Report(
            horizon=None,
            horizon_name=None,
            head=None,
            work_label="worktree",
            work_mode="worktree",
            hist_files=[],
            work_files=[],
            zures=[],
            one_sided="no HEAD; nothing to compare",
        )
    extra_ignore = analyze_kwargs["extra_ignore"]
    no_ignore = analyze_kwargs["no_ignore"]
    diff_work = collect_work_diff(
        cwd,
        staged_only=staged_only,
        include_untracked=include_untracked and not staged_only,
        extra_ignore=extra_ignore,
        no_ignore=no_ignore,
    )
    files_w = parse_unified_diff(diff_work)
    if not files_w:
        mode = "index" if staged_only else "worktree"
        return Report(
            horizon=None,
            horizon_name=None,
            head=head,
            work_label=mode,
            work_mode=mode,
            hist_files=[],
            work_files=[],
            zures=[],
            one_sided="working tree clean" if not staged_only else "index clean",
        )
    hz, hz_name = resolve_horizon(cwd, since=since, horizon=horizon, start="HEAD")
    if hz is None:
        return Report(
            horizon=None,
            horizon_name=hz_name,
            head=head,
            work_label="worktree",
            work_mode="index" if staged_only else "worktree",
            hist_files=[],
            work_files=file_paths(files_w),
            zures=[],
            one_sided="no committed history in window to compare against the dirty tree",
        )
    diff_hist = collect_diff(hz, head, cwd)
    work_label = "index" if staged_only else "worktree"
    work_mode = "index" if staged_only else (
        "worktree+untracked" if include_untracked else "worktree"
    )
    report = analyze_diffs(
        diff_hist,
        diff_work,
        horizon=hz,
        horizon_name=hz_name,
        head=head,
        work_label=work_label,
        work_mode=work_mode,
        **analyze_kwargs,
    )
    if blame and report.zures:
        blamed: list[Zure] = []
        for z in report.zures:
            blamed.append(
                Zure(
                    kind=z.kind,
                    ident=z.ident,
                    hidden=z.hidden,
                    hist=attach_hist_origin(z.hist, cwd, head),
                    work=z.work,
                    files=z.files,
                    lead=z.lead,
                )
            )
        report.zures = blamed
    return report


def run_replay(
    cwd: str | None,
    n: int,
    analyze_kwargs: dict,
    *,
    since: str | None,
    horizon: int | None,
    fmt: str,
    color: bool,
    snippets: bool,
    quiet: bool,
    blame: bool,
) -> int:
    log = git_text(
        ["log", "--no-merges", f"-n{n}", "--format=%H%x09%s"],
        cwd=cwd,
    ).strip()
    if not log:
        if not quiet:
            sys.stderr.write("zure: no non-merge commits in range\n")
        return 0
    found = 0
    n_total = 0
    n_skip = 0
    n_clean = 0
    rc = 0
    hz_n = horizon if horizon is not None else DEFAULT_HORIZON
    for line in log.splitlines():
        commit, _, subject = line.partition("\t")
        n_total += 1
        parent = try_rev(f"{commit}^", cwd)
        if parent is None:
            n_skip += 1
            continue
        if since:
            hz, hz_name = resolve_horizon(
                cwd, since=since, horizon=None, start=parent
            )
        else:
            hz, hz_name = resolve_horizon(
                cwd, since=None, horizon=hz_n, start=parent
            )
        if hz is None:
            n_skip += 1
            continue
        diff_hist = collect_diff(hz, parent, cwd)
        diff_work = collect_diff(parent, commit, cwd)
        if not parse_unified_diff(diff_work):
            n_clean += 1
            continue
        report = analyze_diffs(
            diff_hist,
            diff_work,
            horizon=hz,
            horizon_name=hz_name or f"{commit[:8]}^~",
            head=parent,
            work_label=f"commit {commit[:8]}",
            work_mode="replay",
            note=f"subject: {subject}",
            **analyze_kwargs,
        )
        if blame and report.zures:
            report.zures = [
                Zure(
                    kind=z.kind,
                    ident=z.ident,
                    hidden=z.hidden,
                    hist=attach_hist_origin(z.hist, cwd, parent),
                    work=z.work,
                    files=z.files,
                    lead=z.lead,
                )
                for z in report.zures
            ]
        if report.zures:
            rc = 1
            found += len(report.zures)
            if quiet:
                continue
            if fmt == "text":
                sys.stdout.write(f"# {commit[:8]}  {subject}\n")
                sys.stdout.write(format_text(report, color=color, snippets=snippets))
            elif fmt == "json":
                sys.stdout.write(json.dumps({"commit": commit, "subject": subject}) + "\n")
                sys.stdout.write(format_json(report))
            else:
                sys.stdout.write(f"# {commit[:8]}\n")
                sys.stdout.write(format_tsv(report))
        else:
            n_clean += 1
    sys.stderr.write(
        f"zure: replayed {n_total} commit(s): "
        f"{n_total - n_skip - n_clean} flagged, {n_clean} clean, "
        f"{n_skip} skipped, {found} zure(s)\n"
    )
    return rc


