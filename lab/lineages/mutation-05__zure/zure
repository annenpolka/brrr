class GitError(Exception):
    def __init__(self, args: Sequence[str], stderr: str, code: int) -> None:
        super().__init__(f"git {' '.join(args)} failed ({code}): {stderr.strip()}")
        self.args_ = args
        self.stderr = stderr
        self.code = code


@dataclass(frozen=True, slots=True)
class Hit:
    path: str
    line: int
    sign: str
    role: str
    ident: str
    text: str
    origin: str | None = None


@dataclass
class FileHunks:
    path: str
    lines: list[tuple[str, int, str]] = field(default_factory=list)
    headers: list[str] = field(default_factory=list)


@dataclass
class SideIdent:
    defs_added: list[Hit] = field(default_factory=list)
    defs_removed: list[Hit] = field(default_factory=list)
    defs_touched: list[Hit] = field(default_factory=list)
    uses_added: list[Hit] = field(default_factory=list)
    uses_removed: list[Hit] = field(default_factory=list)

    def all_hits(self) -> list[Hit]:
        return (
            self.defs_added
            + self.defs_removed
            + self.defs_touched
            + self.uses_added
            + self.uses_removed
        )

    def changed_def(self) -> bool:
        return bool(self.defs_added or self.defs_removed or self.defs_touched)

    def deleted_def(self) -> bool:
        return bool(self.defs_removed) and not self.defs_added

    def added_def(self) -> bool:
        return bool(self.defs_added) and not self.defs_removed

    def changed_use(self) -> bool:
        return bool(self.uses_added or self.uses_removed)


