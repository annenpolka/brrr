IDENT_RE = re.compile(r"\b[A-Za-z_][A-Za-z0-9_]*\b")
HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@(.*)$")

INTRO_RE = re.compile(
    r"""
    \b(
        fn | func | function | def | class | struct | enum | trait |
        interface | protocol | type | typedef | record | actor |
        extension | module | namespace | object | union | newtype |
        macro_rules!?
    )\b
    (?:\s*<[^>]*>)?
    \s+
    ([A-Za-z_][A-Za-z0-9_]*)
    """,
    re.VERBOSE,
)
IMPL_RE = re.compile(
    r"""
    \bimpl\b
    (?:\s*<[^>]*>)?
    \s+
    (?:([A-Za-z_][A-Za-z0-9_]*)\s+for\s+)?
    ([A-Za-z_][A-Za-z0-9_]*)
    """,
    re.VERBOSE,
)
# Locals (`let abs =`) are not defs for this tool: a file-move rewrite
# would otherwise flag every renamed binding. Require an export/pub/static
# prefix so `export const foo` / `pub const FOO` still count.
BINDING_RE = re.compile(
    r"""
    \b(?:export|declare|pub|static)\s+
    (?:(?:declare|pub|static)\s+)*
    (?:const|let|var|val)\s+
    ([A-Za-z_][A-Za-z0-9_]*)
    """,
    re.VERBOSE,
)

COMMENT_LINE_RE = re.compile(r"""^\s*(//|/\*|\* |#|-- |<!--|\{/\*)""")
HEADER_CALLABLE_KWS = {"fn", "func", "function", "def", "macro_rules", "macro_rules!"}

