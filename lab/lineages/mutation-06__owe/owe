def rarity_lits(added: list[AddedLine]) -> dict[str, list[AddedLine]]:
    index: dict[str, list[AddedLine]] = {}
    for al in added:
        for tok in literal_values(al.text):
            if not acceptable_debt_literal(tok, al.text, al.path):
                continue
            index.setdefault(tok, []).append(al)
    n = len(added) or 1
    cap = max(8, int(n * 0.08))
    out: dict[str, list[AddedLine]] = {}
    for tok, lines in index.items():
        # unique by (path, line)
        uniq: dict[tuple[str, int], AddedLine] = {(x.path, x.line): x for x in lines}
        vals = list(uniq.values())
        if len(vals) < 2:
            continue
        if len(vals) > cap:
            continue
        out[tok] = vals
    return out


def eval_tree_for(change: Change) -> str | None:
    # Commits and ranges score the living tree (HEAD). Working-tree / stdin
    # diffs score the worktree so uncommitted paid lines are visible as paid.
    if change.kind in {"wt", "stdin"}:
        return None
    return "HEAD"


def paid_new_locs(change: Change) -> set[tuple[str, int]]:
    locs = {(r.path, r.new_line) for r in change.replacements}
    locs |= {(a.path, a.line) for a in change.additions}
    return locs


def paid_new_texts(change: Change) -> set[str]:
    texts = {r.new_text.strip() for r in change.replacements}
    texts |= {a.text.strip() for a in change.additions}
    return texts


def natal_lines_sharing(
    added: list[AddedLine],
    tokens: set[str],
    skip: set[tuple[str, str]] | None = None,
) -> list[AddedLine]:
    out: list[AddedLine] = []
    seen: set[tuple[str, int]] = set()
    for al in added:
        loc = (al.path, al.line)
        if loc in seen:
            continue
        vals = token_values(al.text)
        shared = vals & tokens
        if not shared:
            continue
        if skip and (al.path, al.text.strip()) in skip:
            continue
        # Require at least one literal from the query when literals exist.
        lits = {t for t in tokens if not t.isidentifier() or is_number_token(t) or " " in t or "." in t}
        # tokens may mix ids and lits; if any member of tokens is a literal, require it
        query_lits = {t for t in tokens if is_number_token(t) or " " in t or not t.isidentifier()}
        # also treat dotted nums
        query_lits |= {t for t in tokens if is_number_token(t)}
        if query_lits and not (shared & query_lits):
            continue
        seen.add(loc)
        out.append(al)
    return out


def member_from_hit(
    status: str,
    natal: AddedLine,
    hit: Hit | None,
    shared: Iterable[str],
    holds: str | None = None,
) -> Member:
    if hit is None:
        return Member(
            status="gone",
            path=None,
            line=None,
            text=None,
            birth_path=natal.path,
            birth_line=natal.line,
            birth_text=natal.text,
            shared=sorted(shared),
            holds=holds,
        )
    return Member(
        status=status,
        path=hit.path,
        line=hit.line,
        text=hit.text,
        birth_path=natal.path,
        birth_line=natal.line,
        birth_text=natal.text,
        shared=sorted(shared),
        holds=holds,
    )


def num_appears_bare(text: str, num: str) -> bool:
    """True if `num` is not a prefix/suffix of a longer number (0.4 vs 0.42)."""
    for m in re.finditer(re.escape(num), text):
        before = text[m.start() - 1] if m.start() else ""
        after = text[m.end() : m.end() + 1]
        if before.isdigit() or before == ".":
            continue
        if after.isdigit() or after == ".":
            continue
        return True
    return False


def holds_literal(text: str, tok: str) -> bool:
    if tok in token_values(text):
        return True
    if is_number_token(tok) and num_appears_bare(text, tok):
        if THRESHOLD_LINE.search(text) or re.search(
            rf"[=:<>]\s*{re.escape(tok)}\b", text
        ):
            return True
    return False


def classify_against_abandoned(
    hit_text: str,
    abandoned: set[str],
    adopted: set[str],
    paid_idents: set[str],
) -> str:
    toks = token_values(hit_text)
    ids = ident_values(hit_text)
    has_ab = any(holds_literal(hit_text, t) for t in abandoned)
    has_ad = any(holds_literal(hit_text, t) for t in adopted) or bool(adopted & toks)
    if has_ad and (ids & paid_idents) and not has_ab:
        return "ok"
    if has_ad and not has_ab:
        return "ok"
    if has_ab:
        return "owing"
    return "ok"


def analyze_path_a(
    repo: str,
    change: Change,
    *,
    debug: bool,
    max_members: int,
) -> list[Cohort]:
    """Literal-abandoning replacements/deletions → natal unpaid kin at HEAD."""
    tree = eval_tree_for(change)
    paid_locs = paid_new_locs(change)
    paid_texts = paid_new_texts(change)
    parent = change.parent
    if not parent:
        return []

    # Group events by abandoned-literal set, then by birth commit.
    events: list[tuple[set[str], set[str], str, int, str, str | None, int | None, str | None]] = []
    # abandoned, adopted, path, old_line, old_text, new_pathline text

    for r in change.replacements:
        abandoned = {
            t
            for t in (literal_values(r.old_text) - literal_values(r.new_text))
            if acceptable_debt_literal(t, r.old_text, r.path)
        }
        adopted = {
            t
            for t in (literal_values(r.new_text) - literal_values(r.old_text))
            if interesting_literal(t, r.new_text)
        }
        # A rewrite that drops strings/numbers without adopting a new
        # literal is a refactor, not an unpaid bump.
        if not abandoned or not adopted:
            continue
        events.append(
            (abandoned, adopted, r.path, r.old_line, r.old_text, r.new_text, r.new_line, r.path)
        )
        if len(events) >= MAX_EVENTS:
            break

    if len(events) < MAX_EVENTS:
        for d in change.deletions:
            abandoned = {
                t
                for t in literal_values(d.text)
                if acceptable_debt_literal(t, d.text, d.path)
            }
            if not abandoned:
                continue
            events.append((abandoned, set(), d.path, d.old_line, d.text, None, None, None))
            if len(events) >= MAX_EVENTS:
                break

    buckets: dict[tuple[str, frozenset[str]], dict] = {}
    for abandoned, adopted, path, old_line, old_text, new_text, new_line, new_path in events:
        birth = birth_of_line(repo, path, old_line, parent, debug)
        if birth is None:
            # Fall back: treat this change as a mutation without a known birth.
            birth = Birth(
                commit=change.commit or "UNKNOWN",
                date=change.date,
                subject=change.subject,
                path=path,
                region=[old_text],
                uncommitted=change.kind in {"wt", "stdin"},
            )
        natal_added = added_lines_in_commit(repo, birth.commit) if birth.commit not in {"UNKNOWN"} else []
        # A later bump (60→90) still owes kin that never left the natal 30.
        anc = best_ancestral_line(birth.region, old_text) or old_text
        new_lits = literal_values(new_text) if new_text is not None else set()
        birth_debt = {
            t
            for t in (literal_values(anc) - new_lits)
            if acceptable_debt_literal(t, anc, birth.path or path)
        }
        debt = set(abandoned) | birth_debt
        if not debt:
            debt = set(abandoned)
        keys = sorted(debt, key=len, reverse=True)
        # natal siblings: birth added lines that carry a debt literal
        skip_self = {(path, old_text.strip())}
        natal = [
            n
            for n in natal_lines_sharing(natal_added, debt, skip=skip_self)
            if n.path != path
        ]
        cid = (birth.commit, frozenset(debt))
        bkt = buckets.get(cid)
        if bkt is None:
            bkt = {
                "birth": birth,
                "abandoned": set(debt),
                "adopted": set(adopted),
                "keys": list(keys),
                "natal": {(n.path, n.line): n for n in natal},
                "paid": [],
            }
            buckets[cid] = bkt
        else:
            bkt["abandoned"] |= debt
            bkt["adopted"] |= adopted
            for n in natal:
                bkt["natal"][(n.path, n.line)] = n
        if new_text is not None and new_path is not None and new_line is not None:
            bkt["paid"].append(
                Member(
                    status="paid",
                    path=new_path,
                    line=new_line,
                    text=new_text,
                    birth_path=path,
                    birth_line=old_line,
                    birth_text=old_text,
                    shared=sorted(debt),
                    holds=next(iter(adopted), None),
                )
            )

    cohorts: list[Cohort] = []
    paid_idents_all: dict[tuple[str, frozenset[str]], set[str]] = {}
    for cid, bkt in buckets.items():
        paid_idents = set()
        for m in bkt["paid"]:
            if m.text:
                paid_idents |= ident_values(m.text)
        paid_idents_all[cid] = paid_idents
        owing: list[Member] = []
        ok: list[Member] = []
        gone: list[Member] = []
        seen_now: set[tuple[str, int]] = set()
        abandoned: set[str] = bkt["abandoned"]
        adopted: set[str] = bkt["adopted"]
        keys: list[str] = sorted(abandoned, key=len, reverse=True)

        for natal in bkt["natal"].values():
            hits = locate_natal(repo, tree, natal, keys, paid_locs, paid_texts)
            if not hits:
                gone.append(member_from_hit("gone", natal, None, abandoned & token_values(natal.text)))
                if len(gone) + len(owing) >= max_members:
                    break
                continue
            for h in hits:
                loc = (h.path, h.line)
                if loc in seen_now:
                    continue
                seen_now.add(loc)
                shared = token_values(natal.text) & token_values(h.text)
                st = classify_against_abandoned(h.text, abandoned, adopted, paid_idents)
                holds = None
                for lit in keys:
                    sv = slot_value(natal.text, h.text, lit)
                    if sv:
                        holds = sv
                        break
                mem = member_from_hit(st, natal, h, shared or (abandoned & token_values(natal.text)), holds)
                if st == "owing":
                    owing.append(mem)
                else:
                    ok.append(mem)
                if len(owing) >= max_members:
                    break
            if len(owing) >= max_members:
                break

        for m in bkt["paid"]:
            if m.path is not None and m.line is not None:
                seen_now.add((m.path, m.line))

        echo: list[Member] = []
        for lit in keys:
            hits = grep_token(repo, lit, tree)
            if len(hits) > 40:
                hits = [
                    h
                    for h in hits
                    if (ident_values(h.text) & paid_idents)
                    or THRESHOLD_LINE.search(h.text)
                    or re.search(rf"[=:<>]\s*{re.escape(lit)}\b", h.text)
                ]
            for h in hits:
                loc = (h.path, h.line)
                if loc in seen_now or loc in paid_locs:
                    continue
                if h.text.strip() in paid_texts:
                    continue
                st = classify_against_abandoned(h.text, abandoned, adopted, paid_idents)
                if st != "owing":
                    continue
                seen_now.add(loc)
                echo.append(
                    Member(
                        status="echo",
                        path=h.path,
                        line=h.line,
                        text=h.text,
                        birth_path=h.path,
                        birth_line=h.line,
                        birth_text=h.text,
                        shared=[lit],
                        holds=lit,
                    )
                )
                if len(echo) >= max_members:
                    break
            if len(echo) >= max_members:
                break

        factions: dict[str, int] = {}
        for m in bkt["paid"]:
            if m.holds:
                factions[m.holds] = factions.get(m.holds, 0) + 1
        for m in owing:
            tag = m.holds or (m.shared[0] if m.shared else "?")
            factions[tag] = factions.get(tag, 0) + 1

        cohorts.append(
            Cohort(
                kind="owing",
                birth=bkt["birth"],
                keys=keys,
                abandoned=sorted(abandoned, key=len, reverse=True),
                adopted=sorted(adopted, key=len, reverse=True),
                paid=bkt["paid"],
                owing=owing,
                ok=ok,
                gone=gone,
                echo=echo,
                factions=factions,
            )
        )
        if len(cohorts) >= MAX_COHORTS:
            break
    return cohorts


def analyze_path_b(
    repo: str,
    change: Change,
    already: set[tuple[str, frozenset[str]]],
    *,
    debug: bool,
    max_members: int,
) -> list[Cohort]:
    """The change as a birth: clusters of distinctive literals among added lines,
    scored for splits at HEAD."""
    added = change.additions + [
        AddedLine(r.path, r.new_line, r.new_text) for r in change.replacements
    ]
    if len(added) > 800:
        added = added[:800]
    clusters = rarity_lits(added)
    if not clusters:
        return []
    tree = eval_tree_for(change)
    birth = this_change_as_birth(change)
    cohorts: list[Cohort] = []

    for lit, natal_lines in sorted(clusters.items(), key=lambda kv: (-len(kv[1]), -len(kv[0]), kv[0])):
        cid = (birth.commit, frozenset({lit}))
        if cid in already:
            continue
        owing: list[Member] = []
        ok: list[Member] = []
        gone: list[Member] = []
        paid: list[Member] = []
        factions: dict[str, int] = {}
        seen_now: set[tuple[str, int]] = set()
        keys = [lit]

        for natal in natal_lines:
            h = follow_line(repo, tree, natal, lit)
            if h is None:
                gone.append(member_from_hit("gone", natal, None, {lit}))
                continue
            loc = (h.path, h.line)
            if loc in seen_now:
                continue
            seen_now.add(loc)
            holds = slot_value(natal.text, h.text, lit)
            if holds is None:
                toks = literal_values(h.text)
                holds = lit if lit in toks else None
            if holds is None:
                gone.append(member_from_hit("gone", natal, None, {lit}))
                continue
            factions[holds] = factions.get(holds, 0) + 1
            shared = {lit} if lit in token_values(h.text) else ({holds} if holds else set())
            # Path B scores HEAD factions. "paid" means moved off the natal
            # literal; holders stay ok until we see a split, then they become owing.
            if holds == lit:
                ok.append(member_from_hit("ok", natal, h, shared, holds))
            else:
                paid.append(member_from_hit("paid", natal, h, shared, holds))
            if len(ok) + len(paid) + len(owing) >= max_members:
                break

        # If some members moved off `lit` and others still hold it, the holders
        # are unpaid relative to the movers: re-tag ok→owing.
        moved = {k: n for k, n in factions.items() if k != lit}
        if moved and factions.get(lit, 0) > 0:
            owing = [
                Member(
                    status="owing",
                    path=m.path,
                    line=m.line,
                    text=m.text,
                    birth_path=m.birth_path,
                    birth_line=m.birth_line,
                    birth_text=m.birth_text,
                    shared=m.shared,
                    holds=m.holds,
                )
                for m in ok
                if m.holds == lit
            ]
            ok = [m for m in ok if m.holds != lit]
            kind = "split"
        else:
            kind = "split" if len(factions) > 1 else "owing"

        if debug:
            print(
                f"debug: path-b lit={lit!r} natal={len(natal_lines)} factions={factions}",
                file=sys.stderr,
            )

        cohorts.append(
            Cohort(
                kind=kind,
                birth=birth,
                keys=keys,
                abandoned=[lit],
                adopted=sorted(moved.keys(), key=len, reverse=True),
                paid=paid,
                owing=owing,
                ok=ok,
                gone=gone,
                factions=factions,
            )
        )
        already.add(cid)
        if len(cohorts) >= MAX_COHORTS:
            break
    return cohorts


def merge_cohorts(cohorts: list[Cohort]) -> list[Cohort]:
    """Collapse duplicate (birth, abandoned) reports, preferring Path A owing."""
    by: dict[tuple[str, frozenset[str]], Cohort] = {}
    order: list[tuple[str, frozenset[str]]] = []
    for c in cohorts:
        cid = (c.birth.commit, frozenset(c.abandoned or c.keys))
        if cid not in by:
            by[cid] = c
            order.append(cid)
            continue
        other = by[cid]
        # Prefer the report that already has paid mutations (Path A).
        if other.kind == "owing" and c.kind == "split" and other.paid:
            continue
        if c.paid and not other.paid:
            by[cid] = c
            continue
        # Union members
        def ext(dst: list[Member], extra: list[Member]) -> None:
            seen = {(m.path, m.line, m.birth_path, m.birth_line) for m in dst}
            for m in extra:
                k = (m.path, m.line, m.birth_path, m.birth_line)
                if k not in seen:
                    dst.append(m)
                    seen.add(k)

        ext(other.paid, c.paid)
        ext(other.owing, c.owing)
        ext(other.ok, c.ok)
        ext(other.gone, c.gone)
        ext(other.echo, c.echo)
        for k, n in c.factions.items():
            other.factions[k] = max(other.factions.get(k, 0), n)
        if c.kind == "split" and len(c.factions) > 1:
            other.kind = "split"
    return [by[k] for k in order]


def analyze_change(
    repo: str,
    change: Change,
    *,
    debug: bool,
    max_members: int,
    path_b: bool = True,
) -> list[Cohort]:
    a = analyze_path_a(repo, change, debug=debug, max_members=max_members)
    already = {(c.birth.commit, frozenset(c.abandoned or c.keys)) for c in a}
    b: list[Cohort] = []
    if path_b:
        b = analyze_path_b(
            repo, change, already, debug=debug, max_members=max_members
        )
    cohorts = merge_cohorts(a + b)
    cohorts.sort(
        key=lambda c: (
            0 if c.kind == "owing" and c.paid else 1,
            -len(c.owing),
            -(len(c.factions) - 1),
            c.birth.commit,
        )
    )
    return cohorts[:MAX_COHORTS]


