def die(msg: str, code: int = 2) -> None:
    print(f"owe: {msg}", file=sys.stderr)
    raise SystemExit(code)


def git(
    repo: str,
    args: list[str],
    *,
    check: bool = True,
    timeout: int | None = None,
) -> str:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        timeout=timeout,
    )
    if check and r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip()
        die(err or f"git {' '.join(args)} failed (exit {r.returncode})")
    return r.stdout.decode("utf-8", "replace")


def git_ok(
    repo: str,
    args: list[str],
    timeout: int | None = None,
) -> tuple[int, str]:
    try:
        r = subprocess.run(
            ["git", "-C", repo, *args],
            capture_output=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return 124, ""
    return r.returncode, r.stdout.decode("utf-8", "replace")


def find_repo(start: str) -> str:
    r = subprocess.run(
        ["git", "-C", start, "rev-parse", "--show-toplevel"],
        capture_output=True,
    )
    if r.returncode != 0:
        die(f"not a git repository: {start}")
    return r.stdout.decode("utf-8", "replace").strip()


def unquote_git_path(path: str) -> str:
    path = path.split("\t", 1)[0]
    if len(path) >= 2 and path[0] == '"' and path[-1] == '"':
        inner = path[1:-1]
        out: list[str] = []
        i = 0
        while i < len(inner):
            if inner[i] == "\\" and i + 1 < len(inner):
                nxt = inner[i + 1]
                if nxt in '"\\nrtab':
                    out.append(
                        {"n": "\n", "r": "\r", "t": "\t", "a": "\a", "b": "\b"}.get(nxt, nxt)
                    )
                    i += 2
                    continue
                if nxt.isdigit():
                    out.append(chr(int(inner[i + 1 : i + 4], 8)))
                    i += 4
                    continue
            out.append(inner[i])
            i += 1
        return "".join(out)
    return path


def looks_like_location(spec: str) -> bool:
    m = LOC_RE.match(spec)
    if not m:
        return False
    path, _ln = m.group(1), m.group(2)
    if path in {".", ".."}:
        return False
    if "/" in path or Path(path).suffix or " " in path:
        return True
    # FILE.py:12 yes; HEAD:1 is a git tree-ish, not a location.
    if re.search(r"\.[A-Za-z0-9]{1,8}$", path):
        return True
    return False


# ---------------------------------------------------------------------------
# tokenize
# ---------------------------------------------------------------------------


def _string_spans(text: str) -> list[tuple[int, int]]:
    return [(m.start(), m.end()) for m in STR_RE.finditer(text)]


def _in_span(pos: int, spans: list[tuple[int, int]]) -> bool:
    return any(a <= pos < b for a, b in spans)


def tokenize(text: str) -> list[tuple[str, str]]:
    found: list[tuple[str, str]] = []
    seen: set[tuple[str, str]] = set()

    def add(kind: str, value: str) -> None:
        key = (kind, value)
        if key not in seen:
            seen.add(key)
            found.append(key)

    spans = _string_spans(text)
    for m in STR_RE.finditer(text):
        s = (m.group(1) or m.group(2) or "").strip()
        if len(s) >= 2:
            add("str", s)

    for m in IDENT_RE.finditer(text):
        if _in_span(m.start(), spans):
            continue
        w = m.group(0)
        if w.lower() in STOP:
            continue
        if len(w) == 40 and all(c in "0123456789abcdefABCDEF" for c in w):
            continue
        add("id", w.lower())

    for m in NUM_RE.finditer(text):
        if _in_span(m.start(), spans):
            continue
        n = m.group(1)
        if n in COMMON_NUM:
            continue
        add("num", n)

    return found


def token_values(text: str) -> set[str]:
    return {v for _, v in tokenize(text)}


def literal_values(text: str) -> set[str]:
    return {v for k, v in tokenize(text) if k in ("num", "str")}


def ident_values(text: str) -> set[str]:
    return {v for k, v in tokenize(text) if k == "id"}


def is_number_token(tok: str) -> bool:
    return bool(re.fullmatch(r"\d+(?:\.\d+)?", tok))


def number_context_ok(text: str, num: str) -> bool:
    """Drop range bounds, version suffixes, and UI/style numeric args."""
    for m in re.finditer(re.escape(num), text):
        before = text[max(0, m.start() - 24) : m.start()]
        after = text[m.end() : m.end() + 2]
        if RANGE_RE.search(before) or after.startswith(".."):
            continue
        if re.search(r"[A-Za-z]$", before) or before.endswith("-"):
            if re.search(r"[A-Za-z0-9]-$", before) or re.search(r"[A-Za-z]$", before):
                continue
        if STYLE_BEFORE.search(before):
            continue
        if re.search(r"[\*\/]\s*$", before):
            continue
        if after.startswith("+"):
            continue
        if OS_BEFORE.search(before):
            continue
        return True
    return False


def float_hit_ok(text: str, num: str) -> bool:
    if "." not in num:
        return True
    if STYLE_LINE.search(text) and not THRESHOLD_LINE.search(text):
        return False
    return True


def best_ancestral_line(region: list[str], query_text: str) -> str | None:
    if not region:
        return None
    q = token_values(query_text)
    best = region[0]
    best_n = -1
    for line in region:
        n = len(token_values(line) & q)
        if n > best_n:
            best_n = n
            best = line
    return best


def interesting_literal(tok: str, text: str) -> bool:
    if is_number_token(tok):
        if tok in COMMON_NUM:
            return False
        if not number_context_ok(text, tok):
            return False
        if not float_hit_ok(text, tok):
            return False
    return True


def path_is_code(path: str) -> bool:
    lower = path.lower()
    return any(lower.endswith(ext) for ext in CODE_EXT)


def short_int(tok: str) -> bool:
    return is_number_token(tok) and "." not in tok and len(tok) <= 2


def acceptable_debt_literal(tok: str, text: str, path: str) -> bool:
    """Short integers are debt only as code assignments, not markdown headings."""
    if not interesting_literal(tok, text):
        return False
    if short_int(tok):
        if not path_is_code(path):
            return False
        if not re.search(
            rf"[A-Za-z_][A-Za-z0-9_]*\s*[:=]{{1,2}}\s*{re.escape(tok)}\b", text
        ):
            return False
    return True


# ---------------------------------------------------------------------------
# diff parse
# ---------------------------------------------------------------------------


def parse_hunks(diff: str) -> list[Hunk]:
    hunks: list[Hunk] = []
    path = ""
    i = 0
    lines = diff.splitlines()
    while i < len(lines):
        line = lines[i]
        if line.startswith("diff --git "):
            path = ""
            i += 1
            continue
        if line.startswith("+++ "):
            rest = line[4:]
            if rest.startswith("/dev/null"):
                path = ""
            else:
                if rest.startswith("b/"):
                    rest = rest[2:]
                path = unquote_git_path(rest)
            i += 1
            continue
        m = HUNK_RE.match(line)
        if m and path:
            old_start = int(m.group(1))
            old_count = int(m.group(2) or "1")
            new_start = int(m.group(3))
            new_count = int(m.group(4) or "1")
            body: list[tuple[str, str]] = []
            i += 1
            while i < len(lines):
                l = lines[i]
                if l.startswith("diff --git ") or l.startswith("@@ "):
                    break
                if l.startswith("\\"):
                    i += 1
                    continue
                if l.startswith("+") or l.startswith("-") or l.startswith(" "):
                    body.append((l[0], l[1:]))
                    i += 1
                    continue
                break
            hunks.append(Hunk(path, old_start, old_count, new_start, new_count, body))
            continue
        i += 1
    return hunks


def pair_hunk(h: Hunk) -> tuple[list[Replacement], list[AddedLine], list[Deletion]]:
    replacements: list[Replacement] = []
    additions: list[AddedLine] = []
    deletions: list[Deletion] = []
    minuses: list[tuple[int, str]] = []
    pluses: list[tuple[int, str]] = []

    def flush() -> None:
        n = min(len(minuses), len(pluses))
        for i in range(n):
            ol, ot = minuses[i]
            nl, nt = pluses[i]
            replacements.append(Replacement(h.path, ol, ot, nl, nt))
        for i in range(n, len(minuses)):
            ol, ot = minuses[i]
            deletions.append(Deletion(h.path, ol, ot))
        for i in range(n, len(pluses)):
            nl, nt = pluses[i]
            additions.append(AddedLine(h.path, nl, nt))
        minuses.clear()
        pluses.clear()

    old_line = h.old_start
    new_line = h.new_start
    for kind, text in h.lines:
        if kind == " ":
            flush()
            old_line += 1
            new_line += 1
        elif kind == "-":
            minuses.append((old_line, text))
            old_line += 1
        elif kind == "+":
            pluses.append((new_line, text))
            new_line += 1
    flush()
    return replacements, additions, deletions


def events_from_hunks(
    hunks: Iterable[Hunk],
) -> tuple[list[Replacement], list[AddedLine], list[Deletion]]:
    replacements: list[Replacement] = []
    additions: list[AddedLine] = []
    deletions: list[Deletion] = []
    for h in hunks:
        r, a, d = pair_hunk(h)
        replacements.extend(r)
        additions.extend(a)
        deletions.extend(d)
    return replacements, additions, deletions


def added_from_hunks(hunks: Iterable[Hunk]) -> list[AddedLine]:
    out: list[AddedLine] = []
    for h in hunks:
        new_line = h.new_start
        for kind, text in h.lines:
            if kind == " ":
                new_line += 1
            elif kind == "+":
                out.append(AddedLine(h.path, new_line, text))
                new_line += 1
    return out


# ---------------------------------------------------------------------------
# change ingest
# ---------------------------------------------------------------------------


def commit_meta(repo: str, spec: str) -> tuple[str, str, str]:
    code, out = git_ok(
        repo, ["log", "-1", "--format=%H%x09%cI%x09%s", spec]
    )
    if code != 0 or not out.strip():
        die(f"not a commit: {spec}")
    parts = out.strip().split("\t", 2)
    if len(parts) < 3:
        die(f"could not parse commit metadata for {spec}")
    return parts[0], parts[1], parts[2]


def is_commit_ish(repo: str, spec: str) -> bool:
    code, _ = git_ok(repo, ["rev-parse", "--verify", spec + "^{commit}"])
    return code == 0


def load_change(repo: str, spec: str | None, *, wt: bool, from_stdin: bool) -> Change:
    if from_stdin or spec == "-":
        diff = sys.stdin.read()
        hunks = parse_hunks(diff)
        r, a, d = events_from_hunks(hunks)
        parent = git(repo, ["rev-parse", "HEAD"]).strip()
        return Change(
            spec="-",
            kind="stdin",
            commit=None,
            parent=parent,
            date="",
            subject="stdin diff",
            diff=diff,
            hunks=hunks,
            replacements=r,
            additions=a,
            deletions=d,
        )

    if wt or spec in {"wt", "WORKTREE", "working-tree"}:
        diff = git(repo, ["diff", "-U0", "--find-renames", "HEAD"])
        hunks = parse_hunks(diff)
        r, a, d = events_from_hunks(hunks)
        parent = git(repo, ["rev-parse", "HEAD"]).strip()
        return Change(
            spec="wt",
            kind="wt",
            commit="UNCOMMITTED",
            parent=parent,
            date="",
            subject="working tree",
            diff=diff,
            hunks=hunks,
            replacements=r,
            additions=a,
            deletions=d,
        )

    if spec is None:
        spec = "HEAD"

    if looks_like_location(spec):
        die(
            "pass a commit or a diff, not FILE:LINE "
            "(owe starts from a change; you do not need to know the line)"
        )

    if ".." in spec:
        left, right = spec.split("..", 1)
        right = right.lstrip(".")
        left = left or "HEAD"
        right = right or "HEAD"
        if not is_commit_ish(repo, left) or not is_commit_ish(repo, right):
            die(f"not a commit range: {spec}")
        diff = git(repo, ["diff", "-U0", "--find-renames", left, right])
        full, date, subject = commit_meta(repo, right)
        hunks = parse_hunks(diff)
        r, a, d = events_from_hunks(hunks)
        parent = git(repo, ["rev-parse", left]).strip()
        return Change(
            spec=spec,
            kind="range",
            commit=full,
            parent=parent,
            date=date,
            subject=subject,
            diff=diff,
            hunks=hunks,
            replacements=r,
            additions=a,
            deletions=d,
        )

    if not is_commit_ish(repo, spec):
        die(f"not a commit: {spec}")

    full, date, subject = commit_meta(repo, spec)
    code, parent_out = git_ok(repo, ["rev-parse", f"{full}^"])
    parent = parent_out.strip() if code == 0 else None
    if parent:
        diff = git(repo, ["diff", "-U0", "--find-renames", parent, full])
    else:
        diff = git(repo, ["show", "--format=", "-U0", "--find-renames", full])
    hunks = parse_hunks(diff)
    r, a, d = events_from_hunks(hunks)
    return Change(
        spec=spec,
        kind="commit",
        commit=full,
        parent=parent,
        date=date,
        subject=subject,
        diff=diff,
        hunks=hunks,
        replacements=r,
        additions=a,
        deletions=d,
    )


# ---------------------------------------------------------------------------
# birth
# ---------------------------------------------------------------------------

_birth_cache: dict[tuple[str, str, str, int], Birth | None] = {}
_added_cache: dict[tuple[str, str], list[AddedLine]] = {}
_grep_cache: dict[tuple[str, str, str], list[Hit]] = {}


def birth_of_line(repo: str, path: str, line: int, at: str, debug: bool) -> Birth | None:
    key = (repo, at, path, line)
    if key in _birth_cache:
        return _birth_cache[key]
    spec = f"{line},{line}:{path}"
    args_follow = [
        "log",
        "-L",
        spec,
        at,
        "-p",
        "--pretty=format:%x1e%H%x09%cI%x09%s",
        "--follow",
    ]
    code, out = git_ok(repo, args_follow, timeout=LOG_L_TIMEOUT)
    if code != 0 or not out.strip():
        code, out = git_ok(
            repo,
            ["log", "-L", spec, at, "-p", "--pretty=format:%x1e%H%x09%cI%x09%s"],
            timeout=LOG_L_TIMEOUT,
        )
    if code != 0 or not out.strip():
        _birth_cache[key] = None
        return None
    records = [r for r in out.split("\x1e") if r.strip()]
    if not records:
        _birth_cache[key] = None
        return None
    oldest = records[-1]
    header, _, body = oldest.partition("\n")
    parts = header.strip().split("\t", 2)
    if len(parts) < 3:
        _birth_cache[key] = None
        return None
    commit, date, subject = parts[0], parts[1], parts[2]
    region: list[str] = []
    birth_path = path
    for line_txt in body.splitlines():
        if line_txt.startswith("+++ "):
            rest = line_txt[4:]
            if rest.startswith("b/"):
                rest = rest[2:]
            if not rest.startswith("/dev/null"):
                birth_path = unquote_git_path(rest)
        if line_txt.startswith("+") and not line_txt.startswith("+++"):
            region.append(line_txt[1:])
    if debug:
        print(
            f"debug: birth {commit[:8]} {path}:{line} region={region[:3]!r}",
            file=sys.stderr,
        )
    b = Birth(commit, date, subject, birth_path, region, uncommitted=False)
    _birth_cache[key] = b
    return b


def added_lines_in_commit(repo: str, commit: str) -> list[AddedLine]:
    key = (repo, commit)
    if key in _added_cache:
        return _added_cache[key]
    if commit == "UNCOMMITTED":
        diff = git(repo, ["diff", "-U0", "--find-renames", "HEAD"])
    else:
        code, parent_out = git_ok(repo, ["rev-parse", f"{commit}^"])
        parent = parent_out.strip() if code == 0 else None
        if parent:
            diff = git(repo, ["diff", "-U0", "--find-renames", parent, commit])
        else:
            diff = git(repo, ["show", "--format=", "-U0", "--find-renames", commit])
    added = added_from_hunks(parse_hunks(diff))
    _added_cache[key] = added
    return added


def this_change_as_birth(change: Change) -> Birth:
    return Birth(
        commit=change.commit or "STDIN",
        date=change.date,
        subject=change.subject,
        path="",
        region=[],
        uncommitted=change.kind in {"wt", "stdin"},
    )


