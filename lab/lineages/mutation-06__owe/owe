def run_selftest() -> None:
    fails: list[str] = []

    def expect(cond: bool, msg: str) -> None:
        if not cond:
            fails.append(msg)

    toks = token_values("TIMEOUT = 30  # 15s later")
    expect("timeout" in toks, f"ident TIMEOUT missing: {toks}")
    expect("30" in toks, f"num 30 missing: {toks}")
    expect("15" in toks, f"unit 15s should yield 15: {toks}")

    toks = token_values("presentThreshold: Double = 0.45")
    expect("0.45" in toks, f"float missing: {toks}")
    expect("presentthreshold" in toks, f"camel missing: {toks}")

    toks = token_values(
        'pub(crate) const SCAR_TEXT_ASK: &str = "explain this change";'
    )
    expect("scar_text_ask" in toks, f"const missing: {toks}")
    expect("explain this change" in toks, f"string missing: {toks}")

    toks = token_values(
        'const P = "data/fixtures/golden/direct-critical-armor.scenario.json";'
    )
    expect(
        "data/fixtures/golden/direct-critical-armor.scenario.json" in toks,
        f"full string token missing: {toks}",
    )
    expect("critical" not in toks, f"idents leaked from string: {toks}")
    expect("golden" not in toks, f"idents leaked from string: {toks}")

    expect(number_context_ok("timeout: 300", "300"), "bare 300 should pass")
    expect(
        not number_context_ok("if !(200..<300).contains(code)", "300"),
        "range bound 300 should fail",
    )
    expect(not number_context_ok("runs-on: macos-15", "15"), "macos-15 suffix")
    expect(not number_context_ok(".foregroundStyle(.white.opacity(0.4))", "0.4"), "opacity")
    expect(not number_context_ok("Task.sleep(for: .milliseconds(300))", "300"), "ms wrapper")
    expect(float_hit_ok("// 3回目で0.4を下回る", "0.4"), "threshold comment")
    expect(not float_hit_ok("yaw: 0.4, pitch: 0.0", "0.4"), "gaze yaw")

    expect(
        "TENAOSHI_PROVIDER" in literal_values('environment["TENAOSHI_PROVIDER"]'),
        "quoted env key is a string literal",
    )
    expect(
        "TENAOSHI_PROVIDER" not in literal_values("`TENAOSHI_PROVIDER`"),
        "markdown backticks are not string literals",
    )

    expect(
        not acceptable_debt_literal("5", "## 5. Run just check", "README.md"),
        "heading 5 in markdown is not debt",
    )
    expect(
        acceptable_debt_literal("30", "TIMEOUT = 30", "config.py"),
        "TIMEOUT = 30 is debt",
    )
    expect(
        acceptable_debt_literal("30", "assert TIMEOUT == 30", "tests/test_timeout.py"),
        "TIMEOUT == 30 is a code value",
    )
    expect(
        acceptable_debt_literal("0.4", "threshold: Double = 0.4,", "PresenceArbiter.swift"),
        "float threshold is debt",
    )
    expect(
        not acceptable_debt_literal("14", "- Total clauses: 14", "docs/generated/COVERAGE.md"),
        "prose clause count is not debt",
    )

    expect(looks_like_location("config.py:1"), "config.py:1 is a location")
    expect(looks_like_location("src/foo bar/timeout.py:1"), "path with spaces")
    expect(not looks_like_location("HEAD"), "HEAD is not a location")
    expect(not looks_like_location("e9b0f75"), "short hash is not a location")

    diff = """diff --git a/config.py b/config.py
--- a/config.py
+++ b/config.py
@@ -1,1 +1,1 @@
-TIMEOUT = 30
+TIMEOUT = 60
diff --git a/docs/how to set (timeout).md b/docs/how to set (timeout).md
new file mode 100644
--- /dev/null
+++ b/docs/how to set (timeout).md
@@ -0,0 +1,2 @@
+# timeout
+timeout is 30 seconds
"""
    hunks = parse_hunks(diff)
    r, a, d = events_from_hunks(hunks)
    expect(len(r) == 1, f"one replacement, got {r}")
    expect(r[0].old_text == "TIMEOUT = 30", f"old {r[0].old_text!r}")
    expect(r[0].new_text == "TIMEOUT = 60", f"new {r[0].new_text!r}")
    expect(
        any(x.path.endswith(".md") and "30" in x.text for x in a),
        f"weird path added: {a}",
    )
    abandoned = literal_values(r[0].old_text) - literal_values(r[0].new_text)
    expect(abandoned == {"30"}, f"abandoned {abandoned}")

    diff_multi = """diff --git a/x.swift b/x.swift
--- a/x.swift
+++ b/x.swift
@@ -27,3 +30,5 @@
         sensors: [any SensorProtocol],
-        threshold: Double = 0.4,
+        presentThreshold: Double = 0.45,
+        absentThreshold: Double = 0.35,
         emaAlpha: Double = 0.3,
"""
    hunks = parse_hunks(diff_multi)
    r, a, d = events_from_hunks(hunks)
    expect(len(r) == 1, f"paired first minus/plus, extra plus is add: r={r} a={a}")
    expect("0.4" in literal_values(r[0].old_text), "old has 0.4")
    expect("0.45" in literal_values(r[0].new_text), "new has 0.45")
    expect(any("0.35" in x.text for x in a), f"0.35 addition: {a}")

    st = classify_against_abandoned(
        "timeout is 30 seconds", {"30"}, {"60"}, {"timeout"}
    )
    expect(st == "owing", f"docs still 30 should owe: {st}")
    st = classify_against_abandoned("TIMEOUT = 60", {"30"}, {"60"}, {"timeout"})
    expect(st == "ok", f"paid side is ok: {st}")

    expect(
        holds_literal('@Test("正規化0.714 > 0.4")', "0.4"),
        "comparison inside a quoted test name still holds 0.4",
    )
    expect(not holds_literal("ema=0.42", "0.4"), "0.4 must not match 0.42")
    expect(not num_appears_bare("ema=0.430427", "0.4"), "0.4 must not match 0.430")
    expect(num_appears_bare("threshold 0.4)", "0.4"), "bare 0.4")
    expect(
        holds_literal("threshold: Double = 0.4,", "0.4"),
        "assignment holds 0.4",
    )
    expect(
        not holds_literal(".foregroundStyle(.white.opacity(0.4))", "0.4")
        or not interesting_literal("0.4", ".foregroundStyle(.white.opacity(0.4))"),
        "opacity is not interesting even if it holds the digits",
    )

    expect(slot_value("TIMEOUT = 30", "TIMEOUT = 60", "30") == "60", "slot 30→60")
    expect(slot_value("TIMEOUT = 30", "TIMEOUT = 30", "30") == "30", "slot still 30")

    added_lines = [
        AddedLine("a.py", 1, "TIMEOUT = 30"),
        AddedLine("b.py", 1, "TIMEOUT = 30  # copy"),
        AddedLine("b.md", 1, "timeout is 30 seconds"),
        AddedLine("c.py", 1, "PORT = 8080"),
        AddedLine("d.py", 1, "PORT = 8080  # listen"),
        AddedLine("e.py", 1, "import os"),
        AddedLine("f.py", 1, "import sys"),
        AddedLine("g.py", 1, "import json"),
        AddedLine("h.py", 1, "import re"),
        AddedLine("i.py", 1, "import math"),
        AddedLine("j.py", 1, "import time"),
        AddedLine("k.py", 1, "RETRY = 3"),
        AddedLine("l.py", 1, "retry: 3"),
        AddedLine("n.md", 1, "## 5. Overview"),
        AddedLine("o.md", 1, "5. Run the suite"),
    ]
    clusters = rarity_lits(added_lines)
    expect("30" in clusters, f"30 should cluster: {list(clusters)}")
    expect("8080" in clusters, f"8080 should cluster: {list(clusters)}")
    expect("3" in clusters, f"3 should cluster: {list(clusters)}")
    expect("5" not in clusters, f"heading 5 must not cluster: {list(clusters)}")

    if fails:
        print("selftest FAILED:")
        for f in fails:
            print(" -", f)
        raise SystemExit(1)
    print("selftest ok")


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="owe",
        description=(
            "From a commit or a diff, list every birth cohort in that change "
            "that has already drifted in HEAD. No FILE:LINE — the change is the query."
        ),
    )
    p.add_argument(
        "change",
        nargs="?",
        help="commit, A..B range, 'wt', or '-' (stdin diff). Default: HEAD",
    )
    p.add_argument("-C", "--repo", default=os.getcwd(), help="repository working tree")
    p.add_argument("--wt", action="store_true", help="analyze the working tree vs HEAD")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--check", action="store_true", help="exit 1 if any cohort is unpaid")
    p.add_argument("--all", action="store_true", help="include intact (non-debt) cohorts")
    p.add_argument("--no-birth-clusters", action="store_true", help="skip Path B (change-as-birth clusters)")
    p.add_argument("--max", type=int, default=40, help="max members listed per cohort")
    p.add_argument("--debug", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--no-color", action="store_true")
    p.add_argument("--version", action="version", version=f"owe {VERSION}")
    args = p.parse_args(argv)

    if args.selftest:
        run_selftest()
        return 0

    repo = find_repo(args.repo)
    color = (not args.no_color) and sys.stdout.isatty() and os.environ.get("TERM") != "dumb"
    from_stdin = args.change == "-"
    change = load_change(repo, args.change, wt=args.wt, from_stdin=from_stdin)

    if not change.replacements and not change.additions and not change.deletions:
        if args.json:
            print(json.dumps(report_json(Report(change, [])), indent=2, ensure_ascii=False))
        else:
            print(f"owe: empty diff for {change.spec}")
        return 1 if args.check else 0

    cohorts = analyze_change(
        repo,
        change,
        debug=args.debug,
        max_members=args.max,
        path_b=not args.no_birth_clusters,
    )
    drifted = any(c.debt() for c in cohorts)
    shown = cohorts if args.all else [c for c in cohorts if c.debt()]
    rep = Report(change, shown)

    if args.json:
        print(json.dumps(report_json(rep), indent=2, ensure_ascii=False))
    else:
        print(format_report(rep, color, show_empty=args.all))

    return 1 if args.check and drifted else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
