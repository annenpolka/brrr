# grep / locate
# ---------------------------------------------------------------------------


def parse_grep_line(line: str, tree: str | None) -> Hit | None:
    raw = line
    if tree:
        prefix = tree + ":"
        if raw.startswith(prefix):
            raw = raw[len(prefix) :]
    m = re.match(r"^(.*):(\d+):(.*)$", raw)
    if not m:
        return None
    return Hit(m.group(1), int(m.group(2)), m.group(3))


def grep_token(repo: str, token: str, tree: str | None) -> list[Hit]:
    cache_key = (repo, tree or "WT", token)
    if cache_key in _grep_cache:
        return _grep_cache[cache_key]
    args = ["grep", "-n", "-I", "-i", "-F"]
    if not is_number_token(token) and " " not in token and "." not in token:
        args.append("-w")
    args.extend(["-e", token])
    if tree:
        args.append(tree)
    args.extend(["--", ".", *EXCLUDE_PATHSPEC])
    code, out = git_ok(repo, args)
    if code not in (0, 1):
        _grep_cache[cache_key] = []
        return []
    hits: list[Hit] = []
    for line in out.splitlines():
        h = parse_grep_line(line, tree)
        if not h:
            continue
        if is_number_token(token) and not number_context_ok(h.text, token):
            continue
        if is_number_token(token) and not float_hit_ok(h.text, token):
            continue
        if is_number_token(token) and token not in token_values(h.text):
            # Inside a string / test name: keep only a bare number with
            # comparison or threshold context — never 0.4 inside 0.42.
            if not num_appears_bare(h.text, token):
                continue
            if not THRESHOLD_LINE.search(h.text) and not re.search(
                rf"[=:<>]\s*{re.escape(token)}\b", h.text
            ):
                continue
        if not is_number_token(token) and token not in token_values(h.text) and token.lower() not in h.text.lower():
            # string keys are matched as substrings by git grep -F; require tokenize hit
            if token not in token_values(h.text) and f'"{token}"' not in h.text and f"'{token}'" not in h.text:
                if token not in h.text:
                    continue
        hits.append(h)
    _grep_cache[cache_key] = hits
    return hits


def slot_value(natal_text: str, hit_text: str, natal_lit: str) -> str | None:
    """What did the natal literal become on a located HEAD line?"""
    n_lits = literal_values(natal_text)
    h_lits = literal_values(hit_text)
    if natal_lit in h_lits:
        return natal_lit
    vanished = n_lits - h_lits
    appeared = h_lits - n_lits
    if natal_lit in vanished and len(appeared) == 1:
        return next(iter(appeared))
    if natal_lit in vanished:
        # prefer same kind (num vs str)
        natal_is_num = is_number_token(natal_lit)
        same = [x for x in appeared if is_number_token(x) == natal_is_num]
        if len(same) == 1:
            return same[0]
        if len(appeared) == 1:
            return next(iter(appeared))
    return None


def read_tree_lines(repo: str, tree: str | None, path: str) -> list[str] | None:
    if tree is None:
        p = Path(repo) / path
        if not p.is_file():
            return None
        try:
            return p.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            return None
    code, out = git_ok(repo, ["show", f"{tree}:{path}"])
    if code != 0:
        return None
    return out.splitlines()


def follow_line(
    repo: str,
    tree: str | None,
    natal: AddedLine,
    lit: str,
) -> Hit | None:
    """Follow one natal line to HEAD by same-path identity, then ident.

    Grepping the birth literal would snap to unpaid siblings and hide the
    member that already moved — the whole point of Path B.
    """
    lines = read_tree_lines(repo, tree, natal.path)
    natal_strip = natal.text.strip()
    q = token_values(natal.text)
    ids = ident_values(natal.text)
    if lines is not None:
        for i, t in enumerate(lines, 1):
            if t.strip() == natal_strip:
                return Hit(natal.path, i, t)
        best: Hit | None = None
        best_n = -1
        for i, t in enumerate(lines, 1):
            toks = token_values(t)
            ov = len(toks & q)
            if ids:
                if toks & ids:
                    ov += 2
                else:
                    ov -= 1
            # Prefer a line that still occupies the literal slot (same or swapped).
            if lit in toks or slot_value(natal.text, t, lit):
                ov += 2
            if ov > best_n:
                best_n = ov
                best = Hit(natal.path, i, t)
        if best is not None and best_n >= 2:
            return best

    search = sorted(ids, key=len, reverse=True)[:3]
    for key in search:
        hits = grep_token(repo, key, tree)
        same = [h for h in hits if h.path == natal.path]
        pool = same or hits
        scored: list[tuple[int, Hit]] = []
        for h in pool:
            ov = len(token_values(h.text) & q)
            if ov:
                scored.append((ov, h))
        if scored:
            scored.sort(key=lambda x: -x[0])
            return scored[0][1]
    return None


def locate_natal(
    repo: str,
    tree: str | None,
    natal: AddedLine,
    keys: list[str],
    paid_locs: set[tuple[str, int]],
    paid_texts: set[str],
) -> list[Hit]:
    sib_tokens = token_values(natal.text)
    search_keys = [k for k in keys if k in sib_tokens]
    if not search_keys:
        lits = [t for t in literal_values(natal.text) if t not in COMMON_NUM]
        search_keys = sorted(lits, key=len, reverse=True)[:3]
    if not search_keys:
        search_keys = sorted(sib_tokens, key=len, reverse=True)[:3]
    if not search_keys:
        return []

    candidates: list[Hit] = []
    for key in search_keys:
        hits = grep_token(repo, key, tree)
        if hits:
            candidates = hits
            break
    if not candidates:
        return []

    scored: list[tuple[int, bool, Hit]] = []
    natal_strip = natal.text.strip()
    for h in candidates:
        if (h.path, h.line) in paid_locs:
            continue
        if h.text.strip() in paid_texts and h.path == natal.path:
            continue
        overlap = token_values(h.text) & sib_tokens
        score = len(overlap)
        if h.text.strip() == natal_strip:
            score += 4
        if h.path == natal.path:
            score += 1
        if score <= 0:
            continue
        literal = any(is_number_token(tok) or " " in tok for tok in overlap)
        scored.append((score, literal, h))
    if not scored:
        return []
    best = max(s for s, _, _ in scored)
    kept: list[Hit] = []
    for score, literal, h in scored:
        if score < best:
            continue
        if score >= 2 or h.path == natal.path or literal:
            kept.append(h)
    if best == 1 and len(kept) > 8:
        same = [h for h in kept if h.path == natal.path]
        kept = same or kept[:5]
    elif len(kept) > 12:
        same = [h for h in kept if h.path == natal.path]
        kept = same or kept[:12]
    return kept


