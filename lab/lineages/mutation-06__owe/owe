HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
LOC_RE = re.compile(r"^(.*?):(\d+)(?::\d+)?$")
COMMON_NUM = frozenset({"0", "1", "2", "10", "100"})
RANGE_RE = re.compile(r"\.\.\.?<?$")
