IDENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
NUM_RE = re.compile(
    r"(?<![A-Za-z0-9_])(\d+(?:\.\d+)?)(ms|us|ns|px|em|rem|kb|mb|gb|mib|kib|gib|s)?(?![A-Za-z0-9_])",
