#!/usr/bin/env python3
"""lurch — name every adjacent clock-cut, with scarp's sleep=/ntp=.

scarp classifies cuts[0], cuts[1]. A clock log is a stream of adjacent
cuts. lurch emits SLEEP / DILATE / STEP / REST for every consecutive pair
and prints the same leftover columns scarp does (sleep=, ntp=) on each
row. Never wraps a command. Never spawns.

  wall     CLOCK_REALTIME         (NTP can step it)
  machine  CLOCK_MONOTONIC_RAW    (runs during host sleep; no NTP)
  awake    CLOCK_UPTIME_RAW       (pauses during host sleep; no NTP)
  proper   CPU time a process aged

On Darwin, time.monotonic() is CLOCK_UPTIME_RAW: lid-close does not tick it.
Unlabeled numbers are timestamps of one clock, not a duration bag.
"""

from __future__ import annotations

import argparse
import ast
import ctypes
import json
import os
import re
import sys
import time
from dataclasses import dataclass, field
from typing import Any, TextIO

VERSION = "0.2"

STEP_MIN = 0.05
STEP_PPM = 50e-6
SLEEP_MIN = 0.05
DILATE_GAMMA = 3.0
EPS = 1e-9
ORIGIN_MIXED = 1e7

USAGE = """lurch — name every adjacent clock-cut (scarp names on each pair)

Usage:
  lurch [--explain|--json|--porcelain] [--require NAME] [--forbid NAME]
  lurch cut [--json] [--boot]
  lurch selftest

Stdin is a clock log (JSONL / TSV / key=value / unlabeled timestamps).
Stdout is one named interval per consecutive pair: SLEEP, DILATE, STEP, REST.
Each row carries scarp's leftover columns: sleep=  ntp=
Unlabeled numbers are wall ticks, not a bag of duration fields.
No command wrapping. No spawn. Not a tracer.
"""


def step_min(machine: float) -> float:
    return max(STEP_MIN, STEP_PPM * max(machine, 0.0))


def _has_clock(*names: str) -> bool:
    return all(hasattr(time, n) for n in names)


def clock_backend() -> dict[str, Any]:
    if _has_clock("CLOCK_REALTIME", "CLOCK_MONOTONIC_RAW", "CLOCK_UPTIME_RAW"):
        return {
            "kind": "darwin",
            "wall": time.CLOCK_REALTIME,
            "machine": time.CLOCK_MONOTONIC_RAW,
            "awake": time.CLOCK_UPTIME_RAW,
            "machine_name": "CLOCK_MONOTONIC_RAW",
            "awake_name": "CLOCK_UPTIME_RAW",
            "python_monotonic": "awake",
        }
    if _has_clock("CLOCK_REALTIME", "CLOCK_BOOTTIME", "CLOCK_MONOTONIC"):
        return {
            "kind": "linux",
            "wall": time.CLOCK_REALTIME,
            "machine": time.CLOCK_BOOTTIME,
            "awake": time.CLOCK_MONOTONIC,
            "machine_name": "CLOCK_BOOTTIME",
            "awake_name": "CLOCK_MONOTONIC",
            "python_monotonic": "awake",
        }
    return {
        "kind": "fallback",
        "wall": getattr(time, "CLOCK_REALTIME", None),
        "machine": getattr(time, "CLOCK_MONOTONIC", None),
        "awake": getattr(time, "CLOCK_MONOTONIC", None),
        "machine_name": "CLOCK_MONOTONIC",
        "awake_name": "CLOCK_MONOTONIC",
        "python_monotonic": "unknown",
    }


BACKEND = clock_backend()


def _clock_gettime(clk: int | None) -> float:
    if clk is None:
        return time.time()
    return time.clock_gettime(clk)


class _Timeval(ctypes.Structure):
    _fields_ = [("tv_sec", ctypes.c_int64), ("tv_usec", ctypes.c_int32)]


_LIBC = None


def _libc():
    global _LIBC
    if _LIBC is None:
        try:
            _LIBC = ctypes.CDLL(None)
        except OSError:
            _LIBC = False
    return _LIBC or None


def sysctl_timeval(name: str) -> float | None:
    if sys.platform != "darwin":
        return None
    libc = _libc()
    if libc is None:
        return None
    tv = _Timeval()
    size = ctypes.c_size_t(ctypes.sizeof(tv))
    libc.sysctlbyname.argtypes = [
        ctypes.c_char_p,
        ctypes.c_void_p,
        ctypes.POINTER(ctypes.c_size_t),
        ctypes.c_void_p,
        ctypes.c_size_t,
    ]
    libc.sysctlbyname.restype = ctypes.c_int
    rc = libc.sysctlbyname(name.encode(), ctypes.byref(tv), ctypes.byref(size), None, 0)
    if rc != 0:
        return None
    return float(tv.tv_sec) + float(tv.tv_usec) / 1_000_000.0


def linux_btime() -> float | None:
    try:
        with open("/proc/stat", encoding="utf-8") as f:
            for line in f:
                if line.startswith("btime "):
                    return float(line.split()[1])
    except OSError:
        return None
    return None


def boottime_now() -> float | None:
    if BACKEND["kind"] == "darwin":
        return sysctl_timeval("kern.boottime")
    if BACKEND["kind"] == "linux":
        return linux_btime()
    return None


@dataclass
class Cut:
    wall: float | None = None
    machine: float | None = None
    awake: float | None = None
    python_monotonic: float | None = None
    proper: float | None = None
    boottime: float | None = None
    sleeptime: float | None = None
    waketime: float | None = None
    pid: int | None = None
    extra: dict[str, float] = field(default_factory=dict)

    def as_dict(self) -> dict[str, Any]:
        d: dict[str, Any] = {}
        for k in (
            "wall",
            "machine",
            "awake",
            "python_monotonic",
            "proper",
            "boottime",
            "sleeptime",
            "waketime",
            "pid",
        ):
            v = getattr(self, k)
            if v is not None:
                d[k] = v
        d.update(self.extra)
        return d


def cut_now() -> Cut:
    return Cut(
        wall=_clock_gettime(BACKEND["wall"]),
        machine=_clock_gettime(BACKEND["machine"]),
        awake=_clock_gettime(BACKEND["awake"]),
        python_monotonic=time.monotonic(),
        proper=time.process_time(),
        boottime=boottime_now(),
        sleeptime=sysctl_timeval("kern.sleeptime"),
        waketime=sysctl_timeval("kern.waketime"),
        pid=os.getpid(),
    )


def cut_boot() -> Cut:
    end = cut_now()
    boot = end.boottime
    return Cut(
        wall=boot if boot is not None else (end.wall or 0.0) - (end.machine or 0.0),
        machine=0.0,
        awake=0.0,
        python_monotonic=0.0,
        proper=0.0,
        boottime=boot,
        pid=end.pid,
    )


@dataclass
class PairSpec:
    role: str
    t0: float
    t1: float


@dataclass
class Gap:
    wall: float | None = None
    machine: float | None = None
    awake: float | None = None
    proper: float | None = None
    ntp: float | None = None
    sleep: float | None = None
    gamma: float | None = None
    primary: str = "REST"
    tags: list[str] = field(default_factory=list)
    explains: str = ""
    reason: str = ""
    kind: str = "interval"
    missing_proper: bool = False
    backend: str = field(default_factory=lambda: BACKEND["kind"])


@dataclass
class Interval:
    i: int
    a: Cut
    b: Cut
    gap: Gap


