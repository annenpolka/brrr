# ---------------------------------------------------------------------------
# signature extraction
# ---------------------------------------------------------------------------

def enclosing_type(prefix: str, lang: str) -> str | None:
    if lang == "swift":
        pat = rf"(?:struct|class|enum|actor|extension|protocol)\s+({IDENT})"
    elif lang == "py":
        pat = rf"class\s+({IDENT})"
    elif lang == "rs":
        pat = rf"(?:struct|enum|impl(?:\s*<[^>]*>)?)\s+({IDENT})"
    else:
        pat = rf"(?:class|interface|type|enum)\s+({IDENT})"
    last = None
    for m in re.finditer(pat, prefix):
        last = m.group(1)
    return last


def enclosing_variant(prefix: str) -> str | None:
    """Last Ident {{ before here — clap lives on enum variants, not the enum name."""
    last = None
    for m in re.finditer(rf"({IDENT})\s*\{{", prefix):
        last = m.group(1)
    if last in {
        "enum",
        "struct",
        "impl",
        "mod",
        "match",
        "if",
        "else",
        "for",
        "while",
        "unsafe",
        "pub",
    }:
        return None
    return last


def parse_swift_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk)
    if not chunk or chunk.startswith("@"):
        # attributes like @escaping may prefix; keep going
        chunk = re.sub(r"^(@[A-Za-z_]\w*(?:\([^)]*\))?\s*)+", "", chunk).strip()
    if not chunk:
        return None
    default = None
    # split default at depth-0 '='
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    # name: Type   or  ext int: Type  or  _ int: Type
    m = re.match(
        rf"(?:({IDENT}|_)\s+)?({IDENT})\s*:\s*(.*)$",
        chunk,
        re.S,
    )
    if not m:
        return None
    ext, name, typ_src = m.group(1), m.group(2), m.group(3)
    if ext and ext != "_" and name:
        # external internal:  the *call* uses external label
        call_name = ext
    else:
        call_name = name
    if call_name == "_":
        call_name = name
    tm = re.match(rf"({IDENT})", (typ_src or "").strip())
    typ = tm.group(1) if tm else None
    return Param(name=call_name, default=default, index=index, typ=typ)


def parse_py_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk).strip()
    if not chunk:
        return None
    if chunk.startswith("**") or chunk.startswith("*"):
        return None
    if chunk in {"self", "cls", "/", "*"}:
        return None
    if chunk.startswith("/") or chunk == "*":
        return None
    default = None
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    # drop annotation
    if ":" in chunk:
        name = chunk.split(":", 1)[0].strip()
    else:
        name = chunk.strip()
    if not re.fullmatch(IDENT, name) or name in {"self", "cls"}:
        return None
    return Param(name=name, default=default, index=index)


def parse_ts_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk).strip()
    if not chunk or chunk.startswith("..."):
        return None
    default = None
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    chunk = re.sub(r"[?:].*$", "", chunk).strip()
    chunk = chunk.lstrip("{").strip()
    if not re.fullmatch(IDENT, chunk):
        return None
    return Param(name=chunk, default=default, index=index)


def parse_params(inner: str, lang: str) -> list[Param]:
    out: list[Param] = []
    idx = 0
    for chunk in split_top(inner):
        if lang == "swift":
            p = parse_swift_param(chunk, idx)
        elif lang == "py":
            p = parse_py_param(chunk, idx)
        else:
            p = parse_ts_param(chunk, idx)
        if p:
            out.append(p)
            idx += 1
    return out


def extract_swift_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pat = re.compile(
        rf"{SWIFT_MOD}(func|init)\s*(?:<[^>\n]*>)?\s*({IDENT})?\s*\(",
        re.M,
    )
    for m in pat.finditer(masked):
        kind, name = m.group(1), m.group(2)
        open_idx = m.end() - 1
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = parse_params(inner, "swift")
        if kind == "init":
            callee = enclosing_type(masked[: m.start()], "swift")
            if not callee:
                continue
            skind = "init"
        else:
            callee = name
            if not callee:
                continue
            skind = "func"
        if not any(p.default is not None for p in params):
            continue
        sigs.append(
            Sig(
                callee=callee,
                params=params,
                path=path,
                line=line_at(src, m.start()),
                lang="swift",
                kind=skind,
                open_idx=open_idx,
            )
        )
    return sigs


def extract_py_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pat = re.compile(rf"(?:async\s+)?def\s+({IDENT})\s*\(", re.M)
    for m in pat.finditer(masked):
        name = m.group(1)
        open_idx = m.end() - 1
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = parse_params(inner, "py")
        kind = "func"
        callee = name
        if name == "__init__":
            cls = enclosing_type(masked[: m.start()], "py")
            if not cls:
                continue
            callee = cls
            kind = "init"
        if not any(p.default is not None for p in params):
            continue
        sigs.append(
            Sig(
                callee=callee,
                params=params,
                path=path,
                line=line_at(src, m.start()),
                lang="py",
                kind=kind,
                open_idx=open_idx,
            )
        )
    # dataclass fields
    for m in re.finditer(
        rf"@dataclass(?:\([^)]*\))?\s*\nclass\s+({IDENT})\s*(?:\([^)]*\))?\s*:",
        masked,
    ):
        cls = m.group(1)
        # body: until next class/def at column 0
        rest = src[m.end() :]
        params: list[Param] = []
        idx = 0
        for line in rest.splitlines():
            if re.match(r"^(class|def|async def)\b", line):
                break
            fm = re.match(
                rf"\s+({IDENT})\s*:\s*[^=\n]+?=\s*(.+?)\s*$",
                line,
            )
            if not fm:
                continue
            default = strip_line_comment(fm.group(2))
            params.append(Param(name=fm.group(1), default=default, index=idx))
            idx += 1
        if params:
            sigs.append(
                Sig(
                    callee=cls,
                    params=params,
                    path=path,
                    line=line_at(src, m.start()),
                    lang="py",
                    kind="class",
                )
            )
    return sigs


def extract_ts_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pats = [
        re.compile(rf"(?:export\s+)?(?:async\s+)?function\s+({IDENT})\s*(?:<[^>]*>)?\s*\("),
        re.compile(rf"(?:export\s+)?(?:const|let|var)\s+({IDENT})\s*=\s*(?:async\s+)?(?:<[^>]*>)?\("),
        re.compile(
            rf"(?:(?:public|private|protected|static|async|readonly)\s+)*(constructor)\s*\("
        ),
        # class/object methods with a default, but not every ident(
        re.compile(
            rf"(?:(?:public|private|protected|static|async|readonly)\s+)+({IDENT})\s*(?:<[^>]*>)?\s*\("
        ),
    ]
    seen_opens: set[int] = set()
    for pat in pats:
        for m in pat.finditer(masked):
            open_idx = m.end() - 1
            if open_idx in seen_opens:
                continue
            # constructor / method: skip control keywords
            name = m.group(1)
            if name in {
                "if",
                "for",
                "while",
                "switch",
                "catch",
                "function",
                "return",
                "await",
                "new",
            }:
                continue
            close = match_paren(src, open_idx)
            if close is None:
                continue
            inner = src[open_idx + 1 : close]
            params = parse_params(inner, "ts")
            if not any(p.default is not None for p in params):
                continue
            seen_opens.add(open_idx)
            callee = name
            kind = "func"
            if name == "constructor":
                cls = enclosing_type(masked[: m.start()], "ts")
                if not cls:
                    continue
                callee = cls
                kind = "init"
            sigs.append(
                Sig(
                    callee=callee,
                    params=params,
                    path=path,
                    line=line_at(src, m.start()),
                    lang="ts",
                    kind=kind,
                    open_idx=open_idx,
                )
            )
    return sigs


def extract_clap_sigs(src: str, masked: str, path: str) -> list[Sig]:
    """Rust clap #[arg(default_value = ...)] field → a defaulted slot.

    Structure is matched on the masked file (strings are spaces); the
    default *value* is read from the original, because it lives in a string.
    """
    sigs: list[Sig] = []
    pat = re.compile(
        r"#\[arg\((.*?)\)\]\s*(?:pub\s+)?(" + IDENT + r")\s*:",
        re.S,
    )
    for m in pat.finditer(masked):
        orig = src[m.start() : m.end()]
        field = m.group(2)
        dm = re.search(
            r'default_value(?:_t)?\s*=\s*("(?:\\.|[^"])*"|[A-Za-z0-9_.]+)',
            orig,
        )
        if not dm:
            continue
        default = dm.group(1)
        long_m = re.search(r'\blong\s*=\s*"([^"]+)"', orig)
        flag = long_m.group(1) if long_m else field.replace("_", "-")
        callee = enclosing_variant(masked[: m.start()]) or enclosing_type(
            masked[: m.start()], "rs"
        ) or field
        sigs.append(
            Sig(
                callee=callee,
                params=[Param(name=field, default=default, index=0)],
                path=path,
                line=line_at(src, m.start()),
                lang="rs",
                kind="clap",
                flag=flag,
            )
        )
    return sigs


def extract_sigs(src: str, path: str, lang: str) -> list[Sig]:
    masked = mask(src, lang)
    if lang == "swift":
        return extract_swift_sigs(src, masked, path)
    if lang == "py":
        return extract_py_sigs(src, masked, path)
    if lang == "rs":
        return extract_clap_sigs(src, masked, path)
    return extract_ts_sigs(src, masked, path)


# ---------------------------------------------------------------------------
# call extraction
# ---------------------------------------------------------------------------

def parse_call_args(inner: str, lang: str, params: list[Param]) -> tuple[dict[str, str], set[str]]:
    """Return (passed, bound)."""
    passed: dict[str, str] = {}
    bound: set[str] = set()
    chunks = split_top(inner)
    positional_names = [p.name for p in params]
    pos_i = 0
    for chunk in chunks:
        chunk = strip_line_comment(chunk)
        if not chunk:
            continue
        # keyword: name: value  (swift) or name = value (py/ts)
        kw = None
        val = None
        if lang == "swift":
            m = re.match(rf"({IDENT})\s*:\s*(.*)$", chunk, re.S)
            if m:
                kw, val = m.group(1), m.group(2).strip()
        else:
            m = re.match(rf"({IDENT})\s*=\s*(.*)$", chunk, re.S)
            if m:
                kw, val = m.group(1), m.group(2).strip()
        if kw is None:
            # positional
            if pos_i >= len(positional_names):
                continue
            # swift inits are labeled; a positional unlabeled arg is
            # almost always a comment residue or type-cast, not a call.
            if lang == "swift":
                continue
            kw = positional_names[pos_i]
            val = chunk
            pos_i += 1
        else:
            # keyword: consume this name; positional index skips past it
            if kw in positional_names:
                ni = positional_names.index(kw)
                if ni >= pos_i:
                    pos_i = ni + 1
        passed[kw] = val
        if not is_literal(val):
            bound.add(kw)
    return passed, bound


def find_calls(
    src: str,
    path: str,
    lang: str,
    callees: set[str],
    merged: dict[str, list[Param]],
    sig_opens: set[int] | None = None,
) -> list[Call]:
    if not callees:
        return []
    masked = mask(src, lang)
    names = sorted(callees, key=len, reverse=True)
    # longest-first so PresenceArbiter wins over Arbiter if both exist
    pat = re.compile(r"\b(" + "|".join(re.escape(n) for n in names) + r")\s*\(")
    role = role_of(path)
    calls: list[Call] = []
    opens = sig_opens or set()
    for m in pat.finditer(masked):
        name = m.group(1)
        open_idx = m.end() - 1
        if open_idx in opens:
            continue  # this paren belongs to the signature, not a call
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = merged.get(name, [])
        passed, bound = parse_call_args(inner, lang, params)
        # swift: require at least one labeled arg OR empty ()
        # unlabeled-only was filtered; empty is a real call (Thresholds())
        if lang == "swift" and inner.strip() and not passed:
            continue
        calls.append(
            Call(
                callee=name,
                passed=passed,
                bound=bound,
                path=path,
                line=line_at(src, m.start()),
                role=role,
            )
        )
    return calls


def kebab(name: str) -> str:
    return re.sub(r"(?<!^)(?=[A-Z])", "-", name).replace("_", "-").lower()


def clap_bound_token(val: str) -> bool:
    """Format/interpolation/path-expr tokens are BOUND, not OVERRIDE."""
    if not val:
        return True
    if val[0] in "{$\\":
        return True
    if "{" in val or "}" in val or "$" in val:
        return True
    if val.endswith("\\n") or "\\n" in val:
        return True
    return False


NEEDLE_BEFORE = re.compile(
    r"(?:contains|starts_with|ends_with|find|matches!)\s*\("
)


def _decode_rust_string(body: str) -> str:
    out: list[str] = []
    i = 0
    n = len(body)
    while i < n:
        if body[i] == "\\" and i + 1 < n:
            nxt = body[i + 1]
            if nxt == "\n":
                i += 2
                while i < n and body[i] in " \t":
                    i += 1
                continue
            trans = {"n": "\n", "t": "\t", "r": "\r", '"': '"', "'": "'", "\\": "\\"}
            out.append(trans.get(nxt, nxt))
            i += 2
            continue
        out.append(body[i])
        i += 1
    return "".join(out)


def iter_rs_strings(src: str) -> Iterator[tuple[int, str]]:
    """Yield (start_index, decoded content) of Rust string literals. Skip comments."""
    n = len(src)
    i = 0
    while i < n:
        ch = src[i]
        nxt = src[i + 1] if i + 1 < n else ""
        if ch == "/" and nxt == "/":
            while i < n and src[i] != "\n":
                i += 1
            continue
        if ch == "/" and nxt == "*":
            i += 2
            while i + 1 < n and not (src[i] == "*" and src[i + 1] == "/"):
                i += 1
            i = min(n, i + 2)
            continue
        if ch == "r" and nxt in ("#", '"'):
            j = i + 1
            hashes = 0
            while j < n and src[j] == "#":
                hashes += 1
                j += 1
            if j < n and src[j] == '"':
                start = j + 1
                i = start
                close = '"' + ("#" * hashes)
                while i < n and src[i : i + len(close)] != close:
                    i += 1
                yield start, src[start:i]
                i = min(n, i + len(close))
                continue
        if ch == '"':
            start = i + 1
            i += 1
            body: list[str] = []
            while i < n:
                if src[i] == "\\":
                    body.append(src[i : i + 2])
                    i += 2
                    continue
                if src[i] == '"':
                    break
                body.append(src[i])
                i += 1
            yield start, _decode_rust_string("".join(body))
            i = min(n, i + 1)
            continue
        i += 1


def clap_payloads(content: str) -> list[str]:
    """Whole string plus inner quoted argv (JSON command values)."""
    out = [content]
    for m in re.finditer(r'"((?:\\.|[^"\\])*)"', content):
        inner = _decode_rust_string(m.group(1))
        if inner and inner not in out:
            out.append(inner)
    return out


def tokenize_cmd(s: str) -> list[str]:
    tokens: list[str] = []
    i = 0
    n = len(s)
    while i < n:
        ch = s[i]
        if ch.isspace():
            i += 1
            continue
        if ch in "\"'":
            q = ch
            i += 1
            buf: list[str] = []
            while i < n and s[i] != q:
                if s[i] == "\\" and i + 1 < n:
                    i += 1
                    buf.append(s[i])
                    i += 1
                    continue
                buf.append(s[i])
                i += 1
            if i < n:
                i += 1
            tok = "".join(buf).strip()
            if tok:
                tokens.append(tok)
            continue
        buf = []
        while i < n and not s[i].isspace() and s[i] not in "\"'":
            buf.append(s[i])
            i += 1
        tok = "".join(buf)
        if tok.startswith("{") and "}" in tok:
            tokens.append(tok)
        elif tok.startswith("$"):
            tokens.append(tok)
        else:
            tok = tok.strip("[],();:")
            if tok:
                tokens.append(tok)
    return tokens


def kebab_cmd_index(tokens: list[str], kb: str) -> int | None:
    """Kebab as an invoked subcommand, not English and not --flag.

    With flags: kebab followed by --flag / {interp} / $interp, anywhere
    (shebang `{} hook-post-tool --agent cline` is an invoke at argv[2]).
    Bare omit: kebab is the last token and has at most one predecessor
    (`kizu hook-post-tool`, not `please run hook-post-tool`).
    """
    for i, t in enumerate(tokens):
        raw = t.rstrip(",;")
        base = raw.rsplit("/", 1)[-1]
        if base != kb and raw != kb:
            continue
        if raw.startswith("-"):
            continue
        if i > 0 and tokens[i - 1].startswith("-"):
            continue
        rest = tokens[i + 1 :]
        if rest and (
            rest[0].startswith("-") or rest[0].startswith("{") or rest[0].startswith("$")
        ):
            return i
        if not rest and i <= 1:
            return i
        return None
    return None


def flags_from_argv(argv: list[str]) -> dict[str, str]:
    out: dict[str, str] = {}
    i = 0
    while i < len(argv):
        t = argv[i]
        if not t.startswith("--"):
            i += 1
            continue
        body = t[2:]
        if "=" in body:
            k, v = body.split("=", 1)
            out[k] = _unquote(v)
            i += 1
            continue
        if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            out[body] = _unquote(argv[i + 1])
            i += 2
            continue
        out[body] = ""
        i += 1
    return out


def clap_call_from_flags(
    sig: Sig, field: str, flag: str, parsed: dict[str, str], path: str, line: int, role: str
) -> Call:
    if flag not in parsed:
        return Call(
            callee=sig.callee, passed={}, bound=set(), path=path, line=line, role=role
        )
    val = parsed[flag]
    if val.endswith("\\n") or val.endswith("\\t"):
        val = val[:-2]
    bound: set[str] = set()
    if clap_bound_token(val):
        passed_val = val
        bound.add(field)
    else:
        passed_val = val if val.startswith(("'", '"')) else f'"{val}"'
    return Call(
        callee=sig.callee,
        passed={field: passed_val},
        bound=bound,
        path=path,
        line=line,
        role=role,
    )


def find_clap_uses(src: str, path: str, flags: dict[str, list[Sig]]) -> list[Call]:
    """Clap TACIT is an invocation that omitted --flag, not a command-shaped line."""
    if not flags:
        return []
    role = role_of(path)
    calls: list[Call] = []
    kebabs: dict[str, list[tuple[str, str, Sig]]] = {}
    for field, sigs in flags.items():
        for sig in sigs:
            flag = sig.flag or field.replace("_", "-")
            kb = kebab(sig.callee)
            kebabs.setdefault(kb, []).append((field, flag, sig))

    for start, content in iter_rs_strings(src):
        prefix = src[max(0, start - 80) : start]
        is_needle = bool(NEEDLE_BEFORE.search(prefix))
        line_no = line_at(src, start)
        for payload in clap_payloads(content):
            tokens = tokenize_cmd(payload)
            if not tokens:
                continue
            for kb, items in kebabs.items():
                idx = kebab_cmd_index(tokens, kb)
                if idx is None:
                    continue
                argv = tokens[idx:]
                parsed = flags_from_argv(argv)
                for field, flag, sig in items:
                    if is_needle and flag not in parsed:
                        # .contains("kebab") is a mention, not an omitted-flag invoke
                        continue
                    calls.append(
                        clap_call_from_flags(
                            sig, field, flag, parsed, path, line_no, role
                        )
                    )
    return calls


