# walk / git
# ---------------------------------------------------------------------------

def lang_of(path: str) -> str | None:
    ext = Path(path).suffix.lower()
    return {
        ".swift": "swift",
        ".py": "py",
        ".ts": "ts",
        ".tsx": "ts",
        ".js": "ts",
        ".jsx": "ts",
        ".rs": "rs",
    }.get(ext)


def iter_files(root: Path) -> Iterator[Path]:
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [
            d
            for d in dirnames
            if d not in SKIP_DIRS and not d.startswith(".")
        ]
        for fn in filenames:
            p = Path(dirpath) / fn
            if p.suffix.lower() in CODE_EXTS:
                yield p


def read_text(path: Path) -> str | None:
    try:
        if path.stat().st_size > MAX_BYTES:
            return None
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None


def git(repo: str, *args: str) -> str:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"git {' '.join(args)} failed")
    return r.stdout


def git_ok(repo: str, *args: str) -> str | None:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        return None
    return r.stdout


def tree_files(repo: str, rev: str) -> list[str]:
    out = git(repo, "ls-tree", "-r", "--name-only", rev)
    files = []
    for line in out.splitlines():
        if Path(line).suffix.lower() in CODE_EXTS:
            files.append(line)
    return files


def tree_text(repo: str, rev: str, path: str) -> str | None:
    r = subprocess.run(
        ["git", "-C", repo, "show", f"{rev}:{path}"],
        capture_output=True,
    )
    if r.returncode != 0:
        return None
    if len(r.stdout) > MAX_BYTES:
        return None
    return r.stdout.decode("utf-8", errors="replace")


# ---------------------------------------------------------------------------
# harvest a tree
# ---------------------------------------------------------------------------

@dataclass
class Harvest:
    sigs: list[Sig] = field(default_factory=list)
    calls: list[Call] = field(default_factory=list)

    def merged_params(self) -> dict[str, list[Param]]:
        """Union of params per callee. A name is defaultable if any overload
        gives it a default; required-only names stay required."""
        order: dict[str, list[str]] = {}
        defs: dict[tuple[str, str], str | None] = {}
        types: dict[tuple[str, str], str | None] = {}
        idx_of: dict[tuple[str, str], int] = {}
        for s in self.sigs:
            if s.callee not in order:
                order[s.callee] = []
            for p in s.params:
                key = (s.callee, p.name)
                if p.name not in order[s.callee]:
                    order[s.callee].append(p.name)
                    idx_of[key] = p.index
                if key not in defs:
                    defs[key] = p.default
                elif defs[key] is None and p.default is not None:
                    defs[key] = p.default
                if key not in types and p.typ:
                    types[key] = p.typ
        merged: dict[str, list[Param]] = {}
        for callee, names in order.items():
            merged[callee] = [
                Param(
                    name=n,
                    default=defs[(callee, n)],
                    index=i,
                    typ=types.get((callee, n)),
                )
                for i, n in enumerate(names)
            ]
        return merged


def harvest_texts(items: list[tuple[str, str, str]]) -> Harvest:
    """items: (path, src, lang)"""
    h = Harvest()
    for path, src, lang in items:
        h.sigs.extend(extract_sigs(src, path, lang))
    merged = h.merged_params()
    callees = {s.callee for s in h.sigs if s.kind != "clap"}
    clap_flags: dict[str, list[Sig]] = {}
    sig_opens: dict[str, set[int]] = {}
    for s in h.sigs:
        if s.open_idx >= 0:
            sig_opens.setdefault(s.path, set()).add(s.open_idx)
        if s.kind == "clap" and s.params:
            clap_flags.setdefault(s.params[0].name, []).append(s)
    seen_call: set[tuple[str, str, int, tuple]] = set()
    for path, src, lang in items:
        if lang == "rs":
            for c in find_clap_uses(src, path, clap_flags):
                key = (c.callee, c.path, c.line, tuple(sorted(c.passed.items())))
                if key in seen_call:
                    continue
                seen_call.add(key)
                h.calls.append(c)
            continue
        for c in find_calls(
            src, path, lang, callees, merged, sig_opens.get(path, set())
        ):
            key = (c.callee, c.path, c.line, tuple(sorted(c.passed.items())))
            if key in seen_call:
                continue
            seen_call.add(key)
            h.calls.append(c)
    return h


def harvest_root(root: Path) -> Harvest:
    items: list[tuple[str, str, str]] = []
    for p in iter_files(root):
        lang = lang_of(str(p))
        if not lang:
            continue
        src = read_text(p)
        if src is None:
            continue
        items.append((str(p), src, lang))
    return harvest_texts(items)


def harvest_rev(repo: str, rev: str) -> Harvest:
    items: list[tuple[str, str, str]] = []
    for path in tree_files(repo, rev):
        lang = lang_of(path)
        if not lang:
            continue
        src = tree_text(repo, rev, path)
        if src is None:
            continue
        items.append((path, src, lang))
    return harvest_texts(items)


