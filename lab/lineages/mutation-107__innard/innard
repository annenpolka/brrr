# Search: first producer
# ---------------------------------------------------------------------------


@dataclass
class Hit:
    stage: int
    stream: str
    byte: int
    line: int
    col: int
    argv: str
    kind: str
    text: str
    exit: int | None = None
    path: str = ""
    nest: str | None = None
    parent_argv: str | None = None


@dataclass
class Payload:
    stage: int
    stream: str
    byte: int
    argv: str
    text: str
    relation: str
    needle_at: int = 0
    path: str = ""


@dataclass
class Piece:
    kind: str  # "from" | "glue"
    text: str
    needle_at: int
    stage: int | None = None
    stream: str | None = None
    byte: int | None = None
    argv: str | None = None
    path: str | None = None


@dataclass
class Later:
    stage: int
    argv: str
    stream: str
    kind: str
    byte: int
    path: str = ""
    nest: str | None = None


@dataclass
class Report:
    needle: str
    producer: Hit | None
    payload: Payload | None
    pieces: list[Piece] = field(default_factory=list)
    later: list[Later] = field(default_factory=list)
    tee_sim: Hit | None = None
    disagrees_with_tee: bool = False
    stages: list[StageRec] = field(default_factory=list)
    from_stdin: bool = False
    pipeline: str = ""


def locate(data: bytes, needle: bytes) -> tuple[int, int, int] | None:
    if not needle:
        return None
    off = data.find(needle)
    if off < 0:
        return None
    line = data.count(b"\n", 0, off) + 1
    prev = data.rfind(b"\n", 0, off)
    col = off - (prev + 1)
    return off, line, col


def locate_prefix_line(data: bytes, prefix: bytes) -> tuple[int, int, int, bytes] | None:
    if not prefix:
        return None
    pos = 0
    line_no = 1
    while pos <= len(data):
        nl = data.find(b"\n", pos)
        end = len(data) if nl < 0 else nl
        line = data[pos:end]
        if line.startswith(prefix) or (line + b"\n").startswith(prefix):
            return pos, line_no, 0, line
        if nl < 0:
            break
        pos = nl + 1
        line_no += 1
    return None


def _hit(rec: StageRec, stream: str, data: bytes, needle: bytes, kind: str) -> Hit | None:
    loc = locate(data, needle)
    if loc is None:
        return None
    off, line, col = loc
    try:
        text = needle.decode("utf-8")
    except UnicodeDecodeError:
        text = needle.decode("utf-8", "replace")
    return Hit(
        stage=rec.i,
        stream=stream,
        byte=off,
        line=line,
        col=col,
        argv=rec.argv,
        kind=kind,
        text=text,
        exit=rec.exit,
        path=rec.path or str(rec.i),
        nest=rec.nest,
        parent_argv=rec.parent_argv,
    )


def first_exact(
    recs: list[StageRec],
    needle: bytes,
    *,
    streams: Iterable[str] = ("stderr", "stdout"),
    use_piped: bool = False,
) -> Hit | None:
    for rec in recs:
        if use_piped:
            h = _hit(rec, "piped", rec.piped, needle, "tee")
            if h:
                return h
            continue
        for stream in streams:
            data = rec.stderr if stream == "stderr" else rec.stdout
            h = _hit(rec, stream, data, needle, "mint")
            if h:
                return h
    return None


def first_prefix(recs: list[StageRec], prefix: bytes) -> tuple[Hit | None, bytes]:
    for rec in recs:
        for stream, data in (("stderr", rec.stderr), ("stdout", rec.stdout)):
            found = locate_prefix_line(data, prefix)
            if found is None:
                continue
            off, line, col, full = found
            try:
                text = full.decode("utf-8")
            except UnicodeDecodeError:
                text = full.decode("utf-8", "replace")
            return (
                Hit(
                    stage=rec.i,
                    stream=stream,
                    byte=off,
                    line=line,
                    col=col,
                    argv=rec.argv,
                    kind="mint",
                    text=text,
                    exit=rec.exit,
                    path=rec.path or str(rec.i),
                    nest=rec.nest,
                    parent_argv=rec.parent_argv,
                ),
                full,
            )
    return None, prefix


def _in_stdin(needle: bytes, stdin_data: bytes | None) -> bool:
    return bool(stdin_data and needle and needle in stdin_data)


def classify_kind(
    recs: list[StageRec],
    hit: Hit,
    needle: bytes,
    stdin_data: bytes | None,
) -> str:
    if hit.stage < 0:
        return "stdin"
    if hit.stage == 0:
        if hit.stream == "stderr":
            return "mint"
        if _in_stdin(needle, stdin_data):
            return "carry"
        return "mint"
    prev = recs[hit.stage - 1]
    if needle in prev.piped or needle in prev.stdout:
        return "carry"
    return "mint"


def _hay(recs: list[StageRec], before: int, stdin_data: bytes | None) -> list[tuple[int, str, bytes, str, str]]:
    hay: list[tuple[int, str, bytes, str, str]] = []
    if stdin_data:
        hay.append((-1, "stdin", stdin_data, "<stdin>", "-1"))
    for rec in recs:
        if rec.i >= before:
            break
        hay.append((rec.i, "stderr", rec.stderr, rec.argv, rec.path or str(rec.i)))
        hay.append((rec.i, "stdout", rec.stdout, rec.argv, rec.path or str(rec.i)))
    return hay


def _b2s(b: bytes) -> str:
    try:
        return b.decode("utf-8")
    except UnicodeDecodeError:
        return b.decode("utf-8", "replace")


def cover_pieces(
    recs: list[StageRec],
    needle: bytes,
    before: int,
    stdin_data: bytes | None,
    min_len: int,
) -> list[Piece]:
    if len(needle) < 2:
        return []
    hay = _hay(recs, before, stdin_data)
    if not hay:
        return []
    min_len = max(1, min(min_len, len(needle) - 1))

    def search(frag: bytes) -> tuple[int, str, int, str, str] | None:
        for stage, stream, data, argv, path in hay:
            off = data.find(frag)
            if off >= 0:
                return stage, stream, off, argv, path
        return None

    pieces: list[Piece] = []
    p = 0
    glue_at: int | None = None
    while p < len(needle):
        found: tuple[int, str, int, str, str] | None = None
        frag = b""
        for L in range(len(needle) - p, min_len - 1, -1):
            frag = needle[p : p + L]
            found = search(frag)
            if found:
                break
        if found is None:
            if glue_at is None:
                glue_at = p
            p += 1
            continue
        if glue_at is not None:
            pieces.append(Piece("glue", _b2s(needle[glue_at:p]), glue_at))
            glue_at = None
        st, stream, off, argv, path = found
        pieces.append(
            Piece("from", _b2s(frag), p, stage=st, stream=stream, byte=off, argv=argv, path=path)
        )
        p += len(frag)
    if glue_at is not None:
        pieces.append(Piece("glue", _b2s(needle[glue_at:]), glue_at))
    if not any(x.kind == "from" for x in pieces):
        return []
    return pieces


def pieces_to_payload(pieces: list[Piece]) -> Payload | None:
    froms = [x for x in pieces if x.kind == "from"]
    if not froms:
        return None
    best = max(froms, key=lambda x: len(x.text))
    relation = "piece" if len(froms) > 1 else "suffix"
    return Payload(
        stage=best.stage if best.stage is not None else -1,
        stream=best.stream or "",
        byte=best.byte or 0,
        argv=best.argv or "",
        text=best.text,
        relation=relation,
        needle_at=best.needle_at,
        path=best.path or "",
    )


def _path_wraps(parent: str, child: str) -> bool:
    """True if parent is the outer stage that contains child (e.g. '0' wraps '0.1')."""
    if not parent or not child:
        return False
    return child == parent or child.startswith(parent + ".")


def later_hits(recs: list[StageRec], needle: bytes, producer: Hit) -> list[Later]:
    out: list[Later] = []
    for rec in recs:
        if rec.i < producer.stage:
            continue
        for stream, data in (("stderr", rec.stderr), ("stdout", rec.stdout)):
            if rec.i == producer.stage and stream == producer.stream:
                continue
            loc = locate(data, needle)
            if loc is None:
                continue
            kind = "carry"
            if rec.i == producer.stage:
                kind = "also"
            elif needle not in (recs[rec.i - 1].piped if rec.i else b""):
                if rec.i > 0 and needle not in recs[rec.i - 1].stdout:
                    kind = "remint"
                    # $() / bash -c / <() do not capture stderr. The wrap's
                    # stderr is the inner fd, not a second mint.
                    if (
                        stream == "stderr"
                        and producer.stream == "stderr"
                        and producer.nest
                        and rec.nest is None
                        and _path_wraps(rec.path or str(rec.i), producer.path)
                    ):
                        kind = "leak"
            out.append(
                Later(
                    rec.i,
                    rec.argv,
                    stream,
                    kind,
                    loc[0],
                    path=rec.path or str(rec.i),
                    nest=rec.nest,
                )
            )
    return out


def analyze(
    recs: list[StageRec],
    needle: bytes,
    *,
    stdin_data: bytes | None = None,
    prefix: bool = False,
    min_payload: int = 4,
    pipeline: str = "",
) -> Report:
    used_needle = needle
    producer: Hit | None
    if prefix:
        producer, used_needle = first_prefix(recs, needle)
        needle = used_needle if producer else needle
    else:
        producer = first_exact(recs, needle)

    # Skeptic tee is the *user's* pipe, not the instrumented inner $() dumps.
    outer = [r for r in recs if r.nest is None]
    tee = first_exact(outer if outer else recs, needle if not prefix else used_needle, use_piped=True)
    payload = None
    pieces: list[Piece] = []
    from_stdin = False
    if producer is not None:
        producer.kind = classify_kind(recs, producer, needle, stdin_data)
        if producer.kind == "carry" and producer.stage == 0 and _in_stdin(needle, stdin_data):
            from_stdin = True
        if producer.kind == "mint":
            pieces = cover_pieces(recs, needle, producer.stage, stdin_data, min_payload)
            payload = pieces_to_payload(pieces)
            if payload is not None:
                producer.kind = "wrap"

    later = later_hits(recs, needle, producer) if producer else []
    disagrees = False
    if producer is None:
        disagrees = tee is not None
    elif tee is None:
        disagrees = True
    elif tee.path != producer.path and tee.stage != producer.stage:
        disagrees = True
    elif producer.kind == "wrap":
        disagrees = True
    elif producer.nest is not None:
        disagrees = True

    try:
        needle_s = (used_needle if prefix and producer else needle).decode("utf-8")
    except UnicodeDecodeError:
        needle_s = needle.decode("utf-8", "replace")

    return Report(
        needle=needle_s,
        producer=producer,
        payload=payload,
        pieces=pieces,
        later=later,
        tee_sim=tee,
        disagrees_with_tee=disagrees,
        stages=recs,
        from_stdin=from_stdin,
        pipeline=pipeline,
    )


def needle_from_final(recs: list[StageRec], line: int | None, span: tuple[int, int] | None) -> bytes:
    if not recs:
        raise ValueError("no stages")
    outers = [r for r in recs if r.nest is None]
    last = outers[-1] if outers else recs[-1]
    data = last.stdout
    if last.merge_stderr:
        data = last.piped or (last.stdout + last.stderr)
    if line is not None:
        lines = data.split(b"\n")
        if lines and lines[-1] == b"":
            lines = lines[:-1]
        idx = line if line >= 0 else len(lines) + line
        if line >= 0:
            idx = line - 1
        if idx < 0 or idx >= len(lines):
            raise ValueError(f"no line {line} in final stdout ({len(lines)} lines)")
        return lines[idx]
    if span is not None:
        a, b = span
        if a < 0:
            a = len(data) + a
        if b < 0:
            b = len(data) + b
        if a < 0 or b > len(data) or a >= b:
            raise ValueError(f"span {span} out of range for {len(data)} final bytes")
        return data[a:b]
    raise ValueError("need --line or --span")


# ---------------------------------------------------------------------------
# Format
# ---------------------------------------------------------------------------


def _short(s: str, n: int = 80) -> str:
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1] + "…"


def _stage_label(path: str, i: int) -> str:
    return path if path else str(i)


def format_human(rep: Report) -> str:
    lines: list[str] = []
    if rep.producer is None:
        lines.append("INNARD  NONE")
        lines.append(f"        needle  {rep.needle!r}")
        if rep.tee_sim is None:
            lines.append("        tee     miss (piped dumps do not contain it either)")
        else:
            lines.append(
                f"        tee     stage {_stage_label(rep.tee_sim.path, rep.tee_sim.stage)}  {_short(rep.tee_sim.argv)}"
            )
        return "\n".join(lines) + "\n"
    p = rep.producer
    sl = _stage_label(p.path, p.stage)
    lines.append(f"INNARD  {p.kind.upper()}  stage {sl}  {p.stream}  {_short(p.argv)}")
    if p.nest:
        who = _short(p.parent_argv or "")
        lines.append(f"        nest    {p.nest} of  {who}")
    lines.append(f"        needle  {rep.needle!r}")
    exit_s = "" if p.exit is None else f"  exit {p.exit}"
    lines.append(f"        at      byte {p.byte}  line {p.line}  col {p.col}{exit_s}")
    if rep.from_stdin:
        lines.append("        from    <stdin>  (stage carried it; did not mint)")
    if rep.pieces:
        lines.append("        pieces")
        for pc in rep.pieces:
            if pc.kind == "glue":
                lines.append(f"                glue    {pc.text!r}  (needle byte {pc.needle_at})")
            else:
                who = (
                    "<stdin>"
                    if (pc.stage is not None and pc.stage < 0)
                    else f"stage {pc.path or pc.stage}  {pc.stream}  {_short(pc.argv or '')}"
                )
                lines.append(f"                from    {who}")
                lines.append(
                    f"                        {pc.text!r}  byte {pc.byte}  (needle byte {pc.needle_at})"
                )
    elif rep.payload is not None:
        pl = rep.payload
        who = "<stdin>" if pl.stage < 0 else f"stage {pl.path or pl.stage}  {pl.stream}  {_short(pl.argv)}"
        lines.append(f"        payload {pl.relation}  {who}")
        lines.append(f"                {pl.text!r}  byte {pl.byte}")
    if rep.tee_sim is None:
        lines.append("        tee     MISS  (unpiped stderr, or wrap not yet exact)")
    elif p.kind == "wrap" or p.nest:
        lines.append(
            f"        tee     stage {_stage_label(rep.tee_sim.path, rep.tee_sim.stage)}  piped  {_short(rep.tee_sim.argv)}  (first exact on the outer pipe)"
        )
    elif rep.disagrees_with_tee:
        lines.append(
            f"        tee     stage {_stage_label(rep.tee_sim.path, rep.tee_sim.stage)}  piped  {_short(rep.tee_sim.argv)}  (different stage)"
        )
    else:
        lines.append(
            f"        tee     stage {_stage_label(rep.tee_sim.path, rep.tee_sim.stage)}  piped  (same stage)"
        )
    if p.stream == "stderr" and (rep.tee_sim is None or rep.tee_sim.path != p.path):
        lines.append("        note    tee on the pipe never sees unpiped stderr")
    if p.kind == "wrap":
        lines.append("        note    exact needle is minted by a transform; pieces lived earlier")
    if p.nest:
        lines.append("        note    first-producer is the inner stage, not the outer wrap")
    if p.nest and p.stream == "stderr":
        lines.append(
            "        note    $() captures stdout only; inner stderr never entered the substitution"
        )
    if any(L.kind == "leak" for L in rep.later):
        lines.append("        note    later wrap stderr is fd inheritance, not a remint")
    if rep.later:
        lines.append("        later")
        for L in rep.later:
            nest = f"  {L.nest}" if L.nest else ""
            lines.append(
                f"                stage {_stage_label(L.path, L.stage)}  {L.kind}  {L.stream}  {_short(L.argv)}{nest}"
            )
    return "\n".join(lines) + "\n"


def format_json(rep: Report) -> str:
    def hit(h: Hit | None) -> dict[str, Any] | None:
        if h is None:
            return None
        return {
            "stage": h.stage,
            "path": h.path or str(h.stage),
            "stream": h.stream,
            "byte": h.byte,
            "line": h.line,
            "col": h.col,
            "argv": h.argv,
            "kind": h.kind,
            "text": h.text,
            "exit": h.exit,
            "nest": h.nest,
            "parent_argv": h.parent_argv,
        }

    doc = {
        "needle": rep.needle,
        "pipeline": rep.pipeline,
        "producer": hit(rep.producer),
        "payload": None
        if rep.payload is None
        else {
            "stage": rep.payload.stage,
            "path": rep.payload.path,
            "stream": rep.payload.stream,
            "byte": rep.payload.byte,
            "argv": rep.payload.argv,
            "text": rep.payload.text,
            "relation": rep.payload.relation,
            "needle_at": rep.payload.needle_at,
        },
        "pieces": [
            {
                "kind": pc.kind,
                "text": pc.text,
                "needle_at": pc.needle_at,
                "stage": pc.stage,
                "path": pc.path,
                "stream": pc.stream,
                "byte": pc.byte,
                "argv": pc.argv,
            }
            for pc in rep.pieces
        ],
        "from_stdin": rep.from_stdin,
        "later": [
            {
                "stage": L.stage,
                "path": L.path,
                "argv": L.argv,
                "stream": L.stream,
                "kind": L.kind,
                "byte": L.byte,
                "nest": L.nest,
            }
            for L in rep.later
        ],
        "tee_sim": hit(rep.tee_sim),
        "disagrees_with_tee": rep.disagrees_with_tee,
        "stages": [
            {
                "i": s.i,
                "path": s.path or str(s.i),
                "argv": s.argv,
                "merge_stderr": s.merge_stderr,
                "nest": s.nest,
                "parent_argv": s.parent_argv,
                "exit": s.exit,
                "stdout_bytes": len(s.stdout),
                "stderr_bytes": len(s.stderr),
                "piped_bytes": len(s.piped),
            }
            for s in rep.stages
        ],
    }
    return json.dumps(doc, indent=2, ensure_ascii=False) + "\n"


def format_tsv(rep: Report) -> str:
    cols = ["kind", "path", "stage", "stream", "nest", "byte", "line", "col", "exit", "argv", "needle"]
    if rep.producer is None:
        return "\t".join(cols) + "\n" + "\t".join(["NONE", "", "", "", "", "", "", "", "", "", rep.needle]) + "\n"
    p = rep.producer
    row = [
        p.kind.upper(),
        p.path or str(p.stage),
        str(p.stage),
        p.stream,
        p.nest or "",
        str(p.byte),
        str(p.line),
        str(p.col),
        "" if p.exit is None else str(p.exit),
        p.argv.replace("\t", " "),
        rep.needle.replace("\t", " "),
    ]
    return "\t".join(cols) + "\n" + "\t".join(row) + "\n"


# ---------------------------------------------------------------------------
# Selftest
# ---------------------------------------------------------------------------


def _assert(cond: bool, msg: str) -> None:
    if not cond:
        raise AssertionError(msg)


def selftest() -> int:
    n_ok = 0

    def check(name: str, fn: Any) -> None:
        nonlocal n_ok
        fn()
        print(f"  ok  {name}")
        n_ok += 1

    def t_split_quotes() -> None:
        st = split_pipeline("awk 'BEGIN{print \"a|b\"}' | cat")
        _assert(len(st) == 2, st)
        _assert("a|b" in st[0][0] or "a|b" in st[0][0].replace("\\", ""), st)
        _assert(st[1][0] == "cat", st)

    def t_split_or_and_amp() -> None:
        st = split_pipeline("false || echo x | cat")
        _assert(len(st) == 2, st)
        _assert("||" in st[0][0], st)
        st = split_pipeline("python3 -c 'import sys; sys.stderr.write(\"e\\n\")' |& cat")
        _assert(len(st) == 2 and st[0][1] is True, st)

    def t_split_2gt1_trailing() -> None:
        st = split_pipeline("git status 2>&1 | rg foo")
        _assert(len(st) == 2, st)
        _assert(st[0] == ("git status", True), st)
        _assert(st[1] == ("rg foo", False), st)

    def t_split_2gt1_mid() -> None:
        st = split_pipeline("git -C /tmp 2>&1 status | cat")
        _assert(len(st) == 2, st)
        _assert(st[0] == ("git -C /tmp status", True), st)
        st = split_pipeline("git 2>&1 status | cat")
        _assert(st[0] == ("git status", True), st)
        st = peel_merge_stderr("echo $(git 2>&1 status)")
        _assert(st[1] is False, st)
        _assert("2>&1" in st[0], st)

    def t_split_nested() -> None:
