# CLI
# ---------------------------------------------------------------------------

USAGE = """innard — earliest stage that already contains this needle, including inner $().

Not leftover-name. Not a wait-source (knot). Not facet. Given a pipeline and a
needle, emit the first stage whose stdout or stderr already has those bytes —
descending into $(), backticks, <(), and bash -c instead of naming the wrap.
Mid-command 2>&1 is a stderr merge at that stage, not a trailing-token peel.

  innard --needle 'Kizu' --sh 'echo $(printf kizu | tr k K) | cat'
  innard --needle 'fatal: not a git repository' --sh 'git -C /tmp 2>&1 status | cat'
  innard --needle 'fatal: not a git repository' --sh 'git -C /tmp status | cat'
  innard --needle STR --trace run.json

tee on the outer pipe is the skeptic. It cannot see unpiped stderr, and an
exact grep of those dumps names the wrap, not the inner first-producer.
"""


def _parse_span(s: str) -> tuple[int, int]:
    if ":" not in s:
        raise ValueError("--span START:END")
    a, b = s.split(":", 1)
    return int(a), int(b)


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="innard",
        description=USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--version", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--needle", "-n", help="bytes/text to locate (UTF-8)")
    p.add_argument("--line", type=int, help="1-based line of final stdout as needle (negative from end)")
    p.add_argument("--span", help="START:END byte slice of final stdout as needle")
    p.add_argument("--prefix", action="store_true", help="match a line that starts with --needle")
    p.add_argument("--run", action="store_true", help="run remaining args as a pipeline")
    p.add_argument("--sh", dest="sh", help="pipeline string (honest | cuts)")
    p.add_argument("--trace", help="JSON trace file or directory of N.argv/N.stdout/N.stderr")
    p.add_argument("--save", help="write JSON trace after --run")
    p.add_argument("--json", action="store_true", dest="json_out")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("-C", "--cwd", default=None)
    p.add_argument("--timeout", type=float, default=60.0)
    p.add_argument("--passthrough", "-p", action="store_true", help="original stdout still flows; report on stderr")
    p.add_argument("--stdin", dest="read_stdin", action="store_true", help="feed innard's stdin to stage 0")
    p.add_argument("--quiet", "-q", action="store_true", help="do not forward child stderr (still recorded)")
    p.add_argument("--min-payload", type=int, default=4)
    p.add_argument("rest", nargs=argparse.REMAINDER)
    return p.parse_args(argv)


def _pipeline_from(ns: argparse.Namespace) -> tuple[str, list[tuple[str, bool]]]:
    rest = list(ns.rest or [])
    if rest[:1] == ["--"]:
        rest = rest[1:]
    if ns.sh is not None:
        src = ns.sh
        return src, split_pipeline(src)
    if rest:
        plus = split_plus(rest)
        if plus is not None:
            specs = []
            for cmd in plus:
                cmd2, merge = peel_merge_stderr(cmd)
                specs.append((cmd2, merge))
            return " | ".join(plus), specs
        src = " ".join(rest)
        return src, split_pipeline(src)
    raise SystemExit("innard: provide --sh PIPELINE, --run -- PIPELINE, or stages separated by +")


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    ns = parse_args(argv)
    if ns.version:
        print(f"innard {VERSION}")
        return 0
    if ns.selftest:
        try:
            return selftest()
        except AssertionError as e:
            print(f"selftest FAIL: {e}", file=sys.stderr)
            return 1

    stdin_data: bytes | None = None
    recs: list[StageRec] | None = None
    pipeline = ""

    rest = list(ns.rest or [])
    if rest[:1] == ["--"]:
        rest = rest[1:]

    def _looks_like_trace(path: str) -> bool:
        if path == "-" or os.path.isdir(path):
            return True
        if not os.path.isfile(path):
            return False
        return path.endswith(".json") or path.endswith(".trace")

    try:
        if ns.trace:
            pipeline, recs, stdin_data = load_trace(ns.trace)
        elif ns.sh is not None or ns.run or (rest and ("|" in " ".join(rest) or "+" in rest)):
            pipeline, specs = _pipeline_from(ns)
            if ns.read_stdin:
                stdin_data = sys.stdin.buffer.read()
            recs = run_pipeline_tree(
                specs,
                cwd=ns.cwd,
                timeout=None if ns.timeout <= 0 else ns.timeout,
                passthrough=ns.passthrough,
                stdin_data=stdin_data,
                forward_stderr=not ns.quiet,
            )
        elif rest and _looks_like_trace(rest[0]):
            pipeline, recs, stdin_data = load_trace(rest[0])
        elif rest:
            pipeline, specs = _pipeline_from(ns)
            if ns.read_stdin:
                stdin_data = sys.stdin.buffer.read()
            recs = run_pipeline_tree(
                specs,
                cwd=ns.cwd,
                timeout=None if ns.timeout <= 0 else ns.timeout,
                passthrough=ns.passthrough,
                stdin_data=stdin_data,
                forward_stderr=not ns.quiet,
            )
        else:
            print("innard: need --run/--sh, --trace FILE, or --selftest", file=sys.stderr)
            print(USAGE, file=sys.stderr)
            return 2
    except TimeoutError as e:
        print(f"innard: {e}", file=sys.stderr)
        return 2
    except (ValueError, OSError, json.JSONDecodeError) as e:
        print(f"innard: {e}", file=sys.stderr)
        return 2

    if recs is None:
        print("innard: no stages", file=sys.stderr)
        return 2

    if ns.save:
        doc = recs_to_json(pipeline, recs, stdin_data)
        if ns.save == "-":
            if not (ns.json_out or ns.needle or ns.line is not None or ns.span):
                json.dump(doc, sys.stdout, indent=2, ensure_ascii=False)
                sys.stdout.write("\n")
                return 0
        else:
            with open(ns.save, "w", encoding="utf-8") as f:
                json.dump(doc, f, indent=2, ensure_ascii=False)
                f.write("\n")

    if ns.needle is None and ns.line is None and ns.span is None:
        if ns.save:
            return 0
        print("innard: provide --needle, --line, or --span", file=sys.stderr)
        return 2

    try:
        if ns.needle is not None:
            needle = ns.needle.encode("utf-8")
            if b"\x00" in needle:
                print("innard: embedded NUL in --needle (use --span or a trace)", file=sys.stderr)
                return 2
        else:
            span = _parse_span(ns.span) if ns.span else None
            needle = needle_from_final(recs, ns.line, span)
    except ValueError as e:
        print(f"innard: {e}", file=sys.stderr)
        return 2

    if not needle:
        print("innard: empty needle", file=sys.stderr)
        return 2

    rep = analyze(
        recs,
        needle,
        stdin_data=stdin_data,
        prefix=ns.prefix,
        min_payload=ns.min_payload,
        pipeline=pipeline,
    )

    out = format_json(rep) if ns.json_out else (format_tsv(rep) if ns.tsv else format_human(rep))
    if ns.passthrough:
        sys.stderr.write(out)
    else:
        sys.stdout.write(out)
    return 0 if rep.producer is not None else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except OSError:
            pass
        sys.exit(1)
