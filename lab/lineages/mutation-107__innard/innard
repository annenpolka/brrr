import subprocess
import sys
import threading
import time
from dataclasses import dataclass, field
from typing import Any, BinaryIO, Iterable

VERSION = "0.2"

SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}

# ---------------------------------------------------------------------------
# Quote / nest walker
# ---------------------------------------------------------------------------


class Walker:
    """Single-pass shell-ish scanner. Tracks quotes, $(), ${}, (), ``."""

    def __init__(self, s: str) -> None:
        self.s = s
        self.n = len(s)
        self.i = 0
        self.quote: str | None = None
        self.paren = 0
        self.brace = 0
        self.backtick = False

    def peek(self, k: int = 1) -> str:
        j = self.i + k
        return self.s[j] if j < self.n else ""

    def at(self) -> str:
        return self.s[self.i] if self.i < self.n else ""

    def nested(self) -> bool:
        return bool(self.paren or self.brace or self.backtick)

    def step_quoted(self) -> str | None:
        """Consume one quoted/backtick char. Returns consumed text, or None if not in quote."""
        s, i, n = self.s, self.i, self.n
        if self.quote:
            c = s[i]
            if self.quote == "'" and c == "'":
                self.quote = None
                self.i += 1
                return c
            if self.quote == '"':
                if c == "\\" and i + 1 < n:
                    self.i += 2
                    return s[i : i + 2]
                if c == '"':
                    self.quote = None
                    self.i += 1
                    return c
            self.i += 1
            return c
        if self.backtick:
            c = s[i]
            if c == "\\" and i + 1 < n:
                self.i += 2
                return s[i : i + 2]
            if c == "`":
                self.backtick = False
                self.i += 1
                return c
            self.i += 1
            return c
        return None

    def open_token(self) -> str | None:
        """If at an opener, consume it and update depth. Else None."""
        s, i = self.s, self.i
        c = s[i]
        if c in "'\"":
            self.quote = c
            self.i += 1
            return c
        if c == "`":
            self.backtick = True
            self.i += 1
            return c
        if c == "$" and self.peek() == "(":
            self.paren += 1
            self.i += 2
            return "$("
        if c == "$" and self.peek() == "{":
            self.brace += 1
            self.i += 2
            return "${"
        if c == "(":
            self.paren += 1
            self.i += 1
            return "("
        if c == ")" and self.paren:
            self.paren -= 1
            self.i += 1
            return ")"
        if c == "{":
            self.brace += 1
            self.i += 1
            return "{"
        if c == "}" and self.brace:
            self.brace -= 1
            self.i += 1
            return "}"
        return None


def _is_2gt1_at(s: str, i: int) -> bool:
    """Unquoted 2>&1 token: start/whitespace/;|&( before, end/whitespace/;|&) after."""
    if s[i : i + 4] != "2>&1":
        return False
    if i > 0 and s[i - 1] not in " \t\n;|&(":
        return False
    if i + 4 < len(s) and s[i + 4] not in " \t\n;|&)":
        return False
    return True


def peel_merge_stderr(cmd: str) -> tuple[str, bool]:
    """Peel every top-level unquoted `2>&1`. Mid-command counts. Inside $() does not."""
    s = cmd
    n = len(s)
    merge = False
    out: list[str] = []
    w = Walker(s)
    while w.i < n:
        q = w.step_quoted()
        if q is not None:
            out.append(q)
            continue
        if w.paren == 0 and w.brace == 0 and _is_2gt1_at(s, w.i):
            merge = True
            w.i += 4
            continue
        tok = w.open_token()
        if tok is not None:
            out.append(tok)
            continue
        out.append(s[w.i])
        w.i += 1
    cleaned = re.sub(r"[ \t]{2,}", " ", "".join(out)).strip()
    return cleaned, merge


def split_pipeline(src: str) -> list[tuple[str, bool]]:
    """Cut on top-level `|` and `|&`. Quoted `|`, `||`, and `|` inside $() ${} () `` { } stay."""
    s = src.strip()
    if not s:
        raise ValueError("empty pipeline")
    stages: list[tuple[str, bool]] = []
    buf: list[str] = []
    w = Walker(s)
    n = w.n

    while w.i < n:
        q = w.step_quoted()
        if q is not None:
            buf.append(q)
            continue
        if w.paren == 0 and w.brace == 0 and w.at() == "|":
            nxt = w.peek()
            if nxt == "|":
                buf.append("||")
                w.i += 2
                continue
            cmd = "".join(buf).strip()
            if not cmd:
                raise ValueError("empty pipeline stage")
            if nxt == "&":
                stages.append((cmd, True))
                buf = []
                w.i += 2
                continue
            stages.append((cmd, False))
            buf = []
            w.i += 1
            continue
        tok = w.open_token()
        if tok is not None:
            buf.append(tok)
            continue
        buf.append(s[w.i])
        w.i += 1

    if w.quote:
        raise ValueError("unclosed quote in pipeline")
    if w.backtick:
        raise ValueError("unclosed backtick in pipeline")
    cmd = "".join(buf).strip()
    if cmd:
        stages.append((cmd, False))
    if not stages:
        raise ValueError("empty pipeline")

    out: list[tuple[str, bool]] = []
    for cmd, amp in stages:
        cmd2, merge = peel_merge_stderr(cmd)
        if not cmd2:
            raise ValueError("empty pipeline stage after peeling 2>&1")
        out.append((cmd2, amp or merge))
    return out


def split_plus(args: list[str]) -> list[str] | None:
    if "+" not in args:
        return None
    stages: list[str] = []
    cur: list[str] = []
    for a in args:
        if a == "+":
            cmd = " ".join(cur).strip()
            if not cmd:
                raise ValueError("empty + stage")
            stages.append(cmd)
            cur = []
        else:
            cur.append(a)
    cmd = " ".join(cur).strip()
    if not cmd:
        raise ValueError("empty + stage")
    stages.append(cmd)
    return stages


# ---------------------------------------------------------------------------
# Inner pipelines: $()  ` `  <()  bash -c  { }
# ---------------------------------------------------------------------------


def _match_paren(s: str, open_at: int) -> int:
    """Index of `(` at open_at; return index of matching `)` or -1."""
    depth = 0
    quote: str | None = None
    i = open_at
    n = len(s)
    while i < n:
        c = s[i]
        if quote:
            if quote == "'" and c == "'":
                quote = None
            elif quote == '"':
                if c == "\\" and i + 1 < n:
                    i += 2
                    continue
                if c == '"':
                    quote = None
            i += 1
            continue
        if c in "'\"":
            quote = c
            i += 1
            continue
        if c == "(":
            depth += 1
            i += 1
            continue
        if c == ")":
            depth -= 1
            if depth == 0:
                return i
            i += 1
            continue
        i += 1
    return -1


def _match_backtick(s: str, open_at: int) -> int:
    i = open_at + 1
    n = len(s)
    while i < n:
        if s[i] == "\\" and i + 1 < n:
            i += 2
            continue
        if s[i] == "`":
            return i
        i += 1
    return -1


def find_subs(cmd: str) -> list[tuple[str, str]]:
    """Top-level $(), backticks, <(), >(). $() also inside double quotes. Not $(( ))."""
    s = cmd
    n = len(s)
    found: list[tuple[str, str]] = []
    quote: str | None = None
    i = 0
    while i < n:
        c = s[i]
        if quote == "'":
            if c == "'":
                quote = None
            i += 1
            continue
        if quote == '"':
            if c == "\\" and i + 1 < n:
                i += 2
                continue
            if c == '"':
                quote = None
                i += 1
                continue
            if c == "$" and i + 1 < n and s[i + 1] == "(" and not (
                i + 2 < n and s[i + 2] == "("
            ):
                close = _match_paren(s, i + 1)
                if close < 0:
                    break
                found.append(("$()", s[i + 2 : close]))
                i = close + 1
                continue
            if c == "`":
                close = _match_backtick(s, i)
                if close < 0:
                    break
                found.append(("` `", s[i + 1 : close]))
                i = close + 1
                continue
            i += 1
            continue
        if c in "'\"":
            quote = c
            i += 1
            continue
        if c == "$" and i + 1 < n and s[i + 1] == "(":
            if i + 2 < n and s[i + 2] == "(":
                close = _match_paren(s, i + 1)
                i = close + 1 if close >= 0 else n
                continue
            close = _match_paren(s, i + 1)
            if close < 0:
                break
            found.append(("$()", s[i + 2 : close]))
            i = close + 1
            continue
        if c == "`":
            close = _match_backtick(s, i)
            if close < 0:
                break
            found.append(("` `", s[i + 1 : close]))
            i = close + 1
            continue
        if c in "<>" and i + 1 < n and s[i + 1] == "(":
            close = _match_paren(s, i + 1)
            if close < 0:
                break
            kind = "<()" if c == "<" else ">()"
            found.append((kind, s[i + 2 : close]))
            i = close + 1
            continue
        i += 1
    return [(k, inner.strip()) for k, inner in found if inner.strip()]


def tokenize(s: str) -> list[str]:
    """Quote-aware whitespace split. Surrounding quotes stripped from each token."""
    out: list[str] = []
    buf: list[str] = []
    quote: str | None = None
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if quote:
            if quote == "'" and c == "'":
                quote = None
                i += 1
                continue
            if quote == '"':
                if c == "\\" and i + 1 < n:
                    buf.append(s[i + 1])
                    i += 2
                    continue
                if c == '"':
                    quote = None
                    i += 1
                    continue
            buf.append(c)
            i += 1
            continue
        if c in "'\"":
            quote = c
            i += 1
            continue
        if c in " \t\n":
            if buf:
                out.append("".join(buf))
                buf = []
            i += 1
            continue
        buf.append(c)
        i += 1
    if buf:
        out.append("".join(buf))
    return out


def extract_shell_c(cmd: str) -> str | None:
    """If this stage *is* `bash -c '…'` (or sh/zsh -lc), return the -c script."""
    tokens = tokenize(cmd)
    i = 0
    while i < len(tokens) and "=" in tokens[i] and not tokens[i].startswith("=") and not tokens[i].startswith("-"):
        i += 1
    if i >= len(tokens):
        return None
    comm = os.path.basename(tokens[i])
    if comm not in SHELLS:
        return None
    i += 1
    while i < len(tokens):
        t = tokens[i]
        if t == "-c":
            return tokens[i + 1] if i + 1 < len(tokens) else None
        if t.startswith("-") and not t.startswith("--") and "c" in t[1:]:
            return tokens[i + 1] if i + 1 < len(tokens) else None
        if t.startswith("-"):
            i += 1
            continue
        break
    return None


def _balanced_group(s: str, open_ch: str, close_ch: str) -> int | None:
    """If s starts with open_ch, return index of matching close at top level, else None."""
    if not s or s[0] != open_ch:
        return None
    depth = 0
    quote: str | None = None
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if quote:
            if quote == "'" and c == "'":
                quote = None
            elif quote == '"':
                if c == "\\" and i + 1 < n:
                    i += 2
                    continue
                if c == '"':
                    quote = None
            i += 1
            continue
        if c in "'\"":
            quote = c
            i += 1
            continue
        if c == open_ch:
            depth += 1
        elif c == close_ch:
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return None


def extract_group(cmd: str) -> tuple[str, str] | None:
    """Whole-stage `{ cmd; }` or `( cmd )`. Not the product — just so `{ }` is not three syntax errors."""
    s = cmd.strip()
    close = _balanced_group(s, "{", "}")
    if close is not None and s[close + 1 :].strip() == "":
        inner = s[1:close].strip()
        if inner.endswith(";"):
            inner = inner[:-1].strip()
        if inner:
            return ("{ }", inner)
    close = _balanced_group(s, "(", ")")
    if close is not None and s[close + 1 :].strip() == "":
        inner = s[1:close].strip()
        if inner:
            return ("( )", inner)
    return None


def extract_inners(cmd: str) -> list[tuple[str, str]]:
    """Inner pipelines of one stage. Prefer whole-group, then bash -c, then $() / <()."""
    g = extract_group(cmd)
    if g is not None:
        return [g]
    sc = extract_shell_c(cmd)
    if sc is not None:
        return [("bash -c", sc)]
    return find_subs(cmd)


# ---------------------------------------------------------------------------
# Run / record
# ---------------------------------------------------------------------------


@dataclass
class StageRec:
    i: int
    argv: str
    merge_stderr: bool
    stdout: bytes = b""
    stderr: bytes = b""
    piped: bytes = b""
    exit: int | None = None
    duration_s: float = 0.0
    path: str = ""
    nest: str | None = None
    parent_argv: str | None = None


class _Closer:
    def __init__(self, fp: BinaryIO | None, n: int) -> None:
        self.fp = fp
        self.n = n
        self.lock = threading.Lock()

    def done(self) -> None:
        with self.lock:
            self.n -= 1
            if self.n <= 0 and self.fp is not None:
                try:
                    self.fp.close()
                except OSError:
                    pass
                self.fp = None


def _pump(
    src: BinaryIO | None,
    records: list[bytearray],
    record_lock: threading.Lock,
    writes: list[BinaryIO],
    closer: _Closer | None,
) -> None:
    try:
        if src is None:
            return
        while True:
            chunk = src.read(65536)
            if not chunk:
                break
            with record_lock:
                for rec in records:
                    rec.extend(chunk)
            dead: list[BinaryIO] = []
            for w in writes:
                try:
                    w.write(chunk)
                    w.flush()
                except BrokenPipeError:
                    dead.append(w)
                except OSError:
                    dead.append(w)
            for w in dead:
                writes.remove(w)
    finally:
        try:
            if src is not None:
                src.close()
        except OSError:
            pass
        if closer is not None:
            closer.done()


def _kill_pg(p: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            p.kill()
        except OSError:
            pass


def _feed_stdin(fp: BinaryIO, data: bytes) -> None:
    try:
        fp.write(data)
        fp.flush()
    except BrokenPipeError:
        pass
    finally:
        try:
            fp.close()
        except OSError:
            pass


def run_pipeline(
    specs: list[tuple[str, bool]],
    *,
    cwd: str | None = None,
    timeout: float | None = 60.0,
    passthrough: bool = False,
    stdin_data: bytes | None = None,
    forward_stderr: bool = True,
) -> list[StageRec]:
    n = len(specs)
    if n == 0:
        raise ValueError("no stages")
    procs: list[subprocess.Popen[bytes]] = []
    try:
        for i, (cmd, _merge) in enumerate(specs):
            use_stdin = i > 0 or stdin_data is not None
            p = subprocess.Popen(
                ["bash", "-c", cmd],
                stdin=subprocess.PIPE if use_stdin else subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                cwd=cwd,
                start_new_session=True,
            )
            procs.append(p)
    except OSError:
        for p in procs:
            try:
                p.kill()
            except OSError:
                pass
        raise

    rec_out = [bytearray() for _ in range(n)]
    rec_err = [bytearray() for _ in range(n)]
    rec_pipe = [bytearray() for _ in range(n)]
    locks = [threading.Lock() for _ in range(n)]
    threads: list[threading.Thread] = []
    t0 = time.monotonic()

    try:
        for i, p in enumerate(procs):
            merge = specs[i][1]
            next_in = procs[i + 1].stdin if i + 1 < n else None
            stdout_writes: list[BinaryIO] = []
            stderr_writes: list[BinaryIO] = []
            n_writers = 0
            if next_in is not None:
                stdout_writes.append(next_in)
                n_writers += 1
                if merge:
                    stderr_writes.append(next_in)
                    n_writers += 1
            elif passthrough:
                stdout_writes.append(sys.stdout.buffer)
                if merge:
                    stderr_writes.append(sys.stdout.buffer)
            if not merge and forward_stderr:
                stderr_writes.append(sys.stderr.buffer)

            closer = _Closer(next_in, n_writers) if next_in is not None else None
            out_recs: list[bytearray] = [rec_out[i], rec_pipe[i]]
            err_recs: list[bytearray] = [rec_err[i]]
            if merge:
                err_recs.append(rec_pipe[i])

            threads.append(
                threading.Thread(
                    target=_pump,
                    args=(p.stdout, out_recs, locks[i], stdout_writes, closer),
                    daemon=True,
                )
            )
            threads.append(
                threading.Thread(
                    target=_pump,
                    args=(p.stderr, err_recs, locks[i], stderr_writes, closer if merge else None),
                    daemon=True,
                )
            )

        for t in threads:
            t.start()

        if stdin_data is not None and procs[0].stdin is not None:
            feed = threading.Thread(
                target=_feed_stdin, args=(procs[0].stdin, stdin_data), daemon=True
            )
            feed.start()
            threads.append(feed)

        deadline = None if timeout is None else (t0 + timeout)
        for p in procs:
            remain = None if deadline is None else max(0.01, deadline - time.monotonic())
            try:
                p.wait(timeout=remain)
            except subprocess.TimeoutExpired:
                for q in procs:
                    _kill_pg(q)
                raise TimeoutError(f"pipeline exceeded {timeout}s") from None
        for t in threads:
            t.join(timeout=5.0)
    finally:
        for p in procs:
            if p.poll() is None:
                _kill_pg(p)

    dt = time.monotonic() - t0
    recs: list[StageRec] = []
    for i, (cmd, merge) in enumerate(specs):
        recs.append(
            StageRec(
                i=i,
                argv=cmd,
                merge_stderr=merge,
                stdout=bytes(rec_out[i]),
                stderr=bytes(rec_err[i]),
                piped=bytes(rec_pipe[i]),
                exit=procs[i].returncode,
                duration_s=dt,
                path=str(i),
            )
        )
    return recs


def collect_inner_recs(
    cmd: str,
    outer_i: int,
    ctr: list[int],
    **kwargs: Any,
) -> list[StageRec]:
    """Run every inner pipeline of cmd. Descend $() / bash -c / <() / { } first."""
    out: list[StageRec] = []
    for kind, inner_src in extract_inners(cmd):
        try:
            specs = split_pipeline(inner_src)
        except ValueError:
            continue
        for icmd, _im in specs:
            out.extend(collect_inner_recs(icmd, outer_i, ctr, **kwargs))
        recs = run_pipeline(specs, **kwargs)
        for r in recs:
            r.path = f"{outer_i}.{ctr[0]}"
            ctr[0] += 1
            r.nest = kind
            r.parent_argv = cmd
            out.append(r)
    return out


def run_pipeline_tree(
    specs: list[tuple[str, bool]],
    *,
    cwd: str | None = None,
    timeout: float | None = 60.0,
    passthrough: bool = False,
    stdin_data: bytes | None = None,
    forward_stderr: bool = True,
) -> list[StageRec]:
    """Outer pipeline plus instrumented inner $() / bash -c / <() / group stages.

    Search order: inners of stage 0, outer 0, inners of stage 1, outer 1, …
    Inner runs do not take the outer pipe's stdin and do not forward stderr.
    """
    inner_kw: dict[str, Any] = dict(
        cwd=cwd,
        timeout=timeout,
        passthrough=False,
        stdin_data=None,
        forward_stderr=False,
    )
    outer = run_pipeline(
        specs,
        cwd=cwd,
        timeout=timeout,
        passthrough=passthrough,
        stdin_data=stdin_data,
        forward_stderr=forward_stderr,
    )
    flat: list[StageRec] = []
    for i, (cmd, _merge) in enumerate(specs):
        kids = collect_inner_recs(cmd, i, [0], **inner_kw)
        flat.extend(kids)
        o = outer[i]
        o.path = str(i)
        o.nest = None
        o.parent_argv = None
        flat.append(o)
    for i, r in enumerate(flat):
        r.i = i
    return flat


