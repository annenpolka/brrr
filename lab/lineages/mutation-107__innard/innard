def _blob_dump(b: bytes) -> dict[str, str]:
    try:
        return {"encoding": "utf-8", "text": b.decode("utf-8")}
    except UnicodeDecodeError:
        return {"encoding": "base64", "b64": base64.b64encode(b).decode("ascii")}


def _blob_load(d: dict[str, Any] | str | None) -> bytes:
    if d is None:
        return b""
    if isinstance(d, str):
        return d.encode("utf-8")
    enc = d.get("encoding") or ("utf-8" if "text" in d else "base64")
    if enc == "utf-8" or "text" in d and enc != "base64":
        return str(d.get("text") or "").encode("utf-8")
    return base64.b64decode(d.get("b64") or b"")


def recs_to_json(pipeline: str, recs: list[StageRec], stdin_data: bytes | None) -> dict[str, Any]:
    return {
        "version": 1,
        "tool": "innard",
        "pipeline": pipeline,
        "stdin": _blob_dump(stdin_data) if stdin_data else None,
        "stages": [
            {
                "i": r.i,
                "path": r.path or str(r.i),
                "argv": r.argv,
                "merge_stderr": r.merge_stderr,
                "nest": r.nest,
                "parent_argv": r.parent_argv,
                "stdout": _blob_dump(r.stdout),
                "stderr": _blob_dump(r.stderr),
                "piped": _blob_dump(r.piped),
                "exit": r.exit,
                "duration_s": round(r.duration_s, 4),
            }
            for r in recs
        ],
    }


def recs_from_json(doc: dict[str, Any]) -> tuple[str, list[StageRec], bytes | None]:
    pipeline = str(doc.get("pipeline") or "")
    stdin_data = _blob_load(doc.get("stdin")) if doc.get("stdin") else None
    recs: list[StageRec] = []
    for s in doc.get("stages") or []:
        recs.append(
            StageRec(
                i=int(s.get("i", len(recs))),
                argv=str(s.get("argv") or ""),
                merge_stderr=bool(s.get("merge_stderr")),
                stdout=_blob_load(s.get("stdout")),
                stderr=_blob_load(s.get("stderr")),
                piped=_blob_load(s.get("piped")),
                exit=s.get("exit"),
                duration_s=float(s.get("duration_s") or 0),
                path=str(s.get("path") or s.get("i") or len(recs)),
                nest=s.get("nest"),
                parent_argv=s.get("parent_argv"),
            )
        )
    return pipeline, recs, stdin_data


def load_trace(path: str) -> tuple[str, list[StageRec], bytes | None]:
    if path == "-":
        doc = json.load(sys.stdin)
        return recs_from_json(doc)
    if os.path.isdir(path):
        return _load_trace_dir(path)
    with open(path, encoding="utf-8") as f:
        return recs_from_json(json.load(f))


def _read_first(path: str, stem: str, exts: tuple[str, ...]) -> bytes:
    for ext in exts:
        p = os.path.join(path, f"{stem}.{ext}")
        if os.path.isfile(p):
            with open(p, "rb") as f:
                return f.read()
    return b""


def _load_trace_dir(path: str) -> tuple[str, list[StageRec], bytes | None]:
    names = os.listdir(path)

    def key(s: str) -> tuple:
        try:
            return (0, int(s))
        except ValueError:
            return (1, s)

    stems = sorted(
        {
            n.rsplit(".", 1)[0]
            for n in names
            if n.endswith((".argv", ".cmd", ".stdout", ".out"))
        },
        key=key,
    )
    recs: list[StageRec] = []
    for i, stem in enumerate(stems):
        argv_b = _read_first(path, stem, ("argv", "cmd"))
        argv = argv_b.decode("utf-8", "replace").strip()
        stdout = _read_first(path, stem, ("stdout", "out"))
        stderr = _read_first(path, stem, ("stderr", "err"))
        piped = _read_first(path, stem, ("piped",)) or stdout
        recs.append(
            StageRec(
                i=i,
                argv=argv or stem,
                merge_stderr=False,
                stdout=stdout,
                stderr=stderr,
                piped=piped,
                path=str(i),
            )
        )
    meta = os.path.join(path, "pipeline.txt")
    pipeline = ""
    if os.path.isfile(meta):
        with open(meta, encoding="utf-8") as f:
            pipeline = f.read().strip()
    return pipeline, recs, None


