def strip_ansi(s: str) -> str:
    return ANSI_RE.sub("", s)


def normalize_query(s: str) -> str:
    s = strip_ansi(s).replace("\r\n", "\n").replace("\r", "\n")
    return s.strip()


def is_compiler_locator(q: str) -> bool:
    s = (q or "").strip()
    if not s:
        return False
    if COMPILER_LOCATOR_RE.match(s):
        return True
    if s.startswith("|") and (s == "|" or set(s[1:].strip()) <= set("^~ ")):
        return True
    return False


def _substantial_leftover(s: str) -> bool:
    t = (s or "").strip()
    if not t:
        return False
    if all(ch in ".,;:!?…\"'`)]}" for ch in t):
        return False
    return True


def is_newline_only(s: str) -> bool:
    return bool(s) and all(ch in "\n\r" for ch in s)


def is_fence_marker(s: str) -> bool:
    """A proving string that is only fence ticks (and whitespace/newlines)."""
    if not s:
        return False
    core = "".join(ch for ch in s if not ch.isspace())
    return bool(core) and all(ch == "`" for ch in core)


def distinctive_static(s: str) -> str:
    """Chars that can prove a concat template.

    Newlines, fence ticks, and wrapping whitespace are not distinctive.
    weld's 4-char floor counted stripped length, so `{body}abcd` matched
    every log line ending abcd. stile counts leftover identity, not length.
    """
    return "".join(ch for ch in s if ch not in "\n\r`" and not ch.isspace())


def is_bare_alnum_run(s: str) -> bool:
    """Pure alnum suffix with no delimiter — `{body}abcd`, not `"open "`."""
    if not s or any(ch.isspace() for ch in s):
        return False
    return s.isalnum()


def proving_too_thin(parts: tuple[str, ...], holes: int) -> bool:
    """A proving string that is only a newline / fence marker / <4
    distinctive static chars is not a template unless there are ≥2
    expression holes.
    """
    joined = "".join(parts)
    if holes >= 2:
        return not any(p for p in parts if p)
    if is_newline_only(joined):
        return True
    if is_fence_marker(joined):
        return True
    if len(distinctive_static(joined)) < 4:
        return True
    if is_bare_alnum_run(joined):
        return True
    return False


def is_proving_operand(op: str) -> bool:
    """A concat operand that is the proof, not a 1–2 char separator (`": "`)."""
    if not op:
        return False
    if is_fence_marker(op) or is_newline_only(op):
        return True
    if is_bare_alnum_run(op):
        return True
    return len(distinctive_static(op)) >= 4


def decode_remainder(remainder: str) -> str:
    return (remainder or "").replace("\\n", "\n").replace("\\t", "\t")


def leftover_is_truncated_operand(operand: str, leftover: str) -> bool:
    """True when leftover is a proper prefix of a concat operand (caulk)."""
    if not operand or not leftover:
        return False
    return leftover != operand and operand.startswith(leftover)


def looks_like_fence_opener(s: str) -> bool:
    t = (s or "").lstrip()
    return t.startswith("```")


def hole_has_fence_closer(val: str) -> bool:
    """True when a hole swallowed a fence-marker leftover (`\\n```)."""
    if not val:
        return False
    if is_fence_marker(val):
        return True
    idx = val.find("\n```")
    if idx >= 0 and is_fence_marker(val[idx:]):
        return True
    return False


def fence_closer_stuffed_in_hole(
    tmpl: Template, bindings: list[tuple[str, str]]
) -> bool:
    """Unclosed `"```json\\n" + response()` must not bind the closer into the hole.

    A complete fenced paste against an opener-only template is leftover
    stuffing, not inverse-printf of that concat.
    """
    if not (tmpl.spliced or tmpl.welded):
        return False
    if not tmpl.parts or tmpl.parts[-1] != "" or not bindings:
        return False
    opener = next((p for p in tmpl.parts if p), "")
    if not looks_like_fence_opener(opener):
        return False
    return hole_has_fence_closer(bindings[-1][1])


def incomplete_concat_leftover(
    tmpl: Template,
    truncated: bool,
    remainder: str,
    loc: list[tuple[int, int]],
) -> bool:
    """Incomplete fence leftovers refuse (caulk complete operand).

    Fresh-line truncation that cuts a proving concat operand, or that
    drops a fence-marker closer, is not inverse-printf. Prefix-of-instance
    on interpolations and on non-proving separators (`": "`) still holds.
    """
    if not truncated or not (tmpl.spliced or tmpl.welded):
        return False
    rem = decode_remainder(remainder)
    for i, part in enumerate(tmpl.parts):
        if not part or not is_proving_operand(part):
            continue
        a, b = loc[i] if i < len(loc) else (-1, -1)
        if a >= 0 and (b - a) < len(part):
            return True
        if a < 0 and is_fence_marker(part):
            return True
        if rem and leftover_is_truncated_operand(part, rem):
            return True
    return False


def decode_bytes_or_die(data: bytes, origin: str) -> str:
    sample = data[:8192] if data else b""
    if b"\x00" in sample:
        print(f"stile: binary {origin}: NUL byte", file=sys.stderr)
        raise SystemExit(2)
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        print(f"stile: binary {origin}: not UTF-8", file=sys.stderr)
        raise SystemExit(2)


def read_stdin_text(origin: str = "stdin") -> str:
    return decode_bytes_or_die(sys.stdin.buffer.read(), origin)


def query_variants(q: str, exact: bool = False) -> list[tuple[str, float, str]]:
    q = normalize_query(q)
    if not q:
        return []
    out = [(q, 0.0, "full")]
    if exact:
        return out
    parts = re.split(r": ", q)
    if len(parts) > 1:
        for i in range(1, len(parts)):
            suf = ": ".join(parts[i:])
            if len(suf) >= MIN_STATIC_HOLE:
                out.append((suf, 0.04 * i, f"suffix:{i}"))
    for sep, name in ((" — ", "emdash"), (" - ", "dash")):
        if sep in q:
            suf = q.split(sep, 1)[1]
            if len(suf) >= MIN_STATIC_HOLE:
                out.append((suf, 0.05, name))
    seen: set[str] = set()
    uniq = []
    for item in out:
        if item[0] in seen:
            continue
        seen.add(item[0])
        uniq.append(item)
    return uniq


def unescape_basic(s: str) -> str:
    out = []
    i = 0
    n = len(s)
    escapes = {
        "n": "\n",
        "t": "\t",
        "r": "\r",
        "0": "\0",
        "\\": "\\",
        '"': '"',
        "'": "'",
        "`": "`",
    }
    while i < n:
        if s[i] == "\\" and i + 1 < n:
            nxt = s[i + 1]
            if nxt == "(":
                out.append("\\(")
                i += 2
                continue
            if nxt in escapes:
                out.append(escapes[nxt])
                i += 2
                continue
            if nxt == "x" and i + 3 < n:
                try:
                    out.append(chr(int(s[i + 2 : i + 4], 16)))
                    i += 4
                    continue
                except ValueError:
                    pass
            out.append(nxt)
            i += 2
            continue
        out.append(s[i])
        i += 1
    return "".join(out)


def _matching_brace(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return i
        elif ch == '"' or ch == "'":
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _matching_paren(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
        elif ch == '"' or ch == "'":
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _is_format_hole(s: str, i: int) -> int | None:
    if i >= len(s) or s[i] != "{":
        return None
    n = len(s)
    j = i + 1
    if j < n and s[j] in '{"[ \n\t':
        return None
    if j < n and s[j] == "}":
        return j + 1
    if j < n and s[j].isdigit():
        while j < n and s[j].isdigit():
            j += 1
    elif j < n and (s[j].isalpha() or s[j] == "_"):
        while j < n and (s[j].isalnum() or s[j] in "_."):
            j += 1
    if j < n and s[j] == "!":
        j += 1
        while j < n and s[j].isalpha():
            j += 1
    if j < n and s[j] == ":":
        k = s.find("}", j)
        if k < 0:
            return None
        return k + 1
    if j < n and s[j] == "}":
        return j + 1
    return None


def _brace_hole_name(inner: str) -> str:
    inner = inner.strip()
    if not inner:
        return ""
    if "!" in inner:
        inner = inner.split("!", 1)[0]
    if ":" in inner:
        inner = inner.split(":", 1)[0]
    return inner.strip()


def _swift_hole_name(inner: str) -> str:
    s = inner.strip()
    if not s:
        return ""
    m = re.match(
        r"((?:self\.)?[A-Za-z_][A-Za-z0-9_]*|(?:\#)[A-Za-z_][A-Za-z0-9_]*)"
        r"(?:[.#][A-Za-z_][A-Za-z0-9_]*)*",
        s,
    )
    if m:
        return m.group(0)
    return s.split(",", 1)[0].strip()[:48]


def _dollar_hole_name(inner: str) -> str:
    s = inner.strip()
    if not s:
        return ""
    return s


def _assign_hole_names(raw: list[str]) -> tuple[str, ...]:
    n = 1
    out: list[str] = []
    for name in raw:
        if name:
            out.append(name)
        else:
            out.append(str(n))
            n += 1
    return tuple(out)


def swift_string_value(raw: str) -> str:
    s = SWIFT_CONTINUATION_RE.sub("", raw)
    if "\n" not in s:
        return s
    if s.startswith("\n"):
        s = s[1:]
    lines = s.split("\n")
    while lines and not lines[-1].strip():
        lines.pop()
    while lines and not lines[0].strip():
        lines.pop(0)
    nonempty = [ln for ln in lines if ln.strip()]
    if nonempty:
        cut = min(len(ln) - len(ln.lstrip(" \t")) for ln in nonempty)
        lines = [ln[cut:] if len(ln) >= cut else ln for ln in lines]
    return "\n".join(lines).strip()


def looks_like_data_literal(body: str, holes: int) -> bool:
    if holes:
        return False
    s = body.strip()
    if len(s) >= MAX_NOHOLE_CHARS:
        return True
    if DATA_LITERAL_RE.match(s) and (":" in s or "," in s):
        return True
    return False


def is_test_path(path: str) -> bool:
    return bool(TEST_PATH_RE.search(path.replace("\\", "/")))


def tokenize_named(
    s: str, printf: bool = True
) -> tuple[tuple[str, ...], tuple[str, ...]]:
    buf: list[str] = []
    parts: list[str] = []
    raw_names: list[str] = []
    i = 0
    n = len(s)

    def flush() -> None:
        parts.append("".join(buf))
        buf.clear()

    while i < n:
        if s.startswith("{{", i):
            buf.append("{")
            i += 2
            continue
        if s.startswith("}}", i):
            buf.append("}")
            i += 2
            continue
        if s.startswith("%%", i):
            buf.append("%")
            i += 2
            continue
        if s.startswith("${", i):
            end = _matching_brace(s, i + 1)
            if end is not None:
                flush()
                raw_names.append(_dollar_hole_name(s[i + 2 : end]))
                i = end + 1
                continue
        if s.startswith("\\(", i):
            end = _matching_paren(s, i + 1)
            if end is not None:
                flush()
                raw_names.append(_swift_hole_name(s[i + 2 : end]))
                i = end + 1
                continue
        if s[i] == "{":
            end = _is_format_hole(s, i)
            if end is not None:
                flush()
                raw_names.append(_brace_hole_name(s[i + 1 : end - 1]))
                i = end
                continue
        if printf:
            m = PRINTF_RE.match(s, i)
            if m:
                if m.group(0) == "%%":
                    buf.append("%")
                    i = m.end()
                    continue
                flush()
                raw_names.append("")
                i = m.end()
                continue
        buf.append(s[i])
        i += 1
    flush()
    return tuple(parts), _assign_hole_names(raw_names)


def tokenize_template(s: str) -> tuple[tuple[str, ...], int]:
    parts, names = tokenize_named(s)
    return parts, len(names)


def template_of(
    path: str,
    line: int,
    col: int,
    lang: str,
    raw: str,
    origin: str = "line",
    parts: tuple[str, ...] | None = None,
    names: tuple[str, ...] | None = None,
    hint_line: int | None = None,
    spliced: bool = False,
    welded: bool = False,
) -> Template:
    if parts is None or names is None:
        parts, names = tokenize_named(raw)
    return Template(
        path=path,
        line=line,
        col=col,
        lang=lang,
        raw=raw,
        parts=parts,
        holes=len(names),
        origin=origin,
        names=names,
        hint_line=hint_line,
        spliced=spliced,
        welded=welded,
    )


def _line_starts(text: str) -> list[int]:
    starts = [0]
    for i, ch in enumerate(text):
        if ch == "\n":
            starts.append(i + 1)
    return starts


def _linecol(starts: list[int], index: int) -> tuple[int, int]:
    lo, hi = 0, len(starts) - 1
    while lo <= hi:
        mid = (lo + hi) // 2
        if starts[mid] <= index:
            lo = mid + 1
        else:
            hi = mid - 1
    line_idx = hi
    return line_idx + 1, index - starts[line_idx] + 1


def _skip_line_comment(text: str, i: int) -> int:
    n = len(text)
    while i < n and text[i] != "\n":
        i += 1
    return i


def _skip_block_comment(text: str, i: int) -> int:
    n = len(text)
    i += 2
    while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
        i += 1
    return min(n, i + 2)


def _read_quoted(
    text: str, i: int, quote: str, interpolations: bool = False
) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    start = i
    while i < n:
        if interpolations and text.startswith("\\(", i):
            end = _matching_paren(text, i + 1)
            if end is None:
                return None
            i = end + 1
            continue
        ch = text[i]
        if ch == "\\":
            i += 2
            continue
        if ch == quote:
            return i + 1, text[start:i]
        if ch == "\n" and quote != "`":
            return None
        i += 1
    return None


def _read_raw_hash(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    hashes = 0
    while i < n and text[i] == "#":
        hashes += 1
        i += 1
    if i >= n or text[i] != '"':
        return None
    i += 1
    start = i
    close = '"' + ("#" * hashes)
    while i < n:
        if text.startswith(close, i):
            return i + len(close), text[start:i]
        i += 1
    return None


def _read_triple(
    text: str, i: int, quote: str, interpolations: bool = False
) -> tuple[int, str] | None:
    delim = quote * 3
    if not text.startswith(delim, i):
        return None
    i += 3
    start = i
    n = len(text)
    while i + 2 < n:
        if interpolations and text.startswith("\\(", i):
            end = _matching_paren(text, i + 1)
            if end is None:
                return None
            i = end + 1
            continue
        if text.startswith(delim, i):
            return i + 3, text[start:i]
        if text[i] == "\\":
            i += 2
            continue
        i += 1
    return None


def _read_js_template(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    chunks: list[str] = []
    last = i
    depth_expr = 0
    in_expr = False
    while i < n:
        ch = text[i]
        if not in_expr:
            if ch == "\\":
                i += 2
                continue
            if ch == "`":
                chunks.append(text[last:i])
                return i + 1, "".join(chunks)
            if ch == "$" and i + 1 < n and text[i + 1] == "{":
                chunks.append(text[last:i])
                chunks.append("${")
                i += 2
                last = i
                in_expr = True
                depth_expr = 1
                continue
            i += 1
            continue
        if ch == "{":
            depth_expr += 1
        elif ch == "}":
            depth_expr -= 1
            if depth_expr == 0:
                chunks.append(text[last:i])
                chunks.append("}")
                i += 1
                last = i
                in_expr = False
                continue
        elif ch in ('"', "'", "`"):
            q = ch
            i += 1
            while i < n:
                if text[i] == "\\":
                    i += 2
                    continue
                if text[i] == q:
                    i += 1
                    break
                i += 1
            continue
        i += 1
    return None


def lang_for(path: str | Path, default: str = "any") -> str:
    suf = Path(str(path)).suffix.lower()
    return SOURCE_EXTS.get(suf, default)


def looks_like_source_path(s: str) -> bool:
    name = Path(s).name
    if name.endswith(tuple(SOURCE_EXTS)):
        return True
    if "/" in s or s.startswith("./") or s.startswith("../"):
        return Path(s).suffix.lower() in SOURCE_EXTS or bool(Path(s).suffix)
    return False


def _concat_op_len(text: str, i: int) -> int:
    if i >= len(text):
        return 0
    if text.startswith("<>", i):
        return 2
    if text[i] == "+" and not text.startswith("+=", i) and not text.startswith("++", i):
        return 1
    return 0


def _concat_op_ending_at(text: str, j: int) -> int:
    if j >= 2 and text[j - 2 : j] == "<>":
        return 2
    if j >= 1 and text[j - 1] == "+":
        if j >= 2 and text[j - 2] == "+":
            return 0
        if j < len(text) and text[j] in "+=":
            return 0
        return 1
    return 0


def _skip_concat_gap(text: str, i: int, hash_comment: bool = False) -> int:
    n = len(text)
    while i < n:
        ch = text[i]
        if ch in " \t":
            i += 1
            continue
        if ch in "\r\n":
            i += 1
            continue
        if text.startswith("//", i):
            i = _skip_line_comment(text, i)
            continue
        if text.startswith("/*", i):
            i = _skip_block_comment(text, i)
            continue
        if hash_comment and ch == "#":
            i = _skip_line_comment(text, i)
            continue
        break
    return i


def _line_comment_cut(line: str, hash_comment: bool) -> int | None:
    i = 0
    n = len(line)
    while i < n:
        if line.startswith("//", i):
            return i
        if hash_comment and line[i] == "#":
            return i
        if line[i] in "\"'":
            q = line[i]
            i += 1
            while i < n:
                if line[i] == "\\":
                    i += 2
                    continue
                if line[i] == q:
                    i += 1
                    break
                i += 1
            continue
        i += 1
    return None


def _skip_concat_gap_backward(text: str, i: int, hash_comment: bool = False) -> int:
    while i > 0:
        ch = text[i - 1]
        if ch in " \t":
            i -= 1
            continue
        if ch in "\r\n":
            i -= 1
            line_start = text.rfind("\n", 0, i) + 1
            cut = _line_comment_cut(text[line_start:i], hash_comment)
            if cut is not None:
                i = line_start + cut
            continue
        if i >= 2 and text[i - 2 : i] == "*/":
            start = text.rfind("/*", 0, i - 2)
            if start >= 0:
                i = start
                continue
        break
    return i


def _expr_hole_name(expr: str) -> str:
    s = expr.strip()
    if not s:
        return "1"
    if "//" in s:
        s = s.split("//", 1)[0].strip()
    if "#" in s and "\n" not in s:
        head, _, tail = s.partition("#")
        if tail and not any(ch in head for ch in "\"'"):
            s = head.strip()
    while len(s) >= 2 and s[0] == "(" and s[-1] == ")":
        inner = s[1:-1].strip()
        depth = 0
        ok = True
        for ch in inner:
            if ch == "(":
                depth += 1
            elif ch == ")":
                depth -= 1
                if depth < 0:
                    ok = False
                    break
        if not ok or depth != 0:
            break
        s = inner
    m = re.match(
        r"^((?:[A-Za-z_][A-Za-z0-9_]*\.)*[A-Za-z_][A-Za-z0-9_]*)\(\s*\)$", s
    )
    if m:
        return m.group(1)
    m = re.match(
        r"^(?:[A-Za-z_][A-Za-z0-9_]*\.)*[A-Za-z_][A-Za-z0-9_]*\(\s*"
        r"((?:[A-Za-z_][A-Za-z0-9_]*\.)*[A-Za-z_][A-Za-z0-9_]*)\s*\)$",
        s,
    )
    if m:
        return m.group(1)
    m = re.match(
        r"^((?:self\.)?[A-Za-z_][A-Za-z0-9_]*"
        r"(?:[.#][A-Za-z_][A-Za-z0-9_]*|\[\d+\])*)",
        s,
    )
    if m:
        return m.group(1)
    compact = re.sub(r"\s+", "", s)
    return compact[:48] if compact else "1"


def _read_concat_expr(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    start = i
    depth_paren = 0
    depth_brack = 0
    depth_brace = 0
    while i < n:
        ch = text[i]
        if ch in ("\"", "'", "`"):
            if ch == "`":
                got = _read_js_template(text, i)
                if got is None:
                    j = text.find("`", i + 1)
                    if j < 0:
                        break
                    i = j + 1
                    continue
                i = got[0]
                continue
            got = _read_quoted(text, i, ch, interpolations=False)
            if got is None:
                break
            i = got[0]
            continue
        if ch == "(":
            depth_paren += 1
            i += 1
            continue
        if ch == ")":
            if depth_paren == 0:
                break
            depth_paren -= 1
            i += 1
            continue
        if ch == "[":
            depth_brack += 1
            i += 1
            continue
        if ch == "]":
            if depth_brack == 0:
                break
            depth_brack -= 1
            i += 1
            continue
        if ch == "{":
            depth_brace += 1
            i += 1
            continue
        if ch == "}":
            if depth_brace == 0:
                break
            depth_brace -= 1
            i += 1
            continue
        if depth_paren == 0 and depth_brack == 0 and depth_brace == 0:
            if ch in ",;":
                break
            if ch == "\n":
                break
            if _concat_op_len(text, i):
                break
        i += 1
    expr = text[start:i].strip()
    if not expr:
        return None
    return i, expr


def extract_templates(text: str, lang: str, path: str, origin: str = "file") -> list[Template]:
    starts = _line_starts(text)
    n = len(text)
    i = 0
    out: list[Template] = []
    any_lang = lang in {"any", ""}
    rustish = lang == "rust" or any_lang
    pyish = lang == "py" or any_lang
    jsish = lang == "js" or any_lang
    goish = lang == "go" or any_lang
    swiftish = lang == "swift" or any_lang
    hash_comment = lang in {"py", "sh", "rb"}
    use_lang = lang if lang and lang != "any" else lang_for(path)

    def emit(
        raw_inner: str,
        at: int,
        unesc: bool,
        *,
        printf: bool = True,
        spliced: bool = False,
        welded: bool = False,
        parts: tuple[str, ...] | None = None,
        names: tuple[str, ...] | None = None,
        raw: str | None = None,
    ) -> None:
        body = raw if raw is not None else raw_inner
        if raw is None:
            if lang == "swift" or (any_lang and ("\\(" in body or "\\\n" in body)):
                body = swift_string_value(body)
            if unesc:
                body = unescape_basic(body)
            if not body or body.isspace():
                return
            if body.endswith("\r\n"):
                body = body[:-2]
            elif body.endswith("\n"):
                body = body[:-1]
        if not body or body.isspace():
            return
        if parts is None or names is None:
            if len(body.strip()) < MIN_STATIC_EXACT and not spliced:
                return
            parts, names = tokenize_named(body, printf=printf)
        holes = len(names)
        if looks_like_data_literal(body, holes):
            return
        static = sum(len(p) for p in parts)
        if holes == 0 and static < MIN_STATIC_EXACT:
            return
        if spliced and holes == 0:
            return
        if spliced and holes and proving_too_thin(tuple(parts), holes):
            return
        line, col = _linecol(starts, at)
        out.append(
            template_of(
                path=path,
                line=line,
                col=col,
                lang=use_lang,
                raw=body,
                origin=origin,
                parts=parts,
                names=names,
                spliced=spliced,
                welded=welded,
            )
        )

    def read_string(at: int) -> _StrLit | None:
        if at < 0 or at >= n:
            return None
        ch = text[at]
        if rustish and ch in {"r", "b", "c"}:
            j = at
            if text[j] in {"b", "c"}:
                j += 1
            if j < n and text[j] == "r":
                j += 1
                got = _read_raw_hash(text, j)
                if got:
                    end, inner = got
                    return _StrLit(end, inner, False, at, False)
        if pyish and ch.isalpha():
            j = at
            while j < n and text[j] in "rRfFbBuU":
                j += 1
            if j > at and j < n and text[j] in {'"', "'"}:
                is_raw = any(c in "rR" for c in text[at:j])
                is_f = any(c in "fF" for c in text[at:j])
                if text.startswith(text[j] * 3, j):
                    got = _read_triple(text, j, text[j], interpolations=False)
                else:
                    got = _read_quoted(text, j, text[j], interpolations=False)
                if got:
                    end, inner = got
                    return _StrLit(end, inner, not is_raw, at, is_f)
        if (goish or jsish) and ch == "`":
            if jsish or "${" in text[at : at + 400]:
                got = _read_js_template(text, at)
                if got:
                    end, inner = got
                    return _StrLit(end, inner, True, at, True)
            if goish:
                j = text.find("`", at + 1)
                if j >= 0:
                    return _StrLit(j + 1, text[at + 1 : j], False, at, False)
        if ch in {'"', "'"} and text.startswith(ch * 3, at):
            got = _read_triple(
                text, at, ch, interpolations=swiftish or "\\(" in text[at : at + 80]
            )
            if got:
                end, inner = got
                return _StrLit(end, inner, True, at, swiftish)
        if ch == '"' or (
            ch == "'"
            and lang in {"js", "py", "sh", "rb", "go", "java", "kt", "c", "any", "", "ex"}
        ):
            got = _read_quoted(
                text, at, ch, interpolations=swiftish or text.startswith("\\(", at + 1)
            )
            if got:
                end, inner = got
                return _StrLit(end, inner, True, at, swiftish)
        return None

    def prepare_static(lit: _StrLit) -> str:
        # Concat operands keep escaped trailing newlines. `"```json\n" + body`
        # is a proving string; stripping `\n` glues `json` onto the hole.
        body = lit.inner
        if lang == "swift" or (any_lang and ("\\(" in body or "\\\n" in body)):
            body = swift_string_value(body)
        if lit.unesc:
            body = unescape_basic(body)
        return body

    def operands_to_parts(
        operands: list[tuple[str, object]],
    ) -> tuple[list[str], list[str], str] | None:
        parts: list[str] = [""]
        names: list[str] = []
        raw_chunks: list[str] = []
        for kind, payload in operands:
            if kind == "str":
                lit = payload if isinstance(payload, _StrLit) else None
                if lit is None:
                    return None
                body = prepare_static(lit)
                raw_chunks.append(body)
                subparts, subnames = tokenize_named(
                    body, printf=False if not lit.interpolate else True
                )
                parts[-1] += subparts[0]
                for k, name in enumerate(subnames):
                    names.append(name)
                    parts.append(subparts[k + 1])
            else:
                expr = str(payload)
                name = _expr_hole_name(expr)
                names.append(name)
                parts.append("")
                raw_chunks.append("{" + name + "}")
        raw = "".join(raw_chunks)
        if not names:
            return None
        if not raw.strip():
            return None
        return parts, names, raw

    def read_string_ending_at(end: int) -> _StrLit | None:
        if end <= 1 or end > n:
            return None
        quote = text[end - 1]
        if quote not in "\"'`":
            return None
        lo = max(0, end - MAX_WELD_LOOKBACK)
        i = end - 2
        while i >= lo:
            if text[i] == quote:
                for start in range(max(lo, i - 4), i + 1):
                    lit = read_string(start)
                    if lit is not None and lit.end == end:
                        return lit
            i -= 1
        return None

    def matching_open(close_at: int, open_ch: str, close_ch: str) -> int | None:
        depth = 0
        i = close_at
        lo = max(0, close_at - MAX_WELD_LOOKBACK)
        while i >= lo:
            ch = text[i]
            if ch in "\"'`":
                lit = read_string_ending_at(i + 1)
                if lit is not None:
                    i = lit.start - 1
                    continue
            if ch == close_ch:
                depth += 1
            elif ch == open_ch:
                depth -= 1
                if depth == 0:
                    return i
            i -= 1
        return None

    def read_expr_ending_at(end: int) -> tuple[int, str] | None:
        i = end
        consumed = False
        lo = max(0, end - MAX_WELD_LOOKBACK)
        while i > lo:
            ch = text[i - 1]
            if ch == ")":
                open_i = matching_open(i - 1, "(", ")")
                if open_i is None:
                    break
                i = open_i
                consumed = True
                continue
            if ch == "]":
                open_i = matching_open(i - 1, "[", "]")
                if open_i is None:
                    break
                i = open_i
                consumed = True
                continue
            if ch.isalnum() or ch == "_":
                j = i
                while j > lo and (text[j - 1].isalnum() or text[j - 1] == "_"):
                    j -= 1
                i = j
                consumed = True
                if i > lo and text[i - 1] == ".":
                    i -= 1
                    continue
                break
            break
        if not consumed:
            return None
        expr = text[i:end].strip()
        if not expr:
            return None
        return i, expr

    def read_operand_ending_at(k: int) -> tuple[int, tuple[str, object]] | None:
        lit = read_string_ending_at(k)
        if lit is not None:
            return lit.start, ("str", lit)
        got = read_expr_ending_at(k)
        if got is None:
            return None
        start, expr = got
        return start, ("expr", expr)

    def weld_chain(first: _StrLit) -> tuple[int, int, list[tuple[str, object]]] | None:
        operands: list[tuple[str, object]] = [("str", first)]
        start = first.start
        end = first.end
        floor = max(0, first.start - MAX_WELD_LOOKBACK)

        j = _skip_concat_gap_backward(text, first.start, hash_comment=hash_comment)
        while j > floor:
            oplen = _concat_op_ending_at(text, j)
            if not oplen:
                break
            k = _skip_concat_gap_backward(text, j - oplen, hash_comment=hash_comment)
            prev = read_operand_ending_at(k)
            if prev is None:
                break
            prev_start, operand = prev
            if prev_start < floor:
                break
            operands.insert(0, operand)
            start = prev_start
            j = _skip_concat_gap_backward(text, prev_start, hash_comment=hash_comment)

        j = first.end
        while True:
            j = _skip_concat_gap(text, j, hash_comment=hash_comment)
            oplen = _concat_op_len(text, j)
            if not oplen:
                break
            j += oplen
            j = _skip_concat_gap(text, j, hash_comment=hash_comment)
            nxt = read_string(j)
            if nxt is not None:
                operands.append(("str", nxt))
                end = nxt.end
                j = nxt.end
                continue
            got = _read_concat_expr(text, j)
            if got is None:
                break
            expr_end, expr = got
            if not expr:
                break
            operands.append(("expr", expr))
            end = expr_end
            j = expr_end

        if len(operands) < 2:
            return None
        if not any(kind == "str" for kind, _ in operands):
            return None
        return start, end, operands

    def parse_sprint(at: int, match_end: int) -> tuple[int, list[tuple[str, object]]] | None:
        j = match_end
        operands: list[tuple[str, object]] = []
        while j < n:
            j = _skip_concat_gap(text, j, hash_comment=hash_comment)
            if j < n and text[j] == ")":
                j += 1
                break
            nxt = read_string(j)
            if nxt is not None:
                operands.append(("str", nxt))
                j = nxt.end
            else:
                got = _read_concat_expr(text, j)
                if got is None:
                    return None
                expr_end, expr = got
                operands.append(("expr", expr))
                j = expr_end
            j = _skip_concat_gap(text, j, hash_comment=hash_comment)
            if j < n and text[j] == ",":
                j += 1
                continue
            if j < n and text[j] == ")":
                j += 1
                break
            return None
        if not any(kind == "expr" for kind, _ in operands):
            return None
        if not any(kind == "str" for kind, _ in operands):
            return None
        return j, operands

    def _looks_like_sprint(at: int) -> re.Match[str] | None:
        m = SPRINT_RE.match(text, at)
        if not m:
            return None
        if at > 0 and (text[at - 1].isalnum() or text[at - 1] == "_"):
            return None
        return m

    while i < n:
        ch = text[i]
        if hash_comment and ch == "#":
            i = _skip_line_comment(text, i)
            continue
        if lang != "py" and ch == "/" and i + 1 < n:
            if text[i + 1] == "/":
                i = _skip_line_comment(text, i)
                continue
            if text[i + 1] == "*":
                i = _skip_block_comment(text, i)
                continue
        if goish or any_lang:
            sm = _looks_like_sprint(i)
            if sm:
                parsed = parse_sprint(i, sm.end())
                if parsed is not None:
                    end, operands = parsed
                    built = operands_to_parts(operands)
                    if built is not None:
                        parts_l, names_l, raw = built
                        welded = bool(operands and operands[0][0] == "expr")
                        emit(
                            raw,
                            i,
                            unesc=False,
                            printf=False,
                            spliced=True,
                            welded=welded,
                            parts=tuple(parts_l),
                            names=tuple(names_l),
                            raw=raw,
                        )
                        i = end
                        continue
        lit = read_string(i)
        if lit is not None:
            chain = weld_chain(lit)
            if chain is not None:
                start, end, operands = chain
                built = operands_to_parts(operands)
                if built is not None:
                    parts_l, names_l, raw = built
                    welded = bool(operands and operands[0][0] == "expr")
                    emit(
                        raw,
                        start,
                        unesc=False,
                        printf=False,
                        spliced=True,
                        welded=welded,
                        parts=tuple(parts_l),
                        names=tuple(names_l),
                        raw=raw,
                    )
                    i = end
                    continue
            emit(lit.inner, lit.start, lit.unesc, printf=True)
            i = lit.end
            continue
        i += 1
    return out


def _lit_span(loc: tuple[int, int], part: str) -> bool:
    a, b = loc
    return a >= 0 and (b - a) == len(part)


def _longest_prefix_as_suffix(part: str, rest: str) -> int:
    if not part or not rest:
        return 0
    max_k = min(len(part) - 1, len(rest))
    for k in range(max_k, 0, -1):
        if rest.endswith(part[:k]):
            return k
    return 0


def _later_witnesses(parts: tuple[str, ...], from_index: int) -> tuple[str, ...]:
    seen: list[str] = []
    for p in parts[from_index:]:
        if not p:
            continue
        if p not in seen:
            seen.append(p)
        s = p.strip()
        if s != p and len(s) >= 3 and s not in seen:
            seen.append(s)
    return tuple(seen)


def _contains_later_fragment(value: str, parts: tuple[str, ...], from_index: int) -> bool:
    if not value:
        return False
    for w in _later_witnesses(parts, from_index):
        if len(w) < 3:
            continue
        if w in value:
            return True
    return False


def _align_parts(
    parts: tuple[str, ...], query: str, allow_truncated: bool = True
) -> tuple[str, str, list[tuple[int, int]], int, int, bool, int] | None:
    loc: list[tuple[int, int]] = [(-1, -1)] * len(parts)
    pos = 0
    first = True
    prefix = ""
    span_start = 0
    truncated = False
    stop_at = len(parts)

    for i, part in enumerate(parts):
        if part == "":
            continue
        idx = query.find(part, pos)
        if idx >= 0:
            if first:
                prefix = query[:idx]
                span_start = idx
                first = False
            loc[i] = (idx, idx + len(part))
            pos = idx + len(part)
            continue
        if not allow_truncated:
            return None
        rest = query[pos:]
        if first:
            min_k = MIN_STATIC_PREFIX
            max_k = min(len(part) - 1, len(query))
            found_k = 0
            found_idx = -1
            for cand in range(max_k, min_k - 1, -1):
                frag = part[:cand]
                fidx = query.rfind(frag)
                if fidx >= 0 and fidx + cand == len(query):
                    found_k = cand
                    found_idx = fidx
                    break
            if found_k:
                loc[i] = (found_idx, found_idx + found_k)
                prefix = query[:found_idx]
                span_start = found_idx
                first = False
                truncated = True
                stop_at = i
                pos = len(query)
                break
            return None
        k = _longest_prefix_as_suffix(part, rest)
        if k > 0:
            hole_val = rest[:-k]
            if _contains_later_fragment(hole_val, parts, i):
                return None
            loc[i] = (pos + len(rest) - k, pos + len(rest))
            truncated = True
            stop_at = i
            pos = len(query)
            break
        if rest and _contains_later_fragment(rest, parts, i):
            return None
        truncated = True
        stop_at = i
        pos = len(query)
        break

    if first:
        return None
    if parts and parts[0] == "":
        prefix = ""
        span_start = 0
    if truncated:
        suffix = ""
        span_end = len(query)
    else:
        suffix = query[pos:] if pos <= len(query) else ""
        span_end = len(query) if parts[-1] == "" else pos
    return prefix, suffix, loc, span_start, span_end, truncated, stop_at


def _remainder_of(tmpl: Template, loc: list[tuple[int, int]], stop_at: int) -> str:
    names = tmpl.hole_names
    parts = tmpl.parts
    if stop_at >= len(parts):
        return ""
    out: list[str] = []
    i = stop_at
    part = parts[i]
    a, b = loc[i]
    if a >= 0 and b >= 0 and (b - a) < len(part):
        out.append(part[b - a :].replace("\n", "\\n").replace("\t", "\\t"))
        i += 1
    else:
        out.append(part.replace("\n", "\\n").replace("\t", "\\t"))
        i += 1
    while i < len(parts):
        name = names[i - 1] if i - 1 < len(names) else str(i)
        out.append("{" + name + "}")
        out.append(parts[i].replace("\n", "\\n").replace("\t", "\\t"))
        i += 1
    return "".join(out)


def _match_static(
    tmpl: Template, query: str
) -> tuple[float, str, str, tuple[tuple[str, str], ...], tuple[int, int], bool, str] | None:
    body = tmpl.parts[0] if tmpl.parts else ""
    if not body or body.isspace():
        return None
    static = tmpl.static_len
    if body == query:
        return 1.0, "", "", (), (0, len(query)), False, ""

    idx = query.find(body)
    if idx >= 0:
        prefix = query[:idx]
        suffix = query[idx + len(body) :]
        if _substantial_leftover(suffix):
            return None
        if idx == 0:
            if suffix and static < MIN_STATIC_PREFIX:
                return None
            score = _rank_score(static, query, "", suffix, 0)
            if score <= 0:
                return None
            return score, "", suffix, (), (0, len(body)), False, ""
        if static < MIN_STATIC_INFIX:
            return None
        coverage = static / max(len(query), 1)
        if coverage < 0.25 and static < 24:
            return None
        score = _rank_score(static, query, prefix, suffix, 0)
        if score <= 0:
            return None
        return score, prefix, suffix, (), (idx, idx + len(body)), False, ""

    min_k = MIN_STATIC_PREFIX
    max_k = min(len(body) - 1, len(query))
    for k in range(max_k, min_k - 1, -1):
        frag = body[:k]
        if not query.endswith(frag):
            continue
        fidx = len(query) - k
        prefix = query[:fidx]
        remainder = body[k:]
        score = _rank_score(k, query, prefix, "", 0, truncated=True)
        if score <= 0:
            continue
        return score, prefix, "", (), (fidx, len(query)), True, remainder
    return None


def match_template(
    tmpl: Template, query: str
) -> tuple[float, str, str, tuple[tuple[str, str], ...], tuple[int, int], bool, str] | None:
    parts = tmpl.parts
    names = tmpl.hole_names
    static = tmpl.static_len
    if tmpl.holes == 0:
        return _match_static(tmpl, query)

    if (tmpl.spliced or tmpl.welded) and proving_too_thin(parts, tmpl.holes):
        return None

    min_static = MIN_STATIC_HOLE
    if tmpl.holes >= 2 and any(len(p) >= 4 for p in parts):
        min_static = 5
    concat = tmpl.spliced or tmpl.welded
    if concat and not proving_too_thin(parts, tmpl.holes):
        min_static = min(min_static, max(static, 1))
    elif tmpl.spliced and static >= 5:
        min_static = min(min_static, 5)
    if static < min_static:
        return None

    aligned = _align_parts(parts, query)
    if aligned is None:
        return None
    prefix, suffix, loc, span_start, span_end, truncated, stop_at = aligned
    first_lit = next((p for p in parts if p), "")
    leading_hole = bool(parts and parts[0] == "")
    if first_lit and len(first_lit) < 4 and static < 16 and not truncated:
        if not (concat and (leading_hole or tmpl.holes >= 2)):
            return None
    if parts[-1] and len(suffix) > max(24, static):
        return None

    bindings: list[tuple[str, str]] = []
    n_holes = len(parts) - 1
    for j in range(n_holes):
        name = names[j] if j < len(names) else str(j + 1)
        left = loc[j]
        right = loc[j + 1]
        left_full = parts[j] == "" or _lit_span(left, parts[j])
        if not left_full:
            break
        if left[0] >= 0:
            hole_start = left[1]
        elif j == 0:
            hole_start = 0
        else:
            hole_start = loc[j - 1][1] if loc[j - 1][0] >= 0 else 0
        if right[0] >= 0:
            hole_end = right[0]
            val = query[hole_start:hole_end]
            if val or _lit_span(right, parts[j + 1]):
                bindings.append((name, val))
            if not _lit_span(right, parts[j + 1]):
                break
            continue
        val = query[hole_start:]
        if val:
            bindings.append((name, val))
        break
    trailing_hole = parts[-1] == ""
    if trailing_hole and not truncated:
        suffix = ""
    if fence_closer_stuffed_in_hole(tmpl, bindings):
        return None

    matched_static = 0
    for i, part in enumerate(parts):
        a, b = loc[i]
        if a >= 0:
            matched_static += b - a
    if truncated:
        nonempty = any(v for _, v in bindings)
        if not nonempty:
            return None
        remainder = _remainder_of(tmpl, loc, stop_at)
        if incomplete_concat_leftover(tmpl, True, remainder, loc):
            return None
        if matched_static < 4 and not concat:
            return None
        score = _rank_score(
            matched_static, query, prefix, suffix, len(bindings), truncated=True
        )
        if score <= 0:
            return None
        return score, prefix, suffix, tuple(bindings), (span_start, span_end), True, remainder

    score = _rank_score(static, query, prefix, suffix, tmpl.holes)
    return score, prefix, suffix, tuple(bindings), (span_start, span_end), False, ""


def _rank_score(
    static: int,
    query: str,
    prefix: str,
    suffix: str,
    holes: int,
    truncated: bool = False,
) -> float:
    qn = max(len(query), 1)
    leftover = len(prefix) + len(suffix)
    explained = max(qn - leftover, 0) / qn
    uniqueness = min(static / qn, 1.0)
    hole_reward = 0.03 * min(holes, 7)
    score = 0.55 * explained + 0.32 * uniqueness + hole_reward + 0.10 * min(static / 40.0, 1.0)
    if leftover == 0 and holes == 0 and static == len(query) and not truncated:
        score = max(score, 1.0)
    if leftover and holes == 0 and static < MIN_STATIC_INFIX:
        return 0.0
    if truncated:
        score -= 0.04
    return min(score, 1.25)


def score_query(
    tmpl: Template, query: str, exact: bool = False, complete: bool = False
) -> Hit | None:
    if is_compiler_locator(normalize_query(query)):
        return None
    best: Hit | None = None
    for variant, penalty, tag in query_variants(query, exact=exact):
        got = match_template(tmpl, variant)
        if got is None:
            continue
        score, prefix, suffix, bindings, span, truncated, remainder = got
        if exact and (prefix or suffix or truncated):
            continue
        if complete and truncated:
            continue
        if score <= 0:
            continue
        score = max(0.0, score - penalty)
        if truncated and prefix and tag == "full":
            via = "span"
        elif truncated:
            via = "truncated"
        elif prefix and tag == "full":
            via = "span"
        else:
            via = tag
        if best is None or score > best.score:
            best = Hit(
                template=tmpl,
                score=score,
                variant=via,
                prefix=prefix,
                suffix=suffix,
                bindings=bindings,
                span=span,
                truncated=truncated,
                remainder=remainder,
            )
    return best


def search(
    templates: list[Template],
    query: str,
    min_score: float,
    limit: int,
    exact: bool = False,
    complete: bool = False,
) -> list[Hit]:
    q = normalize_query(query)
    if not q or is_compiler_locator(q):
        return []
    hits: list[Hit] = []
    for tmpl in templates:
        hit = score_query(tmpl, q, exact=exact, complete=complete)
        if hit is None or hit.score < min_score:
            continue
        if tmpl.hint_line is not None:
            dist = abs(tmpl.line - tmpl.hint_line)
            if dist == 0:
                hit.score += 0.06
            elif dist < 8:
                hit.score += 0.02
        hits.append(hit)
    if any(h.template.holes and h.bindings for h in hits):
        hits = [
            h
            for h in hits
            if not (h.template.holes == 0 and (h.suffix or "").strip())
        ]
    # Leading-hole weld `{path}: {err}` is the tail of `open {path}: {err}`,
    # not a second template for the same paste.
    displays = [h.template.display for h in hits]
    hits = [
        h
        for h in hits
        if not (
            h.template.parts
            and h.template.parts[0] == ""
            and any(other != h.template.display and other.endswith(h.template.display) for other in displays)
        )
    ]
    hits.sort(
        key=lambda h: (
            1 if (h.template.holes == 0 and _substantial_leftover(h.suffix)) else 0,
            -h.score,
            is_test_path(h.template.path),
            -h.template.holes,
            -h.template.static_len,
            h.template.path,
            h.template.line,
        )
    )
    return hits[:limit]


def _holes_field(hit: Hit) -> str:
    bound = len(hit.bindings)
    total = hit.template.holes
    if bound != total:
        return f"holes={bound}/{total}"
    return f"holes={total}"


def _unbound_names(hit: Hit) -> tuple[str, ...]:
    names = hit.template.hole_names
    return names[len(hit.bindings) :]


def format_hit(query: str, hit: Hit) -> str:
    t = hit.template
    lines = [
        f"{t.path}:{t.line}:{t.col}: score={hit.score:.2f} lang={t.lang} "
        f"{_holes_field(hit)} via={hit.variant} from={t.origin}",
        f"  query: {normalize_query(query)}",
        f"  tmpl:  {t.display}",
    ]
    for name, value in hit.bindings:
        lines.append(f"  {{{name}}} = {value}")
    unbound = _unbound_names(hit)
    if unbound:
        lines.append("  unbound: " + " ".join("{" + n + "}" for n in unbound))
    if hit.prefix:
        lines.append(f"  prefix: {hit.prefix}")
    if hit.truncated:
        lines.append(f"  truncated: {hit.remainder or 'query is a prefix of this template'}")
    if hit.span:
        lines.append(f"  span={hit.span[0]}-{hit.span[1]}")
    if hit.variant != "full" or (hit.suffix and t.holes == 0):
        extra = []
        if hit.variant != "full":
            extra.append(f"via {hit.variant}")
        if hit.suffix and t.holes == 0:
            extra.append(f"suffix={hit.suffix!r}")
        if extra:
            lines.append("  note:  " + "; ".join(extra))
    return "\n".join(lines)


def hit_json(query: str, hit: Hit) -> dict:
    t = hit.template
    return {
        "path": t.path,
        "line": t.line,
        "col": t.col,
        "lang": t.lang,
        "holes": t.holes,
        "bound": len(hit.bindings),
        "unbound": list(_unbound_names(hit)),
        "score": round(hit.score, 4),
        "via": hit.variant,
        "from": t.origin,
        "template": t.display,
        "raw": t.raw,
        "query": normalize_query(query),
        "prefix": hit.prefix,
        "suffix": hit.suffix,
        "span": list(hit.span) if hit.span else None,
        "truncated": hit.truncated,
        "remainder": hit.remainder,
        "bindings": [{"name": n, "value": v} for n, v in hit.bindings],
        "spliced": t.spliced,
        "welded": t.welded,
    }


def stdin_query_from_line(line: str) -> str | None:
    line = strip_ansi(line).rstrip()
    if SKIP_STDIN_RE.match(line):
        return None
    cleaned = normalize_query(line)
    if len(cleaned) < MIN_STATIC_HOLE:
        return None
    if is_compiler_locator(cleaned):
        return None
    return line


def iter_stdin_queries(text: str) -> list[str]:
    queries = []
    for line in text.splitlines():
        q = stdin_query_from_line(line)
        if q is not None:
            queries.append(q)
    return queries


def _decode_stdin_line(raw: bytes) -> str:
    if raw.endswith(b"\r"):
        raw = raw[:-1]
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        print("stile: binary stdin: not UTF-8", file=sys.stderr)
        raise SystemExit(2)


def iter_stdin_query_lines():
    seen = 0
    head = bytearray()
    while True:
        raw = sys.stdin.buffer.readline()
        if not raw:
            return
        if seen < 8192:
            head.extend(raw[: 8192 - seen])
            if b"\x00" in head:
                print("stile: binary stdin: NUL byte", file=sys.stderr)
                raise SystemExit(2)
        seen += len(raw)
        if raw.endswith(b"\n"):
            raw = raw[:-1]
        yield _decode_stdin_line(raw)


def die_no_walk(path: str | Path) -> None:
    print(f"stile: refusing to walk directory: {path}", file=sys.stderr)
    print(HINT, file=sys.stderr)
    raise SystemExit(2)


def fragment_to_template(text: str, path: str, line: int, lang: str) -> Template | None:
    body = text.strip()
    if body.endswith("\\"):
        body = body[:-1].rstrip()
    if not body or len(body) < MIN_STATIC_EXACT:
        return None
    if "\\(" in body or "\n" in body:
        body = swift_string_value(body)
    if "\\" in body:
        body = unescape_basic(body)
    if body.endswith("\n"):
        body = body[:-1]
    if looks_like_data_literal(body, 0):
        return None
    parts, names = tokenize_named(body)
    holes = len(names)
    if looks_like_data_literal(body, holes):
        return None
    if holes == 0 and sum(len(p) for p in parts) < MIN_STATIC_EXACT:
        return None
    return template_of(
        path=path or "-",
        line=max(line, 1),
        col=1,
        lang=lang if lang and lang != "any" else lang_for(path),
        raw=body,
        origin="fragment",
        parts=parts,
        names=names,
    )


def templates_from_text(
    text: str,
    path: str,
    lang: str,
    line: int = 1,
    origin: str = "line",
) -> list[Template]:
    found = extract_templates(text, lang or lang_for(path), path or "-", origin=origin)
    if found:
        if line > 1 and text.count("\n") == 0:
            found = [
                template_of(
                    path=t.path,
                    line=line,
                    col=t.col,
                    lang=t.lang,
                    raw=t.raw,
                    origin=t.origin,
                    parts=t.parts,
                    names=t.names,
                    hint_line=line,
                    spliced=t.spliced,
                    welded=t.welded,
                )
                for t in found
            ]
        return found
    frag = fragment_to_template(text, path, line, lang or lang_for(path))
    return [frag] if frag else []


def _file_cache() -> dict[str, list[Template]]:
    cache = getattr(_file_cache, "_c", None)
    if cache is None:
        cache = {}
        setattr(_file_cache, "_c", cache)
    return cache


def extract_from_file(
    path: Path,
    lang: str | None = None,
    display_path: str | None = None,
    hint_line: int | None = None,
) -> list[Template]:
    try:
        key = str(path.resolve())
    except OSError:
        key = str(path)
    cache = _file_cache()
    if key not in cache:
        try:
            st = path.stat()
        except OSError:
            cache[key] = []
            return []
        if st.st_size == 0 or st.st_size > MAX_FILE_BYTES:
            cache[key] = []
            return []
        try:
            data = path.read_bytes()
        except OSError:
            cache[key] = []
            return []
        if b"\x00" in data[:8192]:
            cache[key] = []
            return []
        text = data.decode("utf-8", "replace")
        use_lang = lang or lang_for(path)
        cache[key] = extract_templates(text, use_lang, key, origin="file")
    label = display_path or str(path)
    out: list[Template] = []
    for t in cache[key]:
        use_hint = hint_line if hint_line is not None else t.hint_line
        if t.path == label and t.hint_line == use_hint:
            out.append(t)
            continue
        out.append(
            template_of(
                path=label,
                line=t.line,
                col=t.col,
                lang=t.lang,
                raw=t.raw,
                origin="file",
                parts=t.parts,
                names=t.names,
                hint_line=use_hint,
                spliced=t.spliced,
                welded=t.welded,
            )
        )
    return out


def resolve_stream_path(path: str, chdir: Path | None) -> Path | None:
    if not path or path in {"-", "/dev/null"}:
        return None
    candidates = []
    p = Path(path)
    if p.is_absolute():
        candidates.append(p)
    else:
        if chdir is not None:
            candidates.append(chdir / path)
        candidates.append(p)
    for cand in candidates:
        try:
            if cand.is_dir():
                return None
            if cand.is_file():
                return cand
        except OSError:
            continue
    return None


def line_incomplete(text: str) -> bool:
    s = (text or "").rstrip()
    if s.endswith("\\"):
        return True
    if '"""' in s or "'''" in s:
        return True
    return False


def hydrate(
    tmpls: list[Template],
    path: str,
    text: str,
    origin: str,
    open_mode: str,
    chdir: Path | None,
    lang: str,
) -> list[Template]:
    if open_mode == "never":
        return tmpls
    if origin in {"patch", "raw", "index", "jsonl", "slurp"} and open_mode != "always":
        return tmpls
    if open_mode == "auto" and origin not in {"grep", "rg-json", "files", "fragment", "file"}:
        if not (tmpls and tmpls[0].origin == "fragment") and not line_incomplete(text):
            return tmpls
    resolved = resolve_stream_path(path, chdir)
    if resolved is None:
        return tmpls
    hint_line = None
    if tmpls:
        hint_line = tmpls[0].line
    opened = extract_from_file(
        resolved,
        None if lang in {"", "any", None} else lang,
        display_path=path,
        hint_line=hint_line,
    )
    return opened if opened else tmpls


def ingest_path_line(
    raw: str, default_lang: str, chdir: Path | None = None
) -> list[Template] | None:
    s = raw.strip()
    if not s:
        return []
    probe = Path(s) if Path(s).is_absolute() else ((chdir / s) if chdir is not None else Path(s))
    try:
        if probe.is_dir() or Path(s).is_dir():
            die_no_walk(probe if probe.is_dir() else Path(s))
    except OSError:
        pass
    resolved = resolve_stream_path(s, chdir)
    if resolved is None:
        return None
    if not (lang_for(resolved, default="") or default_lang not in {"", "any"}):
        return None
    return extract_from_file(
        resolved,
        None if default_lang in {"", "any"} else default_lang,
        display_path=s,
    )


def parse_json_record(line: str) -> list[Template] | None:
    try:
        obj = json.loads(line)
    except (json.JSONDecodeError, ValueError):
        return None
    if not isinstance(obj, dict):
        return None
    if obj.get("type") == "match" and isinstance(obj.get("data"), dict):
        data = obj["data"]
        path_obj = data.get("path") or {}
        path = path_obj.get("text") or path_obj.get("absolute") or ""
        line_no = int(data.get("line_number") or 1)
        text = (data.get("lines") or {}).get("text") or ""
        return templates_from_text(text.rstrip("\n"), path, lang_for(path), line_no, origin="rg-json")
    if obj.get("type") in {"begin", "end", "summary", "context"}:
        return []
    raw = obj.get("raw") or obj.get("template") or obj.get("text") or obj.get("tmpl")
    if raw is None:
        return None
    path = str(obj.get("path") or "-")
    line_no = int(obj.get("line") or 1)
    col = int(obj.get("col") or 1)
    lang = str(obj.get("lang") or lang_for(path))
    body = str(raw)
    if obj.get("template") and not obj.get("raw"):
        body = str(obj["template"])
    parts, names = tokenize_named(body)
    return [
        template_of(
            path=path,
            line=line_no,
            col=col,
            lang=lang,
            raw=body,
            origin="jsonl",
            parts=parts,
            names=names,
        )
    ]


def _patch_path_from_header(line: str) -> str:
    parts = line.split()
    if len(parts) >= 4:
        b = parts[3]
        return b[2:] if b.startswith("b/") else b
    return ""


def _index_body(body: str) -> tuple[str, bool, bool]:
    spliced = False
    welded = False
    s = body
    if s.startswith("weld "):
        s = s[5:]
        welded = True
        spliced = True
    elif s.startswith("splice "):
        s = s[7:]
        spliced = True
    return s, spliced, welded


def ingest_line(
    line: str,
    state: StreamState,
    default_lang: str,
    force: str,
    origin_label: str,
    open_mode: str = "auto",
    chdir: Path | None = None,
) -> list[Template]:
    raw = line.rstrip("\n")
    if raw.endswith("\r"):
        raw = raw[:-1]
    if not raw:
        return []

    if force == "raw":
        frag = fragment_to_template(raw, origin_label, 1, default_lang)
        return [frag] if frag else []

    if force in {"jsonl", "rg-json"} or (force == "auto" and raw[:1] == "{"):
        got = parse_json_record(raw)
        if got is not None:
            if got and got[0].origin == "rg-json":
                return hydrate(
                    got, got[0].path, raw, "rg-json", open_mode, chdir, default_lang
                )
            return got
        if force in {"jsonl", "rg-json"}:
            return []

    if force in {"auto", "index"}:
        m = INDEX_RE.match(raw)
        if m:
            body, spliced, welded = _index_body(m.group("tmpl"))
            parts, names = tokenize_named(body)
            return [
                template_of(
                    path=m.group("path"),
                    line=int(m.group("line")),
                    col=int(m.group("col")),
                    lang=m.group("lang"),
                    raw=body,
                    origin="index",
                    parts=parts,
                    names=names,
                    spliced=spliced,
                    welded=welded,
                )
            ]

    if force in {"auto", "patch"}:
        if raw.startswith("diff --git "):
            state.seen_diff = True
            state.patch_path = _patch_path_from_header(raw)
            return []
        if raw.startswith("+++ "):
            rest = raw[4:]
            if rest.startswith("b/"):
                rest = rest[2:]
            if rest != "/dev/null":
                state.patch_path = rest
            return []
        if raw.startswith("--- "):
            return []
        mh = PATCH_HUNK_RE.match(raw)
        if mh:
            state.patch_new_line = int(mh.group(2))
            return []
        if raw.startswith("+") and not raw.startswith("+++"):
            text = raw[1:]
            path = state.patch_path or origin_label
            line_no = state.patch_new_line or 1
            state.patch_new_line = line_no + 1
            tmpls = templates_from_text(
                text, path, default_lang or lang_for(path), line_no, origin="patch"
            )
            return hydrate(tmpls, path, text, "patch", open_mode, chdir, default_lang)
        if raw.startswith("-") and not raw.startswith("---"):
            return []
        if state.seen_diff and raw.startswith(" "):
            text = raw[1:]
            path = state.patch_path or origin_label
            line_no = state.patch_new_line or 1
            state.patch_new_line = line_no + 1
            tmpls = templates_from_text(
                text, path, default_lang or lang_for(path), line_no, origin="patch"
            )
            return hydrate(tmpls, path, text, "patch", open_mode, chdir, default_lang)

    if force in {"auto", "files"}:
        as_path = ingest_path_line(raw, default_lang, chdir=chdir)
        if as_path is not None:
            return as_path

    if force in {"auto", "grep"}:
        m = GREP_RE.match(raw)
        if m:
            path = m.group("path")
            exists = resolve_stream_path(path, chdir) is not None
            if force == "grep" or looks_like_source_path(path) or exists:
                line_no = int(m.group("line"))
                text = m.group("text")
                tmpls = templates_from_text(
                    text, path, default_lang or lang_for(path), line_no, origin="grep"
                )
                return hydrate(tmpls, path, text, "grep", open_mode, chdir, default_lang)

    if force == "grep":
        return []

    frag = fragment_to_template(raw, origin_label, 1, default_lang)
    out = [frag] if frag else []
    return hydrate(out, origin_label, raw, "fragment", open_mode, chdir, default_lang)


def ingest_stream(
    text: str,
    default_lang: str,
    force: str,
    origin_label: str,
    slurp: bool,
    nul: bool,
    open_mode: str = "auto",
    chdir: Path | None = None,
) -> list[Template]:
    if slurp:
        lang = default_lang if default_lang and default_lang != "any" else lang_for(origin_label)
        return extract_templates(text, lang, origin_label or "-", origin="slurp")
    records = text.split("\0") if nul else text.splitlines()
    state = StreamState()
    out: list[Template] = []
    seen: set[tuple] = set()
    for rec in records:
        if not rec:
            continue
        for t in ingest_line(
            rec, state, default_lang, force, origin_label, open_mode=open_mode, chdir=chdir
        ):
            key = (t.path, t.line, t.col, t.display)
            if key in seen:
                continue
            seen.add(key)
            out.append(t)
    return out


def load_template_spec(
    spec: str,
    default_lang: str,
    force: str,
    slurp: bool,
    nul: bool,
    stdin_holder: dict,
    open_mode: str = "auto",
    chdir: Path | None = None,
) -> list[Template]:
    if spec == "-":
        if stdin_holder.get("used"):
            print("stile: stdin already consumed (templates vs queries)", file=sys.stderr)
            raise SystemExit(2)
        stdin_holder["used"] = True
        data = sys.stdin.buffer.read()
        if nul:
            text = data.decode("utf-8", "surrogateescape")
        else:
            text = decode_bytes_or_die(data, "stdin")
        return ingest_stream(
            text, default_lang, force, "-", slurp=slurp, nul=nul, open_mode=open_mode, chdir=chdir
        )
    path = Path(spec)
    if path.is_dir():
        die_no_walk(path)
    if not path.exists():
        print(f"stile: templates not found: {path}", file=sys.stderr)
        raise SystemExit(2)
    if lang_for(path, default="") and force == "auto" and not slurp:
        return extract_from_file(path, None if default_lang in {"", "any"} else default_lang)
    data = path.read_bytes()
    if b"\x00" in data[:8192] and not nul:
        print(f"stile: binary template file: {path} (try -0)", file=sys.stderr)
        raise SystemExit(2)
    text = data.decode("utf-8", "replace")
    return ingest_stream(
        text,
        default_lang,
        force,
        str(path),
        slurp=slurp,
        nul=nul,
        open_mode=open_mode,
        chdir=chdir,
    )


def load_files_spec(
    spec: str,
    default_lang: str,
    nul: bool,
    stdin_holder: dict,
    chdir: Path | None = None,
) -> list[Template]:
    if spec == "-":
        if stdin_holder.get("used"):
            print("stile: stdin already consumed", file=sys.stderr)
            raise SystemExit(2)
        stdin_holder["used"] = True
        text = sys.stdin.buffer.read()
        parts = text.split(b"\0") if nul else text.splitlines()
        paths = [p.decode("utf-8", "surrogateescape").strip() for p in parts if p.strip()]
    else:
        p = Path(spec)
        if p.is_dir():
            die_no_walk(p)
        if p.is_file() and lang_for(p, default=""):
            return extract_from_file(p, None if default_lang in {"", "any"} else default_lang)
        print(f"stile: --files expects a path list or a source file, not {spec}", file=sys.stderr)
        raise SystemExit(2)
    out: list[Template] = []
    for raw in paths:
        if not raw:
            continue
        resolved = resolve_stream_path(raw, chdir)
        if resolved is None:
            probe = Path(raw) if Path(raw).is_absolute() else ((chdir / raw) if chdir else Path(raw))
            try:
                if probe.is_dir():
                    die_no_walk(probe)
            except OSError:
                pass
            print(f"stile: not a file: {raw}", file=sys.stderr)
            continue
        if resolved.is_dir():
            die_no_walk(resolved)
        out.extend(
            extract_from_file(
                resolved,
                None if default_lang in {"", "any"} else default_lang,
                display_path=raw,
            )
        )
    return out


def format_index(t: Template) -> str:
    extra = ""
    if t.welded:
        extra = " weld"
    elif t.spliced:
        extra = " splice"
    return (
        f"{t.path}:{t.line}:{t.col}: lang={t.lang} holes={t.holes} "
        f"static={t.static_len}{extra} {t.display}"
    )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="stile",
        description=(
            "Inverse printf of concatenations that may start at an expression. "
            "A proving string that is only a newline / fence marker / <4 "
            "distinctive static chars is not a template unless there are ≥2 "
            "expression holes. Incomplete fence leftovers refuse. No tree walk."
        ),
        epilog=HINT,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("messages", nargs="*", help="runtime message(s); '-' reads queries from stdin")
    p.add_argument(
        "-e",
        "--message",
        action="append",
        default=[],
        metavar="MSG",
        help="runtime message (repeatable; use for strings that look like flags)",
    )
    p.add_argument(
        "-t",
        "--templates",
        action="append",
        default=[],
        metavar="FILE",
        help="template stream (FILE, or - for stdin). Repeatable.",
    )
    p.add_argument(
        "--files",
        action="append",
        default=[],
        metavar="FILE",
        help="stream of source paths to extract from (FILE or -). Not a walk.",
    )
    p.add_argument(
        "--from",
        dest="from_fmt",
        default="auto",
        choices=["auto", "grep", "raw", "jsonl", "rg-json", "index", "patch", "files"],
        help="how to parse the template stream (default: auto)",
    )
    p.add_argument("--lang", default="any", help="language hint for extraction (default: from path)")
    p.add_argument("--slurp", action="store_true", help="treat the template stream as one source blob")
    p.add_argument(
        "--open",
        dest="open_mode",
        default="auto",
        choices=["auto", "always", "never"],
        help="open files named by grep/path records (auto: default; never: line-only; always: even patches)",
    )
    p.add_argument(
        "-C",
        "--chdir",
        default=None,
        metavar="DIR",
        help="resolve relative paths in the stream against DIR (does not walk DIR)",
    )
    p.add_argument("-0", "--null", action="store_true", help="NUL-separated template records / --files paths")
    p.add_argument("-n", "--max", type=int, default=DEFAULT_MAX_HITS, help="max hits per message")
    p.add_argument(
        "--min-score",
        type=float,
        default=DEFAULT_MIN_SCORE,
        help=f"minimum score (default {DEFAULT_MIN_SCORE})",
    )
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument(
        "--extract",
        action="store_true",
        help="print extracted templates and exit (re-readable as --from index / --json)",
    )
    p.add_argument("-q", "--quiet", action="store_true", help="exit status only")
    p.add_argument(
        "--any",
        action="store_true",
        help="stop after the first matching query; exit 0 if any matched",
    )
    p.add_argument(
        "--exact",
        action="store_true",
        help="refuse leftover prefix/suffix and truncated matches",
    )
    p.add_argument(
        "--complete",
        action="store_true",
        help="refuse truncated matches; span leftover is still allowed (unlike --exact)",
    )
    p.add_argument("--selftest", action="store_true", help="run built-in tests")
    p.add_argument("--version", action="store_true")
    return p


