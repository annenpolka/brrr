def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"stile {VERSION}")
        return 0
    if args.selftest:
        return run_selftest()

    chdir: Path | None = None
    if args.chdir is not None:
        chdir = Path(args.chdir)
        if not chdir.is_dir():
            print(f"stile: --chdir not a directory: {chdir}", file=sys.stderr)
            return 2

    stdin_holder = {"used": False}
    templates: list[Template] = []

    have_msgs_on_argv = bool(args.messages) or bool(args.message)
    read_query_stdin = args.messages == ["-"] or "-" in args.messages
    implicit_templates = (
        not args.templates
        and not args.files
        and not sys.stdin.isatty()
        and not read_query_stdin
        and (have_msgs_on_argv or args.extract)
    )

    if implicit_templates:
        args.templates = ["-"]

    if not args.templates and not args.files:
        print("stile: no templates (pipe a stream, or pass --templates FILE / --files FILE)", file=sys.stderr)
        print(HINT, file=sys.stderr)
        return 2

    for spec in args.templates:
        templates.extend(
            load_template_spec(
                spec,
                args.lang,
                args.from_fmt,
                slurp=args.slurp,
                nul=args.null,
                stdin_holder=stdin_holder,
                open_mode=args.open_mode,
                chdir=chdir,
            )
        )
    for spec in args.files:
        templates.extend(
            load_files_spec(
                spec, args.lang, nul=args.null, stdin_holder=stdin_holder, chdir=chdir
            )
        )

    if args.extract:
        if args.json:
            payload = [
                {
                    "path": t.path,
                    "line": t.line,
                    "col": t.col,
                    "lang": t.lang,
                    "holes": t.holes,
                    "template": t.display,
                    "raw": t.raw,
                    "static": t.static_len,
                    "from": t.origin,
                    "spliced": t.spliced,
                    "welded": t.welded,
                }
                for t in templates
            ]
            json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
            sys.stdout.write("\n")
        else:
            for t in templates:
                print(format_index(t))
        return 0

    messages: list[str] = []
    messages.extend(args.message)
    for m in args.messages:
        if m == "-":
            continue
        messages.append(m)
    stream_stdin = (
        (read_query_stdin or (not messages and not sys.stdin.isatty()))
        and not stdin_holder.get("used")
    )
    if not messages and not stream_stdin:
        print("stile: no message (pass args, -e, or pipe queries with --templates FILE)", file=sys.stderr)
        return 2

    if not templates and not args.quiet:
        extra = " (--chdir does not scan the directory)" if chdir is not None else ""
        print(f"stile: 0 templates ingested{extra}", file=sys.stderr)

    any_hit = False
    all_hit = True
    json_rows: list[dict] = []
    streamed = 0

    def emit(msg: str) -> bool:
        nonlocal all_hit
        qn = normalize_query(msg)
        if is_compiler_locator(qn):
            all_hit = False
            if args.quiet:
                return False
            if args.json:
                json_rows.append({"query": qn, "matches": [], "locator": True})
                return False
            print(f"— rustc locator, not a template query: {qn}")
            return False
        hits = search(
            templates,
            msg,
            min_score=args.min_score,
            limit=args.max,
            exact=args.exact,
            complete=args.complete,
        )
        if not hits:
            all_hit = False
            if args.any and not args.json:
                return False
        if args.quiet:
            return bool(hits)
        if args.json:
            json_rows.append(
                {
                    "query": qn,
                    "matches": [hit_json(msg, h) for h in hits],
                }
            )
            return bool(hits)
        if not hits:
            print(f"— no template for: {qn}")
            return False
        for h in hits:
            print(format_hit(msg, h))
            print()
        return True

    stop = False
    for msg in messages:
        if emit(msg):
            any_hit = True
            if args.any:
                stop = True
                break
    if not stop and stream_stdin:
        stdin_holder["used"] = True
        for line in iter_stdin_query_lines():
            q = stdin_query_from_line(line)
            if q is None:
                continue
            streamed += 1
            if emit(q):
                any_hit = True
                if args.any:
                    break

    if args.json and not args.quiet:
        json.dump(json_rows, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")

    n_queries = len(messages) + streamed
    if args.any or (not have_msgs_on_argv and n_queries > 1):
        return 0 if any_hit else 1
    return 0 if all_hit else 1


if __name__ == "__main__":
    sys.exit(main())
