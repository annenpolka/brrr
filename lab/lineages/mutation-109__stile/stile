    class _Buf:
        def __init__(self, data: bytes) -> None:
            self.data = data
            self.nread = 0

        def readline(self) -> bytes:
            self.nread += 1
            if not self.data:
                return b""
            i = self.data.find(b"\n")
            if i < 0:
                out, self.data = self.data, b""
                return out
            out, self.data = self.data[: i + 1], self.data[i + 1 :]
            return out

    class _Stdin:
        def __init__(self, data: bytes) -> None:
            self.buffer = _Buf(data)

