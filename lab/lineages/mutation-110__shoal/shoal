@dataclass
class Fingerprint:
    path: str
    line: int
    text: str
    tokens: list[str] = field(default_factory=list)
    unique: list[str] = field(default_factory=list)
    before: list[str] = field(default_factory=list)
    after: list[str] = field(default_factory=list)
    anchors: list[str] = field(default_factory=list)
    col: Optional[int] = None
    origin: Optional[str] = None

    def payload(self) -> dict:
        d: dict = {"v": 4, "p": self.path, "n": self.line, "t": self.text}
        if self.tokens:
            d["k"] = self.tokens
        if self.unique:
            d["u"] = self.unique
        if self.before:
            d["b"] = self.before
        if self.after:
            d["a"] = self.after
        if self.anchors:
            d["g"] = self.anchors
        if self.col is not None:
            d["c"] = self.col
        if self.origin:
            d["o"] = self.origin
            kid = ShoalId.decode(self.origin)
            if kid is not None:
                d["s"] = origin_sig(kid.remotes, kid.witnesses, self.path, self.line, self.text)
        return d

    @classmethod
    def from_payload(cls, d: dict) -> "Fingerprint":
        if not isinstance(d, dict) or d.get("v") not in (1, 2, 3, 4):
            raise ValueError("unsupported shoal version")
        text = d.get("t")
        path = d.get("p")
        line = d.get("n")
        if not isinstance(text, str) or not isinstance(path, str) or not isinstance(line, int):
            raise ValueError("shoal missing path/line/text")
        origin = d.get("o")
        origin_s = origin if isinstance(origin, str) and origin else None
        # v1/v3 unsigned origin is a silent --any-repo. Fail-close: drop it.
        if d.get("v") != 4:
            origin_s = None
        elif origin_s:
            kid = ShoalId.decode(origin_s)
            expect = origin_sig(
                kid.remotes if kid else (),
                kid.witnesses if kid else (),
                canon_path(path),
                line,
                text,
            )
            if d.get("s") != expect:
                origin_s = None
        return cls(
            path=canon_path(path),
            line=line,
            text=text,
            tokens=_str_list(d.get("k")),
            unique=_str_list(d.get("u")),
            before=_str_list(d.get("b")),
            after=_str_list(d.get("a")),
            anchors=_str_list(d.get("g")),
            col=d.get("c") if isinstance(d.get("c"), int) else None,
            origin=origin_s,
        )


