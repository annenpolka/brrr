def origin_sig(
    remotes: Iterable[str],
    witnesses: Iterable[str],
    path: str,
    line: int,
    text: str,
) -> str:
    """Bind mint-time remotes + required witnesses to this locus.

    Dest `git remote` config cannot satisfy the claim: the signature is
    computed at mint from the snapshot remotes, not from dest.
    """
    body = "\n".join(
        [
            ",".join(remotes),
            ",".join(witnesses),
            path,
            str(line),
            text,
        ]
    ).encode("utf-8")
    return hashlib.sha256(body).hexdigest()[:12]


@dataclass(frozen=True)
class ShoalId:
    """Signed remotes at mint time + required witnesses.

    Live dest remotes are config. Extra remotes (`git remote add`) are
    not the project. Encoded remotes are the mint-time claim.
    """

    remotes: tuple[str, ...] = ()
    witnesses: tuple[str, ...] = ()

    def encode(self) -> Optional[str]:
        if not self.remotes and not self.witnesses:
            return None
        r = ",".join(self.remotes[:MAX_REMOTES])
        w = ",".join(self.witnesses[:MAX_WITNESSES])
        return f"{ORIGIN_PREFIX}r:{r};w:{w}"

    @classmethod
    def decode(cls, raw: Optional[str]) -> Optional["ShoalId"]:
        if not raw or not isinstance(raw, str):
            return None
        if not raw.startswith(ORIGIN_PREFIX):
            return None
        body = raw[len(ORIGIN_PREFIX) :]
        r_part = ""
        w_part = ""
        if body.startswith("r:"):
            if ";w:" in body:
                r_part, w_part = body[2:].split(";w:", 1)
            else:
                r_part = body[2:]
        elif ";w:" in body:
            r_part, w_part = body.split(";w:", 1)
        else:
            return None
        # Signature, if someone stuffed it on the origin string, is not
        # part of remotes/witnesses.
        if ";s:" in w_part:
            w_part = w_part.split(";s:", 1)[0]
        remotes = [x for x in r_part.split(",") if x]
        witnesses = [x.lower() for x in w_part.split(",") if _SHA_RE.match(x.lower())]
        return cls(tuple(remotes), tuple(witnesses))


