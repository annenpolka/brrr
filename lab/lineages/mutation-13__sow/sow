def use_color(mode: str) -> bool:
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def wrap(enabled: bool, code: str, s: str) -> str:
    if not enabled:
        return s
    return f"\033[{code}m{s}\033[0m"


def rel_site(c: Call) -> str:
    return f"{c.path}:{c.line}"


def fixture_record(r: Report, f: Fixture) -> dict:
    return {
        "fn": r.fn.name,
        "qualname": r.fn.qualname,
        "def": {
            "path": r.fn.path,
            "line": r.fn.line,
            "lang": r.fn.lang,
            "params": [
                {"name": p.name, **({"default": p.default} if p.default is not None else {})}
                for p in r.fn.params
            ],
        },
        "kind": f.kind,
        "status": f.status,
        "generable": f.generable,
        "args": f.args,
        "label": f.label,
        "sites": f.sites,
        "suggest": f.suggest,
        "collection": f.collection,
        "param": f.param,
    }


def iter_fixtures(reports: list[Report], due_only: bool) -> Iterator[tuple[Report, Fixture]]:
    for r in reports:
        for f in r.fixtures:
            if due_only and f.status != "due":
                continue
            yield r, f


def render_human(reports: list[Report], color: bool, show_all: bool) -> str:
    lines: list[str] = []
    shown = 0
    for r in reports:
        due = r.due if not show_all else r.fixtures
        if not show_all and not r.due:
            continue
        shown += 1
        params = ", ".join(
            (p.name + (f"={p.default}" if p.default is not None else "")) for p in r.fn.params
        )
        nprod = sum(1 for c in r.calls if not c.is_test)
        ndue = len(r.due)
        head = f"{r.fn.qualname}  {r.fn.path}:{r.fn.line}  ({params})"
        flag = wrap(color, "31;1", f"  {ndue} due") if ndue else wrap(color, "32", "  sown")
        lines.append(wrap(color, "1", head) + flag)
        lines.append(f"  prod:{nprod}  worlds:{sum(1 for w in r.worlds if w.n_prod)}  fixtures:{ndue}")
        for g in r.members:
            miss = wrap(color, "31", fmt_vals(g.missing)) if g.missing else "[]"
            lines.append(
                f"  members {g.collection}  {g.param}  {len(g.members)}  "
                f"have={fmt_vals(g.witnessed)}  miss={miss}"
            )
        shown_fx = due if show_all else r.due
        for f in shown_fx:
            tag = wrap(color, "31" if f.status == "due" else "32", f.status)
            gen = "" if f.generable else wrap(color, "33", "  *")
            coll = f"  in {f.collection}" if f.collection else ""
            lines.append(f"  {tag:s}  {f.kind:6s}  {f.label}{coll}{gen}")
            extra = f"  {f.suggest}"
            site = ("  " + ", ".join(f.sites[:3])) if f.sites else ""
            lines.append(f"         {extra.strip()}{site}")
        lines.append("")
    if not shown:
        nfn = len(reports)
        nd = sum(len(r.due) for r in reports)
        lines.append(f"no due fixtures  prod_fns={nfn} due={nd}")
    return "\n".join(lines).rstrip() + "\n"


def render_json(reports: list[Report], due_only: bool) -> str:
    """Test-generator input: a flat fixture list plus per-function grouping."""
    fixtures = [fixture_record(r, f) for r, f in iter_fixtures(reports, due_only)]
    functions = []
    for r in reports:
        fx = [fixture_record(r, f) for f in (r.due if due_only else r.fixtures)]
        if due_only and not fx:
            continue
        functions.append(
            {
                "name": r.fn.name,
                "qualname": r.fn.qualname,
                "def": {"path": r.fn.path, "line": r.fn.line, "params": [p.name for p in r.fn.params]},
                "n_prod": sum(1 for c in r.calls if not c.is_test),
                "due": len(r.due),
                "fixtures": fx,
            }
        )
    return json.dumps({"tool": "sow", "version": VERSION, "fixtures": fixtures, "functions": functions}, indent=2, ensure_ascii=False) + "\n"


def render_ndjson(reports: list[Report], due_only: bool) -> str:
    lines = [json.dumps(fixture_record(r, f), ensure_ascii=False) for r, f in iter_fixtures(reports, due_only)]
    return "\n".join(lines) + ("\n" if lines else "")


def render_tsv(reports: list[Report], due_only: bool) -> str:
    lines = ["kind\tfn\tpath\tline\tstatus\tlabel\tsuggest"]
    for r, f in iter_fixtures(reports, due_only):
        lines.append(
            f"{f.kind}\t{r.fn.qualname}\t{r.fn.path}\t{r.fn.line}\t{f.status}\t{f.label}\t{f.suggest}"
        )
    return "\n".join(lines) + "\n"


def render_porcelain(reports: list[Report], due_only: bool = True) -> str:
    lines = []
    for r, f in iter_fixtures(reports, due_only):
        gen = "1" if f.generable else "0"
        lines.append(
            f"fixture\t{r.fn.qualname}\t{f.kind}\t{f.label}\t{gen}\t{f.suggest}\t{r.fn.path}:{r.fn.line}"
        )
    return "\n".join(lines) + ("\n" if lines else "")


def _emit_call(fn: FuncDef, args: dict) -> str:
    bits: list[str] = []
    names = [p.name for p in fn.params] or list(args)
    used = set()
    for name in names:
        if name not in args:
            continue
        used.add(name)
        a = args[name]
        kind, val = a.get("kind"), a.get("value")
        if kind == "dyn" or val is None:
            bits.append(f"{name}=..." if fn.lang == "py" else "...")
        elif fn.lang == "py":
            bits.append(f"{name}={val}")
        elif fn.lang == "swift":
            label = next((p.label or p.name for p in fn.params if p.name == name), name)
            if label == "_":
                bits.append(str(val))
            else:
                bits.append(f"{label}: {val}")
        else:
            bits.append(str(val))
    for name, a in args.items():
        if name in used:
            continue
        val = a.get("value")
        bits.append(f"{name}={val}" if val is not None else f"{name}=...")
    recv = f"{fn.recv}." if fn.recv else ""
    return f"{recv}{fn.name}({', '.join(bits)})"


def render_emit_pytest(reports: list[Report], due_only: bool = True) -> str:
    """Stub tests a generator (or a human) can fill in. Only generable due fixtures."""
    lines = [
        "# generated by sow — production argument worlds the tests do not inhabit",
        "import pytest",
        "",
    ]
    n = 0
    seen: set[str] = set()
    for r, f in iter_fixtures(reports, due_only):
        if not f.generable:
            continue
        name = f.suggest
        base, i = name, 2
        while name in seen:
            name = f"{base}_{i}"
            i += 1
        seen.add(name)
        call = _emit_call(r.fn, f.args)
        lines.append(f"def {name}():")
        lines.append(f"    # {r.fn.path}:{r.fn.line}  {f.kind}  {f.label}")
        if f.collection:
            lines.append(f"    # member of {f.collection}")
        if f.sites:
            lines.append(f"    # production: {', '.join(f.sites[:3])}")
        lines.append(f"    {call}")
        lines.append("")
        n += 1
    if n == 0:
        lines.append("# no generable due fixtures")
        lines.append("")
    return "\n".join(lines)


