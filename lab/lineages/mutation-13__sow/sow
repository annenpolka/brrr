def analyze(
    root: Path,
    exclude: list[str] | None = None,
    include_test_defs: bool = False,
) -> tuple[list[FuncDef], list[Call], list[Report]]:
    files = list_source_files(root, exclude)
    defs: list[FuncDef] = []
    calls: list[Call] = []
    collections: dict[str, dict[str, list[str]]] = {}
    for p in files:
        d, c, cols = parse_file(p, root)
        defs.extend(d)
        calls.extend(c)
        if cols:
            try:
                rel = str(p.relative_to(root))
            except ValueError:
                rel = str(p)
            collections[rel] = cols
    reports = build_reports(defs, calls, include_test_defs=include_test_defs, collections=collections)
    return defs, calls, reports


def filter_reports(
    reports: list[Report],
    names: list[str],
    min_callers: int,
    due_only: bool,
) -> list[Report]:
    out = []
    want = {n.lower() for n in names}
    for r in reports:
        nprod = sum(1 for c in r.calls if not c.is_test)
        if nprod == 0:
            continue
        if not names and nprod < min_callers:
            continue
        if want and r.fn.name.lower() not in want and r.fn.qualname.lower() not in want:
            if not any(r.fn.qualname.lower().endswith("." + n) or r.fn.qualname.lower().endswith("::" + n) for n in want):
                continue
        if due_only and not r.due:
            continue
        out.append(r)
    return out


