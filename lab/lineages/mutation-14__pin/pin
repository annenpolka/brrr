#!/usr/bin/env python3
"""pin — mint a durable fingerprint address; resolve it onto any tree.

A file:line is a locator. It dies when the file splits. A pin is the
fingerprint (line + identifiers + neighbors + path hint) so a ticket
can store the address without the SHA or the path:line.
"""
from __future__ import annotations

import argparse
import base64
import difflib
import json
import os
import re
import subprocess
import sys
import zlib
from collections import defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable, Iterator, Optional

