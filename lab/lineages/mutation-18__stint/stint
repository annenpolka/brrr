class StintError(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


def color_enabled(no_color: bool) -> bool:
    if no_color or os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return sys.stdout.isatty()


class Ink:
    def __init__(self, enabled: bool) -> None:
        self.enabled = enabled

    def _c(self, code: str, text: str) -> str:
        if not self.enabled:
            return text
        return f"\033[{code}m{text}\033[0m"

    def bold(self, t: str) -> str:
        return self._c("1", t)

    def dim(self, t: str) -> str:
        return self._c("2", t)

    def red(self, t: str) -> str:
        return self._c("31", t)

    def green(self, t: str) -> str:
        return self._c("32", t)

    def yellow(self, t: str) -> str:
        return self._c("33", t)

    def cyan(self, t: str) -> str:
        return self._c("36", t)


def git(repo: str, *args: str, check: bool = True) -> str:
    proc = subprocess.run(
        ["git", "-C", repo, "-c", "core.quotepath=false", *args],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="surrogateescape",
    )
    if check and proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip() or f"git {' '.join(args)} failed"
        raise StintError(err)
    return proc.stdout


def git_bytes(repo: str, *args: str, check: bool = True) -> bytes:
    proc = subprocess.run(
        ["git", "-C", repo, "-c", "core.quotepath=false", *args],
        capture_output=True,
    )
    if check and proc.returncode != 0:
        err = (proc.stderr or proc.stdout or b"").decode("utf-8", "replace").strip()
        raise StintError(err or f"git {' '.join(args)} failed")
    return proc.stdout


def git_ok(repo: str, *args: str) -> bool:
    proc = subprocess.run(
        ["git", "-C", repo, "-c", "core.quotepath=false", *args],
        capture_output=True,
    )
    return proc.returncode == 0


def short_sha(sha: str) -> str:
    return sha[:8] if sha else ""


def normalize_blob(sha: str) -> str:
    if not sha or set(sha) <= {"0"}:
        return ""
    return sha


@dataclass
class CommitInfo:
    sha: str
    ts: int
    subject: str


@dataclass
class Range:
    repo: str
    base: str | None
    head: str
    base_label: str
    head_label: str
    truncated: bool
    commit_count: int = 0


@dataclass
class Occupancy:
    enter: CommitInfo
    leave: CommitInfo
    died: CommitInfo | None
    blob: str
    commits: int
    paths: list[str] = field(default_factory=list)


@dataclass
class FileStint:
    path: str
    spans: list[Occupancy] = field(default_factory=list)
    aliases: list[str] = field(default_factory=list)
    bytes: int = 0

    @property
    def born(self) -> CommitInfo | None:
        return self.spans[0].enter if self.spans else None

    @property
    def leave(self) -> CommitInfo | None:
        return self.spans[-1].leave if self.spans else None

    @property
    def died(self) -> CommitInfo | None:
        return self.spans[-1].died if self.spans else None

    @property
    def blob(self) -> str:
        return self.spans[-1].blob if self.spans else ""

    @property
    def commits(self) -> int:
        return sum(s.commits for s in self.spans)


