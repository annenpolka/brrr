def _iter_json_objs(text: str) -> Iterator[dict]:
    text = text.strip()
    if not text:
        return
    if text[0] in "[{":
        try:
            data = json.loads(text)
        except json.JSONDecodeError:
            data = None
        if data is not None:
            if isinstance(data, dict):
                if "comments" in data and isinstance(data["comments"], list):
                    for o in data["comments"]:
                        if isinstance(o, dict):
                            yield o
                    return
                yield data
                return
            if isinstance(data, list):
                for o in data:
                    if isinstance(o, dict):
                        yield o
                return
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line[0] != "{":
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(o, dict):
            yield o


def parse_markdown_stream(text: str, source: str = "markdown") -> list[Claim]:
    text = _strip_cr(text)
    claims: list[Claim] = []
    path = ""
    start: int | None = None
    end: int | None = None
    pending_quote: list[str] | None = None
    lines = text.splitlines()
    i = 0
    n = len(lines)
    seq = 0

    def remember_path(p: str, a: str | None, b: str | None) -> None:
        nonlocal path, start, end
        path = p
        start = int(a) if a else None
        end = int(b) if b else start

    while i < n:
        L = lines[i]
        hm = HEADING_PATH_RE.match(L.strip())
        if hm:
            remember_path(hm.group("path"), hm.group("a"), hm.group("b"))
            i += 1
            continue
        html = HTML_PATH_RE.search(L)
        if html:
            path = html.group(1)
            i += 1
            continue
        tick = IN_TICK_PATH_RE.search(L)
        if tick:
            path = tick.group(1)
            i += 1
            continue
        pm = PATH_LINE_RE.match(L.strip().strip("`"))
        if pm and not L.strip().startswith("```"):
            remember_path(pm.group("path"), pm.group("a"), pm.group("b"))
            i += 1
            continue
        stripped = L.strip()
        if stripped.startswith("```") and not stripped.startswith("```suggestion"):
            lang = stripped[3:].strip()
            i += 1
            block: list[str] = []
            while i < n and not lines[i].strip().startswith("```"):
                block.append(lines[i])
                i += 1
            if i < n:
                i += 1
            if lang.lower() in ("", "text", "code", "diff"):
                pending_quote = block
            continue
        if stripped.startswith("```suggestion"):
            i += 1
            after: list[str] = []
            while i < n and not lines[i].strip().startswith("```"):
                after.append(lines[i])
                i += 1
            if i < n:
                i += 1
            if not path:
                i += 1 if i < n else 0
                continue
            seq += 1
            before = pending_quote if pending_quote is not None else []
            recon = "markdown-quote" if before else "markdown"
            claims.append(
                Claim(
                    id=f"md{seq}:{path}",
                    path=path,
                    before=list(before),
                    after=list(after),
                    start=start,
                    end=end,
                    recon=recon,
                    source=source,
                )
            )
            pending_quote = None
            continue
        i += 1
    return claims


def load_stream(text: str, source: str = "stream") -> list[Claim]:
    text = text.lstrip("\ufeff")
    claims: list[Claim] = []
    stripped = text.lstrip()
    looks_json = stripped[:1] in "[{"
    if looks_json:
        for obj in _iter_json_objs(text):
            claims.extend(obj_to_claims(obj, source=source))
        if claims:
            return claims
    # markdown / mixed
    md = parse_markdown_stream(text, source=source)
    if md:
        return md
    # last chance: jsonl mixed with prose
    for obj in _iter_json_objs(text):
        claims.extend(obj_to_claims(obj, source=source))
    return claims


def load_path(path: Path) -> list[Claim]:
    if str(path) == "-":
        return load_stream(sys.stdin.read(), source="stdin")
    return load_stream(path.read_text(encoding="utf-8"), source=str(path))


# ---------------------------------------------------------------------------
# occupancy matcher (hunk kernel, suggestion-sized)
# ---------------------------------------------------------------------------

def ident(s: str) -> str:
    return s


def space_norm(s: str) -> str:
    return re.sub(r"[ \t]+", " ", s).rstrip()


def apply_norm(lines: list[str], norm: Norm) -> list[str]:
    return [norm(L) for L in lines]


def find_all(hay: list[str], needle: list[str]) -> list[int]:
    if not needle:
        return []
    n = len(needle)
    hits: list[int] = []
    first = needle[0]
    start = 0
    length = len(hay)
    while start < length:
        try:
            j = hay.index(first, start)
        except ValueError:
            break
        if hay[j : j + n] == needle:
            hits.append(j)
        start = j + 1
    return hits


def is_subseq(hay: list[str], needle: list[str]) -> bool:
    if not needle:
        return False
    it = iter(hay)
    try:
        for x in needle:
            while next(it) != x:
                pass
        return True
    except StopIteration:
        return False


def significant(lines: list[str]) -> list[str]:
    out = []
    for L in lines:
        s = L.strip()
        if len(s) < 8:
            continue
        if GENERIC_RE.match(L) or GENERIC_RE.match(s):
            continue
        out.append(L)
    if out:
        return out
    return [L for L in lines if L.strip()]


def best_overlap(hay: list[str], needle: list[str], hint: int | None = None) -> tuple[float, int]:
    if not needle:
        return 1.0, 0
    if not hay:
        return 0.0, 0
    n = len(needle)
    if n > len(hay):
        hits = sum(1 for a, b in zip(needle, hay) if a == b)
        return hits / n, 0
    cands: set[int] = set()
    max_start = len(hay) - n
    if hint is not None:
        base = max(0, min(hint, max_start))
        for d in range(0, 80):
            cands.add(max(0, base - d))
            cands.add(min(max_start, base + d))
    ranked = sorted(enumerate(needle), key=lambda iv: len(iv[1]), reverse=True)[:4]
    for idx, line in ranked:
        if len(line.strip()) < 4:
            continue
        start = 0
        while True:
            try:
                j = hay.index(line, start)
            except ValueError:
                break
            cands.add(max(0, min(j - idx, max_start)))
            start = j + 1
    if not cands:
        step = max(1, n // 2)
        cands.update(range(0, max_start + 1, step))
    best_r, best_p = -1.0, 0
    for p in cands:
        window = hay[p : p + n]
        hits = sum(1 for a, b in zip(needle, window) if a == b)
        r = hits / n
        if r > best_r:
            best_r, best_p = r, p
            if r == 1.0:
                break
    return max(0.0, best_r), best_p


FUZZ_RATIO = 0.85


def overlaps_locus(
    hit: int,
    n: int,
    start: int | None,
    end: int | None,
    slack: int = 2,
) -> bool:
    """True if the block [hit, hit+n) overlaps the commented 1-indexed range.

    Slack is a couple of lines for off-by-one headers, not a hunt through
    the rest of the function. Unknown locus → every hit counts (file-wide).
    """
    if start is None and end is None:
        return True
    a = start if start is not None else end
    b = end if end is not None else start
    if a is None:
        return True
    file_lo = min(a, b) - 1 - slack
    file_hi = max(a, b) + slack
    return hit < file_hi and (hit + n) > file_lo


def unexplained(
    small_hits: list[int], big_hits: list[int], small: list[str], big: list[str]
) -> list[int]:
    if not small or not big_hits or not big:
        return list(small_hits)
    offsets = find_all(big, small)
    explained: set[int] = set()
    for bp in big_hits:
        if not offsets:
            if small == big:
                explained.add(bp)
        for off in offsets:
            explained.add(bp + off)
    return [p for p in small_hits if p not in explained]


def classify_claim(
    file_lines: list[str] | None,
    claim: Claim,
    norm: Norm,
    fuzz: bool = False,
) -> Verdict:
    path = claim.path
    header = f"@@ suggestion {claim.id} @@"

    def V(fate: str, method: str, note: str = "", **kw) -> Verdict:
        v = Verdict(
            fate=fate,
            path=path,
            claim=claim.id,
            method=method,
            header=header,
            kind=claim.kind,
            note=note,
            recon=claim.recon,
            start=claim.start,
            end=claim.end,
        )
        for k, val in kw.items():
            setattr(v, k, val)
        return v

    if not claim.path:
        return V("SKIP", "no-path")
    if not claim.before and not claim.after:
        return V("SKIP", "empty-claim")
    if claim.before and claim.after and claim.before == claim.after:
        return V("SKIP", "noop")

    if file_lines is None:
        if claim.after and not claim.before:
            return V("PENDING", "missing-create")
        if claim.before and not claim.after:
            return V("APPLIED", "missing-delete")
        return V("SUPERSEDED", "missing-file")

    hay = apply_norm(file_lines, norm)
    before = apply_norm(claim.before, norm)
    after = apply_norm(claim.after, norm)
    minus = before
    plus = after
    sig_minus = significant(minus)
    sig_plus = significant(plus)

    before_hits = find_all(hay, before) if before else []
    after_hits = find_all(hay, after) if after else []
    hint = max(0, (claim.end or claim.start or 1) - 1)
    nb, pb = best_overlap(hay, before, hint) if before else (0.0, 0)
    na, pa = best_overlap(hay, after, hint) if after else (0.0, 0)
    near_line = (pa if na >= nb else pb) + 1
    extra = dict(
        before_hits=len(before_hits),
        after_hits=len(after_hits),
        near_before=nb,
        near_after=na,
        near_line=near_line,
    )

    # delete
    if before and not after:
        if before_hits:
            return V("PENDING", "exact-before", **extra)
        if sig_minus and is_subseq(hay, sig_minus):
            return V("PENDING", "del-subseq", **extra)
        return V("APPLIED", "deleted", **extra)

    # add (no before reconstructed)
    if after and not before:
        if after_hits:
            return V("APPLIED", "exact-after", **extra)
        if sig_plus and is_subseq(hay, sig_plus):
            return V("APPLIED", "add-subseq", **extra)
        return V("PENDING", "missing-after", **extra)

    # exact blocks
    if after_hits and before_hits:
        leftover_before = unexplained(before_hits, after_hits, before, after)
        leftover_after = unexplained(after_hits, before_hits, after, before)
        if leftover_before and leftover_after:
            lb = [
                h
                for h in leftover_before
                if overlaps_locus(h, len(before), claim.start, claim.end)
            ]
            la = [
                h
                for h in leftover_after
                if overlaps_locus(h, len(after), claim.start, claim.end)
            ]
            # Review comments have a locus. A generic after-image that already
            # exists later in the same function (cli/cli `return nil, err`) is
            # not DUPLEX of *this* plea.
            if lb and not la:
                return V(
                    "PENDING",
                    "exact-before-locus",
                    note=f"before@{lb[:3]} after-elsewhere@{leftover_after[:3]}",
                    **extra,
                )
            if la and not lb:
                return V(
                    "APPLIED",
                    "exact-after-locus",
                    note=f"after@{la[:3]} before-elsewhere@{leftover_before[:3]}",
                    **extra,
                )
            if lb and la:
                return V(
                    "DUPLEX",
                    "exact-both-locus",
                    note=f"before@{lb[:3]} after@{la[:3]}",
                    **extra,
                )
            return V(
                "DUPLEX",
                "exact-both-off-locus",
                note=f"before@{leftover_before[:3]} after@{leftover_after[:3]}",
                **extra,
            )
        if after_hits and not leftover_before:
            return V("APPLIED", "exact-after", **extra)
        if before_hits and not leftover_after:
            return V("PENDING", "exact-before", **extra)
        return V("DUPLEX", "exact-both", **extra)
    if after_hits:
        return V("APPLIED", "exact-after", **extra)
    if before_hits:
        return V("PENDING", "exact-before", **extra)

    minus_sub = is_subseq(hay, sig_minus) if sig_minus else False
    plus_sub = is_subseq(hay, sig_plus) if sig_plus else False
    sig_minus_hits = find_all(hay, sig_minus) if sig_minus else []
    sig_plus_hits = find_all(hay, sig_plus) if sig_plus else []

    if sig_plus_hits and sig_minus_hits:
        if abs((sig_plus_hits[0] - sig_minus_hits[0])) > max(len(sig_plus), len(sig_minus), 3):
            return V("DUPLEX", "core-both-apart", **extra)
        return V("MIXED", "core-both-near", **extra)
    if sig_plus_hits and not minus_sub:
        return V("APPLIED", "core-plus", **extra)
    if sig_minus_hits and not plus_sub:
        return V("PENDING", "core-minus", **extra)
    if plus_sub and minus_sub:
        return V("MIXED", "subseq-both", **extra)
    if plus_sub and not minus_sub:
        return V("APPLIED", "subseq-plus", **extra)
    if minus_sub and not plus_sub:
        return V("PENDING", "subseq-minus", **extra)

    if fuzz:
        if na >= FUZZ_RATIO and nb < 0.5:
            return V("APPLIED", f"fuzz-after:{na:.2f}", **extra)
        if nb >= FUZZ_RATIO and na < 0.5:
            return V("PENDING", f"fuzz-before:{nb:.2f}", **extra)
        if sig_plus or sig_minus:
            p_ratio = (
                sum(1 for L in sig_plus if L in hay) / len(sig_plus) if sig_plus else 0.0
            )
            m_ratio = (
                sum(1 for L in sig_minus if L in hay) / len(sig_minus) if sig_minus else 0.0
            )
            if p_ratio >= 0.5 and m_ratio >= 0.5:
                return V("MIXED", f"fuzz-cores:{m_ratio:.2f}/{p_ratio:.2f}", **extra)

    # bag of change-cores: one + and one − landed independently (classic MIXED)
    if sig_plus or sig_minus:
        p_hit = sum(1 for L in sig_plus if L in hay)
        m_hit = sum(1 for L in sig_minus if L in hay)
        if p_hit and m_hit:
            return V(
                "MIXED",
                "line-bag",
                note=f"plus={p_hit}/{len(sig_plus)} minus={m_hit}/{len(sig_minus)}",
                **extra,
            )
        if p_hit and not m_hit:
            return V("APPLIED", "line-plus", **extra)
        if m_hit and not p_hit:
            return V("PENDING", "line-minus", **extra)

    return V("SUPERSEDED", "neither", **extra)


# ---------------------------------------------------------------------------
# tree IO
# ---------------------------------------------------------------------------

def git(args: list[str], cwd: Path) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(["git", *args], cwd=str(cwd), capture_output=True)


def is_git_repo(root: Path) -> bool:
    proc = git(["rev-parse", "--is-inside-work-tree"], root)
    return proc.returncode == 0 and proc.stdout.decode().strip() == "true"


def read_tree_file(root: Path, path: str, against: str | None) -> list[str] | None:
    if not path:
        return None
    if against is None:
        p = root / path
        try:
            data = p.read_bytes()
        except (FileNotFoundError, IsADirectoryError, NotADirectoryError, OSError):
            return None
        if b"\0" in data[:8192]:
            return None
        return data.decode("utf-8", "replace").splitlines()
    proc = git(["show", f"{against}:{path}"], root)
    if proc.returncode != 0:
        return None
    data = proc.stdout
    if b"\0" in data[:8192]:
        return None
    return data.decode("utf-8", "replace").splitlines()


def default_against(root: Path, explicit: str | None, worktree: bool) -> str | None:
    if worktree:
        return None
    if explicit is not None:
        return explicit
    if is_git_repo(root):
        return "HEAD"
    return None


# ---------------------------------------------------------------------------
# stream topology: collide / echo
# ---------------------------------------------------------------------------

def loci_overlap(a: Claim, b: Claim) -> bool:
    if a.path != b.path:
        return False
    if (
        a.start is not None
        and a.end is not None
        and b.start is not None
        and b.end is not None
    ):
        lo_a, hi_a = (a.start, a.end) if a.start <= a.end else (a.end, a.start)
        lo_b, hi_b = (b.start, b.end) if b.start <= b.end else (b.end, b.start)
        if not (hi_a < lo_b or hi_b < lo_a):
            return True
    sa = set(significant(a.before))
    sb = set(significant(b.before))
    if sa and sb and sa & sb:
        return True
    return False


def annotate_stream(claims: list[Claim], verdicts: list[Verdict]) -> None:
    by_id = {c.id: c for c in claims}
    for i, va in enumerate(verdicts):
        ca = by_id.get(va.claim)
        if ca is None:
            continue
        for j, vb in enumerate(verdicts):
            if i == j:
                continue
            cb = by_id.get(vb.claim)
            if cb is None:
                continue
            if not loci_overlap(ca, cb):
                continue
            if ca.after == cb.after:
                if cb.id not in va.echo:
                    va.echo.append(cb.id)
            else:
                if cb.id not in va.collide:
                    va.collide.append(cb.id)
        if va.collide and not va.note:
            va.note = "collide:" + ",".join(va.collide[:4])
        elif va.echo and not va.note:
            va.note = "echo:" + ",".join(va.echo[:4])


# ---------------------------------------------------------------------------
# reports
# ---------------------------------------------------------------------------

def material(verdicts: list[Verdict]) -> list[Verdict]:
    return [v for v in verdicts if v.fate not in SKIP_FATES]


def counted(verdicts: list[Verdict]) -> dict[str, int]:
    c: dict[str, int] = {}
    for v in verdicts:
        c[v.fate] = c.get(v.fate, 0) + 1
    return c


def unanimous(verdicts: list[Verdict]) -> str:
    s = {v.fate for v in material(verdicts)}
    if not s:
        return "EMPTY"
    if len(s) == 1:
        return next(iter(s))
    return "SPLIT"


def exit_for(uni: str) -> int:
    if uni in ("APPLIED", "EMPTY"):
        return EXIT_APPLIED
    if uni == "PENDING":
        return EXIT_PENDING
    return EXIT_SPLIT


def format_human(verdicts: list[Verdict], title: str) -> str:
    uni = unanimous(verdicts)
    c = counted(verdicts)
    bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
    n = len(material(verdicts))
    lines = [f"plea  {title}  n={n}  unanimous={uni}  {bits}"]
    for v in verdicts:
        if v.fate in SKIP_FATES:
            continue
        alias = ALIAS.get(v.fate, "")
        loc = f"{v.path}  #{v.claim}"
        extra = f"  {v.method}"
        if v.recon:
            extra += f"  recon={v.recon}"
        if v.moved_to:
            extra += f"  moved={v.moved_to}"
        if v.sandwich:
            extra += f"  then={v.sandwich}"
        if v.note:
            extra += f"  {v.note}"
        alias_s = f"  {alias}" if alias and alias != v.fate else ""
        lines.append(f"{v.fate:<11} {loc}{extra}{alias_s}")
    return "\n".join(lines) + "\n"


def format_tsv(verdicts: list[Verdict]) -> str:
    rows = [
        "fate\talias\tpath\tclaim\tmethod\trecon\tcollide\techo\tmoved\tnear_line"
    ]
    for v in verdicts:
        if v.fate in SKIP_FATES:
            continue
        rows.append(
            "\t".join(
                [
                    v.fate,
                    ALIAS.get(v.fate, v.fate),
                    v.path,
                    str(v.claim),
                    v.method,
                    v.recon,
                    ",".join(v.collide),
                    ",".join(v.echo),
                    v.moved_to or "",
                    "" if v.near_line is None else str(v.near_line),
                ]
            )
        )
    return "\n".join(rows) + "\n"


def format_json(verdicts: list[Verdict], extra: dict) -> str:
    payload = {
        **extra,
        "unanimous": unanimous(verdicts),
        "counts": counted(verdicts),
        "claims": [v.as_dict() for v in verdicts if v.fate not in SKIP_FATES],
    }
    return json.dumps(payload, ensure_ascii=False, indent=2) + "\n"


# ---------------------------------------------------------------------------
# classify a stream against a tree
# ---------------------------------------------------------------------------

def classify_stream(
    claims: list[Claim],
    root: Path,
    against: str | None,
    norm: Norm,
    fuzz: bool = False,
) -> list[Verdict]:
    cache: dict[str, list[str] | None] = {}
    verdicts: list[Verdict] = []
    for c in claims:
        if c.path not in cache:
            cache[c.path] = read_tree_file(root, c.path, against)
        verdicts.append(classify_claim(cache[c.path], c, norm, fuzz=fuzz))
    annotate_stream(claims, verdicts)
    return verdicts


def sandwich_claim(
    claim: Claim,
    root: Path,
    now: Verdict,
    norm: Norm,
    fuzz: bool,
) -> None:
    ref = claim.original_commit_id or claim.commit_id
    if not ref or not is_git_repo(root):
        return
    then_lines = read_tree_file(root, claim.path, ref)
    then = classify_claim(then_lines, claim, norm, fuzz=fuzz)
    now.sandwich = then.fate


