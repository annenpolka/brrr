HELP = """\
plea — occupancy of a review-suggestion stream against HEAD

A review comment is a before→after image claim. git apply --check does not
speak this object. GitHub "outdated" is line-identity. sate --suggest takes
every + line of diff_hunk as the before-image. plea reconstructs the
*commented range* and occupies the stream.

Usage:
  plea FILE [FILE ...]       JSON / JSONL / markdown with ```suggestion
  plea -                     stream on stdin
  gh api repos/X/Y/pulls/N/comments | plea -C repo
  plea --selftest

Tree:
  -C DIR           tree root (default: cwd)
  --against REF    read files from git REF (default: HEAD if git, else worktree)
  --worktree       occupy the dirty worktree, not HEAD

Matching:
  --ignore-space   collapse horizontal whitespace
  --fuzz           accept windows with ≥0.85 line overlap
  --sandwich       also classify each claim against its original_commit_id

Output:
  --json / --tsv / --quiet
  --report-only    always exit 0
  --only FATE      hide other fates
  --pick FATE      synonym of --only (OPEN/TAKEN/STALE aliases accepted)

Exit:
  0  unanimous APPLIED / TAKEN (or empty)
  1  unanimous PENDING / OPEN
  2  SPLIT / MIXED / DUPLEX / SUPERSEDED
  3  error
"""


def resolve_only(s: str | None) -> set[str] | None:
    if not s:
        return None
    aliases = {
        "TAKEN": "APPLIED",
        "OPEN": "PENDING",
        "STALE": "SUPERSEDED",
        "GONE": "SUPERSEDED",
    }
    out = set()
    for part in s.split(","):
        p = part.strip().upper()
        out.add(aliases.get(p, p))
    return out


def emit(verdicts: list[Verdict], args: argparse.Namespace, extra: dict) -> int:
    only = resolve_only(args.only or args.pick)
    if only:
        verdicts = [v for v in verdicts if v.fate in only or v.fate in SKIP_FATES]
    title = extra.get("title") or "stdin"
    if args.json:
        sys.stdout.write(
            format_json(verdicts, {k: v for k, v in extra.items() if k != "title"})
        )
    elif args.tsv:
        sys.stdout.write(format_tsv(verdicts))
    else:
        if not args.quiet:
            sys.stdout.write(format_human(verdicts, str(title)))
        else:
            uni = unanimous(verdicts)
            c = counted(verdicts)
            bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
            sys.stdout.write(f"{uni}\t{bits}\n")
    code = exit_for(unanimous(verdicts))
    if args.report_only:
        return 0
    return code


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="plea",
        description="Occupancy of a review-suggestion stream against HEAD",
        add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("files", nargs="*", help="JSON/JSONL/markdown review streams, or -")
    p.add_argument("-C", default=".", metavar="DIR", help="tree root")
    p.add_argument("--against", default=None, metavar="REF", help="git ref (default HEAD)")
    p.add_argument("--worktree", action="store_true", help="read dirty worktree files")
    p.add_argument("--ignore-space", action="store_true")
    p.add_argument("--fuzz", dest="fuzz", action="store_true", default=False)
    p.add_argument("--no-fuzz", dest="fuzz", action="store_false")
    p.add_argument("--sandwich", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--report-only", action="store_true")
    p.add_argument("--only", metavar="FATE[,FATE]")
    p.add_argument("--pick", metavar="FATE[,FATE]")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(HELP)
        return 0
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"plea {VERSION}")
        return 0
    if args.selftest:
        return selftest(fuzz=args.fuzz)

    texts: list[tuple[str, str]] = []
    files = list(args.files)
    if not files or files == ["-"] or (not files and not sys.stdin.isatty()):
        if files and files != ["-"] and sys.stdin.isatty():
            pass
        elif not files or files == ["-"]:
            texts.append(("stdin", sys.stdin.read()))
            files = []
    for f in files:
        if f == "-":
            texts.append(("stdin", sys.stdin.read()))
        else:
            texts.append((f, Path(f).read_text(encoding="utf-8")))

    if not texts:
        sys.stdout.write(HELP)
        return EXIT_ERROR

    claims: list[Claim] = []
    for src, text in texts:
        claims.extend(load_stream(text, source=src))

    if not claims:
        print("plea: no review suggestions in stream", file=sys.stderr)
        return 0 if args.report_only else EXIT_APPLIED

    root = Path(args.C).resolve()
    against = default_against(root, args.against, args.worktree)
    norm = space_norm if args.ignore_space else ident
    verdicts = classify_stream(claims, root, against, norm, fuzz=args.fuzz)
    if args.sandwich:
        cmap = {c.id: c for c in claims}
        for v in verdicts:
            c = cmap.get(v.claim)
            if c:
                sandwich_claim(c, root, v, norm, args.fuzz)
    title = texts[0][0] if len(texts) == 1 else f"{len(texts)} streams"
    try:
        return emit(
            verdicts,
            args,
            {
                "title": title,
                "tree": str(root),
                "against": against if against is not None else ":worktree",
                "n": len(claims),
            },
        )
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
