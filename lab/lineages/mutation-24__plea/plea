#!/usr/bin/env python3
"""plea — occupancy of a review-suggestion stream against HEAD.

sate occupies a git range / unified diff. plea occupies *review claims*.
Input is a stream of review comments (GitHub JSON/JSONL, markdown
```suggestion fences). A GitHub comment's before-image is the *commented
range* of `diff_hunk`, not every `+` line of the hunk.

Fates (same occupancy kernel as a hunk, different object):

  APPLIED     after-image is in the tree; before-image is gone   (TAKEN)
  PENDING     before-image is in the tree; after-image is absent (OPEN)
  MIXED       both change-cores are tangled in the same region
  DUPLEX      both images exist as independent blocks
  SUPERSEDED  neither image; the world moved on                 (STALE)
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Iterable, Iterator

VERSION = "0.2.0"  # 0.1 whole-file; 0.2 locus disambiguates DUPLEX

FATES = ("APPLIED", "PENDING", "MIXED", "DUPLEX", "SUPERSEDED")
SKIP_FATES = ("SKIP", "EMPTY", "NOFILE")
ALIAS = {
    "APPLIED": "TAKEN",
    "PENDING": "OPEN",
    "SUPERSEDED": "STALE",
    "MIXED": "MIXED",
    "DUPLEX": "DUPLEX",
}

EXIT_APPLIED = 0
EXIT_PENDING = 1
EXIT_SPLIT = 2
EXIT_ERROR = 3

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
SUGGEST_RE = re.compile(r"```suggestion[^\n]*\n(.*?)```", re.S)
GENERIC_RE = re.compile(
    r"^[\s{}\[\]().,:;]*$"
    r"|^\s*(else:?|end|pass|break|continue|return|fi|then|do|done|"
    r"end\.?|\);?|//|/\*|\*/|#)\s*$",
    re.I,
)
PATH_LINE_RE = re.compile(
    r"^(?:(?:path|file|filename)\s*:\s*)?+"
    r"(?P<path>(?:[\w./-]+/)*[\w./-]+\.[A-Za-z0-9+]+)"
    r"(?::(?P<a>\d+)(?:-(?P<b>\d+))?)?\s*$"
)
HEADING_PATH_RE = re.compile(
    r"^#{1,6}\s+`?(?P<path>(?:[\w./-]+/)*[\w./-]+\.[A-Za-z0-9+]+)`?"
    r"(?::(?P<a>\d+)(?:-(?P<b>\d+))?)?"
)
HTML_PATH_RE = re.compile(
    r"""<!--\s*(?:filepath|path|file)\s*:\s*([^\s>]+)""",
    re.I,
)
IN_TICK_PATH_RE = re.compile(
    r"""(?:commented on|in)\s+`([^`]+\.[A-Za-z0-9+]+)`""",
    re.I,
)

Norm = Callable[[str], str]


