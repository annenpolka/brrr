@dataclass
class Claim:
    id: str
    path: str
    before: list[str]
    after: list[str]
    side: str = "RIGHT"
    start: int | None = None
    end: int | None = None
    commit_id: str | None = None
    original_commit_id: str | None = None
    in_reply_to: str | None = None
    body: str = ""
    recon: str = ""
    source: str = ""
    kind: str = "suggestion"  # suggestion | quote


@dataclass
class Verdict:
    fate: str
    path: str
    claim: str
    method: str
    header: str = ""
    kind: str = "suggestion"
    before_hits: int = 0
    after_hits: int = 0
    near_before: float = 0.0
    near_after: float = 0.0
    near_line: int | None = None
    note: str = ""
    collide: list[str] = field(default_factory=list)
    echo: list[str] = field(default_factory=list)
    moved_to: str | None = None
    sandwich: str | None = None
    recon: str = ""
    start: int | None = None
    end: int | None = None

    def as_dict(self) -> dict:
        return {
            "fate": self.fate,
            "alias": ALIAS.get(self.fate, self.fate),
            "path": self.path,
            "claim": self.claim,
            "method": self.method,
            "header": self.header,
            "kind": self.kind,
            "before_hits": self.before_hits,
            "after_hits": self.after_hits,
            "near_before": round(self.near_before, 3),
            "near_after": round(self.near_after, 3),
            "near_line": self.near_line,
            "note": self.note,
            "collide": self.collide,
            "echo": self.echo,
            "moved_to": self.moved_to,
            "sandwich": self.sandwich,
            "recon": self.recon,
            "start": self.start,
            "end": self.end,
        }


