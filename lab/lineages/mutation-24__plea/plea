            if now[0].sandwich != "PENDING":
                raise AssertionError(now[0].sandwich)

    t("default-against-HEAD-not-worktree", sandwich_git)

    def github_json_array():
        arr = [
            {
                "id": 1,
                "path": "src/add.py",
                "side": "RIGHT",
                "original_line": 2,
                "diff_hunk": (
                    "@@ -1,2 +1,2 @@\n"
                    " def add(a, b):\n"
                    "-    return a - b\n"
                    "+    return a + b\n"
                ),
                "body": "wrap it\n```suggestion\n    return int(a + b)\n```",
            }
        ]
        claims = load_stream(json.dumps(arr))
        if claims[0].before != ["    return a + b"]:
            raise AssertionError(claims[0].before)
        if claims[0].after != ["    return int(a + b)"]:
            raise AssertionError(claims[0].after)

    t("ingest-github-array", github_json_array)

    def left_side():
        obj = {
            "id": "L",
            "path": "a.py",
            "side": "LEFT",
            "original_line": 2,
            "diff_hunk": (
                "@@ -1,3 +1,3 @@\n"
                " def f():\n"
                "-    return 1\n"
                "+    return 2\n"
                "     # end\n"
            ),
            "body": "keep old\n```suggestion\n    return 0\n```",
        }
        c = obj_to_claims(obj)[0]
        if c.before != ["    return 1"]:
            raise AssertionError(c.before)

    t("recon-left-side-deleted-line", left_side)

    print(f"selftest  {passed} passed  {failed} failed")
    return 0 if failed == 0 else 1


