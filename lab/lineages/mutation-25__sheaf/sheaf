#!/usr/bin/env python3
"""sheaf — shortest covering set of predicates, plus the walks that test them.

tell emits unary predicates that split two trees, one at a time.
sheaf's value is the *set*: a shortest cover of the delta, printed as
ready-to-run `held` / `perch` command lines.

Two trees in; a sheaf out; paste a line into the shell.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from fnmatch import fnmatch
from typing import Iterable, Sequence


class SheafError(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


# --- git -------------------------------------------------------------------


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def run(
    args: Sequence[str],
    *,
    cwd: str | None = None,
    input_bytes: bytes | None = None,
    input_text: str | None = None,
    text: bool = True,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        list(args),
        cwd=cwd,
        input=input_text if text else input_bytes,
        text=text,
        capture_output=True,
    )


def git(repo: str, *args: str, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return run(["git", "-C", repo, *args], input_text=input_text)


def git_bytes(repo: str, *args: str, input_bytes: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
    return run(
        ["git", "-C", repo, *args],
        input_bytes=input_bytes,
        text=False,
    )


def git_ok(repo: str, *args: str) -> str:
    proc = git(repo, *args)
    if proc.returncode != 0:
        msg = proc.stderr.strip() or proc.stdout.strip() or f"git {' '.join(args)} failed"
        raise SheafError(msg)
    return proc.stdout


def resolve_repo(path: str | None) -> str:
    start = os.path.abspath(path or os.getcwd())
    if not os.path.isdir(start):
        raise SheafError(f"not a directory: {start}")
    proc = run(["git", "-C", start, "rev-parse", "--show-toplevel"])
    if proc.returncode != 0:
        raise SheafError(f"not a git repository: {start}")
    return proc.stdout.strip()


# --- sides / trees ---------------------------------------------------------


@dataclass
class Side:
    spec: str
    kind: str  # commit | tree | worktree | index
    sha: str
    tree: str
    subject: str
    iso: str

    @property
    def short(self) -> str:
        if self.kind in ("worktree", "index"):
            return self.sha
        return self.sha[:7] if len(self.sha) >= 7 else self.sha


@dataclass
class Tree:
    side: Side
    paths: dict[str, str]  # path -> blob sha (or synthetic)
    blobs: dict[str, bytes]  # path -> content (text-ish; missing if skipped)


