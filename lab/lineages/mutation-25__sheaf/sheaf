IDENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]{3,}")
KEBAB_RE = re.compile(r"[A-Za-z][A-Za-z0-9]*[-][A-Za-z0-9-]*[A-Za-z0-9]")
CAMEL_SPLIT_RE = re.compile(r"[A-Z]+(?=[A-Z][a-z])|[A-Z]?[a-z]+|[A-Z]+|[0-9]+")
HEXISH_RE = re.compile(r"^[0-9a-fA-F]{8,}$")
