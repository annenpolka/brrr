#!/usr/bin/env python3
"""inlay — rewrite stale locators inside a JSON diagnostic stream.

A pure Unix filter. Never talks to git. stdin is cargo
--message-format=json, rustc --error-format=json, or any JSON log
stream. Locators live in values (span objects, file+line pairs,
strings). stdout is valid JSON with those addresses rewritten from
--from-dir onto --to-dir by content fingerprint.
"""
