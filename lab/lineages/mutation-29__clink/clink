#!/usr/bin/env python3
"""clink — compiled callers that last saw a different signature than HEAD.

Default output is signature changes at compiled/source use-sites.
Plan and markdown mentions stay behind --docs. Comments and string
literals in source files are not compiled callers. --check is the CI
verb: exit 1 if any compiled caller last saw a different signature
than HEAD. No ghost English-word ranking.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import dataclasses
import datetime as dt
import difflib
import json
import os
import re
import subprocess
import sys
from collections import defaultdict

VERSION = "0.2.0"

# Brace-span runaway (a comment `fn foo` swallowing the rest of the file).
SPAN_MAX = 160

IDENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
AT_RE = re.compile(r"^(?P<path>.+):(?P<line>\d+)$")

DEF_EXTS = {
    ".c",
    ".cc",
    ".cpp",
    ".cs",
    ".go",
    ".h",
    ".hpp",
    ".java",
    ".js",
    ".jsx",
    ".kt",
    ".kts",
    ".m",
    ".mm",
    ".php",
    ".py",
    ".rb",
    ".rs",
    ".swift",
    ".ts",
    ".tsx",
}
# Plan / markdown mentions. Opt-in via --docs; not compiled callers.
DOC_EXTS = {
    ".adoc",
    ".markdown",
    ".md",
    ".mdx",
    ".org",
    ".rst",
    ".txt",
}
DOC_DIRS = {"adr", "doc", "docs", "plan", "plans"}

# Stacked modifiers + a defining keyword + a name.
DEF_RE = re.compile(
    r"(?:^|[^A-Za-z0-9_])"
    r"(?:(?:pub(?:\([^)]*\))?|public|private|internal|fileprivate|open|"
    r"protected|static|override|final|async|export|default|abstract|"
    r"mutating|convenience|required|indirect|unowned|lazy|weak|"
    r"constexpr|inline|virtual|friend)\s+)*"
    r"(?:def|fn|func|function|class|struct|enum|trait|interface|protocol|"
    r"actor|typealias|type|namespace|union)\s+"
    r"([A-Za-z_][A-Za-z0-9_]*)"
)

# const/let/var Foo = function|/(|<  (JS/TS/Swift bindings that are defs)
BIND_RE = re.compile(
    r"(?:^|[^A-Za-z0-9_])"
    r"(?:(?:pub(?:\([^)]*\))?|public|private|internal|export|static|const|"
    r"let|var)\s+)+\s*"
    r"([A-Za-z_][A-Za-z0-9_]*)"
    r"\s*(?::[^=]+)?=\s*(?:async\s+)?(?:function\b|\(|<|\[)"
)

