    frag = "                cumulative save failed path=\\(path, privacy: .private) \\"
    got = ingest_stream(frag + "\n", "swift", "raw", "store.swift", slurp=False, nul=False)
    expect(
        got and got[0].holes == 1 and got[0].display.startswith("cumulative save failed path="),
