            chdir=Path(td),
        )
        expect(
            got_never
            and got_never[0].holes == 1
            and "error={err}" not in got_never[0].display,
            f"--open never stays a fragment: {[t.display for t in got_never]}",
        )

    nested = (
        'Logger.coreSession.info(\n'
        '    "camera presence \\(self.isCameraEnabled ? "enabled" : "disabled", privacy: .public)"\n'
        ')\n'
    )
    tmpls = extract_templates(nested, "swift", "SitboneCore.swift")
    expect(
        any(
            t.holes == 1 and t.raw.startswith("camera presence") and "enabled" in t.raw
            for t in tmpls
        ),
        f"nested swift quotes: {[t.raw for t in tmpls]}",
    )
    cam = next((t for t in tmpls if t.raw.startswith("camera presence")), None)
    if cam is not None:
        hit = score_query(cam, "camera presence enabled")
        expect(
            hit is not None and dict(hit.bindings).get("self.isCameraEnabled") == "enabled",
            f"camera bind: {hit.bindings if hit else None}",
        )

    spawn = template_of("revert.rs", 46, 18, "rust", "failed to spawn `git apply --reverse`")
    hit = score_query(
        spawn, "2026-08-19T23:50:01Z ERROR failed to spawn `git apply --reverse`"
    )
    expect(hit is not None and hit.score >= 0.34, f"prefix span score: {hit}")
    expect(
        hit is not None and "2026-08-19T23:50:01Z" in hit.prefix and "ERROR" in hit.prefix,
        f"prefix reported: {hit.prefix if hit else None}",
    )
    expect(hit is not None and hit.variant == "span", f"via span: {hit.variant if hit else None}")
    exact_hit = score_query(
        spawn,
        "2026-08-19T23:50:01Z ERROR failed to spawn `git apply --reverse`",
        exact=True,
    )
    expect(exact_hit is None, f"--exact refuses prefix: {exact_hit}")

    # --- destroyer regressions ---
    seven_trunc = "transition focused → idle reason=timeout idle=12s"
    hit = score_query(seven_t, seven_trunc)
    expect(hit is not None and hit.truncated, f"truncated 7-hole: {hit}")
    if hit is not None:
        b = dict(hit.bindings)
        expect(b.get("oldPhase.rawValue") == "focused", f"trunc from: {hit.bindings}")
        expect(b.get("newPhase.rawValue") == "idle", f"trunc to: {hit.bindings}")
        expect(b.get("reason.name") == "timeout", f"trunc reason: {hit.bindings}")
        expect(b.get("idle") == "12", f"trunc idle: {hit.bindings}")
        expect(
            "deserted" in (hit.remainder or "") and "oldPhase" not in (hit.remainder or ""),
            f"trunc remainder: {hit.remainder}",
        )
    exact_trunc = score_query(seven_t, seven_trunc, exact=True)
    expect(exact_trunc is None, f"--exact refuses truncated: {exact_trunc}")

    # Prefix-of-instance: later holes unbound. Middle-drop is not a prefix.
    prefix_idle = "transition focused → idle"
    hit = score_query(seven_t, prefix_idle)
    expect(
        hit is not None
        and hit.truncated
        and dict(hit.bindings).get("oldPhase.rawValue") == "focused"
        and dict(hit.bindings).get("newPhase.rawValue") == "idle"
        and "reason.name" not in dict(hit.bindings)
        and "idle" not in dict(hit.bindings),
        f"true prefix leaves later holes unbound: {hit.bindings if hit else None}",
    )
    drop = "transition focused → idle awayRecovered=0"
    hit = score_query(seven_t, drop)
    expect(
        hit is None,
        f"middle-drop must not stuff {{to}}: {hit.bindings if hit else None} rem={hit.remainder if hit else None}",
    )
    drop_space = "transition focused → idle awayRecovered=0 "
    hit = score_query(seven_t, drop_space)
    expect(hit is None, f"middle-drop + trailing space still not a prefix: {hit}")
    wrap = (
        "transition focused → idle reason=timeout\n"
        "idle=12s deserted=0 driftRecovered=0 awayRecovered=0"
    )
    hit = score_query(seven_t, wrap)
    expect(
        hit is None,
        f"newline wrap is not a prefix of an instance: {hit.bindings if hit else None}",
    )

    reach_t = template_of("u.py", 6, 27, "py", "cannot reach {host}:{port} after 3 retries")
    hit = score_query(reach_t, "cannot reach")
    expect(hit is None, f"first-literal prefix with no bindings is not a hit: {hit}")

    hit = score_query(seven_t, seven_trunc)
    rendered = format_hit(seven_trunc, hit) if hit else ""
    expect(
        hit is not None and "holes=4/7" in rendered,
        f"truncated header is bound/total: {rendered.splitlines()[0] if rendered else None}",
    )
    expect(
        hit is not None and "unbound: {counters.deserted.value}" in rendered,
        f"unbound later holes named: {rendered}",
    )
    expect(
        score_query(seven_t, seven_trunc, complete=True) is None,
        "--complete refuses truncated prefix",
    )

    user_t = template_of("u.py", 2, 20, "py", "user {uid} not found")
    hit = score_query(user_t, "user 42 not")
    expect(
        hit is not None
        and hit.truncated
        and dict(hit.bindings).get("uid") == "42"
        and "found" in (hit.remainder or ""),
        f"truncated user: {hit}",
    )

    spawn_hole = template_of("revert.rs", 46, 18, "rust", "failed to spawn `{cmd}`")
    hit = score_query(
        spawn_hole, "2026-08-19T23:50:01Z ERROR failed to spawn `git ap"
    )
    expect(
        hit is not None
        and hit.truncated
        and dict(hit.bindings).get("cmd") == "git ap"
        and "2026-08-19T23:50:01Z" in hit.prefix
        and "cmd" not in (hit.remainder or ""),
        f"truncated spawn binds cmd: {hit}",
    )
    span_q = "2026-08-19T23:50:01Z ERROR failed to spawn `git apply --reverse`"
    span_hit = score_query(spawn_hole, span_q, complete=True)
    expect(
        span_hit is not None
        and not span_hit.truncated
        and dict(span_hit.bindings).get("cmd") == "git apply --reverse",
        f"--complete keeps timestamp span: {span_hit}",
    )
    exact_span = score_query(spawn_hole, span_q, exact=True)
    expect(exact_span is None, "--exact still refuses span")

    loc_q = "--> src/git/revert.rs:46:18"
    expect(is_compiler_locator(loc_q), "--> is a locator")
    expect(is_compiler_locator("error[E0308]: mismatched types"), "E0308 is a locator")
    expect(not is_compiler_locator("failed to spawn `git apply --reverse`"), "spawn is not a locator")
    path_t = template_of("app.rs", 5778, 52, "rust", "src/{i}.rs")
    hit = score_query(path_t, "   --> src/git/revert.rs:46:18")
    expect(hit is None, f"locator must not bind src/{{i}}.rs: {hit}")
    expect(search([path_t], loc_q, 0.0, 5) == [], "search refuses locator")

    decoy = template_of(
        "prefix.rs", 3, 13, "rust", "2026-08-19T23:50:01Z ERROR failed to spawn"
    )
    real = template_of("prefix.rs", 7, 13, "rust", "failed to spawn `{cmd}`")
    q_spawn = "2026-08-19T23:50:01Z ERROR failed to spawn `git apply --reverse`"
    decoy_hit = score_query(decoy, q_spawn)
    expect(
        decoy_hit is None or _substantial_leftover(decoy_hit.suffix),
        f"no-hole prefix decoy should miss: {decoy_hit}",
    )
    ranked = search([decoy, real], q_spawn, min_score=0.2, limit=5)
    expect(ranked, f"holed spawn should hit: {ranked}")
    expect(
        ranked and ranked[0].template.holes == 1 and dict(ranked[0].bindings).get("cmd") == "git apply --reverse",
        f"holed source beats no-hole prefix: {[(h.template.display, h.score, h.template.holes) for h in ranked]}",
    )
    q_trunc_spawn = "2026-08-19T23:50:01Z ERROR failed to spawn `git ap"
    ranked = search([decoy, real], q_trunc_spawn, min_score=0.2, limit=5)
    expect(
        ranked
        and ranked[0].truncated
        and ranked[0].template.holes == 1
        and dict(ranked[0].bindings).get("cmd") == "git ap",
        f"truncated spawn prefers holed over short leftover decoy: {[(h.template.display, h.score, h.truncated, h.bindings) for h in ranked]}",
    )

    empty_static = template_of("events.ts", 3, 25, "js", "Event id must not be empty")
    holed_enq = template_of(
        "events.ts", 4, 25, "js", "Event id must not be empty or null when enqueueing ${id}"
    )
    q_enq = "Event id must not be empty or null when enqueueing evt-99"
    ranked = search([empty_static, holed_enq], q_enq, min_score=0.2, limit=5)
    expect(
        ranked
        and ranked[0].template.holes == 1
        and dict(ranked[0].bindings).get("id") == "evt-99",
        f"enqueue hole beats static prefix: {[(h.template.display, h.score, h.bindings) for h in ranked]}",
    )
    expect(
        score_query(empty_static, q_enq) is None,
        "static prefix of a longer paste must not hit",
    )

    _err, sys.stderr = sys.stderr, io.StringIO()
    try:
        try:
            decode_bytes_or_die(b"\x00\xff\xee random", "stdin")
            expect(False, "NUL stdin should fail closed")
        except SystemExit as e:
            expect(e.code == 2, f"NUL stdin exit {e.code}")
        try:
            decode_bytes_or_die(bytes(range(128, 256)) * 8, "stdin")
            expect(False, "non-UTF-8 stdin should fail closed")
        except SystemExit as e:
            expect(e.code == 2, f"non-UTF-8 stdin exit {e.code}")
    finally:
        sys.stderr = _err
    expect(decode_bytes_or_die(b"user 42 not found\n", "stdin") == "user 42 not found\n", "utf-8 stdin ok")

    class _Buf:
        def __init__(self, data: bytes) -> None:
            self.data = data
            self.nread = 0

        def readline(self) -> bytes:
            self.nread += 1
            if not self.data:
                return b""
            i = self.data.find(b"\n")
            if i < 0:
                out, self.data = self.data, b""
                return out
            out, self.data = self.data[: i + 1], self.data[i + 1 :]
            return out

    class _Stdin:
        def __init__(self, data: bytes) -> None:
            self.buffer = _Buf(data)

    _saved_in, sys.stdin = sys.stdin, _Stdin(
        b"ERROR [worker] user 7 not found\n" + b"MORE LINE THAT IS LONG ENOUGH\n" * 40
    )
    try:
        it = iter_stdin_query_lines()
        first = next(it)
        expect("user 7" in first, f"stream first {first!r}")
        expect(sys.stdin.buffer.nread == 1, f"one readline, got {sys.stdin.buffer.nread}")
        expect(
            sys.stdin.buffer.data.startswith(b"MORE"),
            f"unread remainder {sys.stdin.buffer.data[:24]!r}",
        )
    finally:
        sys.stdin = _saved_in

    if failures:
        for f in failures:
            print(f"FAIL: {f}", file=sys.stderr)
        print(f"{len(failures)} selftest failure(s)", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"lede {VERSION}")
        return 0
    if args.selftest:
        return run_selftest()

    chdir: Path | None = None
    if args.chdir is not None:
        chdir = Path(args.chdir)
        if not chdir.is_dir():
            print(f"lede: --chdir not a directory: {chdir}", file=sys.stderr)
            return 2

    stdin_holder = {"used": False}
    templates: list[Template] = []

    have_msgs_on_argv = bool(args.messages) or bool(args.message)
    read_query_stdin = (
        args.messages == ["-"] or "-" in args.messages
    )
    implicit_templates = (
        not args.templates
        and not args.files
        and not sys.stdin.isatty()
        and not read_query_stdin
        and (have_msgs_on_argv or args.extract)
    )

    if implicit_templates:
        args.templates = ["-"]

    if not args.templates and not args.files:
        print("lede: no templates (pipe a stream, or pass --templates FILE / --files FILE)", file=sys.stderr)
        print(HINT, file=sys.stderr)
        return 2

    for spec in args.templates:
        templates.extend(
            load_template_spec(
                spec,
                args.lang,
                args.from_fmt,
                slurp=args.slurp,
                nul=args.null,
                stdin_holder=stdin_holder,
                open_mode=args.open_mode,
                chdir=chdir,
            )
        )
    for spec in args.files:
        templates.extend(
            load_files_spec(
                spec, args.lang, nul=args.null, stdin_holder=stdin_holder, chdir=chdir
            )
        )

    if args.extract:
        if args.json:
            payload = [
                {
                    "path": t.path,
                    "line": t.line,
                    "col": t.col,
                    "lang": t.lang,
                    "holes": t.holes,
                    "template": t.display,
                    "raw": t.raw,
                    "static": t.static_len,
                    "from": t.origin,
                }
                for t in templates
            ]
            json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
            sys.stdout.write("\n")
        else:
            for t in templates:
                print(format_index(t))
        return 0

    messages: list[str] = []
    messages.extend(args.message)
    for m in args.messages:
        if m == "-":
            continue
        messages.append(m)
    stream_stdin = (
        (read_query_stdin or (not messages and not sys.stdin.isatty()))
        and not stdin_holder.get("used")
    )
    if not messages and not stream_stdin:
        print("lede: no message (pass args, -e, or pipe queries with --templates FILE)", file=sys.stderr)
        return 2

    if not templates and not args.quiet:
        extra = " (--chdir does not scan the directory)" if chdir is not None else ""
        print(f"lede: 0 templates ingested{extra}", file=sys.stderr)

    any_hit = False
    all_hit = True
    json_rows: list[dict] = []
    streamed = 0

    def emit(msg: str) -> bool:
        nonlocal all_hit
        qn = normalize_query(msg)
        if is_compiler_locator(qn):
            all_hit = False
            if args.quiet:
                return False
            if args.json:
                json_rows.append({"query": qn, "matches": [], "locator": True})
                return False
            print(f"— rustc locator, not a template query: {qn}")
            return False
        hits = search(
            templates,
            msg,
            min_score=args.min_score,
            limit=args.max,
            exact=args.exact,
            complete=args.complete,
        )
        if not hits:
            all_hit = False
            # --any is a probe: skip misses (including truncated under --complete)
            # without printing them, until a hit or EOF.
            if args.any and not args.json:
                return False
        if args.quiet:
            return bool(hits)
        if args.json:
            json_rows.append(
                {
                    "query": qn,
                    "matches": [hit_json(msg, h) for h in hits],
                }
            )
            return bool(hits)
        if not hits:
            print(f"— no template for: {qn}")
            return False
        for h in hits:
            print(format_hit(msg, h))
            print()
        return True

    stop = False
    for msg in messages:
        if emit(msg):
            any_hit = True
            if args.any:
                stop = True
                break
    if not stop and stream_stdin:
        stdin_holder["used"] = True
        for line in iter_stdin_query_lines():
            q = stdin_query_from_line(line)
            if q is None:
                continue
            streamed += 1
            if emit(q):
                any_hit = True
                if args.any:
                    break

    if args.json and not args.quiet:
        json.dump(json_rows, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")

    n_queries = len(messages) + streamed
    if args.any or (not have_msgs_on_argv and n_queries > 1):
        return 0 if any_hit else 1
    return 0 if all_hit else 1


if __name__ == "__main__":
    sys.exit(main())
