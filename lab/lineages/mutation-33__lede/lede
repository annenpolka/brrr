#!/usr/bin/env python3
"""lede — inverse printf as a Unix filter, prefix-of-instance only.

Mutation of stump: same stream contract (runtime string on argv/stdin,
templates on the other channel, no walk). A truncated log binds names
only when the query is a prefix of some instance; later holes stay
unbound. Leftover later fragments are never stuffed into the last hole.
rustc `--> path:line` is a locator, not a query. `--any` stops after
the first hit. Binary stdin fails closed.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from dataclasses import dataclass
from pathlib import Path

VERSION = "0.2.0"

SOURCE_EXTS = {
    ".rs": "rust",
    ".ts": "js",
    ".tsx": "js",
    ".js": "js",
    ".jsx": "js",
    ".mjs": "js",
    ".cjs": "js",
    ".py": "py",
    ".pyi": "py",
    ".go": "go",
    ".swift": "swift",
    ".c": "c",
    ".h": "c",
    ".hh": "c",
    ".cc": "c",
    ".cpp": "c",
    ".cxx": "c",
    ".hpp": "c",
    ".java": "java",
    ".kt": "kt",
    ".kts": "kt",
    ".rb": "rb",
    ".cs": "cs",
    ".zig": "zig",
    ".sh": "sh",
    ".bash": "sh",
    ".zsh": "sh",
}

MAX_FILE_BYTES = 2_000_000
MIN_STATIC_EXACT = 4
MIN_STATIC_PREFIX = 10
MIN_STATIC_INFIX = 16
MIN_STATIC_HOLE = 6
DEFAULT_MIN_SCORE = 0.34
DEFAULT_MAX_HITS = 5
MAX_NOHOLE_CHARS = 280
SWIFT_CONTINUATION_RE = re.compile(r"\\[ \t]*\n[ \t]*")
TEST_PATH_RE = re.compile(
    r"(?:^|/)(?:tests?|specs?|__tests__|__mocks__)(?:/|$)|"
    r"\.(?:test|spec)\.|_test\.|_tests\.|Tests/",
    re.I,
)
DATA_LITERAL_RE = re.compile(r"""^\s*[{\[]\s*(?:"|\{|\[|\d)""")
ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
PRINTF_RE = re.compile(
    r"%(?:%|[-+0 #]*\d*(?:\.\d+)?(?:hh|h|ll|l|z|j|t|L)?[sdifugGxXeEpc@voOqTwWcS])"
)
SKIP_STDIN_RE = re.compile(
    r"""(?x)
    ^\s*$
    |^(Compiling|Checking|Finished|Running|Downloading|Downloaded|
       Installing|Updating|Fetching|Resolving|Auditing)\b
    |^test\ result:
    |^running\ \d+\ tests
    |^\s*test\ .*\ \.\.\.\ (ok|ignored|FAILED)?
    |^\[created\ [^\]]+\]\s*$
    """
)
# rustc / rustc-like diagnostic locators. Inverse-printf of a runtime
# string, not of compiler grammar. `--> src/git/revert.rs:46:18` must
# not bind format!("src/{i}.rs").
COMPILER_LOCATOR_RE = re.compile(
    r"""(?x)
    ^-->\s+\S+:\d+
    |^(?:error|warning|note|help)\[E\d+\]
    |^=\s+(?:note|help|warning|error):
    |^\^\s*(?:expected|found|error)\b
    |^\^+$
    """
)
INDEX_RE = re.compile(
    r"^(?P<path>.*?):(?P<line>\d+):(?P<col>\d+):\s*"
    r"lang=(?P<lang>\S+)\s+holes=(?P<holes>\d+)\s+"
    r"(?:static=\d+\s+)?(?P<tmpl>.*)$"
)
GREP_RE = re.compile(
    r"^(?P<path>.+?):(?P<line>\d+):(?:(?P<col>\d{1,4}):)?(?P<text>.*)$"
)
PATCH_HUNK_RE = re.compile(r"^@@\s+-(\d+)(?:,\d+)?\s+\+(\d+)(?:,\d+)?\s+@@")
HINT = (
    "lede does not walk a repository. Feed it templates:\n"
    "  rg -n --type rust 'format!|anyhow!' src | lede 'runtime string'\n"
    "  rg -l --type rust 'format!' src | lede --files - 'runtime string'\n"
    "  git -C repo grep -n -e 'format!' -- '*.rs' | lede --chdir repo '…'\n"
    "  git log -p -S 'failed:' -- src | lede '…'\n"
    "  lede --templates extracted.txt --any < build.log"
)


@dataclass(frozen=True)
class Template:
    path: str
    line: int
    col: int
    lang: str
    raw: str
    parts: tuple[str, ...]
    holes: int
    origin: str = "line"
    names: tuple[str, ...] = ()
    hint_line: int | None = None

    @property
    def static_len(self) -> int:
        return sum(len(p) for p in self.parts)

    @property
    def hole_names(self) -> tuple[str, ...]:
        if self.names and len(self.names) == self.holes:
            return self.names
        return tuple(str(i + 1) for i in range(self.holes))

    @property
    def display(self) -> str:
        names = self.hole_names
        out = []
        for i, p in enumerate(self.parts):
            if i:
                name = names[i - 1] if i - 1 < len(names) else ""
                out.append("{" + name + "}")
            out.append(p.replace("\n", "\\n").replace("\t", "\\t"))
        return "".join(out)


@dataclass
class Hit:
    template: Template
    score: float
    variant: str
    prefix: str
    suffix: str
    bindings: tuple[tuple[str, str], ...] = ()
    span: tuple[int, int] | None = None
    truncated: bool = False
    remainder: str = ""


@dataclass
class StreamState:
    patch_path: str = ""
    patch_new_line: int = 0
    seen_diff: bool = False


def strip_ansi(s: str) -> str:
    return ANSI_RE.sub("", s)


def normalize_query(s: str) -> str:
    """ANSI and wrapping only. Timestamp / level prefixes are a span, not stripped."""
    s = strip_ansi(s).replace("\r\n", "\n").replace("\r", "\n")
    return s.strip()


def is_compiler_locator(q: str) -> bool:
    """True if this query is a rustc-style locator, not a printf instance."""
    s = (q or "").strip()
    if not s:
        return False
    if COMPILER_LOCATOR_RE.match(s):
        return True
    # caret / gutter lines: "   --> file:line:col" after indent strip already handled;
    # also the indented form with leading pipes.
    if s.startswith("|") and (s == "|" or set(s[1:].strip()) <= set("^~ ")):
        return True
    return False


def _substantial_leftover(s: str) -> bool:
    """Query text past a no-hole template that is more than punctuation.

    A documentation decoy that is a prefix of the paste must not hit, even
    when the leftover is short (` `git ap` on a truncated log).
    """
    t = (s or "").strip()
    if not t:
        return False
    if all(ch in ".,;:!?…\"'`)]}" for ch in t):
        return False
    return True


def decode_bytes_or_die(data: bytes, origin: str) -> str:
    """Fail closed on binary. File templates already refuse NUL; stdin must too."""
    sample = data[:8192] if data else b""
    if b"\x00" in sample:
        print(f"lede: binary {origin}: NUL byte", file=sys.stderr)
        raise SystemExit(2)
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        print(f"lede: binary {origin}: not UTF-8", file=sys.stderr)
        raise SystemExit(2)


def read_stdin_text(origin: str = "stdin") -> str:
    return decode_bytes_or_die(sys.stdin.buffer.read(), origin)


def query_variants(q: str, exact: bool = False) -> list[tuple[str, float, str]]:
    q = normalize_query(q)
    if not q:
        return []
    out = [(q, 0.0, "full")]
    if exact:
        return out
    parts = re.split(r": ", q)
    if len(parts) > 1:
        for i in range(1, len(parts)):
            suf = ": ".join(parts[i:])
            if len(suf) >= MIN_STATIC_HOLE:
                out.append((suf, 0.04 * i, f"suffix:{i}"))
    for sep, name in ((" — ", "emdash"), (" - ", "dash")):
        if sep in q:
            suf = q.split(sep, 1)[1]
            if len(suf) >= MIN_STATIC_HOLE:
                out.append((suf, 0.05, name))
    seen: set[str] = set()
    uniq = []
    for item in out:
        if item[0] in seen:
            continue
        seen.add(item[0])
        uniq.append(item)
    return uniq


def unescape_basic(s: str) -> str:
    out = []
    i = 0
    n = len(s)
    escapes = {
        "n": "\n",
        "t": "\t",
        "r": "\r",
        "0": "\0",
        "\\": "\\",
        '"': '"',
        "'": "'",
        "`": "`",
    }
    while i < n:
        if s[i] == "\\" and i + 1 < n:
            nxt = s[i + 1]
            if nxt == "(":
                out.append("\\(")
                i += 2
                continue
            if nxt in escapes:
                out.append(escapes[nxt])
                i += 2
                continue
            if nxt == "x" and i + 3 < n:
                try:
                    out.append(chr(int(s[i + 2 : i + 4], 16)))
                    i += 4
                    continue
                except ValueError:
                    pass
            out.append(nxt)
            i += 2
            continue
        out.append(s[i])
        i += 1
    return "".join(out)


def _matching_brace(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return i
        elif ch == '"' or ch == "'":
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _matching_paren(s: str, open_at: int) -> int | None:
    depth = 0
    i = open_at
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
        elif ch == '"' or ch == "'":
            q = ch
            i += 1
            while i < n:
                if s[i] == "\\":
                    i += 2
                    continue
                if s[i] == q:
                    break
                i += 1
        i += 1
    return None


def _is_format_hole(s: str, i: int) -> int | None:
    if i >= len(s) or s[i] != "{":
        return None
    n = len(s)
    j = i + 1
    if j < n and s[j] in '{"[ \n\t':
        return None
    if j < n and s[j] == "}":
        return j + 1
    if j < n and s[j].isdigit():
        while j < n and s[j].isdigit():
            j += 1
    elif j < n and (s[j].isalpha() or s[j] == "_"):
        while j < n and (s[j].isalnum() or s[j] in "_."):
            j += 1
    # Python conversion flags: {name!r} {name!s} {name!a}
    if j < n and s[j] == "!":
        j += 1
        while j < n and s[j].isalpha():
            j += 1
    if j < n and s[j] == ":":
        k = s.find("}", j)
        if k < 0:
            return None
        return k + 1
    if j < n and s[j] == "}":
        return j + 1
    return None


def _brace_hole_name(inner: str) -> str:
    inner = inner.strip()
    if not inner:
        return ""
    if "!" in inner:
        inner = inner.split("!", 1)[0]
    if ":" in inner:
        inner = inner.split(":", 1)[0]
    return inner.strip()


def _swift_hole_name(inner: str) -> str:
    """Leading identifier path; Swift Logger `privacy:` is not a name."""
    s = inner.strip()
    if not s:
        return ""
    m = re.match(
        r"((?:self\.)?[A-Za-z_][A-Za-z0-9_]*|(?:\#)[A-Za-z_][A-Za-z0-9_]*)"
        r"(?:[.#][A-Za-z_][A-Za-z0-9_]*)*",
        s,
    )
    if m:
        return m.group(0)
    return s.split(",", 1)[0].strip()[:48]


def _dollar_hole_name(inner: str) -> str:
    s = inner.strip()
    if not s:
        return ""
    return s


def _assign_hole_names(raw: list[str]) -> tuple[str, ...]:
    n = 1
    out: list[str] = []
    for name in raw:
        if name:
            out.append(name)
        else:
            out.append(str(n))
            n += 1
    return tuple(out)


def swift_string_value(raw: str) -> str:
    s = SWIFT_CONTINUATION_RE.sub("", raw)
    if "\n" not in s:
        return s
    if s.startswith("\n"):
        s = s[1:]
    lines = s.split("\n")
    while lines and not lines[-1].strip():
        lines.pop()
    while lines and not lines[0].strip():
        lines.pop(0)
    nonempty = [ln for ln in lines if ln.strip()]
    if nonempty:
        cut = min(len(ln) - len(ln.lstrip(" \t")) for ln in nonempty)
        lines = [ln[cut:] if len(ln) >= cut else ln for ln in lines]
    return "\n".join(lines).strip()


def looks_like_data_literal(body: str, holes: int) -> bool:
    if holes:
        return False
    s = body.strip()
    if len(s) >= MAX_NOHOLE_CHARS:
        return True
    if DATA_LITERAL_RE.match(s) and (":" in s or "," in s):
        return True
    return False


def is_test_path(path: str) -> bool:
    return bool(TEST_PATH_RE.search(path.replace("\\", "/")))


def tokenize_named(s: str) -> tuple[tuple[str, ...], tuple[str, ...]]:
    buf: list[str] = []
    parts: list[str] = []
    raw_names: list[str] = []
    i = 0
    n = len(s)

    def flush() -> None:
        parts.append("".join(buf))
        buf.clear()

    while i < n:
        if s.startswith("{{", i):
            buf.append("{")
            i += 2
            continue
        if s.startswith("}}", i):
            buf.append("}")
            i += 2
            continue
        if s.startswith("%%", i):
            buf.append("%")
            i += 2
            continue
        if s.startswith("${", i):
            end = _matching_brace(s, i + 1)
            if end is not None:
                flush()
                raw_names.append(_dollar_hole_name(s[i + 2 : end]))
                i = end + 1
                continue
        if s.startswith("\\(", i):
            end = _matching_paren(s, i + 1)
            if end is not None:
                flush()
                raw_names.append(_swift_hole_name(s[i + 2 : end]))
                i = end + 1
                continue
        if s[i] == "{":
            end = _is_format_hole(s, i)
            if end is not None:
                flush()
                raw_names.append(_brace_hole_name(s[i + 1 : end - 1]))
                i = end
                continue
        m = PRINTF_RE.match(s, i)
        if m:
            if m.group(0) == "%%":
                buf.append("%")
                i = m.end()
                continue
            flush()
            raw_names.append("")
            i = m.end()
            continue
        buf.append(s[i])
        i += 1
    flush()
    return tuple(parts), _assign_hole_names(raw_names)


def tokenize_template(s: str) -> tuple[tuple[str, ...], int]:
    parts, names = tokenize_named(s)
    return parts, len(names)


def template_of(
    path: str,
    line: int,
    col: int,
    lang: str,
    raw: str,
    origin: str = "line",
    parts: tuple[str, ...] | None = None,
    names: tuple[str, ...] | None = None,
    hint_line: int | None = None,
) -> Template:
    if parts is None or names is None:
        parts, names = tokenize_named(raw)
    return Template(
        path=path,
        line=line,
        col=col,
        lang=lang,
        raw=raw,
        parts=parts,
        holes=len(names),
        origin=origin,
        names=names,
        hint_line=hint_line,
    )


def _line_starts(text: str) -> list[int]:
    starts = [0]
    for i, ch in enumerate(text):
        if ch == "\n":
            starts.append(i + 1)
    return starts


def _linecol(starts: list[int], index: int) -> tuple[int, int]:
    lo, hi = 0, len(starts) - 1
    while lo <= hi:
        mid = (lo + hi) // 2
        if starts[mid] <= index:
            lo = mid + 1
        else:
            hi = mid - 1
    line_idx = hi
    return line_idx + 1, index - starts[line_idx] + 1


def _skip_line_comment(text: str, i: int) -> int:
    n = len(text)
    while i < n and text[i] != "\n":
        i += 1
    return i


def _skip_block_comment(text: str, i: int) -> int:
    n = len(text)
    i += 2
    while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
        i += 1
    return min(n, i + 2)


def _read_quoted(
    text: str, i: int, quote: str, interpolations: bool = False
) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    start = i
    while i < n:
        if interpolations and text.startswith("\\(", i):
            end = _matching_paren(text, i + 1)
            if end is None:
                return None
            i = end + 1
            continue
        ch = text[i]
        if ch == "\\":
            i += 2
            continue
        if ch == quote:
            return i + 1, text[start:i]
        if ch == "\n" and quote != "`":
            return None
        i += 1
    return None


def _read_raw_hash(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    hashes = 0
    while i < n and text[i] == "#":
        hashes += 1
        i += 1
    if i >= n or text[i] != '"':
        return None
    i += 1
    start = i
    close = '"' + ("#" * hashes)
    while i < n:
        if text.startswith(close, i):
            return i + len(close), text[start:i]
        i += 1
    return None


def _read_triple(
    text: str, i: int, quote: str, interpolations: bool = False
) -> tuple[int, str] | None:
    delim = quote * 3
    if not text.startswith(delim, i):
        return None
    i += 3
    start = i
    n = len(text)
    while i + 2 < n:
        if interpolations and text.startswith("\\(", i):
            end = _matching_paren(text, i + 1)
            if end is None:
                return None
            i = end + 1
            continue
        if text.startswith(delim, i):
            return i + 3, text[start:i]
        if text[i] == "\\":
            i += 2
            continue
        i += 1
    return None


def _read_js_template(text: str, i: int) -> tuple[int, str] | None:
    n = len(text)
    i += 1
    chunks: list[str] = []
    last = i
    depth_expr = 0
    in_expr = False
    while i < n:
        ch = text[i]
        if not in_expr:
            if ch == "\\":
                i += 2
                continue
            if ch == "`":
                chunks.append(text[last:i])
                return i + 1, "".join(chunks)
            if ch == "$" and i + 1 < n and text[i + 1] == "{":
                chunks.append(text[last:i])
                chunks.append("${")
                i += 2
                last = i
                in_expr = True
                depth_expr = 1
                continue
            i += 1
            continue
        if ch == "{":
            depth_expr += 1
        elif ch == "}":
            depth_expr -= 1
            if depth_expr == 0:
                chunks.append(text[last:i])
                chunks.append("}")
                i += 1
                last = i
                in_expr = False
                continue
        elif ch in ('"', "'", "`"):
            q = ch
            i += 1
            while i < n:
                if text[i] == "\\":
                    i += 2
                    continue
                if text[i] == q:
                    i += 1
                    break
                i += 1
            continue
        i += 1
    return None


def lang_for(path: str | Path, default: str = "any") -> str:
    suf = Path(str(path)).suffix.lower()
    return SOURCE_EXTS.get(suf, default)


def looks_like_source_path(s: str) -> bool:
    name = Path(s).name
    if name.endswith(tuple(SOURCE_EXTS)):
        return True
    if "/" in s or s.startswith("./") or s.startswith("../"):
        return Path(s).suffix.lower() in SOURCE_EXTS or bool(Path(s).suffix)
    return False


def extract_templates(text: str, lang: str, path: str, origin: str = "file") -> list[Template]:
    starts = _line_starts(text)
    n = len(text)
    i = 0
    out: list[Template] = []
    any_lang = lang in {"any", ""}
    rustish = lang == "rust" or any_lang
    pyish = lang == "py" or any_lang
    jsish = lang == "js" or any_lang
    goish = lang == "go" or any_lang
    swiftish = lang == "swift" or any_lang
    hash_comment = lang in {"py", "sh", "rb"}

    def emit(raw_inner: str, at: int, unesc: bool) -> None:
        body = raw_inner
        if lang == "swift" or (any_lang and ("\\(" in body or "\\\n" in body)):
            body = swift_string_value(body)
        if unesc:
            body = unescape_basic(body)
        if not body or body.isspace():
            return
        if body.endswith("\r\n"):
            body = body[:-2]
        elif body.endswith("\n"):
            body = body[:-1]
        if len(body.strip()) < MIN_STATIC_EXACT:
            return
        parts, names = tokenize_named(body)
        holes = len(names)
        if looks_like_data_literal(body, holes):
            return
        if holes == 0 and sum(len(p) for p in parts) < MIN_STATIC_EXACT:
            return
        line, col = _linecol(starts, at)
        out.append(
            template_of(
                path=path,
                line=line,
                col=col,
                lang=lang if lang and lang != "any" else lang_for(path),
                raw=body,
                origin=origin,
                parts=parts,
                names=names,
            )
        )

    while i < n:
        ch = text[i]
        if hash_comment and ch == "#":
            i = _skip_line_comment(text, i)
            continue
        if lang != "py" and ch == "/" and i + 1 < n:
            if text[i + 1] == "/":
                i = _skip_line_comment(text, i)
                continue
            if text[i + 1] == "*":
                i = _skip_block_comment(text, i)
                continue
        if rustish and ch in {"r", "b", "c"}:
            j = i
            if text[j] in {"b", "c"}:
                j += 1
            if j < n and text[j] == "r":
                j += 1
                got = _read_raw_hash(text, j)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=False)
                    i = end
                    continue
        if pyish and ch.isalpha():
            j = i
            while j < n and text[j] in "rRfFbBuU":
                j += 1
            if j > i and j < n and text[j] in {'"', "'"}:
                is_raw = any(c in "rR" for c in text[i:j])
                if text.startswith(text[j] * 3, j):
                    got = _read_triple(text, j, text[j], interpolations=False)
                else:
                    got = _read_quoted(text, j, text[j], interpolations=False)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=not is_raw)
                    i = end
                    continue
        if (goish or jsish) and ch == "`":
            if jsish or "${" in text[i : i + 400]:
                got = _read_js_template(text, i)
                if got:
                    end, inner = got
                    emit(inner, i, unesc=True)
                    i = end
                    continue
            if goish:
                j = text.find("`", i + 1)
                if j >= 0:
                    emit(text[i + 1 : j], i, unesc=False)
                    i = j + 1
                    continue
        if ch in {'"', "'"} and text.startswith(ch * 3, i):
            got = _read_triple(text, i, ch, interpolations=swiftish or "\\(" in text[i : i + 80])
            if got:
                end, inner = got
                emit(inner, i, unesc=True)
                i = end
                continue
        if ch == '"' or (ch == "'" and lang in {"js", "py", "sh", "rb", "go", "java", "kt", "c", "any", ""}):
            got = _read_quoted(
                text, i, ch, interpolations=swiftish or text.startswith("\\(", i + 1)
            )
            if got:
                end, inner = got
                emit(inner, i, unesc=True)
                i = end
                continue
        i += 1
    return out


def _lit_span(loc: tuple[int, int], part: str) -> bool:
    a, b = loc
    return a >= 0 and (b - a) == len(part)


def _longest_prefix_as_suffix(part: str, rest: str) -> int:
    """Longest proper prefix of `part` that is a suffix of `rest`."""
    if not part or not rest:
        return 0
    max_k = min(len(part) - 1, len(rest))
    for k in range(max_k, 0, -1):
        if rest.endswith(part[:k]):
            return k
    return 0


def _later_witnesses(parts: tuple[str, ...], from_index: int) -> tuple[str, ...]:
    """Static fragments at/after from_index that can prove a middle-drop stitch."""
    seen: list[str] = []
    for p in parts[from_index:]:
        if not p:
            continue
        if p not in seen:
            seen.append(p)
        s = p.strip()
        if s != p and len(s) >= 3 and s not in seen:
            seen.append(s)
    return tuple(seen)


def _contains_later_fragment(value: str, parts: tuple[str, ...], from_index: int) -> bool:
    """True if value swallowed a later template literal — not a hole interpolation.

    Short delimiters (`:`, backticks) are not witnesses: a truncated last hole
    like `{cmd}=git ap` must still bind.
    """
    if not value:
        return False
    for w in _later_witnesses(parts, from_index):
        if len(w) < 3:
            continue
        if w in value:
            return True
    return False


def _align_parts(
    parts: tuple[str, ...], query: str, allow_truncated: bool = True
) -> tuple[str, str, list[tuple[int, int]], int, int, bool, int] | None:
    """Locate nonempty literals as a prefix of an instance.

    Later literals must appear in order from the current position. If the next
    literal is missing, the leftover may be a hole value plus a prefix of that
    literal — never a later fragment stuffed into the hole. Middle-drop pastes
    (start + end, no middle) miss. Returns prefix, suffix, loc, span,
    truncated, stop_at (first not-fully-matched part index).
    """
    loc: list[tuple[int, int]] = [(-1, -1)] * len(parts)
    pos = 0
    first = True
    prefix = ""
    span_start = 0
    truncated = False
    stop_at = len(parts)

    for i, part in enumerate(parts):
        if part == "":
            continue
        idx = query.find(part, pos)
        if idx >= 0:
            if first:
                prefix = query[:idx]
                span_start = idx
                first = False
            loc[i] = (idx, idx + len(part))
            pos = idx + len(part)
            continue
        if not allow_truncated:
            return None
        rest = query[pos:]
        if first:
            # Query ends on a prefix of the first literal (optional leftover prefix).
            min_k = MIN_STATIC_PREFIX
            max_k = min(len(part) - 1, len(query))
            found_k = 0
            found_idx = -1
            for cand in range(max_k, min_k - 1, -1):
                frag = part[:cand]
                fidx = query.rfind(frag)
                if fidx >= 0 and fidx + cand == len(query):
                    found_k = cand
                    found_idx = fidx
                    break
            if found_k:
                loc[i] = (found_idx, found_idx + found_k)
                prefix = query[:found_idx]
                span_start = found_idx
                first = False
                truncated = True
                stop_at = i
                pos = len(query)
                break
            return None
        k = _longest_prefix_as_suffix(part, rest)
        if k > 0:
            hole_val = rest[:-k]
            if _contains_later_fragment(hole_val, parts, i):
                return None
            loc[i] = (pos + len(rest) - k, pos + len(rest))
            truncated = True
            stop_at = i
            pos = len(query)
            break
        # Next literal is absent. Leftover is a prefix iff it does not
        # contain a later static — otherwise it is a middle-drop stitch.
        if rest and _contains_later_fragment(rest, parts, i):
            return None
        truncated = True
        stop_at = i
        pos = len(query)
        break

    if first:
        return None
    if parts and parts[0] == "":
        prefix = ""
        span_start = 0
    if truncated:
        suffix = ""
        span_end = len(query)
    else:
        suffix = query[pos:] if pos <= len(query) else ""
        span_end = len(query) if parts[-1] == "" else pos
    return prefix, suffix, loc, span_start, span_end, truncated, stop_at


def _remainder_of(tmpl: Template, loc: list[tuple[int, int]], stop_at: int) -> str:
    """Unmatched template tail. Do not re-emit a hole that was already bound."""
    names = tmpl.hole_names
    parts = tmpl.parts
    if stop_at >= len(parts):
        return ""
    out: list[str] = []
    i = stop_at
    part = parts[i]
    a, b = loc[i]
    if a >= 0 and b >= 0 and (b - a) < len(part):
        out.append(part[b - a :].replace("\n", "\\n").replace("\t", "\\t"))
        i += 1
    else:
        # Literal absent: query ended in the previous hole. Start at this literal.
        out.append(part.replace("\n", "\\n").replace("\t", "\\t"))
        i += 1
    while i < len(parts):
        name = names[i - 1] if i - 1 < len(names) else str(i)
        out.append("{" + name + "}")
        out.append(parts[i].replace("\n", "\\n").replace("\t", "\\t"))
        i += 1
    return "".join(out)


def _match_static(
    tmpl: Template, query: str
) -> tuple[float, str, str, tuple[tuple[str, str], ...], tuple[int, int], bool, str] | None:
    body = tmpl.parts[0] if tmpl.parts else ""
    if not body or body.isspace():
        return None
    static = tmpl.static_len
    if body == query:
        return 1.0, "", "", (), (0, len(query)), False, ""

    idx = query.find(body)
    if idx >= 0:
        prefix = query[:idx]
        suffix = query[idx + len(body) :]
        # A no-hole template that is only a prefix of the paste is a decoy
        # (docs / log samples). Do not let it beat a holed source template.
        if _substantial_leftover(suffix):
            return None
        if idx == 0:
            if suffix and static < MIN_STATIC_PREFIX:
                return None
            score = _rank_score(static, query, "", suffix, 0)
            if score <= 0:
                return None
            return score, "", suffix, (), (0, len(body)), False, ""
        if static < MIN_STATIC_INFIX:
            return None
        coverage = static / max(len(query), 1)
        if coverage < 0.25 and static < 24:
            return None
        score = _rank_score(static, query, prefix, suffix, 0)
        if score <= 0:
            return None
        return score, prefix, suffix, (), (idx, idx + len(body)), False, ""

    # Truncated static: the query ends on a prefix of the template body
    # (optional leftover prefix such as a timestamp).
    min_k = MIN_STATIC_PREFIX
    max_k = min(len(body) - 1, len(query))
    for k in range(max_k, min_k - 1, -1):
        frag = body[:k]
        if not query.endswith(frag):
            continue
        fidx = len(query) - k
        prefix = query[:fidx]
        remainder = body[k:]
        score = _rank_score(k, query, prefix, "", 0, truncated=True)
        if score <= 0:
            continue
        return score, prefix, "", (), (fidx, len(query)), True, remainder
    return None


def match_template(
    tmpl: Template, query: str
) -> tuple[float, str, str, tuple[tuple[str, str], ...], tuple[int, int], bool, str] | None:
    parts = tmpl.parts
    names = tmpl.hole_names
    static = tmpl.static_len
    if tmpl.holes == 0:
        return _match_static(tmpl, query)

    min_static = MIN_STATIC_HOLE
    if tmpl.holes >= 2 and any(len(p) >= 4 for p in parts):
        min_static = 5
    if static < min_static:
        return None

    aligned = _align_parts(parts, query)
    if aligned is None:
        return None
    prefix, suffix, loc, span_start, span_end, truncated, stop_at = aligned
    first_lit = next((p for p in parts if p), "")
    if first_lit and len(first_lit) < 4 and static < 16 and not truncated:
        return None
    if parts[-1] and len(suffix) > max(24, static):
        return None

    bindings: list[tuple[str, str]] = []
    n_holes = len(parts) - 1
    for j in range(n_holes):
        name = names[j] if j < len(names) else str(j + 1)
        left = loc[j]
        right = loc[j + 1]
        left_full = parts[j] == "" or _lit_span(left, parts[j])
        if not left_full:
            break
        if left[0] >= 0:
            hole_start = left[1]
        elif j == 0:
            hole_start = 0
        else:
            hole_start = loc[j - 1][1] if loc[j - 1][0] >= 0 else 0
        if right[0] >= 0:
            hole_end = right[0]
            val = query[hole_start:hole_end]
            # Truncated mid-literal: do not emit an empty hole as a binding.
            # A full match may still have an empty interpolation.
            if val or _lit_span(right, parts[j + 1]):
                bindings.append((name, val))
            if not _lit_span(right, parts[j + 1]):
                break
            continue
        val = query[hole_start:]
        if val:
            bindings.append((name, val))
        break
    trailing_hole = parts[-1] == ""
    if trailing_hole and not truncated:
        suffix = ""

    matched_static = 0
    for i, part in enumerate(parts):
        a, b = loc[i]
        if a >= 0:
            matched_static += b - a
    if truncated:
        nonempty = any(v for _, v in bindings)
        # A first-literal prefix with no bindings is not inverse-printf.
        if not nonempty:
            return None
        if matched_static < 4:
            return None
        remainder = _remainder_of(tmpl, loc, stop_at)
        score = _rank_score(
            matched_static, query, prefix, suffix, len(bindings), truncated=True
        )
        if score <= 0:
            return None
        return score, prefix, suffix, tuple(bindings), (span_start, span_end), True, remainder

    score = _rank_score(static, query, prefix, suffix, tmpl.holes)
    return score, prefix, suffix, tuple(bindings), (span_start, span_end), False, ""


def _rank_score(
    static: int,
    query: str,
    prefix: str,
    suffix: str,
    holes: int,
    truncated: bool = False,
) -> float:
    """Reward query coverage and literal uniqueness. Do not tax holes.

    A 7-hole Logger line that explains the whole paste beats a 1-hole
    `error: {}` and a short static fragment that happens to be a substring.
    No-hole prefix-of-query decoys are rejected in `_match_static`.
    Truncated matches (query is a prefix of an instance) are allowed but
    score below a full instance of the same template.
    """
    qn = max(len(query), 1)
    leftover = len(prefix) + len(suffix)
    explained = max(qn - leftover, 0) / qn
    uniqueness = min(static / qn, 1.0)
    hole_reward = 0.03 * min(holes, 7)
    score = 0.55 * explained + 0.32 * uniqueness + hole_reward + 0.10 * min(static / 40.0, 1.0)
    if leftover == 0 and holes == 0 and static == len(query) and not truncated:
        score = max(score, 1.0)
    # Short static fragments as a substring of a longer paste are decoys.
    # Holed templates already have MIN_STATIC_HOLE; do not apply that floor.
    if leftover and holes == 0 and static < MIN_STATIC_INFIX:
        return 0.0
    if truncated:
        score -= 0.04
    return min(score, 1.25)


def score_query(
    tmpl: Template, query: str, exact: bool = False, complete: bool = False
) -> Hit | None:
    if is_compiler_locator(normalize_query(query)):
        return None
    best: Hit | None = None
    for variant, penalty, tag in query_variants(query, exact=exact):
        got = match_template(tmpl, variant)
        if got is None:
            continue
        score, prefix, suffix, bindings, span, truncated, remainder = got
        if exact and (prefix or suffix or truncated):
            continue
        if complete and truncated:
            continue
        if score <= 0:
            continue
        score = max(0.0, score - penalty)
        if truncated and prefix and tag == "full":
            via = "span"
        elif truncated:
            via = "truncated"
        elif prefix and tag == "full":
            via = "span"
        else:
            via = tag
        if best is None or score > best.score:
            best = Hit(
                template=tmpl,
                score=score,
                variant=via,
                prefix=prefix,
                suffix=suffix,
                bindings=bindings,
                span=span,
                truncated=truncated,
                remainder=remainder,
            )
    return best


def search(
    templates: list[Template],
    query: str,
    min_score: float,
    limit: int,
    exact: bool = False,
    complete: bool = False,
) -> list[Hit]:
    q = normalize_query(query)
    if not q or is_compiler_locator(q):
        return []
    hits: list[Hit] = []
    for tmpl in templates:
        hit = score_query(tmpl, q, exact=exact, complete=complete)
        if hit is None or hit.score < min_score:
            continue
        if tmpl.hint_line is not None:
            dist = abs(tmpl.line - tmpl.hint_line)
            if dist == 0:
                hit.score += 0.06
            elif dist < 8:
                hit.score += 0.02
        hits.append(hit)
    # A holed template that actually binds outranks a no-hole prefix of the paste.
    if any(h.template.holes and h.bindings for h in hits):
        hits = [
            h
            for h in hits
            if not (h.template.holes == 0 and (h.suffix or "").strip())
        ]
    hits.sort(
        key=lambda h: (
            1 if (h.template.holes == 0 and _substantial_leftover(h.suffix)) else 0,
            -h.score,
            is_test_path(h.template.path),
            -h.template.holes,
            -h.template.static_len,
            h.template.path,
            h.template.line,
        )
    )
    return hits[:limit]


def _holes_field(hit: Hit) -> str:
    """Template hole count, plus bound/total when later holes stayed unbound."""
    bound = len(hit.bindings)
    total = hit.template.holes
    if bound != total:
        return f"holes={bound}/{total}"
    return f"holes={total}"


def _unbound_names(hit: Hit) -> tuple[str, ...]:
    names = hit.template.hole_names
    return names[len(hit.bindings) :]


def format_hit(query: str, hit: Hit) -> str:
    t = hit.template
    lines = [
        f"{t.path}:{t.line}:{t.col}: score={hit.score:.2f} lang={t.lang} "
        f"{_holes_field(hit)} via={hit.variant} from={t.origin}",
        f"  query: {normalize_query(query)}",
        f"  tmpl:  {t.display}",
    ]
    for name, value in hit.bindings:
        lines.append(f"  {{{name}}} = {value}")
    unbound = _unbound_names(hit)
    if unbound:
        lines.append("  unbound: " + " ".join("{" + n + "}" for n in unbound))
    if hit.prefix:
        lines.append(f"  prefix: {hit.prefix}")
    if hit.truncated:
        lines.append(f"  truncated: {hit.remainder or 'query is a prefix of this template'}")
    if hit.span:
        lines.append(f"  span={hit.span[0]}-{hit.span[1]}")
    if hit.variant != "full" or (hit.suffix and t.holes == 0):
        extra = []
        if hit.variant != "full":
            extra.append(f"via {hit.variant}")
        if hit.suffix and t.holes == 0:
            extra.append(f"suffix={hit.suffix!r}")
        if extra:
            lines.append("  note:  " + "; ".join(extra))
    return "\n".join(lines)


def hit_json(query: str, hit: Hit) -> dict:
    t = hit.template
    return {
        "path": t.path,
        "line": t.line,
        "col": t.col,
        "lang": t.lang,
        "holes": t.holes,
        "bound": len(hit.bindings),
        "unbound": list(_unbound_names(hit)),
        "score": round(hit.score, 4),
        "via": hit.variant,
        "from": t.origin,
        "template": t.display,
        "raw": t.raw,
        "query": normalize_query(query),
        "prefix": hit.prefix,
        "suffix": hit.suffix,
        "span": list(hit.span) if hit.span else None,
        "truncated": hit.truncated,
        "remainder": hit.remainder,
        "bindings": [{"name": n, "value": v} for n, v in hit.bindings],
    }


def stdin_query_from_line(line: str) -> str | None:
    line = strip_ansi(line).rstrip()
    if SKIP_STDIN_RE.match(line):
        return None
    cleaned = normalize_query(line)
    if len(cleaned) < MIN_STATIC_HOLE:
        return None
    if is_compiler_locator(cleaned):
        return None
    return line


def iter_stdin_queries(text: str) -> list[str]:
    queries = []
    for line in text.splitlines():
        q = stdin_query_from_line(line)
        if q is not None:
            queries.append(q)
    return queries


def _decode_stdin_line(raw: bytes) -> str:
    if raw.endswith(b"\r"):
        raw = raw[:-1]
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        print("lede: binary stdin: not UTF-8", file=sys.stderr)
        raise SystemExit(2)


def iter_stdin_query_lines():
    """Yield stdin lines without slurping the rest of the pipe.

    Fail closed if the first 8KiB contains NUL, or if a line is not UTF-8.
    Caller may stop iterating (`--any`) and leave the remainder unread.
    """
    seen = 0
    head = bytearray()
    while True:
        raw = sys.stdin.buffer.readline()
        if not raw:
            return
        if seen < 8192:
            head.extend(raw[: 8192 - seen])
            if b"\x00" in head:
                print("lede: binary stdin: NUL byte", file=sys.stderr)
                raise SystemExit(2)
        seen += len(raw)
        if raw.endswith(b"\n"):
            raw = raw[:-1]
        yield _decode_stdin_line(raw)


def die_no_walk(path: str | Path) -> None:
    print(f"lede: refusing to walk directory: {path}", file=sys.stderr)
    print(HINT, file=sys.stderr)
    raise SystemExit(2)


def fragment_to_template(text: str, path: str, line: int, lang: str) -> Template | None:
    body = text.strip()
    if body.endswith("\\"):
        body = body[:-1].rstrip()
    if body.startswith(("+", "-", " ")) and not body.startswith(("---", "+++")):
        # leftover patch marker; callers usually strip already
        pass
    if not body or len(body) < MIN_STATIC_EXACT:
        return None
    if "\\(" in body or "\n" in body:
        body = swift_string_value(body)
    if "\\" in body:
        body = unescape_basic(body)
    if body.endswith("\n"):
        body = body[:-1]
    if looks_like_data_literal(body, 0):
        return None
    parts, names = tokenize_named(body)
    holes = len(names)
    if looks_like_data_literal(body, holes):
        return None
    if holes == 0 and sum(len(p) for p in parts) < MIN_STATIC_EXACT:
        return None
    return template_of(
        path=path or "-",
        line=max(line, 1),
        col=1,
        lang=lang if lang and lang != "any" else lang_for(path),
        raw=body,
        origin="fragment",
        parts=parts,
        names=names,
    )


def templates_from_text(
    text: str,
    path: str,
    lang: str,
    line: int = 1,
    origin: str = "line",
) -> list[Template]:
    found = extract_templates(text, lang or lang_for(path), path or "-", origin=origin)
    if found:
        if line > 1 and text.count("\n") == 0:
            # extract_templates thinks this is a one-line file; rebase to grep/patch line
            found = [
                template_of(
                    path=t.path,
                    line=line,
                    col=t.col,
                    lang=t.lang,
                    raw=t.raw,
                    origin=t.origin,
                    parts=t.parts,
                    names=t.names,
                    hint_line=line,
                )
                for t in found
            ]
        return found
    frag = fragment_to_template(text, path, line, lang or lang_for(path))
    return [frag] if frag else []


def _file_cache() -> dict[str, list[Template]]:
    cache = getattr(_file_cache, "_c", None)
    if cache is None:
        cache = {}
        setattr(_file_cache, "_c", cache)
    return cache


def extract_from_file(
    path: Path,
    lang: str | None = None,
    display_path: str | None = None,
    hint_line: int | None = None,
) -> list[Template]:
    try:
        key = str(path.resolve())
    except OSError:
        key = str(path)
    cache = _file_cache()
    if key not in cache:
        try:
            st = path.stat()
        except OSError:
            cache[key] = []
            return []
        if st.st_size == 0 or st.st_size > MAX_FILE_BYTES:
            cache[key] = []
            return []
        try:
            data = path.read_bytes()
        except OSError:
            cache[key] = []
            return []
        if b"\x00" in data[:8192]:
            cache[key] = []
            return []
        text = data.decode("utf-8", "replace")
        use_lang = lang or lang_for(path)
        cache[key] = extract_templates(text, use_lang, key, origin="file")
    label = display_path or str(path)
    out: list[Template] = []
    for t in cache[key]:
        use_hint = hint_line if hint_line is not None else t.hint_line
        if t.path == label and t.hint_line == use_hint:
            out.append(t)
            continue
        out.append(
            template_of(
                path=label,
                line=t.line,
                col=t.col,
                lang=t.lang,
                raw=t.raw,
                origin="file",
                parts=t.parts,
                names=t.names,
                hint_line=use_hint,
            )
        )
    return out


def resolve_stream_path(path: str, chdir: Path | None) -> Path | None:
    if not path or path in {"-", "/dev/null"}:
        return None
    candidates = []
    p = Path(path)
    if p.is_absolute():
        candidates.append(p)
    else:
        if chdir is not None:
            candidates.append(chdir / path)
        candidates.append(p)
    for cand in candidates:
        try:
            if cand.is_dir():
                return None
            if cand.is_file():
                return cand
        except OSError:
            continue
    return None


def line_incomplete(text: str) -> bool:
    s = (text or "").rstrip()
    if s.endswith("\\"):
        return True
    if '"""' in s or "'''" in s:
        return True
    return False


def hydrate(
    tmpls: list[Template],
    path: str,
    text: str,
    origin: str,
    open_mode: str,
    chdir: Path | None,
    lang: str,
) -> list[Template]:
    """Replace a grep/path record with templates from the named file, if we can open it.

    Patch/raw/index stay stream-pure unless --open always. auto opens files
    named by grep / rg-json / path records (the producer selected them).
    """
    if open_mode == "never":
        return tmpls
    if origin in {"patch", "raw", "index", "jsonl", "slurp"} and open_mode != "always":
        return tmpls
    if open_mode == "auto" and origin not in {"grep", "rg-json", "files", "fragment", "file"}:
        if not (tmpls and tmpls[0].origin == "fragment") and not line_incomplete(text):
            return tmpls
    resolved = resolve_stream_path(path, chdir)
    if resolved is None:
        return tmpls
    hint_line = None
    if tmpls:
        hint_line = tmpls[0].line
    opened = extract_from_file(
        resolved,
        None if lang in {"", "any", None} else lang,
        display_path=path,
        hint_line=hint_line,
    )
    return opened if opened else tmpls


def ingest_path_line(
    raw: str, default_lang: str, chdir: Path | None = None
) -> list[Template] | None:
    s = raw.strip()
    if not s:
        return []
    probe = Path(s) if Path(s).is_absolute() else ((chdir / s) if chdir is not None else Path(s))
    try:
        if probe.is_dir() or Path(s).is_dir():
            die_no_walk(probe if probe.is_dir() else Path(s))
    except OSError:
        pass
    resolved = resolve_stream_path(s, chdir)
    if resolved is None:
        return None
    if not (lang_for(resolved, default="") or default_lang not in {"", "any"}):
        return None
    return extract_from_file(
        resolved,
        None if default_lang in {"", "any"} else default_lang,
        display_path=s,
    )


def parse_json_record(line: str) -> list[Template] | None:
    try:
        obj = json.loads(line)
    except (json.JSONDecodeError, ValueError):
        return None
    if not isinstance(obj, dict):
        return None
    # rg --json
    if obj.get("type") == "match" and isinstance(obj.get("data"), dict):
        data = obj["data"]
        path_obj = data.get("path") or {}
        path = path_obj.get("text") or path_obj.get("absolute") or ""
        line_no = int(data.get("line_number") or 1)
        text = (data.get("lines") or {}).get("text") or ""
        return templates_from_text(text.rstrip("\n"), path, lang_for(path), line_no, origin="rg-json")
    if obj.get("type") in {"begin", "end", "summary", "context"}:
        return []
    raw = obj.get("raw") or obj.get("template") or obj.get("text") or obj.get("tmpl")
    if raw is None:
        return None
    path = str(obj.get("path") or "-")
    line_no = int(obj.get("line") or 1)
    col = int(obj.get("col") or 1)
    lang = str(obj.get("lang") or lang_for(path))
    body = str(raw)
    if obj.get("template") and not obj.get("raw"):
        body = str(obj["template"])
    parts, names = tokenize_named(body)
    return [
        template_of(
            path=path,
            line=line_no,
            col=col,
            lang=lang,
            raw=body,
            origin="jsonl",
            parts=parts,
            names=names,
        )
    ]


def _patch_path_from_header(line: str) -> str:
    # diff --git a/foo.rs b/foo.rs
    parts = line.split()
    if len(parts) >= 4:
        b = parts[3]
        return b[2:] if b.startswith("b/") else b
    return ""


def ingest_line(
    line: str,
    state: StreamState,
    default_lang: str,
    force: str,
    origin_label: str,
    open_mode: str = "auto",
    chdir: Path | None = None,
) -> list[Template]:
    raw = line.rstrip("\n")
    if raw.endswith("\r"):
        raw = raw[:-1]
    if not raw:
        return []

    if force == "raw":
        frag = fragment_to_template(raw, origin_label, 1, default_lang)
        return [frag] if frag else []

    if force in {"jsonl", "rg-json"} or (force == "auto" and raw[:1] == "{"):
        got = parse_json_record(raw)
        if got is not None:
            if got and got[0].origin == "rg-json":
                return hydrate(
                    got, got[0].path, raw, "rg-json", open_mode, chdir, default_lang
                )
            return got
        if force in {"jsonl", "rg-json"}:
            return []

    if force in {"auto", "index"}:
        m = INDEX_RE.match(raw)
        if m:
            body = m.group("tmpl")
            parts, names = tokenize_named(body)
            return [
                template_of(
                    path=m.group("path"),
                    line=int(m.group("line")),
                    col=int(m.group("col")),
                    lang=m.group("lang"),
                    raw=body,
                    origin="index",
                    parts=parts,
                    names=names,
                )
            ]

    # unified diff headers / hunks — keep state even in auto
    if force in {"auto", "patch"}:
        if raw.startswith("diff --git "):
            state.seen_diff = True
            state.patch_path = _patch_path_from_header(raw)
            return []
        if raw.startswith("+++ "):
            rest = raw[4:]
            if rest.startswith("b/"):
                rest = rest[2:]
            if rest != "/dev/null":
                state.patch_path = rest
            return []
        if raw.startswith("--- "):
            return []
        mh = PATCH_HUNK_RE.match(raw)
        if mh:
            state.patch_new_line = int(mh.group(2))
            return []
        if raw.startswith("+") and not raw.startswith("+++"):
            text = raw[1:]
            path = state.patch_path or origin_label
            line_no = state.patch_new_line or 1
            state.patch_new_line = line_no + 1
            tmpls = templates_from_text(
                text, path, default_lang or lang_for(path), line_no, origin="patch"
            )
            return hydrate(tmpls, path, text, "patch", open_mode, chdir, default_lang)
        if raw.startswith("-") and not raw.startswith("---"):
            return []
        if state.seen_diff and raw.startswith(" "):
            text = raw[1:]
            path = state.patch_path or origin_label
            line_no = state.patch_new_line or 1
            state.patch_new_line = line_no + 1
            tmpls = templates_from_text(
                text, path, default_lang or lang_for(path), line_no, origin="patch"
            )
            return hydrate(tmpls, path, text, "patch", open_mode, chdir, default_lang)

    if force in {"auto", "files"}:
        as_path = ingest_path_line(raw, default_lang, chdir=chdir)
        if as_path is not None:
            return as_path

    if force in {"auto", "grep"}:
        m = GREP_RE.match(raw)
        if m:
            path = m.group("path")
            exists = resolve_stream_path(path, chdir) is not None
            if force == "grep" or looks_like_source_path(path) or exists:
                line_no = int(m.group("line"))
                text = m.group("text")
                tmpls = templates_from_text(
                    text, path, default_lang or lang_for(path), line_no, origin="grep"
                )
                return hydrate(tmpls, path, text, "grep", open_mode, chdir, default_lang)

    if force == "grep":
        return []

    frag = fragment_to_template(raw, origin_label, 1, default_lang)
    out = [frag] if frag else []
    return hydrate(out, origin_label, raw, "fragment", open_mode, chdir, default_lang)


def ingest_stream(
    text: str,
    default_lang: str,
    force: str,
    origin_label: str,
    slurp: bool,
    nul: bool,
    open_mode: str = "auto",
    chdir: Path | None = None,
) -> list[Template]:
    if slurp:
        lang = default_lang if default_lang and default_lang != "any" else lang_for(origin_label)
        return extract_templates(text, lang, origin_label or "-", origin="slurp")
    records = text.split("\0") if nul else text.splitlines()
    state = StreamState()
    out: list[Template] = []
    seen: set[tuple] = set()
    for rec in records:
        if not rec:
            continue
        for t in ingest_line(
            rec, state, default_lang, force, origin_label, open_mode=open_mode, chdir=chdir
        ):
            key = (t.path, t.line, t.col, t.display)
            if key in seen:
                continue
            seen.add(key)
            out.append(t)
    return out


def load_template_spec(
    spec: str,
    default_lang: str,
    force: str,
    slurp: bool,
    nul: bool,
    stdin_holder: dict,
    open_mode: str = "auto",
    chdir: Path | None = None,
) -> list[Template]:
    if spec == "-":
        if stdin_holder.get("used"):
            print("lede: stdin already consumed (templates vs queries)", file=sys.stderr)
            raise SystemExit(2)
        stdin_holder["used"] = True
        data = sys.stdin.buffer.read()
        if nul:
            text = data.decode("utf-8", "surrogateescape")
        else:
            text = decode_bytes_or_die(data, "stdin")
        return ingest_stream(
            text, default_lang, force, "-", slurp=slurp, nul=nul, open_mode=open_mode, chdir=chdir
        )
    path = Path(spec)
    if path.is_dir():
        die_no_walk(path)
    if not path.exists():
        print(f"lede: templates not found: {path}", file=sys.stderr)
        raise SystemExit(2)
    # A source file given as --templates is a slurp, not a line stream.
    if lang_for(path, default="") and force == "auto" and not slurp:
        return extract_from_file(path, None if default_lang in {"", "any"} else default_lang)
    data = path.read_bytes()
    if b"\x00" in data[:8192] and not nul:
        print(f"lede: binary template file: {path} (try -0)", file=sys.stderr)
        raise SystemExit(2)
    text = data.decode("utf-8", "replace")
    return ingest_stream(
        text,
        default_lang,
        force,
        str(path),
        slurp=slurp,
        nul=nul,
        open_mode=open_mode,
        chdir=chdir,
    )


def load_files_spec(
    spec: str,
    default_lang: str,
    nul: bool,
    stdin_holder: dict,
    chdir: Path | None = None,
) -> list[Template]:
    if spec == "-":
        if stdin_holder.get("used"):
            print("lede: stdin already consumed", file=sys.stderr)
            raise SystemExit(2)
        stdin_holder["used"] = True
        text = sys.stdin.buffer.read()
        parts = text.split(b"\0") if nul else text.splitlines()
        paths = [p.decode("utf-8", "surrogateescape").strip() for p in parts if p.strip()]
    else:
        p = Path(spec)
        if p.is_dir():
            die_no_walk(p)
        if p.is_file() and lang_for(p, default=""):
            return extract_from_file(p, None if default_lang in {"", "any"} else default_lang)
        print(f"lede: --files expects a path list or a source file, not {spec}", file=sys.stderr)
        raise SystemExit(2)
    out: list[Template] = []
    for raw in paths:
        if not raw:
            continue
        resolved = resolve_stream_path(raw, chdir)
        if resolved is None:
            probe = Path(raw) if Path(raw).is_absolute() else ((chdir / raw) if chdir else Path(raw))
            try:
                if probe.is_dir():
                    die_no_walk(probe)
            except OSError:
                pass
            print(f"lede: not a file: {raw}", file=sys.stderr)
            continue
        if resolved.is_dir():
            die_no_walk(resolved)
        out.extend(
            extract_from_file(
                resolved,
                None if default_lang in {"", "any"} else default_lang,
                display_path=raw,
            )
        )
    return out


def format_index(t: Template) -> str:
    return (
        f"{t.path}:{t.line}:{t.col}: lang={t.lang} holes={t.holes} "
        f"static={t.static_len} {t.display}"
    )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="lede",
        description="Inverse printf as a filter. Truncation is a prefix of an instance; later holes stay unbound. --complete refuses truncated (span leftover is ok). No tree walk.",
        epilog=HINT,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("messages", nargs="*", help="runtime message(s); '-' reads queries from stdin")
    p.add_argument(
        "-e",
        "--message",
        action="append",
        default=[],
        metavar="MSG",
        help="runtime message (repeatable; use for strings that look like flags)",
    )
    p.add_argument(
        "-t",
        "--templates",
        action="append",
        default=[],
        metavar="FILE",
        help="template stream (FILE, or - for stdin). Repeatable.",
    )
    p.add_argument(
        "--files",
        action="append",
        default=[],
        metavar="FILE",
        help="stream of source paths to extract from (FILE or -). Not a walk.",
    )
    p.add_argument(
        "--from",
        dest="from_fmt",
        default="auto",
        choices=["auto", "grep", "raw", "jsonl", "rg-json", "index", "patch", "files"],
        help="how to parse the template stream (default: auto)",
    )
    p.add_argument("--lang", default="any", help="language hint for extraction (default: from path)")
    p.add_argument("--slurp", action="store_true", help="treat the template stream as one source blob")
    p.add_argument(
        "--open",
        dest="open_mode",
        default="auto",
        choices=["auto", "always", "never"],
        help="open files named by grep/path records (auto: default; never: line-only; always: even patches)",
    )
    p.add_argument(
        "-C",
        "--chdir",
        default=None,
        metavar="DIR",
        help="resolve relative paths in the stream against DIR (does not walk DIR)",
    )
    p.add_argument("-0", "--null", action="store_true", help="NUL-separated template records / --files paths")
    p.add_argument("-n", "--max", type=int, default=DEFAULT_MAX_HITS, help="max hits per message")
    p.add_argument(
        "--min-score",
        type=float,
        default=DEFAULT_MIN_SCORE,
        help=f"minimum score (default {DEFAULT_MIN_SCORE})",
    )
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument(
        "--extract",
        action="store_true",
        help="print extracted templates and exit (re-readable as --from index / --json)",
    )
    p.add_argument("-q", "--quiet", action="store_true", help="exit status only")
    p.add_argument(
        "--any",
        action="store_true",
        help="stop after the first matching query; exit 0 if any matched",
    )
    p.add_argument(
        "--exact",
        action="store_true",
        help="refuse leftover prefix/suffix and truncated matches",
    )
    p.add_argument(
        "--complete",
        action="store_true",
        help="refuse truncated matches; span leftover is still allowed (unlike --exact)",
    )
    p.add_argument("--selftest", action="store_true", help="run built-in tests")
    p.add_argument("--version", action="store_true")
    return p


def run_selftest() -> int:
    failures: list[str] = []

    def expect(cond: bool, msg: str) -> None:
        if not cond:
            failures.append(msg)

    parts, holes = tokenize_template("git diff single file failed: {}")
    expect(holes == 1 and parts == ("git diff single file failed: ", ""), f"rust {{}}: {parts} {holes}")

    parts, names = tokenize_named("unparseable `diff --git` header: {rest}")
    expect(len(names) == 1 and names[0] == "rest" and parts[0].startswith("unparseable"), f"named: {parts} {names}")

    parts, names = tokenize_named("Duplicate event ID: ${snapshot.id}")
    expect(names == ("snapshot.id",) and parts == ("Duplicate event ID: ", ""), f"js: {parts} {names}")

    parts, names = tokenize_named(
        "session started profile=\\(self.activeProfile.name, privacy: .private)"
    )
    expect(
        names == ("self.activeProfile.name",) and parts[0] == "session started profile=",
        f"swift: {parts} {names}",
    )

    parts, names = tokenize_named("unknown dialect {name!r} at line {n}")
    expect(names == ("name", "n"), f"py !r: {names}")

    parts, holes = tokenize_template("open %s: %v")
    expect(holes == 2 and parts == ("open ", ": ", ""), f"printf: {parts} {holes}")

    parts, holes = tokenize_template('{"ok": true}')
    expect(holes == 0, f"json braces should not be holes: {parts} {holes}")

    parts, holes = tokenize_template("progress {0:.2f}%")
    expect(holes == 1 and parts == ("progress ", "%"), f"fmt spec: {parts} {holes}")

    rust = """
        return Err(anyhow!("git diff single file failed: {}", stderr.trim()));
        // decoy: git diff single file failed: should not be extracted from comment
        let _ = format!("diff --git a/{display} b/{display}\\n");
    """
    tmpls = extract_templates(rust, "rust", "diff.rs")
    kinds = {t.display for t in tmpls}
    expect(any("git diff single file failed: {1}" == d for d in kinds), f"extract rust: {kinds}")
    expect(
        any(t.holes == 2 and t.display == "diff --git a/{display} b/{display}" for t in tmpls),
        f"named twice: {kinds}",
    )
    expect(all("decoy" not in t.raw for t in tmpls), "comment leaked")

    go = template_of("p.go", 1, 1, "go", "open %s: %v")
    hit = score_query(go, "open /tmp/x: permission denied")
    expect(hit is not None and hit.score >= 0.34, f"short printf: {hit}")
    expect(
        hit is not None and hit.bindings == (("1", "/tmp/x"), ("2", "permission denied")),
        f"printf binds: {hit.bindings if hit else None}",
    )

    t = template_of("a.rs", 1, 1, "rust", "git diff single file failed: {}")
    hit = score_query(t, "git diff single file failed: fatal: not a git repository")
    expect(hit is not None and hit.score >= 0.5, f"score filled: {hit}")
    expect(
        hit is not None and hit.bindings == (("1", "fatal: not a git repository"),),
        f"unnamed bind: {hit.bindings if hit else None}",
    )

    grep_line = (
        "src/git.rs:2:    Err(format!(\"git diff single file failed: {}\", stderr.trim()))"
    )
    got = ingest_stream(grep_line + "\n", "any", "auto", "-", slurp=False, nul=False)
    expect(
        any(t.display == "git diff single file failed: {1}" and t.line == 2 for t in got),
        f"grep ingest: {[t.display for t in got]}",
    )

    raw_line = "user {} not found\n"
    got = ingest_stream(raw_line, "any", "raw", "tmpls", slurp=False, nul=False)
    expect(got and got[0].holes == 1 and got[0].parts[0] == "user ", f"raw ingest: {got}")

    idx = "src/user.py:2:20: lang=py holes=1 static=16 user {} not found\n"
    got = ingest_stream(idx, "any", "auto", "-", slurp=False, nul=False)
    expect(got and got[0].origin == "index" and got[0].holes == 1, f"index ingest: {got}")

    rgj = json.dumps(
        {
            "type": "match",
            "data": {
                "path": {"text": "src/events.ts"},
