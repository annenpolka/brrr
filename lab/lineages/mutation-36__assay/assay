def _need(name: str, evidence: str, source: str, detail: str) -> Need | None:
    if not ENV_NAME_RE.match(name):
        return None
    if evidence == "string" and name in REJECT_STRINGS:
        return None
    hows = frozenset(h for h in (detail, evidence) if h)
    return Need(name, evidence, source, detail, hows)


def kind_of(need: Need) -> str:
    """DUE = could read (getenv/call). LATENT = did document (help). BOTH = both."""
    hows = set(need.hows)
    if need.detail:
        for part in re.split(r"[+,;|]", need.detail):
            tok = part.strip()
            if tok:
                hows.add(tok)
    hows.add(need.evidence)
    documented = bool(hows & DOC_HOWS)
    strong = bool(hows & STRONG_READ_HOWS) or need.evidence in {"call", "shell"}
    weak = bool(hows & WEAK_READ_HOWS)
    # Prefix-peel of a help line must not promote LATENT → BOTH.
    readable = strong or (weak and not documented)
    if readable and documented:
        return "BOTH"
    if documented and not readable:
        return "LATENT"
    return "DUE"


def _loc(path: Path, lineno: int) -> str:
    return f"{path}:{lineno}"


class _PyEnvVisitor(ast.NodeVisitor):
    """Collect getenv-like reads; ignore stores."""

    def __init__(self, path: Path, constants: dict[str, str]) -> None:
        self.path = path
        self.constants = constants
        self.needs: list[Need] = []
        self.mod_alias: dict[str, str] = {}
        self.from_alias: dict[str, str] = {}

    def visit_Import(self, node: ast.Import) -> None:
        for alias in node.names:
            if alias.name == "os" or alias.name.startswith("os."):
                self.mod_alias[alias.asname or alias.name.split(".", 1)[0]] = "os"
        self.generic_visit(node)

    def visit_ImportFrom(self, node: ast.ImportFrom) -> None:
        if node.module == "os":
            for alias in node.names:
                if alias.name in {"getenv", "environ"}:
                    self.from_alias[alias.asname or alias.name] = alias.name
        self.generic_visit(node)

    def _str(self, node: ast.AST | None) -> str | None:
        if node is None:
            return None
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            return node.value
        if isinstance(node, ast.Name) and node.id in self.constants:
            return self.constants[node.id]
        return None

    def visit_Assign(self, node: ast.Assign) -> None:
        # Keep constants up to date as we walk.
        if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            for tgt in node.targets:
                if isinstance(tgt, ast.Name):
                    self.constants[tgt.id] = node.value.value
        self.generic_visit(node)

    def visit_Subscript(self, node: ast.Subscript) -> None:
        if isinstance(node.ctx, ast.Store):
            self.generic_visit(node)
            return
        name = self._str(node.slice)
        if name and self._is_environ(node.value):
            n = _need(name, "call", _loc(self.path, node.lineno), "os.environ[]")
            if n:
                self.needs.append(n)
        self.generic_visit(node)

    def visit_Call(self, node: ast.Call) -> None:
        func = node.func
        kind = self._call_kind(func)
        if kind and node.args:
            name = self._str(node.args[0])
            if name:
                n = _need(name, "call", _loc(self.path, node.lineno), kind)
                if n:
                    self.needs.append(n)
        self.generic_visit(node)

    def _is_environ(self, node: ast.AST) -> bool:
        if isinstance(node, ast.Attribute) and node.attr == "environ":
            return self._is_os(node.value)
        if isinstance(node, ast.Name) and self.from_alias.get(node.id) == "environ":
            return True
        return False

    def _is_os(self, node: ast.AST) -> bool:
        return isinstance(node, ast.Name) and self.mod_alias.get(node.id) == "os"

    def _call_kind(self, func: ast.AST) -> str | None:
        if isinstance(func, ast.Attribute):
            if func.attr == "getenv" and self._is_os(func.value):
                return "os.getenv"
            if func.attr == "get" and self._is_environ(func.value):
                return "os.environ.get"
            if func.attr == "setdefault" and self._is_environ(func.value):
                return "os.environ.setdefault"
        if isinstance(func, ast.Name):
            bound = self.from_alias.get(func.id)
            if bound == "getenv":
                return "os.getenv"
        return None


def extract_python(path: Path, text: str) -> list[Need]:
    try:
        tree = ast.parse(text, filename=str(path))
    except SyntaxError:
        return extract_by_regex(path, text, "python-fallback")
    constants: dict[str, str] = {}
    for node in ast.walk(tree):
        if not isinstance(node, ast.Assign):
            continue
        if not (isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)):
            continue
        for tgt in node.targets:
            if isinstance(tgt, ast.Name):
                constants[tgt.id] = node.value.value
    vis = _PyEnvVisitor(path, dict(constants))
    vis.visit(tree)
    return vis.needs


