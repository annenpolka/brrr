def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="assay",
        description=(
            "DUE vs LATENT env of a load image set: names it could getenv "
            "versus names it documented."
        ),
    )
    p.add_argument("programs", nargs="*", help="binary, script, source file, or tree")
    p.add_argument("-C", dest="chdir", metavar="DIR", help="change directory first")
    p.add_argument("--vs", dest="vs", metavar="FILE", help="right-hand env file")
    p.add_argument("--left", dest="left", metavar="FILE", help="left-hand env file")
    p.add_argument("--right", dest="right", metavar="FILE", help="alias for --vs")
    p.add_argument("--example", dest="example", metavar="FILE", help=".env.example join")
    p.add_argument("--vs-pid", dest="vs_pid", type=int, metavar="PID")
    p.add_argument(
        "--vs-program",
        dest="vs_program",
        metavar="PATH",
        action="append",
        default=[],
        help="compare owed names against another program/tree (source vs image)",
    )
    p.add_argument(
        "--abi",
        dest="abi",
        metavar="FILE",
        help="load owed names from a lode --dump-abi table (or -)",
    )
    p.add_argument("--dump-abi", action="store_true", help="emit the owed-name table")
    p.add_argument("--names", action="store_true", help="print owed names only")
    p.add_argument(
        "--emit",
        action="store_true",
        help="print KEY=VAL for owed names set on the left",
    )
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--porcelain", action="store_true", help="alias for --tsv")
    p.add_argument("--spare", action="store_true", help="include unread set variables")
    p.add_argument("--app", action="store_true", help="hide well-known libc/runtime names")
    p.add_argument(
        "--due",
        action="store_true",
        help="keep names the image could read (getenv/call cstrings)",
    )
    p.add_argument(
        "--latent",
        action="store_true",
        help="keep names the image documented (help tables / $VAR / NAME =)",
    )
    p.add_argument(
        "--loose",
        action="store_true",
        help="keep low-quality string tokens from binaries (compiler junk)",
    )
    p.add_argument(
        "--min-evidence",
        choices=("call", "shell", "string"),
        default=None,
        help="drop weaker evidence (call > shell > string)",
    )
    p.add_argument("--show-values", action="store_true", help="do not redact secrets")
    p.add_argument(
        "--check",
        action="store_true",
        help="exit 1 if MISSING/DIFF/UNSET/UNDOCUMENTED",
    )
    p.add_argument("--report-only", action="store_true", help="always exit 0")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument(
        "--solo",
        action="store_true",
        help="do not walk loaded dylibs/so (ancestor: main executable only)",
    )
    p.add_argument(
        "--images",
        action="store_true",
        help="print the load image set (main + otool/ldd dependents) and exit",
    )
    p.add_argument(
        "--system",
        action="store_true",
        help="include /usr/lib /System images when walking the load list",
    )
    p.add_argument(
        "--closure",
        action="store_true",
        help="BFS the non-system load graph instead of direct dependents",
    )
    p.add_argument(
        "--depth",
        type=int,
        default=1,
        metavar="N",
        help="max load-list hops (default 1 = otool -L / ldd of the binary)",
    )
    return p


def filter_needs(
    needs: list[Need],
    *,
    app: bool,
    min_evidence: str | None,
    loose: bool = False,
) -> list[Need]:
    out = []
    min_rank = EVIDENCE_RANK[min_evidence] if min_evidence else 0
    for n in needs:
        if app and is_libc_name(n.name):
            continue
        if EVIDENCE_RANK.get(n.evidence, 0) < min_rank:
            continue
        if n.evidence == "string" and not loose and not is_likely_env_name(n.name):
            continue
        out.append(n)
    return out


def filter_kind(needs: list[Need], *, due: bool, latent: bool) -> list[Need]:
    if due and latent:
        return [n for n in needs if kind_of(n) == "BOTH"]
    if due:
        return [n for n in needs if kind_of(n) in {"DUE", "BOTH"}]
    if latent:
        return [n for n in needs if kind_of(n) in {"LATENT", "BOTH"}]
    return needs


def wants_env_join(args: argparse.Namespace) -> bool:
    return bool(
        args.left
        or args.right
        or args.vs
        or args.vs_pid is not None
        or args.example
        or args.emit
        or args.spare
    )


def run(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.version:
        print(VERSION)
        return 0
    if args.selftest:
        return run_selftest()

    if args.chdir:
        os.chdir(args.chdir)

    if args.images:
        if not args.programs:
            print("assay: --images needs a program", file=sys.stderr)
            return 2
        try:
            return emit_images(args)
        except (FileNotFoundError, OSError, RuntimeError) as exc:
            print(f"assay: {exc}", file=sys.stderr)
            return 2

    try:
        needs = collect_needs(args)
    except (FileNotFoundError, ValueError, RuntimeError) as exc:
        print(f"assay: {exc}", file=sys.stderr)
        return 2

    needs = filter_needs(
        needs, app=args.app, min_evidence=args.min_evidence, loose=args.loose
    )
    needs = filter_kind(needs, due=args.due, latent=args.latent)

    if args.vs_program:
        if args.vs or args.right or args.vs_pid is not None:
            print("assay: --vs-program cannot mix with --vs/--right/--vs-pid", file=sys.stderr)
            return 2
        try:
            right_paths = [resolve_program(p) for p in args.vs_program]
            right_needs = harvest(
                right_paths,
                needles=[n.name for n in needs],
                walk_images=not args.solo,
                system=args.system,
                closure=args.closure,
                depth=args.depth,
            )
        except (FileNotFoundError, OSError) as exc:
            print(f"assay: {exc}", file=sys.stderr)
            return 2
        right_needs = filter_needs(
            right_needs, app=args.app, min_evidence=None, loose=args.loose
        )
        right_needs = filter_kind(right_needs, due=args.due, latent=args.latent)
        if args.names:
            sys.stdout.write("".join(n.name + "\n" for n in needs))
            return 0
        if args.dump_abi:
            sys.stdout.write(format_abi(needs))
            return 0
        rows = classify_abi(needs, right_needs)
        show = True
        if args.json:
            sys.stdout.write(format_json(rows, show=show))
        elif args.tsv or args.porcelain:
            sys.stdout.write(format_tsv(rows, show=show))
        else:
            sys.stdout.write(
                format_human(rows, show=show, have_right=True, have_example=False)
            )
        if args.report_only:
            return 0
        fail = ABI_FAIL_STATUSES if args.check else set()
        if any(r.status in fail for r in rows):
            return 1
        return 0

    if args.names:
        sys.stdout.write("".join(n.name + "\n" for n in needs))
        return 0
    if args.dump_abi:
        sys.stdout.write(format_abi(needs))
        return 0

    if not wants_env_join(args):
        rows = classify(needs, None, None, None, spare=False)
        show = args.show_values
        if args.json:
            sys.stdout.write(format_json(rows, show=show))
        elif args.tsv or args.porcelain:
            sys.stdout.write(format_tsv(rows, show=show))
        else:
            sys.stdout.write(
                format_human(
                    rows,
                    show=show,
                    have_right=False,
                    have_example=False,
                    kind_view=True,
                )
            )
        if args.report_only:
            return 0
        return 0

    try:
        left, right, example = load_envs(args)
    except (OSError, ValueError, RuntimeError, json.JSONDecodeError) as exc:
        print(f"assay: {exc}", file=sys.stderr)
        return 2

    if args.emit:
        env = left or current_env()
        sys.stdout.write(format_emit(needs, env, show=args.show_values))
        return 0

    rows = classify(
        needs,
        left,
        right,
        example,
        spare=args.spare,
    )
    show = args.show_values
    if args.json:
        sys.stdout.write(format_json(rows, show=show))
    elif args.tsv or args.porcelain:
        sys.stdout.write(format_tsv(rows, show=show))
    else:
        sys.stdout.write(
            format_human(
                rows,
                show=show,
                have_right=right is not None,
                have_example=example is not None,
            )
        )

    if args.report_only:
        return 0
    if args.check and any(r.status in FAIL_STATUSES for r in rows):
        return 1
    if not args.check and any(r.status in FAIL_STATUSES for r in rows):
        return 1
    return 0


def collect_needs(args: argparse.Namespace) -> list[Need]:
    needs: list[Need] = []
    if args.abi:
        if args.abi == "-":
            needs.extend(parse_abi_text(sys.stdin.read(), "stdin"))
        else:
            path = Path(args.abi)
            needs.extend(parse_abi_text(path.read_text(encoding="utf-8"), str(path)))
    programs = list(args.programs)
    if not programs and not args.abi:
        raise ValueError("need a program/tree or --abi")
    paths = [resolve_program(p) for p in programs]
    if paths:
        needs.extend(
            harvest(
                paths,
                walk_images=not args.solo,
                system=args.system,
                closure=args.closure,
                depth=args.depth,
            )
        )
    return merge_needs(needs)


def format_images(rows: list[ImageRow], *, tsv: bool = False) -> str:
    lines = []
    if tsv:
        lines.append("role\tbytes\tpath\traw")
        for row in rows:
            path = str(row.path) if row.path is not None else "-"
            lines.append(f"{row.role}\t{row.bytes}\t{path}\t{row.raw}")
        return "\n".join(lines) + "\n"
    for row in rows:
        path = str(row.path) if row.path is not None else row.raw
        extra = f"  ({row.bytes})" if row.bytes else ""
        if row.role == "skip":
            lines.append(f"skip  {path}")
        elif row.role == "missing":
            lines.append(f"miss  {row.raw}")
        elif row.role == "main":
            lines.append(f"main  {path}{extra}")
        else:
            lines.append(f"load  {path}{extra}")
    return "\n".join(lines) + ("\n" if lines else "")


def emit_images(args: argparse.Namespace) -> int:
    chunks: list[str] = []
    for spec in args.programs:
        path = resolve_program(spec)
        rows = iter_loaded_images(
            path.resolve(),
            system=args.system,
            closure=args.closure,
            depth=args.depth,
        )
        chunks.append(format_images(rows, tsv=args.tsv or args.porcelain))
    sys.stdout.write("".join(chunks))
    return 0


def load_envs(args: argparse.Namespace) -> tuple[EnvMap | None, EnvMap | None, EnvMap | None]:
    left = load_env_file(Path(args.left)) if args.left else current_env()
    right_path = args.right or args.vs
    right = load_env_file(Path(right_path)) if right_path else None
    if args.vs_pid is not None:
        pid_env = env_from_pid(args.vs_pid)
        if right is None:
            right = pid_env
        else:
            raise ValueError("use only one of --vs/--right and --vs-pid")
    example = load_env_file(Path(args.example)) if args.example else None
    return left, right, example


