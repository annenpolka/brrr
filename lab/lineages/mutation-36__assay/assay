def classify(
    needs: list[Need],
    left: EnvMap | None,
    right: EnvMap | None,
    example: EnvMap | None,
    *,
    spare: bool,
) -> list[Row]:
    by_name = {n.name: n for n in needs}
    owed = set(by_name)
    rows: list[Row] = []

    names = set(owed)
    if left:
        names.update(left.values)
    if right:
        names.update(right.values)
    if example:
        names.update(example.values)

    for name in sorted(names):
        need = by_name.get(name)
        lv = left.values.get(name) if left else None
        rv = right.values.get(name) if right else None
        ev = example.values.get(name) if example else None
        in_left = left is not None and name in left.values
        in_right = right is not None and name in right.values
        in_ex = example is not None and name in example.values

        if name not in owed:
            if example is not None and in_ex:
                rows.append(
                    Row(
                        "STALE_EXAMPLE",
                        name,
                        lv if in_left else None,
                        rv if in_right else None,
                        ev,
                        "example",
                        example.origin,
                        "documented but unread",
                    )
                )
            elif spare and (in_left or in_right):
                rows.append(
                    Row(
                        "SPARE",
                        name,
                        lv if in_left else None,
                        rv if in_right else None,
                        ev if in_ex else None,
                        "-",
                        "-",
                        "set but unread",
                    )
                )
            continue

        assert need is not None
        if example is not None and not in_ex:
            # Still also emit the env-join status; UNDOCUMENTED is extra signal.
            rows.append(
                Row(
                    "UNDOCUMENTED",
                    name,
                    lv if in_left else None,
                    rv if in_right else None,
                    None,
                    need.evidence,
                    need.source,
                    need.detail,
                )
            )

        if left is None and right is None:
            rows.append(
                Row(
                    "DUE",
                    name,
                    None,
                    None,
                    ev if in_ex else None,
                    need.evidence,
                    need.source,
                    need.detail,
                )
            )
            continue

        if right is None:
            status = "DUE" if in_left else "MISSING"
            rows.append(
                Row(
                    status,
                    name,
                    lv if in_left else None,
                    None,
                    ev if in_ex else None,
                    need.evidence,
                    need.source,
                    need.detail,
                )
            )
            continue

        if left is None:
            status = "DUE" if in_right else "MISSING"
            rows.append(
                Row(
                    status,
                    name,
                    None,
                    rv if in_right else None,
                    ev if in_ex else None,
                    need.evidence,
                    need.source,
                    need.detail,
                )
            )
            continue

        if in_left and in_right:
            status = "DUE" if lv == rv else "DIFF"
        elif in_left:
            status = "UNSET_RIGHT"
        elif in_right:
            status = "UNSET_LEFT"
        else:
            status = "MISSING"
        rows.append(
            Row(
                status,
                name,
                lv if in_left else None,
                rv if in_right else None,
                ev if in_ex else None,
                need.evidence,
                need.source,
                need.detail,
            )
        )

    # Prefer the env-join row over a duplicate UNDOCUMENTED-only listing
    # when we already emitted both; keep both — they answer different questions.
    for row in rows:
        need = by_name.get(row.name)
        if need is not None:
            row.kind = kind_of(need)
    if left is None and right is None:
        for row in rows:
            if row.status == "DUE":
                row.status = row.kind
    rows.sort(
        key=lambda r: (
            STATUS_ORDER.index(r.status) if r.status in STATUS_ORDER else 99,
            KIND_ORDER.index(r.kind) if r.kind in KIND_ORDER else 99,
            r.name,
        )
    )
    return rows


def classify_abi(left: list[Need], right: list[Need]) -> list[Row]:
    lmap = {n.name: n for n in left}
    rmap = {n.name: n for n in right}
    rows: list[Row] = []
    for name in sorted(set(lmap) | set(rmap)):
        ln = lmap.get(name)
        rn = rmap.get(name)
        if ln and rn:
            status = "BOTH"
        elif ln:
            status = "LEFT_ONLY"
        else:
            status = "RIGHT_ONLY"
        need = ln or rn
        rows.append(
            Row(
                status,
                name,
                ln.source if ln else None,
                rn.source if rn else None,
                None,
                (ln.evidence if ln else rn.evidence) if (ln or rn) else "-",
                (ln.source if ln else rn.source) if (ln or rn) else "-",
                f"{ln.detail if ln else '-'} | {rn.detail if rn else '-'}",
                kind_of(need) if need else "DUE",
            )
        )
    rows.sort(
        key=lambda r: (
            STATUS_ORDER.index(r.status) if r.status in STATUS_ORDER else 99,
            r.name,
        )
    )
    return rows


def is_libc_name(name: str) -> bool:
    if name in LIBC_ENV:
        return True
    if name.startswith("LC_"):
        return True
    if name.startswith("LD_") or name.startswith("DYLD_"):
        return True
    if name.startswith("XPC_") or name.startswith("SSH_"):
        return True
    return False


def looks_secret(name: str, value: str | None) -> bool:
    if SECRET_NAME_RE.search(name):
        return True
    if value is None:
        return False
    if value.startswith(("sk-", "ghp_", "github_pat_", "xoxb-", "AKIA")):
        return True
    return False


def display_value(name: str, value: str | None, *, show: bool) -> str:
    if value is None:
        return "-"
    if not show and looks_secret(name, value):
        return "«redacted»"
    if len(value) > 72:
        return value[:69] + "..."
    return value


