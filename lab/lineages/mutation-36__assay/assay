def run_selftest() -> int:
    import tempfile
    import traceback

    failures = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal failures
        if cond:
            print(f"  ok  {name}")
        else:
            failures += 1
            extra = f" — {detail}" if detail else ""
            print(f"  FAIL  {name}{extra}", file=sys.stderr)

    tmp = Path(tempfile.mkdtemp(prefix="assay-selftest-"))
    try:
        py = tmp / "app.py"
        py.write_text(
            "import os\n"
            "from os import getenv as g\n"
            'KEY = "DUE_CONST"\n'
            'os.environ["DUE_PORT"]\n'
            'os.getenv("DUE_API_KEY", "")\n'
            "g(KEY)\n"
            'os.environ["DUE_PORT"] = "nope"\n',
            encoding="utf-8",
        )
        got = {n.name: n for n in extract_python(py, py.read_text(encoding="utf-8"))}
        check("py environ load", "DUE_PORT" in got)
        check("py getenv", "DUE_API_KEY" in got)
        check("py const alias", "DUE_CONST" in got)
        check("py ignores store", got["DUE_PORT"].detail == "os.environ[]")

        rs = tmp / "file with spaces.rs"
        rs.write_text(
            'fn main() { let _ = std::env::var("DUE_TOKEN"); }\n',
            encoding="utf-8",
        )
        rsn = extract_file(rs)
        check("rust env::var + spaces", [n.name for n in rsn] == ["DUE_TOKEN"])

        sh = tmp / "計画.sh"
        sh.write_text(
            "#!/bin/sh\n"
            'echo "${DUE_HOME}/x"\n'
            "echo $DUE_PORT\n"
            "# $DUE_COMMENTED\n",
            encoding="utf-8",
        )
        shn = {n.name for n in extract_file(sh)}
        check("shell brace", "DUE_HOME" in shn)
        check("shell dollar", "DUE_PORT" in shn)
        check("shell comment ignored", "DUE_COMMENTED" not in shn)

        js = tmp / "x.ts"
        js.write_text('const x = process.env.DUE_BIN ?? process.env["DUE_PORT"];\n')
        jsn = {n.name for n in extract_file(js)}
        check("process.env", jsn == {"DUE_BIN", "DUE_PORT"})

        go = tmp / "x.go"
        go.write_text('package m\nimport "os"\nfunc f() { os.Getenv("DUE_TOKEN") }\n')
        check("go Getenv", {n.name for n in extract_file(go)} == {"DUE_TOKEN"})

        env_a = parse_env_text(
            "DUE_PORT=3000\nDUE_API_KEY=secret\nSPARE_VAR=1\nexport DUE_HOME=/tmp\n",
            "a",
        )
        env_b = parse_env_text(
            'DUE_PORT="8080"\nDUE_API_KEY=secret\n# only\n',
            "b",
        )
        ex = parse_env_text("DUE_PORT=3000\nDUE_UNUSED=x\n", "ex")
        needs = [
            Need("DUE_PORT", "call", "app.py:1", "os.environ[]"),
            Need("DUE_API_KEY", "call", "app.py:2", "os.getenv"),
            Need("DUE_HOME", "shell", "x.sh:1", "${}"),
            Need("DUE_TOKEN", "call", "x.rs:1", "env::var"),
        ]
        rows = classify(needs, env_a, env_b, ex, spare=True)
        by = defaultdict(list)
        for r in rows:
            by[r.name].append(r.status)
        check("DIFF port", "DIFF" in by["DUE_PORT"])
        check("DUE secret", "DUE" in by["DUE_API_KEY"])
        check("UNSET_RIGHT home", "UNSET_RIGHT" in by["DUE_HOME"])
        check("MISSING token", "MISSING" in by["DUE_TOKEN"])
        check("SPARE unread", "SPARE" in by["SPARE_VAR"])
        check("STALE_EXAMPLE", "STALE_EXAMPLE" in by["DUE_UNUSED"])
        check("UNDOCUMENTED key", "UNDOCUMENTED" in by["DUE_API_KEY"])

        check(
            "redact",
            display_value("DUE_API_KEY", "secret", show=False) == "«redacted»",
        )
        check("show", display_value("DUE_PORT", "3000", show=False) == "3000")

        dumped = format_abi(needs)
        reparsed = parse_abi_text(dumped, "roundtrip")
        check("abi roundtrip", {n.name for n in reparsed} == {n.name for n in needs})

        skip = tmp / "node_modules" / "x.js"
        skip.parent.mkdir()
        skip.write_text("process.env.SHOULD_NOT\n")
        keep = tmp / "src" / "ok.py"
        keep.parent.mkdir()
        keep.write_text('import os\nos.getenv("DUE_KEEP")\n')
        walked = harvest([tmp])
        names = {n.name for n in walked}
        check("walk skips node_modules", "SHOULD_NOT" not in names)
        check("walk finds src", "DUE_KEEP" in names)

        json_env = parse_env_text('{"DUE_PORT": 9, "X": null}', "j")
        check("json env", json_env.values["DUE_PORT"] == "9" and json_env.values["X"] == "")

        packed = "junkKIZU_CONFIGXDG_CONFIG_HOMEtailKITTY_LISTEN_ONTERM_PROGRAM"
        toks = split_packed(packed, env_prefixes(["KIZU_CONFIG"]))
        check("split KIZU_CONFIG", "KIZU_CONFIG" in toks)
        check("split XDG_CONFIG_HOME", "XDG_CONFIG_HOME" in toks)
        check("split KITTY_LISTEN_ON", "KITTY_LISTEN_ON" in toks)
        check("split TERM_PROGRAM", "TERM_PROGRAM" in toks)
        check("reject D_0", not is_valid_env_token("D_0"))
        check("reject T4_", not is_valid_env_token("T4_"))

        blob = tmp / "packed.bin"
        blob.write_bytes(b"\x10\x02\xd6DUE_FIXTURE_C\x00HOME\x00" + packed.encode("ascii") + b"\x00")
        bnames = {n.name for n in extract_binary(blob)}
        check("packed DUE_FIXTURE_C", "DUE_FIXTURE_C" in bnames)
        check("packed HOME cstring", "HOME" in bnames)
        check("packed KIZU_CONFIG", "KIZU_CONFIG" in bnames)
        check("name_in_blob TMUX", name_in_blob(b"<!--TMUX.git", "TMUX"))
        check(
            "name_in_blob ZELLIJ packed",
            name_in_blob(b"kizuZELLIJKITTY_LISTEN_ON", "ZELLIJ"),
        )
        check(
            "name_in_blob packed boundary",
            name_in_blob(b"KIZU_CONFIGXDG_CONFIG_HOME", "KIZU_CONFIG"),
        )
        check(
            "name_in_blob rejects longer word",
            not name_in_blob(b"KIZU_CONFIGURATION\x00", "KIZU_CONFIG"),
        )
        check(
            "name_in_blob titlecase path",
            name_in_blob(b"KIZU_STATE_DIRLibrary/Application", "KIZU_STATE_DIR"),
        )
        check("likely env KIZU_CONFIG", is_likely_env_name("KIZU_CONFIG"))
        check("unlikely BITSET_CANONICAL", not is_likely_env_name("BITSET_CANONICAL"))
        glued = split_packed("KIZU_STATE_DIRLibrary/Application", env_prefixes())
        check("trim titlecase glue", "KIZU_STATE_DIR" in glued and "KIZU_STATE_DIRL" not in glued)
        home_tail = split_packed("XDG_CONFIG_HOMEtailKITTY_LISTEN_ON", env_prefixes())
        check(
            "do not trim HOME+tail",
            "XDG_CONFIG_HOME" in home_tail and "XDG_CONFIG_HOM" not in home_tail,
        )
        # explicit needle on a fresh blob
        zblob = tmp / "mux.bin"
        zblob.write_bytes(b"detectkizuZELLIJKITTY_LISTEN_ON\x00")
        znames = {n.name for n in extract_binary(zblob, ["ZELLIJ", "TMUX"])}
        check("needle ZELLIJ in packed rust", "ZELLIJ" in znames)

        left_abi = [Need("KIZU_CONFIG", "call", "paths.rs:10", "env::var")]
        right_abi = [Need("KIZU_CONFIG", "string", "kizu", "packed"), Need("RUST_LOG", "string", "kizu", "rodata")]
        arows = {r.name: r.status for r in classify_abi(left_abi, right_abi)}
        check("abi BOTH", arows["KIZU_CONFIG"] == "BOTH")
        check("abi RIGHT_ONLY", arows["RUST_LOG"] == "RIGHT_ONLY")

        otool_l = (
            "/opt/host:\n"
            "\t@rpath/libplugin.dylib (compatibility version 0.0.0, current version 0.0.0)\n"
            "\t/usr/lib/libSystem.B.dylib (compatibility version 1.0.0, current version 1356.0.0)\n"
        )
        parsed = parse_otool_L(otool_l)
        check("otool -L rpath", parsed[0] == "@rpath/libplugin.dylib")
        check("otool -L system", parsed[1].endswith("libSystem.B.dylib"))
        otool_r = (
            "          cmd LC_RPATH\n"
            "      cmdsize 32\n"
            "         path @loader_path/../lib (offset 12)\n"
        )
        check("otool rpath", parse_otool_rpaths(otool_r) == ["@loader_path/../lib"])
        ldd_txt = (
            "\tlinux-vdso.so.1 (0x0000)\n"
            "\tlibpython3.14.so.1.0 => /usr/lib/libpython3.14.so.1.0 (0x1234)\n"
            "\tlibc.so.6 => /lib/x86_64-linux-gnu/libc.so.6 (0x5678)\n"
        )
        ldd_parsed = parse_ldd(ldd_txt)
        check("ldd python", "/usr/lib/libpython3.14.so.1.0" in ldd_parsed)

        plug_dir = tmp / "lib"
        plug_dir.mkdir()
        plug = plug_dir / "libplugin.dylib"
        plug.write_bytes(b"\xcf\xfa\xed\xfeLODE_PLUGIN_HOME\x00HOME\x00")
        host = tmp / "bin"
        host.mkdir()
        exe = host / "host"
        resolved = resolve_load_name(
            "@rpath/libplugin.dylib",
            loader=exe,
            executable=exe,
            rpaths=["@loader_path/../lib"],
        )
        check("resolve @rpath", resolved == plug.resolve())
        check("system image", is_system_image(Path("/usr/lib/libSystem.B.dylib")))
        check(
            "homebrew python not system",
            not is_system_image(
                Path("/opt/homebrew/Cellar/python@3.14/Python.framework/Versions/3.14/Python")
            ),
        )

        pref = peel_prefix_tokens(
            b"junkRUSTC_LOG\x00moreLODE_PLUGIN_HOMEXDG_CACHE_HOME",
            env_prefixes(["RUSTC_LOG", "LODE_PLUGIN_HOME"]),
        )
        check("prefix peel RUSTC_LOG", "RUSTC_LOG" in pref)
        check("prefix peel LODE_PLUGIN_HOME", "LODE_PLUGIN_HOME" in pref)

        helpb = tmp / "help.bin"
        helpb.write_bytes(
            b"header\nPYTHONHOME      : alternate <prefix>\n"
            b"\x00  PYTHONPATH = \x00Consider setting $PYTHONSTARTUP to x\x00"
        )
        hfound = {n.name: n for n in extract_binary(helpb)}
        hnames = set(hfound)
        check("doc PYTHONHOME", "PYTHONHOME" in hnames)
        check("assign PYTHONPATH", "PYTHONPATH" in hnames)
        check("dollar PYTHONSTARTUP", "PYTHONSTARTUP" in hnames)
        check("likely PYTHONHOME", is_likely_env_name("PYTHONHOME"))
        check("runtime family PYTHONHOME", is_runtime_family("PYTHONHOME"))
        check("unlikely JAVASCRIPT", not is_runtime_family("ERROR"))
        check("kind PYTHONHOME LATENT", kind_of(hfound["PYTHONHOME"]) == "LATENT")
        check("kind PYTHONPATH LATENT", kind_of(hfound["PYTHONPATH"]) == "LATENT")
        check("kind PYTHONSTARTUP LATENT", kind_of(hfound["PYTHONSTARTUP"]) == "LATENT")

        splitb = tmp / "split.bin"
        splitb.write_bytes(
            b"\x00ASSAY_GETENV_ONLY\x00ASSAY_BOTH\x00"
            b"ASSAY_DOC_ONLY      : documented, never getenv\n"
            b"ASSAY_BOTH      : getenv and documented\n"
            b"Consider setting $ASSAY_DOLLAR to x\x00"
        )
        sfound = {n.name: n for n in extract_binary(splitb)}
        check("split getenv only", kind_of(sfound["ASSAY_GETENV_ONLY"]) == "DUE")
        check("split doc only", kind_of(sfound["ASSAY_DOC_ONLY"]) == "LATENT")
        check("split dollar", kind_of(sfound["ASSAY_DOLLAR"]) == "LATENT")
        check("split both", kind_of(sfound["ASSAY_BOTH"]) == "BOTH")
        glued = tmp / "glued-help.bin"
        glued.write_bytes(b"\xd6ASSAY_PACKED_DOC      : glued to a code byte\n")
        gfound = {n.name: n for n in extract_binary(glued)}
        check("packed help name", "ASSAY_PACKED_DOC" in gfound)
        check(
            "packed help LATENT",
            kind_of(gfound["ASSAY_PACKED_DOC"]) == "LATENT",
        )
        proseb = tmp / "prose.bin"
        proseb.write_bytes(
            b"overridden by setting environment variable `ASSAY_PROSE` (default: x)"
            b"incremental compilation CARGO_INCREMENTAL=0 via environment variable CARGO_INCREMENTAL=0"
        )
        pfound = {n.name: n for n in extract_binary(proseb)}
        check("prose backtick ASSAY_PROSE", "ASSAY_PROSE" in pfound)
        check("prose ASSAY_PROSE LATENT", kind_of(pfound["ASSAY_PROSE"]) == "LATENT")
        check("prose CARGO_INCREMENTAL", "CARGO_INCREMENTAL" in pfound)
        check(
            "prose CARGO_INCREMENTAL LATENT",
            kind_of(pfound["CARGO_INCREMENTAL"]) == "LATENT",
        )
        dumped = format_abi(list(sfound.values()))
        reparsed = {n.name: kind_of(n) for n in parse_abi_text(dumped, "kind-roundtrip")}
        check("kind abi roundtrip BOTH", reparsed.get("ASSAY_BOTH") == "BOTH")
        check("kind abi roundtrip LATENT", reparsed.get("ASSAY_DOC_ONLY") == "LATENT")
    except Exception:
        traceback.print_exc()
        failures += 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if failures:
        print(f"selftest: {failures} failure(s)", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


if __name__ == "__main__":
    sys.exit(run())
