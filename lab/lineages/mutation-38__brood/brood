def load_pr_diff(repo: str, pr: str | None) -> str:
    cmd = ["gh", "pr", "diff"]
    if pr:
        cmd.append(pr)
    try:
        r = subprocess.run(cmd, cwd=repo, capture_output=True)
    except FileNotFoundError:
        die("gh not found (install GitHub CLI, or pipe: gh pr diff | brood -)")
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip()
        die(err or "gh pr diff failed")
    return r.stdout.decode("utf-8", "replace")


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="brood",
        description=(
            "From a commit or a diff, list natal cohorts still unpaid at HEAD. "
            "Natal keys inflect (t1 ↔ driftDelay). Natal literals are domain-tagged "
            "so 0.4-threshold is not 0.4-opacity. No FILE:LINE — the change is the query."
        ),
    )
    p.add_argument(
        "change",
        nargs="?",
        help="commit, A..B range, 'wt', or '-' (stdin diff). Default: HEAD",
    )
    p.add_argument("-C", "--repo", default=os.getcwd(), help="repository working tree")
    p.add_argument("--wt", action="store_true", help="analyze the working tree vs HEAD")
    p.add_argument(
        "--pr",
        nargs="?",
        const="",
        metavar="N",
        help="read `gh pr diff [N]` as the change (same as: gh pr diff | brood -)",
    )
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--tsv", action="store_true", help="TSV output")
    p.add_argument("--check", action="store_true", help="exit 1 if any cohort is unpaid")
    p.add_argument("--all", action="store_true", help="include intact (non-debt) cohorts")
    p.add_argument(
        "--no-birth-clusters",
        action="store_true",
        help="skip Path B (change-as-birth clusters)",
    )
    p.add_argument("--max", type=int, default=40, help="max members listed per cohort")
    p.add_argument("--debug", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--no-color", action="store_true")
    p.add_argument("--version", action="version", version=f"brood {VERSION}")
    args = p.parse_args(argv)

    if args.selftest:
        run_selftest()
        return 0

    repo = find_repo(args.repo)
    color = (
        (not args.no_color)
        and sys.stdout.isatty()
        and os.environ.get("TERM") != "dumb"
    )
    if args.pr is not None:
        diff = load_pr_diff(repo, args.pr or None)
        hunks = parse_hunks(diff)
        r, a, d = events_from_hunks(hunks)
        parent = git(repo, ["rev-parse", "HEAD"]).strip()
        change = Change(
            spec=f"pr:{args.pr or 'current'}",
            kind="stdin",
            commit=None,
            parent=parent,
            date="",
            subject="gh pr diff",
            diff=diff,
            hunks=hunks,
            replacements=r,
            additions=a,
            deletions=d,
        )
    else:
        from_stdin = args.change == "-"
        change = load_change(repo, args.change, wt=args.wt, from_stdin=from_stdin)

    if not change.replacements and not change.additions and not change.deletions:
        if args.json:
            print(json.dumps(report_json(Report(change, [])), indent=2, ensure_ascii=False))
        elif args.tsv:
            print(format_tsv(Report(change, [])))
        else:
            print(f"brood: empty diff for {change.spec}")
        return 1 if args.check else 0

    cohorts = analyze_change(
        repo,
        change,
        debug=args.debug,
        max_members=args.max,
        path_b=not args.no_birth_clusters,
    )
    drifted = any(c.debt() for c in cohorts)
    shown = cohorts if args.all else [c for c in cohorts if c.debt()]
    rep = Report(change, shown)

    if args.json:
        print(json.dumps(report_json(rep), indent=2, ensure_ascii=False))
    elif args.tsv:
        print(format_tsv(rep))
    else:
        print(format_report(rep, color, show_empty=args.all))

    return 1 if args.check and drifted else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
