# birth
# ---------------------------------------------------------------------------

_birth_cache: dict[tuple[str, str, str, int], Birth | None] = {}
_added_cache: dict[tuple[str, str], list[AddedLine]] = {}
_grep_cache: dict[tuple[str, str, str, str], list[Hit]] = {}


def birth_of_line(repo: str, path: str, line: int, at: str, debug: bool) -> Birth | None:
    key = (repo, at, path, line)
    if key in _birth_cache:
        return _birth_cache[key]
    spec = f"{line},{line}:{path}"
    args_follow = [
        "log",
        "-L",
        spec,
        at,
        "-p",
        "--pretty=format:%x1e%H%x09%cI%x09%s",
        "--follow",
    ]
    code, out = git_ok(repo, args_follow, timeout=LOG_L_TIMEOUT)
    if code != 0 or not out.strip():
        code, out = git_ok(
            repo,
            ["log", "-L", spec, at, "-p", "--pretty=format:%x1e%H%x09%cI%x09%s"],
            timeout=LOG_L_TIMEOUT,
        )
    if code != 0 or not out.strip():
        _birth_cache[key] = None
        return None
    records = [r for r in out.split("\x1e") if r.strip()]
    if not records:
        _birth_cache[key] = None
        return None
    oldest = records[-1]
    header, _, body = oldest.partition("\n")
    parts = header.strip().split("\t", 2)
    if len(parts) < 3:
        _birth_cache[key] = None
        return None
    commit, date, subject = parts[0], parts[1], parts[2]
    region: list[str] = []
    birth_path = path
    for line_txt in body.splitlines():
        if line_txt.startswith("+++ "):
            rest = line_txt[4:]
            if rest.startswith("b/"):
                rest = rest[2:]
            if not rest.startswith("/dev/null"):
                birth_path = unquote_git_path(rest)
        if line_txt.startswith("+") and not line_txt.startswith("+++"):
            region.append(line_txt[1:])
    if debug:
        print(
            f"debug: birth {commit[:8]} {path}:{line} region={region[:3]!r}",
            file=sys.stderr,
        )
    b = Birth(commit, date, subject, birth_path, region, uncommitted=False)
    _birth_cache[key] = b
    return b


def added_lines_in_commit(repo: str, commit: str) -> list[AddedLine]:
    key = (repo, commit)
    if key in _added_cache:
        return _added_cache[key]
    if commit == "UNCOMMITTED":
        diff = git(repo, ["diff", "-U0", "--find-renames", "HEAD"])
    else:
        code, parent_out = git_ok(repo, ["rev-parse", f"{commit}^"])
        parent = parent_out.strip() if code == 0 else None
        if parent:
            diff = git(repo, ["diff", "-U0", "--find-renames", parent, commit])
        else:
            diff = git(repo, ["show", "--format=", "-U0", "--find-renames", commit])
    added = added_from_hunks(parse_hunks(diff))
    _added_cache[key] = added
    return added


def this_change_as_birth(change: Change) -> Birth:
    return Birth(
        commit=change.commit or "STDIN",
        date=change.date,
        subject=change.subject,
        path="",
        region=[],
        uncommitted=change.kind in {"wt", "stdin"},
    )


