def rarity_lits(added: list[AddedLine]) -> dict[str, list[AddedLine]]:
    """Cluster natal literals by (token, domain), not by token alone."""
    index: dict[tuple[str, str], list[AddedLine]] = {}
    for al in added:
        for tok in literal_values(al.text):
            if not acceptable_debt_literal(tok, al.text, al.path):
                continue
            dom = extract_domain(al.text, tok, path=al.path)
            index.setdefault((tok, dom.label()), []).append(al)
    n = len(added) or 1
    cap = max(8, int(n * 0.08))
    out: dict[str, list[AddedLine]] = {}
    for (tok, label), lines in index.items():
        uniq: dict[tuple[str, int], AddedLine] = {(x.path, x.line): x for x in lines}
        vals = list(uniq.values())
        if len(vals) < 2:
            continue
        if len(vals) > cap:
            continue
        # Keep the tagged form so path B does not merge 0.4@threshold with 0.4@alpha.
        out[f"{tok}@{label}"] = vals
    return out


def rarity_idents(added: list[AddedLine]) -> dict[str, list[AddedLine]]:
    """Cluster birth-added lines by inflection class of a distinctive ident."""
    index: dict[tuple[str, ...], list[tuple[str, AddedLine]]] = {}
    for al in added:
        seen_stems: set[tuple[str, ...]] = set()
        for ident in ident_values(al.text):
            if not distinctive_ident(ident):
                continue
            stem = ident_parts(ident)
            if stem in seen_stems:
                continue
            seen_stems.add(stem)
            index.setdefault(stem, []).append((ident, al))
    n = len(added) or 1
    cap = max(8, int(n * 0.08))
    out: dict[str, list[AddedLine]] = {}
    for stem, rows in index.items():
        uniq: dict[tuple[str, int], AddedLine] = {}
        label = rows[0][0]
        for ident, al in rows:
            uniq[(al.path, al.line)] = al
            if same_inflection(ident, label) and ident != label:
                label = ident
        vals = list(uniq.values())
        if len(vals) < 2 or len(vals) > cap:
            continue
        out[label] = vals
    return out


def eval_tree_for(change: Change) -> str | None:
    if change.kind in {"wt", "stdin"}:
        return None
    return "HEAD"


def paid_new_locs(change: Change) -> set[tuple[str, int]]:
    locs = {(r.path, r.new_line) for r in change.replacements}
    locs |= {(a.path, a.line) for a in change.additions}
    return locs


def paid_new_texts(change: Change) -> set[str]:
    texts = {r.new_text.strip() for r in change.replacements}
    texts |= {a.text.strip() for a in change.additions}
    return texts


def natal_lines_sharing(
    added: list[AddedLine],
    tokens: set[str],
    skip: set[tuple[str, str]] | None = None,
    natal_domain: Domain | None = None,
    natal_path: str = "",
) -> list[AddedLine]:
    out: list[AddedLine] = []
    seen: set[tuple[str, int]] = set()
    id_keys = [t for t in tokens if not is_number_token(t) and " " not in t]
    lit_keys = {t for t in tokens if is_number_token(t) or " " in t}
    for al in added:
        loc = (al.path, al.line)
        if loc in seen:
            continue
        if skip and (al.path, al.text.strip()) in skip:
            continue
        vals = token_values(al.text)
        shared_lit = vals & lit_keys if lit_keys else set()
        shared_id = any(holds_ident_forms(al.text, k) or quoted_only_hold(al.text, k) for k in id_keys)
        if not shared_lit and not shared_id:
            continue
        if lit_keys and not shared_lit:
            # Generic ident-only (`threshold` at 0.7) is not this 0.4 family.
            if not any(
                distinctive_ident(k) and holds_ident_forms(al.text, k) for k in id_keys
            ):
                continue
        # Same-commit `alpha = 0.4` is not kin of natal `threshold = 0.4`.
        if natal_domain is not None and shared_lit:
            ok_lit = False
            for lit in shared_lit:
                sib = extract_domain(al.text, lit, path=al.path)
                if domains_compatible(
                    natal_domain, sib, al.text, natal_path=natal_path, hit_path=al.path
                ):
                    ok_lit = True
                    break
            if not ok_lit and not shared_id:
                continue
            if not ok_lit and shared_id:
                # Ident overlap without domain-compatible literal: keep only
                # when the ident itself is distinctive natal kin (t1).
                if not any(distinctive_ident(k) for k in id_keys):
                    continue
        seen.add(loc)
        out.append(al)
    return out


def member_from_hit(
    status: str,
    natal: AddedLine,
    hit: Hit | None,
    shared: Iterable[str],
    holds: str | None = None,
) -> Member:
    if hit is None:
        return Member(
            status="gone",
            path=None,
            line=None,
            text=None,
            birth_path=natal.path,
            birth_line=natal.line,
            birth_text=natal.text,
            shared=sorted(shared),
            holds=holds,
        )
    return Member(
        status=status,
        path=hit.path,
        line=hit.line,
        text=hit.text,
        birth_path=natal.path,
        birth_line=natal.line,
        birth_text=natal.text,
        shared=sorted(shared),
        holds=holds,
    )


def classify_hit(
    hit_text: str,
    abandoned: set[str],
    adopted: set[str],
) -> str:
    has_ab_id = False
    has_ad_id = False
    has_ab_lit = False
    has_ad_lit = False
    quoted_ab = False
    for t in abandoned:
        if is_number_token(t) or " " in t:
            if holds_literal(hit_text, t):
                has_ab_lit = True
        else:
            if holds_ident_forms(hit_text, t):
                has_ab_id = True
            elif quoted_only_hold(hit_text, t):
                quoted_ab = True
    for t in adopted:
        if is_number_token(t) or " " in t:
            if holds_literal(hit_text, t):
                has_ad_lit = True
        else:
            if holds_ident_forms(hit_text, t):
                has_ad_id = True
    if quoted_ab and (has_ad_id or ADAPTER_RE.search(hit_text)):
        return "alias"
    if quoted_ab and not has_ab_id:
        return "alias"
    if (has_ad_id or has_ad_lit) and not has_ab_id and not has_ab_lit:
        return "ok"
    if has_ab_id or has_ab_lit:
        return "owing"
    return "ok"


def format_pair(old: str, new: str) -> str:
    return f"{old}↔{new}"


def analyze_path_a(
    repo: str,
    change: Change,
    *,
    debug: bool,
    max_members: int,
) -> list[Cohort]:
    tree = eval_tree_for(change)
    paid_locs = paid_new_locs(change)
    paid_texts = paid_new_texts(change)
    parent = change.parent
    if not parent:
        return []

    events: list[tuple[set[str], set[str], list[tuple[str, str]], str, int, str, str | None, int | None, str | None]] = []

    for r in change.replacements:
        lit_ab = {
            t
            for t in (literal_values(r.old_text) - literal_values(r.new_text))
            if acceptable_debt_literal(t, r.old_text, r.path)
        }
        lit_ad = {
            t
            for t in (literal_values(r.new_text) - literal_values(r.old_text))
            if interesting_literal(t, r.new_text)
        }
        id_pairs = pair_line_idents(r.old_text, r.new_text)
        id_ab = {o for o, _ in id_pairs}
        id_ad = {n for _, n in id_pairs}
        # Literal-only bump still carries erstwhile names from this line later
        # (birth region). Require a swap of *something*.
        if not id_pairs and not (lit_ab and lit_ad):
            continue
        events.append(
            (
                lit_ab | id_ab,
                lit_ad | id_ad,
                id_pairs,
                r.path,
                r.old_line,
                r.old_text,
                r.new_text,
                r.new_line,
                r.path,
            )
        )
        if len(events) >= MAX_EVENTS:
            break

    buckets: dict[tuple[str, frozenset[str]], dict] = {}
    for abandoned, adopted, id_pairs, path, old_line, old_text, new_text, new_line, new_path in events:
        birth = birth_of_line(repo, path, old_line, parent, debug)
        if birth is None:
            birth = Birth(
                commit=change.commit or "UNKNOWN",
                date=change.date,
                subject=change.subject,
                path=path,
                region=[old_text],
                uncommitted=change.kind in {"wt", "stdin"},
            )
        natal_added = (
            added_lines_in_commit(repo, birth.commit)
            if birth.commit not in {"UNKNOWN"}
            else []
        )
        anc = best_ancestral_line(birth.region, old_text) or old_text
        # Erstwhile names live on the birth line even when this change only
        # bumped a number on the already-renamed descendant.
        hist_pairs = pair_line_idents(anc, new_text or old_text)
        if not hist_pairs:
            hist_pairs = pair_idents(
                ident_values(anc),
                ident_values(old_text) | ident_values(new_text or ""),
                one_to_one=True,
            )
        all_pairs = list(id_pairs)
        seen_p = {(a.lower(), b.lower()) for a, b in all_pairs}
        for a, b in hist_pairs:
            if (a.lower(), b.lower()) not in seen_p:
                all_pairs.append((a, b))
                seen_p.add((a.lower(), b.lower()))
        new_lits = literal_values(new_text) if new_text is not None else set()
        birth_debt_lits = {
            t
            for t in (literal_values(anc) - new_lits)
            if acceptable_debt_literal(t, anc, birth.path or path)
        }
        erst_names = {o for o, _ in all_pairs}
        # Birth ident that never made it onto the new line is debt even without
        # a pair from this hunk (t1 on the ancestral mega-line).
        for ident in ident_values(anc):
            if any(same_inflection(ident, n) for n in ident_values(new_text or "")):
                if not any(s.lower() == ident.lower() for s in ident_values(new_text or "")):
                    erst_names.add(ident)
                    continue
            if ident.lower() in {n.lower() for n in ident_values(new_text or "")}:
                continue
            if any(same_inflection(ident, n) or stem_related(ident, n) for n in ident_values(new_text or old_text)):
                erst_names.add(ident)
        debt = set(abandoned) | birth_debt_lits | erst_names
        if not debt:
            continue
        adopted_ids = {n for _, n in all_pairs} | set(adopted)
        keys = sorted(debt, key=lambda s: (-len(s), s))
        src_text = anc or old_text
        lit_debt = [t for t in keys if is_number_token(t) or " " in t]
        id_debt = [t for t in keys if t not in lit_debt]
        natal_dom: Domain | None = None
        for t in lit_debt + id_debt:
            cand = extract_domain(src_text, t, path=path)
            if cand.binder or cand.kind in {"slot", "call"}:
                natal_dom = cand
                break
            if natal_dom is None:
                natal_dom = cand
        if natal_dom is None and keys:
            natal_dom = extract_domain(src_text, keys[0], path=path)
        tagged = []
        for t in keys:
            if natal_dom is not None and (is_number_token(t) or " " in t):
                tagged.append(natal_dom.tagged(t))
            else:
                tagged.append(extract_domain(src_text, t, path=path).tagged(t))
        skip_self = {(path, old_text.strip())}
        natal = [
            n
            for n in natal_lines_sharing(
                natal_added,
                debt,
                skip=skip_self,
                natal_domain=natal_dom,
                natal_path=path,
            )
            if n.path != path or n.text.strip() != old_text.strip()
        ]
        # Domain label is part of the cohort identity: 0.4@threshold ≠ 0.4@alpha.
        dom_label = (natal_dom.label() if natal_dom else "?").lower()
        cid = (birth.commit, dom_label, frozenset(x.lower() for x in debt))
        bkt = buckets.get(cid)
        if bkt is None:
            bkt = {
                "birth": birth,
                "abandoned": set(debt),
                "adopted": set(adopted_ids),
                "pairs": list(all_pairs),
                "keys": list(keys),
                "tagged": list(tagged),
                "domain": natal_dom,
                "natal": {(n.path, n.line): n for n in natal},
                "paid": [],
            }
            buckets[cid] = bkt
        else:
            bkt["abandoned"] |= debt
            bkt["adopted"] |= adopted_ids
            for p in all_pairs:
                if p not in bkt["pairs"]:
                    bkt["pairs"].append(p)
            for tg in tagged:
                if tg not in bkt["tagged"]:
                    bkt["tagged"].append(tg)
            for n in natal:
                bkt["natal"][(n.path, n.line)] = n
        if new_text is not None and new_path is not None and new_line is not None:
            holds = next(iter(adopted_ids), None)
            bkt["paid"].append(
                Member(
                    status="paid",
                    path=new_path,
                    line=new_line,
                    text=new_text,
                    birth_path=path,
                    birth_line=old_line,
                    birth_text=old_text,
                    shared=sorted(debt),
                    holds=holds,
                    domain=dom_label,
                )
            )

    cohorts: list[Cohort] = []
    for bkt in buckets.values():
        owing: list[Member] = []
        ok: list[Member] = []
        gone: list[Member] = []
        alias: list[Member] = []
        seen_now: set[tuple[str, int]] = set()
        abandoned: set[str] = bkt["abandoned"]
        adopted: set[str] = bkt["adopted"]
        keys: list[str] = sorted(abandoned, key=lambda s: (-len(s), s))

        for natal in bkt["natal"].values():
            hits = locate_natal(repo, tree, natal, keys, paid_locs, paid_texts)
            if not hits:
                gone.append(
                    member_from_hit(
                        "gone", natal, None, abandoned & token_values(natal.text)
                    )
                )
                if len(gone) + len(owing) >= max_members:
                    break
                continue
            for h in hits:
                loc = (h.path, h.line)
                if loc in seen_now:
                    continue
                seen_now.add(loc)
                shared = token_values(natal.text) & token_values(h.text)
                st = classify_hit(h.text, abandoned, adopted)
                holds = None
                for k in keys:
                    if is_number_token(k):
                        sv = slot_value(natal.text, h.text, k)
                        if sv:
                            holds = sv
                            break
                    elif holds_ident_forms(h.text, k) or quoted_only_hold(h.text, k):
                        holds = k
                        break
                mem = member_from_hit(
                    st,
                    natal,
                    h,
                    shared or (abandoned & token_values(natal.text)),
                    holds,
                )
                if st == "owing":
                    owing.append(mem)
                elif st == "alias":
                    alias.append(mem)
                else:
                    ok.append(mem)
                if len(owing) >= max_members:
                    break
            if len(owing) >= max_members:
                break

        for m in bkt["paid"]:
            if m.path is not None and m.line is not None:
                seen_now.add((m.path, m.line))

        echo: list[Member] = []
        natal_dom: Domain | None = bkt.get("domain")
        natal_path = bkt["birth"].path or ""
        for key in keys:
            if is_number_token(key) or " " in key:
                hits = grep_token(
                    repo, key, tree, natal_domain=natal_dom, natal_path=natal_path
                )
            elif distinctive_ident(key):
                hits = grep_ident_forms(
                    repo, key, tree, natal_domain=natal_dom, natal_path=natal_path
                )
            else:
                hits = [
                    h
                    for h in grep_ident_forms(
                        repo, key, tree, natal_domain=natal_dom, natal_path=natal_path
                    )
                    if path_is_doc_or_test(h.path)
                ]
            if len(hits) > 50:
                hits = hits[:50]
            for h in hits:
                loc = (h.path, h.line)
                if loc in seen_now or loc in paid_locs:
                    continue
                if h.text.strip() in paid_texts:
                    continue
                st = classify_hit(h.text, abandoned, adopted)
                if st == "alias":
                    seen_now.add(loc)
                    alias.append(
                        Member(
                            status="alias",
                            path=h.path,
                            line=h.line,
                            text=h.text,
                            birth_path=h.path,
                            birth_line=h.line,
                            birth_text=h.text,
                            shared=[key],
                            holds=key,
                        )
                    )
                    continue
                if st != "owing":
                    continue
                seen_now.add(loc)
                echo.append(
                    Member(
                        status="echo",
                        path=h.path,
                        line=h.line,
                        text=h.text,
                        birth_path=h.path,
                        birth_line=h.line,
                        birth_text=h.text,
                        shared=[key],
                        holds=key,
                    )
                )
                if len(echo) >= max_members:
                    break
            if len(echo) >= max_members:
                break

        factions: dict[str, int] = {}
        for m in bkt["paid"]:
            if m.holds:
                factions[m.holds] = factions.get(m.holds, 0) + 1
        for m in owing:
            tag = m.holds or (m.shared[0] if m.shared else "?")
            factions[tag] = factions.get(tag, 0) + 1

        pair_labels = [format_pair(a, b) for a, b in bkt["pairs"]]
        natal_dom = bkt.get("domain")
        tagged = list(bkt.get("tagged") or [])
        if not tagged and natal_dom is not None:
            tagged = [natal_dom.tagged(k) for k in keys]
        elif not tagged:
            tagged = list(keys)
        cohorts.append(
            Cohort(
                kind="owing",
                birth=bkt["birth"],
                keys=keys,
                abandoned=sorted(abandoned, key=lambda s: (-len(s), s)),
                adopted=sorted(adopted, key=lambda s: (-len(s), s)),
                pairs=pair_labels,
                tagged=tagged,
                domain=natal_dom.label() if natal_dom else None,
                paid=bkt["paid"],
                owing=owing,
                ok=ok,
                gone=gone,
                echo=echo,
                alias=alias,
                factions=factions,
            )
        )
        if len(cohorts) >= MAX_COHORTS:
            break
    return cohorts


def analyze_path_b(
    repo: str,
    change: Change,
    already: set[tuple[str, frozenset[str]]],
    *,
    debug: bool,
    max_members: int,
) -> list[Cohort]:
    added = change.additions + [
        AddedLine(r.path, r.new_line, r.new_text) for r in change.replacements
    ]
    if len(added) > 800:
        added = added[:800]
    clusters = rarity_lits(added)
    id_clusters = rarity_idents(added)
    if not clusters and not id_clusters:
        return []
    tree = eval_tree_for(change)
    birth = this_change_as_birth(change)
    cohorts: list[Cohort] = []

    def emit(key: str, natal_lines: list[AddedLine], identish: bool) -> None:
        bare, lab = (key.rsplit("@", 1) + [None])[:2] if "@" in key else (key, None)
        if lab is None:
            bare = key
        cid = (birth.commit, (lab or "").lower(), frozenset({bare.lower()}))
        if cid in already:
            return
        owing: list[Member] = []
        ok: list[Member] = []
        gone: list[Member] = []
        paid: list[Member] = []
        factions: dict[str, int] = {}
        seen_now: set[tuple[str, int]] = set()

        for natal in natal_lines:
            h = follow_line(repo, tree, natal, bare)
            if h is None:
                gone.append(member_from_hit("gone", natal, None, {key}))
                continue
            loc = (h.path, h.line)
            if loc in seen_now:
                continue
            seen_now.add(loc)
            if identish:
                if holds_ident_forms(h.text, bare) or quoted_only_hold(h.text, bare):
                    holds = bare
                else:
                    hid = ident_values(h.text)
                    partner = None
                    for ident in hid:
                        if same_inflection(ident, bare) or stem_related(ident, bare):
                            partner = ident
                            break
                    holds = partner
            else:
                natal_dom = extract_domain(natal.text, bare, path=natal.path)
                hit_dom = extract_domain(h.text, bare, path=h.path)
                if not domains_compatible(
                    natal_dom, hit_dom, h.text, natal_path=natal.path, hit_path=h.path
                ):
                    # Same bytes, other domain — not this brood.
                    continue
                holds = slot_value(natal.text, h.text, bare)
                if holds is None:
                    toks = literal_values(h.text)
                    holds = bare if bare in toks else None
            if holds is None:
                gone.append(member_from_hit("gone", natal, None, {bare}))
                continue
            factions[holds] = factions.get(holds, 0) + 1
            shared = {bare} if bare.lower() in {holds.lower()} or holds_ident_forms(h.text, bare) else {holds}
            if holds.lower() == bare.lower() or same_inflection(str(holds), bare):
                # Same identity at HEAD — ok until a faction splits.
                ok.append(member_from_hit("ok", natal, h, shared, holds))
            else:
                paid.append(member_from_hit("paid", natal, h, shared, holds))
            if len(ok) + len(paid) + len(owing) >= max_members:
                break

        moved = {k: n for k, n in factions.items() if k.lower() != bare.lower() and not same_inflection(str(k), bare)}
        still = sum(
            n
            for k, n in factions.items()
            if k.lower() == bare.lower() or same_inflection(str(k), bare)
        )
        if moved and still > 0:
            owing = [
                Member(
                    status="owing",
                    path=m.path,
                    line=m.line,
                    text=m.text,
                    birth_path=m.birth_path,
                    birth_line=m.birth_line,
                    birth_text=m.birth_text,
                    shared=m.shared,
                    holds=m.holds,
                )
                for m in ok
            ]
            ok = []
            kind = "split"
        else:
            kind = "split" if len(factions) > 1 else "owing"

        if debug:
            print(
                f"debug: path-b key={key!r} natal={len(natal_lines)} factions={factions}",
                file=sys.stderr,
            )

        cohorts.append(
            Cohort(
                kind=kind,
                birth=birth,
                keys=[bare],
                abandoned=[bare],
                adopted=sorted(moved.keys(), key=len, reverse=True),
                tagged=[key if lab else bare],
                domain=lab,
                paid=paid,
                owing=owing,
                ok=ok,
                gone=gone,
                factions=factions,
            )
        )
        already.add(cid)

    for lit, natal_lines in sorted(
        clusters.items(), key=lambda kv: (-len(kv[1]), -len(kv[0]), kv[0])
    ):
        emit(lit, natal_lines, identish=False)
        if len(cohorts) >= MAX_COHORTS:
            return cohorts
    for ident, natal_lines in sorted(
        id_clusters.items(), key=lambda kv: (-len(kv[1]), -len(kv[0]), kv[0])
    ):
        emit(ident, natal_lines, identish=True)
        if len(cohorts) >= MAX_COHORTS:
            return cohorts
    return cohorts


def merge_cohorts(cohorts: list[Cohort]) -> list[Cohort]:
    by: dict[tuple[str, frozenset[str]], Cohort] = {}
    order: list[tuple[str, frozenset[str]]] = []
    for c in cohorts:
        cid = (
            c.birth.commit,
            (c.domain or "").lower(),
            frozenset(x.lower() for x in (c.abandoned or c.keys)),
        )
        if cid not in by:
            by[cid] = c
            order.append(cid)
            continue
        other = by[cid]
        if other.kind == "owing" and c.kind == "split" and other.paid:
            continue
        if c.paid and not other.paid:
            by[cid] = c
            continue

        def ext(dst: list[Member], extra: list[Member]) -> None:
            seen = {(m.path, m.line, m.birth_path, m.birth_line) for m in dst}
            for m in extra:
                k = (m.path, m.line, m.birth_path, m.birth_line)
                if k not in seen:
                    dst.append(m)
                    seen.add(k)

        ext(other.paid, c.paid)
        ext(other.owing, c.owing)
        ext(other.ok, c.ok)
        ext(other.gone, c.gone)
        ext(other.echo, c.echo)
        ext(other.alias, c.alias)
        for k, n in c.factions.items():
            other.factions[k] = max(other.factions.get(k, 0), n)
        for p in c.pairs:
            if p not in other.pairs:
                other.pairs.append(p)
        for tg in c.tagged:
            if tg not in other.tagged:
                other.tagged.append(tg)
        if c.domain and not other.domain:
            other.domain = c.domain
        if c.kind == "split" and len(c.factions) > 1:
            other.kind = "split"
    return [by[k] for k in order]


def analyze_change(
    repo: str,
    change: Change,
    *,
    debug: bool,
    max_members: int,
    path_b: bool = True,
) -> list[Cohort]:
    a = analyze_path_a(repo, change, debug=debug, max_members=max_members)
    already = {
        (
            c.birth.commit,
            (c.domain or "").lower(),
            frozenset(x.lower() for x in (c.abandoned or c.keys)),
        )
        for c in a
    }
    b: list[Cohort] = []
    if path_b:
        b = analyze_path_b(
            repo, change, already, debug=debug, max_members=max_members
        )
    cohorts = merge_cohorts(a + b)
    cohorts.sort(
        key=lambda c: (
            0 if c.kind == "owing" and c.paid else 1,
            -len(c.owing),
            -(len(c.factions) - 1),
            c.birth.commit,
        )
    )
    return cohorts[:MAX_COHORTS]


