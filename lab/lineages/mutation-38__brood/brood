def die(msg: str, code: int = 2) -> None:
    print(f"brood: {msg}", file=sys.stderr)
    raise SystemExit(code)


def git(
    repo: str,
    args: list[str],
    *,
    check: bool = True,
    timeout: int | None = None,
) -> str:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        timeout=timeout,
    )
    if check and r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip()
        die(err or f"git {' '.join(args)} failed (exit {r.returncode})")
    return r.stdout.decode("utf-8", "replace")


def git_ok(
    repo: str,
    args: list[str],
    timeout: int | None = None,
) -> tuple[int, str]:
    try:
        r = subprocess.run(
            ["git", "-C", repo, *args],
            capture_output=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return 124, ""
    return r.returncode, r.stdout.decode("utf-8", "replace")


def find_repo(start: str) -> str:
    r = subprocess.run(
        ["git", "-C", start, "rev-parse", "--show-toplevel"],
        capture_output=True,
    )
    if r.returncode != 0:
        die(f"not a git repository: {start}")
    return r.stdout.decode("utf-8", "replace").strip()


def unquote_git_path(path: str) -> str:
    path = path.split("\t", 1)[0]
    if len(path) >= 2 and path[0] == '"' and path[-1] == '"':
        inner = path[1:-1]
        out: list[str] = []
        i = 0
        while i < len(inner):
            if inner[i] == "\\" and i + 1 < len(inner):
                nxt = inner[i + 1]
                if nxt in '"\\nrtab':
                    out.append(
                        {"n": "\n", "r": "\r", "t": "\t", "a": "\a", "b": "\b"}.get(
                            nxt, nxt
                        )
                    )
                    i += 2
                    continue
                if nxt.isdigit():
                    out.append(chr(int(inner[i + 1 : i + 4], 8)))
                    i += 4
                    continue
            out.append(inner[i])
            i += 1
        return "".join(out)
    return path


def looks_like_location(spec: str) -> bool:
    m = LOC_RE.match(spec)
    if not m:
        return False
    path = m.group(1)
    if path in {".", ".."}:
        return False
    if "/" in path or Path(path).suffix or " " in path:
        return True
    if re.search(r"\.[A-Za-z0-9]{1,8}$", path):
        return True
    return False


# ---------------------------------------------------------------------------
# tokenize + inflection
# ---------------------------------------------------------------------------


def _string_spans(text: str) -> list[tuple[int, int]]:
    return [(m.start(), m.end()) for m in STR_RE.finditer(text)]


def _in_span(pos: int, spans: list[tuple[int, int]]) -> bool:
    return any(a <= pos < b for a, b in spans)


def keep_ident(w: str) -> bool:
    if SHORT_NATAL.match(w):
        return True
    if len(w) < 3:
        return False
    if w.lower() in STOP:
        return False
    if len(w) == 40 and all(c in "0123456789abcdefABCDEF" for c in w):
        return False
    return True


def tokenize(text: str) -> list[tuple[str, str]]:
    found: list[tuple[str, str]] = []
    seen: set[tuple[str, str]] = set()

    def add(kind: str, value: str) -> None:
        key = (kind, value)
        if key not in seen:
            seen.add(key)
            found.append(key)

    spans = _string_spans(text)
    for m in STR_RE.finditer(text):
        s = (m.group(1) or m.group(2) or "").strip()
        if len(s) >= 2:
            add("str", s)

    for m in IDENT_RE.finditer(text):
        if _in_span(m.start(), spans):
            continue
        w = m.group(0)
        if not keep_ident(w):
            continue
        add("id", w)

    for m in NUM_RE.finditer(text):
        if _in_span(m.start(), spans):
            continue
        n = m.group(1)
        if n in COMMON_NUM:
            continue
        add("num", n)

    return found


def token_values(text: str) -> set[str]:
    out: set[str] = set()
    for k, v in tokenize(text):
        if k == "id":
            out.add(v.lower())
        else:
            out.add(v)
    return out


def literal_values(text: str) -> set[str]:
    return {v for k, v in tokenize(text) if k in ("num", "str")}


def ident_values(text: str) -> set[str]:
    return {v for k, v in tokenize(text) if k == "id"}


def is_number_token(tok: str) -> bool:
    return bool(re.fullmatch(r"\d+(?:\.\d+)?", tok))


def ident_parts(name: str) -> tuple[str, ...]:
    s = name.replace("-", "_")
    parts: list[str] = []
    for chunk in s.split("_"):
        if not chunk:
            continue
        bits = re.findall(
            r"[A-Z]+(?=[A-Z][a-z0-9])|[A-Z]?[a-z]+|[A-Z]+|\d+", chunk
        )
        if bits:
            parts.extend(b.lower() for b in bits if b)
        else:
            parts.append(chunk.lower())
    return tuple(parts) if parts else (name.lower(),)


def surfaces(name: str) -> set[str]:
    parts = list(ident_parts(name))
    if not parts:
        return {name}
    camel = parts[0] + "".join(p.capitalize() for p in parts[1:])
    pascal = "".join(p.capitalize() for p in parts)
    snake = "_".join(parts)
    kebab = "-".join(parts)
    const = "_".join(p.upper() for p in parts)
    out = {name, name.lower(), name.upper(), camel, pascal, snake, kebab, const}
    if SHORT_NATAL.match(name):
        out.add(name.lower())
        out.add(name.upper())
    return {s for s in out if s}


def same_inflection(a: str, b: str) -> bool:
    return ident_parts(a) == ident_parts(b)


def stem_related(a: str, b: str) -> bool:
    pa, pb = ident_parts(a), ident_parts(b)
    if not pa or not pb:
        return False
    if pa == pb:
        return True
    # presentThreshold contains threshold as a trailing segment.
    # updatedCounters is prefix-noise + counters — not erstwhile identity.
    if pa == pb[-len(pa) :]:
        extra = pb[: -len(pa)]
        word = "".join(pa)
        if extra and all(p in STEM_NOISE for p in extra):
            return False
        return len(pa) > 1 or len(word) >= 6
    if pb == pa[-len(pb) :]:
        extra = pa[: -len(pb)]
        word = "".join(pb)
        if extra and all(p in STEM_NOISE for p in extra):
            return False
        return len(pb) > 1 or len(word) >= 6
    return False


def slot_idents(text: str) -> list[str]:
    """Declared / assigned names (`t1: Type =`, `let threshold =`)."""
    found: list[str] = []
    seen: set[str] = set()
    for m in SLOT_RE.finditer(text):
        w = m.group(1)
        if not keep_ident(w):
            continue
        if w.lower() in seen:
            continue
        seen.add(w.lower())
        found.append(w)
    return found


def pair_idents(
    old_ids: Iterable[str],
    new_ids: Iterable[str],
    *,
    one_to_one: bool = True,
    stem: bool = True,
) -> list[tuple[str, str]]:
    """Pair abandoned idents with adopted ones.

    Order: same inflection (present_threshold ↔ presentThreshold), then
    stem containment (threshold ↔ presentThreshold), then leftover 1-to-1
    (t1 ↔ driftDelay) only when the abandoned name is distinctive.
    Same-surface leftovers are not pairs.
    """
    old = list(dict.fromkeys(old_ids))
    new = list(dict.fromkeys(new_ids))
    new_l = {n.lower() for n in new}
    old_l = {o.lower() for o in old}
    abandoned = [o for o in old if o.lower() not in new_l]
    adopted = [n for n in new if n.lower() not in old_l]
    pairs: list[tuple[str, str]] = []
    used_o: set[str] = set()
    used_n: set[str] = set()

    def take(o: str, n: str) -> None:
        used_o.add(o.lower())
        used_n.add(n.lower())
        pairs.append((o, n))

    for o in abandoned:
        cands = [
            n
            for n in adopted
            if n.lower() not in used_n and same_inflection(o, n) and o.lower() != n.lower()
        ]
        if len(cands) == 1:
            take(o, cands[0])

    if stem:
        for o in abandoned:
            if o.lower() in used_o:
                continue
            cands = [
                n for n in adopted if n.lower() not in used_n and stem_related(o, n)
            ]
            if len(cands) == 1:
                take(o, cands[0])

    if one_to_one:
        left_o = [o for o in abandoned if o.lower() not in used_o]
        left_n = [n for n in adopted if n.lower() not in used_n]
        # t1 ↔ driftDelay: short natal or multi-segment on the abandoned side.
        if len(left_o) == 1 and len(left_n) == 1 and distinctive_ident(left_o[0]):
            take(left_o[0], left_n[0])
    return pairs


def pair_line_idents(old_text: str, new_text: str) -> list[tuple[str, str]]:
    """Prefer declaration-slot names; fall back to all idents without 1:1."""
    slots = pair_idents(slot_idents(old_text), slot_idents(new_text), one_to_one=True)
    if slots:
        return slots
    # Inflection only on the full ident sets — no stem, no leftover 1:1.
    # That stops `window` ↔ `focusedWindow`, `radius` ↔ `cornerRadius`,
    # and `geo` ↔ `geometry`. Stem pairing is declaration-slot only.
    return pair_idents(
        ident_values(old_text),
        ident_values(new_text),
        one_to_one=False,
        stem=False,
    )


def distinctive_ident(name: str) -> bool:
    if SHORT_NATAL.match(name):
        return True
    parts = ident_parts(name)
    if len(parts) >= 2:
        return True
    if name.lower() in GENERIC_IDENTS:
        return False
    return len(name) >= 8


def number_context_ok(text: str, num: str) -> bool:
    for m in re.finditer(re.escape(num), text):
        before = text[max(0, m.start() - 24) : m.start()]
        after = text[m.end() : m.end() + 2]
        if RANGE_RE.search(before) or after.startswith(".."):
            continue
        if re.search(r"[A-Za-z]$", before) or before.endswith("-"):
            if re.search(r"[A-Za-z0-9]-$", before) or re.search(r"[A-Za-z]$", before):
                continue
        if STYLE_BEFORE.search(before):
            continue
        if re.search(r"[\*\/]\s*$", before):
            continue
        if after.startswith("+"):
            continue
        if OS_BEFORE.search(before):
            continue
        return True
    return False


def float_hit_ok(text: str, num: str) -> bool:
    if "." not in num:
        return True
    if STYLE_LINE.search(text) and not THRESHOLD_LINE.search(text):
        return False
    return True


def best_ancestral_line(region: list[str], query_text: str) -> str | None:
    if not region:
        return None
    q = token_values(query_text)
    best = region[0]
    best_n = -1
    for line in region:
        n = len(token_values(line) & q)
        if n > best_n:
            best_n = n
            best = line
    return best


def interesting_literal(tok: str, text: str) -> bool:
    if is_number_token(tok):
        if tok in COMMON_NUM:
            return False
        if not number_context_ok(text, tok):
            return False
        if not float_hit_ok(text, tok):
            return False
    return True


def path_is_code(path: str) -> bool:
    return any(path.lower().endswith(ext) for ext in CODE_EXT)


def path_is_doc_or_test(path: str) -> bool:
    low = path.replace("\\", "/").lower()
    base = low.rsplit("/", 1)[-1]
    if low.endswith(".md") or "/docs/" in f"/{low}" or "/doc/" in f"/{low}":
        return True
    if "test" in base or "/test" in f"/{low}" or "/tests/" in f"/{low}":
        return True
    if "/spec/" in f"/{low}" or base.startswith("spec"):
        return True
    return False


def short_int(tok: str) -> bool:
    return is_number_token(tok) and "." not in tok and len(tok) <= 2


def acceptable_debt_literal(tok: str, text: str, path: str) -> bool:
    if not interesting_literal(tok, text):
        return False
    if short_int(tok):
        if not path_is_code(path):
            return False
        if not re.search(
            rf"[A-Za-z_][A-Za-z0-9_]*\s*[:=]{{1,2}}\s*{re.escape(tok)}\b", text
        ):
            return False
    return True


def num_appears_bare(text: str, num: str) -> bool:
    for m in re.finditer(re.escape(num), text):
        before = text[m.start() - 1] if m.start() else ""
        after = text[m.end() : m.end() + 1]
        if before.isdigit() or before == ".":
            continue
        if after.isdigit() or after == ".":
            continue
        return True
    return False


def holds_literal(text: str, tok: str) -> bool:
    if tok in token_values(text):
        return True
    if is_number_token(tok) and num_appears_bare(text, tok):
        if THRESHOLD_LINE.search(text) or re.search(
            rf"[=:<>]\s*{re.escape(tok)}\b", text
        ):
            return True
    return False


def holds_surface(text: str, surface: str) -> bool:
    """Unquoted token only. Quoted `= \"t1\"` is an adapter, not a code ident."""
    if not surface:
        return False
    spans = _string_spans(text)
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", surface):
        pat = re.compile(rf"(?<![A-Za-z0-9_]){re.escape(surface)}(?![A-Za-z0-9_])")
    else:
        pat = re.compile(rf"(?<![A-Za-z0-9]){re.escape(surface)}(?![A-Za-z0-9])")
    for m in pat.finditer(text):
        if not _in_span(m.start(), spans):
            return True
    return False


def holds_ident_forms(text: str, name: str) -> bool:
    return any(holds_surface(text, s) for s in surfaces(name))


def quoted_only_hold(text: str, name: str) -> bool:
    """True when the name lives only inside quotes (CodingKeys = \"t1\")."""
    if holds_ident_forms(text, name):
        return False
    for s in surfaces(name):
        if re.search(rf"""['"]{re.escape(s)}['"]""", text):
            return True
    return False


def domain_stems_of(name: str) -> tuple[str, ...]:
    parts = list(ident_parts(name))
    alias = DOMAIN_ALIAS.get(name) or DOMAIN_ALIAS.get(name.lower())
    if alias:
        parts.append(alias)
    out: list[str] = []
    seen: set[str] = set()
    for p in parts:
        if p in GENERIC_DOMAIN_PARTS or p in STOP:
            continue
        if p in seen:
            continue
        seen.add(p)
        out.append(p)
    return tuple(out)


def cjk_domain_stems(text: str) -> tuple[str, ...]:
    found: list[str] = []
    for surface, stem in DOMAIN_ALIAS.items():
        if surface in text and stem not in found:
            found.append(stem)
    return tuple(found)


def token_spans(text: str, tok: str) -> list[tuple[int, int]]:
    spans: list[tuple[int, int]] = []
    numeric = is_number_token(tok)
    for m in re.finditer(re.escape(tok), text):
        if numeric:
            before = text[m.start() - 1] if m.start() else ""
            after = text[m.end() : m.end() + 1]
            if before.isdigit() or before == ".":
                continue
            if after.isdigit() or after == ".":
                continue
        spans.append((m.start(), m.end()))
    return spans


def binder_for_span(text: str, start: int, end: int) -> tuple[str | None, str]:
    """Classify how `text[start:end]` is used. Binder comes from the line, not a list."""
    left = text[:start]
    after = text[end:]
    if ARITH_BEFORE.search(left) or ARITH_AFTER.match(after):
        return None, "arith"
    if CUTOFF_BEFORE.search(left) or CUTOFF_AFTER.match(after):
        return None, "cutoff"
    m = SLOT_BEFORE.search(left)
    if m:
        return m.group(1), "slot"
    # Numbers inside quotes (`@Test("… threshold 0.4")`) are not arguments of
    # the outer call. Classify from the quoted interior, not `Test(`.
    if _in_span(start, _string_spans(text)):
        if CUTOFF_BEFORE.search(left) or CUTOFF_AFTER.match(after):
            return None, "cutoff"
        m = SLOT_BEFORE.search(left)
        if m:
            return m.group(1), "slot"
        return None, "prose"
    m = CALL_BEFORE.search(left)
    if m:
        return m.group(1), "call"
    return None, "prose"


def neighbor_idents(text: str) -> tuple[str, ...]:
    """Idents on the line, including inside strings and comments.

    `@Test("… threshold 0.4")` is a leftover threshold mention. Tokenize()
    skips quoted idents on purpose (so path strings do not explode keys);
    domain tags still need those words.
    """
    found: list[str] = []
    seen: set[str] = set()
    for m in IDENT_RE.finditer(text):
        ident = m.group(0)
        if not keep_ident(ident):
            continue
        if ident.lower() in seen:
            continue
        if ident.lower() in GENERIC_IDENTS and not distinctive_ident(ident):
            continue
        seen.add(ident.lower())
        found.append(ident)
    return tuple(found)


def mentions_name(text: str, name: str) -> bool:
    """Quoted or unquoted surface of a natal binder."""
    if not name:
        return False
    if holds_ident_forms(text, name) or quoted_only_hold(text, name):
        return True
    for s in surfaces(name):
        if not s:
            continue
        if re.search(rf"(?<![A-Za-z0-9_]){re.escape(s)}(?![A-Za-z0-9_])", text):
            return True
    return False


def extract_domain(text: str, token: str, *, path: str = "") -> Domain:
    """Domain tag of a natal token. Ident keys are their own domain."""
    if not is_number_token(token) and " " not in token and re.fullmatch(
        r"[A-Za-z_][A-Za-z0-9_]*", token or ""
    ):
        stems = domain_stems_of(token) + cjk_domain_stems(text)
        return Domain(token, "ident", stems=tuple(dict.fromkeys(stems)), neighbors=neighbor_idents(text))

    spans = token_spans(text, token)
    if not spans:
        stems = cjk_domain_stems(text)
        return Domain(None, "prose", stems=stems, neighbors=neighbor_idents(text))

    binders: list[tuple[str | None, str]] = [binder_for_span(text, a, b) for a, b in spans]
    # Prefer a named slot/call over cutoff/prose when the line has both.
    named = [(b, k) for b, k in binders if b]
    if named:
        binder, kind = named[0]
    else:
        binder, kind = binders[0]

    stems: list[str] = []
    if binder:
        stems.extend(domain_stems_of(binder))
    stems.extend(cjk_domain_stems(text))
    if kind == "cutoff" and "threshold" not in stems:
        stems.append("threshold")
    neighbors = neighbor_idents(text)
    for n in neighbors:
        for s in domain_stems_of(n):
            if s not in stems:
                stems.append(s)
    if path:
        base = Path(path).stem
        for s in ident_parts(base):
            if s in {"test", "tests", "spec", "docs", "doc", "src", "lib"}:
                continue
            if s not in stems and s not in GENERIC_DOMAIN_PARTS:
                # Path stems are neighbors, not binders — they help affinity later.
                pass
    return Domain(binder, kind, stems=tuple(dict.fromkeys(stems)), neighbors=neighbors)


def path_domain_stems(path: str) -> set[str]:
    if not path:
        return set()
    base = Path(path.replace("\\", "/")).stem
    drop = {"test", "tests", "spec", "specs", "docs", "doc", "src", "lib", "source"}
    return {p for p in ident_parts(base) if p not in drop and p not in GENERIC_DOMAIN_PARTS}


def path_affinity(natal_path: str, hit_path: str) -> bool:
    a = path_domain_stems(natal_path)
    b = path_domain_stems(hit_path)
    if not a or not b:
        return False
    return bool(a & b)


def stem_overlap(a: Iterable[str], b: Iterable[str]) -> set[str]:
    sa, sb = set(a), set(b)
    if sa & sb:
        return sa & sb
    # present ⊂ presentThreshold: share a part
    parts_a = set()
    parts_b = set()
    for x in sa:
        parts_a.update(ident_parts(x))
        alias = DOMAIN_ALIAS.get(x) or DOMAIN_ALIAS.get(x.lower())
        if alias:
            parts_a.add(alias)
    for x in sb:
        parts_b.update(ident_parts(x))
        alias = DOMAIN_ALIAS.get(x) or DOMAIN_ALIAS.get(x.lower())
        if alias:
            parts_b.add(alias)
    return parts_a & parts_b


def domains_compatible(
    natal: Domain,
    hit: Domain,
    hit_text: str,
    *,
    natal_path: str = "",
    hit_path: str = "",
) -> bool:
    """True when the leftover token is the same natal domain.

    A named slot/call on the hit that does not inflect from the natal binder
    is a different cohort (alpha = 0.4 is not threshold = 0.4).
    Cutoff / prose leftovers of a slot natal are kin (the abandoned constant
    used as a cutoff) unless a conflicting binder is sitting on the number.
    """
    if natal.kind == "arith" or hit.kind == "arith":
        return natal.kind == "arith" and hit.kind == "arith"

    if natal.binder and hit.binder:
        if same_inflection(natal.binder, hit.binder) or stem_related(natal.binder, hit.binder):
            return True
        if holds_ident_forms(hit_text, natal.binder):
            return True
        if stem_overlap(natal.stems, hit.stems):
            # presentThreshold vs present: shared stem, same family
            # threshold vs alpha: no shared stem
            if hit.kind in {"slot", "call"} and not stem_overlap(
                domain_stems_of(natal.binder), domain_stems_of(hit.binder)
            ):
                return False
            return True
        if hit.kind in {"slot", "call"}:
            return False

    if hit.binder and natal.binder is None:
        if stem_overlap(natal.stems, domain_stems_of(hit.binder)):
            return True
        if hit.kind in {"slot", "call"} and natal.kind not in {"prose", "cutoff"}:
            return False

    if natal.binder and mentions_name(hit_text, natal.binder):
        return True

    hit_stems = set(hit.stems)
    hit_stems.update(cjk_domain_stems(hit_text))
    for ident in ident_values(hit_text):
        hit_stems.update(domain_stems_of(ident))
    if stem_overlap(natal.stems, hit_stems):
        return True

    if hit.kind == "cutoff" and natal.kind in {"slot", "cutoff", "ident"}:
        if path_affinity(natal_path, hit_path):
            return True
        # Cutoff with no conflicting binder and natal was a bound constant:
        # leftover "x > 0.4" / "0.4を下回る" is the unpaid threshold.
        if not hit.binder:
            return natal.kind in {"slot", "cutoff"}

    if hit.kind == "prose" and natal.kind in {"slot", "cutoff", "ident"}:
        if path_affinity(natal_path, hit_path):
            return True
        return False

    return False


def hit_in_domain(
    hit: Hit,
    token: str,
    natal: Domain,
    *,
    natal_path: str = "",
) -> bool:
    hit_dom = extract_domain(hit.text, token, path=hit.path)
    return domains_compatible(
        natal, hit_dom, hit.text, natal_path=natal_path, hit_path=hit.path
    )


def primary_domain(text: str, tokens: Iterable[str], *, path: str = "") -> Domain | None:
    toks = list(tokens)
    lits = [t for t in toks if is_number_token(t) or " " in t]
    ids = [t for t in toks if t not in lits]
    for t in lits + ids:
        d = extract_domain(text, t, path=path)
        if d.binder or d.kind in {"slot", "call", "cutoff"}:
            return d
    if toks:
        return extract_domain(text, toks[0], path=path)
    return None


def slot_value(natal_text: str, hit_text: str, natal_lit: str) -> str | None:
    n_lits = literal_values(natal_text)
    h_lits = literal_values(hit_text)
    if natal_lit in h_lits:
        return natal_lit
    vanished = n_lits - h_lits
    appeared = h_lits - n_lits
    if natal_lit in vanished and len(appeared) == 1:
        return next(iter(appeared))
    if natal_lit in vanished:
        natal_is_num = is_number_token(natal_lit)
        same = [x for x in appeared if is_number_token(x) == natal_is_num]
        if len(same) == 1:
            return same[0]
        if len(appeared) == 1:
            return next(iter(appeared))
    return None


