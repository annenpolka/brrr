def colorize(enabled: bool, code: str, text: str) -> str:
    if not enabled:
        return text
    return f"\033[{code}m{text}\033[0m"


def format_member(prefix: str, m: Member, color: bool, code: str) -> list[str]:
    tag = colorize(color, code, f"{prefix:<6}")
    if m.status == "gone" or m.path is None:
        return [f"{tag} {m.birth_path}:{m.birth_line}: {m.birth_text.strip()}"]
    loc = f"{m.path}:{m.line}:"
    line = f"{tag} {loc} {m.text.strip() if m.text else ''}"
    extra = []
    if m.holds:
        extra.append(f"holds {m.holds}")
    out = [line]
    if extra:
        out.append(f"       ({'; '.join(extra)})")
    return out


def format_cohort(c: Cohort, color: bool) -> str:
    b = c.birth
    birth_bit = f"{b.commit[:12]}  {b.date}  {b.subject}".strip()
    lines: list[str] = []
    if c.kind == "split" and len(c.factions) > 1:
        fac = "  ".join(
            f"{val}×{n}" for val, n in sorted(c.factions.items(), key=lambda kv: -kv[1])
        )
        head = colorize(color, "33", "split ")
        lines.append(f"{head} {len(c.factions)} factions  ·  {birth_bit}")
        lines.append(f"       HEAD {fac}")
    else:
        n_ow = len(c.owing)
        head = colorize(color, "31", "owing ")
        lines.append(f"{head} {n_ow} unpaid  ·  {birth_bit}")
    if c.pairs:
        lines.append(f"nee    {', '.join(c.pairs)}")
    if c.domain:
        lines.append(f"domain {c.domain}")
    if c.tagged:
        lines.append(f"keys   {', '.join(c.tagged)}")
    elif c.keys:
        lines.append(f"keys   {', '.join(c.keys)}")
    if c.abandoned or c.adopted:
        ab = ", ".join(c.abandoned) if c.abandoned else "—"
        ad = ", ".join(c.adopted) if c.adopted else "—"
        if c.adopted:
            lines.append(f"delta  {ab} → {ad}")
        else:
            lines.append(f"token  {ab}")
    if c.paid:
        lines.append("")
        for m in c.paid[:12]:
            lines.extend(format_member("paid", m, color, "36"))
    if c.owing:
        lines.append("")
        for m in c.owing[:MAX_MEMBERS]:
            lines.extend(format_member("owing", m, color, "31"))
        if len(c.owing) > MAX_MEMBERS:
            lines.append(f"       … {len(c.owing) - MAX_MEMBERS} more owing")
    if c.echo:
        lines.append("")
        for m in c.echo[:MAX_MEMBERS]:
            lines.extend(format_member("echo", m, color, "35"))
        if len(c.echo) > MAX_MEMBERS:
            lines.append(f"       … {len(c.echo) - MAX_MEMBERS} more echo")
    if c.alias:
        lines.append("")
        for m in c.alias[:8]:
            lines.extend(format_member("alias", m, color, "34"))
    if c.gone:
        lines.append("")
        for m in c.gone[:8]:
            lines.extend(format_member("gone", m, color, "33"))
    if c.kind == "split" and c.ok and not c.owing:
        lines.append("")
        for m in c.ok[:8]:
            holds = m.holds or "?"
            tag = colorize(color, "32", f"{holds:<6}")
            loc = f"{m.path}:{m.line}:" if m.path else f"{m.birth_path}:{m.birth_line}:"
            txt = (m.text or m.birth_text).strip()
            lines.append(f"{tag} {loc} {txt}")
    return "\n".join(lines)


def format_report(rep: Report, color: bool, *, show_empty: bool) -> str:
    ch = rep.change
    who = ch.commit[:12] if ch.commit else ch.spec
    header = f"change {ch.kind}  {who}  {ch.subject}".strip()
    chunks = [header]
    if not rep.cohorts:
        chunks.append("")
        chunks.append("no unpaid kin at HEAD")
        return "\n".join(chunks)
    shown = [c for c in rep.cohorts if c.debt() or show_empty]
    if not shown:
        chunks.append("")
        chunks.append("no unpaid kin at HEAD")
        return "\n".join(chunks)
    for i, c in enumerate(shown):
        chunks.append("")
        if i:
            chunks.append("---")
            chunks.append("")
        chunks.append(format_cohort(c, color))
    return "\n".join(chunks)


def member_json(m: Member) -> dict:
    return {
        "status": m.status,
        "path": m.path,
        "line": m.line,
        "text": m.text,
        "birth_path": m.birth_path,
        "birth_line": m.birth_line,
        "birth_text": m.birth_text,
        "shared": m.shared,
        "holds": m.holds,
        "domain": m.domain,
    }


def cohort_json(c: Cohort) -> dict:
    return {
        "kind": c.kind,
        "birth": {
            "commit": c.birth.commit,
            "date": c.birth.date,
            "subject": c.birth.subject,
            "path": c.birth.path,
            "region": c.birth.region,
            "uncommitted": c.birth.uncommitted,
        },
        "keys": c.keys,
        "abandoned": c.abandoned,
        "adopted": c.adopted,
        "pairs": c.pairs,
        "tagged": c.tagged,
        "domain": c.domain,
        "paid": [member_json(m) for m in c.paid],
        "owing": [member_json(m) for m in c.owing],
        "ok": [member_json(m) for m in c.ok],
        "gone": [member_json(m) for m in c.gone],
        "echo": [member_json(m) for m in c.echo],
        "alias": [member_json(m) for m in c.alias],
        "factions": c.factions,
    }


def format_tsv(rep: Report) -> str:
    rows = [
        "\t".join(
            [
                "kind",
                "status",
                "path",
                "line",
                "token",
                "domain",
                "holds",
                "text",
            ]
        )
    ]
    for c in rep.cohorts:
        token = c.keys[0] if c.keys else ""
        domain = c.domain or ""
        for group in (c.paid, c.owing, c.echo, c.alias, c.ok, c.gone):
            for m in group:
                rows.append(
                    "\t".join(
                        [
                            c.kind,
                            m.status,
                            m.path or m.birth_path or "",
                            str(m.line if m.line is not None else m.birth_line or ""),
                            token,
                            m.domain or domain,
                            m.holds or "",
                            (m.text or m.birth_text or "").replace("\t", " ").strip(),
                        ]
                    )
                )
    return "\n".join(rows)


def report_json(rep: Report) -> dict:
    ch = rep.change
    return {
        "version": VERSION,
        "change": {
            "spec": ch.spec,
            "kind": ch.kind,
            "commit": ch.commit,
            "parent": ch.parent,
            "date": ch.date,
            "subject": ch.subject,
        },
        "cohorts": [cohort_json(c) for c in rep.cohorts],
    }


