def parse_grep_line(line: str, tree: str | None) -> Hit | None:
    raw = line
    if tree:
        prefix = tree + ":"
        if raw.startswith(prefix):
            raw = raw[len(prefix) :]
    m = re.match(r"^(.*):(\d+):(.*)$", raw)
    if not m:
        return None
    return Hit(m.group(1), int(m.group(2)), m.group(3))


def grep_token(
    repo: str,
    token: str,
    tree: str | None,
    natal_domain: Domain | None = None,
    natal_path: str = "",
) -> list[Hit]:
    tag = natal_domain.tagged(token) if natal_domain else token
    cache_key = (repo, tree or "WT", tag, natal_path)
    if cache_key in _grep_cache:
        return _grep_cache[cache_key]
    args = ["grep", "-n", "-I", "-F"]
    wordish = (
        not is_number_token(token)
        and " " not in token
        and "." not in token
        and "-" not in token
    )
    if wordish:
        args.append("-w")
    # Short natal names are case-exact (t1 vs T1 are both wanted; we grep each).
    if is_number_token(token) or not SHORT_NATAL.match(token):
        if not SHORT_NATAL.match(token or ""):
            args.append("-i")
    args.extend(["-e", token])
    if tree:
        args.append(tree)
    args.extend(["--", ".", *EXCLUDE_PATHSPEC])
    code, out = git_ok(repo, args)
    if code not in (0, 1):
        _grep_cache[cache_key] = []
        return []
    hits: list[Hit] = []
    for line in out.splitlines():
        h = parse_grep_line(line, tree)
        if not h:
            continue
        if is_number_token(token):
            if not number_context_ok(h.text, token):
                continue
            if not float_hit_ok(h.text, token):
                continue
            if token not in token_values(h.text):
                if not num_appears_bare(h.text, token):
                    continue
                if not THRESHOLD_LINE.search(h.text) and not re.search(
                    rf"[=:<>]\s*{re.escape(token)}\b", h.text
                ):
                    continue
        else:
            if not (
                holds_surface(h.text, token)
                or holds_ident_forms(h.text, token)
                or quoted_only_hold(h.text, token)
                or token.lower() in h.text.lower()
            ):
                continue
        if natal_domain is not None and not hit_in_domain(
            h, token, natal_domain, natal_path=natal_path
        ):
            continue
        hits.append(h)
    _grep_cache[cache_key] = hits
    return hits


def grep_ident_forms(
    repo: str,
    name: str,
    tree: str | None,
    natal_domain: Domain | None = None,
    natal_path: str = "",
) -> list[Hit]:
    seen: set[tuple[str, int]] = set()
    out: list[Hit] = []
    # Inflection (t1/T1) is the same identity. Do not domain-filter surfaces
    # of the name itself — leftover T1 is unpaid kin of natal t1.
    for s in sorted(surfaces(name), key=len, reverse=True):
        if len(s) < 2:
            continue
        for h in grep_token(repo, s, tree):
            loc = (h.path, h.line)
            if loc in seen:
                continue
            if holds_surface(h.text, s) or quoted_only_hold(h.text, name):
                if natal_domain is not None and natal_domain.kind != "ident":
                    if not hit_in_domain(h, s, natal_domain, natal_path=natal_path):
                        continue
                seen.add(loc)
                out.append(h)
    return out


def read_tree_lines(repo: str, tree: str | None, path: str) -> list[str] | None:
    if tree is None:
        p = Path(repo) / path
        if not p.is_file():
            return None
        try:
            return p.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            return None
    code, out = git_ok(repo, ["show", f"{tree}:{path}"])
    if code != 0:
        return None
    return out.splitlines()


def follow_line(
    repo: str,
    tree: str | None,
    natal: AddedLine,
    key: str,
) -> Hit | None:
    lines = read_tree_lines(repo, tree, natal.path)
    natal_strip = natal.text.strip()
    q = token_values(natal.text)
    ids = ident_values(natal.text)
    if lines is not None:
        for i, t in enumerate(lines, 1):
            if t.strip() == natal_strip:
                return Hit(natal.path, i, t)
        best: Hit | None = None
        best_n = -1
        for i, t in enumerate(lines, 1):
            toks = token_values(t)
            ov = len(toks & q)
            hid = ident_values(t)
            if ids:
                if any(
                    same_inflection(a, b) or a.lower() == b.lower()
                    for a in ids
                    for b in hid
                ):
                    ov += 2
                elif any(holds_ident_forms(t, a) for a in ids):
                    ov += 2
            if key and (
                key in toks
                or holds_ident_forms(t, key)
                or (is_number_token(key) and slot_value(natal.text, t, key))
            ):
                ov += 2
            if ov > best_n:
                best_n = ov
                best = Hit(natal.path, i, t)
        if best is not None and best_n >= 2:
            return best

    search = sorted(ids, key=len, reverse=True)[:4]
    for ident in search:
        hits = grep_ident_forms(repo, ident, tree)
        same = [h for h in hits if h.path == natal.path]
        pool = same or hits
        scored: list[tuple[int, Hit]] = []
        for h in pool:
            ov = len(token_values(h.text) & q)
            if ov:
                scored.append((ov, h))
        if scored:
            scored.sort(key=lambda x: -x[0])
            return scored[0][1]
    followed = follow_via_log_l(repo, tree, natal)
    if followed is not None:
        return followed
    return None


def follow_via_log_l(repo: str, tree: str | None, natal: AddedLine) -> Hit | None:
    """Rename-follow a natal sibling whose path moved and whose tokens inflected.

    Same-path grep misses `timing.py` → `wait.py` after `t1` became `driftDelay`.
    `git log -L --follow` walks the line.
    """
    spec = f"{natal.line},{natal.line}:{natal.path}"
    at = tree or "HEAD"
    code, out = git_ok(
        repo,
        [
            "log",
            "-L",
            spec,
            f"{at}",
            "-p",
            "--follow",
            "--pretty=format:%x1e%H",
        ],
        timeout=LOG_L_TIMEOUT,
    )
    if code != 0 or not out.strip():
        return None
    records = [r for r in out.split("\x1e") if r.strip()]
    if not records:
        return None
    newest = records[0]
    body = newest.partition("\n")[2]
    path = natal.path
    last_plus = ""
    last_ctx = ""
    new_line = natal.line
    hunk_new = natal.line
    plus_i = 0
    for line_txt in body.splitlines():
        if line_txt.startswith("+++ "):
            rest = line_txt[4:]
            if rest.startswith("b/"):
                rest = rest[2:]
            if not rest.startswith("/dev/null"):
                path = unquote_git_path(rest)
            continue
        hm = HUNK_RE.match(line_txt)
        if hm:
            hunk_new = int(hm.group(3))
            plus_i = 0
            continue
        if line_txt.startswith("+") and not line_txt.startswith("+++"):
            last_plus = line_txt[1:]
            new_line = hunk_new + plus_i
            plus_i += 1
        elif line_txt.startswith(" "):
            last_ctx = line_txt[1:]
            plus_i += 1
        elif line_txt.startswith("-") and not line_txt.startswith("---"):
            pass
    text = last_plus or last_ctx
    if not text:
        return None
    if tree is None:
        lines = read_tree_lines(repo, None, path)
        if lines:
            for i, t in enumerate(lines, 1):
                if t.strip() == text.strip():
                    return Hit(path, i, t)
    return Hit(path, new_line, text)


def locate_natal(
    repo: str,
    tree: str | None,
    natal: AddedLine,
    keys: list[str],
    paid_locs: set[tuple[str, int]],
    paid_texts: set[str],
) -> list[Hit]:
    sib_tokens = token_values(natal.text)
    search_keys = [k for k in keys if k.lower() in sib_tokens or holds_ident_forms(natal.text, k)]
    if not search_keys:
        lits = [t for t in literal_values(natal.text) if t not in COMMON_NUM]
        search_keys = sorted(lits, key=len, reverse=True)[:3]
    if not search_keys:
        search_keys = sorted(sib_tokens, key=len, reverse=True)[:3]
    if not search_keys:
        return []

    def key_rank(k: str) -> tuple[int, int]:
        if is_number_token(k) or " " in k:
            return (0, -len(k))
        if distinctive_ident(k):
            return (1, -len(k))
        return (2, -len(k))

    search_keys = sorted(search_keys, key=key_rank)

    lit_keys = [k for k in keys if is_number_token(k) or " " in k]
    distinct_id_keys = [k for k in keys if not is_number_token(k) and " " not in k and distinctive_ident(k)]
    natal_dom = None
    for k in lit_keys + [k for k in keys if k not in lit_keys]:
        natal_dom = extract_domain(natal.text, k, path=natal.path)
        if natal_dom.binder or natal_dom.kind in {"slot", "call", "cutoff"}:
            break

    candidates: list[Hit] = []
    for key in search_keys:
        if is_number_token(key) or " " in key:
            hits = grep_token(
                repo, key, tree, natal_domain=natal_dom, natal_path=natal.path
            )
        else:
            hits = grep_ident_forms(
                repo, key, tree, natal_domain=natal_dom, natal_path=natal.path
            )
            if not distinctive_ident(key):
                # Generic ident (threshold): keep hits bound to a natal literal
                # or distinctive sibling, plus leftover docs/tests. Other
                # modules' same-spelled locals (SiteObserver.threshold=0.7)
                # are not this family.
                filtered: list[Hit] = []
                for h in hits:
                    if any(holds_literal(h.text, lit) for lit in lit_keys):
                        filtered.append(h)
                        continue
                    if any(holds_ident_forms(h.text, d) for d in distinct_id_keys):
                        filtered.append(h)
                        continue
                    if path_is_doc_or_test(h.path):
                        filtered.append(h)
                hits = filtered
        if hits:
            candidates = hits
            break
    if not candidates:
        return []

    scored: list[tuple[int, bool, Hit]] = []
    natal_strip = natal.text.strip()
    for h in candidates:
        if (h.path, h.line) in paid_locs:
            continue
        if h.text.strip() in paid_texts and h.path == natal.path:
            continue
        overlap = token_values(h.text) & sib_tokens
        score = len(overlap)
        if any(holds_ident_forms(h.text, k) for k in keys if not is_number_token(k)):
            score += 2
        if h.text.strip() == natal_strip:
            score += 4
        if h.path == natal.path:
            score += 1
        if score <= 0:
            continue
        literal = any(is_number_token(tok) or " " in tok for tok in overlap)
        scored.append((score, literal, h))
    if not scored:
        return []
    best = max(s for s, _, _ in scored)
    kept: list[Hit] = []
    for score, literal, h in scored:
        if score < best:
            continue
        if score >= 2 or h.path == natal.path or literal:
            kept.append(h)
    if best == 1 and len(kept) > 8:
        same = [h for h in kept if h.path == natal.path]
        kept = same or kept[:5]
    elif len(kept) > 12:
        same = [h for h in kept if h.path == natal.path]
        kept = same or kept[:12]
    return kept


