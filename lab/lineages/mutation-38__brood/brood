def run_selftest() -> None:
    fails: list[str] = []

    def expect(cond: bool, msg: str) -> None:
        if not cond:
            fails.append(msg)

    toks = token_values("TIMEOUT = 30  # 15s later")
    expect("timeout" in toks, f"ident TIMEOUT missing: {toks}")
    expect("30" in toks, f"num 30 missing: {toks}")
    expect("15" in toks, f"unit 15s should yield 15: {toks}")

    toks = token_values("t1: TimeInterval = 15")
    expect("t1" in toks, f"short natal t1 missing: {toks}")
    expect("15" in toks, f"15 missing next to t1: {toks}")

    toks = token_values("presentThreshold: Double = 0.45")
    expect("0.45" in toks, f"float missing: {toks}")
    expect("presentthreshold" in toks, f"camel missing: {toks}")

    toks = token_values(
        'const P = "data/fixtures/golden/direct-critical-armor.scenario.json";'
    )
    expect("critical" not in toks, f"idents leaked from string: {toks}")

    expect(same_inflection("present_threshold", "presentThreshold"), "snake/camel")
    expect(same_inflection("present-threshold", "PresentThreshold"), "kebab/pascal")
    expect(same_inflection("t1", "T1"), "t1/T1")
    expect(not same_inflection("t1", "driftDelay"), "t1 is not an inflection of driftDelay")
    expect(stem_related("threshold", "presentThreshold"), "threshold ⊂ presentThreshold")
    expect("T1" in surfaces("t1"), f"T1 surface of t1: {surfaces('t1')}")
    expect("present_threshold" in surfaces("presentThreshold"), "snake surface")

    pairs = pair_idents({"t1", "TimeInterval"}, {"driftDelay", "TimeInterval"})
    expect(pairs == [("t1", "driftDelay")], f"1:1 rename pair: {pairs}")

    pairs = pair_idents({"present_threshold"}, {"presentThreshold"})
    expect(
        pairs == [("present_threshold", "presentThreshold")],
        f"inflection pair: {pairs}",
    )

    pairs = pair_idents({"threshold", "Double"}, {"presentThreshold", "Double"})
    expect(
        pairs == [("threshold", "presentThreshold")],
        f"stem-containment pair: {pairs}",
    )

    expect(
        slot_idents("t1: TimeInterval = 15") == ["t1"],
        f"slot t1: {slot_idents('t1: TimeInterval = 15')}",
    )
    expect(
        slot_idents("present_threshold = 0.4") == ["present_threshold"],
        f"slot snake: {slot_idents('present_threshold = 0.4')}",
    )
    expect(
        slot_idents("return (.drift(since: now), updatedCounters)") == [],
        "return-site is not a declaration slot",
    )
    expect(
        pair_line_idents("t1: TimeInterval = 15", "driftDelay: TimeInterval = 15")
        == [("t1", "driftDelay")],
        "slot 1:1 t1↔driftDelay",
    )
    expect(
        pair_line_idents(
            "return (.drift(since: now), counters)",
            "return (.drift(since: now), updatedCounters)",
        )
        == [],
        f"local counters→updatedCounters is not natal: {pair_line_idents('return (.drift(since: now), counters)', 'return (.drift(since: now), updatedCounters)')}",
    )
    expect(
        pair_line_idents(
            "AXUIElementCopyAttributeValue(window, title)",
            "AXUIElementCopyAttributeValue(focusedWindow, title)",
        )
        == [],
        "window↔focusedWindow is not a natal pair",
    )
    expect(
        pair_line_idents(
            ".shadow(color: phaseColor, radius: 8)",
            "center: CGPoint(x: cornerRadius, y: 0)",
        )
        == [],
        "radius↔cornerRadius is not a natal pair",
    )
    expect(
        not stem_related("counters", "updatedCounters"),
        "updated- prefix is stem noise",
    )
    expect(
        stem_related("threshold", "presentThreshold"),
        "present+threshold stays related",
    )

    expect(holds_ident_forms("T1 = 15秒（FLOW→DRIFT閾値）", "t1"), "T1 holds t1")
    expect(holds_ident_forms("t1: 15", "T1"), "t1 holds T1")
    expect(
        holds_ident_forms("present_threshold: 0.4", "presentThreshold"),
        "snake holds camel",
    )
    expect(
        not holds_ident_forms("presentThreshold: Double = 0.45", "threshold"),
        "camel must not hold bare threshold as a token",
    )
    expect(quoted_only_hold('case flowThreshold = "t1"', "t1"), "CodingKeys t1")
    expect(
        not holds_ident_forms('case flowThreshold = "t1"', "t1"),
        "quoted t1 is not a code ident",
    )

    expect(number_context_ok("timeout: 300", "300"), "bare 300 should pass")
    expect(
        not number_context_ok("if !(200..<300).contains(code)", "300"),
        "range bound 300 should fail",
    )
    expect(not float_hit_ok("yaw: 0.4, pitch: 0.0", "0.4"), "gaze yaw")
    expect(not holds_literal("ema=0.42", "0.4"), "0.4 must not match 0.42")
    expect(
        not acceptable_debt_literal("5", "## 5. Run just check", "README.md"),
        "heading 5 in markdown is not debt",
    )
    expect(
        acceptable_debt_literal("0.4", "threshold: Double = 0.4,", "PresenceArbiter.swift"),
        "float threshold is debt",
    )

    expect(looks_like_location("config.py:1"), "config.py:1 is a location")
    expect(not looks_like_location("HEAD"), "HEAD is not a location")
    expect(not looks_like_location("e9b0f75"), "short hash is not a location")

    expect(distinctive_ident("t1"), "t1 distinctive")
    expect(distinctive_ident("present_threshold"), "two-part distinctive")
    expect(not distinctive_ident("threshold"), "bare threshold is generic")

    st = classify_hit("T1 = 15秒", {"t1", "15"}, {"driftDelay"})
    expect(st == "owing", f"docs T1 should owe: {st}")
    st = classify_hit("driftDelay: TimeInterval = 15", {"t1"}, {"driftDelay"})
    expect(st == "ok", f"paid rename is ok: {st}")
    st = classify_hit('case flowThreshold = "t1"', {"t1"}, {"driftDelay"})
    expect(st == "alias", f"CodingKeys should alias: {st}")
    st = classify_hit("present_threshold: 0.4", {"present_threshold", "0.4"}, {"presentThreshold", "0.45"})
    expect(st == "owing", f"old snake surface owes: {st}")

    d_thr = extract_domain("threshold: Double = 0.4,", "0.4")
    expect(d_thr.binder == "threshold", f"binder threshold: {d_thr}")
    expect(d_thr.kind == "slot", f"kind slot: {d_thr.kind}")
    expect(d_thr.tagged("0.4") == "0.4@threshold", d_thr.tagged("0.4"))

    d_alpha = extract_domain("alpha = 0.4  # overlay wash", "0.4")
    expect(d_alpha.binder == "alpha", f"binder alpha: {d_alpha}")
    expect(d_alpha.tagged("0.4") == "0.4@alpha", d_alpha.tagged("0.4"))

    d_op = extract_domain(".foregroundStyle(.white.opacity(0.4))", "0.4")
    expect(d_op.binder == "opacity", f"binder opacity: {d_op}")
    expect(d_op.kind == "call", d_op.kind)

    d_rgba = extract_domain("color: rgba(0, 0, 0, 0.4)", "0.4")
    expect(d_rgba.binder == "rgba", f"binder rgba: {d_rgba}")

    d_cut = extract_domain("normalized > 0.4 → .present", "0.4")
    expect(d_cut.kind == "cutoff", f"cutoff: {d_cut}")

    d_jp = extract_domain("// 3回目で0.4を下回る", "0.4")
    expect(d_jp.kind == "cutoff", f"jp cutoff: {d_jp}")

    expect(
        not domains_compatible(d_thr, d_alpha, "alpha = 0.4"),
        "0.4@threshold is not 0.4@alpha",
    )
    expect(
        not domains_compatible(d_thr, d_op, ".white.opacity(0.4)"),
        "0.4@threshold is not 0.4@opacity",
    )
    expect(
        domains_compatible(
            d_thr,
            extract_domain("`threshold: Double = 0.4`", "0.4"),
            "`threshold: Double = 0.4`",
        ),
        "docs quoting natal slot stay in domain",
    )
    expect(
        domains_compatible(
            d_thr,
            d_cut,
            "normalized > 0.4 → .present",
            natal_path="PresenceArbiter.swift",
            hit_path="SPEC.md",
        )
        or "present" in d_cut.stems
        or "present" in ident_values("normalized > 0.4 → .present"),
        "cutoff leftover of a threshold natal is kin",
    )
    expect(
        domains_compatible(
            extract_domain("t1: TimeInterval = 15", "t1"),
            extract_domain("T1 = 15秒（FLOW→DRIFT閾値）", "t1"),
            "T1 = 15秒（FLOW→DRIFT閾値）",
        ),
        "T1 inflection stays unpaid kin",
    )
    expect("0.4@threshold" != "0.4@opacity", "tag strings differ")

    quoted = '@Test("カメラのみpresent → 総合present（weight 0.50 > threshold 0.4）")'
    d_quoted = extract_domain(quoted, "0.4")
    expect(d_quoted.binder != "Test", f"quoted 0.4 must not bind to Test: {d_quoted}")
    expect(
        domains_compatible(d_thr, d_quoted, quoted),
        "quoted leftover 'threshold 0.4' stays in the threshold brood",
    )

    diff = """diff --git a/core.py b/core.py
--- a/core.py
+++ b/core.py
@@ -1,2 +1,2 @@
-t1 = 15
-present_threshold = 0.4
+driftDelay = 15
+presentThreshold = 0.45
"""
    hunks = parse_hunks(diff)
    r, a, d = events_from_hunks(hunks)
    expect(len(r) == 2, f"two replacements, got {r}")
    p0 = pair_idents(ident_values(r[0].old_text), ident_values(r[0].new_text))
    p1 = pair_idents(ident_values(r[1].old_text), ident_values(r[1].new_text))
    expect(p0 == [("t1", "driftDelay")], f"hunk t1 pair {p0}")
    expect(p1 == [("present_threshold", "presentThreshold")], f"hunk snake pair {p1}")

    if fails:
        print("selftest FAILED:")
        for f in fails:
            print(" -", f)
        raise SystemExit(1)
    print("selftest ok")


