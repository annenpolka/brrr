@dataclass(frozen=True)
class Domain:
    """Natal domain of a token: binder at birth, not a global byte match.

    kind: slot (name = 0.4) | call (opacity(0.4)) | cutoff (x > 0.4)
          | arith (height * 0.4) | ident (the name itself) | prose
    """

    binder: str | None
    kind: str
    stems: tuple[str, ...] = ()
    neighbors: tuple[str, ...] = ()

    def label(self) -> str:
        if self.binder:
            return self.binder
        if self.kind == "cutoff":
            return "cutoff"
        if self.kind == "arith":
            return "scale"
        if self.kind == "ident":
            return "ident"
        return "prose"

    def tagged(self, token: str) -> str:
        return f"{token}@{self.label()}"


