HELP = """\
dreg — SUPERSEDED occupancy as an applyable patch

A hunk is a before→after image claim. sate reports how a tree occupies
each claim. dreg occupies, then stdout is a unified diff of the picked
cores. Default pick is SUPERSEDED (the dregs: what HEAD no longer occupies).
--pick PENDING is the leftover apply.

Sandwich: against C, SUPERSEDED of C^..C is empty. Against a later
rewrite, the old cores come out as a patch.

Not git apply --check. Not git-format-patch. Not GitHub outdated.

Usage:
  dreg PATCH                 occupy PATCH, emit --pick (default SUPERSEDED)
  dreg -                     occupy a diff on stdin
  dreg --git REV             occupy `git show REV` (or A..B as diff)
  dreg --log [N]             last N non-merge commits, each occupied
  dreg --log A..B            each commit in the range, occupied
  dreg --selftest

Tree:
  -C DIR           repository / tree root (default: cwd)
  --against REF    read files from git REF (default HEAD in a repo)
  --worktree       read the dirty worktree instead of HEAD

Pick / emit:
  --pick FATE[,FATE]   APPLIED,PENDING,MIXED,DUPLEX,SUPERSEDED
                       default SUPERSEDED
  --core               minus/plus only (0-context; git apply --unidiff-zero)
  --full               emit original hunks (default for PENDING leftover)
                       SUPERSEDED default: cores + 1 original context line

Report (instead of a patch):
  --report / --json / --tsv / --stat

Matching:
  --ignore-space
  --fuzz               opt-in ≥0.85 window overlap
  --first-parent       with --log

Exit:
  0  empty pick (no dregs / no leftover)
  1  emitted a patch
  2  --report: occupancy split
  3  error
"""


def resolve_against(root: Path, args: argparse.Namespace) -> str | None:
    if args.worktree:
        return None
    if args.against is not None:
        return args.against
    if in_git_repo(root):
        return "HEAD"
    return None


def cores_for(args: argparse.Namespace, want: set[str]) -> bool:
    if args.full:
        return False
    if args.core:
        return True
    # SUPERSEDED (and mixed dead-ish fates) → cores. PENDING leftover apply → full.
    if want <= {"PENDING"}:
        return False
    return True


def format_report(rows: list[Occupied], extra: dict, args: argparse.Namespace) -> str:
    if args.json:
        payload = {
            **extra,
            "unanimous": unanimous(rows),
            "counts": counted(rows),
            "hunks": [r.as_dict() for r in rows if r.verdict.fate != "SKIP"],
        }
        return json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
    if args.tsv:
        lines = [
            "fate\tpath\thunk\tkind\tmethod\tcommit\theader"
        ]
        for r in rows:
            v = r.verdict
            if v.fate == "SKIP":
                continue
            lines.append(
                "\t".join(
                    [
                        v.fate,
                        v.path,
                        str(v.hunk),
                        v.kind,
                        v.method,
                        r.commit[:12],
                        v.header.replace("\t", " "),
                    ]
                )
            )
        return "\n".join(lines) + "\n"
    if args.stat:
        c = counted(picked(rows, parse_pick(args.pick)))
        n = sum(c.values())
        bits = " ".join(f"{k}={v}" for k, v in sorted(c.items()) if v)
        lines = [f"{n} hunks  {bits}".rstrip()]
        for r in picked(rows, parse_pick(args.pick)):
            v = r.verdict
            loc = f"{v.path}"
            if r.commit:
                loc = f"{r.commit[:8]}  {loc}"
            minus = len(r.hunk.minus) if r.hunk else 0
            plus = len(r.hunk.plus) if r.hunk else 0
            subj = f"  {r.subject}" if r.subject else ""
            lines.append(f"{v.fate:<11} {loc}  -{minus}/+{plus}  {v.method}{subj}")
        return "\n".join(lines) + "\n"
    return legend(
        rows,
        parse_pick(args.pick),
        extra.get("against"),
        str(extra.get("title") or extra.get("git") or "."),
    )


def run_occupy(
    rows: list[Occupied],
    args: argparse.Namespace,
    extra: dict,
) -> int:
    want = parse_pick(args.pick)
    extra.setdefault("pick", sorted(want))
    if args.stat:
        chosen = picked(rows, want)
        sys.stdout.write(format_report(rows, extra, args))
        if args.report_only:
            return 0
        return EXIT_EMPTY if not chosen else EXIT_DREGS
    report = args.report or args.json or args.tsv
    if report:
        sys.stdout.write(format_report(rows, extra, args))
        uni = unanimous(rows)
        if args.report_only:
            return 0
        if uni in ("APPLIED", "EMPTY"):
            return EXIT_EMPTY
        if uni == "PENDING":
            return EXIT_DREGS
        return EXIT_SPLIT

    chosen = picked(rows, want)
    cores = cores_for(args, want)
    margin = 0 if args.core else 1
    patch = emit_patch(chosen, cores=cores, margin=margin)
    if not args.quiet:
        sys.stderr.write(
            legend(rows, want, extra.get("against"), str(extra.get("title") or "."))
        )
    sys.stdout.write(patch)
    if args.report_only:
        return 0
    return EXIT_EMPTY if not patch else EXIT_DREGS


def looks_like_rev(root: Path, spec: str) -> bool:
    if spec in ("-",) or spec.startswith("-"):
        return False
    if ".." in spec:
        return True
    proc = git(["rev-parse", "--verify", "--quiet", spec], root)
    return proc.returncode == 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="dreg",
        description="SUPERSEDED occupancy as an applyable patch",
        add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "patch",
        nargs="?",
        help="unified diff file, git rev / A..B, or - for stdin",
    )
    p.add_argument("-C", default=".", metavar="DIR", help="tree root")
    p.add_argument("--against", default=None, metavar="REF", help="git ref to read")
    p.add_argument("--worktree", action="store_true", help="read dirty worktree")
    p.add_argument("--git", metavar="REV", help="occupy git show REV / git diff A..B")
    p.add_argument(
        "--log",
        nargs="?",
        const="15",
        metavar="N|RANGE",
        help="occupy last N non-merge commits, or each commit in RANGE",
    )
    p.add_argument("--first-parent", action="store_true")
    p.add_argument(
        "--pick",
        default="SUPERSEDED",
        metavar="FATE[,FATE]",
        help="default SUPERSEDED",
    )
    p.add_argument("--core", action="store_true", help="emit minus/plus only")
    p.add_argument("--full", action="store_true", help="emit original hunks")
    p.add_argument("--report", action="store_true", help="occupancy report, not a patch")
    p.add_argument("--report-all", action="store_true")
    p.add_argument("--stat", action="store_true")
    p.add_argument("--ignore-space", action="store_true")
    p.add_argument("--fuzz", dest="fuzz", action="store_true", default=False)
    p.add_argument("--no-fuzz", dest="fuzz", action="store_false")
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--report-only", action="store_true", help="always exit 0")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(HELP)
        return 0
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"dreg {VERSION}")
        return 0
    if args.selftest:
        return selftest(fuzz=args.fuzz)

    root = Path(args.C).resolve()
    try:
        want = parse_pick(args.pick)
    except RuntimeError as e:
        print(f"dreg: {e}", file=sys.stderr)
        return EXIT_ERROR
    args.pick = ",".join(sorted(want))  # normalized
    norm = space_norm if args.ignore_space else ident
    against = resolve_against(root, args)

    try:
        if args.log is not None:
            revs = log_revs(root, args.log, first_parent=args.first_parent)
            rows: list[Occupied] = []
            for h, _, subj in revs:
                try:
                    rows.extend(
                        occupy_rev(root, h, against, norm, args.fuzz, h, subj)
                    )
                except RuntimeError as e:
                    print(f"dreg: skip {h[:8]}: {e}", file=sys.stderr)
            return run_occupy(
                rows,
                args,
                {
                    "title": f"log:{args.log}",
                    "against": against,
                    "tree": str(root),
                    "n": len(revs),
                },
            )

        git_rev = args.git
        patch_arg = args.patch
        if git_rev is None and patch_arg and looks_like_rev(root, patch_arg) and not Path(patch_arg).is_file():
            git_rev = patch_arg
            patch_arg = None

        if git_rev:
            rows = occupy_rev(root, git_rev, against, norm, args.fuzz, commit=git_rev)
            return run_occupy(
                rows,
                args,
                {
                    "title": f"git:{git_rev}",
                    "git": git_rev,
                    "against": against,
                    "tree": str(root),
                },
            )

        text = None
        title = "stdin"
        if patch_arg == "-" or (patch_arg is None and not sys.stdin.isatty()):
            text = sys.stdin.read()
            title = "stdin"
        elif patch_arg:
            text = Path(patch_arg).read_text(encoding="utf-8")
            title = patch_arg
        else:
            sys.stdout.write(HELP)
            return EXIT_ERROR

        files = parse_patch(text)
        if not files:
            print("dreg: no hunks in patch", file=sys.stderr)
            return EXIT_EMPTY
        rows = occupy_files(files, root, against, norm, fuzz=args.fuzz)
        return run_occupy(
            rows,
            args,
            {"title": title, "patch": title, "against": against, "tree": str(root)},
        )
    except BrokenPipeError:
        return 0
    except RuntimeError as e:
        print(f"dreg: {e}", file=sys.stderr)
        return EXIT_ERROR
    except OSError as e:
        print(f"dreg: {e}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
