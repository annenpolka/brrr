#!/usr/bin/env python3
"""scribe — rewrite locators inside SARIF / clang / Swift JSON diagnostics.

A pure Unix filter. Never talks to git. stdin is a SARIF log, a clang
-fdiagnostics-format=json array, Swift serialized diagnostics, or NDJSON
of those. Locators live in nested schema fields (uri + startLine, caret
file/line/offset, key.filepath + key.line), not cargo's sibling
file_name + line_start. stdout is the same schema with addresses
rewritten from --from-dir onto --to-dir by content fingerprint.
"""
from __future__ import annotations

