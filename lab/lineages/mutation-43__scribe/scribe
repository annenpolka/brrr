@dataclass
class Hit:
    path: str
    line: int
    col: Optional[int] = None
    span: tuple[int, int] = (0, 0)
    form: str = "colon"  # python | colon | arrow | basename
    quote: str = '"'
    raw_path: str = ""


@dataclass
class Resolution:
    hit: Hit
    status: str  # same | shifted | moved | edited | deleted | unresolved
    dest_path: Optional[str] = None
    dest_line: Optional[int] = None
    score: float = 0.0
    note: str = ""
    dest_text: str = ""


@dataclass
class Carry:
    """Last rewritten locator, so rustc/clang `NNN |` gutters can follow it."""
    old_line: int
    dest_line: int
    ttl: int


@dataclass
class Snapshot:
    label: str
    files: dict[str, list[str]]
    by_norm: dict[str, list[tuple[str, int]]] = field(default_factory=lambda: defaultdict(list))
    by_token: dict[str, list[tuple[str, int]]] = field(default_factory=lambda: defaultdict(list))
    token_df: dict[str, int] = field(default_factory=lambda: defaultdict(int))
    paths: tuple[str, ...] = ()
    by_basename: dict[str, list[str]] = field(default_factory=lambda: defaultdict(list))
    path_set: frozenset[str] = field(default_factory=frozenset)

    def index(self) -> None:
        self.by_norm.clear()
        self.by_token.clear()
        self.token_df.clear()
        self.by_basename.clear()
        seen_token_file: dict[str, set[str]] = defaultdict(set)
        for path, lines in self.files.items():
            self.by_basename[os.path.basename(path)].append(path)
            for i, raw in enumerate(lines, start=1):
                n = normalize(raw)
                if n not in TRIVIAL_NORMS:
                    self.by_norm[n].append((path, i))
                for tok in tokens(raw):
                    self.by_token[tok].append((path, i))
                    seen_token_file[tok].add(path)
        for tok, files in seen_token_file.items():
            self.token_df[tok] = len(files)
        self.paths = tuple(sorted(self.files.keys(), key=lambda p: len(p), reverse=True))
        self.path_set = frozenset(self.files.keys())


@dataclass
class Ctx:
    src: Snapshot
    dst: Snapshot
    context: int
    debug: bool
    trace: bool
    cache: dict[tuple[str, int], Resolution] = field(default_factory=dict)
    traced: set[tuple[str, int, str, Optional[str], Optional[int]]] = field(default_factory=set)
    unresolved: bool = False
    artifacts: list[Optional[str]] = field(default_factory=list)

    def resolve(self, hit: Hit) -> Resolution:
        key = (hit.path, hit.line)
        base = self.cache.get(key)
        if base is None:
            base = resolve_hit(hit, self.src, self.dst, self.context, self.debug)
            self.cache[key] = base
        res = Resolution(
            hit=Hit(
                path=base.hit.path,
                line=base.hit.line,
                col=hit.col,
                span=hit.span,
                form=hit.form,
                quote=hit.quote,
                raw_path=hit.raw_path,
            ),
            status=base.status,
            dest_path=base.dest_path,
            dest_line=base.dest_line,
            score=base.score,
            note=base.note,
            dest_text=base.dest_text,
        )
        if res.status == "unresolved":
            self.unresolved = True
        if self.trace:
            tkey = (res.hit.path, res.hit.line, res.status, res.dest_path, res.dest_line)
            if tkey not in self.traced:
                self.traced.add(tkey)
                print_trace(res)
        return res


def posix_rel(path: str) -> str:
    p = path.replace("\\", "/")
    while p.startswith("./"):
        p = p[2:]
    return p.lstrip("/") if p.startswith("/") and not os.path.isabs(path) else p


def should_skip_path(path: str) -> bool:
    parts = path.replace("\\", "/").split("/")
    if any(part in SKIP_DIRS or (part.startswith(".") and part not in (".", "..")) for part in parts[:-1]):
        return True
    name = parts[-1] if parts else ""
    if name.startswith(".") and name not in BARE_ALLOW:
        return True
    lower = path.lower()
    return any(lower.endswith(suf) for suf in SKIP_SUFFIXES)


def normalize(line: str) -> str:
    return re.sub(r"\s+", " ", line.strip())


def tokens(line: str) -> list[str]:
    out = []
    for m in IDENT_RE.findall(line):
        if m.lower() in STOPWORDS:
            continue
        if len(m) < 2:
            continue
        out.append(m)
    return out


def decode_bytes(data: bytes) -> Optional[str]:
    if b"\x00" in data[:4096]:
        return None
    if len(data) > MAX_FILE_BYTES:
        return None
    for enc in ("utf-8", "utf-8-sig", "latin-1"):
        try:
            return data.decode(enc)
        except UnicodeDecodeError:
            continue
    return data.decode("utf-8", "replace")


def walk_dir_files(root: Path) -> Iterator[str]:
    root = root.resolve()
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = [
            d for d in dirnames
            if d not in SKIP_DIRS and not d.startswith(".")
        ]
        for name in filenames:
            full = Path(dirpath) / name
            try:
                rel = full.relative_to(root).as_posix()
            except ValueError:
                continue
            if should_skip_path(rel):
                continue
            yield rel


def read_dir_file(root: Path, path: str) -> Optional[list[str]]:
    fp = root / path
    try:
        data = fp.read_bytes()
    except OSError:
        return None
    text = decode_bytes(data)
    if text is None:
        return None
    if text == "":
        return []
    return text.splitlines()


def load_snapshot(directory: Path, label: str) -> Snapshot:
    files: dict[str, list[str]] = {}
    for path in walk_dir_files(directory):
        lines = read_dir_file(directory, path)
        if lines is not None:
            files[path] = lines
    snap = Snapshot(label=label, files=files)
    snap.index()
    return snap


def bind_path(raw: str, snap: Snapshot) -> Optional[str]:
    p = posix_rel(raw.replace("\\", "/"))
    while p.startswith("./"):
        p = p[2:]
    if p in snap.path_set:
        return p
    best = None
    for kp in snap.path_set:
        if p.endswith("/" + kp) or p.endswith("\\" + kp):
            if best is None or len(kp) > len(best):
                best = kp
    if best:
        return best
    base = os.path.basename(p)
    hits = snap.by_basename.get(base, [])
    if len(hits) == 1:
        return hits[0]
    return None


def _boundary_ok(text: str, start: int, end: int) -> bool:
    if start > 0:
        prev = text[start - 1]
        if prev.isalnum() or prev in "._-":
            return False
    if end < len(text):
        nxt = text[end]
        if nxt.isalnum() or nxt in "._-":
            return False
    return True


def _in_url(text: str, start: int) -> bool:
    proto = text.rfind("://", 0, start)
    if proto < 0:
        return False
    chunk = text[proto:start]
    return all(c not in " \t\"'" for c in chunk)


def _basename_ok(name: str) -> bool:
    if not name or name in BASENAME_DENY:
        return False
    if name.lower() in BASENAME_DENY:
        return False
    if name in BARE_ALLOW:
        return True
    stem, ext = os.path.splitext(name)
    if ext.lower() in SOURCE_EXTS:
        return True
    return False


def _span_path_start(appeared: str, bound: str, path_start: int, path_end: int) -> tuple[int, str]:
    appeared_n = appeared.replace("\\", "/")
    bound_n = bound.replace("\\", "/")
    if appeared_n == bound_n:
        return path_start, "colon"
    if appeared_n.endswith("/" + bound_n):
        return path_end - len(bound), "colon"
    base = os.path.basename(bound_n)
    if appeared_n == base:
        return path_start, "basename"
    if appeared_n.endswith("/" + base) and bound_n.endswith("/" + base):
        return path_end - len(base), "basename"
    return path_start, "colon"


def _take(span: tuple[int, int], occupied: list[tuple[int, int]]) -> bool:
    s, e = span
    if s < 0 or e <= s:
        return False
    for os_, oe in occupied:
        if not (e <= os_ or s >= oe):
            return False
    occupied.append(span)
    return True


def find_hits(text: str, src: Snapshot) -> list[Hit]:
    """Pull locators out of one string value. Noise is whatever we do not take."""
    occupied: list[tuple[int, int]] = []
    found: list[Hit] = []

    for m in PY_TB_RE.finditer(text):
        if _in_url(text, m.start()):
            continue
        bound = bind_path(m.group("path"), src)
        if not bound:
            continue
        span = (m.start(), m.end())
        if not _take(span, occupied):
            continue
        found.append(
            Hit(
                path=bound,
                line=int(m.group("line")),
                span=span,
                form="python",
                quote=m.group("q"),
                raw_path=m.group("path"),
            )
        )

    for m in ARROW_RE.finditer(text):
        if _in_url(text, m.start()):
            continue
        appeared = m.group("path")
        bound = bind_path(appeared, src)
        if not bound:
            continue
        path_start, path_end = m.start("path"), m.end("path")
        span_start, form = _span_path_start(appeared, bound, path_start, path_end)
        span = (span_start, m.end())
        if not _take(span, occupied):
            continue
        col = int(m.group("col")) if m.group("col") else None
        found.append(
            Hit(
                path=bound,
                line=int(m.group("line")),
                col=col,
                span=span,
                form="arrow" if form != "basename" else "basename",
                raw_path=text[span_start:path_end],
            )
        )

    for m in COLON_NUM_RE.finditer(text):
        span_end = m.end()
        prefix = text[: m.start()]
        if not prefix:
            continue
        if _in_url(text, m.start()):
            continue
        bound = None
        appeared = None
        form = "colon"
        span_start = None
        for path in src.paths:
            if not path:
                continue
            if prefix.endswith(path) and _boundary_ok(text, m.start() - len(path), m.start()):
                bound = path
                appeared = path
                span_start = m.start() - len(path)
                form = "colon"
                break
        if bound is None:
            uniques = [
                (base, paths[0])
                for base, paths in src.by_basename.items()
                if len(paths) == 1 and _basename_ok(base)
            ]
            uniques.sort(key=lambda x: len(x[0]), reverse=True)
            for base, path in uniques:
                if prefix.endswith(base) and _boundary_ok(text, m.start() - len(base), m.start()):
                    bound = path
                    appeared = base
                    span_start = m.start() - len(base)
                    form = "basename"
                    break
        if bound is None or span_start is None:
            continue
        span = (span_start, span_end)
        if not _take(span, occupied):
            continue
        col = int(m.group(2)) if m.group(2) else None
        found.append(
            Hit(
                path=bound,
                line=int(m.group(1)),
                col=col,
                span=span,
                form=form,
                raw_path=appeared or bound,
            )
        )

    found.sort(key=lambda h: h.span[0])
    return found


def path_score(src: str, dst: str) -> float:
    if src == dst:
        return 1.0
    s_parts = src.replace("\\", "/").split("/")
    d_parts = dst.replace("\\", "/").split("/")
    s_base = s_parts[-1]
    d_base = d_parts[-1]
    score = 0.0
    if s_base == d_base:
        score += 0.55
    s_stem, s_ext = os.path.splitext(src)
    d_stem = os.path.splitext(dst)[0]
    if dst.startswith(s_stem + "/") or f"/{os.path.basename(s_stem)}/" in f"/{dst}":
        score += 0.35
    if s_ext and s_ext == os.path.splitext(dst)[1]:
        score += 0.05
    if os.path.basename(s_stem) and os.path.basename(s_stem) in d_stem:
        score += 0.08
    s_set, d_set = set(s_parts[:-1]), set(d_parts[:-1])
    if s_set and d_set:
        score += 0.15 * len(s_set & d_set) / len(s_set | d_set)
    return min(1.0, score)


def neighbor_score(
    src_lines: list[str], src_i: int, dst_lines: list[str], dst_i: int, ctx: int
) -> float:
    if ctx <= 0:
        return 0.0
    hits = 0
    total = 0
    for delta in range(-ctx, ctx + 1):
        if delta == 0:
            continue
        sj = src_i + delta
        if sj < 1 or sj > len(src_lines):
            continue
        sn = normalize(src_lines[sj - 1])
        if sn in TRIVIAL_NORMS:
            continue
        total += 1
        lo = max(1, dst_i - ctx)
        hi = min(len(dst_lines), dst_i + ctx)
        window = {normalize(dst_lines[k - 1]) for k in range(lo, hi + 1) if k != dst_i}
        if sn in window:
            hits += 1
    if total == 0:
        return 0.0
    return hits / total


def line_ratio(a: str, b: str) -> float:
    if a == b:
        return 1.0
    na, nb = normalize(a), normalize(b)
    if na == nb:
        return 0.97
    if not na or not nb:
        return 0.0
    return difflib.SequenceMatcher(None, na, nb).ratio()


def token_score(a: str, b: str) -> float:
    ta, tb = set(tokens(a)), set(tokens(b))
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)


def score_pair(
    src_path: str,
    src_lines: list[str],
    src_i: int,
    dst_path: str,
    dst_lines: list[str],
    dst_i: int,
    ctx: int,
) -> float:
    sraw = src_lines[src_i - 1]
    draw = dst_lines[dst_i - 1]
    ns = neighbor_score(src_lines, src_i, dst_lines, dst_i, ctx)
    ps = path_score(src_path, dst_path)
    if sraw == draw:
        return min(1.0, 0.75 + 0.25 * ps + 0.05 * ns)
    if normalize(sraw) == normalize(draw):
        return min(1.0, 0.68 + 0.25 * ps + 0.07 * ns)
    lr = line_ratio(sraw, draw)
    ts = token_score(sraw, draw)
    return W_LINE * lr + W_TOK * ts + W_NEI * ns + W_PATH * ps


def candidates_for(
    src_path: str, src_lines: list[str], src_i: int, dst: Snapshot
) -> list[tuple[str, int]]:
    raw = src_lines[src_i - 1]
    n = normalize(raw)
    toks = tokens(raw)
    found: dict[tuple[str, int], None] = {}

    def add(path: str, line: int) -> None:
        found[(path, line)] = None

    if n not in TRIVIAL_NORMS:
        for path, line in dst.by_norm.get(n, ()):
            add(path, line)
            if len(found) >= CANDIDATE_CAP:
                return list(found)

    ranked = sorted(set(toks), key=lambda t: (dst.token_df.get(t, 10**9), -len(t)))
    for tok in ranked[:4]:
        locs = dst.by_token.get(tok, ())
        if len(locs) > 800:
            continue
        for path, line in locs:
            add(path, line)
            if len(found) >= CANDIDATE_CAP:
                return list(found)

    preferred_paths = []
    if src_path in dst.files:
        preferred_paths.append(src_path)
    stem = os.path.splitext(src_path)[0]
    base = os.path.basename(src_path)
    for p in dst.files:
        if p.startswith(stem + "/") or p.endswith("/" + base) or os.path.basename(p) == base:
            preferred_paths.append(p)
    for p in preferred_paths:
        lines = dst.files.get(p) or []
        for i, _ in enumerate(lines, start=1):
            add(p, i)
            if len(found) >= CANDIDATE_CAP:
                return list(found)
    return list(found)


def classify(
    src_path: str, src_line: int, src_raw: str, dst_path: Optional[str], dst_line: Optional[int], dst_raw: str, score: float
) -> str:
    if dst_path is None or dst_line is None or score < RESOLVE_THRESHOLD:
        return "deleted"
    same_text = normalize(src_raw) == normalize(dst_raw) or line_ratio(src_raw, dst_raw) >= 0.96
    if src_path == dst_path and same_text:
        return "same" if src_line == dst_line else "shifted"
    if same_text:
        return "moved" if src_path != dst_path else "shifted"
    return "edited"


def describe_hole(src_lines: list[str], src_i: int, dst: Snapshot, ctx: int) -> str:
    prev_hit: Optional[tuple[str, int]] = None
    next_hit: Optional[tuple[str, int]] = None
    reach = max(ctx * 4, 10)
    for d in range(1, reach + 1):
        if prev_hit is None:
            j = src_i - d
            if j >= 1:
                n = normalize(src_lines[j - 1])
                if n not in TRIVIAL_NORMS:
                    locs = dst.by_norm.get(n, [])
                    if len(locs) == 1:
                        prev_hit = locs[0]
        if next_hit is None:
            j = src_i + d
            if j <= len(src_lines):
                n = normalize(src_lines[j - 1])
                if n not in TRIVIAL_NORMS:
                    locs = dst.by_norm.get(n, [])
                    if len(locs) == 1:
                        next_hit = locs[0]
        if prev_hit and next_hit:
            break
    if prev_hit and next_hit and prev_hit[0] == next_hit[0]:
        lo, hi = sorted((prev_hit[1], next_hit[1]))
        return f"gap in {prev_hit[0]} between {lo} and {hi}"
    if prev_hit and next_hit:
        return f"last context at {prev_hit[0]}:{prev_hit[1]}; next context at {next_hit[0]}:{next_hit[1]}"
    if prev_hit:
        return f"last context at {prev_hit[0]}:{prev_hit[1]}"
    if next_hit:
        return f"next context at {next_hit[0]}:{next_hit[1]}"
    return "no candidates"


def resolve_hit(hit: Hit, src: Snapshot, dst: Snapshot, ctx: int, debug: bool) -> Resolution:
    src_lines = src.files.get(hit.path)
    if src_lines is None:
        hits = [p for p in src.files if p == hit.path or p.endswith("/" + hit.path)]
        if len(hits) == 1:
            hit.path = hits[0]
            src_lines = src.files[hit.path]
        elif not hits:
            return Resolution(hit=hit, status="unresolved", note="source path not in from-dir")
        else:
            return Resolution(hit=hit, status="unresolved", note="source path ambiguous")
    if hit.line < 1 or hit.line > len(src_lines):
        return Resolution(
            hit=hit,
            status="unresolved",
            note=f"line {hit.line} out of range (file has {len(src_lines)} lines)",
        )
    src_raw = src_lines[hit.line - 1]
    if normalize(src_raw) in TRIVIAL_NORMS:
        return Resolution(hit=hit, status="unresolved", note="line is too trivial to fingerprint")

    cands = candidates_for(hit.path, src_lines, hit.line, dst)
    best: Optional[tuple[float, str, int, str]] = None
    for dpath, dline in cands:
        dlines = dst.files.get(dpath)
        if not dlines or dline < 1 or dline > len(dlines):
            continue
        sc = score_pair(hit.path, src_lines, hit.line, dpath, dlines, dline, ctx)
        if best is None or sc > best[0]:
            best = (sc, dpath, dline, dlines[dline - 1])
    if debug and best:
        print(
            f"# debug {hit.path}:{hit.line} -> {best[1]}:{best[2]} score={best[0]:.3f} cands={len(cands)}",
            file=sys.stderr,
        )
    if best is None:
        return Resolution(
            hit=hit,
            status="deleted",
            score=0.0,
            note=describe_hole(src_lines, hit.line, dst, ctx),
        )
    sc, dpath, dline, draw = best
    status = classify(hit.path, hit.line, src_raw, dpath, dline, draw, sc)
    if status == "deleted":
        note = describe_hole(src_lines, hit.line, dst, ctx)
        if note == "no candidates":
            note = "best candidate below threshold"
        return Resolution(
            hit=hit,
            status="deleted",
            dest_path=dpath,
            dest_line=dline,
            score=sc,
            note=note,
            dest_text=draw,
        )
    note = ""
    if status == "edited":
        note = "line text drifted"
    elif status == "moved":
        note = "path or surrounding file changed"
    elif status == "shifted":
        note = "same file, line number drifted"
    return Resolution(
        hit=hit,
        status=status,
        dest_path=dpath,
        dest_line=dline,
        score=sc,
        note=note,
        dest_text=draw,
    )


def format_from(hit: Hit) -> str:
    col = f":{hit.col}" if hit.col is not None else ""
    return f"{hit.path}:{hit.line}{col}"


def format_to(res: Resolution) -> str:
    if res.dest_path is None or res.dest_line is None or res.status in {"deleted", "unresolved"}:
        return "-"
    col = f":{res.hit.col}" if res.hit.col is not None else ""
    return f"{res.dest_path}:{res.dest_line}{col}"


def emit_path(res: Resolution) -> Optional[str]:
    if res.status in {"deleted", "unresolved"}:
        return None
    if res.dest_path is None or res.dest_line is None:
        return None
    hit = res.hit
    if res.dest_path == hit.path:
        return hit.raw_path or hit.path
    if hit.form == "basename":
        dest_base = os.path.basename(res.dest_path)
        if dest_base == os.path.basename(hit.path) and dest_base == (hit.raw_path or dest_base):
            return dest_base
        return res.dest_path
    return res.dest_path


def replacement_text(res: Resolution, original_slice: str = "") -> Optional[str]:
    if res.status in {"deleted", "unresolved"}:
        return None
    if res.dest_path is None or res.dest_line is None:
        return None
    hit = res.hit
    if hit.form == "python":
        q = hit.quote or '"'
        return f"File {q}{res.dest_path}{q}, line {res.dest_line}"
    path = emit_path(res)
    if path is None:
        return None
    col = f":{hit.col}" if hit.col is not None else ""
    new = f"{path}:{res.dest_line}{col}"
    return _keep_wrap_ansi(original_slice, new)


def _keep_wrap_ansi(old_slice: str, new_text: str) -> str:
    """Re-insert a reset that sat between the path and `:line` in the original.

    Colorized rustc/clang often emits `ESC[1mpathESC[0m:529:5`. Replacing the
    whole visible locator would swallow the reset and leave the colon bold.
    """
    if not old_slice or "\x1b" not in old_slice:
        return new_text
    m = re.search(r"((?:\x1b\[[0-9;:]*[A-Za-z])+):(\d+)(?::(\d+))?$", old_slice)
    if not m:
        return new_text
    m2 = re.search(r":(\d+)(?::(\d+))?$", new_text)
    if not m2:
        return new_text
    return new_text[: m2.start()] + m.group(1) + new_text[m2.start() :]


def apply_gutter(body: str, carry: Carry) -> Optional[str]:
    m = GUTTER_RE.match(body)
    if not m:
        return None
    n = int(m.group(2))
    delta = n - carry.old_line
    if delta < 0 or delta > GUTTER_SPAN:
        return None
    new_n = carry.dest_line + delta
    num = str(new_n).rjust(len(m.group(2)))
    return m.group(1) + num + m.group(3) + m.group(4)


def should_carry(res: Resolution, body: str) -> bool:
    if res.status not in {"same", "shifted", "moved", "edited"} or res.dest_line is None:
        return False
    if res.hit.form == "arrow" or "-->" in body:
        return True
    if re.search(r":\s*(error|warning|note|fatal)\b", body, re.I):
        return True
    if res.hit.col is not None and res.hit.form in {"colon", "basename"}:
        return True
    return False


def rewrite_line(text: str, resolutions: list[Resolution]) -> str:
    items = [res for res in resolutions if res.hit.span is not None]
    items.sort(key=lambda r: r.hit.span[0], reverse=True)
    out = text
    for res in items:
        start, end = res.hit.span
        new = replacement_text(res, text[start:end] if 0 <= start <= end <= len(text) else "")
        if not new:
            continue
        out = out[:start] + new + out[end:]
    return out


def print_trace(res: Resolution) -> None:
    note = res.note.replace("\t", " ").replace("\n", " ")
    print(
        f"{res.status}\t{format_from(res.hit)}\t{format_to(res)}\t{res.score:.3f}\t{note}",
        file=sys.stderr,
    )


def pick_key(obj: dict, names: tuple[str, ...]) -> Optional[str]:
    for n in names:
        if n in obj:
            return n
    lower = {k.lower(): k for k in obj if isinstance(k, str)}
    for n in names:
        got = lower.get(n.lower())
        if got is not None:
            return got
    return None


def as_lineno(val: Any) -> Optional[int]:
    if isinstance(val, bool):
        return None
    if isinstance(val, int):
        return val if val > 0 else None
    if isinstance(val, float) and val.is_integer() and val > 0:
        return int(val)
    if isinstance(val, str) and val.isdigit():
        n = int(val)
        return n if n > 0 else None
    return None


def emit_file_field(appeared: str, bound: str, dest: str) -> str:
    """Rewrite a JSON file field, keeping CI prefixes / basename style."""
    appeared_n = appeared.replace("\\", "/")
    bound_n = bound.replace("\\", "/")
    dest_n = dest.replace("\\", "/")
    if appeared_n == bound_n:
        return dest_n
    if appeared_n.endswith("/" + bound_n):
        return appeared_n[: -len(bound_n)] + dest_n
    base = os.path.basename(bound_n)
    dest_base = os.path.basename(dest_n)
    if appeared_n == base:
        return dest_base if dest_base == base else dest_n
    if appeared_n.endswith("/" + base):
        prefix = appeared_n[: -len(base)]
        if dest_base == base:
            return prefix + dest_base
        return prefix + dest_n
    return dest_n


def keep_line_type(original: Any, dest_line: int) -> Any:
    if isinstance(original, str):
        return str(dest_line)
    return dest_line


def split_keep(text: str) -> list[tuple[str, str]]:
    """Split a JSON string value into (body, ending) lines."""
    if text == "":
        return [("", "")]
    parts: list[tuple[str, str]] = []
    i = 0
    n = len(text)
    while i < n:
        nl = text.find("\n", i)
        if nl < 0:
            parts.append((text[i:], ""))
            break
        if nl > i and text[nl - 1] == "\r":
            parts.append((text[i : nl - 1], "\r\n"))
        else:
            parts.append((text[i:nl], "\n"))
        i = nl + 1
    return parts


def byte_offset(lines: list[str], line: int, col: int) -> int:
    """UTF-8 byte offset of a 1-based line/column in dest file text."""
    if line < 1 or line > len(lines):
        return 0
    total = 0
    for i in range(line - 1):
        total += len((lines[i] + "\n").encode("utf-8"))
    raw = lines[line - 1]
    if col <= 1:
        return total
    cut = min(len(raw), col - 1)
    return total + len(raw[:cut].encode("utf-8"))


def char_offset(lines: list[str], line: int, col: int) -> int:
    """Unicode code-point offset of a 1-based line/column."""
    if line < 1 or line > len(lines):
        return 0
    total = 0
    for i in range(line - 1):
        total += len(lines[i]) + 1
    raw = lines[line - 1]
    if col <= 1:
        return total
    cut = min(len(raw), col - 1)
    return total + cut


def strip_ansi_map(text: str) -> tuple[str, list[int]]:
    """Return visible text and a map from visible index -> original index.

    orig_map[i] is the original index of visible[i]; orig_map[len(visible)]
    is the original index just past the last visible character.
    """
    orig_map: list[int] = []
    out: list[str] = []
    i = 0
    n = len(text)
    while i < n:
        if text[i] == "\x1b":
            m = ANSI_RE.match(text, i)
            if m:
                i = m.end()
                continue
        out.append(text[i])
        orig_map.append(i)
        i += 1
    orig_map.append(i)
    return "".join(out), orig_map


def looks_pretty(original: str) -> bool:
    """True when a JSON value was pretty-printed (newlines inside), not NDJSON."""
    s = original.strip("\r")
    return "\n" in s


# ---------------------------------------------------------------------------
# URI / path appearance
# ---------------------------------------------------------------------------

def path_from_uri(uri: str) -> str:
    if uri.startswith("file:"):
        parsed = urlparse(uri)
        path = unquote(parsed.path or "")
        if os.name == "nt" and path.startswith("/") and len(path) >= 3 and path[2] == ":":
            path = path[1:]
        return path
    if uri.startswith("file://"):
        return unquote(uri[len("file://") :])
    return uri


def emit_uri(appeared: str, bound: str, dest: str) -> str:
    if appeared.startswith("file:"):
        parsed = urlparse(appeared)
        path = unquote(parsed.path or "")
        new_path = emit_file_field(path, bound, dest)
        if path.startswith("/") and not new_path.startswith("/"):
            # dest is relative; keep the original absolute prefix via emit_file_field.
            # If that still produced a relative path, make it URI-absolute.
            new_path = "/" + new_path
        return parsed._replace(path=new_path).geturl()
    return emit_file_field(appeared, bound, dest)


def resolve_uri_and_line(
    ctx: Ctx, appeared: str, line: int, col: Optional[int]
) -> tuple[Optional[str], Resolution]:
    pathish = path_from_uri(appeared)
    bound = bind_path(pathish, ctx.src)
    if not bound:
        # Unique-basename fallback already lives in bind_path.
        res = Resolution(
            hit=Hit(path=pathish, line=line, col=col, raw_path=appeared, form="colon"),
            status="unresolved",
            note="source path not in from-dir",
        )
        ctx.unresolved = True
        if ctx.trace:
            tkey = (pathish, line, res.status, res.dest_path, res.dest_line)
            if tkey not in ctx.traced:
                ctx.traced.add(tkey)
                print_trace(res)
        return None, res
    hit = Hit(path=bound, line=line, col=col, span=(0, 0), form="colon", raw_path=appeared)
    return bound, ctx.resolve(hit)


def dest_owned_offsets(
    ctx: Ctx,
    res: Resolution,
    start_line: int,
    end_line: Optional[int],
    col_start: Optional[int],
    col_end: Optional[int],
) -> tuple[int, int, int, int]:
    """Return dest_line, dest_end, byte_start, char_start."""
    dest_line = res.dest_line or start_line
    dest_end = dest_line
    if end_line is not None and end_line >= start_line:
        dest_end = dest_line + (end_line - start_line)
    dest_lines = ctx.dst.files.get(res.dest_path or "") or []
    bs = byte_offset(dest_lines, dest_line, col_start or 1) if dest_lines else 0
    cs = char_offset(dest_lines, dest_line, col_start or 1) if dest_lines else 0
    return dest_line, dest_end, bs, cs


def snippet_from_dest(ctx: Ctx, res: Resolution, dest_line: int, dest_end: int) -> Optional[str]:
    dest_lines = ctx.dst.files.get(res.dest_path or "") or []
    if not dest_lines or dest_line < 1 or dest_line > len(dest_lines):
        return res.dest_text or None
    lo = dest_line
    hi = dest_end if dest_end >= dest_line else dest_line
    hi = min(hi, len(dest_lines))
    return "\n".join(dest_lines[lo - 1 : hi])


def ordered_dict(original: dict, out: dict) -> dict:
    ordered: dict[Any, Any] = {}
    for k in original:
        if k in out:
            ordered[k] = out[k]
    for k, v in out.items():
        if k not in ordered:
            ordered[k] = v
    return ordered


def is_cargo_span(obj: dict) -> bool:
    """inlay's schema. scribe does not treat this as a locator object."""
    keys = set(obj)
    return bool(keys & CARGO_FILE_KEYS) and bool(keys & CARGO_LINE_KEYS)


def is_physical_location(obj: dict) -> bool:
    art = obj.get("artifactLocation") or obj.get("artifact_location")
    region = obj.get("region")
    if not isinstance(art, dict):
        return False
    if not isinstance(region, dict) and not isinstance(obj.get("contextRegion"), dict):
        return False
    uri = art.get("uri")
    has_uri = isinstance(uri, str) and uri != ""
    has_index = isinstance(art.get("index"), int)
    if not has_uri and not has_index:
        return False
    if isinstance(region, dict) and (
        "startLine" in region or "start_line" in region or "charOffset" in region or "byteOffset" in region
    ):
        return True
    ctxr = obj.get("contextRegion")
    return isinstance(ctxr, dict) and ("startLine" in ctxr or "start_line" in ctxr)


def is_sarif_location_wrapper(obj: dict) -> bool:
    pl = obj.get("physicalLocation") or obj.get("physical_location")
    return isinstance(pl, dict) and (is_physical_location(pl) or "artifactLocation" in pl or "artifact_location" in pl)


def is_sarif_artifact_change(obj: dict) -> bool:
    art = obj.get("artifactLocation") or obj.get("artifact_location")
    reps = obj.get("replacements")
    return isinstance(art, dict) and isinstance(reps, list)


def is_clang_file_loc(obj: dict) -> bool:
    """clang -fdiagnostics-format=json caret/start/end location."""
    if is_cargo_span(obj):
        return False
    if "key.filepath" in obj or "key.file_path" in obj:
        return False
    has_file = isinstance(obj.get("file"), str) or isinstance(obj.get("filename"), str)
    has_line = as_lineno(obj.get("line")) is not None
    if not has_file or not has_line:
        return False
    # Distinguisher from generic {file, line}: clang locations carry column and/or offset.
    return "column" in obj or "offset" in obj or "col" in obj


def is_swift_key_diag(obj: dict) -> bool:
    has_file = isinstance(obj.get("key.filepath"), str) or isinstance(obj.get("key.file_path"), str)
    if not has_file:
        return False
    return as_lineno(obj.get("key.line")) is not None or isinstance(obj.get("key.offset"), int)


def is_swift_serialized_record(obj: dict) -> bool:
    """Swift/clang serialized-diag JSON dump: filename + line + diagnostic payload."""
    if is_cargo_span(obj):
        return False
    if "key.filepath" in obj:
        return False
    filek = None
    for k in ("filename", "file_name", "file"):
        if isinstance(obj.get(k), str):
            filek = k
            break
    if filek is None:
        return False
    if as_lineno(obj.get("line")) is None:
        return False
    clues = {
        "spelling", "message", "text", "level", "kind", "severity",
        "offset", "ranges", "fix-its", "fixits", "category",
    }
    return bool(clues & obj.keys())


def is_sarif_run(obj: dict) -> bool:
    if "results" not in obj and "artifacts" not in obj:
        return False
    return "tool" in obj or "invocations" in obj or "artifacts" in obj


def is_sarif_log(obj: dict) -> bool:
    if not isinstance(obj.get("runs"), list):
        return False
    schema = obj.get("$schema")
    if isinstance(schema, str) and "sarif" in schema.lower():
        return True
    if obj.get("version") in {"2.1.0", "2.1.0-rtm.5", "2.0.0"}:
        return True
    return any(isinstance(r, dict) and is_sarif_run(r) for r in obj.get("runs") or [])


def collect_run_artifacts(run: dict) -> list[Optional[str]]:
    arts = run.get("artifacts")
    if not isinstance(arts, list):
        return []
    out: list[Optional[str]] = []
    for art in arts:
        uri = None
        if isinstance(art, dict):
            loc = art.get("location") or {}
            if isinstance(loc, dict) and isinstance(loc.get("uri"), str):
                uri = loc["uri"]
        out.append(uri)
    return out


def uri_from_artifact_location(art: dict, ctx: Ctx) -> Optional[str]:
    uri = art.get("uri")
    if isinstance(uri, str) and uri:
        return uri
    idx = art.get("index")
    if isinstance(idx, int) and 0 <= idx < len(ctx.artifacts):
        return ctx.artifacts[idx]
    return None


def apply_resolution_to_region(
    region: dict, ctx: Ctx, res: Resolution, start: int
) -> dict:
    dest_line = res.dest_line or start
    dest_end = dest_line
    end_no = as_lineno(region.get("endLine") if "endLine" in region else region.get("end_line"))
    if end_no is not None and end_no >= start:
        dest_end = dest_line + (end_no - start)
    dest_lines = ctx.dst.files.get(res.dest_path or "") or []
    col_start = as_lineno(region.get("startColumn") if "startColumn" in region else region.get("start_column"))
    col_end = as_lineno(region.get("endColumn") if "endColumn" in region else region.get("end_column"))
    out: dict[Any, Any] = {}
    handled: set[str] = set()
    for key, names, dest_val in (
        ("startLine", ("startLine", "start_line"), dest_line),
        ("endLine", ("endLine", "end_line"), dest_end),
    ):
        k = pick_key(region, names)
        if k:
            out[k] = keep_line_type(region[k], dest_val)
            handled.add(k)
    if dest_lines and 1 <= dest_line <= len(dest_lines):
        bs = byte_offset(dest_lines, dest_line, col_start or 1)
        cs = char_offset(dest_lines, dest_line, col_start or 1)
        be = byte_offset(dest_lines, dest_end if 1 <= dest_end <= len(dest_lines) else dest_line, col_end or col_start or 1)
        ce = char_offset(dest_lines, dest_end if 1 <= dest_end <= len(dest_lines) else dest_line, col_end or col_start or 1)
        for names, val in (
            (("byteOffset", "byte_offset"), bs),
            (("charOffset", "char_offset"), cs),
            (("byteEnd",), be),
            (("charEnd",), ce),
        ):
            k = pick_key(region, names)
            if k:
                out[k] = val
                handled.add(k)
        # byteLength / charLength: dest-owned span size.
        if pick_key(region, ("byteLength", "byte_length")):
            k = pick_key(region, ("byteLength", "byte_length"))
            if k:
                out[k] = max(0, be - bs)
                handled.add(k)
        if pick_key(region, ("charLength", "char_length")):
            k = pick_key(region, ("charLength", "char_length"))
            if k:
                out[k] = max(0, ce - cs)
                handled.add(k)
        if "snippet" in region:
            sn = region["snippet"]
            text = snippet_from_dest(ctx, res, dest_line, dest_end)
            if isinstance(sn, dict):
                new_sn = {}
                for sk, sv in sn.items():
                    if sk == "text" and text is not None:
                        new_sn[sk] = text
                    else:
                        new_sn[sk] = rewrite_value(sv, ctx)
                if text is not None:
                    new_sn["text"] = text
                out["snippet"] = new_sn
            elif isinstance(sn, str) and text is not None:
                out["snippet"] = text
            else:
                out["snippet"] = rewrite_value(sn, ctx)
            handled.add("snippet")
    for k, v in region.items():
        if k in handled:
            continue
        if k in {"startColumn", "start_column", "endColumn", "end_column"}:
            out[k] = v
            continue
        out[k] = rewrite_value(v, ctx)
    return ordered_dict(region, out)


def rewrite_physical_location(obj: dict, ctx: Ctx) -> dict:
    art_key = "artifactLocation" if "artifactLocation" in obj else (
        "artifact_location" if "artifact_location" in obj else "artifactLocation"
    )
    art = obj.get(art_key)
    if not isinstance(art, dict):
        return rewrite_object_generic(obj, ctx)
    appeared = uri_from_artifact_location(art, ctx)
    region = obj.get("region") if isinstance(obj.get("region"), dict) else None
    ctx_region = obj.get("contextRegion") if isinstance(obj.get("contextRegion"), dict) else None
    start = None
    col = None
    if region is not None:
        start = as_lineno(region.get("startLine") if "startLine" in region else region.get("start_line"))
        col = as_lineno(region.get("startColumn") if "startColumn" in region else region.get("start_column"))
        if start is None:
            # offset-only region: map through the source file if we can bind it.
            off = region.get("byteOffset")
            if appeared and isinstance(off, int):
                pathish = path_from_uri(appeared)
                bound = bind_path(pathish, ctx.src)
                if bound:
                    start = line_from_byte_offset(ctx.src.files.get(bound) or [], off)
    if start is None and ctx_region is not None:
        start = as_lineno(ctx_region.get("startLine") if "startLine" in ctx_region else ctx_region.get("start_line"))
        col = col or as_lineno(ctx_region.get("startColumn") if "startColumn" in ctx_region else ctx_region.get("start_column"))
    if not appeared or start is None:
        return rewrite_object_generic(obj, ctx)

    bound, res = resolve_uri_and_line(ctx, appeared, start, col)
    out: dict[Any, Any] = {}
    handled: set[str] = set()
    if res.status not in {"deleted", "unresolved"} and res.dest_path and res.dest_line and bound:
        new_art = {}
        for k, v in art.items():
            if k == "uri":
                new_art[k] = emit_uri(appeared, bound, res.dest_path)
            else:
                new_art[k] = v
        if "uri" not in new_art:
            new_art["uri"] = emit_uri(appeared, bound, res.dest_path)
        out[art_key] = new_art
        handled.add(art_key)
        if region is not None:
            out["region"] = apply_resolution_to_region(region, ctx, res, start)
            handled.add("region")
        if ctx_region is not None:
            ctx_start = as_lineno(ctx_region.get("startLine") if "startLine" in ctx_region else ctx_region.get("start_line")) or start
            out["contextRegion"] = apply_resolution_to_region(ctx_region, ctx, res, ctx_start)
            handled.add("contextRegion")
    else:
        # Deletion / unresolved: pass the locator through unchanged; still walk other fields.
        out[art_key] = art
        handled.add(art_key)
        if region is not None:
            out["region"] = region
            handled.add("region")
        if ctx_region is not None:
            out["contextRegion"] = ctx_region
            handled.add("contextRegion")

    for k, v in obj.items():
        if k in handled:
            continue
        out[k] = rewrite_value(v, ctx)
    return ordered_dict(obj, out)


def line_from_byte_offset(lines: list[str], offset: int) -> Optional[int]:
    if offset < 0 or not lines:
        return None
    total = 0
    for i, raw in enumerate(lines, start=1):
        nbytes = len((raw + "\n").encode("utf-8"))
        if offset < total + nbytes:
            return i
        total += nbytes
    return len(lines)


def rewrite_artifact_change(obj: dict, ctx: Ctx) -> dict:
    art_key = "artifactLocation" if "artifactLocation" in obj else "artifact_location"
    art = obj.get(art_key)
    reps = obj.get("replacements")
    if not isinstance(art, dict) or not isinstance(reps, list):
        return rewrite_object_generic(obj, ctx)
    appeared = uri_from_artifact_location(art, ctx)
    out: dict[Any, Any] = {}
    handled: set[str] = set()
    dest_uri = None
    dest_bound = None
    new_reps = []
    for repl in reps:
        if not isinstance(repl, dict):
            new_reps.append(rewrite_value(repl, ctx))
            continue
        region = None
        rk = None
        for cand in ("deletedRegion", "deleted_region", "insertedRegion", "inserted_region"):
            if isinstance(repl.get(cand), dict):
                region = repl[cand]
                rk = cand
                break
        start = as_lineno(region.get("startLine") if region else None) if region else None
        if appeared and start is not None:
            bound, res = resolve_uri_and_line(ctx, appeared, start, as_lineno(region.get("startColumn") if region else None))
            new_repl = {}
            if res.status not in {"deleted", "unresolved"} and res.dest_path and res.dest_line and bound:
                dest_uri = emit_uri(appeared, bound, res.dest_path)
                dest_bound = bound
                for k, v in repl.items():
                    if k == rk and isinstance(v, dict):
                        new_repl[k] = apply_resolution_to_region(v, ctx, res, start)
                    else:
                        new_repl[k] = rewrite_value(v, ctx)
                new_reps.append(ordered_dict(repl, new_repl))
                continue
        new_reps.append(rewrite_value(repl, ctx))
    if dest_uri is not None:
        new_art = {}
        for k, v in art.items():
            new_art[k] = dest_uri if k == "uri" else v
        if "uri" not in new_art:
            new_art["uri"] = dest_uri
        out[art_key] = new_art
        handled.add(art_key)
        out["replacements"] = new_reps
        handled.add("replacements")
        _ = dest_bound
    for k, v in obj.items():
        if k in handled:
            continue
        if k == "replacements":
            out[k] = new_reps
            continue
        out[k] = rewrite_value(v, ctx)
    return ordered_dict(obj, out)


def rewrite_clang_loc(obj: dict, ctx: Ctx) -> dict:
    file_key = "file" if isinstance(obj.get("file"), str) else (
        "filename" if isinstance(obj.get("filename"), str) else None
    )
    if file_key is None:
        return rewrite_object_generic(obj, ctx)
    appeared = obj[file_key]
    start = as_lineno(obj.get("line"))
    if start is None:
        return rewrite_object_generic(obj, ctx)
    col = as_lineno(obj.get("column") if "column" in obj else obj.get("col"))
    bound, res = resolve_uri_and_line(ctx, appeared, start, col)
    out: dict[Any, Any] = {}
    handled: set[str] = set()
    if res.status not in {"deleted", "unresolved"} and res.dest_path and res.dest_line and bound:
        out[file_key] = emit_uri(appeared, bound, res.dest_path)
        handled.add(file_key)
        out["line"] = keep_line_type(obj["line"], res.dest_line)
        handled.add("line")
        dest_lines = ctx.dst.files.get(res.dest_path) or []
        if "offset" in obj and dest_lines:
            out["offset"] = byte_offset(dest_lines, res.dest_line, col or 1)
            handled.add("offset")
    for k, v in obj.items():
        if k in handled:
            continue
        out[k] = rewrite_value(v, ctx)
    return ordered_dict(obj, out)


