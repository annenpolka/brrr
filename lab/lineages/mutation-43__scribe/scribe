def rewrite_swift_serialized(obj: dict, ctx: Ctx) -> dict:
    file_key = None
    for k in ("filename", "file_name", "file"):
        if isinstance(obj.get(k), str):
            file_key = k
            break
    if file_key is None:
        return rewrite_object_generic(obj, ctx)
    appeared = obj[file_key]
    start = as_lineno(obj.get("line"))
    if start is None:
        return rewrite_object_generic(obj, ctx)
    col = as_lineno(obj.get("column") if "column" in obj else obj.get("col"))
    bound, res = resolve_uri_and_line(ctx, appeared, start, col)
    out: dict[Any, Any] = {}
    handled: set[str] = set()
    if res.status not in {"deleted", "unresolved"} and res.dest_path and res.dest_line and bound:
        out[file_key] = emit_uri(appeared, bound, res.dest_path)
        handled.add(file_key)
        out["line"] = keep_line_type(obj["line"], res.dest_line)
        handled.add("line")
        dest_lines = ctx.dst.files.get(res.dest_path) or []
        if "offset" in obj and dest_lines:
            out["offset"] = byte_offset(dest_lines, res.dest_line, col or 1)
            handled.add("offset")
        if "spelling" in obj and dest_lines and 1 <= res.dest_line <= len(dest_lines):
            # spelling is the diagnostic text, not the source line; leave it.
            pass
    for k, v in obj.items():
        if k in handled:
            continue
        out[k] = rewrite_value(v, ctx)
    return ordered_dict(obj, out)


def rewrite_sarif_run(run: dict, ctx: Ctx) -> dict:
    old = ctx.artifacts
    ctx.artifacts = collect_run_artifacts(run)
    try:
        return rewrite_object_generic(run, ctx)
    finally:
        ctx.artifacts = old


def rewrite_object_generic(obj: dict, ctx: Ctx) -> dict:
    out: dict[Any, Any] = {}
    for k, v in obj.items():
        # Path-only catalog keys are not locators (same rule as inlay's src_path).
        if k in {"$schema", "uriBaseId", "informationUri", "downloadUri"}:
            out[k] = v
            continue
        out[k] = rewrite_value(v, ctx)
    return out


def rewrite_object(obj: dict, ctx: Ctx) -> dict:
    # Schema-shaped locators first. cargo file_name+line_start is not a locator here.
    if is_cargo_span(obj):
        return rewrite_object_generic(obj, ctx)
    if is_physical_location(obj):
        return rewrite_physical_location(obj, ctx)
    if is_sarif_location_wrapper(obj):
        pl_key = "physicalLocation" if "physicalLocation" in obj else "physical_location"
        out: dict[Any, Any] = {}
        for k, v in obj.items():
            if k == pl_key and isinstance(v, dict):
                out[k] = rewrite_physical_location(v, ctx) if is_physical_location(v) else rewrite_value(v, ctx)
            else:
                out[k] = rewrite_value(v, ctx)
        return out
    if is_sarif_artifact_change(obj):
        return rewrite_artifact_change(obj, ctx)
    if is_swift_key_diag(obj):
        return rewrite_swift_key(obj, ctx)
    if is_clang_file_loc(obj):
        return rewrite_clang_loc(obj, ctx)
    if is_swift_serialized_record(obj):
        return rewrite_swift_serialized(obj, ctx)
    if is_sarif_log(obj):
        out = {}
        for k, v in obj.items():
            if k == "runs" and isinstance(v, list):
                out[k] = [rewrite_sarif_run(r, ctx) if isinstance(r, dict) else rewrite_value(r, ctx) for r in v]
            else:
                out[k] = rewrite_value(v, ctx)
        return out
    if is_sarif_run(obj):
        return rewrite_sarif_run(obj, ctx)
    return rewrite_object_generic(obj, ctx)


def rewrite_string(text: str, ctx: Ctx) -> str:
    """Rewrite locators inside a JSON string, including ANSI-wrapped paths."""
    pieces = split_keep(text)
    carry: Optional[Carry] = None
    out: list[str] = []
    for body, nl in pieces:
        visible, mapping = strip_ansi_map(body)
        gutter_applied = False
        if carry is not None:
            rewritten_vis = apply_gutter(visible, carry)
            if rewritten_vis is not None:
                body = apply_mapped_replace(body, mapping, visible, rewritten_vis)
                gutter_applied = True
        hits = [] if gutter_applied else find_hits(visible, ctx.src)
        mapped_hits: list[Hit] = []
        for h in hits:
            a, b = h.span
            if a < 0 or b > len(mapping) - 1:
                continue
            oa, ob = mapping[a], mapping[b]
            mapped_hits.append(
                Hit(
                    path=h.path,
                    line=h.line,
                    col=h.col,
                    span=(oa, ob),
                    form=h.form,
                    quote=h.quote,
                    raw_path=h.raw_path,
                )
            )
        line_res = [ctx.resolve(h) for h in mapped_hits]
        refreshed: Optional[Carry] = None
        for r in line_res:
            if should_carry(r, visible) and r.dest_line is not None:
                refreshed = Carry(old_line=r.hit.line, dest_line=r.dest_line, ttl=GUTTER_TTL)
        if refreshed is not None:
            carry = refreshed
        elif carry is not None:
            carry.ttl -= 1
            if carry.ttl <= 0:
                carry = None
        out.append(rewrite_line(body, line_res) + nl)
    return "".join(out)


def apply_mapped_replace(original: str, mapping: list[int], visible: str, new_visible: str) -> str:
    """Replace original using a full-line visible rewrite (gutter number change).

    If only the number digits changed, splice just that span so wrapping ANSI
    around the gutter survives. Otherwise fall back to new_visible (loses
    inner ANSI, keeps the rewrite).
    """
    old_m = GUTTER_RE.match(visible)
    new_m = GUTTER_RE.match(new_visible)
    if old_m and new_m and old_m.group(1) == new_m.group(1) and old_m.group(3) == new_m.group(3):
        gs, ge = old_m.start(2), old_m.end(2)
        oa = mapping[gs]
        # End after the last digit, not at the next visible char, so a
        # reset sitting between `529` and ` |` survives.
        ob = mapping[ge - 1] + 1 if ge > gs else mapping[ge]
        return original[:oa] + new_m.group(2) + original[ob:]
    return new_visible


def rewrite_value(val: Any, ctx: Ctx) -> Any:
    if isinstance(val, dict):
        return rewrite_object(val, ctx)
    if isinstance(val, list):
        return [rewrite_value(x, ctx) for x in val]
    if isinstance(val, str):
        return rewrite_string(val, ctx)
    return val


def dumps_json(val: Any, indent: Optional[int]) -> str:
    if indent is None:
        return json.dumps(val, ensure_ascii=False, separators=(",", ":"))
    return json.dumps(val, ensure_ascii=False, indent=indent)


def scan_stream(raw: str) -> Iterator[tuple[str, Any, str, str]]:
    """Yield ('json', value, nl, original_slice) or ('raw', body, nl, '').

    Concatenated JSON values (NDJSON, pretty objects, one array) are the
    ingest. Non-JSON chatter passes through. original_slice is used to
    preserve pretty vs compact.
    """
    dec = json.JSONDecoder()
    i = 0
    n = len(raw)
    while i < n:
        if raw[i] in "{[":
            try:
                val, end = dec.raw_decode(raw, i)
            except json.JSONDecodeError:
                nl = raw.find("\n", i)
                if nl < 0:
                    yield ("raw", raw[i:], "", "")
                    return
                yield ("raw", raw[i:nl], "\n", "")
                i = nl + 1
                continue
            original = raw[i:end]
            nl = "\n"
            j = end
            if j < n and raw[j] == "\r":
                j += 1
                nl = "\r\n" if j < n and raw[j] == "\n" else "\r"
            if j < n and raw[j] == "\n":
                j += 1
                if nl != "\r\n":
                    nl = "\n"
            elif j == end:
                nl = "\n" if end < n else ""
            yield ("json", val, nl, original)
            i = j
            continue
        nl_at = raw.find("\n", i)
        if nl_at < 0:
            yield ("raw", raw[i:], "", "")
            return
        body = raw[i:nl_at]
        if body.endswith("\r"):
            yield ("raw", body[:-1], "\r\n", "")
        else:
            yield ("raw", body, "\n", "")
        i = nl_at + 1


def read_inputs(names: list[str]) -> str:
    if not names:
        names = ["-"]
    chunks: list[str] = []
    for name in names:
        if name == "-":
            chunks.append(sys.stdin.read())
        else:
            with open(name, encoding="utf-8", errors="surrogateescape", newline="") as fp:
                chunks.append(fp.read())
    return "".join(chunks)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="scribe",
        description=(
            "Rewrite locators inside a SARIF / clang JSON / Swift serialized "
            "diagnostic stream from one directory snapshot onto another. "
            "Nested schema fields move; the JSON stays valid. No git, no "
            "locator arguments."
        ),
        epilog="cat results.sarif | scribe --from-dir old --to-dir new",
    )
    p.add_argument(
        "logs",
        nargs="*",
        help="JSON streams to rewrite (default: stdin). '-' is stdin.",
    )
    p.add_argument("--from-dir", type=Path, required=True, help="source snapshot directory")
    p.add_argument("--to-dir", type=Path, required=True, help="destination snapshot directory")
    p.add_argument("--trace", action="store_true", help="print mapping TSV on stderr")
    p.add_argument("--strict", action="store_true", help="exit 1 if any locator is unresolved")
    p.add_argument("--context", type=int, default=3, help="neighbor window (default 3)")
    p.add_argument("--debug", action="store_true", help="scorer traces on stderr")
    p.add_argument(
        "--indent",
        type=int,
        default=None,
        help="pretty-print JSON with this indent (overrides input style)",
    )
    p.add_argument(
        "--compact",
        action="store_true",
        help="force compact JSON even if the input value was pretty-printed",
    )
    p.add_argument("--version", action="version", version=f"scribe {VERSION}")
    return p


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    if not args.from_dir.is_dir():
        print(f"scribe: --from-dir is not a directory: {args.from_dir}", file=sys.stderr)
        return 2
    if not args.to_dir.is_dir():
        print(f"scribe: --to-dir is not a directory: {args.to_dir}", file=sys.stderr)
        return 2
    if not args.logs and sys.stdin.isatty():
        build_parser().print_help()
        return 2

    src = load_snapshot(args.from_dir, str(args.from_dir))
    dst = load_snapshot(args.to_dir, str(args.to_dir))
    ctx = Ctx(
        src=src,
        dst=dst,
        context=args.context,
        debug=args.debug,
        trace=args.trace,
    )

    raw = read_inputs(args.logs)
    for kind, payload, nl, original in scan_stream(raw):
        if kind == "raw":
            print(payload + nl, end="")
            continue
        rewritten = rewrite_value(payload, ctx)
        if args.indent is not None:
            indent: Optional[int] = args.indent
        elif args.compact:
            indent = None
        elif original and looks_pretty(original):
            indent = 2
        else:
            indent = None
        print(dumps_json(rewritten, indent) + (nl or "\n"), end="")

    if args.strict and ctx.unresolved:
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
