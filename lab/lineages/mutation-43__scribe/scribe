)
COLON_NUM_RE = re.compile(r":(\d+)(?::(\d+))?(?!\d)")
GUTTER_RE = re.compile(r"^([ \t]*)(\d+)([ \t]*\|)(.*)$")
# CSI / OSC / a few single-char ESC sequences used in colorized diagnostics.
ANSI_RE = re.compile(
    r"(?:\x1b\[[0-9;:]*[A-Za-z]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_])"
)
