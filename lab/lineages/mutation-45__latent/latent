def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="latent",
        usage="latent [options] PROGRAM [args...]",
        description=(
            "Env ABI as two columns: DUE (load-image getenv names) vs "
            "LATENT (names consulted on a traced run). "
            "The owed set is not the used set."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "TSV columns: name  source  due|latent|both\n"
            "Examples:\n"
            "  latent python3 -c 'print(1)'\n"
            "  latent --due python3\n"
            "  latent --dry\n"
            "  latent --images node\n"
        ),
    )
    p.add_argument("program", nargs="?", help="binary on PATH or a path")
    p.add_argument("run_args", nargs=argparse.REMAINDER, help="args for the traced exec")
    p.add_argument("--due", action="store_true", help="DUE column only (no exec)")
    p.add_argument(
        "--dry",
        action="store_true",
        help="compile and trace the fixture probe (interposer demo)",
    )
    p.add_argument("--images", action="store_true", help="print the load list and exit")
    p.add_argument("--solo", action="store_true", help="do not walk loaded dylibs")
    p.add_argument("--system", action="store_true", help="include /usr/lib /System images")
    p.add_argument("--closure", action="store_true", help="BFS non-system dependents")
    p.add_argument("--depth", type=int, default=1, metavar="N")
    p.add_argument(
        "--cap-mb",
        type=int,
        default=DEFAULT_CAP_MB,
        metavar="N",
        help=f"skip loaded images larger than N MB (default {DEFAULT_CAP_MB}; 0 = off). "
        "Runtime drivers (libpython, librustc_driver) are kept anyway.",
    )
    p.add_argument(
        "--keep-large",
        action="store_true",
        help="scan every loaded image regardless of --cap-mb (includes libnode)",
    )
    p.add_argument(
        "--libc",
        action="store_true",
        help="include PATH/HOME/LC_*/DYLD_* (hidden by default)",
    )
    p.add_argument("--loose", action="store_true", help="keep low-quality string tokens")
    p.add_argument("--timeout", type=float, default=12.0, metavar="SEC")
    p.add_argument("--tsv", action="store_true", help="TSV (default)")
    p.add_argument("--header", action="store_true", help="print TSV header")
    p.add_argument("--human", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--quiet", action="store_true", help="no stderr summary")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    return p


def emit_rows(rows: list[JoinRow], args: argparse.Namespace) -> None:
    if args.json:
        sys.stdout.write(format_json(rows))
    elif args.human:
        sys.stdout.write(format_human(rows))
    else:
        sys.stdout.write(format_tsv(rows, header=args.header))


def summarize(
    rows: list[JoinRow],
    images: list[ImageRow],
    trace: TraceResult | None,
    *,
    quiet: bool,
) -> None:
    if quiet:
        return
    n_due = sum(1 for r in rows if r.kind == "due")
    n_lat = sum(1 for r in rows if r.kind == "latent")
    n_both = sum(1 for r in rows if r.kind == "both")
    n_cap = sum(1 for i in images if i.role == "cap")
    n_load = sum(1 for i in images if i.role in {"load", "keep"})
    extra = ""
    if trace is not None:
        if trace.sip and not trace.loaded:
            extra = " sip=1"
        elif not trace.loaded:
            extra = f" trace={trace.detail or 'unloaded'}"
    sys.stderr.write(
        f"latent: due={n_due} latent={n_lat} both={n_both} "
        f"images={n_load} cap={n_cap}{extra}\n"
    )


def run(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.version:
        print(VERSION)
        return 0
    if args.selftest:
        return run_selftest()

    cap_bytes = 0 if args.cap_mb <= 0 else args.cap_mb * 1024 * 1024
    run_args = list(args.run_args)
    if run_args[:1] == ["--"]:
        run_args = run_args[1:]

    work = Path(tempfile.mkdtemp(prefix="latent-"))
    try:
        return _run_with_work(args, run_args, cap_bytes, work)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def _run_with_work(
    args: argparse.Namespace,
    run_args: list[str],
    cap_bytes: int,
    work: Path,
) -> int:
    if args.dry:
        try:
            program = compile_probe(work)
        except RuntimeError as exc:
            print(f"latent: {exc}", file=sys.stderr)
            return 2
        run_args = []
    else:
        if not args.program:
            print("latent: need PROGRAM, or --dry / --selftest", file=sys.stderr)
            return 2
        try:
            program = resolve_program(args.program)
        except FileNotFoundError as exc:
            print(f"latent: {exc}", file=sys.stderr)
            return 2

    if args.images:
        images = iter_loaded_images(
            program.resolve() if program.is_file() else program,
            system=args.system,
            closure=args.closure,
            depth=args.depth,
            cap_bytes=cap_bytes,
            keep_large=args.keep_large,
        )
        sys.stdout.write(format_images(images, tsv=args.tsv or args.header))
        if not args.quiet:
            for note in cap_notes(images):
                print(note, file=sys.stderr)
        return 0

    try:
        due_needs, images = harvest(
            program,
            walk_images=not args.solo,
            system=args.system,
            closure=args.closure,
            depth=args.depth,
            cap_bytes=cap_bytes,
            keep_large=args.keep_large,
        )
    except (OSError, RuntimeError) as exc:
        print(f"latent: {exc}", file=sys.stderr)
        return 2

    due_needs = filter_due(due_needs, libc=args.libc, loose=args.loose)
    if not args.quiet:
        for note in cap_notes(images):
            print(note, file=sys.stderr)

    trace: TraceResult | None = None
    latent_names: set[str] = set()
    sip_fail = False

    want_trace = not args.due
    if want_trace:
        try:
            interposer = compile_interposer(work)
        except RuntimeError as exc:
            print(f"latent: {exc}", file=sys.stderr)
            print(
                "latent: LATENT omitted; static DUE follows. "
                "Install a C compiler, or pass --due.",
                file=sys.stderr,
            )
            rows = join_columns(due_needs, [])
            emit_rows(rows, args)
            summarize(rows, images, None, quiet=args.quiet)
            return 1
        log_path = work / "latent.log"
        trace = trace_run(
            program,
            run_args,
            interposer=interposer,
            timeout=args.timeout,
            log_path=log_path,
        )
        if not trace.loaded:
            if trace.sip:
                sys.stderr.write(SIP_MESSAGE)
                sip_fail = True
            else:
                print(
                    f"latent: interposer did not load ({trace.detail or 'unknown'}); "
                    "LATENT empty (fail closed).",
                    file=sys.stderr,
                )
                sip_fail = True
        latent_names = filter_latent(trace.names, libc=args.libc)

    rows = join_columns(due_needs, latent_names)
    emit_rows(rows, args)
    summarize(rows, images, trace, quiet=args.quiet)
    if sip_fail:
        return 1
    return 0


