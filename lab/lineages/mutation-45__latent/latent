def is_macho_or_elf(path: Path) -> bool:
    try:
        with path.open("rb") as fh:
            magic = fh.read(4)
    except OSError:
        return False
    if magic == b"\x7fELF":
        return True
    if magic in MACH_O_MAGICS:
        return True
    return False


def extract_binary(path: Path, needles: Iterable[str] | None = None) -> list[Need]:
    try:
        data = path.read_bytes()
    except OSError:
        return []
    found: list[Need] = []
    seen: set[str] = set()
    prefixes = env_prefixes(needles)
    src = str(path)

    def add(text: str, detail: str) -> None:
        if text in seen:
            return
        if not ENV_NAME_RE.match(text):
            return
        if text in REJECT_STRINGS:
            return
        seen.add(text)
        found.append(Need(text, src, detail))

    for chunk in data.split(b"\0"):
        if not (3 <= len(chunk) <= 80):
            continue
        if not all(32 <= b < 127 for b in chunk):
            continue
        text = chunk.decode("ascii")
        assign = CSTRING_ASSIGN_RE.match(text.strip())
        if assign:
            add(assign.group(1), "cstring-assign")
        if is_valid_env_token(text) or text in LIBC_ENV or text in BARE_APP:
            add(text, "cstring")
        else:
            for tok in split_packed(text, prefixes):
                add(tok, "cstring-packed")

    large = len(data) >= LARGE_IMAGE_BYTES
    if not large:
        for run in PRINTABLE_RUN_RE.finditer(data):
            text = run.group().decode("ascii")
            if is_valid_env_token(text) or text in LIBC_ENV or text in BARE_APP:
                add(text, "rodata")
                continue
            for tok in split_packed(text, prefixes):
                add(tok, "packed")

    for tok in peel_prefix_tokens(data, prefixes):
        add(tok, "prefix")
    for tok in extract_doc_env_tokens(data):
        add(tok, "doc")
    if needles:
        for name in needles:
            if name in seen:
                continue
            if name_in_blob(data, name):
                add(name, "needle")
    return found


def extract_source(path: Path) -> list[Need]:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    found: list[Need] = []
    seen: set[str] = set()
    for i, line in enumerate(text.splitlines(), 1):
        stripped = line.lstrip()
        if stripped.startswith("#") and path.suffix.lower() in {".c", ".h", ".sh"}:
            continue
        for cre, detail in (
            (GETENV_C_RE, "getenv"),
            (ENV_VAR_RS_RE, "env::var"),
        ):
            for m in cre.finditer(line):
                name = m.group(1)
                if name in seen or not ENV_NAME_RE.match(name):
                    continue
                seen.add(name)
                found.append(Need(name, f"{path}:{i}", detail))
    return found


def looks_like_binary_file(path: Path) -> bool:
    if is_macho_or_elf(path):
        return True
    if path.suffix.lower() in {".bin", ".so", ".dylib", ".exe", ".o", ".a"}:
        return True
    try:
        chunk = path.read_bytes()[:4096]
    except OSError:
        return False
    return b"\0" in chunk


def extract_file(path: Path, needles: Iterable[str] | None = None) -> list[Need]:
    if looks_like_binary_file(path):
        return extract_binary(path, needles)
    return extract_source(path)


