def filter_due(needs: list[Need], *, libc: bool, loose: bool) -> list[Need]:
    out: list[Need] = []
    for n in needs:
        if not libc and is_libc_name(n.name):
            continue
        if not loose and not is_likely_env_name(n.name):
            continue
        out.append(n)
    return out


def filter_latent(names: Iterable[str], *, libc: bool) -> set[str]:
    out: set[str] = set()
    for name in names:
        if not libc and is_libc_name(name):
            continue
        if not (is_valid_env_token(name) or is_runtime_family(name) or name in LIBC_ENV or name in BARE_APP):
            continue
        out.add(name)
    return out


def join_columns(due: list[Need], latent: Iterable[str]) -> list[JoinRow]:
    due_map = {n.name: n for n in due}
    lat = set(latent)
    names = sorted(set(due_map) | lat)
    rows: list[JoinRow] = []
    for name in names:
        in_due = name in due_map
        in_lat = name in lat
        if in_due and in_lat:
            kind = "both"
            source = due_map[name].source
        elif in_due:
            kind = "due"
            source = due_map[name].source
        else:
            kind = "latent"
            source = "trace"
        rows.append(JoinRow(name, source, kind))
    return rows


def format_tsv(rows: list[JoinRow], *, header: bool = False) -> str:
    lines: list[str] = []
    if header:
        lines.append("name\tsource\tkind")
    for r in rows:
        lines.append(f"{r.name}\t{r.source}\t{r.kind}")
    return "\n".join(lines) + ("\n" if lines else "")


def format_human(rows: list[JoinRow]) -> str:
    if not rows:
        return ""
    w_kind = max(4, max(len(r.kind) for r in rows))
    w_name = max(4, max(len(r.name) for r in rows))
    lines = []
    for r in rows:
        lines.append(f"{r.kind:<{w_kind}}  {r.name:<{w_name}}  {r.source}")
    return "\n".join(lines) + "\n"


def format_json(rows: list[JoinRow]) -> str:
    payload = [{"name": r.name, "source": r.source, "kind": r.kind} for r in rows]
    return json.dumps(payload, indent=2) + "\n"


def format_images(rows: list[ImageRow], *, tsv: bool = False) -> str:
    if tsv:
        lines = ["role\tbytes\tpath\traw"]
        for row in rows:
            path = str(row.path) if row.path is not None else "-"
            lines.append(f"{row.role}\t{row.bytes}\t{path}\t{row.raw}")
        return "\n".join(lines) + "\n"
    lines = []
    for row in rows:
        path = str(row.path) if row.path is not None else row.raw
        extra = f"  ({row.bytes})" if row.bytes else ""
        if row.role == "skip":
            lines.append(f"skip  {path}")
        elif row.role == "missing":
            lines.append(f"miss  {row.raw}")
        elif row.role == "cap":
            lines.append(f"cap   {path}{extra}")
        elif row.role == "keep":
            lines.append(f"keep  {path}{extra}")
        elif row.role == "main":
            lines.append(f"main  {path}{extra}")
        else:
            lines.append(f"load  {path}{extra}")
    return "\n".join(lines) + ("\n" if lines else "")


def cap_notes(images: list[ImageRow]) -> list[str]:
    notes = []
    for row in images:
        if row.role != "cap" or row.path is None:
            continue
        mb = row.bytes / (1024 * 1024)
        notes.append(
            f"latent: cap  {row.path.name} ({mb:.0f}MB > --cap-mb); "
            f"not scanned. Raise --cap-mb or pass --keep-large."
        )
    return notes


