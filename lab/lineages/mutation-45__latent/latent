def run_selftest() -> int:
    import traceback

    failures = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal failures
        if cond:
            print(f"  ok  {name}")
        else:
            failures += 1
            extra = f" — {detail}" if detail else ""
            print(f"  FAIL  {name}{extra}", file=sys.stderr)

    tmp = Path(tempfile.mkdtemp(prefix="latent-selftest-"))
    try:
        check("likely PYTHONHOME", is_likely_env_name("PYTHONHOME"))
        check("runtime PYTHONHOME", is_runtime_family("PYTHONHOME"))
        check("likely RUSTC_LOG", is_likely_env_name("RUSTC_LOG"))
        check("likely LATENT_DUE_IDLE", is_likely_env_name("LATENT_DUE_IDLE"))
        check("unlikely BITSET_CANONICAL", not is_likely_env_name("BITSET_CANONICAL"))
        check("reject D_0", not is_valid_env_token("D_0"))
        check("keep Python dylib", is_keep_image(Path("/x/Python")))
        check("keep librustc_driver", is_keep_image(Path("/x/librustc_driver-abc.dylib")))
        check("not keep libnode", not is_keep_image(Path("/x/libnode.147.dylib")))
        check("system libSystem", is_system_image(Path("/usr/lib/libSystem.B.dylib")))

        packed = "junkKIZU_CONFIGXDG_CONFIG_HOMEtailKITTY_LISTEN_ONTERM_PROGRAM"
        toks = split_packed(packed, env_prefixes(["KIZU_CONFIG"]))
        check("split KIZU_CONFIG", "KIZU_CONFIG" in toks)
        check("split XDG_CONFIG_HOME", "XDG_CONFIG_HOME" in toks)

        helpb = tmp / "help.bin"
        helpb.write_bytes(
            b"header\nPYTHONHOME      : alternate <prefix>\n"
            b"\x00  PYTHONPATH = \x00Consider setting $PYTHONSTARTUP to x\x00"
        )
        hnames = {n.name for n in extract_binary(helpb)}
        check("doc PYTHONHOME", "PYTHONHOME" in hnames)
        check("assign PYTHONPATH", "PYTHONPATH" in hnames)
        check("dollar PYTHONSTARTUP", "PYTHONSTARTUP" in hnames)

        # GO_ must not slice CARGO_HOME (left-boundary peel).
        cargo = peel_prefix_tokens(b"xxCARGO_HOME\x00", env_prefixes())
        check("peel CARGO_HOME", "CARGO_HOME" in cargo)
        check("peel does not invent GO_HOME", "GO_HOME" not in cargo)
        idle_peel = peel_prefix_tokens(b"\x00LATENT_DUE_IDLE\x00", env_prefixes())
        check("peel keeps LATENT_DUE_IDLE", "LATENT_DUE_IDLE" in idle_peel)
        check("peel does not invent DUE_IDLE", "DUE_IDLE" not in idle_peel)
        check("reject LATENT_ trailing underscore", not is_runtime_family("LATENT_"))

        otool_l = (
            "/opt/host:\n"
            "\t@rpath/libplugin.dylib (compatibility version 0.0.0, current version 0.0.0)\n"
            "\t/usr/lib/libSystem.B.dylib (compatibility version 1.0.0, current version 1356.0.0)\n"
        )
        parsed = parse_otool_L(otool_l)
        check("otool -L rpath", parsed[0] == "@rpath/libplugin.dylib")
        check("otool -L system", parsed[1].endswith("libSystem.B.dylib"))

        due = [Need("LATENT_DUE_USED", "/probe", "cstring"), Need("LATENT_DUE_IDLE", "/probe", "cstring")]
        lat = {"LATENT_DUE_USED", "LATENT_SYNTH"}
        joined = {r.name: r.kind for r in join_columns(due, lat)}
        check("join both", joined["LATENT_DUE_USED"] == "both")
        check("join due", joined["LATENT_DUE_IDLE"] == "due")
        check("join latent", joined["LATENT_SYNTH"] == "latent")
        tsv = format_tsv(join_columns(due, lat))
        check("tsv columns", "LATENT_DUE_IDLE\t/probe\tdue" in tsv)

        loaded, names = parse_trace_log("#loaded\nHOME\nLATENT_SYNTH\n#note\n")
        check("log canary", loaded and "LATENT_SYNTH" in names and "HOME" in names)

        if sys.platform == "darwin" and Path("/bin/ls").exists():
            check("ls is SIP-restricted", codesign_restricted(Path("/bin/ls")))
        py = shutil.which("python3")
        if py and sys.platform == "darwin":
            check("homebrew python not platform", not codesign_restricted(Path(py).resolve()))

        # cap: a huge fake dylib is not scanned.
        huge = tmp / "libnode.147.dylib"
        huge.write_bytes(b"\xcf\xfa\xed\xfe" + b"NODE_HUGE_TOKEN_XXXX\x00" + b"\0" * 64)
        # not a real Mach-O load; unit-test is_keep / size gate instead
        check("cap gate libnode", not is_keep_image(huge) and huge.stat().st_size < 70 * 1024 * 1024)

        # live --dry if we can compile
        cc = shutil.which("cc")
        if cc and interpose_source().is_file():
            probe = compile_probe(tmp)
            dylib = compile_interposer(tmp)
            log = tmp / "dry.log"
            tr = trace_run(probe, [], interposer=dylib, timeout=5, log_path=log)
            check("dry interposer loaded", tr.loaded, tr.detail)
            check("dry used", "LATENT_DUE_USED" in tr.names)
            check("dry synth latent", "LATENT_SYNTH" in tr.names)
            check("dry idle not latent", "LATENT_DUE_IDLE" not in tr.names)
            dneeds, _imgs = harvest(probe, walk_images=False)
            dnames = {n.name for n in dneeds}
            check("dry due idle", "LATENT_DUE_IDLE" in dnames)
            check("dry due used", "LATENT_DUE_USED" in dnames)
            check("dry due no synth token", "LATENT_SYNTH" not in dnames)
            j = {r.name: r.kind for r in join_columns(filter_due(dneeds, libc=False, loose=False), filter_latent(tr.names, libc=False))}
            check("dry join both used", j.get("LATENT_DUE_USED") == "both")
            check("dry join due idle", j.get("LATENT_DUE_IDLE") == "due")
            check("dry join latent synth", j.get("LATENT_SYNTH") == "latent")
        else:
            print("  skip  no cc / interpose.c")
    except Exception:
        traceback.print_exc()
        failures += 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if failures:
        print(f"selftest: {failures} failure(s)", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


if __name__ == "__main__":
    sys.exit(run())
