def is_system_install_name(name: str) -> bool:
    text = name.replace("\\", "/")
    for pfx in SYSTEM_IMAGE_PREFIXES:
        if text.startswith(pfx) or text.startswith("/private" + pfx):
            return True
    base = text.rsplit("/", 1)[-1]
    if base in {"libSystem.B.dylib", "libobjc.A.dylib", "libc++.1.dylib", "linux-vdso.so.1"}:
        return True
    return False


def is_system_image(path: Path) -> bool:
    try:
        text = str(path.resolve())
    except OSError:
        text = str(path)
    return is_system_install_name(text)


def is_keep_image(path: Path) -> bool:
    return bool(KEEP_IMAGE_RE.match(path.name))


def parse_otool_L(text: str) -> list[str]:
    names: list[str] = []
    for i, raw in enumerate(text.splitlines()):
        line = raw.strip()
        if not line:
            continue
        if i == 0 and line.endswith(":"):
            continue
        m = re.match(r"^(.+?) \((?:compatibility version|architecture)\b", line)
        if m:
            names.append(m.group(1).strip())
            continue
        if line.startswith(("@", "/")) or ".dylib" in line or ".so" in line:
            names.append(line.split(" (", 1)[0].strip())
    return names


def parse_otool_rpaths(text: str) -> list[str]:
    rpaths: list[str] = []
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if "LC_RPATH" not in line:
            continue
        for j in range(i + 1, min(i + 8, len(lines))):
            m = re.search(r"\bpath\s+(\S+)", lines[j])
            if m:
                rpaths.append(m.group(1))
                break
    return rpaths


def parse_ldd(text: str) -> list[str]:
    out: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        if " => " in line:
            right = line.split(" => ", 1)[1].strip()
            path = right.split(" (", 1)[0].strip()
            if path and path != "not found":
                out.append(path)
        elif line.startswith("/") and ".so" in line:
            out.append(line.split()[0])
    return out


def parse_objdump_dynamic(text: str) -> tuple[list[str], list[str]]:
    needed: list[str] = []
    rpaths: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("NEEDED"):
            needed.append(line.split()[-1])
        elif line.startswith("RPATH") or line.startswith("RUNPATH"):
            val = line.split()[-1]
            rpaths.extend(p for p in val.split(":") if p)
    return needed, rpaths


def _run_tool(argv: list[str], timeout: float = 8.0) -> str:
    try:
        return subprocess.check_output(
            argv, text=True, stderr=subprocess.DEVNULL, timeout=timeout
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return ""


def macho_install_names(path: Path) -> list[str]:
    return parse_otool_L(_run_tool(["otool", "-L", str(path)]))


def macho_rpaths(path: Path) -> list[str]:
    return parse_otool_rpaths(_run_tool(["otool", "-l", str(path)]))


def expand_load_special(spec: str, *, loader: Path, executable: Path) -> str:
    loader_dir = str(loader.parent)
    exec_dir = str(executable.parent)
    return spec.replace("@loader_path", loader_dir).replace("@executable_path", exec_dir)


def resolve_load_name(
    name: str,
    *,
    loader: Path,
    executable: Path,
    rpaths: list[str],
) -> Path | None:
    name = name.strip()
    if not name:
        return None
    if name.startswith("@rpath/"):
        rest = name[len("@rpath/") :]
        expanded = [
            expand_load_special(r, loader=loader, executable=executable) for r in rpaths
        ]
        extra = [
            str(loader.parent),
            str(loader.parent / "lib"),
            str(loader.parent.parent / "lib"),
            str(executable.parent),
            str(executable.parent / "lib"),
            str(executable.parent.parent / "lib"),
        ]
        seen_dir: set[str] = set()
        for rp in expanded + extra:
            if not rp or rp in seen_dir:
                continue
            seen_dir.add(rp)
            cand = Path(rp) / rest
            if cand.is_file():
                return cand.resolve()
        return None
    expanded = expand_load_special(name, loader=loader, executable=executable)
    if expanded.startswith("@rpath/"):
        return resolve_load_name(
            expanded, loader=loader, executable=executable, rpaths=rpaths
        )
    path = Path(expanded)
    if path.is_file():
        return path.resolve()
    rel = loader.parent / name
    if rel.is_file():
        return rel.resolve()
    return None


def elf_needed_and_rpaths(path: Path) -> tuple[list[str], list[str]]:
    ldd = shutil.which("ldd")
    if ldd:
        resolved = parse_ldd(_run_tool([ldd, str(path)]))
        if resolved:
            return resolved, []
    dump = shutil.which("objdump") or shutil.which("llvm-objdump")
    if dump:
        return parse_objdump_dynamic(_run_tool([dump, "-p", str(path)]))
    return [], []


def iter_loaded_images(
    root: Path,
    *,
    system: bool = False,
    closure: bool = False,
    depth: int = 1,
    cap_bytes: int = DEFAULT_CAP_MB * 1024 * 1024,
    keep_large: bool = False,
) -> list[ImageRow]:
    root = root.resolve()
    rows: list[ImageRow] = []
    try:
        size = root.stat().st_size
    except OSError:
        size = 0
    rows.append(ImageRow("main", root, str(root), size))
    if not is_macho_or_elf(root):
        return rows

    max_depth = 64 if closure else max(0, depth)
    pending: list[tuple[Path, int]] = [(root, 0)]
    seen: set[Path] = {root}
    listed_raw: set[str] = set()

    while pending:
        current, d = pending.pop(0)
        if d >= max_depth:
            continue
        rpaths = macho_rpaths(current) if is_macho_or_elf(current) else []
        names: list[str] = []
        try:
            with current.open("rb") as fh:
                magic = fh.read(4)
        except OSError:
            magic = b""
        if magic in MACH_O_MAGICS:
            names = macho_install_names(current)
        elif magic == b"\x7fELF":
            needed, elf_rpaths = elf_needed_and_rpaths(current)
            rpaths = list(elf_rpaths) + rpaths
            names = needed
        else:
            continue

        for raw in names:
            if raw in listed_raw:
                continue
            listed_raw.add(raw)
            resolved = resolve_load_name(
                raw, loader=current, executable=root, rpaths=rpaths
            )
            if resolved is None:
                role = "skip" if (not system) and is_system_install_name(raw) else "missing"
                rows.append(ImageRow(role, None, raw, 0))
                continue
            if resolved == root or resolved == current:
                continue
            if resolved in seen:
                continue
            seen.add(resolved)
            try:
                sz = resolved.stat().st_size
            except OSError:
                sz = 0
            if (not system) and is_system_image(resolved):
                rows.append(ImageRow("skip", resolved, raw, sz))
                continue
            over = cap_bytes > 0 and sz > cap_bytes
            keep = keep_large or is_keep_image(resolved)
            if over and not keep:
                rows.append(ImageRow("cap", resolved, raw, sz))
                continue
            role = "keep" if over and keep else "load"
            rows.append(ImageRow(role, resolved, raw, sz))
            pending.append((resolved, d + 1))
    return rows


def harvest(
    path: Path,
    *,
    walk_images: bool = True,
    system: bool = False,
    closure: bool = False,
    depth: int = 1,
    cap_bytes: int = DEFAULT_CAP_MB * 1024 * 1024,
    keep_large: bool = False,
) -> tuple[list[Need], list[ImageRow]]:
    path = path.resolve()
    images = (
        iter_loaded_images(
            path,
            system=system,
            closure=closure,
            depth=depth,
            cap_bytes=cap_bytes,
            keep_large=keep_large,
        )
        if walk_images
        else [ImageRow("main", path, str(path), path.stat().st_size if path.is_file() else 0)]
    )
    acc: list[Need] = []
    seen: set[Path] = set()
    for row in images:
        if row.role in {"skip", "missing", "cap"}:
            continue
        if row.path is None:
            continue
        rp = row.path.resolve()
        if rp in seen:
            continue
        seen.add(rp)
        acc.extend(extract_file(rp))
    return merge_needs(acc), images


def merge_needs(needs: Iterable[Need]) -> list[Need]:
    best: dict[str, Need] = {}
    for need in needs:
        cur = best.get(need.name)
        if cur is None:
            best[need.name] = need
    return [best[k] for k in sorted(best)]


def resolve_program(spec: str) -> Path:
    path = Path(spec)
    if path.exists():
        return path
    found = shutil.which(spec)
    if found:
        return Path(found)
    raise FileNotFoundError(f"not a file, directory, or PATH command: {spec}")


