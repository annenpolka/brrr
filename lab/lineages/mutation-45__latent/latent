def here() -> Path:
    return Path(__file__).resolve().parent


def interpose_source() -> Path:
    return here() / "interpose.c"


def compile_interposer(dest_dir: Path) -> Path:
    src = interpose_source()
    if not src.is_file():
        raise RuntimeError(f"missing interposer source: {src}")
    cc = shutil.which("cc") or shutil.which("clang") or shutil.which("gcc")
    if not cc:
        raise RuntimeError("no C compiler (cc) to build the getenv interposer")
    if sys.platform == "darwin":
        out = dest_dir / "liblatent.dylib"
        cmd = [cc, "-dynamiclib", "-O2", "-o", str(out), str(src)]
    else:
        out = dest_dir / "liblatent.so"
        cmd = [cc, "-shared", "-fPIC", "-O2", "-o", str(out), str(src), "-ldl"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not out.is_file():
        raise RuntimeError(f"interposer compile failed: {r.stderr.strip() or r.stdout}")
    return out


def compile_probe(dest_dir: Path, src: Path | None = None) -> Path:
    src = src or (here() / "fixtures" / "latent" / "probe.c")
    cc = shutil.which("cc") or shutil.which("clang") or shutil.which("gcc")
    if not cc:
        raise RuntimeError("no C compiler (cc) to build the --dry probe")
    out = dest_dir / "latent-probe"
    r = subprocess.run([cc, "-O0", "-o", str(out), str(src)], capture_output=True, text=True)
    if r.returncode != 0 or not out.is_file():
        raise RuntimeError(f"probe compile failed: {r.stderr.strip() or r.stdout}")
    return out


def codesign_restricted(path: Path) -> bool:
    """Platform / hardened-runtime binaries strip DYLD_* (SIP)."""
    if sys.platform != "darwin":
        return False
    exe = shutil.which("codesign")
    if not exe:
        return False
    r = subprocess.run(
        [exe, "-d", "-vv", str(path)],
        capture_output=True,
        text=True,
        timeout=5,
    )
    blob = (r.stdout or "") + (r.stderr or "")
    if re.search(r"Platform identifier=", blob):
        return True
    if re.search(r"flags=0x[0-9a-f]*\(.*runtime", blob):
        if "allow-dyld-environment-variables" in blob.lower():
            return False
        return True
    return False


def parse_trace_log(text: str) -> tuple[bool, set[str]]:
    loaded = False
    names: set[str] = set()
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("#"):
            if line.startswith("#loaded"):
                loaded = True
            continue
        if ENV_NAME_RE.match(line):
            names.add(line)
    return loaded, names


def trace_run(
    program: Path,
    args: list[str],
    *,
    interposer: Path,
    timeout: float,
    log_path: Path,
) -> TraceResult:
    env = os.environ.copy()
    env.pop("DYLD_INSERT_LIBRARIES", None)
    env.pop("DYLD_FORCE_FLAT_NAMESPACE", None)
    env.pop("LD_PRELOAD", None)
    env["LATENT_LOG"] = str(log_path)
    if sys.platform == "darwin":
        env["DYLD_INSERT_LIBRARIES"] = str(interposer)
    else:
        prev = env.get("LD_PRELOAD", "")
        env["LD_PRELOAD"] = str(interposer) if not prev else f"{interposer}:{prev}"
    argv = [str(program), *args]
    rc: int | None = None
    detail = ""
    try:
        r = subprocess.run(
            argv,
            env=env,
            capture_output=True,
            timeout=timeout if timeout > 0 else None,
        )
        rc = r.returncode
        if r.returncode < 0:
            detail = f"signal {-r.returncode}"
    except subprocess.TimeoutExpired:
        detail = "timeout"
        rc = None
    except OSError as exc:
        detail = str(exc)
        rc = None

    loaded = False
    names: set[str] = set()
    if log_path.is_file():
        loaded, names = parse_trace_log(log_path.read_text(encoding="utf-8", errors="replace"))

    sip = False
    if not loaded:
        sip = codesign_restricted(program) or sys.platform == "darwin"
        if not loaded and rc == 0 and sys.platform == "darwin":
            sip = True
        if sys.platform != "darwin" and not loaded:
            sip = False
            detail = detail or "interposer did not load"
    return TraceResult(names=names, loaded=loaded, sip=sip, rc=rc, detail=detail)


