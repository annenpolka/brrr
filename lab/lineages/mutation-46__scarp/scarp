# CLI
# ---------------------------------------------------------------------------

def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="scarp", add_help=False, usage=USAGE)
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--porcelain", action="store_true")
    p.add_argument("--explain", action="store_true")
    p.add_argument("--require", metavar="NAME")
    p.add_argument("--boot", action="store_true")
    p.add_argument("cmd", nargs="?", default="")
    p.add_argument("cmd_args", nargs="*")
    return p.parse_args(argv)


def emit_gap(g: Gap, ns: argparse.Namespace, stream) -> None:
    if ns.json:
        stream.write(format_json(g))
    elif ns.porcelain:
        stream.write(format_porcelain(g))
    elif ns.explain:
        stream.write(format_explain(g))
    else:
        stream.write(format_word(g))


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    ns = parse_args(argv)
    if ns.help:
        print(USAGE)
        return 0
    if ns.version:
        print(f"scarp {VERSION} backend={BACKEND['kind']}")
        return 0
    cmd = ns.cmd or ""
    if cmd == "--":
        cmd = ""

    if cmd == "selftest":
        try:
            return selftest()
        except Fail as e:
            print(f"FAIL  {e}", file=sys.stderr)
            return 1

    if cmd == "cut":
        c = cut_boot() if ns.boot else cut_now()
        if ns.json:
            sys.stdout.write(format_cut_json(c))
        else:
            sys.stdout.write(format_cut_tsv(c))
        return 0

    if cmd:
        print(USAGE, file=sys.stderr)
        return 2

    raw = sys.stdin.read()
    if not raw.strip():
        print("scarp: no clock readings on stdin", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        return 2
    try:
        g = classify_text(raw)
    except SystemExit as e:
        print(str(e), file=sys.stderr)
        return 1
    emit_gap(g, ns, sys.stdout)
    if ns.require:
        want = ns.require.strip().upper()
        if g.primary != want:
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
