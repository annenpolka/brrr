def _iter_json_objs(text: str) -> Iterator[dict]:
    text = text.strip()
    if not text:
        return
    if text[0] in "[{":
        try:
            data = json.loads(text)
        except json.JSONDecodeError:
            data = None
        if data is not None:
            if isinstance(data, dict):
                if "comments" in data and isinstance(data["comments"], list):
                    for o in data["comments"]:
                        if isinstance(o, dict):
                            yield o
                    return
                yield data
                return
            if isinstance(data, list):
                for o in data:
                    if isinstance(o, dict):
                        yield o
                return
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or line[0] != "{":
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(o, dict):
            yield o


def parse_markdown_stream(text: str, source: str = "markdown") -> list[Suggest]:
    text = _strip_cr(text)
    claims: list[Suggest] = []
    path = ""
    start: int | None = None
    end: int | None = None
    pending_quote: list[str] | None = None
    lines = text.splitlines()
    i = 0
    n = len(lines)
    seq = 0

    def remember_path(p: str, a: str | None, b: str | None) -> None:
        nonlocal path, start, end
        path = p
        start = int(a) if a else None
        end = int(b) if b else start

    while i < n:
        L = lines[i]
        hm = HEADING_PATH_RE.match(L.strip())
        if hm:
            remember_path(hm.group("path"), hm.group("a"), hm.group("b"))
            i += 1
            continue
        html = HTML_PATH_RE.search(L)
        if html:
            path = html.group(1)
            i += 1
            continue
        tick = IN_TICK_PATH_RE.search(L)
        if tick:
            path = tick.group(1)
            i += 1
            continue
        pm = PATH_LINE_RE.match(L.strip().strip("`"))
        if pm and not L.strip().startswith("```"):
            remember_path(pm.group("path"), pm.group("a"), pm.group("b"))
            i += 1
            continue
        stripped = L.strip()
        if stripped.startswith("```") and not stripped.startswith("```suggestion"):
            lang = stripped[3:].strip()
            i += 1
            block: list[str] = []
            while i < n and not lines[i].strip().startswith("```"):
                block.append(lines[i])
                i += 1
            if i < n:
                i += 1
            if lang.lower() in ("", "text", "code", "diff"):
                pending_quote = block
            continue
        if stripped.startswith("```suggestion"):
            i += 1
            after: list[str] = []
            while i < n and not lines[i].strip().startswith("```"):
                after.append(lines[i])
                i += 1
            if i < n:
                i += 1
            if not path:
                continue
            seq += 1
            before = pending_quote if pending_quote is not None else []
            recon = "markdown-quote" if before else "markdown"
            claims.append(
                Suggest(
                    id=f"md{seq}:{path}",
                    path=path,
                    before=list(before),
                    after=list(after),
                    start=start,
                    end=end,
                    recon=recon,
                    source=source,
                )
            )
            pending_quote = None
            continue
        i += 1
    return claims


def _strip_ab(path: str) -> str:
    path = path.strip().strip('"')
    if path.startswith("a/") or path.startswith("b/"):
        return path[2:]
    return path


def parse_patch_suggests(text: str, source: str = "patch") -> list[Suggest]:
    """Each unified-diff hunk is one suggestion (whole-hunk replacement)."""
    suggests: list[Suggest] = []
    old_path = new_path = ""
    hunk: Suggest | None = None
    tagged: list[tuple[str, str]] = []
    per_file = 0

    def flush() -> None:
        nonlocal hunk, tagged, per_file
        if hunk is None:
            return
        hunk.before = [t for op, t in tagged if op in " -"]
        hunk.after = [t for op, t in tagged if op in " +"]
        if hunk.before:
            hunk.end = (hunk.start or 1) + len(hunk.before) - 1
        suggests.append(hunk)
        hunk = None
        tagged = []

    for raw in _strip_cr(text).splitlines():
        if raw.startswith("diff --git "):
            flush()
            rest = raw[len("diff --git ") :]
            idx = rest.find(" b/")
            if idx != -1:
                old_path = _strip_ab(rest[:idx])
                new_path = _strip_ab(rest[idx + 1 :])
            per_file = 0
            continue
        if raw.startswith("--- "):
            rhs = raw[4:]
            if "/dev/null" not in rhs:
                old_path = _strip_ab(rhs)
            continue
        if raw.startswith("+++ "):
            rhs = raw[4:]
            if "/dev/null" not in rhs:
                new_path = _strip_ab(rhs)
            continue
        m = HUNK_RE.match(raw)
        if m:
            flush()
            per_file += 1
            live = new_path or old_path
            old_start = int(m.group(1)) or 1
            hunk = Suggest(
                id=f"{source}:{live}#{per_file}",
                path=live,
                before=[],
                after=[],
                start=old_start,
                recon="patch",
                source=source,
            )
            tagged = []
            continue
        if hunk is None:
            continue
        if raw.startswith("\\"):
            continue
        if raw.startswith("+"):
            tagged.append(("+", raw[1:]))
        elif raw.startswith("-"):
            tagged.append(("-", raw[1:]))
        elif raw.startswith(" "):
            tagged.append((" ", raw[1:]))
        elif raw == "":
            tagged.append((" ", ""))
    flush()
    return suggests


def looks_like_patch(text: str) -> bool:
    s = text.lstrip("\ufeff")
    return s.startswith("diff --git ") or s.startswith("--- ") or bool(HUNK_RE.match(s.splitlines()[0] if s else ""))


def load_stream(text: str, source: str = "stream") -> list[Suggest]:
    text = text.lstrip("\ufeff")
    if looks_like_patch(text):
        got = parse_patch_suggests(text, source=source)
        if got:
            return got
    stripped = text.lstrip()
    if stripped[:1] in "[{":
        claims: list[Suggest] = []
        for obj in _iter_json_objs(text):
            claims.extend(obj_to_suggests(obj, source=source))
        if claims:
            return claims
    md = parse_markdown_stream(text, source=source)
    if md:
        return md
    claims = []
    for obj in _iter_json_objs(text):
        claims.extend(obj_to_suggests(obj, source=source))
    return claims


def load_path(path: str, label: str | None = None) -> list[Suggest]:
    if path == "-":
        return load_stream(sys.stdin.read(), source=label or "stdin")
    p = Path(path)
    return load_stream(p.read_text(encoding="utf-8"), source=label or str(p))


# ---------------------------------------------------------------------------
# algebra kernel — no tree
# ---------------------------------------------------------------------------

def find_all(hay: list[str], needle: list[str]) -> list[int]:
    if not needle:
        return []
    n = len(needle)
    hits: list[int] = []
    first = needle[0]
    start = 0
    length = len(hay)
    while start < length:
        try:
            j = hay.index(first, start)
        except ValueError:
            break
        if hay[j : j + n] == needle:
            hits.append(j)
        start = j + 1
    return hits


def find_sub(hay: list[str], needle: list[str]) -> int | None:
    hits = find_all(hay, needle)
    return hits[0] if hits else None


def apply_one(lines: list[str], s: Suggest, origin: int) -> list[str] | None:
    """Replace s.before with s.after in a local original. None = does not apply."""
    text = list(lines)
    if s.before == s.after:
        return text
    if not s.before:
        if s.start is None:
            return None
        i = s.start - origin
        i = max(0, min(i, len(text)))
        return text[:i] + list(s.after) + text[i:]
    hits = find_all(text, s.before)
    if not hits:
        return None
    if s.start is not None:
        expected = s.start - origin
        i = min(hits, key=lambda h: (abs(h - expected), h))
    else:
        if len(hits) != 1:
            return None
        i = hits[0]
    return text[:i] + list(s.after) + text[i + len(s.before) :]


def apply_all(lines: list[str], ss: list[Suggest], origin: int) -> list[str] | None:
    text = list(lines)
    ordered = sorted(ss, key=lambda s: (s.start is None, s.start or 0))
    for s in ordered:
        nxt = apply_one(text, s, origin)
        if nxt is None:
            return None
        text = nxt
    return text


def paint(suggests: list[Suggest]) -> tuple[list[str], int] | None:
    """Local original covering every before-image. Gaps are placeholders."""
    numbered = [s for s in suggests if s.start is not None and s.before]
    commits = {s.original_commit_id for s in suggests if s.original_commit_id}
    if len(commits) > 1:
        return None
    if numbered:
        lo = min(s.start or 1 for s in numbered)
        hi = lo
        for s in numbered:
            _a, b = s.span
            if b is not None:
                hi = max(hi, b)
            hi = max(hi, (s.start or lo) + len(s.before) - 1)
        orig: list[str | None] = [None] * (hi - lo + 1)
        for s in numbered:
            start = s.start or lo
            for j, line in enumerate(s.before):
                idx = start + j - lo
                if idx < 0 or idx >= len(orig):
                    continue
                if orig[idx] is None:
                    orig[idx] = line
                elif orig[idx] != line:
                    return None
        out: list[str] = []
        for i, v in enumerate(orig):
            out.append(v if v is not None else f"{GAP_PREFIX}{lo + i}__")
        return out, lo
    # unnumbered: nest or concat
    if not suggests:
        return [], 1
    bodies = [s.before for s in suggests if s.before]
    if not bodies:
        # inserts only
        return [], 1
    bodies = sorted(bodies, key=len, reverse=True)
    host = list(bodies[0])
    for other in bodies[1:]:
        if not other:
            continue
        if find_sub(host, other) is not None:
            continue
        if find_sub(other, host) is not None:
            host = list(other)
            continue
        host = host + [f"{GAP_PREFIX}join__"] + list(other)
    return host, 1


def range_contains(outer: Suggest, inner: Suggest) -> bool:
    os, oe = outer.span
    ins, ine = inner.span
    if None in (os, oe, ins, ine):
        if not inner.before:
            return False
        return find_sub(outer.before, inner.before) is not None
    return os <= ins and ine <= oe  # type: ignore[operator]


def nested_absorb(outer: Suggest, inner: Suggest) -> bool:
    """True iff taking outer already realizes inner's after-image."""
    if outer.path != inner.path:
        return False
    if not inner.before:
        return False
    if outer.before == inner.before and outer.after == inner.after:
        return True
    pos = find_sub(outer.before, inner.before)
    if pos is None:
        return False
    local = outer.before[:pos] + inner.after + outer.before[pos + len(inner.before) :]
    if local == outer.after:
        return True
    prefix = outer.before[:pos]
    suffix = outer.before[pos + len(inner.before) :]
    if prefix and outer.after[: len(prefix)] != prefix:
        return False
    if suffix:
        if len(outer.after) < len(suffix) or outer.after[-len(suffix) :] != suffix:
            return False
        mid = outer.after[len(prefix) : len(outer.after) - len(suffix)]
    else:
        mid = outer.after[len(prefix) :]
    return mid == inner.after


def _verdict(
    status: str,
    a: Suggest,
    b: Suggest,
    note: str = "",
    order: str = "",
    absorber: str | None = None,
    batch: bool = False,
) -> Verdict:
    path = a.path if a.path == b.path else f"{a.path}|{b.path}"
    return Verdict(
        status=status,
        a=a.id,
        b=b.id,
        path=path,
        note=note,
        order=order,
        absorber=absorber,
        batch=batch,
        a_path=a.path,
        b_path=b.path,
        a_start=a.start,
        b_start=b.start,
    )


def compose_pair(a: Suggest, b: Suggest) -> Verdict:
    """Compose two suggestions. Never reads a tree."""
    if a.path != b.path:
        return _verdict("COMMUTE", a, b, note="disjoint-path", order="ab|ba", batch=True)

    # identical images
    if a.before == b.before and a.after == b.after:
        return _verdict("ABSORB", a, b, note="equal", order="ab|ba", absorber="*", batch=True)

    # chain on the same image
    if a.after == b.before and a.before != b.before:
        return _verdict("ORDERED", a, b, note="chain", order="ab", batch=False)
    if b.after == a.before and b.before != a.before:
        return _verdict("ORDERED", a, b, note="chain", order="ba", batch=False)

    commits = {c for c in (a.original_commit_id, b.original_commit_id) if c}
    different_commit = len(commits) > 1

    if different_commit:
        if a.before == b.before:
            return _verdict("CONFLICT", a, b, note="unrelated-commit-same-before", batch=False)
        # Same path, different snapshot: not GitHub-batchable.
        return _verdict("COMMUTE", a, b, note="unrelated-commit", order="ab|ba", batch=False)

    if nested_absorb(a, b) and not nested_absorb(b, a):
        return _verdict("ABSORB", a, b, note="nested", absorber=a.id, batch=False)
    if nested_absorb(b, a) and not nested_absorb(a, b):
        return _verdict("ABSORB", a, b, note="nested", absorber=b.id, batch=False)
    if nested_absorb(a, b) and nested_absorb(b, a):
        return _verdict("ABSORB", a, b, note="equal-nested", absorber="*", batch=True)

    painted = paint([a, b])
    if painted is None:
        if a.before == b.before:
            return _verdict("CONFLICT", a, b, note="inconsistent-before", batch=False)
        return _verdict("CONFLICT", a, b, note="inconsistent-before", batch=False)

    orig, origin = painted
    a_only = apply_one(orig, a, origin)
    b_only = apply_one(orig, b, origin)
    ab = apply_all(orig, [a, b], origin)
    ba = apply_all(orig, [b, a], origin)

    if ab is not None and ba is not None:
        if ab != ba:
            return _verdict("CONFLICT", a, b, note="order-disagrees", batch=False)
        if a_only is not None and ab == a_only:
            return _verdict("ABSORB", a, b, note="redundant", absorber=a.id, batch=False)
        if b_only is not None and ba == b_only:
            return _verdict("ABSORB", a, b, note="redundant", absorber=b.id, batch=False)
        return _verdict("COMMUTE", a, b, note="either-order", order="ab|ba", batch=True)

    if ab is not None and ba is None:
        if a_only is not None and ab == a_only:
            return _verdict("ABSORB", a, b, note="redundant", absorber=a.id, batch=False)
        return _verdict("ORDERED", a, b, note="ab-only", order="ab", batch=False)
    if ba is not None and ab is None:
        if b_only is not None and ba == b_only:
            return _verdict("ABSORB", a, b, note="redundant", absorber=b.id, batch=False)
        return _verdict("ORDERED", a, b, note="ba-only", order="ba", batch=False)

    # neither sequential apply: overlapping disagreement
    return _verdict("CONFLICT", a, b, note="overlap", batch=False)


def compose_patches(p: list[Suggest], q: list[Suggest]) -> tuple[str, list[Verdict]]:
    """Patch-level: every p_i vs every q_j, plus worst status."""
    if not p or not q:
        return "EMPTY", []
    pairs = [compose_pair(a, b) for a in p for b in q]
    worst = "EMPTY"
    for v in pairs:
        if RANK[v.status] > RANK[worst]:
            worst = v.status
    return worst, pairs


def commit_key(s: Suggest) -> str:
    return s.original_commit_id or s.commit_id or ""


def pairwise(ss: list[Suggest], all_commits: bool = False) -> tuple[str, list[Verdict], dict]:
    """Compose pairs. Default: only within original_commit_id.

    A harvested comments.json from two PRs must not look batch-safe.
    `--all-commits` restores the cartesian product (v0.1).
    """
    meta = {"commits": 0, "skipped": 0, "singles": 0}
    n = len(ss)
    cartesian = n * (n - 1) // 2 if n >= 2 else 0
    if n < 2:
        return "EMPTY", [], meta
    groups: dict[str, list[Suggest]] = {}
    for s in ss:
        groups.setdefault(commit_key(s), []).append(s)
    meta["commits"] = len(groups)
    if all_commits:
        pairs = [compose_pair(a, b) for a, b in combinations(ss, 2)]
        meta["skipped"] = 0
        meta["singles"] = sum(1 for g in groups.values() if len(g) < 2)
    else:
        pairs = []
        singles = 0
        for g in groups.values():
            if len(g) < 2:
                singles += 1
                continue
            pairs.extend(compose_pair(a, b) for a, b in combinations(g, 2))
        meta["singles"] = singles
        meta["skipped"] = cartesian - len(pairs)
    worst = "EMPTY"
    for v in pairs:
        if RANK[v.status] > RANK[worst]:
            worst = v.status
    return worst, pairs, meta


# ---------------------------------------------------------------------------
# emit composed unified diff (no tree)
# ---------------------------------------------------------------------------

def hunk_text(s: Suggest) -> str:
    old_n = len(s.before)
    new_n = len(s.after)
    start = s.start or 1
    lines = [f"@@ -{start},{old_n} +{start},{new_n} @@"]
    # Prefer a true replacement listing: minus then plus. Context-style
    # mixed hunks are reconstructed as wholesale before→after.
    for t in s.before:
        lines.append("-" + t)
    for t in s.after:
        lines.append("+" + t)
    return "\n".join(lines)


def emit_suggests(ss: list[Suggest]) -> str:
    by_path: dict[str, list[Suggest]] = {}
    for s in ss:
        by_path.setdefault(s.path, []).append(s)
    out: list[str] = []
    for path, hunks in by_path.items():
        hunks = sorted(hunks, key=lambda s: s.start or 0)
        out.append(f"diff --git a/{path} b/{path}")
        out.append(f"--- a/{path}")
        out.append(f"+++ b/{path}")
        for h in hunks:
            out.append(hunk_text(h))
    return "\n".join(out) + ("\n" if out else "")


def emit_pair(v: Verdict, a: Suggest, b: Suggest) -> str:
    if v.status == "CONFLICT":
        return ""
    if v.status == "ABSORB":
        if v.absorber == b.id:
            return emit_suggests([b])
        return emit_suggests([a])
    if v.status == "ORDERED":
        if v.order == "ba":
            merged = Suggest(
                id=f"{b.id}+{a.id}",
                path=a.path,
                before=list(b.before) if b.before else list(a.before),
                after=list(a.after),
                start=b.start if b.start is not None else a.start,
                recon="ordered-merge",
            )
            return emit_suggests([merged])
        merged = Suggest(
            id=f"{a.id}+{b.id}",
            path=a.path,
            before=list(a.before) if a.before else list(b.before),
            after=list(b.after),
            start=a.start if a.start is not None else b.start,
            recon="ordered-merge",
        )
        return emit_suggests([merged])
    # COMMUTE: both, original coordinates
    return emit_suggests([a, b])


