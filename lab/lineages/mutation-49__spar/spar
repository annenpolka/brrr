# format
# ---------------------------------------------------------------------------

def worst_status(pairs: list[Verdict]) -> str:
    worst = "EMPTY"
    for v in pairs:
        if RANK[v.status] > RANK[worst]:
            worst = v.status
    return worst


def batch_safe(pairs: list[Verdict]) -> bool:
    if not pairs:
        return True
    return all(v.batch for v in pairs)


def counts_of(pairs: list[Verdict]) -> dict[str, int]:
    c = Counter(v.status for v in pairs)
    return {k: int(c.get(k, 0)) for k in ("COMMUTE", "ABSORB", "ORDERED", "CONFLICT")}


def format_human(status: str, pairs: list[Verdict], interesting: bool, meta: dict | None = None) -> str:
    c = counts_of(pairs)
    batch = "yes" if batch_safe(pairs) else "no"
    n = len(pairs)
    extra = ""
    if meta:
        if meta.get("commits"):
            extra += f"  commits={meta['commits']}"
        if meta.get("skipped"):
            extra += f"  skipped={meta['skipped']}"
        if meta.get("singles"):
            extra += f"  singles={meta['singles']}"
    lines = [
        f"spar  {status}  pairs={n}  "
        f"COMMUTE={c['COMMUTE']}  ABSORB={c['ABSORB']}  "
        f"ORDERED={c['ORDERED']}  CONFLICT={c['CONFLICT']}  batch={batch}{extra}"
    ]
    hidden = 0
    for v in pairs:
        if interesting and v.status == "COMMUTE" and v.note in ("disjoint-path", "unrelated-commit"):
            hidden += 1
            continue
        extra = ""
        if v.absorber:
            extra += f"  absorber={v.absorber}"
        if v.order:
            extra += f"  order={v.order}"
        loc = ""
        if v.a_start is not None or v.b_start is not None:
            loc = f"  @{v.a_start or '-'}×{v.b_start or '-'}"
        lines.append(
            f"  {v.status:<8} {v.path}  {v.a} × {v.b}  {v.note}{loc}{extra}"
        )
    if hidden:
        lines.append(f"  ({hidden} disjoint/unrelated COMMUTE hidden; drop --interesting)")
    return "\n".join(lines) + "\n"


def format_porcelain(status: str, pairs: list[Verdict], meta: dict | None = None) -> str:
    c = counts_of(pairs)
    meta = meta or {}
    return (
        f"status {status}\n"
        f"pairs {len(pairs)}\n"
        f"commute {c['COMMUTE']}\n"
        f"absorb {c['ABSORB']}\n"
        f"ordered {c['ORDERED']}\n"
        f"conflict {c['CONFLICT']}\n"
        f"batch {int(batch_safe(pairs))}\n"
        f"commits {int(meta.get('commits', 0))}\n"
        f"skipped {int(meta.get('skipped', 0))}\n"
        f"singles {int(meta.get('singles', 0))}\n"
    )


def format_tsv(pairs: list[Verdict]) -> str:
    rows = ["status\ta\tb\tpath\tnote\torder\tabsorber\tbatch\ta_start\tb_start"]
    for v in pairs:
        rows.append(
            "\t".join(
                [
                    v.status,
                    v.a,
                    v.b,
                    v.path,
                    v.note,
                    v.order,
                    v.absorber or "",
                    "1" if v.batch else "0",
                    "" if v.a_start is None else str(v.a_start),
                    "" if v.b_start is None else str(v.b_start),
                ]
            )
        )
    return "\n".join(rows) + "\n"


def report_dict(
    status: str,
    pairs: list[Verdict],
    left: list[Suggest],
    right: list[Suggest] | None,
    meta: dict | None = None,
) -> dict:
    meta = meta or {}
    return {
        "status": status,
        "pairs": len(pairs),
        "counts": counts_of(pairs),
        "batch": batch_safe(pairs),
        "commits": meta.get("commits", 0),
        "skipped": meta.get("skipped", 0),
        "singles": meta.get("singles", 0),
        "left": [s.id for s in left],
        "right": [s.id for s in right] if right is not None else None,
        "verdicts": [v.as_dict() for v in pairs],
    }


def status_exit(status: str, pairs: list[Verdict]) -> int:
    if status in ("EMPTY", "COMMUTE"):
        return EXIT_OK
    if status == "ABSORB":
        return EXIT_OK if batch_safe(pairs) else EXIT_ORDER
    if status == "ORDERED":
        return EXIT_ORDER
    if status == "CONFLICT":
        return EXIT_CONFLICT
    return EXIT_ERROR


