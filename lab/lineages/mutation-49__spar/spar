#!/usr/bin/env python3
"""spar — compose two review-suggestion patches.

twain occupies oracle-half vs production-half of a *commit* against a tree.
plea/lodge occupy a suggestion against HEAD.

spar does not occupy a tree. Two suggestions are a patch algebra:

  COMMUTE   either order, same after-image (GitHub batch-safe)
  ABSORB    one after-image already contains the other; drop the inner
  ORDERED   only one order applies (chain / reply on the other's after)
  CONFLICT  both orders fail, or same locus disagrees

Input is GitHub review comments, markdown ```suggestion fences, or unified
diffs. Reconstruction of a comment's before-image is the commented range,
not every `+` line of a truncated diff_hunk.
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from collections import Counter
from dataclasses import dataclass
from itertools import combinations
from pathlib import Path
from typing import Iterator

VERSION = "0.2.0"  # 0.1 compose; 0.2 pairwise within original_commit_id

EXIT_OK = 0       # COMMUTE / EQUAL / EMPTY (batch-safe)
EXIT_ORDER = 1    # ABSORB nested / ORDERED (resolvable, not batch)
EXIT_CONFLICT = 2
EXIT_ERROR = 3

RANK = {"EMPTY": 0, "COMMUTE": 1, "ABSORB": 2, "ORDERED": 3, "CONFLICT": 4}

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
SUGGEST_RE = re.compile(r"```suggestion[^\n]*\n(.*?)```", re.S)
PATH_LINE_RE = re.compile(
    r"^(?:(?:path|file|filename)\s*:\s*)?"
    r"(?P<path>(?:[\w./-]+/)*[\w./-]+\.[A-Za-z0-9+]+)"
    r"(?::(?P<a>\d+)(?:-(?P<b>\d+))?)?\s*$"
)
HEADING_PATH_RE = re.compile(
    r"^#{1,6}\s+`?(?P<path>(?:[\w./-]+/)*[\w./-]+\.[A-Za-z0-9+]+)`?"
    r"(?::(?P<a>\d+)(?:-(?P<b>\d+))?)?"
)
HTML_PATH_RE = re.compile(r"""<!--\s*(?:filepath|path|file)\s*:\s*([^\s>]+)""", re.I)
IN_TICK_PATH_RE = re.compile(r"""(?:commented on|in)\s+`([^`]+\.[A-Za-z0-9+]+)`""", re.I)
GAP_PREFIX = "__spar_gap_"


