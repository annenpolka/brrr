HELP = f"""spar {VERSION} — two review suggestions are a patch algebra

Usage:
  spar FILE                    pairwise compose a review stream
  spar A B                     compose patch A with patch B
  gh api repos/o/r/pulls/N/comments | spar
  spar --patch oracle.patch prod.patch
  spar --emit A B              print the composed unified diff
  spar --all-commits FILE      pairwise across original_commit_id (v0.1)
  spar --selftest

A and B are GitHub comment JSON/JSONL, markdown ```suggestion fences,
or unified diffs. The before-image of a GitHub comment is the commented
range of diff_hunk, not every + line.

spar does not occupy a tree. That is plea. The question is whether the
two patches commute, conflict, or one absorbs the other.

Statuses:
  COMMUTE   either order, same after-image (GitHub batch-safe)
  ABSORB    one suggestion already contains the other (drop the inner)
  ORDERED   only one order applies (chain)
  CONFLICT  same locus disagrees, or neither order applies

Exit: 0 COMMUTE/EQUAL/EMPTY, 1 ABSORB-nested/ORDERED, 2 CONFLICT, 3 error.
      --report-only forces 0.
"""


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="spar", add_help=False)
    p.add_argument("files", nargs="*")
    p.add_argument("--patch", action="store_true", help="treat files as unified diffs")
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--porcelain", action="store_true")
    p.add_argument("--explain", action="store_true")
    p.add_argument("--interesting", action="store_true")
    p.add_argument(
        "--all-commits",
        action="store_true",
        help="pairwise across original_commit_id (mixed-PR harvest)",
    )
    p.add_argument("--emit", action="store_true")
    p.add_argument("--report-only", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--help", "-h", action="store_true")
    p.add_argument("--version", action="store_true")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    ns = parse_args(argv if argv is not None else sys.argv[1:])
    if ns.help:
        sys.stdout.write(HELP)
        return 0
    if ns.version:
        print(VERSION)
        return 0
    if ns.selftest:
        return selftest()

    files = list(ns.files)
    if not files:
        files = ["-"]
    if len(files) > 2:
        print("spar: expected at most two inputs", file=sys.stderr)
        return EXIT_ERROR

    try:
        loaded: list[list[Suggest]] = []
        for f in files:
            if ns.patch and f != "-":
                text = Path(f).read_text(encoding="utf-8")
                loaded.append(parse_patch_suggests(text, source=f))
            elif ns.patch and f == "-":
                loaded.append(parse_patch_suggests(sys.stdin.read(), source="stdin"))
            else:
                loaded.append(load_path(f))
    except OSError as e:
        print(f"spar: {e}", file=sys.stderr)
        return EXIT_ERROR

    if any(x is None for x in loaded):
        return EXIT_ERROR
    if not any(loaded):
        print("spar: no suggestions", file=sys.stderr)
        return EXIT_ERROR

    right: list[Suggest] | None
    meta: dict = {"commits": 0, "skipped": 0, "singles": 0}
    if len(loaded) == 1:
        left = loaded[0]
        right = None
        status, pairs, meta = pairwise(left, all_commits=ns.all_commits)
        emit_src = (left[0], left[1]) if len(left) == 2 else None
    else:
        left, right = loaded[0], loaded[1]
        status, pairs = compose_patches(left, right)
        emit_src = (left[0], right[0]) if len(left) == 1 and len(right) == 1 else None

    if ns.emit:
        if emit_src is None:
            # patch-level: emit every left+right hunk that is not absorbed/conflicted
            if right is None:
                print("spar: --emit needs two suggestions or two patches", file=sys.stderr)
                return EXIT_ERROR
            if status == "CONFLICT":
                print("spar: CONFLICT; not emitting", file=sys.stderr)
                return EXIT_CONFLICT
            keep: list[Suggest] = []
            absorbed = {v.b if v.absorber == v.a else v.a for v in pairs if v.status == "ABSORB" and v.absorber not in (None, "*")}
            # When absorber is left id, drop right of that pair, etc.
            drop: set[str] = set()
            for v in pairs:
                if v.status == "ABSORB" and v.absorber and v.absorber != "*":
                    if v.absorber == v.a:
                        drop.add(v.b)
                    elif v.absorber == v.b:
                        drop.add(v.a)
            keep = [s for s in left + right if s.id not in drop]
            sys.stdout.write(emit_suggests(keep))
            return 0 if ns.report_only else status_exit(status, pairs)
        em = emit_pair(compose_pair(emit_src[0], emit_src[1]), emit_src[0], emit_src[1])
        if not em:
            print("spar: CONFLICT; not emitting", file=sys.stderr)
            return EXIT_CONFLICT
        sys.stdout.write(em)
        return 0 if ns.report_only else status_exit(status, pairs)

    if ns.json:
        sys.stdout.write(
            json.dumps(report_dict(status, pairs, left, right, meta), indent=2, ensure_ascii=False) + "\n"
        )
    elif ns.tsv:
        sys.stdout.write(format_tsv(pairs))
    elif ns.porcelain:
        sys.stdout.write(format_porcelain(status, pairs, meta))
    else:
        sys.stdout.write(format_human(status, pairs, ns.interesting, meta))
        if ns.explain:
            for s in left + (right or []):
                sys.stdout.write(
                    f"  claim  {s.id}  {s.path}:{s.start or '-'}  "
                    f"recon={s.recon}  before={len(s.before)} after={len(s.after)}\n"
                )

    if ns.report_only:
        return 0
    return status_exit(status, pairs)


if __name__ == "__main__":
    sys.exit(main())
