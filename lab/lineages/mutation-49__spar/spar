@dataclass
class Suggest:
    id: str
    path: str
    before: list[str]
    after: list[str]
    start: int | None = None
    end: int | None = None
    side: str = "RIGHT"
    commit_id: str | None = None
    original_commit_id: str | None = None
    in_reply_to: str | None = None
    recon: str = ""
    source: str = ""
    user: str | None = None
    body: str = ""

    @property
    def span(self) -> tuple[int | None, int | None]:
        if self.start is None:
            return None, None
        if self.before:
            end = self.start + len(self.before) - 1
        else:
            end = self.start - 1
        if self.end is not None:
            end = max(end, self.end) if self.before else self.end
        return self.start, end

    def as_dict(self) -> dict:
        return {
            "id": self.id,
            "path": self.path,
            "start": self.start,
            "end": self.end,
            "before": self.before,
            "after": self.after,
            "recon": self.recon,
            "original_commit_id": self.original_commit_id,
            "in_reply_to": self.in_reply_to,
            "user": self.user,
        }


@dataclass
class Verdict:
    status: str
    a: str
    b: str
    path: str
    note: str = ""
    order: str = ""          # "ab", "ba", "ab|ba"
    absorber: str | None = None
    batch: bool = False
    a_path: str = ""
    b_path: str = ""
    a_start: int | None = None
    b_start: int | None = None

    def as_dict(self) -> dict:
        return {
            "status": self.status,
            "a": self.a,
            "b": self.b,
            "path": self.path,
            "note": self.note,
            "order": self.order,
            "absorber": self.absorber,
            "batch": self.batch,
            "a_path": self.a_path,
            "b_path": self.b_path,
            "a_start": self.a_start,
            "b_start": self.b_start,
        }


# ---------------------------------------------------------------------------
# reconstruction (commented range, not sate-all-plus)
# ---------------------------------------------------------------------------

def _strip_cr(s: str) -> str:
    return s.replace("\r", "")


def _as_int(v) -> int | None:
    if v is None or v == "":
        return None
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _first(*vals):
    for v in vals:
        if v is not None and v != "":
            return v
    return None


def _as_lines(val) -> list[str] | None:
    if val is None:
        return None
    if isinstance(val, list):
        return [_strip_cr(str(x)).rstrip("\n") for x in val]
    if isinstance(val, str):
        return _strip_cr(val).splitlines()
    return None


def parse_diff_hunk(diff_hunk: str) -> tuple[int, int, list[tuple[str, str]]] | None:
    text = _strip_cr(diff_hunk)
    lines = text.splitlines()
    if not lines:
        return None
    header_i = 0
    while header_i < len(lines) and not lines[header_i].startswith("@@"):
        header_i += 1
    if header_i >= len(lines):
        return None
    m = HUNK_RE.match(lines[header_i])
    if not m:
        return None
    old_start = int(m.group(1))
    new_start = int(m.group(3))
    tagged: list[tuple[str, str]] = []
    for L in lines[header_i + 1 :]:
        if L.startswith("\\"):
            continue
        if not L:
            tagged.append((" ", ""))
            continue
        tag = L[0]
        if tag in " +-":
            tagged.append((tag, L[1:]))
        else:
            tagged.append((" ", L))
    return old_start, new_start, tagged


def _in_range(loc: int, start: int, end: int) -> bool:
    lo, hi = (start, end) if start <= end else (end, start)
    return lo <= loc <= hi


def lines_in_range(
    tagged: list[tuple[str, str]],
    old_start: int,
    new_start: int,
    side: str,
    start: int,
    end: int,
) -> list[str]:
    old_ln, new_ln = old_start, new_start
    out: list[str] = []
    right = side in ("RIGHT", "NEW", "+")
    for tag, text in tagged:
        if tag == "+":
            if right and _in_range(new_ln, start, end):
                out.append(text)
            new_ln += 1
        elif tag == "-":
            if not right and _in_range(old_ln, start, end):
                out.append(text)
            old_ln += 1
        else:
            loc = new_ln if right else old_ln
            if _in_range(loc, start, end):
                out.append(text)
            old_ln += 1
            new_ln += 1
    return out


def side_new_lines(tagged: list[tuple[str, str]], side: str) -> list[str]:
    if side in ("LEFT", "OLD", "-"):
        return [t for tag, t in tagged if tag in " -"]
    return [t for tag, t in tagged if tag in " +"]


def extract_suggestions(body: str) -> list[list[str]]:
    if not body:
        return []
    body = _strip_cr(body)
    out: list[list[str]] = []
    for m in SUGGEST_RE.finditer(body):
        raw = m.group(1)
        if raw.endswith("\n"):
            raw = raw[:-1]
        out.append(raw.splitlines())
    return out


def reconstruct_before(obj: dict) -> tuple[list[str], str, int | None, int | None]:
    explicit = _as_lines(obj.get("before"))
    if explicit is not None:
        start = _as_int(obj.get("start_line") or obj.get("original_start_line"))
        end = _as_int(obj.get("line") or obj.get("original_line"))
        return explicit, "explicit", start, end

    side = str(obj.get("side") or obj.get("start_side") or "RIGHT").upper()
    end = _as_int(_first(obj.get("line"), obj.get("original_line"), obj.get("originalLine")))
    start = _as_int(
        _first(
            obj.get("start_line"),
            obj.get("original_start_line"),
            obj.get("startLine"),
            obj.get("originalStartLine"),
            end,
        )
    )
    diff_hunk = obj.get("diff_hunk") or obj.get("diffHunk") or ""
    parsed = parse_diff_hunk(diff_hunk) if diff_hunk else None
    if parsed and start is not None and end is not None:
        old_start, new_start, tagged = parsed
        got = lines_in_range(tagged, old_start, new_start, side, start, end)
        if got:
            return got, "range", start, end
        n = max(1, abs(end - start) + 1)
        side_lines = side_new_lines(tagged, side)
        if side_lines:
            return side_lines[-n:], "hunk-tail", start, end
    if parsed:
        _old_start, _new_start, tagged = parsed
        side_lines = side_new_lines(tagged, side)
        if side_lines:
            return [side_lines[-1]], "hunk-last", start, end
    return [], "none", start, end


def _user_of(obj: dict) -> str | None:
    u = obj.get("user") or obj.get("author")
    if isinstance(u, dict):
        login = u.get("login") or u.get("name")
        return str(login) if login else None
    if u:
        return str(u)
    return None


def obj_to_suggests(obj: dict, source: str = "json") -> list[Suggest]:
    path = obj.get("path") or obj.get("filename") or obj.get("file") or ""
    if not path:
        return []
    cid = str(_first(obj.get("id"), obj.get("html_url"), obj.get("url"), path) or path)
    afters = _as_lines(obj.get("after"))
    body = obj.get("body") or obj.get("comment") or obj.get("suggestion") or ""
    sug = extract_suggestions(body) if isinstance(body, str) else []
    if afters is not None:
        images = [afters]
    elif sug:
        images = sug
    else:
        return []
    before, recon, start, end = reconstruct_before(obj)
    side = str(obj.get("side") or "RIGHT").upper()
    in_reply = obj.get("in_reply_to_id") or obj.get("in_reply_to")
    commit = obj.get("commit_id") or obj.get("commitId")
    orig = obj.get("original_commit_id") or obj.get("originalCommitId")
    user = _user_of(obj)
    out: list[Suggest] = []
    for i, after in enumerate(images):
        ident = cid if len(images) == 1 else f"{cid}#{i + 1}"
        out.append(
            Suggest(
                id=str(ident),
                path=str(path),
                before=list(before),
                after=list(after),
                start=start,
                end=end,
                side=side,
                commit_id=str(commit) if commit else None,
                original_commit_id=str(orig) if orig else None,
                in_reply_to=str(in_reply) if in_reply else None,
                recon=recon,
                source=source,
                user=user,
                body=body if isinstance(body, str) else "",
            )
        )
    return out


