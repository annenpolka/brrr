def _S(
    ident: str,
    path: str,
    before: list[str],
    after: list[str],
    start: int | None = None,
    commit: str | None = None,
) -> Suggest:
    end = None if start is None or not before else start + len(before) - 1
    return Suggest(
        id=ident,
        path=path,
        before=before,
        after=after,
        start=start,
        end=end,
        original_commit_id=commit,
        recon="test",
    )


def selftest() -> int:
    fails = 0
    passed = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal fails, passed
        if cond:
            passed += 1
            print(f"  PASS  {name}")
        else:
            fails += 1
            print(f"  FAIL  {name}" + (f"  {detail}" if detail else ""))

    # 1. disjoint files
    a = _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    b = _S("b", "lib.py", ["y = 1"], ["y = 2"], 1, "c0")
    v = compose_pair(a, b)
    check("disjoint-path COMMUTE", v.status == "COMMUTE" and v.batch, f"{v.status} {v.note}")

    # 2. disjoint ranges same file
    a = _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    b = _S("b", "app.py", ["y = 1"], ["y = 2"], 10, "c0")
    v = compose_pair(a, b)
    check("disjoint-range COMMUTE", v.status == "COMMUTE" and v.note in ("either-order", "disjoint-range"), f"{v.status} {v.note}")

    # 3. same locus disagreement
    a = _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    b = _S("b", "app.py", ["x = 1"], ["x = 3"], 1, "c0")
    v = compose_pair(a, b)
    check("same-range CONFLICT", v.status == "CONFLICT", f"{v.status} {v.note}")

    # 4. equal
    a = _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    b = _S("b", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    v = compose_pair(a, b)
    check("equal ABSORB batch", v.status == "ABSORB" and v.batch and v.note == "equal", f"{v.status} {v.note} batch={v.batch}")

    # 5. nested absorb: outer rewrite already has the inner fix
    outer = _S(
        "big",
        "app.py",
        ["def add(a, b):", "    return a + b", "    # todo"],
        ["def add(a, b):", "    return a + b + bias()", "    # todo"],
        1,
        "c0",
    )
    inner = _S("tiny", "app.py", ["    return a + b"], ["    return a + b + bias()"], 2, "c0")
    v = compose_pair(outer, inner)
    check("nested ABSORB", v.status == "ABSORB" and v.absorber == "big" and not v.batch, f"{v.status} {v.absorber} {v.note}")

    # 6. chain ORDERED
    a = _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    b = _S("b", "app.py", ["x = 2"], ["x = 3"], 1, "c0")
    v = compose_pair(a, b)
    check("chain ORDERED ab", v.status == "ORDERED" and v.order == "ab", f"{v.status} {v.order} {v.note}")

    # 7. empty suggestion = delete, disjoint
    a = _S("del", "doc.html", ["w"], [], 221, "c0")
    b = _S("typo", "doc.html", ["outside"], ["outside"], 218, "c0")
    # b is a no-op; use a real edit
    b = _S("typo", "doc.html", ['lies outwith your'], ['lies outside your'], 218, "c0")
    v = compose_pair(a, b)
    check("delete × neighbor COMMUTE", v.status == "COMMUTE", f"{v.status} {v.note}")

    # 8. overlapping context still COMMUTE (shared blank kept)
    a = _S(
        "prod",
        "lib.rs",
        ["pub fn add(a: i32, b: i32) -> i32 {", "    a + b", "}", ""],
        ["pub fn add(a: i32, b: i32) -> i32 {", "    a + b + bias()", "}", ""],
        1,
        "c0",
    )
    b = _S(
        "oracle",
        "lib.rs",
        ["", "#[cfg(test)]", "mod tests {", "    use super::*;", "}"],
        ["", "#[cfg(test)]", "mod tests {", "    use super::*;", "    #[test]", "    fn t() {}", "}"],
        4,
        "c0",
    )
    v = compose_pair(a, b)
    check("context-overlap COMMUTE", v.status == "COMMUTE", f"{v.status} {v.note} order={v.order}")

    # 9. unrelated commits, different befores → COMMUTE note
    a = _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    b = _S("b", "app.py", ["z = 9"], ["z = 8"], 1, "c1")
    v = compose_pair(a, b)
    check(
        "cross-commit COMMUTE not batch",
        v.status == "COMMUTE" and v.note == "unrelated-commit" and not v.batch,
        f"{v.status} {v.note} batch={v.batch}",
    )

    # 10. unicode path
    a = _S("a", "tests/加算.rs", ["fn 加算() {}"], ["fn 加算() { 1 }"], 1, "c0")
    b = _S("b", "src/lib.rs", ["fn add() {}"], ["fn add() { 2 }"], 1, "c0")
    v = compose_pair(a, b)
    check("unicode disjoint COMMUTE", v.status == "COMMUTE", v.status)

    # 11. GitHub body reconstruction: range, not all-plus
    obj = {
        "id": 1,
        "path": "command/pr.go",
        "side": "RIGHT",
        "original_line": 347,
        "diff_hunk": (
            "@@ -339,7 +342,11 @@ func show(number ...string) error {\n"
            " func pullRequestForCurrentBranch() (*github.PullRequest, error) {\n"
            " \tproject := project()\n"
            " \tclient := github.NewClient(project.Host)\n"
            "-\theadWithOwner := fmt.Sprintf(\"%s:%s\", project.Owner, currentBranch())\n"
            "+\tcurrentBranch, err := context.CurrentBranch()\n"
            "+\tif err != nil {\n"
            "+\t\treturn &github.PullRequest{}, err"
        ),
        "body": "```suggestion\r\n\t\treturn nil, err\r\n```",
    }
    ss = obj_to_suggests(obj)
    check("recon one claim", len(ss) == 1, str(len(ss)))
    if ss:
        check(
            "recon is commented line not all-plus",
            ss[0].before == ["\t\treturn &github.PullRequest{}, err"],
            str(ss[0].before),
        )
        check("recon after", ss[0].after == ["\t\treturn nil, err"], str(ss[0].after))
        check("recon method range", ss[0].recon == "range", ss[0].recon)

    # 12. empty fence = delete
    obj = {
        "id": 2,
        "path": "doc/code.html",
        "original_line": 221,
        "diff_hunk": "@@ -1,1 +1,1 @@\n+w",
        "body": "```suggestion\r\n```",
    }
    ss = obj_to_suggests(obj)
    check("empty suggestion is delete", bool(ss) and ss[0].after == [] and ss[0].before == ["w"], str(ss[0].after if ss else None))

    # 13. markdown stream
    md = (
        "# src/add.py:2\n\n```\n    return a - b\n```\n"
        "```suggestion\n    return a + b\n```\n"
    )
    md_s = parse_markdown_stream(md)
    check("markdown parse", len(md_s) == 1 and md_s[0].after == ["    return a + b"], str(md_s))

    # 14. unified diff hunks
    patch = (
        "diff --git a/app.py b/app.py\n--- a/app.py\n+++ b/app.py\n"
        "@@ -1,2 +1,2 @@\n def add(a, b):\n-    return a + b\n+    return a + b + bias()\n"
        "diff --git a/tests/test_add.py b/tests/test_add.py\n"
        "--- a/tests/test_add.py\n+++ b/tests/test_add.py\n"
        "@@ -1,2 +1,2 @@\n def test_add():\n-    assert add(1,1)==2\n+    assert add(1,1)==2 + bias()\n"
    )
    ps = parse_patch_suggests(patch)
    check("patch two hunks", len(ps) == 2, str(len(ps)))
    if len(ps) == 2:
        v = compose_pair(ps[0], ps[1])
        check("oracle×prod COMMUTE", v.status == "COMMUTE" and v.note == "disjoint-path", f"{v.status} {v.note}")

    # 15. emit commute concatenates
    a = _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0")
    b = _S("b", "app.py", ["y = 1"], ["y = 2"], 10, "c0")
    v = compose_pair(a, b)
    em = emit_pair(v, a, b)
    check(
        "emit has both hunks",
        em.count("\n@@ ") == 2 and "-x = 1" in em and "-y = 1" in em,
        em,
    )

    # 16. jsonl load
    raw = '{"path":"mod.py","before":["TIMEOUT = 30"],"after":["TIMEOUT = 60"],"id":"r1","start_line":1,"line":1}\n{"path":"mod.py","before":["retries = 3"],"after":["retries = 5"],"id":"r2","start_line":2,"line":2}\n'
    loaded = load_stream(raw, "jsonl")
    check("jsonl two", len(loaded) == 2, str(len(loaded)))
    if len(loaded) == 2:
        v = compose_pair(loaded[0], loaded[1])
        check("jsonl COMMUTE", v.status == "COMMUTE", f"{v.status} {v.note}")

    # 17. zip multiline drop-blank (start_line–line)
    zobj = {
        "id": 720912639,
        "path": "src/archive/zip/reader.go",
        "side": "RIGHT",
        "original_line": 792,
        "original_start_line": 791,
        "diff_hunk": (
            "@@ -789,6 +788,8 @@ func (r *Reader) Open(name string) (fs.File, error) {\n"
            " \tif e.isDir {\n"
            " \t\treturn &openDir{e, r.openReadDir(name), 0}, nil\n"
            " \t}\n"
            "+\n"
            "+\te.file.readDataDescriptor()"
        ),
        "body": "```suggestion\r\n\te.file.readDataDescriptor()\r\n```",
    }
    zs = obj_to_suggests(zobj)
    check(
        "zip range is two lines",
        bool(zs) and zs[0].before == ["", "\te.file.readDataDescriptor()"] and zs[0].after == ["\te.file.readDataDescriptor()"],
        str(zs[0].before if zs else None),
    )

    # 18. pairwise worst
    st, pairs, _meta = pairwise(
        [
            _S("a", "a.py", ["1"], ["2"], 1, "c"),
            _S("b", "b.py", ["1"], ["2"], 1, "c"),
            _S("c", "a.py", ["1"], ["9"], 1, "c"),
        ]
    )
    check("pairwise worst CONFLICT", st == "CONFLICT", st)
    check("pairwise 3", len(pairs) == 3, str(len(pairs)))

    # 19. v0.2: default pairwise stays inside original_commit_id
    grouped = [
        _S("a", "app.py", ["x = 1"], ["x = 2"], 1, "c0"),
        _S("b", "app.py", ["y = 1"], ["y = 2"], 10, "c0"),
        _S("c", "app.py", ["z = 1"], ["z = 9"], 1, "c1"),
    ]
    st, pairs, meta = pairwise(grouped)
    check("same-commit only one pair", len(pairs) == 1, str(len(pairs)))
    check("skipped cross-commit", meta["skipped"] == 2, str(meta))
    check("grouped COMMUTE", st == "COMMUTE" and pairs[0].note == "either-order", f"{st} {pairs[0].note if pairs else None}")
    st, pairs, meta = pairwise(grouped, all_commits=True)
    check("all-commits restores 3", len(pairs) == 3 and meta["skipped"] == 0, str(len(pairs)))
    check("cross-commit not batch", any(p.note == "unrelated-commit" and not p.batch for p in pairs), str([(p.note, p.batch) for p in pairs]))

    # 20. jsonl without commit ids still pair (empty key)
    naked = [
        _S("r1", "mod.py", ["TIMEOUT = 30"], ["TIMEOUT = 60"], 1, None),
        _S("r2", "mod.py", ["retries = 3"], ["retries = 5"], 2, None),
    ]
    st, pairs, meta = pairwise(naked)
    check("missing-commit still COMMUTE", st == "COMMUTE" and len(pairs) == 1, f"{st} {len(pairs)}")

    print(f"selftest: {passed} passed, {fails} failed")
    return 0 if fails == 0 else 1


