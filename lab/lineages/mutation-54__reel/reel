#!/usr/bin/env python3
"""reel — a mixed commit as a format-patch mailbox of name-closed acts.

A mixed commit is a coil. git format-patch needs already-split commits.
canto reported the plot. reel *emits* it: one git-am patch per name-closed
act. Default stdout is a mailbox, not a report. ASIDE acts trail so a
blank-line sibling does not interrupt PRELUDE → PAYOFF.

A name is a plot point if this diff defines it; an act is a name-closed
set of files; later acts may use earlier defs, never the reverse.

Kinds: PRELUDE (defs later acts use) · PAYOFF (uses earlier defs) ·
SOLO (closed, nobody else cites) · ASIDE (no plot names) · CYCLE
(mutual defs) · SPOIL (prod + test in one strongly-connected piece).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from collections import defaultdict, deque
from dataclasses import dataclass, field
from typing import Any

VERSION = "0.2"

HELP = f"""reel {VERSION} — mixed commit as format-patch acts (name-closed)

Usage:
  reel [-C REPO] [FROM [TO]]            # mailbox on stdout (git am)
  reel [-C REPO] COMMIT                 # COMMIT^ vs COMMIT
  reel [-C REPO] -o DIR [FROM [TO]]     # 0001-*.patch files (format-patch -o)
  reel --report [-C REPO] COMMIT        # porcelain plot (opt-in)
  git diff A B | reel --stdin --report
  reel --selftest

Default range: dirty worktree vs HEAD, else HEAD^ HEAD.
Default grain: file (what a patch series can name).
Default output: git-am mailbox, not a report.

  --report              porcelain plot (canto's default; here opt-in)
  --format porcelain|json|tsv|mbox
  --json                shortcut for --format json
  --check               exit 1 if SPOIL or TANGLE (report, no mailbox)
  -o, --output, --split DIR   write 000N-kind-file.patch
  --stdout              mailbox on stdout (default when no -o)
  --verify              git am the series on FROM; tree must equal TO
  --cover               0000-cover-letter.patch (plot as the letter)
  --aside last|inline   emit order for ASIDE acts (default last)
  --against             score acts vs original commits in FROM..TO
  --grain hunk|file     file is emit; hunk is --report only
  --max-names N         names shown per act (default 8)
  --stdin               read a unified diff (report/check; emit needs git)

Exit: 0 ok, 1 --check failed or --verify miss, 2 usage/error.
"""

IDENT_RE = re.compile(r"\b[A-Za-z_][A-Za-z0-9_]*\b")

# Defs that mint a plot point. Keep tight: uses only count if they hit this set.
DEF_RES = [
    re.compile(
        r"^\s*(?:pub(?:\([^)]*\))?\s+|export\s+|public\s+|private\s+|internal\s+"
        r"|open\s+|static\s+|async\s+|override\s+|fileprivate\s+|package\s+"
        r"|final\s+|required\s+|convenience\s+|lazy\s+|weak\s+|unowned\s+"
        r"|nonisolated\s+|mutating\s+|borrowing\s+|consuming\s+)*"
        r"(?:class|struct|enum|trait|interface|protocol|type|typedef|record|"
        r"fn|func|def|mod|extension|actor|macro_rules!)\s+"
        r"(?:[\w.:<>]+\s+for\s+)?"
        r"([A-Za-z_][A-Za-z0-9_]*)"
    ),
    re.compile(
        r"\b(?:class|struct|enum|trait|interface|protocol|actor|extension)\s+"
        r"([A-Za-z_][A-Za-z0-9_]*)"
    ),
    re.compile(
        r"^\s*(?:pub(?:\([^)]*\))?\s+|export\s+|public\s+|private\s+|final\s+)?"
        r"(?:async\s+)?(?:fn|func|def)\s+([A-Za-z_][A-Za-z0-9_]*)"
    ),
    re.compile(
        r"^\s*(?:pub(?:\([^)]*\))?\s+)?impl(?:\s*<[^>]*>)?\s+"
        r"(?:[\w.:<>]+\s+for\s+)?([A-Za-z_][A-Za-z0-9_]*)"
    ),
    re.compile(
        r"^\s*(?:export\s+)?(?:const|let|var|val)\s+(?:mut\s+)?"
        r"([A-Za-z_][A-Za-z0-9_]*)"
    ),
    re.compile(r"^\s*([A-Z][A-Z0-9_]{2,})\s*="),  # CONST =
    re.compile(r"#\[test\]\s*(?:async\s+)?fn\s+([A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"@(?:Test|test|pytest\.mark\.\w+)\s*\n\s*(?:async\s+)?def\s+([A-Za-z_][A-Za-z0-9_]*)"),
]

# Field `name: Type` is too noisy (content/status/source). Natal `let x` still
# hits the const/let/var rule. Keep a tight Swift stored-property form only.
FIELD_RE = re.compile(
    r"^\s*(?:public\s+|private\s+|internal\s+|fileprivate\s+|open\s+|package\s+)?"
    r"(?:let|var)\s+([A-Za-z_][A-Za-z0-9_]*)\s*:"
)

IMPL_FOR_RE = re.compile(
    r"\bimpl(?:\s*<[^>]*>)?\s+(?:[\w.:<>]+\s+for\s+)?([A-Za-z_][A-Za-z0-9_]*)"
)

MOD_RE = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_][A-Za-z0-9_]*)")

