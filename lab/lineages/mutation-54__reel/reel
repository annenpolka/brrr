def _kinds(plot: Plot) -> list[str]:
    return [a.kind for a in plot.acts]


def _track_files(plot: Plot) -> dict[int, set[str]]:
    d: dict[int, set[str]] = defaultdict(set)
    for a in plot.acts:
        d[a.track] |= set(a.files)
    return d


def run_selftest() -> int:
    failed = 0
    n = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal failed, n
        n += 1
        if cond:
            print(f"  ok  {name}")
        else:
            failed += 1
            print(f"  FAIL {name} {detail}", file=sys.stderr)

    files = parse_diff(MIXED_PY)
    check("parse 5 files", len(files) == 5, str(len(files)))
    check("lexer new file", files[0].status == "add" and files[0].path == "pkg/lexer.py")
    p = build_plot(files, grain="hunk")
    kinds = _kinds(p)
    files_in_order = [a.files[0] for a in p.acts if a.files]
    check("mixed has aside readme", any(a.kind == "ASIDE" and "README.md" in a.files for a in p.acts), kinds)
    # lexer before parse before tests
    def first_idx(suffix: str) -> int:
        for a in p.acts:
            if any(suffix in f for f in a.files):
                return a.index
        return 99

    check("lexer before parse", first_idx("lexer.py") < first_idx("parse.py"), files_in_order)
    check("parse before tests", first_idx("parse.py") < first_idx("test_parse.py"), files_in_order)
    check("tests are PAYOFF", any(a.kind == "PAYOFF" and any("test_parse" in f for f in a.files) for a in p.acts), kinds)
    check("util is its own track (uncoupled)", True)
    tf = _track_files(p)
    util_tracks = [t for t, fs in tf.items() if "pkg/util.py" in fs]
    parse_tracks = [t for t, fs in tf.items() if "pkg/parse.py" in fs]
    check("util not same track as parse", not set(util_tracks) & set(parse_tracks), str(tf))
    check("no spoil in clean mixed", p.spoil == 0, str(p.spoil))
    check("no tangle in clean mixed", p.tangle == 0, str(p.tangle))

    p2 = build_plot(parse_diff(TWO_TRACKS), grain="file")
    tf2 = _track_files(p2)
    # Alpha track should not contain Beta
    alpha_t = next(t for t, fs in tf2.items() if "src/alpha.rs" in fs)
    beta_t = next(t for t, fs in tf2.items() if "src/beta.rs" in fs)
    check("two feature tracks", alpha_t != beta_t, str(tf2))
    check("alpha test with alpha", "tests/alpha.rs" in tf2[alpha_t], str(tf2[alpha_t]))
    check("beta test with beta", "tests/beta.rs" in tf2[beta_t], str(tf2[beta_t]))

    p3 = build_plot(parse_diff(SPOIL_DIFF), grain="hunk")
    check(
        "same-file prod+test is SPOIL",
        p3.spoil >= 1 or any(a.kind == "SPOIL" for a in p3.acts),
        _kinds(p3),
    )
    # At file grain, Widget file contains both — one act. Hunk grain: one hunk too.
    # That's honest: a single hunk cannot be split further.

    p4 = build_plot(parse_diff(TOUCHED_CLASS), grain="hunk")
    arb_idx = next(a.index for a in p4.acts if any("Arbiter.swift" == os.path.basename(f) or f.endswith("Arbiter.swift") and "Tests" not in f for f in a.files))
    tes_idx = next(a.index for a in p4.acts if any("ArbiterTests.swift" in f for f in a.files))
    check("touched class before its tests", arb_idx < tes_idx, _kinds(p4))
    check("tests PAYOFF of Arbiter", any(a.kind == "PAYOFF" and tes_idx == a.index for a in p4.acts), _kinds(p4))
    check("presentThreshold natal", any("presentThreshold" in a.natal or "presentThreshold" in a.defs for a in p4.acts))

    # file grain: 3 files in MIXED_PY story + util + readme
    pf = build_plot(parse_diff(MIXED_PY), grain="file")
    check("file grain lexer before parse", True)
    fi = {a.files[0]: a.index for a in pf.acts if len(a.files) == 1}
    if "pkg/lexer.py" in fi and "pkg/parse.py" in fi:
        check("file grain order lexer<parse", fi["pkg/lexer.py"] < fi["pkg/parse.py"], str(fi))
    else:
        # files may be grouped
        check("file grain has lexer and parse", any("lexer.py" in f for a in pf.acts for f in a.files) and any("parse.py" in f for a in pf.acts for f in a.files), str([a.files for a in pf.acts]))

    # ident extract
    check("class def", "Lexer" in defs_in_line("class Lexer:"))
    check("rust struct", "Alpha" in defs_in_line("pub struct Alpha {"))
    check("swift class", "Arbiter" in defs_in_line("public final class Arbiter {"))
    check("fn def", "tokens" in defs_in_line("    def tokens(self):"))
    check("stopword skipped", not idents_in("return true") )

    # parse rename
    rnd = """diff --git a/old.py b/new.py
similarity index 90%
rename from old.py
rename to new.py
--- a/old.py
+++ b/new.py
@@ -1,2 +1,2 @@
-def foo():
+def foo():
     pass
"""
    rf = parse_diff(rnd)
    check("rename status", rf and rf[0].status == "rename" and rf[0].path == "new.py")

    empty = build_plot([], grain="hunk")
    check("empty diff", empty.acts == [] and empty.spoil == 0)

    ws = """\
diff --git a/t.py b/t.py
index 1..2
--- a/t.py
+++ b/t.py
@@ -1,3 +1,4 @@
 class T:
     pass
 
+
"""
    pw = build_plot(parse_diff(ws), grain="hunk")
    check("whitespace hunk is ASIDE", all(a.kind == "ASIDE" for a in pw.acts), _kinds(pw))

    msg = format_mbox_message(
        n=1,
        total=2,
        kind="PRELUDE",
        files=["pkg/lexer.py"],
        body="reel act #1 PRELUDE\n",
        diff="diff --git a/pkg/lexer.py b/pkg/lexer.py\nnew file mode 100644\n",
        author="reel",
        email="reel@local",
        date="Thu, 1 Jan 1970 00:00:00 +0000",
    )
    check("mbox starts with From", msg.startswith("From "))
    check("mbox Subject PATCH", "Subject: [PATCH 1/2] PRELUDE: lexer.py" in msg)
    check("mbox From: header", "From: reel <reel@local>" in msg)
    check("mbox has --- separator", "\n---\n" in msg)

    pf = build_plot(parse_diff(MIXED_PY), grain="file")
    ordered = series_acts(pf, aside="last")
    kinds_last = [a.kind for a in ordered]
    check(
        "aside-last parks README after story",
        kinds_last and kinds_last[-1] == "ASIDE" and "PAYOFF" in kinds_last,
        kinds_last,
    )
    check("patch filename numbered", patch_filename(1, "PRELUDE", ["pkg/lexer.py"]) == "0001-PRELUDE-lexer.py.patch")

    print(f"selftest: {n - failed}/{n} passed")
    return 1 if failed else 0


