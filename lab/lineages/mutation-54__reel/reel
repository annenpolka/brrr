def resolve_range(repo: str, args: list[str]) -> tuple[str, str]:
    if len(args) >= 2:
        return args[0], args[1]
    if len(args) == 1:
        rev = args[0]
        if git_ok(repo, "rev-parse", "--verify", f"{rev}^"):
            return f"{rev}^", rev
        return rev, rev
    if is_dirty(repo):
        return "HEAD", ":worktree"
    if git_ok(repo, "rev-parse", "--verify", "HEAD^"):
        return "HEAD^", "HEAD"
    return "HEAD", "HEAD"


def get_diff(repo: str, frm: str, to: str) -> str:
    if to == ":worktree":
        # staged + unstaged + untracked as diff vs frm
        return git(repo, "diff", "--binary", "--no-color", "-U3", frm)
    return git(repo, "diff", "--binary", "--no-color", "-U3", frm, to)


def load_blobs(repo: str, to: str, files: list[FileChange]) -> dict[str, str]:
    out: dict[str, str] = {}
    if to == ":worktree":
        root = repo
        for fc in files:
            p = os.path.join(root, fc.path)
            if os.path.isfile(p):
                try:
                    with open(p, encoding="utf-8", errors="replace") as f:
                        out[fc.path] = f.read()
                except OSError:
                    pass
        return out
    for fc in files:
        body = git_show(repo, to, fc.path)
        if body is not None:
            out[fc.path] = body
    return out


