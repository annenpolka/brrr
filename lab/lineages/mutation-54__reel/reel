# diff parse
# ---------------------------------------------------------------------------

@dataclass
class Hunk:
    old_start: int
    old_count: int
    new_start: int
    new_count: int
    section: str
    lines: list[tuple[str, str]] = field(default_factory=list)

    def text(self) -> str:
        out = []
        for k, t in self.lines:
            out.append(k + t)
        return "\n".join(out)

    def added(self) -> list[str]:
        return [t for k, t in self.lines if k == "+"]

    def removed(self) -> list[str]:
        return [t for k, t in self.lines if k == "-"]

    def context(self) -> list[str]:
        return [t for k, t in self.lines if k == " "]


@dataclass
class FileChange:
    path: str
    old_path: str
    status: str
    hunks: list[Hunk] = field(default_factory=list)
    is_binary: bool = False


HUNK_HDR = re.compile(
    r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@(.*)$"
)


def parse_diff(text: str) -> list[FileChange]:
    files: list[FileChange] = []
    cur: FileChange | None = None
    hunk: Hunk | None = None
    pending_old = None
    pending_new = None
    for raw in text.splitlines():
        if raw.startswith("diff --git "):
            if cur is not None:
                files.append(cur)
            parts = raw.split()
            a = parts[2][2:] if len(parts) > 2 and parts[2].startswith("a/") else (parts[2] if len(parts) > 2 else "")
            b = parts[3][2:] if len(parts) > 3 and parts[3].startswith("b/") else (parts[3] if len(parts) > 3 else a)
            cur = FileChange(path=norm_path(b or a), old_path=norm_path(a or b), status="modify")
            hunk = None
            pending_old = pending_new = None
            continue
        if cur is None:
            continue
        if raw.startswith("new file mode"):
            cur.status = "add"
        elif raw.startswith("deleted file mode"):
            cur.status = "delete"
        elif raw.startswith("rename from "):
            cur.status = "rename"
            cur.old_path = norm_path(raw[len("rename from ") :])
        elif raw.startswith("rename to "):
            cur.path = norm_path(raw[len("rename to ") :])
        elif raw.startswith("Binary files") or raw.startswith("GIT binary patch"):
            cur.is_binary = True
        elif raw.startswith("--- "):
            rest = raw[4:]
            if rest.startswith("a/"):
                pending_old = rest[2:]
            elif rest == "/dev/null":
                pending_old = None
                cur.status = "add" if cur.status == "modify" else cur.status
        elif raw.startswith("+++ "):
            rest = raw[4:]
            if rest.startswith("b/"):
                pending_new = rest[2:]
                cur.path = norm_path(pending_new)
            elif rest == "/dev/null":
                cur.status = "delete"
            if pending_old:
                cur.old_path = norm_path(pending_old)
        elif raw.startswith("@@ "):
            m = HUNK_HDR.match(raw)
            if not m:
                continue
            hunk = Hunk(
                old_start=int(m.group(1)),
                old_count=int(m.group(2) or "1"),
                new_start=int(m.group(3)),
                new_count=int(m.group(4) or "1"),
                section=(m.group(5) or "").strip(),
            )
            cur.hunks.append(hunk)
        elif hunk is not None:
            if raw.startswith("\\"):
                continue
            if raw.startswith("+") or raw.startswith("-") or raw.startswith(" "):
                hunk.lines.append((raw[0], raw[1:]))
            elif raw == "":
                hunk.lines.append((" ", ""))
    if cur is not None:
        files.append(cur)
    return files


