def plot_from_diff(
    text: str,
    grain: str,
    repo: str | None = None,
    to: str | None = None,
) -> Plot:
    files = parse_diff(text)
    blobs = {}
    if repo and to:
        blobs = load_blobs(repo, to, files)
    return build_plot(files, grain=grain, blobs=blobs)


def _want_report(args: argparse.Namespace) -> bool:
    if args.check or args.report or args.against or args.json:
        return True
    if args.format in {"porcelain", "json", "tsv"}:
        return True
    return False


def _print_report(plot: Plot, args: argparse.Namespace) -> None:
    if args.format == "json" or args.json:
        print(json.dumps(plot.to_json(), indent=2))
    elif args.format == "tsv":
        sys.stdout.write(format_tsv(plot))
    else:
        sys.stdout.write(format_porcelain(plot, args.max_names))


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--help" in argv or "-h" in argv:
        print(HELP, end="")
        return 0
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("-C", dest="repo", default=None)
    p.add_argument("--grain", choices=("hunk", "file"), default="file")
    p.add_argument("--format", choices=("mbox", "porcelain", "json", "tsv"), default="mbox")
    p.add_argument("--json", action="store_true")
    p.add_argument("--report", action="store_true")
    p.add_argument("--check", action="store_true")
    p.add_argument("-o", "--output", "--split", dest="split", metavar="DIR", default=None)
    p.add_argument("--stdout", action="store_true")
    p.add_argument("--verify", action="store_true")
    p.add_argument("--cover", action="store_true")
    p.add_argument("--aside", choices=("inline", "last"), default="last")
    p.add_argument("--against", action="store_true")
    p.add_argument("--stdin", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--max-names", type=int, default=8)
    p.add_argument("range", nargs="*")
    try:
        args = p.parse_args(argv)
    except SystemExit:
        return 2
    if args.selftest:
        return run_selftest()
    if args.json:
        args.format = "json"
    if args.report and args.format == "mbox":
        args.format = "porcelain"

    if args.stdin:
        text = sys.stdin.read()
        grain = args.grain
        plot = plot_from_diff(text, grain)
        # stdin has no git blobs to format-patch against; report/check only
        if args.format == "mbox" and not args.check and not args.report:
            print("reel: --stdin cannot emit a mailbox; pass --report or --check", file=sys.stderr)
            return 2
        _print_report(plot, args)
        if args.check and (plot.spoil or plot.tangle):
            return 1
        return 0

    repo = args.repo or os.getcwd()
    root = repo_root(repo)
    if not root:
        print("reel: not a git repository", file=sys.stderr)
        return 2
    repo = root
    try:
        frm, to = resolve_range(repo, args.range)
        text = get_diff(repo, frm, to)
    except RuntimeError as e:
        print(f"reel: {e}", file=sys.stderr)
        return 2
    emit = not _want_report(args) or args.split or args.stdout or args.verify
    grain = "file" if (emit and not _want_report(args)) else args.grain
    if args.split or args.stdout or args.verify:
        grain = "file"
    plot = plot_from_diff(text, grain, repo=repo, to=to if to != ":worktree" else ":worktree")
    plot.from_rev = frm
    plot.to_rev = to
    files = parse_diff(text)
    attach_stragglers(plot, files)

    if _want_report(args) and not (args.split or args.stdout or args.verify):
        _print_report(plot, args)
        if args.against:
            info = against_log(plot, repo, frm, to)
            print("against")
            print(f"  commits={info.get('commits')} acts={info.get('acts')} mean_jaccard={info.get('mean_jaccard')}")
            for m in info.get("matches", []):
                print(
                    f"  {m.get('sha')}  act={m.get('act')} j={m.get('jaccard')}  {m.get('subject')}"
                )
        if args.check and (plot.spoil or plot.tangle):
            return 1
        return 0

    if to == ":worktree":
        print("reel: emit needs a commit TO, not a dirty worktree (use --report)", file=sys.stderr)
        return 2
    try:
        items = collect_series(
            plot, repo, frm, to, aside=args.aside, max_names=args.max_names
        )
    except RuntimeError as e:
        print(f"reel: {e}", file=sys.stderr)
        return 2
    dest = args.split
    if dest is None and args.verify:
        import tempfile

        dest = tempfile.mkdtemp(prefix="reel-mbox-")
    cover = None
    if args.cover:
        if dest is None:
            print("reel: --cover needs -o DIR", file=sys.stderr)
            return 2
        author, email, date = commit_ident(repo, to)
        cover = cover_letter(plot, len(items), frm, to, author, email, date)
    written = write_series(items, dest, cover=cover)
    if dest is not None:
        print(f"reel {len(items)} patches → {dest}", file=sys.stderr)
    if args.verify:
        ok = apply_split_verify(repo, frm, to, written)
        print("verify " + ("ok" if ok else "FAIL"), file=sys.stderr)
        if not ok:
            return 1
    if args.check and (plot.spoil or plot.tangle):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
