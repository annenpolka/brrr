TEST_DIR = re.compile(
    r"(^|/)(tests?|spec|__tests__|testdata|fixtures|testcases|golden|oracles?|benches)(/|$)",
    re.I,
)
TEST_FILE = re.compile(r"(_test|\.test|\.spec|_spec|Tests?)\.")
DOC_EXT = {".md", ".rst", ".txt", ".adoc", ".org"}
DOC_BASE = {"readme", "changelog", "license", "authors", "copying", "notice"}
LOCK_RE = re.compile(
    r"(^|/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|Cargo\.lock|go\.sum|Podfile\.lock)$"
)
CONFIG_EXT = {".json", ".yml", ".yaml", ".toml", ".ini", ".cfg", ".lock"}
SRC_EXT = {
    ".py", ".rs", ".swift", ".go", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs",
    ".c", ".h", ".cc", ".cpp", ".hpp", ".m", ".mm", ".java", ".kt", ".rb",
    ".cs", ".scala", ".hs", ".ml", ".zig", ".nim", ".php", ".lua", ".r",
}

ROLE_RANK = {"prod": 0, "mixed": 0, "test": 1, "config": 2, "doc": 3, "other": 4}


def norm_path(p: str) -> str:
    return p.replace("\\", "/").lstrip("./")


def path_role(path: str) -> str:
    p = norm_path(path)
    b = p.rsplit("/", 1)[-1]
    stem, ext = os.path.splitext(b)
    low = b.lower()
    if LOCK_RE.search(p):
        return "config"
    if TEST_DIR.search(p) or TEST_FILE.search(b):
        return "test"
    if ext.lower() in DOC_EXT or stem.lower() in DOC_BASE:
        return "doc"
    if low in {"makefile", "dockerfile", "gemfile", "rakefile"}:
        return "config"
    if ext.lower() in CONFIG_EXT:
        return "config"
    if ext.lower() in SRC_EXT:
        return "prod"
    if "/docs/" in f"/{p}/" or "/plans/" in f"/{p}/" or "/adr/" in f"/{p}/":
        return "doc"
    return "other"


_TEST_DEF = re.compile(
    r"(?:^|\n)[^\n]*\b(?:def test_|func test[A-Z]|fn test_|#\[test\]|@Test\b)",
    re.M,
)
_PROD_DEF = re.compile(
    r"(?:^|\n)[^\n]*\b(?:class|struct|enum|trait|interface|protocol|actor)\s+[A-Z]",
    re.M,
)


def hunk_is_mixed(path: str, hunk_text: str) -> bool:
    del path
    body = hunk_text
    return bool(_TEST_DEF.search(body)) and bool(_PROD_DEF.search(body))


def hunk_role(path: str, hunk_text: str) -> str:
    """A src file can still host tests (#[test], #[cfg(test)], @Test)."""
    base = path_role(path)
    if hunk_is_mixed(path, hunk_text):
        return "mixed"
    if base != "prod":
        return base
    if re.search(r"#\[cfg\(test\)\]|#\[test\]|@Test\b|func test[A-Z]|def test_", hunk_text):
        added = [ln for ln in hunk_text.splitlines() if ln.startswith("+") and not ln.startswith("+++")]
        if not added:
            return base
        testish = 0
        for ln in added:
            if re.search(r"#\[test\]|#\[cfg\(test\)\]|@Test\b|func test[A-Z]|def test_|#expect\(|assert", ln):
                testish += 1
        if testish >= max(1, len(added) // 4):
            return "test"
    return base


def strip_noise(line: str) -> str:
    s = re.sub(r"//.*?$", "", line)
    s = re.sub(r"#(?![\[\w]).*?$", "", s)  # keep #[attr] and preprocessor-ish
    s = re.sub(r"/\*.*?\*/", "", s)
    s = re.sub(r'"(?:\\.|[^"\\])*"', '""', s)
    s = re.sub(r"'(?:\\.|[^'\\])*'", "''", s)
    return s


def defs_in_line(line: str) -> set[str]:
    out: set[str] = set()
    raw = line.rstrip("\n")
    for rx in DEF_RES:
        m = rx.search(raw)
        if m:
            out.add(m.group(1))
    for m in FIELD_RE.finditer(raw):
        name = m.group(1)
        if name[0].islower() or name[0].isupper():
            if name not in STOP and len(name) >= 3:
                out.add(name)
    for m in IMPL_FOR_RE.finditer(raw):
        out.add(m.group(1))
    for m in MOD_RE.finditer(raw):
        out.add(m.group(1))
    return {n for n in out if n not in STOP and len(n) >= 2 and not n.startswith("__")}


def idents_in(line: str) -> set[str]:
    return {
        m.group(0)
        for m in IDENT_RE.finditer(strip_noise(line))
        if m.group(0) not in STOP and len(m.group(0)) >= 3 and not m.group(0).startswith("__")
    }


def enclosing_defs(src: str | None, line_no: int) -> set[str]:
    """Defs whose body likely contains 1-indexed line_no, by indent/brace guess."""
    if not src or line_no <= 1:
        return set()
    lines = src.splitlines()
    idx = min(max(line_no - 1, 0), len(lines))
    stack: list[tuple[int, str]] = []
    for i, ln in enumerate(lines[:idx]):
        indent = len(ln) - len(ln.lstrip(" \t"))
        names = defs_in_line(ln)
        while stack and stack[-1][0] >= indent and not ln.strip().startswith("{"):
            # pop only on strict outdent
            if stack[-1][0] > indent:
                stack.pop()
            else:
                break
        for n in names:
            stack.append((indent, n))
    return {n for _, n in stack[-4:]}


