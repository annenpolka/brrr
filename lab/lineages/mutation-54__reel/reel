@dataclass
class Node:
    nid: str
    path: str
    hunk_i: int
    role: str
    defs: set[str]
    uses: set[str]
    natal: set[str]
    file: FileChange
    hunk: Hunk | None


def _typeish(name: str) -> bool:
    return bool(name) and name[0].isupper() and name not in STOP


def extract_hunk_names(h: Hunk, path: str, blob: str | None) -> tuple[set[str], set[str], set[str]]:
    """Plot points = natal ∪ touched ∪ enclosing types. Context-only defs are not plot points."""
    role = path_role(path)
    if role in {"doc", "config"}:
        return set(), set(), set()
    minus_defs: set[str] = set()
    plus_defs: set[str] = set()
    uses: set[str] = set()
    enc: set[str] = set()
    if h.section:
        enc |= {n for n in defs_in_line(h.section) if _typeish(n)}
        enc |= {
            m.group(0)
            for m in IDENT_RE.finditer(h.section)
            if _typeish(m.group(0))
        }
    substantive = False
    for k, t in h.lines:
        d = defs_in_line(t)
        if k == "-":
            minus_defs |= d
            if t.strip():
                substantive = True
        elif k == "+":
            plus_defs |= d
            uses |= idents_in(t)
            if t.strip():
                substantive = True
        elif k == " ":
            enc |= {n for n in d if _typeish(n)}
    if not substantive:
        return set(), set(), set()
    natal = plus_defs - minus_defs
    touched = plus_defs | minus_defs
    enc |= {n for n in enclosing_defs(blob, h.new_start) if _typeish(n)}
    defs = natal | touched | enc
    uses -= defs
    return defs, uses, natal


def nodes_from_files(
    files: list[FileChange],
    grain: str,
    blobs: dict[str, str] | None = None,
) -> list[Node]:
    blobs = blobs or {}
    raw: list[Node] = []
    for fc in files:
        if fc.is_binary:
            continue
        if not fc.hunks:
            role = path_role(fc.path)
            raw.append(
                Node(
                    nid=f"{fc.path}#all",
                    path=fc.path,
                    hunk_i=-1,
                    role=role,
                    defs=set(),
                    uses=set(),
                    natal=set(),
                    file=fc,
                    hunk=None,
                )
            )
            continue
        for i, h in enumerate(fc.hunks):
            blob = blobs.get(fc.path)
            defs, uses, natal = extract_hunk_names(h, fc.path, blob)
            role = hunk_role(fc.path, h.text())
            raw.append(
                Node(
                    nid=f"{fc.path}#{i}",
                    path=fc.path,
                    hunk_i=i,
                    role=role,
                    defs=defs,
                    uses=uses,
                    natal=natal,
                    file=fc,
                    hunk=h,
                )
            )
    if grain == "file":
        grouped: dict[str, list[Node]] = defaultdict(list)
        for n in raw:
            grouped[n.path].append(n)
        merged: list[Node] = []
        for path, ns in grouped.items():
            roles = {n.role for n in ns}
            if "mixed" in roles or ("prod" in roles and "test" in roles):
                role = "mixed"
            else:
                role = ns[0].role
                for cand in ("prod", "test", "doc", "config", "other"):
                    if any(n.role == cand for n in ns):
                        role = cand
                        break
            defs: set[str] = set()
            uses: set[str] = set()
            natal: set[str] = set()
            for n in ns:
                defs |= n.defs
                uses |= n.uses
                natal |= n.natal
            uses -= defs
            merged.append(
                Node(
                    nid=f"{path}#file",
                    path=path,
                    hunk_i=-1,
                    role=role,
                    defs=defs,
                    uses=uses,
                    natal=natal,
                    file=ns[0].file,
                    hunk=None,
                )
            )
        return merged
    return raw


def plot_names(nodes: list[Node]) -> set[str]:
    s: set[str] = set()
    for n in nodes:
        s |= n.defs
        s |= n.natal
    return {x for x in s if x not in STOP}


def restrict_uses(nodes: list[Node], names: set[str]) -> None:
    for n in nodes:
        n.uses &= names
        n.uses -= n.defs


def scc_order(nodes: list[Node], before: dict[str, set[str]]) -> list[list[Node]]:
    """Tarjan SCC, then topo of condensation along 'before' edges (a before b)."""
    idx_of = {n.nid: n for n in nodes}
    ids = [n.nid for n in nodes]
    index = 0
    stack: list[str] = []
    on: set[str] = set()
    indexes: dict[str, int] = {}
    low: dict[str, int] = {}
    comps: list[list[str]] = []

    def strongconnect(v: str) -> None:
        nonlocal index
        indexes[v] = index
        low[v] = index
        index += 1
        stack.append(v)
        on.add(v)
        for w in before.get(v, ()):
            if w not in idx_of:
                continue
            if w not in indexes:
                strongconnect(w)
                low[v] = min(low[v], low[w])
            elif w in on:
                low[v] = min(low[v], indexes[w])
        if low[v] == indexes[v]:
            comp = []
            while True:
                w = stack.pop()
                on.discard(w)
                comp.append(w)
                if w == v:
                    break
            comps.append(comp)

    for v in ids:
        if v not in indexes:
            strongconnect(v)

    # map node -> comp
    comp_of: dict[str, int] = {}
    for i, c in enumerate(comps):
        for v in c:
            comp_of[v] = i
    n_c = len(comps)
    succ: dict[int, set[int]] = defaultdict(set)
    indeg = [0] * n_c
    for a, bs in before.items():
        if a not in comp_of:
            continue
        for b in bs:
            if b not in comp_of:
                continue
            ca, cb = comp_of[a], comp_of[b]
            if ca != cb and cb not in succ[ca]:
                succ[ca].add(cb)
                indeg[cb] += 1

    def comp_key(ci: int) -> tuple:
        ns = [idx_of[v] for v in comps[ci]]
        role = min(ROLE_RANK.get(n.role, 9) for n in ns)
        path = min(n.path for n in ns)
        return (role, path, ci)

    ready = [i for i in range(n_c) if indeg[i] == 0]
    ready.sort(key=comp_key)
    order: list[int] = []
    q = deque(ready)
    seen_ready = set(ready)
    while q:
        # pick best by key among q
        best_i = min(range(len(q)), key=lambda i: comp_key(q[i]))
        ci = q[best_i]
        del q[best_i]
        order.append(ci)
        for cj in sorted(succ[ci], key=comp_key):
            indeg[cj] -= 1
            if indeg[cj] == 0 and cj not in seen_ready:
                seen_ready.add(cj)
                q.append(cj)
                # keep q unsorted; we min each time
    # leftover cycles already in comps; if topo missed, append
    missing = [i for i in range(n_c) if i not in order]
    missing.sort(key=comp_key)
    order.extend(missing)

    out: list[list[Node]] = []
    for ci in order:
        ns = [idx_of[v] for v in comps[ci]]
        ns.sort(key=lambda n: (ROLE_RANK.get(n.role, 9), n.path, n.hunk_i))
        out.append(ns)
    return out


@dataclass
class Act:
    index: int
    kind: str
    track: int
    nodes: list[Node]
    defs: set[str] = field(default_factory=set)
    uses: set[str] = field(default_factory=set)
    natal: set[str] = field(default_factory=set)
    via: set[str] = field(default_factory=set)
    files: list[str] = field(default_factory=list)

    def to_json(self) -> dict[str, Any]:
        return {
            "index": self.index,
            "kind": self.kind,
            "track": self.track,
            "files": self.files,
            "hunks": len(self.nodes),
            "defs": sorted(self.defs),
            "uses": sorted(self.uses),
            "natal": sorted(self.natal),
            "via": sorted(self.via),
            "roles": sorted({n.role for n in self.nodes}),
        }


@dataclass
class Plot:
    acts: list[Act]
    grain: str
    spoil: int
    tangle: int
    from_rev: str = ""
    to_rev: str = ""
    n_files: int = 0
    n_hunks: int = 0

    def n_tracks(self) -> int:
        return len({a.track for a in self.acts}) if self.acts else 0

    def to_json(self) -> dict[str, Any]:
        tracks: dict[int, list[int]] = defaultdict(list)
        for a in self.acts:
            tracks[a.track].append(a.index)
        return {
            "grain": self.grain,
            "from": self.from_rev,
            "to": self.to_rev,
            "files": self.n_files,
            "hunks": self.n_hunks,
            "spoil": self.spoil,
            "tangle": self.tangle,
            "tracks": {str(k): v for k, v in sorted(tracks.items())},
            "acts": [a.to_json() for a in self.acts],
        }


def merge_same_file_runs(groups: list[list[Node]]) -> list[list[Node]]:
    """Adjacent SCCs that are the same file and role are one act (one prelude, not five)."""
    if not groups:
        return groups
    out: list[list[Node]] = [list(groups[0])]
    for g in groups[1:]:
        prev = out[-1]
        prev_paths = {n.path for n in prev}
        g_paths = {n.path for n in g}
        prev_roles = {n.role for n in prev}
        g_roles = {n.role for n in g}
        if (
            prev_paths == g_paths
            and len(prev_paths) == 1
            and prev_roles == g_roles
            and "mixed" not in prev_roles
            and prev_roles != {"test"}  # keep test hunks mergeable too actually
        ):
            out[-1].extend(g)
        elif prev_paths == g_paths and len(prev_paths) == 1 and prev_roles == g_roles:
            out[-1].extend(g)
        else:
            out.append(list(g))
    return out


def classify_acts(groups: list[list[Node]], before_via: dict[tuple[str, str], set[str]]) -> list[Act]:
    acts: list[Act] = []
    defined_so_far: set[str] = set()
    nid_act: dict[str, int] = {}
    for i, ns in enumerate(groups, start=1):
        defs: set[str] = set()
        uses: set[str] = set()
        natal: set[str] = set()
        roles = {n.role for n in ns}
        files = []
        seen_f = set()
        for n in ns:
            defs |= n.defs
            uses |= n.uses
            natal |= n.natal
            nid_act[n.nid] = i
            if n.path not in seen_f:
                seen_f.add(n.path)
                files.append(n.path)
        via: set[str] = set()
        for n in ns:
            for m in n.uses:
                if m in defined_so_far:
                    via.add(m)
        cycle = len(ns) > 1 and any(
            n.nid != o.nid and (n.nid, o.nid) in before_via and (o.nid, n.nid) in before_via
            for n in ns
            for o in ns
        )
        mixed = "prod" in roles and "test" in roles or "mixed" in roles
        if mixed:
            kind = "SPOIL"
        elif not defs and not uses:
            kind = "ASIDE"
        elif via and natal and not mixed:
            kind = "PAYOFF" if roles == {"test"} or "test" in roles else "PRELUDE"
        elif via and roles <= {"test"}:
            kind = "PAYOFF"
        elif natal and not via:
            # prelude if someone later will use; we don't know yet → PRELUDE tentative
            kind = "PRELUDE"
        elif defs and not natal and not via:
            kind = "SOLO"
        else:
            kind = "SOLO"
        if cycle and kind not in {"SPOIL"}:
            kind = "CYCLE"
        if not defs and not natal and via:
            kind = "PAYOFF"
        acts.append(
            Act(
                index=i,
                kind=kind,
                track=0,
                nodes=ns,
                defs=defs,
                uses=uses,
                natal=natal,
                via=via,
                files=files,
            )
        )
        defined_so_far |= defs | natal
    # PRELUDE vs SOLO: a prelude is cited later
    cited_later: set[str] = set()
    seen: set[str] = set()
    for a in reversed(acts):
        if a.via or a.uses:
            # uses that were defined in earlier acts
            pass
        cited_later |= a.uses
        if a.kind == "PRELUDE" and not (a.natal | a.defs) & cited_later:
            if not a.via:
                a.kind = "SOLO" if (a.defs or a.natal) else "ASIDE"
        if a.kind == "SOLO" and (a.natal | a.defs) & cited_later:
            a.kind = "PRELUDE"
        seen |= a.defs | a.natal
    # second pass forward for PAYOFF that were marked PRELUDE (prod that uses earlier)
    defined = set()
    for a in acts:
        uses_earlier = a.uses & defined
        if uses_earlier:
            a.via |= uses_earlier
            if a.kind in {"SOLO", "PRELUDE"} and a.nodes and all(n.role == "test" for n in a.nodes):
                a.kind = "PAYOFF"
            elif a.kind == "SOLO" and uses_earlier and not a.natal:
                a.kind = "PAYOFF"
        defined |= a.defs | a.natal
    return acts


def assign_tracks(acts: list[Act], before: dict[str, set[str]]) -> None:
    # undirected connectivity via before-edges and same-file
    parent = {a.index: a.index for a in acts}
    nid_to_act = {n.nid: a.index for a in acts for n in a.nodes}

    def find(x: int) -> int:
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a: int, b: int) -> None:
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

    for a, bs in before.items():
        if a not in nid_to_act:
            continue
        for b in bs:
            if b in nid_to_act:
                union(nid_to_act[a], nid_to_act[b])
    by_file: dict[str, list[int]] = defaultdict(list)
    for act in acts:
        for n in act.nodes:
            by_file[n.path].append(act.index)
    for idxs in by_file.values():
        for i in idxs[1:]:
            union(idxs[0], i)
    # asides stay their own tracks unless connected
    roots = []
    seen = set()
    for a in acts:
        r = find(a.index)
        if r not in seen:
            seen.add(r)
            roots.append(r)
    # asides with no edges: each own track, grouped at end
    root_has_name = defaultdict(bool)
    for a in acts:
        r = find(a.index)
        if a.defs or a.natal or a.uses or a.kind not in {"ASIDE"}:
            root_has_name[r] = True
    track_of_root: dict[int, int] = {}
    t = 1
    # named tracks first, in first-act order
    for a in acts:
        r = find(a.index)
        if r not in track_of_root and root_has_name[r]:
            track_of_root[r] = t
            t += 1
    for a in acts:
        r = find(a.index)
        if r not in track_of_root:
            track_of_root[r] = t
            t += 1
    for a in acts:
        a.track = track_of_root[find(a.index)]


def build_plot(
    files: list[FileChange],
    grain: str = "hunk",
    blobs: dict[str, str] | None = None,
) -> Plot:
    nodes = nodes_from_files(files, grain, blobs)
    names = plot_names(nodes)
    restrict_uses(nodes, names)
    before: dict[str, set[str]] = defaultdict(set)
    before_via: dict[tuple[str, str], set[str]] = defaultdict(set)
    by_def: dict[str, list[Node]] = defaultdict(list)
    for n in nodes:
        for d in n.defs | n.natal:
            by_def[d].append(n)
    for user in nodes:
        for u in user.uses:
            for defn in by_def.get(u, ()):
                if defn.nid == user.nid:
                    continue
                # definer before user
                before[defn.nid].add(user.nid)
                before_via[(defn.nid, user.nid)].add(u)
    groups = scc_order(nodes, before)
    groups = merge_same_file_runs(groups)
    acts = classify_acts(groups, before_via)
    assign_tracks(acts, before)
    spoil = sum(1 for a in acts if a.kind == "SPOIL")
    # TANGLE: a use of a natal/def that only appears in a LATER act
    later_defs: dict[str, int] = {}
    for a in acts:
        for d in a.defs | a.natal:
            later_defs.setdefault(d, a.index)
    tangle = 0
    for a in acts:
        for u in a.uses:
            def_at = later_defs.get(u)
            if def_at is not None and def_at > a.index:
                tangle += 1
                break
    n_hunks = sum(len(f.hunks) for f in files)
    return Plot(
        acts=acts,
        grain=grain,
        spoil=spoil,
        tangle=tangle,
        n_files=len(files),
        n_hunks=n_hunks,
    )


# ---------------------------------------------------------------------------
# format
# ---------------------------------------------------------------------------

def _names(xs: set[str], limit: int) -> str:
    if not xs:
        return ""
    ordered = sorted(xs, key=lambda s: (-len(s), s.lower()))
    more = len(ordered) - limit
    head = ordered[:limit]
    s = ", ".join(head)
    if more > 0:
        s += f" +{more}"
    return s


def format_porcelain(plot: Plot, max_names: int = 8) -> str:
    n_tracks = plot.n_tracks()
    lines = [
        f"reel {len(plot.acts)} acts  {n_tracks} tracks  "
        f"spoil={plot.spoil} tangle={plot.tangle}  grain={plot.grain}"
    ]
    if plot.from_rev or plot.to_rev:
        lines[0] += f"  {plot.from_rev}..{plot.to_rev}"
    by_track: dict[int, list[Act]] = defaultdict(list)
    for a in plot.acts:
        by_track[a.track].append(a)
    for t in sorted(by_track):
        acts = by_track[t]
        title_names: set[str] = set()
        for a in acts:
            title_names |= a.natal | (a.defs if a.kind in {"PRELUDE", "CYCLE", "SPOIL"} else set())
        if not title_names:
            for a in acts:
                title_names |= a.via
        title = _names(title_names, 3) or "(aside)"
        lines.append(f"TRACK {t}  {title}")
        for a in acts:
            files = a.files
            shown = files[0] if files else "?"
            extra = f" +{len(files)-1}" if len(files) > 1 else ""
            nh = len(a.nodes)
            hunks = f"{nh} hunk{'s' if nh != 1 else ''}"
            lines.append(f"  #{a.index:<2} {a.kind:<8} {hunks:<8} {shown}{extra}")
            d = _names(a.natal or a.defs, max_names)
            u = _names(a.via or (a.uses - a.defs), max_names)
            if d and a.kind not in {"ASIDE"}:
                lines.append(f"           defs  {d}")
            if u and a.kind in {"PAYOFF", "PRELUDE", "CYCLE", "SPOIL"}:
                lines.append(f"           via   {u}")
    return "\n".join(lines) + "\n"


def format_tsv(plot: Plot) -> str:
    rows = ["act\ttrack\tkind\tpath\trole\tnatal\tvia"]
    for a in plot.acts:
        natal = ",".join(sorted(a.natal)[:12])
        via = ",".join(sorted(a.via)[:12])
        for n in a.nodes:
            rows.append(
                f"{a.index}\t{a.track}\t{a.kind}\t{n.path}\t{n.role}\t{natal}\t{via}"
            )
    return "\n".join(rows) + "\n"


# ---------------------------------------------------------------------------
# series (format-patch mailbox) / against
# ---------------------------------------------------------------------------

MBOX_FROM = "From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001"


def files_first_act(plot: Plot) -> dict[str, int]:
    first: dict[str, int] = {}
    for a in plot.acts:
        for p in a.files:
            first.setdefault(p, a.index)
    return first


def paths_by_act(plot: Plot) -> dict[int, list[str]]:
    first = files_first_act(plot)
    by_act: dict[int, list[str]] = defaultdict(list)
    for p, ai in first.items():
        by_act[ai].append(p)
    for k in list(by_act):
        by_act[k] = sorted(by_act[k])
    return by_act


def series_acts(plot: Plot, aside: str = "last") -> list[Act]:
    """Emit order. 'last' parks ASIDE after the story so a blank-line sibling
    does not interrupt PRELUDE → PAYOFF (sitbone e9b0f75)."""
    if aside == "last":
        story = [a for a in plot.acts if a.kind != "ASIDE"]
        asides = [a for a in plot.acts if a.kind == "ASIDE"]
        return story + asides
    return list(plot.acts)


def slug_path(path: str) -> str:
    base = path.rsplit("/", 1)[-1] if path else "act"
    s = re.sub(r"[^A-Za-z0-9._]+", "-", base).strip(".-")
    return (s or "act")[:50]


def patch_filename(n: int, kind: str, files: list[str]) -> str:
    lead = slug_path(files[0]) if files else "empty"
    return f"{n:04d}-{kind}-{lead}.patch"


def patch_subject(n: int, total: int, kind: str, files: list[str]) -> str:
    lead = files[0].rsplit("/", 1)[-1] if files else "empty"
    extra = f" +{len(files) - 1}" if len(files) > 1 else ""
    return f"[PATCH {n}/{total}] {kind}: {lead}{extra}"


def act_body(act: Act, paths: list[str], max_names: int = 8) -> str:
    lines = [
        f"reel act #{act.index} {act.kind} track={act.track}",
        f"files: {', '.join(paths)}",
    ]
    d = _names(act.natal or act.defs, max_names)
    u = _names(act.via or (act.uses - act.defs), max_names)
    if d:
        lines.append(f"defs: {d}")
    if u:
        lines.append(f"via: {u}")
    return "\n".join(lines) + "\n"


def format_mbox_message(
    *,
    n: int,
    total: int,
    kind: str,
    files: list[str],
    body: str,
    diff: str,
    author: str,
    email: str,
    date: str,
    patch_id: str | None = None,
) -> str:
    """One git-am / format-patch message. Diff must be git-diff --git form."""
    pid = patch_id or ("0" * 40)
    subject = patch_subject(n, total, kind, files)
    diff = diff.replace("\r\n", "\n")
    if not diff.endswith("\n") and diff:
        diff += "\n"
    parts = [
        f"From {pid} Mon Sep 17 00:00:00 2001",
        f"From: {author} <{email}>",
        f"Date: {date}",
        f"Subject: {subject}",
        "",
        body.rstrip("\n"),
        "",
        "---",
        "",
        diff.rstrip("\n"),
        "",
        "-- ",
        f"reel {VERSION}",
        "",
    ]
    return "\n".join(parts)


def cover_letter(
    plot: Plot,
    n_patches: int,
    frm: str,
    to: str,
    author: str,
    email: str,
    date: str,
) -> str:
    letter = format_porcelain(plot)
    body = (
        f"reel unsquash of {frm}..{to}\n"
        f"{n_patches} acts as format-patch. git am in order from {frm}.\n\n"
        f"{letter}"
    )
    return format_mbox_message(
        n=0,
        total=n_patches,
        kind="COVER",
        files=["COVER"],
        body=body,
        diff="",
        author=author,
        email=email,
        date=date,
    )


def commit_ident(repo: str, rev: str) -> tuple[str, str, str]:
    """Author / email / RFC2822 date of rev; fallback to reel@local."""
    if rev == ":worktree" or not git_ok(repo, "rev-parse", "--verify", rev):
        return "reel", "reel@local", "Thu, 1 Jan 1970 00:00:00 +0000"
    out = git(
        repo,
        "log",
        "-1",
        "--format=%an%n%ae%n%aD",
        rev,
        check=False,
    ).splitlines()
    if len(out) >= 3:
        return out[0], out[1], out[2]
    return "reel", "reel@local", "Thu, 1 Jan 1970 00:00:00 +0000"


def attach_stragglers(plot: Plot, files: list[FileChange]) -> None:
    """Binaries / hunkless files skipped by the graph still belong in the series
    so `git am` reconstitutes TO."""
    assigned = {p for a in plot.acts for p in a.files}
    leftover = [fc for fc in files if fc.path not in assigned]
    if not leftover:
        return
    nodes = []
    for fc in leftover:
        nodes.append(
            Node(
                nid=f"{fc.path}#straggler",
                path=fc.path,
                hunk_i=-1,
                role=path_role(fc.path),
                defs=set(),
                uses=set(),
                natal=set(),
                file=fc,
                hunk=None,
            )
        )
    idx = (plot.acts[-1].index + 1) if plot.acts else 1
    plot.acts.append(
        Act(
            index=idx,
            kind="ASIDE",
            track=(plot.acts[-1].track + 1) if plot.acts else 1,
            nodes=nodes,
            files=[fc.path for fc in leftover],
        )
    )
    plot.n_files = max(plot.n_files, len(files))


def collect_series(
    plot: Plot,
    repo: str,
    frm: str,
    to: str,
    aside: str = "last",
    max_names: int = 8,
) -> list[tuple[str, str, Act, list[str]]]:
    """[(filename, mbox_text, act, paths), ...] omitting empty diffs."""
    author, email, date = commit_ident(repo, to if to != ":worktree" else frm)
    by_act = paths_by_act(plot)
    ordered = series_acts(plot, aside=aside)
    ready: list[tuple[Act, list[str], str]] = []
    for a in ordered:
        paths = by_act.get(a.index, list(a.files))
        if not paths:
            continue
        diff = git(repo, "diff", "--binary", "--find-renames", frm, to, "--", *paths)
        if not diff.strip():
            continue
        ready.append((a, paths, diff))
    total = len(ready)
    out = []
    for i, (a, paths, diff) in enumerate(ready, start=1):
        body = act_body(a, paths, max_names=max_names)
        msg = format_mbox_message(
            n=i,
            total=total,
            kind=a.kind,
            files=paths,
            body=body,
            diff=diff,
            author=author,
            email=email,
            date=date,
        )
        name = patch_filename(i, a.kind, paths)
        out.append((name, msg, a, paths))
    return out


def write_series(
    items: list[tuple[str, str, Act, list[str]]],
    dest: str | None,
    cover: str | None = None,
) -> list[str]:
    """Write 000N-*.patch to dest, or return ['-'] with stdout already printed."""
    if dest is None:
        chunks = []
        if cover:
            chunks.append(cover.rstrip("\n") + "\n")
        for _name, msg, _a, _p in items:
            chunks.append(msg if msg.endswith("\n") else msg + "\n")
        sys.stdout.write("".join(chunks))
        return ["-"] * len(items)
    os.makedirs(dest, exist_ok=True)
    written: list[str] = []
    if cover:
        path = os.path.join(dest, "0000-cover-letter.patch")
        with open(path, "w", encoding="utf-8") as f:
            f.write(cover if cover.endswith("\n") else cover + "\n")
        written.append(path)
    for name, msg, _a, _p in items:
        path = os.path.join(dest, name)
        with open(path, "w", encoding="utf-8") as f:
            f.write(msg if msg.endswith("\n") else msg + "\n")
        written.append(path)
    return written


def write_split(plot: Plot, dest: str, repo: str, frm: str, to: str) -> list[str]:
    """Back-compat name: format-patch files in dest (no APPLY.txt)."""
    items = collect_series(plot, repo, frm, to, aside="last")
    return write_series(items, dest)


def against_log(plot: Plot, repo: str, frm: str, to: str) -> dict[str, Any]:
    """Jaccard of act file-sets vs original commits in frm..to (oldest first)."""
    # commits reachable from to, not from frm (i.e. frm..to)
    if not git_ok(repo, "rev-parse", "--verify", frm) or not git_ok(repo, "rev-parse", "--verify", to):
        return {"error": "bad range"}
    log = git(repo, "log", "--reverse", "--format=%H %s", f"{frm}..{to}").strip().splitlines()
    commits = []
    for line in log:
        if not line.strip():
            continue
        sha, _, subj = line.partition(" ")
        files = git(repo, "diff-tree", "--no-commit-id", "-r", "--name-only", sha).splitlines()
        files = [norm_path(x) for x in files if x.strip()]
        commits.append({"sha": sha[:12], "subject": subj, "files": files})
    act_files = []
    first = files_first_act(plot)
    by_act: dict[int, set[str]] = defaultdict(set)
    for p, ai in first.items():
        by_act[ai].add(p)
    for a in plot.acts:
        act_files.append({"index": a.index, "kind": a.kind, "files": sorted(by_act.get(a.index, ()))})
    # greedy match commits → acts
    matches = []
    used = set()
    scores = []
    for c in commits:
        cs = set(c["files"])
        best = None
        best_j = -1.0
        for a in act_files:
            if a["index"] in used:
                continue
            as_ = set(a["files"])
            if not cs and not as_:
                j = 1.0
            else:
                j = len(cs & as_) / len(cs | as_) if (cs | as_) else 0.0
            if j > best_j:
                best_j = j
                best = a
        if best is None:
            matches.append({**c, "act": None, "jaccard": 0.0})
            scores.append(0.0)
        else:
            used.add(best["index"])
            matches.append({**c, "act": best["index"], "kind": best["kind"], "jaccard": round(best_j, 3)})
            scores.append(best_j)
    mean = sum(scores) / len(scores) if scores else 0.0
    return {
        "commits": len(commits),
        "acts": len(plot.acts),
        "mean_jaccard": round(mean, 3),
        "matches": matches,
    }


def apply_split_verify(repo: str, frm: str, to: str, patches: list[str]) -> bool:
    """git am the mailbox series on a throwaway worktree of frm; tree == to."""
    import tempfile
    import shutil

    tmp = tempfile.mkdtemp(prefix="reel-verify-")
    try:
        git(repo, "worktree", "add", "--detach", tmp, frm)
        git(tmp, "config", "user.name", "reel")
        git(tmp, "config", "user.email", "reel@local")
        git(tmp, "config", "commit.gpgsign", "false")
        for p in patches:
            if os.path.basename(p).startswith("0000-cover"):
                continue
            r = subprocess.run(
                ["git", "-C", tmp, "am", "--whitespace=nowarn", p],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
            if r.returncode != 0:
                subprocess.run(
                    ["git", "-C", tmp, "am", "--abort"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                )
                return False
        h1 = git(tmp, "rev-parse", "HEAD^{tree}").strip()
        h2 = git(repo, "rev-parse", f"{to}^{{tree}}").strip()
        return h1 == h2
    finally:
        subprocess.run(
            ["git", "-C", repo, "worktree", "remove", "--force", tmp],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        shutil.rmtree(tmp, ignore_errors=True)


