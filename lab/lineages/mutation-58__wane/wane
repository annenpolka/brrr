def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="wane",
        description=(
            "Two git trees in. Emit the exclusive-A path-condition "
            "stacks that died (true on A, false on B), then occupy "
            "those stacks through history. Not thatch's mixed A/B/AB "
            "budget. Not sheaf's grep/exists. Invert A/B to ask what "
            "was born."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  wane HEAD~1 HEAD
  wane 14b1d6e HEAD
  wane HEAD :worktree
  wane --json --limit 6 -C sitbone 14b1d6e HEAD
  wane --also-changed --limit 6 -C sitbone 14b1d6e HEAD
  wane --walks -C sitbone 70ec7df^ 70ec7df
""",
    )
    parser.add_argument("-C", "--repo", default=None, help="repository (default: cwd)")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--oneline", action="store_true")
    parser.add_argument(
        "--walks",
        "--sh",
        action="store_true",
        help="print only ready-to-run tenure FILE:LINE command lines",
    )
    parser.add_argument(
        "--no-walks",
        action="store_true",
        help="do not print tenure command lines in human output",
    )
    parser.add_argument(
        "--no-occupy",
        action="store_true",
        help="covering set only; do not walk history",
    )
    parser.add_argument(
        "--full",
        action="store_true",
        help="force full-history occupy (not only first-parent)",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=8,
        help="max exclusive-A (dead) stacks to name (default: 8); never filled with exclusive-B or AB else",
    )
    parser.add_argument(
        "--also-changed",
        action="store_true",
        help="also name exclusive-A stacks that died inside surviving files (default: deleted files only)",
    )
    parser.add_argument(
        "--occupy-limit",
        type=int,
        default=None,
        help="keep only the last N commits when occupying (default: 12 if adjacent, else all)",
    )
    parser.add_argument(
        "--boolean",
        action="store_true",
        help="occupy compresses only on TRUE/FALSE (ancestor held)",
    )
    parser.add_argument(
        "--grain",
        choices=("files", "functions", "regions", "loci"),
        default="functions",
    )
    parser.add_argument("--with-fn", action="store_true")
    parser.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    parser.add_argument("-q", "--quiet", action="store_true")
    parser.add_argument("--now", action="store_true", help="append the working tree as a final occupy sample")
    parser.add_argument("--selftest", action="store_true")
    parser.add_argument("a", nargs="?", help="tree-ish A")
    parser.add_argument("b", nargs="?", help="tree-ish B")
    parser.add_argument("paths", nargs="*", help="optional path limiter")
    return parser.parse_args(list(argv))


def selftest() -> int:
    fails = 0

    def check(name: str, cond: bool) -> None:
        nonlocal fails
        if cond:
            print(f"  ok  {name}")
        else:
            print(f"  FAIL {name}", file=sys.stderr)
            fails += 1

    src = (
        "def process(x, ready=True, enabled=True):\n"
        "    if not ready:\n"
        "        return None\n"
        "    if x > 0:\n"
        "        flag = True\n"
        "        return 'ok'\n"
    )
    idx = FileIndex(src, "src/app.py")
    loc = idx.at(6)
    loc.file = "src/app.py"
    key = cond_key(loc.frames, with_fn=False)
    check("return line has given+if, not fn", [k[0] for k in key] == ["given", "if"])
    check("given is ready (negated not ready)", "ready" in key[0][1] and "not ready" not in key[0][1])
    check("if is x > 0", "x > 0" in key[1][1] or "x>0" in key[1][1].replace(" ", ""))

    hits = stacks_in_source(src, "src/app.py", grain="functions", with_fn=False)
    check("discovered the ready|x>0 stack", key in hits)
    check("functions grain is process", hits[key].holders == ["src/app.py:process"])

    # Move covers both paths as one member; two exclusives are the concatenation.
    move = Stack(
        key=key,
        holders_a=["src/git.py:parse"],
        holders_b=["src/parse.py:parse"],
        paths_a=["src/git.py"],
        paths_b=["src/parse.py"],
        pin_a=("src/git.py", 4),
        pin_b=("src/parse.py", 4),
    )
    universe = {"src/git.py", "src/parse.py"}
    move.covers = move.cover_paths(universe)
    check("move role", move.role == "move")
    check("move covers both paths", set(move.covers) == universe)
    check("move quality is 0 (the joint)", move.quality == 0)

    ex_a = Stack(
        key=(("if", "gone"),),
        holders_a=["src/git.py:parse"],
        holders_b=[],
        paths_a=["src/git.py"],
        paths_b=[],
        pin_a=("src/git.py", 1),
        pin_b=None,
    )
    ex_a.covers = ex_a.cover_paths(universe)
    ex_b = Stack(
        key=(("if", "born"),),
        holders_a=[],
        holders_b=["src/parse.py:parse"],
        paths_a=[],
        paths_b=["src/parse.py"],
        pin_a=None,
        pin_b=("src/parse.py", 1),
    )
    ex_b.covers = ex_b.cover_paths(universe)
    cover = shortest_cover([ex_a, ex_b, move], sorted(universe), limit=4)
    check("shortest cover is the one move, not two exclusives", cover == [move])

    shallow = Stack(
        key=(("given", "ready"),),
        holders_a=[],
        holders_b=["src/git.py:parse"],
        paths_a=[],
        paths_b=["src/git.py"],
        pin_a=None,
        pin_b=("src/git.py", 3),
    )
    shallow.covers = ["src/git.py"]
    deep = Stack(
        key=(("given", "ready"), ("if", "x > 0")),
        holders_a=[],
        holders_b=["src/git.py:parse"],
        paths_a=[],
        paths_b=["src/git.py"],
        pin_a=None,
        pin_b=("src/git.py", 5),
    )
    deep.covers = ["src/git.py"]
    body = shortest_cover([shallow, deep], ["src/git.py"], limit=2)
    check("deeper body stack beats prefix given", body == [deep])

    # Exclusive-A only: island stack survives a B-side flood without reservation.
    river_key = (("if", "flow_score > 0.2"),)
    river = Stack(
        key=river_key,
        holders_a=["src/river.py:bar"],
        holders_b=[],
        paths_a=["src/river.py"],
        paths_b=[],
        pin_a=("src/river.py", 2),
        pin_b=None,
    )
    river.covers = ["src/river.py"]
    flood: list[Stack] = []
    only_b: list[str] = []
    for i in range(8):
        p = f"src/mod{i}.py"
        only_b.append(p)
        s = Stack(
            key=(("if", f"unique_mod_{i} > 0"),),
            holders_a=[],
            holders_b=[f"{p}:fn"],
            paths_a=[],
            paths_b=[p],
            pin_a=None,
            pin_b=(p, 2),
        )
        s.covers = [p]
        flood.append(s)
    dead = dead_cover(
        [river, *flood],
        ["src/river.py"],
        [],
        limit=4,
    )
    check("dead cover keeps the island under --limit 4", any(s.key == river_key for s in dead))
    check("dead cover ignores exclusive-B flood", all(s.true_on == "A" for s in dead))
    check("dead cover size respects --limit", len(dead) <= 4)

    else_spread = Stack(
        key=(("else", ""),),
        holders_a=["src/old.py:f"],
        holders_b=["src/old.py:f", "src/mod0.py:fn"],
        paths_a=["src/old.py"],
        paths_b=["src/old.py", "src/mod0.py"],
        pin_a=("src/old.py", 1),
        pin_b=("src/mod0.py", 1),
    )
    check("bare else is junk", else_spread.junk)
    check("bare else quality is last", else_spread.quality >= 5)
    dead2 = dead_cover(
        [river, else_spread, *flood, move],
        ["src/river.py"],
        ["src/old.py", "src/git.py", "src/parse.py"],
        limit=4,
    )
    check(
        "dead cover is exclusive-A only (no else, no B, no move)",
        any(s.key == river_key for s in dead2)
        and all(s.true_on == "A" for s in dead2)
        and all(s.key != else_spread.key for s in dead2)
        and all(s.role != "move" for s in dead2),
    )

    given_else = Stack(
        key=(("given", "¬(app.flowScore>0.2)"), ("given", "¬(app.flowScore<-0.2)")),
        holders_a=["src/river.py:dotColor"],
        holders_b=[],
        paths_a=["src/river.py"],
        paths_b=[],
        pin_a=("src/river.py", 8),
        pin_b=None,
    )
    given_else.covers = ["src/river.py"]
    if_arm = Stack(
        key=(("if", "app.flowScore > 0.2"),),
        holders_a=["src/river.py:barColor"],
        holders_b=[],
        paths_a=["src/river.py"],
        paths_b=[],
        pin_a=("src/river.py", 4),
        pin_b=None,
    )
    if_arm.covers = ["src/river.py"]
    window = Stack(
        key=(("if", "w = window"),),
        holders_a=["src/river.py:show"],
        holders_b=[],
        paths_a=["src/river.py"],
        paths_b=[],
        pin_a=("src/river.py", 12),
        pin_b=None,
    )
    window.covers = ["src/river.py"]
    prefix = Stack(
        key=(("given", "¬(app.flowScore>0.2)"),),
        holders_a=["src/river.py:dotColor"],
        holders_b=[],
        paths_a=["src/river.py"],
        paths_b=[],
        pin_a=("src/river.py", 7),
        pin_b=None,
    )
    prefix.covers = ["src/river.py"]
    dead3 = dead_cover(
        [given_else, if_arm, window, prefix],
        ["src/river.py"],
        [],
        limit=3,
    )
    check("dead cover prefers if-arm flowScore over given-negation else", dead3[0].key == if_arm.key)
    check(
        "dead cover suppresses prefix of a chosen deeper stack",
        all(s.key != prefix.key for s in dead3),
    )
    check(
        "dead cover extra stacks on the island stay name-like",
        all(_pred_name_like(s) for s in dead3),
    )

    tick = Stack(
        key=(("switch", "current"), ("case", ".flow"), ("if", "idle<thresholds.t1")),
        holders_a=["src/core.py:tick"],
        holders_b=[],
        paths_a=["src/core.py"],
        paths_b=[],
        pin_a=("src/core.py", 40),
        pin_b=None,
    )
    tick.covers = ["src/core.py"]
    dead4 = dead_cover(
        [if_arm, tick],
        ["src/river.py"],
        ["src/core.py"],
        limit=6,
    )
    check("default leftover ignores surviving-file exclusive-A", all(s.key != tick.key for s in dead4))
    check("default leftover still names the deleted file", any(s.key == if_arm.key for s in dead4))
    dead5 = dead_cover(
        [if_arm, tick],
        ["src/river.py"],
        ["src/core.py"],
        limit=6,
        also_changed=True,
    )
    check("--also-changed includes surviving-file exclusive-A", any(s.key == tick.key for s in dead5))

    ghost = classify_era(
        value=True,
        split="holders",
        holders=["tests/test_app.py:test_process"],
        added=[],
        dropped=["src/app.py:process"],
    )
    check("production→tests is ghost", ghost == "ghost")
    deeper = (("given", "enabled"), ("given", "ready"), ("if", "x > 0"))
    check("extra guard is deeper", relate_keys(deeper, key) == "deeper")

    samples = [
        Sample("a" * 40, 1, "2026-01-01", "t0", "commit"),
        Sample("b" * 40, 2, "2026-01-02", "t1", "commit"),
        Sample("c" * 40, 3, "2026-01-03", "t2", "commit"),
    ]
    values = [True, True, True]
    wits = [
        ["src/git.py:parse"],
        ["src/git.py:parse"],
        ["src/parse.py:parse"],
    ]
    eras = compress(samples, values, wits, split_holders=True)
    check("holder move splits TRUE", len(eras) == 2 and all(e.value for e in eras))
    check("second era is move", eras[1].kind == "move")
    bool_eras = compress(samples, values, wits, split_holders=False)
    check("--boolean hides the move", len(bool_eras) == 1)

    if fails:
        print(f"selftest FAIL={fails}", file=sys.stderr)
        return 1
    print("selftest ok")
    return 0


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.selftest:
        return selftest()
    try:
        if not args.a or not args.b:
            raise WaneError("usage: wane A B")
        repo = resolve_repo(args.repo)
        side_a = resolve_side(repo, args.a)
        side_b = resolve_side(repo, args.b)
        pathspecs = list(args.paths)
        tree_a = load_tree(repo, side_a, pathspecs)
        tree_b = load_tree(repo, side_b, pathspecs)

        if tree_a.paths == tree_b.paths and all(
            tree_a.paths[p] == tree_b.paths.get(p) for p in tree_a.paths
        ):
            if not args.quiet:
                if args.json:
                    print(
                        json.dumps(
                            {
                                "repo": repo,
                                "a": _side_json(side_a),
                                "b": _side_json(side_b),
                                "identical": True,
                                "wane": [],
                            },
                            indent=2,
                            ensure_ascii=False,
                        )
                    )
                else:
                    eprint(f"wane: {side_a.short} and {side_b.short} are identical")
            return 1

        only_a = sorted(p for p in tree_a.paths if p not in tree_b.paths)
        only_b = sorted(p for p in tree_b.paths if p not in tree_a.paths)
        changed = sorted(
            p
            for p in tree_a.paths
            if p in tree_b.paths and tree_a.paths[p] != tree_b.paths[p]
        )
        same = len(tree_a.paths) - len(only_a) - len(changed)
        delta = {
            "deleted": len(only_a),
            "added": len(only_b),
            "changed": len(changed),
            "same": same,
        }
        universe = {p for p in (only_a + only_b + changed) if is_source_path(p)}

        grain = args.grain
        with_fn = bool(args.with_fn)
        stacks_a = discover_tree_stacks(tree_a, grain=grain, with_fn=with_fn)
        stacks_b = discover_tree_stacks(tree_b, grain=grain, with_fn=with_fn)
        distinguishing = merge_stacks(stacks_a, stacks_b, universe)
        lim = args.limit if args.limit >= 0 else 8
        covering = dead_cover(
            distinguishing, only_a, changed, limit=lim, also_changed=args.also_changed
        )
        covered: set[str] = set()
        for s in covering:
            covered.update(s.covers)
        # Unexplained deaths: exclusive-A files with no named dead stack.
        # Born-only and AB leftovers are out of wane's universe on purpose.
        unexplained = [p for p in sorted(only_a) if is_source_path(p) and p not in covered]
        non_source = [
            p
            for p in only_a
            if not is_source_path(p) and not skip_token_path(p)
        ]

        force_full: bool | None = True if args.full else None
        walks: list[dict] = []
        if not args.no_walks:
            walks = build_walks(
                repo,
                side_a,
                side_b,
                covering,
                force_full=force_full,
            )

        occupies: list[OccupyReport | None] = [None] * len(covering)
        if not args.no_occupy and covering and (side_a.kind == "commit" or side_b.kind == "commit"):
            tip = _walk_tip(side_a, side_b)
            adjacent = _adjacent_commits(repo, side_a, side_b)
            now = bool(args.now) or side_a.kind == "worktree" or side_b.kind == "worktree"
            sample_cache: dict[tuple[bool, int | None], list[Sample]] = {}
            for i, stack in enumerate(covering):
                full = (
                    True
                    if force_full is True
                    else (
                        False
                        if force_full is False
                        else needs_full_walk(repo, side_a, side_b, stack)
                    )
                )
                occ_limit = args.occupy_limit
                if occ_limit is None and adjacent and not full:
                    occ_limit = 12
                cache_key = (not full, occ_limit)
                if cache_key not in sample_cache:
                    if tip is None:
                        sample_cache[cache_key] = []
                    else:
                        sample_cache[cache_key] = list_samples(
                            repo,
                            end_rev=tip.sha,
                            first_parent=not full,
                            limit=occ_limit,
                        )
                samples = list(sample_cache[cache_key])
                if now:
                    samples = list(samples) + [worktree_sample(repo)]
                if not samples:
                    continue
                occupies[i] = occupy_stack(
                    repo,
                    stack,
                    samples=samples,
                    grain=grain,
                    with_fn=with_fn,
                    split_holders=not args.boolean,
                    end_rev=tip.sha if tip else "",
                    first_parent=not full,
                )

        if not args.quiet:
            if args.json:
                print(
                    json.dumps(
                        {
                            "repo": repo,
                            "a": _side_json(side_a),
                            "b": _side_json(side_b),
                            "identical": False,
                            "delta": {
                                **delta,
                                "paths": {
                                    "only_a": only_a,
                                    "only_b": only_b,
                                    "changed": changed,
                                },
                            },
                            "wane": [
                                stack_to_json(s, o) for s, o in zip(covering, occupies)
                            ],
                            "walks": walks,
                            "unexplained": unexplained,
                            "non_source": non_source,
                            "discovered": len(distinguishing),
                        },
                        indent=2,
                        ensure_ascii=False,
                    )
                )
            elif args.walks:
                text = "\n".join(item["line"] for item in walks)
                if text:
                    print(text)
            elif args.oneline:
                text = format_oneline(covering)
                if text:
                    print(text)
            else:
                print(
                    format_human(
                        repo=repo,
                        a=side_a,
                        b=side_b,
                        delta=delta,
                        covering=covering,
                        unexplained=unexplained + non_source[:8],
                        walks=[] if args.no_walks else walks,
                        occupies=occupies,
                        color=color_enabled(args),
                    )
                )
        return 0
    except WaneError as exc:
        eprint(f"wane: {exc}")
        return exc.code
    except KeyboardInterrupt:
        eprint("wane: interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
