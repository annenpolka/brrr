class Fail(Exception):
    pass


def _assert(cond: bool, msg: str) -> None:
    if not cond:
        raise Fail(msg)


def selftest() -> int:
    n = 0

    def check(name: str, fn) -> None:
        nonlocal n
        fn()
        n += 1
        print(f"PASS  {name}")

    def test_no_spawn() -> None:
        _assert("subprocess" not in sys.modules, "subprocess imported")
        src = open(__file__, encoding="utf-8").read()
        tree = ast.parse(src)
        imported: set[str] = set()
        called: set[str] = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                imported.update(a.name.split(".")[0] for a in node.names)
            elif isinstance(node, ast.ImportFrom) and node.module:
                imported.add(node.module.split(".")[0])
            elif isinstance(node, ast.Call):
                fn = node.func
                if isinstance(fn, ast.Name):
                    called.add(fn.id)
                elif isinstance(fn, ast.Attribute):
                    called.add(fn.attr)
                    if isinstance(fn.value, ast.Name):
                        called.add(f"{fn.value.id}.{fn.attr}")
        _assert("subprocess" not in imported, f"imports {imported}")
        _assert("Popen" not in called, f"called {called}")
        _assert("os.system" not in called and "system" not in called, f"called {called}")
        _assert("posix_spawn" not in called, f"called {called}")

    def test_aliases() -> None:
        _assert(canon("monotonic") == "CLOCK_MONOTONIC", "monotonic is POSIX, not python")
        _assert(canon("time.monotonic") == "python.monotonic", "time.monotonic is python")
        _assert(canon("raw") == "CLOCK_MONOTONIC_RAW", "raw")
        _assert(canon("machine") == "CLOCK_MONOTONIC_RAW", "scarp machine = RAW")
        _assert(canon("awake") == "CLOCK_UPTIME_RAW", "scarp awake = UPTIME_RAW")

    def test_synthetic() -> None:
        slew = classify_pair(
            "CLOCK_MONOTONIC",
            "CLOCK_MONOTONIC_RAW",
            {
                "CLOCK_MONOTONIC": 92.5,
                "CLOCK_MONOTONIC_RAW": 100.0,
                "CLOCK_UPTIME_RAW": 100.0,
                "CLOCK_REALTIME": 1_000_000_092.5,
                "kern.boottime": 1_000_000_000.0,
            },
        )
        _assert(slew.primary == "SLEW", f"slew got {slew.primary}")
        _assert(abs((slew.delta or 0) - (-7.5)) < 1e-9, f"slew Δ {slew.delta}")

        sleep = classify_pair(
            "CLOCK_MONOTONIC_RAW",
            "CLOCK_UPTIME_RAW",
            {
                "CLOCK_MONOTONIC_RAW": 100.0,
                "CLOCK_UPTIME_RAW": 10.0,
                "CLOCK_MONOTONIC": 100.0,
            },
        )
        _assert(sleep.primary == "SLEEP", f"sleep got {sleep.primary}")
        _assert(abs((sleep.delta or 0) - 90) < 1e-9, f"sleep Δ {sleep.delta}")

        rest = classify_pair(
            "CLOCK_MONOTONIC",
            "CLOCK_MONOTONIC_RAW",
            {"CLOCK_MONOTONIC": 100.0, "CLOCK_MONOTONIC_RAW": 100.0000004},
        )
        _assert(rest.primary == "REST", f"tiny slew {rest.primary} Δ={rest.delta}")

        py = classify_pair(
            "python.monotonic",
            "CLOCK_UPTIME_RAW",
            {"python.monotonic": 50.0, "CLOCK_UPTIME_RAW": 50.0},
        )
        _assert(py.primary == "REST", f"python vs UPTIME {py.primary}")

        # v0.2: wall vs RAW with MONOTONIC witness is SLEW (same 7.5s).
        wall_raw = classify_pair(
            "CLOCK_REALTIME",
            "CLOCK_MONOTONIC_RAW",
            {
                "CLOCK_MONOTONIC": 92.5,
                "CLOCK_MONOTONIC_RAW": 100.0,
                "CLOCK_UPTIME_RAW": 100.0,
                "CLOCK_REALTIME": 1_000_000_092.5,
                "kern.boottime": 1_000_000_000.0,
            },
        )
        _assert(
            wall_raw.primary == "SLEW",
            f"wall−RAW should be SLEW, got {wall_raw.primary} Δ={wall_raw.delta} step={wall_raw.step}",
        )
        _assert("STEP" not in wall_raw.tags, f"tags {wall_raw.tags}")

        # scarp cut: no CLOCK_MONOTONIC. Still SLEW, not NTP STEP.
        scarp_ntp = classify_pair(
            "CLOCK_REALTIME",
            "CLOCK_MONOTONIC_RAW",
            {
                "CLOCK_MONOTONIC_RAW": 100.0,
                "CLOCK_UPTIME_RAW": 100.0,
                "CLOCK_REALTIME": 1_000_000_092.5,
                "kern.boottime": 1_000_000_000.0,
            },
        )
        _assert(
            scarp_ntp.primary == "SLEW",
            f"scarp-shaped wall−RAW {scarp_ntp.primary} (must not be STEP/NTP)",
        )

        wall_mono = classify_pair(
            "CLOCK_REALTIME",
            "CLOCK_MONOTONIC",
            {
                "CLOCK_MONOTONIC": 92.5,
                "CLOCK_MONOTONIC_RAW": 100.0,
                "CLOCK_REALTIME": 1_000_000_092.5,
                "kern.boottime": 1_000_000_000.0,
            },
        )
        _assert(wall_mono.primary == "REST", f"wall−MONOTONIC {wall_mono.primary} Δ={wall_mono.delta}")

        jumped = classify_pair(
            "CLOCK_REALTIME",
            "CLOCK_MONOTONIC",
            {
                "CLOCK_MONOTONIC": 100.0,
                "CLOCK_MONOTONIC_RAW": 100.0,
                "CLOCK_REALTIME": 1_000_000_104.0,
                "kern.boottime": 1_000_000_000.0,
            },
        )
        _assert(jumped.primary == "STEP", f"true jump {jumped.primary} Δ={jumped.delta}")
        _assert(abs((jumped.delta or 0) - 4) < 1e-9, f"jump 4s {jumped.delta}")

        # jump vs RAW still STEP: MONOTONIC witness shows the 4s is not slew.
        jumped_raw = classify_pair(
            "CLOCK_REALTIME",
            "CLOCK_MONOTONIC_RAW",
            {
                "CLOCK_MONOTONIC": 100.0,
                "CLOCK_MONOTONIC_RAW": 100.0,
                "CLOCK_REALTIME": 1_000_000_104.0,
                "kern.boottime": 1_000_000_000.0,
            },
        )
        _assert(
            jumped_raw.primary == "STEP",
            f"jump vs RAW {jumped_raw.primary} step={jumped_raw.step} slew={jumped_raw.slew}",
        )

    def test_parse_scarp_cut() -> None:
        text = (
            "wall\t1000000092.5\n"
            "machine\t100.0\n"
            "awake\t100.0\n"
            "python.monotonic\t100.0\n"
            "boottime\t1000000000.0\n"
        )
        clocks = parse_snapshot(text)
        _assert(clocks["CLOCK_REALTIME"] == 1000000092.5, clocks)
        _assert(clocks["CLOCK_MONOTONIC_RAW"] == 100.0, clocks)
        _assert("CLOCK_MONOTONIC" not in clocks, "scarp cut hides POSIX MONOTONIC")
        g = classify_default(clocks)
        _assert(g.primary == "SLEW", f"scarp-shaped cut {g.primary} pair={g.a} {g.b}")
        _assert("STEP" not in g.tags, f"scarp ntp must not become STEP: {g.tags}")

    def test_live() -> None:
        c = sample()
        _assert("CLOCK_REALTIME" in c and c["CLOCK_REALTIME"] > 1e9, "wall epoch")
        if PLATFORM != "darwin":
            return
        _assert("CLOCK_MONOTONIC" in c and "CLOCK_MONOTONIC_RAW" in c, "darwin clocks")
        _assert("CLOCK_UPTIME_RAW" in c, "uptime")
        _assert("kern.boottime" in c, "boottime")
        py = c["python.monotonic"]
        up = c["CLOCK_UPTIME_RAW"]
        _assert(abs(py - up) < 0.05, f"python.monotonic is UPTIME_RAW {py-up}")
        raw, mono = c["CLOCK_MONOTONIC_RAW"], c["CLOCK_MONOTONIC"]
        _assert(abs((c["CLOCK_REALTIME"] - c["kern.boottime"]) - mono) < 0.05, "wall-boot ≈ MONOTONIC")
        g = classify_pair("CLOCK_MONOTONIC", "CLOCK_MONOTONIC_RAW", c)
        _assert(g.primary == "SLEW", f"live POSIX vs RAW {g.primary} Δ={g.delta}")
        sleep = classify_pair("CLOCK_MONOTONIC_RAW", "CLOCK_UPTIME_RAW", c)
        _assert(sleep.primary == "SLEEP", f"live RAW vs UPTIME {sleep.primary}")
        rest = classify_pair("CLOCK_REALTIME", "CLOCK_MONOTONIC", c)
        _assert(rest.primary == "REST", f"live wall vs POSIX MONOTONIC {rest.primary} Δ={rest.delta}")
        wall_raw = classify_pair("CLOCK_REALTIME", "CLOCK_MONOTONIC_RAW", c)
        _assert(
            wall_raw.primary == "SLEW",
            f"live wall vs RAW {wall_raw.primary} (v0.1 called this STEP) Δ={wall_raw.delta} step={wall_raw.step}",
        )
        _assert("STEP" not in wall_raw.tags, f"live wall−RAW tags {wall_raw.tags}")
        _assert(
            abs((wall_raw.slew or 0) - (g.slew or 0)) < 0.05,
            f"wall−RAW slew {wall_raw.slew} vs MONOTONIC−RAW {g.slew}",
        )

    check("no spawn", test_no_spawn)
    check("aliases: monotonic is POSIX", test_aliases)
    check("synthetic SLEW/SLEEP/STEP/REST", test_synthetic)
    check("scarp cut has no CLOCK_MONOTONIC", test_parse_scarp_cut)
    check("live Darwin snapshot", test_live)
    print(f"selftest {n}/{n} passed  backend={PLATFORM}  yaw {VERSION}")
    return 0


