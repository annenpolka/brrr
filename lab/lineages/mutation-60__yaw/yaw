def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="yaw", add_help=False, usage=USAGE)
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--porcelain", action="store_true")
    p.add_argument("--explain", action="store_true")
    p.add_argument("--require", metavar="NAME")
    p.add_argument("--all", action="store_true")
    p.add_argument("--as", nargs=2, metavar=("A", "B"), dest="as_pair")
    p.add_argument("cmd", nargs="?", default="")
    p.add_argument("cmd_args", nargs="*")
    return p.parse_args(argv)


def emit_gap(g: Gap, ns: argparse.Namespace, stream) -> None:
    if ns.json:
        stream.write(format_json(g))
    elif ns.porcelain:
        stream.write(format_porcelain(g))
    elif ns.explain:
        stream.write(format_explain(g))
    else:
        stream.write(format_word(g))


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    ns = parse_args(argv)
    if ns.help:
        print(USAGE)
        return 0
    if ns.version:
        print(f"yaw {VERSION} backend={PLATFORM}")
        return 0

    cmd = ns.cmd or ""
    rest = list(ns.cmd_args)

    if cmd == "selftest":
        try:
            return selftest()
        except Fail as e:
            print(f"FAIL  {e}", file=sys.stderr)
            return 1

    if cmd == "clocks":
        sys.stdout.write(format_clocks(sample(), as_json=ns.json))
        return 0

    pair: tuple[str, str] | None = None
    if ns.as_pair:
        pair = (canon(ns.as_pair[0]), canon(ns.as_pair[1]))

    # yaw CLOCK_A CLOCK_B
    if cmd and cmd not in ("selftest", "clocks") and cmd != "--":
        try:
            a = canon(cmd)
            if not rest:
                print("yaw: need two clock names", file=sys.stderr)
                print(USAGE, file=sys.stderr)
                return 2
            b = canon(rest[0])
            pair = (a, b)
            cmd = ""
        except SystemExit as e:
            print(str(e), file=sys.stderr)
            return 2

    stdin_text = ""
    if not sys.stdin.isatty():
        stdin_text = sys.stdin.read()

    try:
        if stdin_text.strip():
            clocks = parse_snapshot(stdin_text, as_pair=pair)
            if ns.all:
                sys.stdout.write(format_all(clocks))
                return 0
            g = classify_default(clocks, pair=pair)
        else:
            clocks = sample()
            if ns.all:
                sys.stdout.write(format_all(clocks))
                return 0
            g = classify_default(clocks, pair=pair)
    except SystemExit as e:
        print(str(e), file=sys.stderr)
        return 1

    emit_gap(g, ns, sys.stdout)
    if ns.require:
        want = ns.require.strip().upper()
        if g.primary != want:
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
