def _selftest() -> bool:
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(SnagTests)
    result = unittest.TextTestRunner(verbosity=1).run(suite)
    return result.wasSuccessful()


def _ops(edits: Sequence[Edit], cls: str) -> list[tuple[str, str, str]]:
    return [(e.op, e.old, e.new) for e in edits if e.cls == cls and e.op != "mov"]


class SnagTests(unittest.TestCase):
    def test_number_only_change(self) -> None:
        e = edits_from_texts("timeout = 30\n", "timeout = 60\n", "x.rs")
        self.assertEqual(_ops(e, "number"), [("chg", "30", "60")])
        self.assertEqual(_ops(e, "ident"), [])
        self.assertEqual(_ops(e, "comment"), [])

    def test_comment_only_change(self) -> None:
        e = edits_from_texts("x = 1  // old default\n", "x = 1  // new default\n", "x.rs")
        self.assertEqual(_ops(e, "comment"), [("chg", "old default", "new default")])
        self.assertEqual(_ops(e, "number"), [])

    def test_mixed_line_splits_plies(self) -> None:
        e = edits_from_texts("timeout = 30  // seconds\n", "timeout = 60  // secs\n", "x.rs")
        self.assertEqual(_ops(e, "number"), [("chg", "30", "60")])
        self.assertEqual(_ops(e, "comment"), [("chg", "seconds", "secs")])
        self.assertEqual(_ops(e, "ident"), [])
        hits = hits_of(e, parse_forbid("number"), punct=False)
        self.assertEqual([(h.op, h.old, h.new) for h in hits], [("chg", "30", "60")])

    def test_comment_only_clears_forbid_number(self) -> None:
        e = edits_from_texts("x = 1 // a\n", "x = 1 // b\n", "x.rs")
        self.assertEqual(hits_of(e, parse_forbid("number"), punct=False), [])
        self.assertTrue(hits_of(e, parse_forbid("comment"), punct=False))

    def test_ident_rename_does_not_trip_number(self) -> None:
        e = edits_from_texts("fn foo() {}\n", "fn bar() {}\n", "x.rs")
        self.assertEqual(hits_of(e, parse_forbid("number"), punct=False), [])
        self.assertTrue(any(x.cls == "ident" for x in hits_of(e, parse_forbid("ident"), punct=False)))

    def test_whitespace_only_hidden(self) -> None:
        e = edits_from_texts("a=1\n", "a = 1\n", "x.rs")
        self.assertEqual(hits_of(e, parse_forbid("number"), punct=False), [])

    def test_docs_path_does_not_free_a_number(self) -> None:
        """Inversion of weft --only docs: README numbers still trip."""
        e = edits_from_texts("timeout is 30\n", "timeout is 60\n", "README.md")
        self.assertTrue(_ops(e, "number"))
        hits = hits_of(e, parse_forbid("number"), punct=False)
        self.assertTrue(any(x.cls == "number" for x in hits))

    def test_cjk_text_does_not_trip_number(self) -> None:
        e = edits_from_texts("契約は蒸留\n", "契約は資産\n", "AGENTS.md")
        self.assertTrue(_ops(e, "text"))
        self.assertEqual(hits_of(e, parse_forbid("number"), punct=False), [])

    def test_parse_unified_mixed(self) -> None:
        diff = """diff --git a/src.rs b/src.rs
--- a/src.rs
+++ b/src.rs
@@ -1,3 +1,3 @@
 fn main() {
-    let timeout = 30; // seconds
+    let timeout = 60; // secs
 }
"""
        files = parse_unified(diff)
        e = edits_from_diff(files)
        self.assertEqual(_ops(e, "number"), [("chg", "30", "60")])
        self.assertEqual(_ops(e, "comment"), [("chg", "seconds", "secs")])

    def test_skip_lockfile(self) -> None:
        diff = """diff --git a/Cargo.lock b/Cargo.lock
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1,2 +1,2 @@
-version = "0.5.1"
+version = "0.7.0"
"""
        files = parse_unified(diff)
        self.assertEqual(edits_from_diff(files), [])
        e = edits_from_diff(files, locks=True)
        self.assertTrue(_ops(e, "string"))

    def test_added_file_number_trips(self) -> None:
        diff = """diff --git a/n.rs b/n.rs
--- /dev/null
+++ b/n.rs
@@ -0,0 +1 @@
+fn hello() { let t = 30; }
"""
        files = parse_unified(diff)
        e = edits_from_diff(files, classes=("number",))
        hits = hits_of(e, parse_forbid("number"), punct=False)
        self.assertTrue(any(x.cls == "number" and x.new == "30" for x in hits))

    def test_aliases(self) -> None:
        self.assertEqual(parse_forbid("comments").classes, ("comment",))
        self.assertEqual(parse_forbid("number").classes, ("number",))
        self.assertIn("number", parse_forbid("code").classes)

    def test_comment_interior_number_trips(self) -> None:
        """v0.2: // timeout 30 → // timeout 60 peels to number 30→60."""
        e = edits_from_texts(
            "let timeout = 30; // timeout 30\n",
            "let timeout = 30; // timeout 60\n",
            "x.rs",
        )
        self.assertEqual(_ops(e, "number"), [("chg", "30", "60")])
        self.assertTrue(_ops(e, "comment"))
        hits = hits_of(e, parse_forbid("number"), punct=False)
        self.assertEqual([(h.op, h.old, h.new) for h in hits], [("chg", "30", "60")])

    def test_string_version_peels_to_number(self) -> None:
        e = edits_from_texts('version = "0.6.0"\n', 'version = "0.7.0"\n', "Cargo.toml")
        self.assertEqual(_ops(e, "string"), [("chg", "0.6.0", "0.7.0")])
        self.assertIn(("chg", "0.6", "0.7"), _ops(e, "number"))
        hits = hits_of(e, parse_forbid("number"), punct=False)
        self.assertTrue(any(h.old == "0.6" and h.new == "0.7" for h in hits))

    def test_markdown_fence_number_peels(self) -> None:
        old = "intro\n"
        new = "intro\n```bash\ndefault_bits = 2048\n```\n"
        e = edits_from_texts(old, new, "README.md")
        hits = hits_of(e, parse_forbid("number"), punct=False)
        self.assertTrue(any(h.new == "2048" for h in hits))

    def test_comment_rewrite_without_number_still_clears(self) -> None:
        e = edits_from_texts("x = 1 // timeout 30\n", "x = 1 // wait 30\n", "x.rs")
        self.assertEqual(hits_of(e, parse_forbid("number"), punct=False), [])

    def test_cli_mixed_number_trips(self) -> None:
        diff = """--- a/x.rs
+++ b/x.rs
@@ -1 +1 @@
-timeout = 30; // seconds
+timeout = 60; // secs
"""
        rc, out, err = _run_capture(["--forbid", "number"], stdin=diff)
        self.assertEqual(rc, 1, out + err)
        self.assertIn("snag TRIP", out)
        self.assertIn("number", out)
        self.assertIn("30", out)
        self.assertIn("60", out)
        self.assertNotIn("path\tline\tclass", out)

    def test_cli_comment_only_clears(self) -> None:
        diff = """--- a/x.rs
+++ b/x.rs
@@ -1 +1 @@
-x = 1 // a
+x = 1 // b
"""
        rc, out, err = _run_capture(["--forbid", "number"], stdin=diff)
        self.assertEqual(rc, 0, out + err)
        self.assertIn("snag CLEAR", out)
        self.assertNotIn("path\tline\tclass", out)

    def test_cli_readme_number_trips(self) -> None:
        diff = """--- a/README.md
+++ b/README.md
@@ -1 +1 @@
-timeout is 30
+timeout is 60
"""
        rc, out, err = _run_capture(["--forbid", "number"], stdin=diff)
        self.assertEqual(rc, 1, out + err)
        self.assertIn("30", out)
        self.assertIn("60", out)

    def test_cli_requires_forbid(self) -> None:
        rc, out, err = _run_capture([])
        self.assertEqual(rc, 2)
        self.assertIn("--forbid", err)

    def test_cli_emit_is_tsv_of_hits(self) -> None:
        diff = """--- a/x.rs
+++ b/x.rs
@@ -1 +1 @@
-timeout = 30; // seconds
+timeout = 60; // secs
"""
        rc, out, err = _run_capture(["--forbid", "number", "--emit"], stdin=diff)
        self.assertEqual(rc, 1)
        self.assertTrue(out.startswith("path\tline\tclass\top\told\tnew\n"))
        self.assertIn("number\tchg\t30\t60", out)
        self.assertNotIn("snag TRIP", out)
        self.assertNotIn("comment", out)

    def test_cli_quiet(self) -> None:
        diff = """--- a/x.rs
+++ b/x.rs
@@ -1 +1 @@
-x = 1
+x = 2
"""
        rc, out, err = _run_capture(["--forbid", "number", "-q"], stdin=diff)
        self.assertEqual(rc, 1)
        self.assertEqual(out, "")

    def test_cli_empty_clear(self) -> None:
        rc, out, err = _run_capture(["--forbid", "number"], stdin="")
        self.assertEqual(rc, 0, out + err)
        self.assertIn("snag CLEAR", out)

    def test_cli_comment_interior_trips(self) -> None:
        diff = """--- a/x.rs
+++ b/x.rs
@@ -1 +1 @@
-let timeout = 30; // timeout 30
+let timeout = 30; // timeout 60
"""
        rc, out, err = _run_capture(["--forbid", "number"], stdin=diff)
        self.assertEqual(rc, 1, out + err)
        self.assertIn("snag TRIP", out)
        self.assertIn("30", out)
        self.assertIn("60", out)

    def test_cli_string_version_trips(self) -> None:
        diff = """--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,2 +1,2 @@
 [package]
-version = "0.6.0"
+version = "0.7.0"
"""
        rc, out, err = _run_capture(["--forbid", "number"], stdin=diff)
        self.assertEqual(rc, 1, out + err)
        self.assertIn("0.6", out)
        self.assertIn("0.7", out)

    def test_cli_docs_pr_plus_timeout(self) -> None:
        diff = """diff --git a/README.md b/README.md
--- a/README.md
+++ b/README.md
@@ -1,2 +1,2 @@
 # retry
-timeout is 30 seconds
+timeout is 30 seconds (documented)
diff --git a/src.rs b/src.rs
--- a/src.rs
+++ b/src.rs
@@ -1,3 +1,3 @@
 fn main() {
-    let timeout = 30; // documented
+    let timeout = 60; // documented
 }
"""
        rc, out, err = _run_capture(["--forbid", "number"], stdin=diff)
        self.assertEqual(rc, 1, out + err)
        self.assertIn("30", out)
        self.assertIn("60", out)


def _run_capture(argv: list[str], stdin: str = "") -> tuple[int, str, str]:
    from contextlib import redirect_stderr, redirect_stdout
    from io import StringIO

    so, se = StringIO(), StringIO()
    old_in = sys.stdin
    try:
        sys.stdin = StringIO(stdin)
        with redirect_stdout(so), redirect_stderr(se):
            code = run(argv)
    except SystemExit as e:
        code = int(e.code) if e.code is not None else 0
    finally:
        sys.stdin = old_in
    return code, so.getvalue(), se.getvalue()


if __name__ == "__main__":
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    try:
        sys.exit(run())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
