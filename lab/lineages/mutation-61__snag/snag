#!/usr/bin/env python3
"""snag — one-class tripwire on a unified diff.

weft's default is --only CLASS: allow-list purity. snag inverts that.
--forbid CLASS exits 1 if that ply moved, even when the rest of the
patch is comments or docs. Numbers that hid inside a comment or string
still count. stdin is a unified diff. TSV only on --emit.
"""
from __future__ import annotations

import argparse
import re
import signal
import sys
import unicodedata
import unittest
from dataclasses import dataclass, field
from difflib import SequenceMatcher
from typing import Sequence

VERSION = "0.2"

CLASSES = (
    "ident",
    "kw",
    "number",
    "string",
    "comment",
    "key",
    "import",
    "text",
    "punct",
    "space",
)
CLASS_SET = set(CLASSES)
NOISE = frozenset({"space"})
LOCK_BASENAMES = frozenset(
    {
        "Cargo.lock",
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "go.sum",
        "composer.lock",
        "Gemfile.lock",
        "poetry.lock",
        "Pipfile.lock",
        "flake.lock",
        "bun.lock",
        "bun.lockb",
    }
)

KEYWORDS = frozenset(
    """
    if else elif for while do return break continue yield
    fn def function class struct enum impl trait union
    let var const mut pub async await static
    import from use export include require package module mod
    true false none null nil True False None
    try except catch finally throw raise
    in is not and or
    match case switch default
    type interface where self Self this
    public private protected internal
    new delete sizeof typeof instanceof
    with as of from
    pass lambda
    crate super
    """.split()
)
PREPROCESSOR = frozenset(
    "include define undef ifdef ifndef endif pragma once line error warning".split()
)
_IMPORT_HEADS = frozenset({"import", "from", "use", "require", "include", "export", "mod"})

# --forbid aliases. "docs" is not a path glob: it means comment+text tokens.
# Path never frees a hit. That is the inversion of weft --only docs.
ALIAS = {
    "comments": ("comment",),
    "comment": ("comment",),
    "docs": ("comment", "text"),
    "prose": ("comment", "text"),
    "code": ("ident", "kw", "number", "string", "key", "import"),
}


# ---------------------------------------------------------------------------
# dialects / lexer (same typed token as weft/ply)
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Dialect:
    name: str
    line_comment: tuple[str, ...] = ()
    block_comment: tuple[tuple[str, str], ...] = ()
    json_keys: bool = False
    hash_ok: bool = False
    triple: bool = False


def dialect_for(path: str) -> Dialect:
    name = path.replace("\\", "/").rsplit("/", 1)[-1]
    ext = name.lower()
    ext = ext.rsplit(".", 1)[-1] if "." in ext else ext
    if name in {"Makefile", "makefile", "GNUmakefile", "Dockerfile"}:
        return Dialect("hash", line_comment=("#",), hash_ok=True)
    if ext in {"py", "pyi"}:
        return Dialect("python", line_comment=("#",), hash_ok=True, triple=True)
    if ext in {
        "sh",
        "bash",
        "zsh",
        "rb",
        "r",
        "pl",
        "ps1",
        "toml",
        "yml",
        "yaml",
        "mak",
        "mk",
        "cfg",
        "ini",
        "env",
        "gitignore",
        "dockerignore",
    }:
        return Dialect("hash", line_comment=("#",), hash_ok=True)
    if ext == "hs":
        return Dialect("haskell", line_comment=("--",), block_comment=(("{-", "-}"),))
    if ext in {"lua", "sql"}:
        return Dialect("dash", line_comment=("--",), block_comment=(("/*", "*/"),))
    if ext in {"html", "xml", "svg", "xhtml"}:
        return Dialect("html", block_comment=(("<!--", "-->"),))
    if ext in {"md", "markdown", "rst"}:
        return Dialect("md", block_comment=(("<!--", "-->"),))
    if ext in {"json"}:
        return Dialect("json", json_keys=True)
    if ext in {"jsonc", "json5"}:
        return Dialect("jsonc", line_comment=("//",), block_comment=(("/*", "*/"),), json_keys=True)
    if ext in {
        "rs",
        "c",
        "h",
        "cc",
        "hh",
        "cpp",
        "hpp",
        "go",
        "java",
        "js",
        "mjs",
        "cjs",
        "ts",
        "tsx",
        "jsx",
        "css",
        "scss",
        "swift",
        "kt",
        "kts",
        "scala",
        "cs",
        "m",
        "mm",
        "pkl",
    }:
        return Dialect("c", line_comment=("//",), block_comment=(("/*", "*/"),))
    return Dialect("c", line_comment=("//",), block_comment=(("/*", "*/"),))


@dataclass(frozen=True)
class Token:
    cls: str
    value: str
    line: int
    col: int


_IDENT = re.compile(r"[A-Za-z_$@][A-Za-z0-9_$@]*")
_NUMBER = re.compile(
    r"(?:"
    r"0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*"
    r"|0[bB][01](?:_?[01])*"
    r"|0[oO][0-7](?:_?[0-7])*"
    r"|\d+(?:_\d+)*(?:\.\d+(?:_\d+)*)?(?:[eE][+-]?\d+)?"
    r")"
)


def _starts(src: str, i: int, needle: str) -> bool:
    return src.startswith(needle, i)


def lex(src: str, dialect: Dialect, start_line: int = 1) -> list[Token]:
    out: list[Token] = []
    i = 0
    n = len(src)
    line = start_line
    col = 1
    line_start = True

    def emit(cls: str, val: str, at_line: int, at_col: int) -> None:
        if val == "":
            return
        out.append(Token(cls, val, at_line, at_col))

    def bump(k: int) -> None:
        nonlocal i, line, col, line_start
        for ch in src[i : i + k]:
            if ch == "\n":
                line += 1
                col = 1
                line_start = True
            else:
                col += 1
                if not ch.isspace():
                    line_start = False
        i += k

    while i < n:
        ch = src[i]
        sl, sc = line, col

        if ch.isspace():
            j = i
            while j < n and src[j].isspace():
                j += 1
            emit("space", src[i:j], sl, sc)
            bump(j - i)
            continue

        consumed = False
        for open_, close in dialect.block_comment:
            if _starts(src, i, open_):
                j = src.find(close, i + len(open_))
                if j < 0:
                    val = src[i:]
                    emit("comment", _comment_body(val, open_, close), sl, sc)
                    bump(len(val))
                else:
                    val = src[i : j + len(close)]
                    emit("comment", _comment_body(val, open_, close), sl, sc)
                    bump(len(val))
                consumed = True
                break
        if consumed:
            continue

        for mark in dialect.line_comment:
            if _starts(src, i, mark):
                if mark == "#" and not dialect.hash_ok:
                    break
                j = src.find("\n", i)
                if j < 0:
                    j = n
                raw = src[i:j]
                emit("comment", raw[len(mark) :].strip(), sl, sc)
                bump(j - i)
                consumed = True
                break
        if consumed:
            continue

        if ch == "#" and not dialect.hash_ok:
            emit("punct", "#", sl, sc)
            bump(1)
            continue

        if dialect.triple and _starts(src, i, '"""'):
            tok, k = _read_triple(src, i, '"""')
            emit("string", tok, sl, sc)
            bump(k)
            continue
        if dialect.triple and _starts(src, i, "'''"):
            tok, k = _read_triple(src, i, "'''")
            emit("string", tok, sl, sc)
            bump(k)
            continue

        if ch in ("'", '"', "`"):
            tok, k = _read_string(src, i, ch)
            emit("string", tok, sl, sc)
            bump(k)
            continue

        m = _NUMBER.match(src, i)
        if m and not (i > 0 and (src[i - 1].isalnum() or src[i - 1] in "_$")):
            emit("number", m.group(0), sl, sc)
            bump(m.end() - i)
            continue

        m = _IDENT.match(src, i)
        if m:
            val = m.group(0)
            cls = "kw" if val in KEYWORDS else "ident"
            emit(cls, val, sl, sc)
            bump(m.end() - i)
            continue

        if ord(ch) > 127 and unicodedata.category(ch).startswith("L"):
            j = i + 1
            while j < n:
                cj = unicodedata.category(src[j])
                if cj.startswith("L") or cj in {"Mn", "Mc", "Lm"} or src[j] in "ー々〆ゝゞ":
                    j += 1
                else:
                    break
            emit("text", src[i:j], sl, sc)
            bump(j - i)
            continue

        multi = (
            ">>=",
            "<<=",
            "&&=",
            "||=",
            "...",
            "..=",
            "==",
            "!=",
            "<=",
            ">=",
            "&&",
            "||",
            "->",
            "=>",
            "::",
            "<<",
            ">>",
            "++",
            "--",
            "+=",
            "-=",
            "*=",
            "/=",
            "%=",
            "&=",
            "|=",
            "^=",
            "//",
        )
        hit = None
        for op in multi:
            if _starts(src, i, op):
                if op == "//" and "//" in dialect.line_comment:
                    continue
                hit = op
                break
        if hit:
            emit("punct", hit, sl, sc)
            bump(len(hit))
            continue
        emit("punct", ch, sl, sc)
        bump(1)

    tagged = _tag_imports(out)
    if dialect.json_keys:
        tagged = _tag_json_keys(tagged)
    return tagged


def _comment_body(raw: str, open_: str, close: str) -> str:
    s = raw
    if s.startswith(open_):
        s = s[len(open_) :]
    if close and s.endswith(close):
        s = s[: -len(close)]
    return s.strip()


def _read_string(src: str, i: int, quote: str) -> tuple[str, int]:
    n = len(src)
    j = i + 1
    out = []
    while j < n:
        c = src[j]
        if c == "\\":
            if j + 1 < n:
                out.append(src[j : j + 2])
                j += 2
                continue
            out.append(c)
            j += 1
            continue
        if c == quote:
            return "".join(out), (j + 1 - i)
        if c == "\n" and quote != "`":
            return "".join(out), (j - i)
        out.append(c)
        j += 1
    return "".join(out), (n - i)


def _read_triple(src: str, i: int, quote: str) -> tuple[str, int]:
    j = i + len(quote)
    k = src.find(quote, j)
    if k < 0:
        return src[j:], (len(src) - i)
    return src[j:k], (k + len(quote) - i)


def _tag_imports(tokens: Sequence[Token]) -> list[Token]:
    by_line: dict[int, list[int]] = {}
    for idx, t in enumerate(tokens):
        by_line.setdefault(t.line, []).append(idx)
    out = list(tokens)
    for idxs in by_line.values():
        heads = [tokens[i] for i in idxs if tokens[i].cls != "space"]
        if not heads:
            continue
        h0 = heads[0]
        is_import = (h0.cls in {"kw", "ident"} and h0.value in _IMPORT_HEADS) or (
            h0.cls == "punct" and h0.value == "#" and len(heads) > 1 and heads[1].value in PREPROCESSOR
        )
        if not is_import:
            continue
        for i in idxs:
            if out[i].cls == "string":
                out[i] = Token("import", out[i].value, out[i].line, out[i].col)
    return out


def _tag_json_keys(tokens: Sequence[Token]) -> list[Token]:
    out = list(tokens)
    n = len(out)
    for i, t in enumerate(out):
        if t.cls != "string":
            continue
        j = i + 1
        while j < n and out[j].cls == "space":
            j += 1
        if j < n and out[j].cls == "punct" and out[j].value == ":":
            out[i] = Token("key", t.value, t.line, t.col)
    return out


# ---------------------------------------------------------------------------
# unified diff
# ---------------------------------------------------------------------------


@dataclass
class Hunk:
    old_start: int
    new_start: int
    rows: list[tuple[str, str]]


@dataclass
class FileDiff:
    path: str
    old_path: str
    hunks: list[Hunk] = field(default_factory=list)
    status: str = "modified"


_HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def parse_unified(text: str) -> list[FileDiff]:
    files: list[FileDiff] = []
    cur: FileDiff | None = None
    hunk: Hunk | None = None
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("diff --git "):
            hunk = None
            parts = line.split()
            old = parts[2][2:] if len(parts) > 2 and parts[2].startswith("a/") else (parts[2] if len(parts) > 2 else "")
            new = parts[3][2:] if len(parts) > 3 and parts[3].startswith("b/") else (parts[3] if len(parts) > 3 else old)
            cur = FileDiff(path=new or old, old_path=old or new)
            files.append(cur)
            i += 1
            continue
        if line.startswith("Binary files ") or line.startswith("GIT binary patch"):
            if cur:
                cur.status = "binary"
            hunk = None
            i += 1
            continue
        if line.startswith("--- "):
            oldp = _strip_ab(line[4:])
            if cur is None:
                cur = FileDiff(path=oldp, old_path=oldp)
                files.append(cur)
            else:
                cur.old_path = oldp if oldp != "/dev/null" else cur.old_path
            if oldp == "/dev/null" and cur:
                cur.status = "added"
            i += 1
            continue
        if line.startswith("+++ "):
            newp = _strip_ab(line[4:])
            if cur is None:
                cur = FileDiff(path=newp, old_path=newp)
                files.append(cur)
            else:
                if newp != "/dev/null":
                    cur.path = newp
            if newp == "/dev/null" and cur:
                cur.status = "deleted"
            i += 1
            continue
        m = _HUNK_RE.match(line)
        if m:
            if cur is None:
                cur = FileDiff(path="?", old_path="?")
                files.append(cur)
            hunk = Hunk(old_start=int(m.group(1)), new_start=int(m.group(3)), rows=[])
            cur.hunks.append(hunk)
            i += 1
            continue
        if hunk is not None and line[:1] in {" ", "-", "+", "\\"}:
            tag = line[:1]
            body = line[1:] if tag != "\\" else line
            if tag == "\\":
                i += 1
                continue
            hunk.rows.append((tag, body))
            i += 1
            continue
        i += 1
    return files


def _strip_ab(s: str) -> str:
    s = s.strip()
    if "\t" in s:
        s = s.split("\t", 1)[0]
    if s.startswith("a/") or s.startswith("b/"):
        return s[2:]
    return s


def hunk_side(hunk: Hunk, minus: bool) -> tuple[str, int]:
    parts: list[str] = []
    want = "-" if minus else "+"
    for tag, body in hunk.rows:
        if tag == " " or tag == want:
            parts.append(body)
    start = hunk.old_start if minus else hunk.new_start
    return "\n".join(parts), start


# ---------------------------------------------------------------------------
# projection
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Edit:
    path: str
    line: int
    cls: str
    op: str
    old: str
    new: str
    new_line: int = 0


def project_edits(old: Sequence[Token], new: Sequence[Token], path: str, classes: Sequence[str]) -> list[Edit]:
    edits: list[Edit] = []
    for cls in classes:
        a = [t for t in old if t.cls == cls]
        b = [t for t in new if t.cls == cls]
        edits.extend(_script(a, b, path, cls))
    return _collapse_moves(edits)


def _script(a: Sequence[Token], b: Sequence[Token], path: str, cls: str) -> list[Edit]:
    if not a and not b:
        return []
    sm = SequenceMatcher(a=[t.value for t in a], b=[t.value for t in b], autojunk=False)
    out: list[Edit] = []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            continue
        if tag == "delete":
            for t in a[i1:i2]:
                out.append(Edit(path, t.line, cls, "del", t.value, "", 0))
        elif tag == "insert":
            for t in b[j1:j2]:
                out.append(Edit(path, t.line, cls, "ins", "", t.value, t.line))
        elif tag == "replace":
            olds = list(a[i1:i2])
            news = list(b[j1:j2])
            n = min(len(olds), len(news))
            one_slot = len(olds) == 1 and len(news) == 1
            for k in range(n):
                if olds[k].value == news[k].value:
                    continue
                if cls == "number" or one_slot or _similar(olds[k].value, news[k].value, cls):
                    out.append(Edit(path, news[k].line, cls, "chg", olds[k].value, news[k].value, news[k].line))
                else:
                    out.append(Edit(path, olds[k].line, cls, "del", olds[k].value, "", 0))
                    out.append(Edit(path, news[k].line, cls, "ins", "", news[k].value, news[k].line))
            for t in olds[n:]:
                out.append(Edit(path, t.line, cls, "del", t.value, "", 0))
            for t in news[n:]:
                out.append(Edit(path, t.line, cls, "ins", "", t.value, t.line))
    return out


def _similar(a: str, b: str, cls: str) -> bool:
    if cls in {"kw", "punct", "space"}:
        return False
    if a == b:
        return True
    al, bl = a.lower(), b.lower()
    if al in bl or bl in al:
        return True
    if min(len(a), len(b)) >= 4 and SequenceMatcher(None, al, bl).ratio() >= 0.55:
        return True
    return False


def _collapse_moves(edits: list[Edit]) -> list[Edit]:
    unused_ins: dict[tuple[str, str, str], list[int]] = {}
    ins_list = [e for e in edits if e.op == "ins"]
    for idx, e in enumerate(ins_list):
        unused_ins.setdefault((e.path, e.cls, e.new), []).append(idx)
    used_ins = [False] * len(ins_list)
    consumed_del = [False] * len(edits)
    result: list[Edit] = []
    for i, e in enumerate(edits):
        if e.op != "del":
            continue
        key = (e.path, e.cls, e.old)
        bucket = unused_ins.get(key) or []
        found = None
        while bucket:
            j = bucket.pop(0)
            if not used_ins[j]:
                found = j
                break
        if found is None:
            continue
        used_ins[found] = True
        consumed_del[i] = True
        dest = ins_list[found]
        result.append(Edit(e.path, e.line, e.cls, "mov", e.old, dest.new, dest.line))
    ins_used_idx = set(j for j, u in enumerate(used_ins) if u)
    for i, e in enumerate(edits):
        if e.op == "del":
            if not consumed_del[i]:
                result.append(e)
        elif e.op == "ins":
            continue
        elif e.op in {"chg", "mov"}:
            result.append(e)
    ins_cursor = 0
    for e in edits:
        if e.op != "ins":
            continue
        if ins_cursor not in ins_used_idx:
            result.append(e)
        ins_cursor += 1
    return result


def is_lock_path(path: str) -> bool:
    base = path.replace("\\", "/").rsplit("/", 1)[-1]
    if base in LOCK_BASENAMES:
        return True
    if base.endswith(".lock") or base.endswith("-lock.json") or base.endswith(".lockb"):
        return True
    return False


# Comment / string / key / import bodies hide numbers from the surface lexer.
# weft named the miss: // timeout 30 → // timeout 60 is class comment.
# Markdown fences are one backtick-string; README 2048 lived in there.
_SHELLS = frozenset({"comment", "string", "key", "import"})


def peel_numbers(src: str, start_line: int) -> list[Token]:
    """Number tokens inside an already-classified shell (comment/string)."""
    out: list[Token] = []
    i = 0
    n = len(src)
    line = start_line
    col = 1
    while i < n:
        if src[i] == "\n":
            line += 1
            col = 1
            i += 1
            continue
        m = _NUMBER.match(src, i)
        if m and not (i > 0 and (src[i - 1].isalnum() or src[i - 1] in "_$")):
            out.append(Token("number", m.group(0), line, col))
            span = m.end() - i
            col += span
            i = m.end()
            continue
        i += 1
        col += 1
    return out


def interior_numbers(tokens: Sequence[Token]) -> list[Token]:
    out: list[Token] = []
    for t in tokens:
        if t.cls in _SHELLS:
            out.extend(peel_numbers(t.value, t.line))
    return out


def project_with_peel(
    old: Sequence[Token],
    new: Sequence[Token],
    path: str,
    classes: Sequence[str],
) -> list[Edit]:
    edits = project_edits(old, new, path, classes)
    if "number" in classes:
        edits.extend(_script(interior_numbers(old), interior_numbers(new), path, "number"))
    return _collapse_moves(edits)


def edits_from_diff(
    files: Sequence[FileDiff],
    *,
    locks: bool = False,
    classes: Sequence[str] | None = None,
) -> list[Edit]:
    """Project the requested classes. Added/deleted bodies are in the gate."""
    want = list(classes) if classes is not None else [c for c in CLASSES if c != "space"]
    out: list[Edit] = []
    for fd in files:
        if fd.status == "binary":
            continue
        if not locks and is_lock_path(fd.path or fd.old_path):
            continue
        dialect = dialect_for(fd.path if fd.path != "/dev/null" else fd.old_path)
        for h in fd.hunks:
            old_txt, old_start = hunk_side(h, True)
            new_txt, new_start = hunk_side(h, False)
            old_toks = lex(old_txt, dialect, old_start)
            new_toks = lex(new_txt, dialect, new_start)
            out.extend(project_with_peel(old_toks, new_toks, fd.path, want))
    return _collapse_moves(out)


def edits_from_texts(old: str, new: str, path: str, classes: Sequence[str] | None = None) -> list[Edit]:
    dialect = dialect_for(path)
    want = list(classes) if classes is not None else [c for c in CLASSES if c != "space"]
    return project_with_peel(lex(old, dialect, 1), lex(new, dialect, 1), path, want)


# ---------------------------------------------------------------------------
# tripwire (invert of weft's allow-list)
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Forbidden:
    classes: tuple[str, ...]


def parse_forbid(spec: str) -> Forbidden:
    if not spec or not spec.strip():
        raise SystemExit("snag: --forbid is required (number, ident, string, comment, …)")
    out: list[str] = []
    for part in spec.split(","):
        p = part.strip().lower()
        if not p:
            continue
        if p in {"all"}:
            out.extend(c for c in CLASSES if c not in NOISE)
            continue
        if p in ALIAS:
            out.extend(ALIAS[p])
            continue
        if p not in CLASS_SET:
            raise SystemExit(
                f"snag: unknown class {p!r} (want {', '.join(CLASSES)}, comments, code, all)"
            )
        out.append(p)
    seen = set()
    uniq = []
    for c in out:
        if c not in seen:
            seen.add(c)
            uniq.append(c)
    if not uniq:
        raise SystemExit("snag: --forbid is empty")
    return Forbidden(tuple(uniq))


def is_hit(edit: Edit, forbidden: Forbidden, *, punct: bool) -> bool:
    """A hit is a ply of a forbidden class. Path never frees it. Moves do not trip."""
    if edit.op == "mov":
        return False
    if edit.cls in NOISE and "space" not in forbidden.classes:
        return False
    if edit.cls == "punct" and not punct and "punct" not in forbidden.classes:
        return False
    return edit.cls in set(forbidden.classes)


def hits_of(edits: Sequence[Edit], forbidden: Forbidden, *, punct: bool) -> list[Edit]:
    out = [e for e in edits if is_hit(e, forbidden, punct=punct)]
    out.sort(key=lambda e: (e.path, e.line, e.cls, e.op))
    return out


def count_classes(edits: Sequence[Edit]) -> dict[str, int]:
    c: dict[str, int] = {}
    for e in edits:
        c[e.cls] = c.get(e.cls, 0) + 1
    return c


def render_verdict(hits: Sequence[Edit], forbid: str, origin: str, extra: Sequence[str]) -> str:
    bits = [f"forbid={forbid}"]
    if origin:
        bits.append(origin)
    bits.extend(extra)
    if hits:
        bits.append(f"hits={len(hits)}")
        counts = count_classes(hits)
        for cls in CLASSES:
            if counts.get(cls):
                bits.append(f"{cls}={counts[cls]}")
        header = "snag TRIP  " + "  ".join(bits)
        rows = [header]
        cap = 32
        for e in hits[:cap]:
            rows.append(f"  {_fmt_edit(e)}")
        if len(hits) > cap:
            rows.append(f"  … and {len(hits) - cap} more")
        return "\n".join(rows) + "\n"
    bits.append("hits=0")
    return "snag CLEAR  " + "  ".join(bits) + "\n"


def _fmt_edit(e: Edit) -> str:
    if e.op == "chg":
        body = f"{_esc(e.old)} → {_esc(e.new)}"
    elif e.op == "del":
        body = _esc(e.old)
    else:
        body = _esc(e.new)
    return f"{e.path}:{e.line}  {e.cls}  {e.op}  {body}"


def _esc(s: str, width: int = 48) -> str:
    s = s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
    if len(s) > width:
        return s[: width - 1] + "…"
    return s


def render_tsv(edits: Sequence[Edit]) -> str:
    rows = ["path\tline\tclass\top\told\tnew"]
    for e in edits:
        rows.append(
            "\t".join(
                [
                    e.path,
                    str(e.line),
                    e.cls,
                    e.op,
                    e.old.replace("\t", "\\t").replace("\n", "\\n"),
                    e.new.replace("\t", "\\t").replace("\n", "\\n"),
                ]
            )
        )
    return "\n".join(rows) + "\n"


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="snag",
        description=(
            "One-class tripwire: a unified diff must not move --forbid CLASS. "
            "git diff | snag --forbid number exits 1 if a number ply leaked, "
            "even when the rest is comments or docs. TSV only on --emit."
        ),
        epilog="Read a unified diff on stdin. Example: git diff | snag --forbid number",
    )
    p.add_argument("input", nargs="?", help="unified diff file, or - for stdin")
    p.add_argument(
        "--forbid",
        default="",
        help="forbidden class(es): number, ident, string, comment, … (required)",
    )
    p.add_argument("--emit", action="store_true", help="print hits as TSV (no dump by default)")
    p.add_argument("-q", "--quiet", action="store_true", help="exit code only")
    p.add_argument("--punct", action="store_true", help="also trip on punctuation when it is forbidden")
    p.add_argument("--locks", action="store_true", help="include lockfiles")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="version", version=f"snag {VERSION}")
    return p


def run(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    p = build_parser()
    args = p.parse_args(argv)
    if args.selftest:
        return 0 if _selftest() else 1

    if not args.forbid:
        sys.stderr.write("snag: --forbid is required (number, ident, string, comment, …)\n")
        return 2

    if args.input is None and sys.stdin.isatty():
        p.print_help()
        sys.stderr.write("\nsnag: pass a unified diff on stdin, or a file path\n")
        return 2

    if args.input and args.input != "-":
        try:
            raw = open(args.input, encoding="utf-8", errors="replace").read()
        except OSError as e:
            sys.stderr.write(f"snag: {e}\n")
            return 2
        origin = args.input
    else:
        raw = sys.stdin.read()
        origin = "stdin"

    try:
        forbidden = parse_forbid(args.forbid)
    except SystemExit as e:
        msg = e.args[0] if e.args else str(e)
        if isinstance(msg, str) and msg.startswith("snag:"):
            sys.stderr.write(msg + "\n")
            return 2
        raise

    files = parse_unified(raw)
    # Project only the forbidden classes — the tripwire, not the dump.
    edits = edits_from_diff(files, locks=args.locks, classes=forbidden.classes)
    hits = hits_of(edits, forbidden, punct=args.punct)

    extra: list[str] = []
    if files:
        extra.append(f"files={len(files)}")
        n_lock = sum(1 for f in files if is_lock_path(f.path or f.old_path))
        if n_lock and not args.locks:
            extra.append(f"skipped_lock={n_lock}")

    if args.emit:
        sys.stdout.write(render_tsv(hits))
    elif not args.quiet:
        sys.stdout.write(render_verdict(hits, args.forbid, origin, extra))
    return 1 if hits else 0


