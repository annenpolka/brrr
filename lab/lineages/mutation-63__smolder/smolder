        ash=True,
        generator="npm",
        ash_reason="lockfile",
        claim="config",
    )
    check("lockfile dest is classified ash (regenerate, not blame)", ash_dest.ash and ash_dest.generator == "npm")

    both = """diff --git a/Cargo.lock b/Cargo.lock
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1,3 +1,3 @@
 [[package]]
 name = "kizu"
-version = "0.3.0"
+version = "0.3.1"
diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,3 @@
 [package]
 name = "kizu"
-version = "0.3.0"
+version = "0.3.1"
"""
    both_facts = extract_facts(parse_unified_diff(both), {"value"})
    check(
        "lockfile hunk is not a falsifying origin when Cargo.toml also moved",
        any(f.origin.path == "Cargo.toml" and f.old == "0.3.0" for f in both_facts)
        and not any(f.origin.path.endswith(".lock") for f in both_facts),
        str([(f.origin.path, f.old, f.new) for f in both_facts]),
    )
    lock_dest = Dest(
        path="plugin/plugin.json",
        line=4,
        text='{\n  "version": "0.3.0"\n}\n',
        body='  "version": "0.3.0",',
        excerpt='"version": "0.3.0",',
        nearby="",
        ash=False,
        generator=None,
        ash_reason="",
        claim="config",
    )
    both_hit = search_diff(
        lock_dest,
        both,
        {"value", "rename", "polarity", "string"},
        55,
        sha="DIFF",
        subject="supplied diff",
        when="",
        source="diff",
    )
    check(
        "kizu-shaped bump names Cargo.toml not Cargo.lock",
        both_hit is not None and both_hit.fact.origin.path == "Cargo.toml",
        str(both_hit.fact.origin.path if both_hit else None),
    )

    timeout_line = Dest(
        path="docs/help.txt",
        line=2,
        text="--timeout N   hook timeout seconds (default 10)\n",
        body="--timeout N   hook timeout seconds (default 10)",
        excerpt="--timeout N   hook timeout seconds (default 10)",
        nearby="",
        ash=False,
        generator=None,
        ash_reason="",
        claim="docs",
    )
    check(
        "named timeout seeds integer 10 (not a calendar month)",
        "10" in pickaxe_seeds(timeout_line),
        str(pickaxe_seeds(timeout_line)),
    )
    polar_line = Dest(
        path="README.md",
        line=9,
        text="Cache is enabled (`ENABLE_CACHE = True`).\n",
        body="Cache is enabled (`ENABLE_CACHE = True`).",
        excerpt="Cache is enabled (`ENABLE_CACHE = True`).",
        nearby="",
        ash=False,
        generator=None,
        ash_reason="",
        claim="docs",
    )
    polar_seeds = pickaxe_seeds(polar_line)
    check(
        "polarity True is a pickaxe seed (not dropped as a keyword)",
        "True" in polar_seeds or "true" in {s.lower() for s in polar_seeds},
        str(polar_seeds),
    )

    dual = """diff --git a/src/retry.py b/src/retry.py
--- a/src/retry.py
+++ b/src/retry.py
@@ -1,4 +1,4 @@
-MAX_RETRIES = 3
-HOOK_TIMEOUT = 10
+MAX_ATTEMPTS = 8
+HOOK_TIMEOUT = 30
"""
    dual_dest = Dest(
        path="docs/ja.md",
        line=1,
        text="タイムアウトは 10 秒です。MAX_RETRIES はまだ 3 のまま。\n",
        body="タイムアウトは 10 秒です。MAX_RETRIES はまだ 3 のまま。",
        excerpt="タイムアウトは 10 秒です。MAX_RETRIES はまだ 3 のまま。",
        nearby="",
        ash=False,
        generator=None,
        ash_reason="",
        claim="docs",
    )
    dual_hit = search_diff(
        dual_dest,
        dual,
        {"value", "rename", "polarity", "string"},
        55,
        sha="DIFF",
        subject="supplied diff",
        when="",
        source="diff",
    )
    dual_names = set()
    if dual_hit:
        dual_names.add((dual_hit.fact.kind, dual_hit.fact.old, dual_hit.fact.new))
        dual_names.update((fa.kind, fa.old, fa.new) for fa, _sc, _wh in dual_hit.also)
    check(
        "one dest line leftover-claims both rename and timeout",
        dual_hit is not None
        and ("rename", "MAX_RETRIES", "MAX_ATTEMPTS") in dual_names
        and any(old == "10" and new == "30" for _k, old, new in dual_names),
        str(dual_names),
    )

    return 1 if failures else 0


def main(argv: Sequence[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in {"self-test", "--self-test"}:
        return cmd_self_test()
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.version:
        print(f"{NAME} {VERSION}")
        return 0
    if args.min_score < 0:
        die("--min-score must be >= 0")
    if args.limit < 1:
        die("--limit must be >= 1")
    if args.max_commits < 1:
        die("--max-commits must be >= 1")

    root = Path(args.root).resolve()
    if not root.exists():
        die(f"root not found: {root}")

    kinds = parse_kinds(args.kinds)
    locators = read_locators(args)
    color = color_enabled(args, sys.stdout)
    results: list[tuple[Locator, Dest | None, list[Falsifier]]] = []
    json_rows: list[dict[str, object]] = []
    found_any = False
    tsv_header = False

    for loc in locators:
        dest = load_dest(root, loc, args.rev)
        if dest is None:
            if args.json:
                json_rows.append(
                    {
                        "locator": loc.raw,
                        "path": rel_path(root, loc.path),
                        "line": loc.line,
                        "status": "missing",
                        "action": "none",
                    }
                )
            elif args.tsv:
                if not tsv_header:
                    print(
                        "status\tpath\tline\taction\tcommit\tname\told\tnew\tkind\torigin\torigin_line\tscore\texcerpt"
                    )
                    tsv_header = True
                print(
                    f"missing\t{rel_path(root, loc.path)}\t{loc.line}\tnone\t\t\t\t\t\t\t\t\t"
                )
            else:
                print(f"{NAME}: missing  {rel_path(root, loc.path)}:{loc.line}", file=sys.stderr)
            results.append((loc, None, []))
            continue

        if dest.ash:
            found_any = True
            if args.json:
                json_rows.append(
                    {
                        **dest_json(dest),
                        "status": "ash",
                        "action": "regenerate",
                        "falsifiers": [],
                    }
                )
            elif args.tsv:
                if not tsv_header:
                    print(
                        "status\tpath\tline\taction\tcommit\tname\told\tnew\tkind\torigin\torigin_line\tscore\texcerpt"
                    )
                    tsv_header = True
                print_tsv_ash(dest)
            else:
                print_ash(dest, color=color)
            results.append((loc, dest, []))
            continue

        hits = find_falsifiers(root, dest, args, kinds)
        if hits:
            found_any = True
        if args.json:
            json_rows.append(
                {
                    **dest_json(dest),
                    "status": "leftover" if hits else "none",
                    "action": "falsified" if hits else "none",
                    "falsifiers": [
                        {
                            "sha": h.sha,
                            "subject": h.subject,
                            "when": h.when,
                            "source": h.source,
                            "score": h.score,
                            "why": list(h.why),
                            "fact": fact_json(h.fact),
                            "also": [
                                {
                                    "score": sc,
                                    "why": list(wh),
                                    "fact": fact_json(fa),
                                }
                                for fa, sc, wh in h.also
                            ],
                            "hunk": h.hunk,
                        }
                        for h in hits
                    ],
                }
            )
        elif args.tsv:
            if not tsv_header:
                print(
                    "status\tpath\tline\taction\tcommit\tname\told\tnew\tkind\torigin\torigin_line\tscore\texcerpt"
                )
                tsv_header = True
            if not hits:
                print_tsv_none(dest)
            else:
                for h in hits:
                    print_tsv_hit(dest, h)
        else:
            if hits:
                print_falsifiers(
                    dest, hits, explain=args.explain, color=color, show_hunk=not args.no_hunk
                )
            else:
                print_none(dest, color=color)
        results.append((loc, dest, hits))

    if args.json:
        print(
            json.dumps(
                {
                    "version": VERSION,
                    "root": str(root),
                    "results": json_rows,
                },
                indent=2,
                ensure_ascii=False,
            )
        )
    return 0 if found_any else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
