def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="wale",
        description=(
            "Locus-aware composition algebra of review-suggestion strands. "
            "ECHO is a locus, not image-identity. "
            "Not occupancy (plea/sate) and not GitHub outdated."
        ),
    )
    p.add_argument("inputs", nargs="*", help="JSON / JSONL / markdown review streams; - for stdin")
    p.add_argument("-C", "--root", dest="root", default=None, help="tree for apply witnesses")
    p.add_argument("--against", default=None, help="git ref to read files from (default: worktree files)")
    p.add_argument("--worktree", action="store_true", help="force reading worktree files")
    p.add_argument("--remarks", action="store_true", help="include non-suggestion comments as COVER strands")
    p.add_argument("--ignore-space", action="store_true", help="collapse horizontal whitespace in images")
    p.add_argument("--json", action="store_true", help="JSON report")
    p.add_argument("--tsv", action="store_true", help="TSV pairs + wales")
    p.add_argument("--pretty", action="store_true", help="human report (default)")
    p.add_argument("--report-only", action="store_true", help="always exit 0 on success")
    p.add_argument("--pick", default=None, help="only emit these pair/wale verdicts (comma)")
    p.add_argument(
        "--all-pairs",
        action="store_true",
        help="include DISJOINT pairs (default hides the Cartesian miss)",
    )
    p.add_argument("--selftest", action="store_true")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    if args.selftest:
        try:
            return run_selftest()
        except Exception:
            return 3
    inputs = list(args.inputs)
    if not inputs:
        if sys.stdin.isatty():
            print("wale: pass a review stream or '-' for stdin", file=sys.stderr)
            return 3
        inputs = ["-"]
    strands: list[Strand] = []
    for src in inputs:
        label = "stdin" if src == "-" else src
        try:
            text = read_source(src)
        except OSError as e:
            print(f"wale: {src}: {e}", file=sys.stderr)
            return 3
        strands.extend(ingest(text, label, remarks=args.remarks))
    # stable unique ids if duplicates
    seen: dict[str, int] = {}
    for s in strands:
        n = seen.get(s.id, 0) + 1
        seen[s.id] = n
        if n > 1:
            s.id = f"{s.id}~{n}"

    pairs = all_pairs(strands, args.ignore_space)
    worktree = args.worktree or (args.root is not None and not args.against)
    against = args.against
    comps = build_components(strands, pairs, args.root, against, worktree)
    files = file_apply_report(strands, pairs, args.root, against, worktree)

    emit_pairs = list(pairs)
    emit_comps = list(comps)
    if args.pick:
        pick = {x.strip().upper() for x in args.pick.split(",") if x.strip()}
        emit_pairs = [p for p in pairs if p.verdict in pick]
        emit_comps = [c for c in comps if c.verdict in pick]
    hide = not args.all_pairs
    payload = to_json(strands, emit_pairs, emit_comps, files)
    if not args.all_pairs:
        payload["pairs"] = [p for p in payload["pairs"] if p["verdict"] != "DISJOINT"]

    if args.json:
        json.dump(payload, sys.stdout, indent=2)
        sys.stdout.write("\n")
    elif args.tsv:
        sys.stdout.write(format_tsv(emit_pairs, emit_comps, hide_disjoint=hide))
    else:
        sys.stdout.write(
            format_pretty(strands, emit_pairs, emit_comps, hide_disjoint=hide)
        )

    if args.report_only:
        return 0
    return worst_exit(comps)


if __name__ == "__main__":
    sys.exit(main())
