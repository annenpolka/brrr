#!/usr/bin/env python3
"""shunt — mint a durable fingerprint address; resolve it onto a later tree.

A file:line is a locator. It dies when the file splits. A shunt is the
fingerprint (line + identifiers + in-scope neighbors + path hint +
optional repo origin) so a ticket can store the address without the SHA.

v0.6 keeps the v0.4/v0.5 gold (extract-and-keep is identity; leftover
+ src/math/ops.py is a move) and flips leftover matching:
  * leftover is an import pointer, not `form in enclosing-function-blob`
  * a unique leftover pointer beats stem-split (src/math/ops.py over
    an abandoned src/calc/ops.py clone the wrapper does not import)
  * basename is not bait: unique-non-basename cannot land a helpers
    decoy and call the real extract basename bait
  * module-level `from pkg import name as _impl` and `from pkg import
    mod` are leftover grammar, including when the pointer is not inside
    the enclosing function
  * `io.fs` ⊂ `audio.fs` is not a pointer (imports match on module
    identity, not substring)
  * extract-and-keep is not a move — if the origin function still holds
    the implementation body, that path is the locus
  * unique means unique in both snapshots
  * a missing --to ref is an error, not a deletion
  * a truncated token fails closed
  * a shunt does not land on a foreign repo unless --any-repo
"""
from __future__ import annotations

