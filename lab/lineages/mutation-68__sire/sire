def looks_like_unified_diff(text: str) -> bool:
    if not text.strip():
        return True
    return bool(
        re.search(r"(?m)^(diff --git |--- |index [0-9a-f]+\.\.|@@ )", text)
    )


def decode_diff_bytes(raw: bytes, src: str) -> str:
    if b"\0" in raw[:8192]:
        die(f"binary diff ({src})")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as e:
        die(f"binary diff ({src}): {e}")
    return ""


def stdin_as_diff() -> tuple[str, str, str, str | None]:
    raw = sys.stdin.buffer.read()
    text = decode_diff_bytes(raw, "stdin")
    if text.strip() and not looks_like_unified_diff(text):
        preview = text.strip().splitlines()[0][:80]
        die(f"stdin is not a unified diff (first line: {preview!r})")
    return text, "diff", "worktree", None


def obtain_diff(
    root: Path, args: argparse.Namespace
) -> tuple[str, str, str, str | None]:
    """Return (diff_text, from_label, to_label, search_rev).

    Default is a unified diff on stdin (CI). A SHA is opt-in.
    """
    def with_at(
        text: str, frm: str, to: str, search: str | None
    ) -> tuple[str, str, str, str | None]:
        if args.at:
            return text, frm, to, args.at
        return text, frm, to, search

    if args.diff is not None:
        if args.diff == "-":
            return with_at(*stdin_as_diff())
        p = Path(args.diff)
        try:
            raw = p.read_bytes()
        except OSError as e:
            die(f"cannot read {p}: {e}")
        text = decode_diff_bytes(raw, str(p))
        return with_at(text, str(p), "worktree", None)

    specs = [s for s in (args.spec, args.spec2) if s]
    if not specs and not args.staged and not args.wt:
        if sys.stdin.isatty():
            die(
                "pass a unified diff on stdin (CI), "
                "or --explain COMMIT for a natal dump"
            )
        return with_at(*stdin_as_diff())

    if not git_ok(root):
        die(f"not a git repository: {root} (pass a diff on stdin or run inside a repo)")

    specs = [s for s in (args.spec, args.spec2) if s]
    if specs and looks_like_location(specs[0]):
        die(
            "pass a unified diff on stdin or a commit, not FILE:LINE "
            "(lien starts from a change; leftovers are the natal record speaking)"
        )

    if args.staged:
        raw = git(["diff", "--cached", "--no-color", "--no-ext-diff"], root)
        return raw.decode("utf-8", "replace"), "HEAD", "index", None

    if args.wt or (not specs):
        if not specs:
            # default: HEAD → worktree
            raw = git(["diff", "HEAD", "--no-color", "--no-ext-diff"], root)
            return raw.decode("utf-8", "replace"), "HEAD", "worktree", None
        if specs[0] in {"wt", "WORKTREE", "working-tree"}:
            raw = git(["diff", "HEAD", "--no-color", "--no-ext-diff"], root)
            return raw.decode("utf-8", "replace"), "HEAD", "worktree", None

    if len(specs) == 1 and (".." in specs[0]):
        left, right = specs[0].split("..", 1)
        right = right.lstrip(".")
        left = left or "HEAD"
        right = right or "HEAD"
        raw = git(["diff", "--no-color", "--no-ext-diff", left, right], root)
        return raw.decode("utf-8", "replace"), left, right, right

    if len(specs) == 2:
        a, b = specs
        raw = git(["diff", "--no-color", "--no-ext-diff", a, b], root)
        return raw.decode("utf-8", "replace"), a, b, b

    spec = specs[0]
    if not is_commit_ish(root, spec):
        die(f"not a commit: {spec}")
    full = git_text(root, ["rev-parse", spec]).strip()
    proc = subprocess.run(
        ["git", "-C", str(root), "rev-parse", f"{full}^"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    parent = proc.stdout.decode().strip() if proc.returncode == 0 else None
    if parent:
        raw = git(["diff", "--no-color", "--no-ext-diff", parent, full], root)
        frm = parent[:12]
    else:
        raw = git(["show", "--format=", "--no-color", "--no-ext-diff", full], root)
        frm = "empty"
    # leftovers at HEAD: what the tree still owes after this change
    search = "HEAD"
    if args.at:
        search = args.at
    return raw.decode("utf-8", "replace"), frm, full[:12], search


