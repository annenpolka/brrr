@dataclass(frozen=True)
class Origin:
    path: str
    line: int
    excerpt: str


@dataclass(frozen=True)
class Natal:
    """One natal record: inflected identity + typed value."""

    names: tuple[str, ...]
    adopted: tuple[str, ...]
    old: str
    new: str
    kind: str  # value | rename | polarity | record
    vtype: str
    origin: Origin
    pairs: tuple[str, ...]

    def key(self) -> tuple[str, ...]:
        return (
            self.kind,
            ",".join(self.names),
            self.old,
            ",".join(self.adopted),
            self.new,
        )

    def label(self) -> str:
        pair = self.pairs[0] if self.pairs else (self.names[0] if self.names else "?")
        if self.old and self.new and self.old != self.new:
            return f"{pair}  {self.old} → {self.new}"
        if self.old and self.old == self.new:
            return f"{pair}  {self.old}"
        if self.pairs:
            return pair
        if self.old:
            return f"{self.names[0] if self.names else '?'}: {self.old} → {self.new}"
        return pair


