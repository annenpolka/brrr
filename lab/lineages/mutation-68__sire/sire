def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=NAME,
        description=(
            "Given a leftover FILE:LINE, show the change whose natal record "
            "that line still speaks. Not git blame. Not a leftover-name walker."
        ),
    )
    p.add_argument(
        "locators",
        nargs="*",
        help="FILE:LINE (lien dest-line liens also parse)",
    )
    p.add_argument("-C", "--root", default=".", help="repository root")
    p.add_argument(
        "--at",
        metavar="REV",
        help="read the leftover from this tree (default: worktree)",
    )
    p.add_argument("--json", action="store_true")
    p.add_argument(
        "--explain",
        action="store_true",
        help="human dump: leftover, sire commit, natal, via",
    )
    p.add_argument("--min-score", type=int, default=55)
    p.add_argument("--max-commits", type=int, default=60)
    p.add_argument("--limit", type=int, default=5, help="sires per locator")
    p.add_argument("--no-color", action="store_true")
    p.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="exit code only (0 if any sire, 1 if none)",
    )
    p.add_argument("--version", action="store_true")
    return p


def main(argv: Sequence[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in {"self-test", "--self-test", "selftest", "--selftest"}:
        return cmd_self_test()
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.version:
        print(f"{NAME} {VERSION}")
        return 0

    root = Path(args.root).resolve()
    if not root.exists():
        die(f"root not found: {root}")
    if not git_ok(root):
        die(f"not a git repository: {root}")

    stdin_text = read_stdin_if_piped()
    if not args.locators and stdin_text is None:
        die("want FILE:LINE (argv or stdin). Not a unified diff, not git blame.")
    if not args.locators and stdin_text == "":
        die("want FILE:LINE (empty stdin)")

    locators = collect_locators(args.locators, stdin_text)
    if not locators:
        die("want FILE:LINE")

    rev: str | None
    if args.at in {None, "worktree", "index"}:
        rev = None
    else:
        rev = args.at

    sires: list[Sire] = []
    for path, line in locators:
        sires.extend(
            sire_locator(
                root,
                path,
                line,
                rev=rev,
                max_commits=args.max_commits,
                min_score=args.min_score,
                limit=args.limit,
            )
        )

    if args.json:
        print_sire_json(sires, root=root)
    elif args.quiet:
        pass
    elif args.explain:
        print_sire_explain(sires, color=color_enabled(args, sys.stdout))
    else:
        print_sires(sires, color=color_enabled(args, sys.stdout))
    return 0 if sires else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
