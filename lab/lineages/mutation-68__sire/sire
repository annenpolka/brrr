def die(msg: str, code: int = 2) -> None:
    print(f"{NAME}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def git(
    args: Sequence[str],
    root: Path,
    *,
    check: bool = True,
    input: bytes | None = None,
) -> bytes:
    proc = subprocess.run(
        ["git", "-C", str(root), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        input=input,
        check=False,
    )
    if check and proc.returncode != 0:
        err = proc.stderr.decode("utf-8", "replace").strip()
        die(f"git {' '.join(args)} failed: {err or proc.returncode}")
    return proc.stdout


def git_ok(root: Path, args: Sequence[str] | None = None) -> bool:
    if args is None:
        args = ["rev-parse", "--is-inside-work-tree"]
        proc = subprocess.run(
            ["git", "-C", str(root), *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return proc.returncode == 0 and proc.stdout.strip() == b"true"
    proc = subprocess.run(
        ["git", "-C", str(root), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return proc.returncode == 0


def git_text(root: Path, args: Sequence[str], *, check: bool = True) -> str:
    return git(list(args), root, check=check).decode("utf-8", "replace")


def looks_like_location(spec: str) -> bool:
    m = LOC_RE.match(spec)
    if not m:
        return False
    path = m.group(1)
    if path in {".", ".."}:
        return False
    if "/" in path or Path(path).suffix or " " in path:
        return True
    if re.search(r"\.[A-Za-z0-9]{1,8}$", path):
        return True
    return False


def is_commit_ish(root: Path, spec: str) -> bool:
