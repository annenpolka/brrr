        "leftovers": [
            {
                "path": L.path,
                "line": L.line,
                "claim": L.claim_kind,
                "excerpt": L.excerpt,
                "score": L.score,
                "via": L.via,
                "why": L.why,
                "natals": [natal_d(n) for n in L.natals],
            }
            for L in leftovers
        ],
    }
    print(json.dumps(payload, indent=2, ensure_ascii=False))


# ---------------------------------------------------------------------------
# invert: leftover locator → natal change
# ---------------------------------------------------------------------------

# v0.2: typed leftover-match, same-line only. Forced by sitbone
# SPEC.md `v0.4` siring float `0.4`, and by kin-only ADR ranking
# CATEGORY above the hysteresis rename.
TYPED_MATCH = True
NEARBY_RADIUS = 0

LOCATOR_LINE_RE = re.compile(
    r"^(?P<path>.+?):(?P<line>\d+)(?::\d+)?(?::(?P<rest>.*))?$"
)
NAIVE_NUM_RE = re.compile(r"\d+(?:\.\d+)+")


def parse_locator(spec: str) -> tuple[str, int] | None:
    spec = spec.strip()
    if not spec or spec.startswith("#"):
        return None
    if spec.startswith(("diff --git", "--- ", "+++ ", "@@ ", "index ")):
        return None
    m = LOCATOR_LINE_RE.match(spec)
    if not m:
        return None
    path = m.group("path").strip()
    if not path or path in {".", ".."}:
        return None
    if re.fullmatch(r"[0-9a-f]{7,40}", path):
        return None
    return path, int(m.group("line"))


def rel_to_root(root: Path, path: str) -> str:
    p = Path(path)
    if p.is_absolute():
        try:
            return str(p.resolve().relative_to(root.resolve()))
        except ValueError:
            return path
    if path.startswith("./"):
        return path[2:]
    return path


def read_locator_line(root: Path, path: str, line: int, rev: str | None) -> tuple[str, list[str]]:
    rel = rel_to_root(root, path)
    text = read_tree_file(root, rel, rev)
    if text is None and rel != path:
        text = read_tree_file(root, path, rev)
        if text is not None:
            rel = path
    if text is None:
        die(f"cannot read {rel}")
    lines = text.splitlines()
    if line < 1 or line > len(lines):
        die(f"{rel}:{line} out of range (1..{len(lines)})")
    return rel, lines


def nearby_text(lines: Sequence[str], line: int, radius: int) -> str:
    if radius <= 0:
        return ""
    i = line - 1
    lo = max(0, i - radius)
    hi = min(len(lines), i + radius + 1)
    chunk = [lines[j] for j in range(lo, hi) if j != i]
    return "\n".join(chunk)


def leftover_needles(line: str) -> list[str]:
    """Pickaxe needles from a leftover line.

    v0.1 stripped a leading letter from `v0.4` so the float natal `0.4`
    was a candidate. v0.2 uses typed needles, and inflects leftover
    names (`T1` → `t1`) so an unmoved value is still reachable.
    """
    out: list[str] = []
    seen: set[str] = set()

    def add(tok: str) -> None:
        if not tok or tok in seen:
            return
        seen.add(tok)
        out.append(tok)

    if TYPED_MATCH:
        hay = mask_calendar(line)
        for m in VERSION_RE.finditer(hay):
            add(m.group(0))
        for m in NUMBER_RE.finditer(hay):
            tok = m.group(0)
            if tok in COMMON_NUMBERS:
                continue
            add(tok)
        for ident in extract_idents(line):
            if ident.lower() in STOP:
                continue
            add(ident)
            for surf in surfaces(ident):
                if len(surf) < 2 or surf.lower() in STOP:
                    continue
                add(surf)
        return out

    for m in NAIVE_NUM_RE.finditer(line):
        add(m.group(0))
    for m in re.finditer(r"\b\d+\b", mask_calendar(line)):
        tok = m.group(0)
        if tok in COMMON_NUMBERS:
            continue
        add(tok)
    for ident in extract_idents(line):
        if ident.lower() in STOP:
            continue
        if SHORT_NATAL.match(ident) or distinctive_ident(ident) or len(ident) >= 4:
            add(ident)
    return out


def commit_diff_text(root: Path, sha: str) -> str:
    proc = subprocess.run(
        ["git", "-C", str(root), "diff", f"{sha}^", sha],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode == 0:
        return proc.stdout.decode("utf-8", "replace")
    proc = subprocess.run(
        ["git", "-C", str(root), "show", "--format=", "--first-parent", "-m", sha],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace")


def commit_subject(root: Path, sha: str) -> str:
    return git_text(root, ["log", "-1", "--format=%s", sha], check=False).strip()


def short_sha(root: Path, sha: str) -> str:
    out = git_text(root, ["rev-parse", "--short=7", sha], check=False).strip()
    return out or sha[:7]


def candidate_shas(
    root: Path,
    needles: Sequence[str],
    *,
    max_commits: int,
) -> list[str]:
    seen: set[str] = set()
    order: list[str] = []
    for needle in needles:
        if not needle or len(needle) < 2:
            continue
        proc = subprocess.run(
            [
                "git",
                "-C",
                str(root),
                "log",
                "--pretty=%H",
                "--no-merges",
                "-S",
                needle,
                f"-n{max_commits}",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if proc.returncode != 0:
            continue
        for sha in proc.stdout.decode("utf-8", "replace").splitlines():
            sha = sha.strip()
            if not sha or sha in seen:
                continue
            seen.add(sha)
            order.append(sha)
            if len(order) >= max_commits:
                return order
    return order


def naive_via(natal: Natal, line: str, nearby: str) -> str | None:
    hay = line if not nearby else f"{line}\n{nearby}"
    has_name = False
    for n in natal.names:
        if not n:
            continue
        if n in line or (len(n) >= 2 and n.lower() in line.lower()):
            has_name = True
            break
    has_val = bool(natal.old and natal.old in hay)
    if has_name and has_val:
        return "both"
    if has_name:
        return "kin"
    if has_val:
        return "claim"
    return None


def match_line(
    natal: Natal,
    path: str,
    line_no: int,
    line: str,
    nearby: str,
) -> tuple[str, int, list[str]] | None:
    claim = classify_claim(path, line)
    if TYPED_MATCH:
        via = decide_via(natal, path, line, claim)
        if via is None:
            return None
        if is_homonym(natal, line) and via == "claim":
            return None
        if is_homonym(natal, line) and via == "both":
            via = "kin"
        score, why = score_hit(
            natal,
            path,
            line,
            claim,
            via=via,
            nearby="",
            file_has_new=False,
        )
        if score < 1:
            return None
        return via, score, why
    via = naive_via(natal, line, nearby)
    if via is None:
        return None
    score = 40
    why = ["naive"]
    if via == "both":
        score += 20
        why.append("via-both")
    if natal.old and natal.old in line:
        score += 16
        why.append("old-value-line")
    elif natal.old and natal.old in nearby:
        score += 8
        why.append("old-value-nearby")
    if any(n in line for n in natal.names if n):
        score += 16
        why.append("same-line-name")
    return via, score, why


def sire_locator(
    root: Path,
    path: str,
    line_no: int,
    *,
    rev: str | None,
    max_commits: int,
    min_score: int,
    limit: int,
) -> list[Sire]:
    rel, lines = read_locator_line(root, path, line_no, rev)
    body = lines[line_no - 1]
    nearby = nearby_text(lines, line_no, NEARBY_RADIUS)
    needles = leftover_needles(body)
    shas = candidate_shas(root, needles, max_commits=max_commits)
    found: list[Sire] = []
    seen_row: set[tuple[str, str, tuple[str, ...]]] = set()
    for sha in shas:
        diff_text = commit_diff_text(root, sha)
        if not diff_text.strip():
            continue
        natals = extract_natals(parse_unified_diff(diff_text))
        if not natals:
            continue
        subject = commit_subject(root, sha)
        short = short_sha(root, sha)
        excerpt = body.strip()
        if len(excerpt) > 220:
            excerpt = excerpt[:217] + "..."
        for natal in natals:
            matched = match_line(natal, rel, line_no, body, nearby)
            if matched is None:
                continue
            via, score, why = matched
            if score < min_score:
                continue
            # Kin of a value-only natal whose name never inflected is
            # every leftover that still says "version", not unpaid kin.
            if (
                via == "kin"
                and natal.kind in {"value", "polarity"}
                and not natal.adopted
            ):
                continue
            key = (short, via, natal.key())
            if key in seen_row:
                continue
            seen_row.add(key)
            found.append(
                Sire(
                    sha=short,
                    subject=subject,
                    natal=natal,
                    via=via,
                    score=score,
                    why=tuple(why),
                    path=rel,
                    line=line_no,
                    excerpt=excerpt,
                )
            )
    found = prune_shadow_claims(found)
    found.sort(
        key=lambda s: (
            0 if s.via == "both" else 1 if s.via == "claim" else 2,
            -s.score,
            s.path,
            s.line,
            s.sha,
        )
    )
    return fuse_sires(found)[:limit]


def prune_shadow_claims(sires: Sequence[Sire]) -> list[Sire]:
    """If the leftover already speaks a named natal (via=both), drop
    nameless value-claims of the same typed old from other changes.

    sitbone CLAUDE.md:329 leftover-matches hysteresis via=both and also
    a098d51 RESPONSE 0.4→0.15 as via=claim. The line is about threshold.
    """
    rows = list(sires)
    if any(s.via == "both" for s in rows):
        return [s for s in rows if s.via != "claim"]
    return rows


def fuse_sires(sires: Sequence[Sire]) -> list[Sire]:
    """One leftover × one commit is one sire; via fuses like lien."""
    buckets: dict[tuple[str, int, str], Sire] = {}
    order: list[tuple[str, int, str]] = []
    for s in sires:
        k = (s.path, s.line, s.sha)
        if k not in buckets:
            buckets[k] = s
            order.append(k)
            continue
        cur = buckets[k]
        vias = {cur.via, s.via}
        via = cur.via
        if "both" in vias or ({"claim", "kin"} <= vias):
            via = "both"
        score = max(cur.score, s.score)
        why = tuple(dict.fromkeys([*cur.why, *s.why, *(("via-both",) if via == "both" else ())]))
        natal = cur.natal if cur.score >= s.score else s.natal
        buckets[k] = Sire(
            sha=cur.sha,
            subject=cur.subject,
            natal=natal,
            via=via,
            score=score,
            why=why,
            path=cur.path,
            line=cur.line,
            excerpt=cur.excerpt,
        )
    out = [buckets[k] for k in order]
    out.sort(
        key=lambda s: (
            0 if s.via == "both" else 1 if s.via == "claim" else 2,
            -s.score,
            s.path,
            s.line,
            s.sha,
        )
    )
    return out


def print_sires(sires: Sequence[Sire], *, color: bool) -> None:
    for s in sires:
        natal = s.natal.label()
        excerpt = s.excerpt.replace("\n", " ")
        via = paint(s.via, "33" if s.via == "both" else "36", color)
        sha = paint(s.sha, "32", color)
        print(f"{s.path}:{s.line}: {sha}: {via}: {natal}: {excerpt}")


def print_sire_explain(sires: Sequence[Sire], *, color: bool) -> None:
    if not sires:
        return
    grouped: dict[tuple[str, int], list[Sire]] = {}
    order: list[tuple[str, int]] = []
    for s in sires:
        k = (s.path, s.line)
        if k not in grouped:
            grouped[k] = []
            order.append(k)
        grouped[k].append(s)
    for i, k in enumerate(order):
        rows = grouped[k]
        if i:
            print()
        head = paint(f"{k[0]}:{k[1]}", "1", color)
        print(f"sire: {head}  leftover still speaks {len(rows)} natal change(s)")
        print(f"  leftover  {rows[0].excerpt}")
        for s in rows:
            print(
                f"  sire      {paint(s.sha, '32', color)}  {s.subject}"
            )
            print(
                f"  natal     {s.natal.label()}   {s.natal.origin.path}:{s.natal.origin.line}"
            )
            print(f"  via       {s.via}  score={s.score}  {' '.join(s.why)}")


def print_sire_json(sires: Sequence[Sire], *, root: Path) -> None:
    payload = {
        "root": str(root),
        "version": VERSION,
        "typed": TYPED_MATCH,
        "sires": [
            {
                "path": s.path,
                "line": s.line,
                "excerpt": s.excerpt,
                "sha": s.sha,
                "subject": s.subject,
                "via": s.via,
                "score": s.score,
                "why": list(s.why),
                "natal": {
                    "label": s.natal.label(),
                    "names": list(s.natal.names),
                    "adopted": list(s.natal.adopted),
                    "old": s.natal.old,
                    "new": s.natal.new,
                    "kind": s.natal.kind,
                    "vtype": s.natal.vtype,
                    "pairs": list(s.natal.pairs),
                    "origin": {
                        "path": s.natal.origin.path,
                        "line": s.natal.origin.line,
                        "excerpt": s.natal.origin.excerpt,
                    },
                },
            }
            for s in sires
        ],
    }
    print(json.dumps(payload, indent=2, ensure_ascii=False))


def collect_locators(specs: Sequence[str], stdin_text: str | None) -> list[tuple[str, int]]:
    locators: list[tuple[str, int]] = []
    seen: set[tuple[str, int]] = set()

    def add(spec: str) -> None:
        loc = parse_locator(spec)
        if loc is None:
            die(f"not a locator (want FILE:LINE): {spec[:80]!r}")
        if loc not in seen:
            seen.add(loc)
            locators.append(loc)

    for spec in specs:
        add(spec)
    if stdin_text is not None:
        stripped = stdin_text.strip()
        if stripped and looks_like_unified_diff(stripped) and re.search(
            r"(?m)^diff --git |^@@ ", stripped
        ):
            preview = stripped.splitlines()[0][:80]
            die(
                "stdin is a unified diff, not FILE:LINE "
                f"(first line: {preview!r}). Try: git diff | lien | {NAME}"
            )
        for raw in stdin_text.splitlines():
            if not raw.strip() or raw.lstrip().startswith("#"):
                continue
            add(raw)
    return locators


def read_stdin_if_piped() -> str | None:
    if sys.stdin.isatty():
        return None
    raw = sys.stdin.buffer.read()
    if not raw:
        return ""
    return decode_diff_bytes(raw, "stdin")


