def cmd_self_test() -> int:
    failures = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal failures
        if cond:
            print(f"  ok  {name}")
        else:
            print(f"  FAIL {name} {detail}")
            failures += 1

    check("t1/T1 inflection", same_inflection("t1", "T1"))
    check("snake/camel", same_inflection("present_threshold", "presentThreshold"))
    check("T1 surface of t1", "T1" in surfaces("t1"))
    check("threshold ⊂ presentThreshold", stem_related("threshold", "presentThreshold"))

    loc = parse_locator("CLAUDE.md:329")
    check("parse CLAUDE.md:329", loc == ("CLAUDE.md", 329), str(loc))
    loc = parse_locator(
        "CLAUDE.md:329: both: threshold↔presentThreshold  0.4 → 0.45: leftover"
    )
    check("parse lien dest-line as locator", loc == ("CLAUDE.md", 329), str(loc))
    loc = parse_locator("docs/how to set (t1).md:3")
    check("parse path with spaces", loc == ("docs/how to set (t1).md", 3), str(loc))
    check("SHA is not a locator", parse_locator("e9b0f75") is None)
    check("commit-ish is not a locator", parse_locator("HEAD") is None)

    rename = """diff --git a/core.py b/core.py
--- a/core.py
+++ b/core.py
@@ -1,3 +1,3 @@
-t1 = 15
-present_threshold = 0.4
+driftDelay = 15
+presentThreshold = 0.45
 PORT = 8080
"""
    natals = extract_natals(parse_unified_diff(rename))
    labels = " | ".join(n.label() for n in natals)
    t1 = next(n for n in natals if any(x.lower() == "t1" for x in n.names))
    check(
        "t1 natal keeps value 15 even though it did not move",
        t1.old == "15",
        labels,
    )
    via = decide_via(t1, "docs/how to set (t1).md", "T1 is 15 seconds.", "docs")
    check("typed T1 is 15 seconds is via=both", via == "both", str(via))

    hyst = """diff --git a/PresenceArbiter.swift b/PresenceArbiter.swift
--- a/PresenceArbiter.swift
+++ b/PresenceArbiter.swift
@@ -1,2 +1,3 @@
-        threshold: Double = 0.4,
+        presentThreshold: Double = 0.45,
+        absentThreshold: Double = 0.35,
"""
    hn = extract_natals(parse_unified_diff(hyst))
    th = next((n for n in hn if n.old == "0.4"), None)
    check("hysteresis 0.4 natal extracted", th is not None, str([n.label() for n in hn]))
    leftover = '@Test("カメラのみpresent → 総合present（weight 0.50 > threshold 0.4）")'
    if th is not None:
        via = decide_via(th, "CLAUDE.md", leftover, "docs")
        check("typed CLAUDE.md threshold 0.4 is via=both", via == "both", str(via))
        via = decide_via(th, "SPEC.md", "v0.4  カメラPresence検出", "docs")
        check("typed SPEC.md v0.4 is not float 0.4", via is None, str(via))
        via = decide_via(
            th,
            "docs/adr/0019.md",
            "let status: PresenceStatus = smoothedScore >= threshold ? .present : .absent",
            "docs",
        )
        check("typed ADR quote is via=kin (no 0.4 on the line)", via == "kin", str(via))
        via = decide_via(
            th,
            "Sources/SitboneCore/SiteObserver.swift",
            "private let threshold: Double = 0.7",
            "code",
        )
        check("SiteObserver.threshold=0.7 is a different domain", via is None, str(via))

        naive = naive_via(th, "v0.4  カメラPresence検出", "")
        check(
            "v0.1 naive: v0.4 leftover-matches float 0.4",
            naive in {"claim", "both"},
            str(naive),
        )
        adr_kin = "let status: PresenceStatus = smoothedScore >= threshold ? .present : .absent"
        nearby_val = "単一閾値(0.4)で判定している"
        naive = naive_via(th, adr_kin, nearby_val)
        check(
            "v0.1 naive: nearby 0.4 turns kin-only ADR into via=both",
            naive == "both",
            str(naive),
        )
        needles = leftover_needles("v0.4  カメラPresence検出")
        check(
            "v0.2 needles do not strip v0.4 down to float 0.4",
            "0.4" not in needles,
            str(needles),
        )
        t1_needles = leftover_needles("T1 is 15 seconds.")
        check(
            "v0.2 inflects T1 → t1 for pickaxe",
            "t1" in t1_needles and "T1" in t1_needles,
            str(t1_needles),
        )

    fake_origin = Origin("x.py", 1, "x")
    both = Sire(
        sha="aaa",
        subject="hyst",
        natal=Natal(
            names=("threshold",),
            adopted=("presentThreshold",),
            old="0.4",
            new="0.45",
            kind="record",
            vtype="float",
            origin=fake_origin,
            pairs=("threshold↔presentThreshold",),
        ),
        via="both",
        score=90,
        why=("via-both",),
        path="CLAUDE.md",
        line=329,
        excerpt="threshold 0.4",
    )
    shadow = Sire(
        sha="bbb",
        subject="style",
        natal=Natal(
            names=("RESPONSE",),
            adopted=(),
            old="0.4",
            new="0.15",
            kind="value",
            vtype="float",
            origin=fake_origin,
            pairs=(),
        ),
        via="claim",
        score=66,
        why=("old-value",),
        path="CLAUDE.md",
        line=329,
        excerpt="threshold 0.4",
    )
    pruned = prune_shadow_claims([both, shadow])
    check(
        "via=both drops shadow 0.4 claims from other natals",
        len(pruned) == 1 and pruned[0].sha == "aaa",
        str([(s.sha, s.via) for s in pruned]),
    )

    check(
        "float 0.4 is not version-label v0.4 (typed needle)",
        not needle_value("0.4", "v0.4  カメラPresence検出", "float"),
    )
    check(
        "float 0.4 still matches threshold 0.4",
        needle_value("0.4", leftover, "float"),
    )

    jsver = """diff --git a/plugin.json b/plugin.json
--- a/plugin.json
+++ b/plugin.json
@@ -1,4 +1,4 @@
 {
-  "version": "0.3.0",
+  "version": "0.7.0",
   "timeout": 10
 }
"""
    jn = extract_natals(parse_unified_diff(jsver))
    ver = next(n for n in jn if n.old == "0.3.0")
    via = decide_via(ver, "README.md", "plugin version 0.3.0, hook timeout 10 seconds.", "docs")
    check("prose 0.3.0 leftover is a claim (or both)", via in {"claim", "both"}, str(via))
    check(
        "integer 10 is not October",
        not needle_value("10", "shipped 2024-10-01", "integer"),
    )

    check(
        "empty stdin is a legal (no-op) diff for the detector",
        looks_like_unified_diff(""),
    )
    check(
        "commit log is not a unified diff",
        not looks_like_unified_diff("commit deadbeef\nAuthor: x\n"),
    )
    check(
        "diff --git is a unified diff",
        looks_like_unified_diff(
            "diff --git a/x b/x\n--- a/x\n+++ b/x\n@@ -1 +1 @@\n-a\n+b\n"
        ),
    )

    tool = str(Path(__file__).resolve())
    proc = subprocess.run(
        [sys.executable, tool, "--no-color"],
        input=b"diff --git a/x b/x\n--- a/x\n+++ b/x\n@@ -1 +1 @@\n-a\n+b\n",
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    check("unified-diff stdin exits 2", proc.returncode == 2, str(proc.returncode))
    err = proc.stderr.decode("utf-8", "replace")
    check("unified-diff stdin names FILE:LINE", "FILE:LINE" in err, err[:240])

    proc = subprocess.run(
        [sys.executable, tool, "--no-color"],
        input=b"",
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    check("empty stdin exits 2 (need a locator)", proc.returncode == 2, str(proc.returncode))

    return 1 if failures else 0


