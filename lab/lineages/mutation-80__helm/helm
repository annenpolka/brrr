        check(shallow_flag == "true", f"file:// --depth 1 should be shallow, got {shallow_flag!r}")
        o_full = repo_keel(a, sha_a.strip())
        o_sh = repo_keel(shallow)
        check(
            o_sh is not None and "github.com/keel-lab/demo" in o_sh,
            f"file:// clone should inherit project remotes: {o_sh}",
        )
        check(
            origins_match(o_full, o_sh, dest_root=shallow),
            f"depth-1 clone should match full repo: {o_full} vs {o_sh}",
        )
        check(
            not origins_match(o_full, ob, dest_root=b),
            "depth-1 identity must not match a foreign repo",
        )
    except Exception as e:
        check(False, f"git helm identity fixtures: {e}")
    finally:
        import shutil

        shutil.rmtree(tmp, ignore_errors=True)

    if fails:
        print(f"selftest: {fails} failure(s)", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


_VALUE_FLAGS = {
    "--repo",
    "-C",
    "--from",
    "--from-dir",
    "--to",
    "--to-dir",
    "--file",
    "--name",
    "--context",
}
_COMMANDS = {"mint", "resolve", "show", "id", "selftest"}


def normalize_argv(argv: list[str]) -> list[str]:
    """Allow flags on either side of the subcommand, and `helm helm1.…` as resolve."""
    if not argv:
        return argv
    if argv[0] in _COMMANDS or argv[0] in {"-h", "--help", "--version"}:
        return argv
    if is_pin_token(argv[0]) or (argv[0] == "-" and len(argv) == 1):
        return ["resolve", *argv]

    i = 0
    cmd_at: Optional[int] = None
    while i < len(argv):
        a = argv[i]
        if a in _COMMANDS:
            cmd_at = i
            break
        if is_pin_token(a) or a == "-":
            return ["resolve", *argv]
        if a.startswith("--") and "=" in a:
            i += 1
            continue
        if a in _VALUE_FLAGS:
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        i += 1
    if cmd_at is not None and cmd_at != 0:
        return [argv[cmd_at], *argv[:cmd_at], *argv[cmd_at + 1 :]]
    if any(is_pin_token(a) for a in argv):
        return ["resolve", *argv]
    return argv


def main(argv: Optional[list[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    argv = normalize_argv(argv)
    args = build_parser().parse_args(argv)
    if getattr(args, "selftest", False) and not args.cmd:
        return cmd_selftest()
    if not args.cmd:
        build_parser().print_help()
        return 2
    if args.cmd == "mint":
        return cmd_mint(args)
    if args.cmd == "resolve":
        return cmd_resolve(args)
    if args.cmd == "show":
        return cmd_show(args)
    if args.cmd == "id":
        return cmd_id(args)
    if args.cmd == "selftest":
        return cmd_selftest()
    build_parser().print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except subprocess.CalledProcessError as e:
        err = e.stderr.decode("utf-8", "replace") if e.stderr else str(e)
        print(f"helm: git failed: {err}", file=sys.stderr)
        sys.exit(2)
