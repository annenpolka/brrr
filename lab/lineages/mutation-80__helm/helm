@dataclass(frozen=True)
class HelmId:
    """Stable repo identity: project remotes + tip witnesses, not root SHAs."""

    remotes: tuple[str, ...] = ()
    witnesses: tuple[str, ...] = ()

    def encode(self) -> Optional[str]:
        if not self.remotes and not self.witnesses:
            return None
        r = ",".join(self.remotes[:MAX_REMOTES])
        w = ",".join(self.witnesses[:MAX_WITNESSES])
        return f"{ORIGIN_PREFIX}r:{r};w:{w}"

    @classmethod
    def decode(cls, raw: Optional[str]) -> Optional["HelmId"]:
        if not raw or not isinstance(raw, str):
            return None
        if not raw.startswith(ORIGIN_PREFIX):
            return None
        body = raw[len(ORIGIN_PREFIX) :]
        remotes: list[str] = []
        witnesses: list[str] = []
        r_part = ""
        w_part = ""
        if body.startswith("r:"):
            if ";w:" in body:
                r_part, w_part = body[2:].split(";w:", 1)
            else:
                r_part = body[2:]
        elif ";w:" in body:
            r_part, w_part = body.split(";w:", 1)
        else:
            return None
        remotes = [x for x in r_part.split(",") if x]
        witnesses = [x.lower() for x in w_part.split(",") if _SHA_RE.match(x.lower())]
        return cls(tuple(remotes), tuple(witnesses))


@dataclass
class Fingerprint:
    path: str
    line: int
    text: str
    tokens: list[str] = field(default_factory=list)
    unique: list[str] = field(default_factory=list)
    before: list[str] = field(default_factory=list)
    after: list[str] = field(default_factory=list)
    anchors: list[str] = field(default_factory=list)
    col: Optional[int] = None
    origin: Optional[str] = None

    def payload(self) -> dict:
        d: dict = {"v": 2, "p": self.path, "n": self.line, "t": self.text}
        if self.tokens:
            d["k"] = self.tokens
        if self.unique:
            d["u"] = self.unique
        if self.before:
            d["b"] = self.before
        if self.after:
            d["a"] = self.after
        if self.anchors:
            d["g"] = self.anchors
        if self.col is not None:
            d["c"] = self.col
        if self.origin:
            d["o"] = self.origin
        return d

    @classmethod
    def from_payload(cls, d: dict) -> "Fingerprint":
        if not isinstance(d, dict) or d.get("v") not in (1, 2):
            raise ValueError("unsupported pin version")
        text = d.get("t")
        path = d.get("p")
        line = d.get("n")
        if not isinstance(text, str) or not isinstance(path, str) or not isinstance(line, int):
            raise ValueError("pin missing path/line/text")
        origin = d.get("o")
        return cls(
            path=canon_path(path),
            line=line,
            text=text,
            tokens=_str_list(d.get("k")),
            unique=_str_list(d.get("u")),
            before=_str_list(d.get("b")),
            after=_str_list(d.get("a")),
            anchors=_str_list(d.get("g")),
            col=d.get("c") if isinstance(d.get("c"), int) else None,
            origin=origin if isinstance(origin, str) and origin else None,
        )


