def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def run(
    args: Sequence[str],
    *,
    cwd: Optional[str] = None,
    input_text: Optional[str] = None,
    env: Optional[dict[str, str]] = None,
    timeout: Optional[float] = None,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        list(args),
        cwd=cwd,
        input=input_text,
        text=True,
        encoding="utf-8",
        errors="replace",
        capture_output=True,
        env=env,
        timeout=timeout,
    )


def git(
    repo: str,
    *args: str,
    input_text: Optional[str] = None,
) -> subprocess.CompletedProcess:
    return run(
        ["git", "-c", "core.quotepath=false", "-C", repo, *args],
        input_text=input_text,
    )


def resolve_repo(path: Optional[str]) -> tuple[str, bool]:
    start = os.path.abspath(path or os.getcwd())
    if not os.path.isdir(start):
        raise FordError(f"not a directory: {start}")
    inside = run(["git", "-C", start, "rev-parse", "--is-inside-work-tree"])
    if inside.returncode == 0 and inside.stdout.strip() == "true":
        top = run(["git", "-C", start, "rev-parse", "--show-toplevel"])
        if top.returncode != 0:
            raise FordError(f"not a git repository: {start}")
        return top.stdout.strip(), False
    bare = run(["git", "-C", start, "rev-parse", "--is-bare-repository"])
    if bare.returncode == 0 and bare.stdout.strip() == "true":
        gitdir = run(["git", "-C", start, "rev-parse", "--absolute-git-dir"])
        if gitdir.returncode != 0:
            raise FordError(f"not a git repository: {start}")
        return gitdir.stdout.strip(), True
    raise FordError(f"not a git repository: {start}")


def color_enabled(args: argparse.Namespace) -> bool:
    if args.color == "always":
        return True
    if args.color == "never" or args.json or args.tsv or args.oneline or args.revs:
        return False
    if args.human:
        return sys.stdout.isatty() and os.environ.get("TERM") != "dumb"
    return False


def paint(enabled: bool, code: str, text: str) -> str:
    if not enabled:
        return text
    return f"\033[{code}m{text}\033[0m"


def status_color(status: Status) -> str:
    return {
        Status.TRUE: "32;1",
        Status.FALSE: "31",
        Status.UNKNOWN: "33;1",
        Status.SHALLOW: "36;1",
        Status.EMPTY: "35;1",
    }[status]


def is_glob(path: str) -> bool:
    return any(ch in path for ch in GLOB_CHARS)


def _parse_log_line(line: str) -> Optional[Sample]:
    parts = line.split("\0")
    if len(parts) < 5:
        return None
    sha, tree, ct, iso, subject = parts[:5]
    parent_s = parts[5] if len(parts) > 5 else ""
    parents = tuple(p for p in parent_s.split() if p)
    try:
        timestamp = int(ct)
    except ValueError:
        timestamp = 0
    return Sample(
        sha=sha,
        tree=tree,
        timestamp=timestamp,
        iso=iso,
        subject=subject,
        parents=parents,
    )


def list_samples(
    repo: str,
    *,
    end_rev: str,
    rev_range: Optional[str],
    first_parent: bool,
    limit: Optional[int],
) -> list[Sample]:
    spec = rev_range if rev_range else end_rev
    fmt = "%H%x00%T%x00%ct%x00%ci%x00%s%x00%P"
    cmd = ["log", "--reverse", f"--format={fmt}"]
    if first_parent:
        cmd.append("--first-parent")
    cmd.append(spec)
    proc = git(repo, *cmd)
    if proc.returncode != 0:
        err = proc.stderr.strip() or f"cannot walk {spec}"
        raise FordError(err)
    samples: list[Sample] = []
    for line in proc.stdout.splitlines():
        if not line.strip():
            continue
        got = _parse_log_line(line)
        if got is not None:
            samples.append(got)
    if limit is not None and limit >= 0 and len(samples) > limit:
        samples = samples[-limit:]
    return samples


def load_commits(repo: str, shas: Sequence[str]) -> dict[str, Optional[Sample]]:
    """Load commit metadata. Missing objects map to None (SHALLOW parent)."""
    out: dict[str, Optional[Sample]] = {s: None for s in shas}
    if not shas:
        return out
    payload = "".join(f"{s}\n" for s in shas)
    chk = git(repo, "cat-file", "--batch-check", input_text=payload)
    existing: list[str] = []
    if chk.returncode == 0:
        lines = chk.stdout.splitlines()
        for sha, line in zip(shas, lines):
            if line.endswith(" missing") or " missing" in line:
                out[sha] = None
            else:
                existing.append(sha)
    else:
        for sha in shas:
            one = git(repo, "cat-file", "-t", sha)
            if one.returncode == 0 and one.stdout.strip():
                existing.append(sha)
            else:
                out[sha] = None
    if not existing:
        return out
    fmt = "%H%x00%T%x00%ct%x00%ci%x00%s%x00%P"
    proc = git(repo, "log", "--no-walk", f"--format={fmt}", *existing)
    if proc.returncode != 0:
        for sha in existing:
            one = git(repo, "log", "-1", f"--format={fmt}", sha)
            if one.returncode == 0:
                got = _parse_log_line(one.stdout.strip())
                if got is not None:
                    out[got.sha] = got
        return out
    for line in proc.stdout.splitlines():
        got = _parse_log_line(line)
        if got is not None:
            out[got.sha] = got
    return out


