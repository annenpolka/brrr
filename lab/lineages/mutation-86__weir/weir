SHA_RE = re.compile(r"^[0-9a-f]{40}$")
GLOB_CHARS = frozenset("*?[")
TOOL = "weir"


class WeirError(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


FordError = WeirError  # occupancy family alias; do not raise this name


class Status(str, Enum):
    TRUE = "TRUE"
    FALSE = "FALSE"
    UNKNOWN = "UNKNOWN"
    SHALLOW = "SHALLOW"
    EMPTY = "EMPTY"


# Presence chain. meet = inf, join = sup. A real lattice (total order).
# FALSE: measured absence
# SHALLOW: parent/history missing (unmeasured)
# UNKNOWN: probe failed (timeout, regex, checkout)
# EMPTY: occupied, not as text
# TRUE: occupied as asked
RANK = {
    Status.FALSE: 0,
    Status.SHALLOW: 1,
    Status.UNKNOWN: 2,
    Status.EMPTY: 3,
    Status.TRUE: 4,
}

MEET_SYM = "⊓"
JOIN_SYM = "⊔"
NON_TF = frozenset({Status.UNKNOWN, Status.SHALLOW, Status.EMPTY})


def meet(*xs: Status) -> Status:
    if not xs:
        return Status.FALSE
    return min(xs, key=lambda s: RANK[s])


def join(*xs: Status) -> Status:
    if not xs:
        return Status.FALSE
    return max(xs, key=lambda s: RANK[s])


def lattice_apply(op: str, xs: Sequence[Status]) -> Status:
    if op == "any":
        return join(*xs)
    return meet(*xs)


def lattice_symbol(op: str) -> str:
    return JOIN_SYM if op == "any" else MEET_SYM


