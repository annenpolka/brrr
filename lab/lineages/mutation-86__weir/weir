def probe_exists(
    repo: str,
    samples: Sequence[Sample],
    path: str,
) -> tuple[list[Probe], int]:
    probes_out: list[Probe] = [
        Probe(status=Status.FALSE, raw=Status.FALSE) for _ in samples
    ]
    nprobe = 0
    commit_idx = [i for i, s in enumerate(samples) if s.kind == "commit"]
    if commit_idx:
        payload = "".join(f"{samples[i].sha}:{path}\n" for i in commit_idx)
        proc = git(repo, "cat-file", "--batch-check", input_text=payload)
        nprobe += 1
        if proc.returncode != 0:
            err = proc.stderr.strip() or "git cat-file --batch-check failed"
            raise FordError(err)
        lines = proc.stdout.splitlines()
        if len(lines) != len(commit_idx):
            for i in commit_idx:
                probes_out[i] = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(cat-file)"])
        else:
            for i, line in zip(commit_idx, lines):
                exists = not line.endswith(" missing")
                st = Status.TRUE if exists else Status.FALSE
                wits = [path] if exists else []
                probes_out[i] = Probe(st, st, wits)

    for i, sample in enumerate(samples):
        if sample.kind == "worktree":
            nprobe += 1
            exists = os.path.lexists(os.path.join(repo, path))
            st = Status.TRUE if exists else Status.FALSE
            probes_out[i] = Probe(st, st, [path] if exists else [])
        elif sample.kind == "index":
            nprobe += 1
            proc = git(repo, "ls-files", "--cached", "--error-unmatch", "--", path)
            exists = proc.returncode == 0
            st = Status.TRUE if exists else Status.FALSE
            probes_out[i] = Probe(st, st, [path] if exists else [])
        elif sample.kind == "empty":
            probes_out[i] = Probe(Status.EMPTY, Status.EMPTY, [])
    return probes_out, nprobe


def probe_glob(
    repo: str,
    samples: Sequence[Sample],
    pattern: str,
) -> tuple[list[Probe], int]:
    probes_out: list[Probe] = [
        Probe(status=Status.FALSE, raw=Status.FALSE) for _ in samples
    ]
    nprobe = 0
    tree_cache: dict[str, Probe] = {}

    for i, sample in enumerate(samples):
        if sample.kind != "commit":
            continue
        cached = tree_cache.get(sample.tree)
        if cached is not None:
            probes_out[i] = Probe(cached.status, cached.raw, list(cached.witnesses))
            continue
        proc = git(repo, "ls-tree", "-r", "--name-only", sample.sha)
        nprobe += 1
        if proc.returncode != 0:
            got = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(ls-tree)"])
        else:
            hits = [p for p in proc.stdout.splitlines() if fnmatch(p, pattern)]
            st = Status.TRUE if hits else Status.FALSE
            got = Probe(st, st, hits[:12])
        tree_cache[sample.tree] = got
        probes_out[i] = Probe(got.status, got.raw, list(got.witnesses))

    for i, sample in enumerate(samples):
        if sample.kind == "worktree":
            nprobe += 1
            hits = _walk_worktree(repo, pattern)
            st = Status.TRUE if hits else Status.FALSE
            probes_out[i] = Probe(st, st, hits[:12])
        elif sample.kind == "index":
            nprobe += 1
            proc = git(repo, "ls-files", "-z", "--cached")
            if proc.returncode != 0:
                probes_out[i] = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(ls-files)"])
                continue
            hits = [p for p in proc.stdout.split("\0") if p and fnmatch(p, pattern)]
            st = Status.TRUE if hits else Status.FALSE
            probes_out[i] = Probe(st, st, hits[:12])
        elif sample.kind == "empty":
            probes_out[i] = Probe(Status.EMPTY, Status.EMPTY, [])
    return probes_out, nprobe


def _walk_worktree(repo: str, pattern: str) -> list[str]:
    hits: list[str] = []
    for root, dirs, files in os.walk(repo):
        rel_root = os.path.relpath(root, repo)
        if rel_root == ".git" or rel_root.startswith(".git" + os.sep):
            dirs[:] = []
            continue
        if ".git" in dirs:
            dirs.remove(".git")
        for name in files:
            rel = name if rel_root == "." else os.path.join(rel_root, name)
            rel = rel.replace(os.sep, "/")
            if fnmatch(rel, pattern):
                hits.append(rel)
    return hits


def _split_grep_line(line: str) -> tuple[str, str]:
    if len(line) >= 41 and line[40] == ":" and SHA_RE.match(line[:40]):
        return line[:40], line[41:]
    sha, _, rest = line.partition(":")
    return sha, rest


def _parse_grep_paths(stdout: str, expected_sha: Optional[str] = None) -> list[str]:
    hits: list[str] = []
    for line in stdout.splitlines():
        if not line:
            continue
        if line.startswith("Binary file ") and line.endswith(" matches"):
            mid = line[len("Binary file ") : -len(" matches")]
            _, _, path = mid.partition(":")
            path = path or mid
            if path and path not in hits:
                hits.append(path)
            continue
        sha, path = _split_grep_line(line)
        if expected_sha and SHA_RE.match(sha) and sha != expected_sha:
            if path and path not in hits:
                if not SHA_RE.match(sha):
                    hits.append(sha)
            continue
        if path and path not in hits:
            hits.append(path)
        elif not path and sha and sha not in hits:
            hits.append(sha)
    return hits


def _parse_worktree_grep(stdout: str) -> list[str]:
    hits: list[str] = []
    for line in stdout.splitlines():
        if not line:
            continue
        if line.startswith("Binary file ") and line.endswith(" matches"):
            path = line[len("Binary file ") : -len(" matches")]
            if path and path not in hits:
                hits.append(path)
            continue
        path = line.split(":", 1)[0] if ":" in line else line
        if path and path not in hits:
            hits.append(path)
    return hits


def _grep_error_kind(stderr: str, rc: int) -> str:
    if rc in (0, 1):
        return "ok"
    err = stderr.lower()
    if any(
        tok in err
        for tok in (
            "not balanced",
            "unmatched",
            "invalid regular expression",
            "trailing backslash",
            "repetition-operator operand invalid",
        )
    ):
        return "bad_pattern"
    if "did not match any file" in err:
        return "no_path"
    return "error"


def probe_grep(
    repo: str,
    samples: Sequence[Sample],
    pattern: str,
    paths: Sequence[str],
    *,
    ignore_case: bool,
    fixed: bool,
    word: bool,
    invert: bool,
) -> tuple[list[Probe], int, Optional[str]]:
    n = len(samples)
    probes_out: list[Probe] = [Probe(Status.FALSE, Status.FALSE) for _ in range(n)]
    nprobe = 0
    path_args: list[str] = ["--", *paths] if paths else []

    def flags(*, text_only: bool, treat_binary: bool) -> list[str]:
        out = ["-l", "--full-name", "-e", pattern]
        if text_only:
            out.append("-I")
        if treat_binary:
            out.append("-a")
        if ignore_case:
            out.append("-i")
        if fixed:
            out.append("-F")
        if word:
            out.append("-w")
        return out

    commit_idx = [i for i, s in enumerate(samples) if s.kind == "commit"]
    by_sha = {samples[i].sha: i for i in commit_idx}
    tree_rep: dict[str, str] = {}
    sha_to_tree = {samples[i].sha: samples[i].tree for i in commit_idx}
    for i in commit_idx:
        tree_rep.setdefault(samples[i].tree, samples[i].sha)
    reps = list(tree_rep.values())

    def apply_tree(rep_sha: str, probe: Probe) -> None:
        tree = sha_to_tree[rep_sha]
        for sha, t in sha_to_tree.items():
            if t == tree:
                probes_out[by_sha[sha]] = Probe(
                    probe.status, probe.raw, list(probe.witnesses)
                )

    def run_chunk(
        shas: Sequence[str], extra_flags: list[str]
    ) -> tuple[dict[str, list[str]], Optional[str], int]:
        hits: dict[str, list[str]] = {s: [] for s in shas}
        extra = 0
        for chunk in _chunked(list(shas), 80) if shas else []:
            proc = git(repo, "grep", *extra_flags, *chunk, *path_args)
            extra += 1
            kind = _grep_error_kind(proc.stderr, proc.returncode)
            if kind == "bad_pattern":
                msg = proc.stderr.strip() or "invalid regular expression"
                return {}, msg, extra
            if kind == "error" or kind == "no_path":
                for sha in chunk:
                    one = git(repo, "grep", *extra_flags, sha, *path_args)
                    extra += 1
                    k2 = _grep_error_kind(one.stderr, one.returncode)
                    if k2 == "bad_pattern":
                        return (
                            {},
                            one.stderr.strip() or "invalid regular expression",
                            extra,
                        )
                    if k2 == "ok" and one.returncode == 0:
                        hits[sha] = _parse_grep_paths(one.stdout, expected_sha=sha)
                    elif k2 == "error":
                        hits[sha] = ["\x00UNKNOWN"]
                    else:
                        hits[sha] = []
                continue
            if proc.returncode == 0:
                for line in proc.stdout.splitlines():
                    sha, path = _split_grep_line(line)
                    if sha not in hits:
                        continue
                    if path and path not in hits[sha]:
                        hits[sha].append(path)
        return hits, None, extra

    if reps:
        text_hits, bad, extra = run_chunk(reps, flags(text_only=True, treat_binary=False))
        nprobe += extra
        if bad:
            unk = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(invalid regex)"])
            for i in range(n):
                probes_out[i] = Probe(unk.status, unk.raw, list(unk.witnesses))
            return probes_out, nprobe, bad

        need_bin: list[str] = []
        for sha, paths_hit in text_hits.items():
            if paths_hit == ["\x00UNKNOWN"]:
                apply_tree(sha, Probe(Status.UNKNOWN, Status.UNKNOWN, ["(grep)"]))
            elif paths_hit:
                apply_tree(sha, Probe(Status.TRUE, Status.TRUE, paths_hit[:12]))
            else:
                need_bin.append(sha)

        if need_bin:
            bin_hits, bad2, extra2 = run_chunk(
                need_bin, flags(text_only=False, treat_binary=True)
            )
            nprobe += extra2
            if bad2:
                unk = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(invalid regex)"])
                for i in range(n):
                    probes_out[i] = Probe(unk.status, unk.raw, list(unk.witnesses))
                return probes_out, nprobe, bad2
            for sha in need_bin:
                paths_hit = bin_hits.get(sha, [])
                if paths_hit == ["\x00UNKNOWN"]:
                    apply_tree(sha, Probe(Status.UNKNOWN, Status.UNKNOWN, ["(grep)"]))
                elif paths_hit:
                    apply_tree(sha, Probe(Status.EMPTY, Status.EMPTY, paths_hit[:12]))
                else:
                    apply_tree(sha, Probe(Status.FALSE, Status.FALSE, []))

    if invert:
        for i, s in enumerate(samples):
            if s.kind != "commit":
                continue
            st = probes_out[i].status
            if st == Status.TRUE:
                probes_out[i] = Probe(Status.FALSE, Status.FALSE, probes_out[i].witnesses)
            elif st == Status.FALSE:
                probes_out[i] = Probe(Status.TRUE, Status.TRUE, ["(no match)"])

    for i, sample in enumerate(samples):
        if sample.kind not in ("worktree", "index"):
            if sample.kind == "empty":
                probes_out[i] = Probe(Status.EMPTY, Status.EMPTY, [])
            continue
        nprobe += 1
        extra = flags(text_only=True, treat_binary=False)
        if sample.kind == "index":
            cmd = ["grep", *extra, "--cached", *path_args]
        else:
            cmd = ["grep", *extra, *path_args]
        proc = git(repo, *cmd)
        kind = _grep_error_kind(proc.stderr, proc.returncode)
        if kind == "bad_pattern":
            probes_out[i] = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(invalid regex)"])
            continue
        if kind == "error":
            probes_out[i] = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(grep)"])
            continue
        text_hits = _parse_worktree_grep(proc.stdout) if proc.returncode == 0 else []
        if text_hits:
            if invert:
                probes_out[i] = Probe(Status.FALSE, Status.FALSE, text_hits[:12])
            else:
                probes_out[i] = Probe(Status.TRUE, Status.TRUE, text_hits[:12])
            continue
        extra_a = flags(text_only=False, treat_binary=True)
        if sample.kind == "index":
            cmd_a = ["grep", *extra_a, "--cached", *path_args]
        else:
            cmd_a = ["grep", *extra_a, *path_args]
        proc_a = git(repo, *cmd_a)
        nprobe += 1
        kind_a = _grep_error_kind(proc_a.stderr, proc_a.returncode)
        if kind_a == "bad_pattern":
            probes_out[i] = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(invalid regex)"])
            continue
        if kind_a == "error":
            probes_out[i] = Probe(Status.UNKNOWN, Status.UNKNOWN, ["(grep)"])
            continue
        bin_hits = _parse_worktree_grep(proc_a.stdout) if proc_a.returncode == 0 else []
        if bin_hits:
            probes_out[i] = Probe(Status.EMPTY, Status.EMPTY, bin_hits[:12])
        else:
            if invert:
                probes_out[i] = Probe(Status.TRUE, Status.TRUE, ["(no match)"])
            else:
                probes_out[i] = Probe(Status.FALSE, Status.FALSE, [])
    return probes_out, nprobe, None


def probe_exec(
    repo: str,
    samples: Sequence[Sample],
    command: Sequence[str],
    *,
    timeout: float,
) -> tuple[list[Probe], int]:
    probes_out: list[Probe] = [Probe(Status.FALSE, Status.FALSE) for _ in samples]
    nprobe = 0
    tmp: Optional[str] = None
    created_worktree = False
    try:
        first_commit = next((s.sha for s in samples if s.kind == "commit"), None)
        if first_commit is None:
            for i, sample in enumerate(samples):
                if sample.kind == "empty":
                    probes_out[i] = Probe(Status.EMPTY, Status.EMPTY, [])
                    continue
                nprobe += 1
                probes_out[i] = _run_exec_command(
                    command, cwd=repo, sample=sample, timeout=timeout
                )
            return probes_out, nprobe

        tmp = tempfile.mkdtemp(prefix="weir-wt-")
        add = git(repo, "worktree", "add", "--detach", "-f", tmp, first_commit)
        if add.returncode != 0:
            raise FordError(add.stderr.strip() or "git worktree add failed")
        created_worktree = True
        git(tmp, "config", "core.hooksPath", "/dev/null")

        for i, sample in enumerate(samples):
            nprobe += 1
            if sample.kind == "commit":
                chk = git(tmp, "checkout", "--detach", "-f", "-q", sample.sha)
                if chk.returncode != 0:
                    probes_out[i] = Probe(
                        Status.UNKNOWN, Status.UNKNOWN, ["(checkout failed)"]
                    )
                    continue
                cwd = tmp
            elif sample.kind == "empty":
                probes_out[i] = Probe(Status.EMPTY, Status.EMPTY, [])
                continue
            else:
                cwd = repo
            probes_out[i] = _run_exec_command(
                command, cwd=cwd, sample=sample, timeout=timeout
            )
    finally:
        if created_worktree:
            git(repo, "worktree", "remove", "--force", tmp or "")
        elif tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    return probes_out, nprobe


def _run_exec_command(
    command: Sequence[str],
    *,
    cwd: str,
    sample: Sample,
    timeout: float,
) -> Probe:
    env = os.environ.copy()
    env["WEIR_COMMIT"] = sample.sha
    env["WEIR_KIND"] = sample.kind
    env["WEIR_SUBJECT"] = sample.subject
    env["FORD_COMMIT"] = sample.sha
    env["FORD_KIND"] = sample.kind
    env["FORD_SUBJECT"] = sample.subject
    env["STEAD_COMMIT"] = sample.sha
    env["HELD_COMMIT"] = sample.sha
    try:
        proc = subprocess.Popen(
            list(command),
            cwd=cwd,
            text=True,
            encoding="utf-8",
            errors="replace",
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            start_new_session=True,
        )
    except FileNotFoundError as exc:
        raise FordError(f"exec command not found: {exc}") from exc
    try:
        stdout, stderr = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        try:
            proc.communicate(timeout=1)
        except Exception:
            pass
        return Probe(Status.UNKNOWN, Status.UNKNOWN, ["(timeout)"])
    ok = proc.returncode == 0
    witness: list[str] = []
    if stdout and stdout.strip():
        witness.append(stdout.strip().splitlines()[0][:120])
    elif not ok and stderr and stderr.strip():
        witness.append(stderr.strip().splitlines()[0][:120])
    st = Status.TRUE if ok else Status.FALSE
    return Probe(st, st, witness)


def apply_horizon_trees(
    samples: Sequence[Sample],
    by_sha: dict[str, Probe],
    *,
    shallow: set[str],
    probed: set[str],
) -> set[str]:
    """Rewrite measurable occupancy at a graft into SHALLOW.

    A second parent that we extra-probed is *not* a horizon — that is the
    whole point of a ford. Horizon is: sha in .git/shallow, missing object,
    or a walked commit whose parents were never measured.
    """
    horizon: set[str] = set()
    walked = {s.sha for s in samples if s.kind == "commit"}
    for s in samples:
        if s.kind != "commit":
            continue
        if s.sha in shallow:
            horizon.add(s.sha)
            continue
        unmeasured = [p for p in s.parents if p not in probed]
        if s.parents and unmeasured:
            horizon.add(s.sha)
        _ = walked
    for sha in list(by_sha):
        if sha in shallow:
            horizon.add(sha)

    saw_true = False
    for s in samples:
        if s.kind != "commit":
            continue
        p = by_sha.get(s.sha)
        if p is not None and p.raw == Status.TRUE:
            saw_true = True
            break
    for sha in horizon:
        p = by_sha.get(sha)
        if p is not None and p.status in (Status.TRUE, Status.EMPTY):
            p.status = Status.SHALLOW
    if not saw_true and horizon:
        for s in samples:
            if s.kind != "commit":
                continue
            p = by_sha.get(s.sha)
            if p is not None and p.status == Status.FALSE:
                p.status = Status.SHALLOW
    return horizon


def extra_parent_shas(samples: Sequence[Sample]) -> list[str]:
    """Immediate off-walk parents (ford). Recursive collection is separate."""
    walked = {s.sha for s in samples if s.kind == "commit"}
    extra: list[str] = []
    seen: set[str] = set()
    for s in samples:
        if s.kind != "commit" or len(s.parents) < 2:
            continue
        for p in s.parents:
            if p not in walked and p not in seen:
                seen.add(p)
                extra.append(p)
    return extra


def collect_join_shas(
    samples: Sequence[Sample],
    extra_meta: dict[str, Optional[Sample]],
    repo: str,
) -> tuple[list[str], dict[str, Optional[Sample]]]:
    """Every SHA the recursive join may need: off-walk parents of merges,
    and parents of those parents when *they* are merges.

    A non-merge parent stops the walk (its occupancy is its tree).
    """
    walked = {s.sha: s for s in samples if s.kind == "commit"}
    meta: dict[str, Optional[Sample]] = dict(extra_meta)
    for s in walked.values():
        meta.setdefault(s.sha, s)

    extra: list[str] = []
    seen: set[str] = set(walked)
    frontier: list[str] = []
    for s in samples:
        if s.kind != "commit" or len(s.parents) < 2:
            continue
        for p in s.parents:
            if p not in seen:
                frontier.append(p)

    while frontier:
        batch: list[str] = []
        for sha in frontier:
            if sha in seen:
                continue
            seen.add(sha)
            extra.append(sha)
            batch.append(sha)
        frontier = []
        if not batch:
            break
        loaded = load_commits(repo, batch)
        for sha in batch:
            node = loaded.get(sha)
            meta[sha] = node
            if node is not None and len(node.parents) >= 2:
                for p in node.parents:
                    if p not in seen:
                        frontier.append(p)
    return extra, meta


def _parent_equation(parents: Sequence[ParentJoin], op: str, result: Status) -> str:
    if not parents:
        return ""
    sym = lattice_symbol(op)
    bits = f" {sym} ".join(pj.status.value for pj in parents)
    return f"{bits} = {result.value}"


def _any_parent_held_true(parents: Sequence[ParentJoin]) -> bool:
    for pj in parents:
        if pj.status == Status.TRUE:
            return True
        if pj.join_parents and _any_parent_held_true(pj.join_parents):
            return True
        if pj.tree == Status.TRUE:
            return True
    return False


def _find_origin(parents: Sequence[ParentJoin]) -> Optional[ParentJoin]:
    """Deepest introducing TRUE: nested occupancy first, then immediate."""
    for pj in parents:
        if pj.is_merge and pj.join_parents:
            nested = _find_origin(pj.join_parents)
            if nested is not None:
                return nested
    for pj in parents:
        if pj.status == Status.TRUE:
            return pj
    return None


def _subject_of(
    sha: str,
    samples: Sequence[Sample],
    extra_meta: dict[str, Optional[Sample]],
) -> str:
    meta = extra_meta.get(sha)
    if meta is not None:
        return meta.subject
    for w in samples:
        if w.sha == sha:
            return w.subject
    return ""


def apply_join(
    samples: Sequence[Sample],
    tree_by_sha: dict[str, Probe],
    tree_walk: Sequence[Probe],
    *,
    op: str,
    tree_mode: bool,
    boolean: bool,
    extra_meta: dict[str, Optional[Sample]],
) -> list[Probe]:
    """Occupancy of a merge is the lattice of parent *occupancy*.

    A merge-parent that is itself a merge contributes its occupancy
    lattice, not its tree. That is the hole ford named and refused.
    """
    walk_meta: dict[str, Sample] = {
        s.sha: s for s in samples if s.kind == "commit"
    }
    occ_cache: dict[str, Probe] = {}
    in_progress: set[str] = set()

    def occupancy_of(sha: str) -> Probe:
        cached = occ_cache.get(sha)
        if cached is not None:
            return cached
        if sha in in_progress:
            tp = tree_by_sha.get(sha)
            if tp is None:
                return Probe(Status.SHALLOW, Status.SHALLOW, ["(missing parent)"])
            got = _copy_probe(tp)
            got.tree = tp.status
            return got
        in_progress.add(sha)
        try:
            tp = tree_by_sha.get(sha)
            if tp is None:
                got = Probe(Status.SHALLOW, Status.SHALLOW, ["(missing parent)"])
                occ_cache[sha] = got
                return got
            meta = extra_meta.get(sha) or walk_meta.get(sha)
            if (
                meta is None
                or len(meta.parents) < 2
                or tree_mode
                or boolean
            ):
                got = _copy_probe(tp)
                got.tree = tp.status
                occ_cache[sha] = got
                return got

            parents: list[ParentJoin] = []
            pst: list[Status] = []
            recursive = False
            for psha in meta.parents:
                pocc = occupancy_of(psha)
                ptree_p = tree_by_sha.get(psha)
                tree_st = ptree_p.status if ptree_p is not None else pocc.tree
                pmeta = extra_meta.get(psha) or walk_meta.get(psha)
                parent_is_merge = bool(pmeta is not None and len(pmeta.parents) >= 2)
                if parent_is_merge:
                    recursive = True
                source = "occupancy" if parent_is_merge else "tree"
                eq = ""
                if parent_is_merge and pocc.join_parents:
                    eq = _parent_equation(
                        pocc.join_parents,
                        pocc.join_op or op,
                        pocc.join_result or pocc.status,
                    )
                st = pocc.status
                wits = list(pocc.witnesses)
                if ptree_p is None and not parent_is_merge:
                    st = Status.SHALLOW
                    wits = ["(missing parent)"]
                pst.append(st)
                parents.append(
                    ParentJoin(
                        sha=psha,
                        short=psha[:7],
                        status=st,
                        subject=_subject_of(psha, samples, extra_meta),
                        witnesses=wits,
                        tree=tree_st,
                        is_merge=parent_is_merge,
                        source=source,
                        join_op=pocc.join_op if parent_is_merge else None,
                        join_parents=list(pocc.join_parents) if parent_is_merge else [],
                        join_result=pocc.join_result if parent_is_merge else None,
                        join_equation=eq,
                    )
                )
            result = lattice_apply(op, pst)
            tree_inputs: list[Status] = []
            for pj in parents:
                tree_inputs.append(pj.tree if pj.tree is not None else pj.status)
            tree_join = lattice_apply(op, tree_inputs)
            reason = ""
            is_weir = False
            is_ford = False
            if recursive and tree_join != result:
                # the hole: tree-join would have been T⊓T preserve; occupancy is not
                is_weir = True
                reason = "recursive"
            elif len(set(pst)) > 1:
                is_weir = True
                is_ford = not recursive
                reason = "disagree"
            elif tp.status != result:
                is_weir = True
                is_ford = not recursive
                reason = "tree"
            wits: list[str] = []
            for pj in parents:
                if pj.status in (Status.TRUE, Status.EMPTY):
                    wits.extend(pj.witnesses)
            wits = _uniq(wits)
            if result == Status.UNKNOWN and not wits:
                wits = ["(join)"]
            refused = _any_parent_held_true(parents)
            got = Probe(
                status=result,
                raw=result,
                witnesses=wits,
                tree=tp.status,
                is_merge=True,
                is_ford=is_ford,
                is_weir=is_weir,
                recursive=recursive,
                ford_reason=reason,
                join_op=op,
                join_parents=parents,
                join_result=result,
                refused_birth=refused,
            )
            occ_cache[sha] = got
            return got
        finally:
            in_progress.discard(sha)

    out: list[Probe] = []
    for i, s in enumerate(samples):
        base = _copy_probe(tree_walk[i])
        base.tree = tree_walk[i].status
        if s.kind != "commit" or tree_mode or boolean:
            out.append(base)
            continue
        if len(s.parents) < 2:
            out.append(base)
            continue
        out.append(occupancy_of(s.sha))
    return out


def booleanize(probes: Sequence[Probe]) -> list[Probe]:
    """Lossy held recovery: tree TRUE stays, everything else is FALSE."""
    out: list[Probe] = []
    for p in probes:
        tree = p.tree if p.tree is not None else p.raw
        if tree == Status.TRUE:
            out.append(Probe(Status.TRUE, Status.TRUE, list(p.witnesses), tree=p.tree))
        else:
            wits = list(p.witnesses) if tree != Status.FALSE else []
            out.append(Probe(Status.FALSE, tree, wits, tree=p.tree))
    return out


def _is_chain(members: Sequence[int], samples: Sequence[Sample]) -> bool:
    if len(members) <= 1:
        return True
    if members[-1] - members[0] + 1 != len(members):
        return False
    for pos in range(1, len(members)):
        cur = samples[members[pos]]
        prev = samples[members[pos - 1]]
        if cur.kind == "commit" and prev.kind == "commit":
            if prev.sha not in cur.parents and cur.sha not in prev.parents:
                return False
    return True


def _era_from_members(
    members: list[int],
    samples: Sequence[Sample],
    probes: Sequence[Probe],
) -> Era:
    first = probes[members[0]]
    crossing = first.is_weir or first.is_ford
    kind = "run"
    if first.is_weir:
        kind = "weir"
    elif first.is_ford:
        kind = "ford"
    elif samples[members[0]].kind == "worktree":
        kind = "worktree"
    elif samples[members[0]].kind == "empty":
        kind = "unborn"
    origin = None
    if crossing and first.join_parents:
        origin = _find_origin(first.join_parents)
    return Era(
        status=first.status,
        start=samples[members[0]],
        end=samples[members[-1]],
        count=len(members),
        members=[samples[j] for j in members],
        witnesses_start=list(probes[members[0]].witnesses),
        witnesses_end=list(probes[members[-1]].witnesses),
        chain=_is_chain(members, samples),
        raw=first.raw,
        kind=kind,
        is_ford=first.is_ford,
        is_weir=first.is_weir,
        recursive=first.recursive,
        join_op=first.join_op,
        join_parents=list(first.join_parents),
        join_result=first.join_result,
        tree=first.tree,
        ford_reason=first.ford_reason,
        origin=origin,
        refused_birth=first.refused_birth,
    )


def compress_list(samples: Sequence[Sample], probes: Sequence[Probe]) -> list[Era]:
    """Compress adjacent samples. A ford is always its own era."""
    if not samples:
        return []
    eras: list[Era] = []
    start = 0
    for i in range(1, len(samples) + 1):
        same = False
        if i < len(samples):
            same = (
                probes[i].status == probes[start].status
                and not probes[i].is_ford
                and not probes[start].is_ford
                and not probes[i].is_weir
                and not probes[start].is_weir
            )
        if same:
            continue
        eras.append(_era_from_members(list(range(start, i)), samples, probes))
        start = i
    return eras


def compress_lattice(samples: Sequence[Sample], probes: Sequence[Probe]) -> list[Era]:
    n = len(samples)
    if n == 0:
        return []
    parent_uf = list(range(n))

    def find(x: int) -> int:
        while parent_uf[x] != x:
            parent_uf[x] = parent_uf[parent_uf[x]]
            x = parent_uf[x]
        return x

    def union(a: int, b: int) -> None:
        ra, rb = find(a), find(b)
        if ra != rb:
            parent_uf[rb] = ra

    idx_by_sha = {s.sha: i for i, s in enumerate(samples) if s.kind == "commit"}
    last_commit = None
    for i, s in enumerate(samples):
        if s.kind == "commit":
            last_commit = i

    for i, s in enumerate(samples):
        if probes[i].is_ford or probes[i].is_weir:
            continue
        if s.kind == "commit":
            for p in s.parents:
                j = idx_by_sha.get(p)
                if j is None or probes[j].is_ford or probes[j].is_weir:
                    continue
                if probes[i].status == probes[j].status:
                    union(i, j)
        elif last_commit is not None and probes[i].status == probes[last_commit].status:
            if not probes[last_commit].is_ford and not probes[last_commit].is_weir:
                union(i, last_commit)

    groups: dict[int, list[int]] = defaultdict(list)
    for i in range(n):
        groups[find(i)].append(i)

    eras: list[Era] = []
    for members in sorted(groups.values(), key=lambda m: (min(m), m[0])):
        members = sorted(members)
        eras.append(_era_from_members(members, samples, probes))
    return eras


def _origin_sha(era: Era) -> str:
    return era.origin.sha if era.origin is not None else ""


def compress_inherited(eras: list[Era]) -> list[Era]:
    """After the first recursive weir, later same-origin weirs are cascade.

    kizu: 21ae074 is the merge-of-merges. PR #3–#6 reprint the same
    FALSE ⊓ TRUE occupancy. That is not a new crossing.
    """
    out: list[Era] = []
    i = 0
    n = len(eras)
    while i < n:
        era = eras[i]
        out.append(era)
        if not (era.is_weir and era.recursive):
            i += 1
            continue
        j = i + 1
        chunk: list[Era] = []
        while j < n:
            nxt = eras[j]
            if (
                nxt.is_weir
                and nxt.recursive
                and nxt.status == era.status
                and _origin_sha(nxt) == _origin_sha(era)
            ):
                chunk.append(nxt)
                j += 1
            else:
                break
        if chunk:
            members: list[Sample] = []
            for e in chunk:
                members.extend(e.members)
            first, last = chunk[0], chunk[-1]
            out.append(
                Era(
                    status=first.status,
                    start=first.start,
                    end=last.end,
                    count=len(members),
                    members=members,
                    witnesses_start=list(first.witnesses_start),
                    witnesses_end=list(last.witnesses_end),
                    chain=True,
                    raw=first.raw,
                    kind="inherited",
                    is_ford=False,
                    is_weir=True,
                    recursive=True,
                    join_op=first.join_op,
                    join_parents=[],
                    join_result=first.join_result,
                    tree=last.tree,
                    ford_reason="inherited",
                    origin=era.origin,
                    continued_from=era.start,
                    refused_birth=True,
                )
            )
        i = j
    return out


def annotate_continuations(eras: list[Era]) -> None:
    """A TRUE run after a weir is continued occupancy, not a birth.

    ford named 21ae074 preserve because parent *trees* were T⊓T.
    weir occupancy at 21ae074 is the recursive join (FALSE ⊓ TRUE);
    the next TRUE (a non-merge snapshot, or a real T⊓T occupancy
    preserve) is continue/preserve after the weir, origin still the
    introducing TRUE parent. Refuse birth at any merge whose parents
    already held TRUE.
    """
    pending_origin: Optional[ParentJoin] = None
    pending_weir: Optional[Sample] = None
    for era in eras:
        if era.kind == "inherited":
            continue
        crossing = era.is_weir or era.is_ford
        if crossing and era.origin is not None:
            pending_origin = era.origin
            pending_weir = era.start
            if era.refused_birth and era.kind == "run":
                era.kind = "weir"
            continue
        if era.status == Status.FALSE and not crossing:
            pending_origin = None
            pending_weir = None
            continue
        if (
            era.status == Status.TRUE
            and not crossing
            and pending_origin is not None
        ):
            era.origin = pending_origin
            era.continued_from = pending_weir
            if era.start.kind == "commit" and len(era.start.parents) >= 2:
                era.kind = "preserve"
            else:
                era.kind = "continue"
            pending_origin = None
            pending_weir = None
        if era.refused_birth and era.kind == "run":
            era.kind = "weir"


def count_reachable(repo: str, spec: str) -> int:
    proc = git(repo, "rev-list", "--count", spec)
    if proc.returncode != 0:
        return 0
    try:
        return int(proc.stdout.strip() or "0")
    except ValueError:
        return 0


def _hit_span(samples: Sequence[Sample], probes: Sequence[Probe]) -> tuple[int, str]:
    hits = [
        s
        for s, p in zip(samples, probes)
        if p.status == Status.TRUE and s.kind == "commit"
    ]
    if not hits:
        return 0, ""
    first, last = hits[0], hits[-1]
    if first.sha == last.sha:
        span = f"{first.short} {first.subject}"
    else:
        span = f"{first.short}..{last.short}  {first.iso[:10]} → {last.iso[:10]}"
    return len(hits), span


def _shell_single_quote(s: str) -> str:
    return "'" + s.replace("'", "'\\''") + "'"


def join_equation(era: Era) -> str:
    if not era.join_parents:
        return ""
    sym = lattice_symbol(era.join_op or "all")
    bits = f" {sym} ".join(pj.status.value for pj in era.join_parents)
    res = (era.join_result or era.status).value
    return f"{bits} = {res}"


def diagnose(
    *,
    args: argparse.Namespace,
    repo: str,
    samples: Sequence[Sample],
    probes: Sequence[Probe],
    end_rev: str,
    horizon: set[str],
) -> tuple[list[str], list[str], int]:
    warnings: list[str] = []
    hints: list[str] = []
    extra = 0
    first_parent = not args.full
    statuses = [p.status for p in probes]
    saw_true = any(s == Status.TRUE for s in statuses)
    saw_shallow = any(s == Status.SHALLOW for s in statuses)
    saw_unknown = any(s == Status.UNKNOWN for s in statuses)
    saw_empty = any(s == Status.EMPTY for s in statuses)
    crossings = [p for p in probes if p.is_weir or p.is_ford]

    if saw_shallow:
        hints.append(
            "SHALLOW: the walk starts at a graft or --limit/--range horizon; "
            "this is not birth and not never-held. unshallow, drop --limit, or clone full history"
        )
    if saw_unknown:
        hints.append(
            "UNKNOWN: a probe failed (timeout, invalid regex, checkout). "
            "that is not FALSE and does not compress into a never-held era"
        )
    if saw_empty and args.cmd == "grep":
        hints.append(
            "EMPTY: the token occupies a binary/NUL blob only. "
            "that is not text occupancy and not a FALSE death"
        )
    seen_hint: set[tuple] = set()
    for p in crossings:
        if not p.join_parents:
            continue
        intro = _find_origin(p.join_parents)
        key = (p.recursive, intro.sha if intro else "", p.status.value)
        if key in seen_hint:
            continue
        seen_hint.add(key)
        eq = f" {lattice_symbol(p.join_op or 'all')} ".join(
            pj.status.value for pj in p.join_parents
        )
        eq += f" = {(p.join_result or p.status).value}"
        sides = ", ".join(f"{pj.short}={pj.status.value}" for pj in p.join_parents)
        tree = p.tree.value if p.tree else "?"
        if (p.join_op or "all") == "all" and p.status != Status.TRUE:
            via = f" origin {intro.short}" if intro else ""
            rec = "; recursive occupancy not tree" if p.recursive else ""
            hints.append(
                f"weir {eq} (does not preserve; tree={tree}{via}{rec}; parents {sides}). "
                "not a boolean birth at the merge. --any to treat introduce-via-side as TRUE"
            )
        elif (p.join_op or "all") == "any" and p.status == Status.TRUE:
            via = f" via {intro.short} {intro.subject}".rstrip() if intro else ""
            rec = " recursive occupancy" if p.recursive else ""
            hints.append(
                f"weir {eq} (introduced{via}{rec}; parents {sides}). "
                "the merge is a join, not a birth"
            )

    dead_paths: list[str] = []
    if args.cmd == "grep" and args.paths and not saw_unknown:
        for path in args.paths:
            if is_glob(path):
                continue
            vals, n = probe_exists(repo, samples, path)
            extra += n
            if not any(p.status == Status.TRUE for p in vals):
                dead_paths.append(path)
        if dead_paths:
            phrase = " ".join([args.pattern, *dead_paths])
            warnings.append(
                "pathspec "
                + ", ".join(repr(p) for p in dead_paths)
                + " matched no file in any scanned commit. "
                + "If you meant a phrase, quote it: weir grep "
                + _shell_single_quote(phrase)
            )

    never_measurable = (
        not saw_true and not saw_shallow and not saw_unknown and not saw_empty
    )
    has_commits = any(s.kind == "commit" for s in samples)
    last = probes[-1] if probes else None
    if (
        last is not None
        and last.tree == Status.TRUE
        and last.status != Status.TRUE
        and last.is_merge
        and not args.any
        and not args.tree
    ):
        hints.append(
            "HEAD tree is TRUE but occupancy is the parent join "
            f"({last.status.value}). --any for introduce-via-side, --tree for the snapshot"
        )

    if (
        args.cmd in ("exists", "glob")
        and first_parent
        and never_measurable
        and has_commits
    ):
        path = args.path if args.cmd == "exists" else args.pattern
        if path:
            full_samples = list_samples(
                repo,
                end_rev=end_rev,
                rev_range=args.rev_range,
                first_parent=False,
                limit=None,
            )
            if args.cmd == "exists" and not is_glob(path):
                vals, n = probe_exists(repo, full_samples, path)
            else:
                vals, n = probe_glob(repo, full_samples, path)
            extra += n
            n_hit, span = _hit_span(full_samples, vals)
            if n_hit:
                hints.append(
                    f"never held on first-parent, but existed in {n_hit} reachable commit"
                    f"{'' if n_hit == 1 else 's'} off the mainline ({span}). rerun with --full"
                )

    if (
        args.cmd == "grep"
        and never_measurable
        and not args.invert_match
        and not dead_paths
        and has_commits
    ):
        if not args.ignore_case:
            vals, n, bad = probe_grep(
                repo,
                samples,
                args.pattern,
                args.paths,
                ignore_case=True,
                fixed=args.fixed_strings,
                word=args.word_regexp,
                invert=False,
            )
            extra += n
            if not bad:
                ci_hits = sum(
                    1
                    for s, p in zip(samples, vals)
                    if p.status in (Status.TRUE, Status.EMPTY) and s.kind == "commit"
                )
                if ci_hits:
                    example = ""
                    for p in vals:
                        if p.witnesses:
                            example = p.witnesses[0]
                            break
                    extra_ex = f" (e.g. {example})" if example else ""
                    hints.append(
                        f"0 case-sensitive matches; {ci_hits} commit"
                        f"{'' if ci_hits == 1 else 's'} match with -i{extra_ex}. rerun with -i"
                    )
        if first_parent:
            full_samples = list_samples(
                repo,
                end_rev=end_rev,
                rev_range=args.rev_range,
                first_parent=False,
                limit=None,
            )
            vals, n, bad = probe_grep(
                repo,
                full_samples,
                args.pattern,
                args.paths,
                ignore_case=args.ignore_case,
                fixed=args.fixed_strings,
                word=args.word_regexp,
                invert=False,
            )
            extra += n
            if not bad:
                n_hit, span = _hit_span(full_samples, vals)
                if n_hit:
                    hints.append(
                        f"never held on first-parent, but matched in {n_hit} reachable commit"
                        f"{'' if n_hit == 1 else 's'} off the mainline ({span}). rerun with --full"
                    )
    _ = horizon
    return warnings, hints, extra


def era_span(era: Era) -> str:
    if era.count == 1 or era.start.sha == era.end.sha:
        return era.start.short
    if era.chain:
        return f"{era.start.short}..{era.end.short}"
    shorts = [s.short for s in era.members]
    if len(shorts) <= 6:
        return ", ".join(shorts)
    return ", ".join(shorts[:3]) + f", … (+{len(shorts) - 3})"


def _date_span(a: Sample, b: Sample) -> str:
    da = a.iso[:10] if a.iso else ""
    db = b.iso[:10] if b.iso else ""
    if not da and not db:
        return ""
    if da == db or not db:
        return da
    return f"{da} → {db}"


def format_tsv(report: Report, *, header: bool = True) -> str:
    rows: list[str] = []
    if header:
        rows.append(
            "status\tcount\tstart\tend\tstart_iso\tend_iso\tchain\tkind\tjoin\twitnesses"
        )
    for era in report.eras:
        wits = _uniq(era.witnesses_start + era.witnesses_end)
        wcol = ",".join(w.replace("\t", " ") for w in wits[:8])
        if len(wits) > 8:
            wcol += f",+{len(wits) - 8}"
        start_iso = era.start.iso[:19] if era.start.iso else ""
        end_iso = era.end.iso[:19] if era.end.iso else ""
        rows.append(
            "\t".join(
                [
                    era.status.value,
                    str(era.count),
                    era.start.short,
                    era.end.short,
                    start_iso,
                    end_iso,
                    "1" if era.chain else "0",
                    era.kind,
                    join_equation(era).replace("\t", " "),
                    wcol,
                ]
            )
        )
    return "\n".join(rows)


def format_oneline(report: Report) -> str:
    rows = []
    for era in report.eras:
        extra = ""
        if era.is_weir or era.is_ford:
            extra = "  weir " + join_equation(era)
        rows.append(
            f"{era.status.value}\t{era.count}\t{era_span(era)}\t{_date_span(era.start, era.end)}{extra}"
        )
    return "\n".join(rows)


def _format_parent_lines(parents: Sequence[ParentJoin], indent: str) -> list[str]:
    lines: list[str] = []
    for pj in parents:
        src = "occupancy" if pj.source == "occupancy" else "tree"
        extra = ""
        if pj.source == "occupancy" and pj.join_equation:
            extra = f"  {pj.join_equation}"
        if pj.tree is not None and pj.source == "occupancy":
            extra += f"  (tree={pj.tree.value})"
        lines.append(
            f"{indent}parent {pj.short}={pj.status.value}  {src}{extra}  {pj.subject}".rstrip()
        )
        if pj.join_parents:
            nested = _format_parent_lines(pj.join_parents, indent + "       ")
            lines.extend(nested)
    return lines


def format_human(report: Report, *, color: bool, show_witnesses: bool) -> str:
    lines: list[str] = []
    if report.reachable > report.commits_scanned:
        scanned = (
            f"{report.commits_scanned} of {report.reachable} commit"
            + ("" if report.reachable == 1 else "s")
        )
    else:
        scanned = (
            f"{report.commits_scanned} commit"
            + ("" if report.commits_scanned == 1 else "s")
        )
    bits = [
        os.path.basename(report.repo) or report.repo,
        scanned,
        report.walk,
        f"join={report.join_op}",
    ]
    if report.include_now:
        bits.append("now")
    if report.bare:
        bits.append("bare")
    if report.boolean:
        bits.append("boolean")
    if report.tree_mode:
        bits.append("tree")
    lines.append(f"# {report.predicate}  (" + ", ".join(bits) + ")")
    if not report.eras:
        lines.append("  (no samples)")
        return "\n".join(lines)

    label_w = 8
    count_w = max(len(str(e.count)) for e in report.eras) + len(" commits")
    for era in report.eras:
        raw = era.status.value
        label = paint(color, status_color(era.status), f"{raw:<{label_w}}")
        unit = "commit" if era.count == 1 else "commits"
        if era.start.kind != "commit" or era.end.kind != "commit":
            unit = "sample" if era.count == 1 else "samples"
        count = f"{era.count} {unit}".ljust(count_w)
        span = era_span(era)
        dates = _date_span(era.start, era.end)
        lines.append(f"{label}  {count}  {span}  {dates}".rstrip())
        if era.start.sha != era.end.sha:
            lines.append(f"       {era.start.short}  {era.start.subject}")
            lines.append(f"       {era.end.short}  {era.end.subject}")
        else:
            lines.append(f"       {era.start.subject}")
        if era.kind == "inherited":
            src = era.continued_from.short if era.continued_from is not None else "?"
            lines.append(
                f"       inherited weir {src}; occupancy still the recursive "
                "join, not a new crossing"
            )
            if era.origin is not None:
                lines.append(
                    f"       origin: {era.origin.short}  {era.origin.subject}".rstrip()
                    + f"  ({era.origin.status.value} parent)"
                )
            if era.refused_birth:
                lines.append(
                    "       refuse birth: a parent already held TRUE"
                )
        elif era.is_weir or era.is_ford:
            eq = join_equation(era)
            op = era.join_op or report.join_op
            if era.ford_reason == "recursive":
                verb = "recursive: merge-parent contributes occupancy, not tree"
            elif op == "all" and era.status != Status.TRUE:
                verb = "does not preserve"
            elif op == "any" and era.status == Status.TRUE:
                verb = "introduced via a side"
            elif era.ford_reason == "tree":
                verb = "tree disagrees with parent join"
            else:
                verb = "parent occupancy join"
            lines.append(f"       weir  {eq}  ({verb})")
            lines.extend(_format_parent_lines(era.join_parents, indent="       "))
            if era.tree is not None:
                note = ""
                if era.tree == Status.TRUE and era.status != Status.TRUE:
                    if era.ford_reason == "tree":
                        note = "  born in the merge snapshot, not from a parent"
                    else:
                        note = (
                            "  snapshot has it; occupancy is the recursive "
                            "join, not a birth"
                        )
                lines.append(f"       tree={era.tree.value}{note}")
            if era.origin is not None:
                lines.append(
                    f"       origin: {era.origin.short}  {era.origin.subject}".rstrip()
                    + f"  ({era.origin.status.value} parent)"
                )
            if era.refused_birth:
                lines.append(
                    "       refuse birth: a parent already held TRUE"
                )
        elif era.kind in ("preserve", "continue") and era.continued_from is not None:
            lines.append(
                f"       {era.kind} after weir {era.continued_from.short}; not birth"
            )
            if era.origin is not None:
                lines.append(
                    f"       origin: {era.origin.short}  {era.origin.subject}".rstrip()
                    + f"  ({era.origin.status.value} parent)"
                )
        if not era.chain and era.count > 1:
            lines.append(
                "       lattice component (not adjacent in git log --reverse)"
            )
        show = show_witnesses and era.status != Status.FALSE
        if show:
            w = _uniq(era.witnesses_start + era.witnesses_end)
            if w:
                shown = w[:5]
                extra = f" (+{len(w) - 5})" if len(w) > 5 else ""
                lines.append("       witnesses: " + ", ".join(shown) + extra)
        if era.status == Status.SHALLOW:
            lines.append("       graft/horizon: not birth, not never-held")
        elif era.status == Status.EMPTY and report.probe_kind == "grep":
            lines.append("       binary/NUL occupancy, not text FALSE")
        elif era.status == Status.UNKNOWN:
            lines.append("       failed probe, not FALSE")
    if report.commits_scanned:
        true_bit = f"true={report.true_commits}/{report.commits_scanned}"
    else:
        true_n = sum(1 for e in report.eras if e.status == Status.TRUE for _ in e.members)
        sample_n = sum(e.count for e in report.eras)
        true_bit = f"true={true_n}/{sample_n} samples"
    summary = (
        f"now={report.holds_now.value}  "
        f"{true_bit}  "
        f"eras={len(report.eras)}  weirs={report.weirs}  fords={report.fords}  probes={report.probes}  "
        f"walk={report.walk}  join={report.join_op}"
    )
    extra_bits = []
    if report.tree_now is not None:
        extra_bits.append(f"tree_now={report.tree_now.value}")
    if report.shallow_commits:
        extra_bits.append(f"shallow={report.shallow_commits}")
    if report.unknown_commits:
        extra_bits.append(f"unknown={report.unknown_commits}")
    if report.empty_commits:
        extra_bits.append(f"empty={report.empty_commits}")
    if extra_bits:
        summary += "  " + " ".join(extra_bits)
    lines.append(summary)
    for warning in report.warnings:
        lines.append("warning: " + warning)
    for hint in report.hints or ([report.hint] if report.hint else []):
        lines.append("hint: " + hint)
    return "\n".join(lines)


def format_bounds(report: Report, *, only_true: bool) -> str:
    rows = []
    for era in report.eras:
        if only_true and era.status != Status.TRUE:
            continue
        rows.append(
            f"{era.start.sha} {era.end.sha} {era.status.value} {era.count}"
        )
    return "\n".join(rows)


def parent_dict(pj: ParentJoin) -> dict:
    return {
        "sha": pj.sha,
        "short": pj.short,
        "status": pj.status.value,
        "subject": pj.subject,
        "witnesses": pj.witnesses,
        "tree": pj.tree.value if pj.tree else None,
        "is_merge": pj.is_merge,
        "source": pj.source,
        "join": pj.join_equation or None,
        "join_op": pj.join_op,
        "join_result": pj.join_result.value if pj.join_result else None,
        "parents": [parent_dict(n) for n in pj.join_parents],
    }


