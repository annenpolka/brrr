            }
            for e in report.eras
        ],
        "hint": report.hint,
        "hints": report.hints,
        "warnings": report.warnings,
    }


def lattice_table(op: str) -> list[list[str]]:
    order = [
        Status.TRUE,
        Status.EMPTY,
        Status.UNKNOWN,
        Status.SHALLOW,
        Status.FALSE,
    ]
    fn = join if op == "any" else meet
    header = [op] + [s.value for s in order]
    rows = [header]
    for a in order:
        row = [a.value]
        for b in order:
            row.append(fn(a, b).value)
        rows.append(row)
    return rows


def format_lattice(*, op: str, as_json: bool) -> str:
    if as_json:
        tables = {}
        for name in ("all", "any"):
            tab = lattice_table(name)
            tables[name] = {
                "symbol": lattice_symbol(name),
                "order": [s.value for s in RANK],
                "rank": {s.value: r for s, r in RANK.items()},
                "table": tab,
            }
        tables["note"] = (
            "FALSE ⊑ SHALLOW ⊑ UNKNOWN ⊑ EMPTY ⊑ TRUE. "
            "meet (--all, preserve) is inf; join (--any, introduce) is sup. "
            "A missing parent is SHALLOW, a timeout is UNKNOWN; neither is FALSE."
        )
        return json.dumps(tables, indent=2)
    lines = [
        "weir lattice  FALSE ⊑ SHALLOW ⊑ UNKNOWN ⊑ EMPTY ⊑ TRUE",
        "meet ⊓  (--all, default): TRUE iff every parent TRUE (preserve)",
        "join ⊔  (--any):          TRUE if any parent TRUE (introduce via a side)",
        "",
    ]
    names = [op] if op in ("all", "any") else ["all", "any"]
    for name in names:
        tab = lattice_table(name)
        sym = lattice_symbol(name)
        lines.append(f"# {name}  {sym}")
        widths = [max(len(tab[r][c]) for r in range(len(tab))) for c in range(len(tab[0]))]
        for row in tab:
            lines.append("  ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)))
        lines.append("")
    return "\n".join(lines).rstrip()


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="weir",
        description=(
            "Occupancy of a merge is a recursive join of parent occupancy, "
            "not a boolean sample on the merge SHA and not a parent-tree join. "
            "A merge-parent that is itself a merge contributes its occupancy "
            "lattice, not its tree. Statuses TRUE / FALSE / UNKNOWN / SHALLOW / EMPTY. "
            "A failed probe is not FALSE. --follow is berth. --boolean that "
            "downcasts UNKNOWN is a refuse."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  weir exists src/app.py                 # merge: meet of parent occupancy
  weir --any exists src/app.py           # merge: join of parent occupancy
  weir --tree exists src/app.py          # sample the merge SHA (held/stead)
  weir lattice                           # print the 5×5 tables
  weir --now -C empty-dirty exists README.md
""",
    )
    parser.add_argument("-C", "--repo", default=None, help="repository (default: cwd)")
    parser.add_argument("--rev", default="HEAD", help="end revision (default: HEAD)")
    parser.add_argument("--range", dest="rev_range", default=None, help="limit to A..B")
    parser.add_argument(
        "--full",
        action="store_true",
        help="walk every reachable commit; compress along the DAG, not log order",
    )
    parser.add_argument(
        "--list",
        dest="list_order",
        action="store_true",
        help="compress git log --reverse order (held's lie) instead of the lattice",
    )
    parser.add_argument(
        "--now",
        action="store_true",
        help="append the working tree as a final sample (works with no commits)",
    )
    parser.add_argument(
        "--index",
        action="store_true",
        help="append the index as a sample",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="keep only the last N commits (creates a horizon, reported as SHALLOW)",
    )
    parser.add_argument(
        "--any",
        action="store_true",
        help="join: TRUE if any parent TRUE (the merge introduces via a side)",
    )
    parser.add_argument(
        "--all",
        dest="join_all",
        action="store_true",
        help="meet: TRUE iff all parents TRUE (default; the merge preserves)",
    )
    parser.add_argument(
        "--tree",
        action="store_true",
        help="sample the merge SHA like held/stead; disable the parent join",
    )
    parser.add_argument("--json", action="store_true", help="machine-readable report")
    parser.add_argument(
        "--tsv",
        action="store_true",
        help="TSV eras (default when stdout is not a tty)",
    )
    parser.add_argument("--human", action="store_true", help="human report")
    parser.add_argument("--oneline", action="store_true", help="status count span dates")
    parser.add_argument("--revs", action="store_true", help="print SHAs where status is TRUE")
    parser.add_argument(
        "--bounds",
        action="store_true",
        help="print start_sha end_sha status count",
    )
    parser.add_argument(
        "--true-bounds",
        action="store_true",
        help="like --bounds but only TRUE eras",
    )
    parser.add_argument(
        "--boolean",
        action="store_true",
        help=(
            "labelled lie: downcast recursive occupancy to tree TRUE/else-FALSE "
            "(held recovery). refused if any sample is UNKNOWN/SHALLOW/EMPTY"
        ),
    )
    parser.add_argument(
        "--follow",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument("-q", "--quiet", action="store_true", help="exit code only")
    parser.add_argument(
        "--color",
        choices=("auto", "always", "never"),
        default="auto",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=30.0,
        help="seconds per exec probe (default: 30). must be > 0",
    )
    parser.add_argument(
        "--no-witnesses",
        action="store_true",
        help="do not print witness paths",
    )
    parser.add_argument(
        "--no-header",
        action="store_true",
        help="omit the TSV header row",
    )

    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser(
        "lattice",
        help="print the 5-status meet/join tables (no repository needed)",
    )

    p_exists = sub.add_parser(
        "exists",
        help="TRUE when PATH exists (exact; one cat-file batch). globs: use glob",
    )
    p_exists.add_argument("path", help="exact path relative to repo root")

    p_glob = sub.add_parser(
        "glob",
        help="TRUE when any path matches PATTERN (per unique tree, not exists)",
    )
    p_glob.add_argument("pattern", help="fnmatch pattern relative to repo root")

    p_grep = sub.add_parser(
        "grep",
        help="TRUE on text match; EMPTY on binary/NUL-only match; UNKNOWN on bad regex",
    )
    p_grep.add_argument("-i", "--ignore-case", action="store_true")
    p_grep.add_argument("-F", "--fixed-strings", action="store_true")
    p_grep.add_argument("-w", "--word-regexp", action="store_true")
    p_grep.add_argument("-v", "--invert-match", action="store_true")
    p_grep.add_argument("pattern")
    p_grep.add_argument("paths", nargs="*", help="optional path limiters")

    p_exec = sub.add_parser(
        "exec",
        help="TRUE when COMMAND exits 0; timeout/checkout fail is UNKNOWN",
    )
    p_exec.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="command to run; prefix with -- to avoid flag eating",
    )

    args = parser.parse_args(list(argv))
    if args.cmd == "exec":
        command = list(args.command)
        if command and command[0] == "--":
            command = command[1:]
        if not command:
            parser.error("exec requires a command")
        args.command = command
    if args.timeout is None or args.timeout <= 0:
        parser.error("--timeout must be > 0 (a timeout is UNKNOWN; 0 is not a probe)")
    if args.cmd == "exists" and is_glob(args.path):
        parser.error(
            "exists is exact path occupancy (one cat-file batch). "
            f"glob is a different cost class: weir glob {args.path}"
        )
    if getattr(args, "follow", False):
        parser.error("--follow is berth, not this object")
    if args.any and args.join_all:
        parser.error("use either --any (join) or --all (meet), not both")
    if args.any and args.tree:
        parser.error("--tree samples the merge SHA; --any has no join to apply")
    args.join_op = "any" if args.any else "all"
    return args


def predicate_label(args: argparse.Namespace) -> str:
    if args.cmd == "exists":
        return f"exists {args.path}"
    if args.cmd == "glob":
        return f"glob {args.pattern}"
    if args.cmd == "grep":
        extra = []
        if args.ignore_case:
            extra.append("-i")
        if args.fixed_strings:
            extra.append("-F")
        if args.word_regexp:
            extra.append("-w")
        if args.invert_match:
            extra.append("-v")
        flags = (" " + " ".join(extra)) if extra else ""
        paths = (" -- " + " ".join(args.paths)) if args.paths else ""
        return f"grep{flags} {args.pattern}{paths}"
    if args.cmd == "lattice":
        return "lattice"
    return "exec " + " ".join(args.command)


def probe_cost(cmd: str) -> str:
    return {
        "exists": "batch",
        "glob": "per-tree",
        "grep": "per-tree",
        "exec": "per-commit",
        "lattice": "none",
    }.get(cmd, "unknown")


def exit_for(status: Status, boolean: bool) -> int:
    if boolean:
        return 0 if status == Status.TRUE else 1
    if status == Status.TRUE:
        return 0
    if status == Status.FALSE:
        return 1
    if status in NON_TF:
        return 3
    return 2


def default_human(args: argparse.Namespace) -> bool:
    if args.json or args.oneline or args.revs or args.bounds or args.true_bounds:
        return False
    if args.human:
        return True
    if args.tsv:
        return False
    return sys.stdout.isatty() and not args.quiet


def run_probes(
    args: argparse.Namespace,
    repo: str,
    targets: Sequence[Sample],
) -> tuple[list[Probe], int, Optional[str]]:
    bad_regex = None
    if args.cmd == "exists":
        probes, nprobe = probe_exists(repo, targets, args.path)
    elif args.cmd == "glob":
        probes, nprobe = probe_glob(repo, targets, args.pattern)
    elif args.cmd == "grep":
        probes, nprobe, bad_regex = probe_grep(
            repo,
            targets,
            args.pattern,
            args.paths,
            ignore_case=args.ignore_case,
            fixed=args.fixed_strings,
            word=args.word_regexp,
            invert=args.invert_match,
        )
    else:
        probes, nprobe = probe_exec(
            repo, targets, args.command, timeout=args.timeout
        )
    return probes, nprobe, bad_regex


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        if args.cmd == "lattice":
            text = format_lattice(op=args.join_op, as_json=bool(args.json))
            print(text)
            return 0

        repo, bare = resolve_repo(args.repo)
        if bare and args.now:
            raise FordError("bare repository has no work tree for --now")

        head = git(repo, "rev-parse", "--verify", f"{args.rev}^{{commit}}")
        has_head = head.returncode == 0
        samples: list[Sample] = []
        if has_head:
            samples = list_samples(
                repo,
                end_rev=args.rev,
                rev_range=args.rev_range,
                first_parent=not args.full,
                limit=args.limit,
            )
        elif args.rev_range is not None:
            raise FordError(f"no commits at {args.rev} (empty repository?)")

        if args.index:
            if bare:
                raise FordError("bare repository has no index sample")
            samples.append(index_sample())
        if args.now:
            samples.append(worktree_sample())
        if not samples:
            samples = [empty_sample()]

        extras_needed, extra_meta = collect_join_shas(samples, {}, repo)
        extra_samples = [m for m in extra_meta.values() if m is not None and m.kind == "commit"]

        # Probe walked samples plus every SHA the recursive join may read.
        targets: list[Sample] = []
        seen: set[str] = set()
        for m in extra_samples:
            if m.sha not in seen:
                targets.append(m)
                seen.add(m.sha)
        for s in samples:
            if s.kind == "commit" and s.sha in seen:
                continue
            targets.append(s)
            if s.kind == "commit":
                seen.add(s.sha)

        probes_t, nprobe, bad_regex = run_probes(args, repo, targets)
        by_sha: dict[str, Probe] = {}
        target_index = {id(s): i for i, s in enumerate(targets)}
        _ = target_index
        for s, p in zip(targets, probes_t):
            if s.kind == "commit":
                by_sha[s.sha] = p

        for psha in extras_needed:
            if psha not in by_sha:
                by_sha[psha] = Probe(
                    Status.SHALLOW, Status.SHALLOW, ["(missing parent)"]
                )

        shallow = (
            read_shallow_shas(repo) if any(s.kind == "commit" for s in samples) else set()
        )
        probed = set(by_sha)
        tree_walk: list[Probe] = []
        for s in samples:
            if s.kind == "commit":
                p = by_sha.get(s.sha)
                if p is None:
                    tree_walk.append(Probe(Status.UNKNOWN, Status.UNKNOWN, ["(probe)"]))
                else:
                    tree_walk.append(_copy_probe(p))
            else:
                # worktree/index/empty live on the target list
                found = None
                for t, p in zip(targets, probes_t):
                    if t is s or (t.kind == s.kind and t.sha == s.sha):
                        found = p
                        break
                tree_walk.append(
                    _copy_probe(found) if found is not None else Probe(Status.EMPTY, Status.EMPTY)
                )

        horizon: set[str] = set()
        if not args.boolean:
            horizon = apply_horizon_trees(
                samples, by_sha, shallow=shallow, probed=probed
            )
            # refresh walk trees after horizon rewrite
            for i, s in enumerate(samples):
                if s.kind == "commit" and s.sha in by_sha:
                    tree_walk[i] = _copy_probe(by_sha[s.sha])
                    tree_walk[i].tree = by_sha[s.sha].status

        probes = apply_join(
            samples,
            by_sha,
            tree_walk,
            op=args.join_op,
            tree_mode=bool(args.tree),
            boolean=bool(args.boolean),
            extra_meta=extra_meta,
        )
        boolean_lie = False
        if args.boolean:
            for p in probes:
                st = p.tree if p.tree is not None else p.status
                if st not in (Status.TRUE, Status.FALSE):
                    raise WeirError(
                        "--boolean would downcast "
                        f"{st.value} to FALSE; that is a labelled lie. refuse. "
                        "drop --boolean (UNKNOWN/SHALLOW/EMPTY stay themselves)"
                    )
            probes = booleanize(probes)
            boolean_lie = True

        # A TRUE/EMPTY join sitting on a shallow graft is still not birth.
        if not args.boolean and horizon:
            for i, s in enumerate(samples):
                if s.kind == "commit" and s.sha in horizon:
                    if probes[i].status in (Status.TRUE, Status.EMPTY):
                        probes[i].status = Status.SHALLOW

        if args.list_order:
            eras = compress_list(samples, probes)
            walk = "list"
        else:
            if args.full:
                eras = compress_lattice(samples, probes)
                walk = "lattice"
            else:
                eras = compress_list(samples, probes)
                walk = "first-parent"
        eras = compress_inherited(eras)
        annotate_continuations(eras)
        if not any(s.kind == "commit" for s in samples):
            if any(s.kind in ("worktree", "index") for s in samples):
                walk = "filesystem"
            else:
                walk = "unborn"
        if args.boolean:
            walk = walk + "+boolean"
        if args.tree and "boolean" not in walk:
            walk = walk + "+tree"

        commit_pairs = [(s, p) for s, p in zip(samples, probes) if s.kind == "commit"]
        true_n = sum(1 for _, p in commit_pairs if p.status == Status.TRUE)
        shallow_n = sum(1 for _, p in commit_pairs if p.status == Status.SHALLOW)
        unknown_n = sum(1 for _, p in commit_pairs if p.status == Status.UNKNOWN)
        empty_n = sum(1 for _, p in commit_pairs if p.status == Status.EMPTY)
        ford_n = sum(1 for _, p in commit_pairs if p.is_ford)
        weir_n = sum(1 for _, p in commit_pairs if p.is_weir)
        holds_now = probes[-1].status if probes else Status.EMPTY
        tree_now = probes[-1].tree if probes else None
        if tree_now is None and probes:
            tree_now = probes[-1].raw
        never_held = (
            bool(commit_pairs)
            and true_n == 0
            and shallow_n == 0
            and unknown_n == 0
            and empty_n == 0
        )
        always_held = bool(commit_pairs) and true_n == len(commit_pairs)
        spec = args.rev_range or args.rev
        reachable = count_reachable(repo, spec) if has_head else 0

        warnings: list[str] = []
        hints: list[str] = []
        extra_probes = 0
        if bad_regex:
            warnings.append("invalid regex: " + bad_regex.splitlines()[0])
        if boolean_lie:
            warnings.append(
                "--boolean is a labelled lie: tree TRUE/else-FALSE "
                "(held recovery). occupancy is the recursive join"
            )
        if not args.boolean:
            warnings, hints, extra_probes = diagnose(
                args=args,
                repo=repo,
                samples=samples,
                probes=probes,
                end_rev=args.rev,
                horizon=horizon,
            )
            if bad_regex:
                warnings = [
                    "invalid regex: " + bad_regex.splitlines()[0],
                    *warnings,
                ]
        nprobe += extra_probes

        report = Report(
            repo=repo,
            predicate=predicate_label(args),
            end_rev=spec,
            first_parent=not args.full,
            include_now=bool(args.now),
            holds_now=holds_now,
            tree_now=tree_now,
            never_held=never_held,
            always_held=always_held,
            commits_scanned=len(commit_pairs),
            reachable=reachable,
            probes=nprobe,
            true_commits=true_n,
            shallow_commits=shallow_n,
            unknown_commits=unknown_n,
            empty_commits=empty_n,
            fords=ford_n,
            weirs=weir_n,
            eras=eras,
            walk=walk,
            probe_kind=args.cmd,
            cost=probe_cost(args.cmd),
            horizon=bool(horizon),
            bare=bare,
            boolean=bool(args.boolean),
            boolean_lie=boolean_lie,
            join_op=args.join_op,
            tree_mode=bool(args.tree),
            hint=hints[0] if hints else None,
            hints=hints,
            warnings=warnings,
        )

        if not args.quiet:
            if args.json:
                print(json.dumps(report_to_json(report), indent=2, ensure_ascii=False))
            elif args.revs:
                print(
                    "\n".join(
                        s.sha
                        for s, p in zip(samples, probes)
                        if p.status == Status.TRUE and s.kind == "commit"
                    )
                )
            elif args.bounds or args.true_bounds:
                text = format_bounds(report, only_true=args.true_bounds)
                if text:
                    print(text)
            elif args.oneline:
                text = format_oneline(report)
                if text:
                    print(text)
            elif default_human(args):
                print(
                    format_human(
                        report,
                        color=color_enabled(args),
                        show_witnesses=not args.no_witnesses,
                    )
                )
            else:
                text = format_tsv(report, header=not args.no_header)
                if text:
                    print(text)
                if sys.stderr.isatty() and not args.tsv:
                    eprint(
                        f"now={report.holds_now.value}  "
                        f"true={report.true_commits}/{report.commits_scanned}  "
                        f"weirs={report.weirs}  walk={report.walk}  join={report.join_op}"
                    )

        return exit_for(holds_now, boolean=bool(args.boolean))
    except WeirError as exc:
        eprint(f"{TOOL}: {exc}")
        return exc.code
    except KeyboardInterrupt:
        eprint(f"{TOOL}: interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
