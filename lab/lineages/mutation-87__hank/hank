from typing import Any, Iterable, Iterator, Optional

VERSION = "0.2.0"

EXIT_OK = 0       # composed, occupancy reported (or empty)
EXIT_SPLIT = 1
EXIT_JAM = 2
EXIT_ERROR = 3

SUGGEST_RE = re.compile(r"```suggestion[^\n]*\n(.*?)```", re.S)
HUNK_RE = re.compile(r"^@@\s+-(\d+)(?:,(\d+))?\s+\+(\d+)(?:,(\d+))?\s+@@")
PATH_HEADER_RE = re.compile(
    r"^(?:#+\s*)?(?:file:\s*)?(\S+):(\d+)(?:-(\d+))?\s*$", re.I
)
MD_PATH_RE = re.compile(r"^(?:#+\s*|<!--\s*)(?:path|file)\s*[:\s]\s*(\S+)", re.I)

CONNECTING = frozenset(
    {"ECHO", "STACK", "SUBSUME", "SPLIT", "JAM", "COVER", "COMMUTE", "THREAD"}
)
QUIET_PAIRS = frozenset({"DISJOINT"})
REFUSE = frozenset({"JAMMED", "SPLIT"})
LOCUS_SLACK = 2


class ParseError(Exception):
    pass


class InputError(Exception):
