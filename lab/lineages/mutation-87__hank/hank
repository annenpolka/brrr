def _strip_cr(s: str) -> str:
    return s.replace("\r", "")


def _nfc(s: str) -> str:
    return unicodedata.normalize("NFC", s) if s else s


def _as_int(v: Any) -> Optional[int]:
    if v is None or v == "":
        return None
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _first(*vals: Any) -> Any:
    for v in vals:
        if v is not None and v != "":
            return v
    return None


def _as_lines(val: Any) -> Optional[list[str]]:
    if val is None:
        return None
    if isinstance(val, list):
        return [_strip_cr(str(x)).rstrip("\n") for x in val]
    if isinstance(val, str):
        return _strip_cr(val).splitlines()
    return None


def _norm(lines: Optional[list[str]], ignore_space: bool) -> Optional[list[str]]:
    if lines is None:
        return None
    if not ignore_space:
        return list(lines)
    return [re.sub(r"[ \t]+", " ", ln).strip() for ln in lines]


@dataclass
class Span:
    start: int
    end: int

    def __post_init__(self) -> None:
        if self.start > self.end:
            self.start, self.end = self.end, self.start

    def overlaps(self, other: Span) -> bool:
        return self.start <= other.end and other.start <= self.end

    def contains(self, other: Span) -> bool:
        return self.start <= other.start and self.end >= other.end

    def strictly_contains(self, other: Span) -> bool:
        return self.contains(other) and (self.start, self.end) != (other.start, self.end)

    def nlines(self) -> int:
        return self.end - self.start + 1

    def __str__(self) -> str:
        if self.start == self.end:
            return str(self.start)
        return f"{self.start}-{self.end}"


@dataclass
class Strand:
    id: str
    path: str
    span: Span
    before: Optional[list[str]]
    after: Optional[list[str]]
    kind: str = "suggestion"
    commit: Optional[str] = None
    original_commit: Optional[str] = None
    created_at: Optional[str] = None
    author: Optional[str] = None
    in_reply_to: Optional[str] = None
    recon: str = "explicit"
    source: str = "json"
    body: str = ""

    @property
    def coord_key(self) -> str:
        return self.original_commit or self.commit or ""

    def has_edit(self) -> bool:
        return self.after is not None

    def real_edit(self) -> bool:
        return self.after is not None and self.after != (self.before or [])


@dataclass
class Pair:
    a: str
    b: str
    path: str
    verdict: str
    reason: str
    a_span: str
    b_span: str
    order: Optional[str] = None


@dataclass
class Occupancy:
