class Fail(Exception):
    pass


def _strand(
    i: str,
    path: str,
    start: int,
    end: int,
    before: Optional[list[str]],
    after: Optional[list[str]],
    **kw: Any,
) -> Strand:
    return Strand(id=i, path=path, span=Span(start, end), before=before, after=after, **kw)


def run_selftest() -> int:
    n = 0
    failed = 0

    def t(name: str, fn) -> None:
        nonlocal n, failed
        try:
            fn()
            print(f"  PASS  {name}")
            n += 1
        except Exception as e:
            print(f"  FAIL  {name}: {e}", file=sys.stderr)
            failed += 1

    def commute_disjoint():
        a = _strand("a", "f.py", 1, 1, ["x"], ["x2"])
        b = _strand("b", "f.py", 3, 3, ["z"], ["z2"])
        p = pair_verdict(a, b)
        if p.verdict != "COMMUTE":
            raise Fail(p)

    def echo_same_locus():
        a = _strand("a", "f.py", 1, 1, ["x"], ["y"])
        b = _strand("b", "f.py", 1, 1, ["x"], ["y"])
        p = pair_verdict(a, b)
        if p.verdict != "ECHO":
            raise Fail(p)

    def echo_is_locus_not_image():
        a = _strand("site1", "f.py", 1, 1, ["return 0"], ["return 1"])
        b = _strand("site2", "f.py", 10, 10, ["return 0"], ["return 1"])
        p = pair_verdict(a, b)
        if p.verdict != "COMMUTE":
            raise Fail(("expected COMMUTE of two loci, got", p))

    def split_same_span():
        a = _strand("a", "f.py", 1, 1, ["x"], ["y"])
        b = _strand("b", "f.py", 1, 1, ["x"], ["z"])
        p = pair_verdict(a, b)
        if p.verdict != "SPLIT":
            raise Fail(p)

    def replacement_not_union_words():
        a = _strand("a", "f.py", 1, 1, ["hello world"], ["HELLO world"])
        b = _strand("b", "f.py", 1, 1, ["hello world"], ["hello WORLD"])
        p = pair_verdict(a, b)
        if p.verdict != "SPLIT":
            raise Fail(p)

    def jam_overlap():
        a = _strand("a", "f.py", 1, 3, ["a", "b", "c"], ["A", "B", "C"])
        b = _strand("b", "f.py", 3, 5, ["c", "d", "e"], ["C", "D", "E"])
        p = pair_verdict(a, b)
        if p.verdict != "JAM":
            raise Fail(p)

    def jam_overlap_same_join():
        # different ranges, join line agrees: still JAM (replacement, not union)
        w = _strand("wide", "f.py", 1, 2, ["a", "shared"], ["A", "SHARED"])
        t = _strand("tail", "f.py", 2, 3, ["shared", "c"], ["SHARED", "C"])
        p = pair_verdict(w, t)
        if p.verdict != "JAM":
            raise Fail(p)

    def stack_images():
        a = _strand("a", "f.py", 2, 2, ["beta"], ["beta2"], original_commit="c1")
        b = _strand("b", "f.py", 2, 2, ["beta2"], ["beta3"], original_commit="c2")
        p = pair_verdict(a, b)
        if p.verdict != "STACK" or p.order != "a>b":
            raise Fail(p)

    def stack_cycle_is_jam():
        a = _strand("a", "f.py", 1, 1, ["A"], ["B"], original_commit="c1")
        b = _strand("b", "f.py", 1, 1, ["B"], ["A"], original_commit="c2")
        p = pair_verdict(a, b)
        if p.verdict != "JAM":
            raise Fail(p)

    def stack_subset():
        a = _strand(
            "ins",
            "f.py",
            1,
            1,
            ["pass"],
            ["def f():", "    return 1", ""],
            original_commit="c1",
        )
        b = _strand("ed", "f.py", 2, 2, ["    return 1"], ["    return 2"], original_commit="c2")
        p = pair_verdict(a, b)
        if p.verdict != "STACK":
            raise Fail(p)

    def empty_before_not_split():
        a = _strand("a", "f.py", 1, 1, None, ["ALPHA"])
        b = _strand("b", "f.py", 3, 3, None, ["GAMMA"])
        p = pair_verdict(a, b)
        if p.verdict != "COMMUTE":
            raise Fail(("empty before must not SPLIT disjoint afters", p))

    def subsume_ok():
        a = _strand("a", "f.py", 1, 5, list("abcde"), list("abXde"))
        b = _strand("b", "f.py", 3, 3, ["c"], ["X"])
        p = pair_verdict(a, b)
        if p.verdict != "SUBSUME":
            raise Fail(p)

    def recon_github_range():
        obj = {
            "id": 333030758,
            "path": "command/pr.go",
            "original_line": 347,
            "line": None,
            "diff_hunk": (
                "@@ -339,7 +342,11 @@ func show(number ...string) error {\n"
                " func pullRequestForCurrentBranch() (*github.PullRequest, error) {\n"
                " \tproject := project()\n"
                " \tclient := github.NewClient(project.Host)\n"
                "-\theadWithOwner := fmt.Sprintf(\"%s:%s\", project.Owner, currentBranch())\n"
                "+\tcurrentBranch, err := context.CurrentBranch()\n"
                "+\tif err != nil {\n"
                "+\t\treturn &github.PullRequest{}, err"
            ),
            "body": (
                "It's fine to return nil in place of pointers when an error occurs:\n"
                "```suggestion\n"
                "\t\treturn nil, err\n"
                "```"
            ),
        }
        ss = obj_to_strands(obj, "t", remarks=False)
        if len(ss) != 1:
            raise Fail(ss)
        if ss[0].after != ["\t\treturn nil, err"]:
            raise Fail(ss[0].after)
        if ss[0].before != ["\t\treturn &github.PullRequest{}, err"]:
            raise Fail(("before", ss[0].before))

    def occupy_commute_union():
        a = _strand("alice", "app.py", 1, 1, ["alpha"], ["ALPHA"])
        b = _strand("bob", "app.py", 3, 3, ["gamma"], ["GAMMA"])
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        if v != "PARALLEL":
            raise Fail(v)
        c = compose_group([a, b], pairs, v, note)
        pending = occupy_union(["alpha", "beta", "gamma"], c)
        if pending.fate != "PENDING":
            raise Fail(("pending", pending))
        applied = occupy_union(["ALPHA", "beta", "GAMMA"], c)
        if applied.fate != "APPLIED":
            raise Fail(("applied", applied))
        # A already applied: SUPERSEDED of the composed image, not APPLIED+PENDING
        partial = occupy_union(["ALPHA", "beta", "gamma"], c)
        if partial.fate != "SUPERSEDED":
            raise Fail(("partial must be SUPERSEDED of the union", partial))

    def occupy_stack_fold():
        a = _strand("r1", "app.py", 2, 2, ["beta"], ["beta2"], original_commit="c1")
        b = _strand("r2", "app.py", 2, 2, ["beta2"], ["beta3"], original_commit="c2")
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        if v != "SERIES":
            raise Fail(v)
        c = compose_group([a, b], pairs, v, note)
        if c.before != ["beta"] or c.after != ["beta3"]:
            raise Fail(("fold", c.before, c.after))
        if occupy_union(["alpha", "beta", "gamma"], c).fate != "PENDING":
            raise Fail("pending origin")
        if occupy_union(["alpha", "beta3", "gamma"], c).fate != "APPLIED":
            raise Fail("applied fold")
        mid = occupy_union(["alpha", "beta2", "gamma"], c)
        if mid.fate != "SUPERSEDED":
            raise Fail(("mid must be SUPERSEDED of the fold, not APPLIED of r1", mid))
        both = occupy_union(["alpha", "beta", "beta2", "gamma"], c)
        if both.fate == "APPLIED":
            raise Fail("both-images must not occupy the series after-image")

    def occupy_echo_once():
        a = _strand("alice", "f.py", 1, 1, ["x"], ["y"])
        b = _strand("cara", "f.py", 1, 1, ["x"], ["y"])
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        c = compose_group([a, b], pairs, v, note)
        if len(c.parts) != 1:
            raise Fail(("echo must collapse to one part", c.parts))
        if occupy_union(["x"], c).fate != "PENDING":
            raise Fail("echo pending")
        if occupy_union(["y"], c).fate != "APPLIED":
            raise Fail("echo applied")

    def occupy_dup_sites_union():
        a = _strand("site1", "app.py", 1, 1, ["return 0"], ["return 1"])
        b = _strand("site2", "app.py", 10, 10, ["return 0"], ["return 1"])
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        if v != "PARALLEL":
            raise Fail(v)
        c = compose_group([a, b], pairs, v, note)
        if len(c.parts) != 2:
            raise Fail(("two loci, two parts", c.parts))
        tree = ["return 0"] + ["keep"] * 8 + ["return 0"]
        if occupy_union(tree, c).fate != "PENDING":
            raise Fail("dup pending")
        one = ["return 1"] + ["keep"] * 8 + ["return 0"]
        if occupy_union(one, c).fate != "SUPERSEDED":
            raise Fail("one site applied is SUPERSEDED of the two-site image")
        both = ["return 1"] + ["keep"] * 8 + ["return 1"]
        if occupy_union(both, c).fate != "APPLIED":
            raise Fail("both sites")

    def occupy_subset_fold():
        a = _strand(
            "ins",
            "app.py",
            1,
            1,
            ["pass"],
            ["def f():", "    return 1", ""],
            original_commit="c1",
        )
        b = _strand("ed", "app.py", 2, 2, ["    return 1"], ["    return 2"], original_commit="c2")
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        if v != "SERIES":
            raise Fail(v)
        c = compose_group([a, b], pairs, v, note)
        if c.after != ["def f():", "    return 2", ""]:
            raise Fail(("subset fold", c.after))
        if occupy_union(["pass"], c).fate != "PENDING":
            raise Fail("subset pending")
        inserted = ["def f():", "    return 1", ""]
        mid = occupy_union(inserted, c)
        if mid.fate != "SUPERSEDED":
            raise Fail(("insert-only is SUPERSEDED of the series", mid))

    def md_noquote_commute():
        text = "app.py:1-1\n```suggestion\nALPHA\n```\n\napp.py:3-3\n```suggestion\nGAMMA\n```\n"
        ss = ingest(text, "m", remarks=False)
        if len(ss) != 2:
            raise Fail(ss)
        if ss[0].before is not None or ss[1].before is not None:
            raise Fail(("missing quote is recon=none, not []", ss[0].before, ss[0].recon))
        p = pair_verdict(ss[0], ss[1])
        if p.verdict != "COMMUTE":
            raise Fail(p)

    def jsonl_junk_is_error():
        text = '{"id":"a","path":"app.py","line":1,"before":["alpha"],"after":["ALPHA"]}\nthis is not json\n'
        try:
            ingest(text, "j", remarks=False)
        except ParseError:
            return
        raise Fail("junk jsonl must not go EMPTY")

    def empty_is_empty():
        ss = ingest("", "e", remarks=False)
        if ss:
            raise Fail(ss)
        ss = ingest("[]", "e", remarks=False)
        if ss:
            raise Fail(ss)

    def refuse_jam_no_occupy():
        a = _strand("wide", "app.py", 1, 3, ["a", "b", "c"], ["A", "B", "C"])
        b = _strand("tail", "app.py", 3, 4, ["c", "d"], ["C", "D"])
        pairs = [pair_verdict(a, b)]
        comps = build_components([a, b], pairs)
        if worst_exit(comps) != EXIT_JAM:
            raise Fail(comps)
        if compose_label(comps) != "JAMMED":
            raise Fail(compose_label(comps))

    def covering_fills_gap_from_tree():
        a = _strand("alice", "app.py", 1, 1, ["alpha"], ["ALPHA"])
        b = _strand("bob", "app.py", 3, 3, ["gamma"], ["GAMMA"])
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        tree = ["alpha", "beta", "gamma"]
        c = compose_group([a, b], pairs, v, note, tree_lines=tree)
        if not c.covering:
            raise Fail("expected covering")
        if c.before != tree:
            raise Fail(("before", c.before))
        if c.after != ["ALPHA", "beta", "GAMMA"]:
            raise Fail(("after", c.after))
        if occupy_union(tree, c).fate != "PENDING":
            raise Fail("covering pending")
        if occupy_union(["ALPHA", "beta", "GAMMA"], c).fate != "APPLIED":
            raise Fail("covering applied")
        if occupy_union(["ALPHA", "beta", "gamma"], c).fate != "SUPERSEDED":
            raise Fail("a-only still SUPERSEDED of the file region")

    def md_noquote_occupy_pending():
        text = "app.py:1-1\n```suggestion\nALPHA\n```\n\napp.py:3-3\n```suggestion\nGAMMA\n```\n"
        ss = ingest(text, "m", remarks=False)
        pairs = all_pairs(ss, False)
        v, _, note = component_verdict(ss, pairs)
        tree = ["alpha", "beta", "gamma"]
        c = compose_group(ss, pairs, v, note, tree_lines=tree)
        if c.after != ["ALPHA", "beta", "GAMMA"]:
            raise Fail(("md covering after", c.after, c.covering))
        occ = occupy_union(tree, c)
        if occ.fate != "PENDING":
            raise Fail(("md-noquote against origin must be PENDING of the after-image", occ))

    def nfc_path():
        obj = {"id": "a", "path": "cafe\u0301.py", "line": 1, "before": ["x"], "after": ["y"]}
        ss = obj_to_strands(obj, "t", False)
        if ss[0].path != unicodedata.normalize("NFC", "cafe\u0301.py"):
            raise Fail(ss[0].path)

    def emit_commute_one_covering_not_two_fences():
        a = _strand("alice", "app.py", 1, 1, ["alpha"], ["ALPHA"])
        b = _strand("bob", "app.py", 3, 3, ["gamma"], ["GAMMA"])
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        c = compose_group([a, b], pairs, v, note, tree_lines=["alpha", "beta", "gamma"])
        patch, errs = emit_composed([c], mixed=True)
        if errs:
            raise Fail(errs)
        if n_hunks(patch) != 1:
            raise Fail(("fold is one hunk, not N fences", n_hunks(patch), patch))
        if "-alpha" not in patch or "+ALPHA" not in patch:
            raise Fail(patch)
        if "-gamma" not in patch or "+GAMMA" not in patch:
            raise Fail(patch)
        if "\n beta\n" not in patch:
            raise Fail(("mixed covering keeps the unclaimed gap as context", patch))
        if "diff --git a/app.py b/app.py" not in patch:
            raise Fail(patch)

    def emit_stack_is_fold_not_rounds():
        a = _strand("r1", "app.py", 2, 2, ["beta"], ["beta2"], original_commit="c1")
        b = _strand("r2", "app.py", 2, 2, ["beta2"], ["beta3"], original_commit="c2")
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        c = compose_group([a, b], pairs, v, note)
        tree = ["alpha", "beta", "gamma"]
        patch, errs = emit_composed([c], mixed=True, trees={"app.py": tree})
        if errs:
            raise Fail(errs)
        if "beta2" in patch:
            raise Fail(("fold must not mention the intermediate round", patch))
        if "-beta" not in patch or "+beta3" not in patch:
            raise Fail(patch)
        if "\n alpha\n" not in patch or "\n gamma\n" not in patch:
            raise Fail(("zero-context fold pads neighbors so git apply has context", patch))
        if n_hunks(patch) != 1:
            raise Fail(patch)

    def emit_refuses_non_covering():
        a = _strand("alice", "app.py", 1, 1, ["alpha"], ["ALPHA"])
        b = _strand("bob", "app.py", 3, 3, ["gamma"], ["GAMMA"])
        pairs = [pair_verdict(a, b)]
        v, _, note = component_verdict([a, b], pairs)
        c = compose_group([a, b], pairs, v, note, tree_lines=None)
        if c.covering:
            raise Fail("gap without a tree is not a covering")
        patch, errs = emit_composed([c], mixed=True)
        if patch:
            raise Fail(("must not emit concatenation as if it were the fold", patch))
        if not errs:
            raise Fail("need an error for the missing covering")

    t("commute-disjoint", commute_disjoint)
    t("echo-same-locus", echo_same_locus)
    t("echo-is-locus-not-image", echo_is_locus_not_image)
    t("split-same-span", split_same_span)
    t("replacement-not-union", replacement_not_union_words)
    t("jam-overlap", jam_overlap)
    t("jam-overlap-same-join", jam_overlap_same_join)
    t("stack-images", stack_images)
    t("stack-cycle-is-jam", stack_cycle_is_jam)
    t("stack-subset", stack_subset)
    t("empty-before-not-split", empty_before_not_split)
    t("subsume", subsume_ok)
    t("recon-github-range", recon_github_range)
    t("occupy-commute-union", occupy_commute_union)
    t("occupy-stack-fold", occupy_stack_fold)
    t("occupy-echo-once", occupy_echo_once)
    t("occupy-dup-sites-union", occupy_dup_sites_union)
    t("occupy-subset-fold", occupy_subset_fold)
    t("md-noquote-commute", md_noquote_commute)
    t("jsonl-junk-is-error", jsonl_junk_is_error)
    t("empty-is-empty", empty_is_empty)
    t("refuse-jam-no-occupy", refuse_jam_no_occupy)
    t("covering-fills-gap-from-tree", covering_fills_gap_from_tree)
    t("md-noquote-occupy-pending", md_noquote_occupy_pending)
    t("nfc-path", nfc_path)
    t("emit-commute-one-covering", emit_commute_one_covering_not_two_fences)
    t("emit-stack-fold-not-rounds", emit_stack_is_fold_not_rounds)
    t("emit-refuses-non-covering", emit_refuses_non_covering)
    print(f"selftest {n}/{n + failed} passed")
    return 0 if failed == 0 else EXIT_ERROR


