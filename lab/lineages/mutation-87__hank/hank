def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="hank",
        description=(
            "Compose review-suggestion strands, occupy the single composed "
            "after-image, and --emit that covering as one unified diff. "
            "JAM/SPLIT refuse occupancy and emit."
        ),
        epilog=(
            "hank --emit -C TREE stream.jsonl | git apply   "
            "applies the fold, not N GitHub suggestion fences."
        ),
    )
    p.add_argument("inputs", nargs="*", help="JSON / JSONL / markdown review streams; - for stdin")
    p.add_argument("-C", "--root", dest="root", default=None, help="tree to occupy / paint covering against")
    p.add_argument("--against", default=None, help="git ref (default: worktree files)")
    p.add_argument("--worktree", action="store_true", help="force reading worktree files")
    p.add_argument("--remarks", action="store_true", help="include non-suggestion comments")
    p.add_argument("--ignore-space", action="store_true")
    p.add_argument(
        "--emit",
        action="store_true",
        help="print the composed covering as a unified diff (stdout); occupancy stays on stderr",
    )
    p.add_argument(
        "--wholesale",
        action="store_true",
        help="with --emit, minus-then-plus the covering (v0.1; needs git apply --unidiff-zero)",
    )
    p.add_argument("--json", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--report-only", action="store_true", help="always exit 0 on success")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    return p.parse_args(argv)


def main(argv: Optional[list[str]] = None) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    if args.version:
        print(f"hank {VERSION}")
        return 0
    if args.selftest:
        try:
            return run_selftest()
        except Exception:
            import traceback

            traceback.print_exc()
            return EXIT_ERROR
    inputs = list(args.inputs)
    if not inputs:
        if sys.stdin.isatty():
            print("hank: pass a review stream or '-' for stdin", file=sys.stderr)
            return EXIT_ERROR
        inputs = ["-"]
    try:
        strands: list[Strand] = []
        for src in inputs:
            label = "stdin" if src == "-" else src
            text = read_source(src)
            strands.extend(ingest(text, label, remarks=args.remarks))
        seen: dict[str, int] = {}
        for s in strands:
            n = seen.get(s.id, 0) + 1
            seen[s.id] = n
            if n > 1:
                s.id = f"{s.id}~{n}"
        pairs = all_pairs(strands, args.ignore_space)
        comps = build_components(strands, pairs)
        label = compose_label(comps)
        occupied = label not in REFUSE and label != "EMPTY"
        worktree = args.worktree or (args.against is None)
        root = args.root
        composed: list[Composed] = []
        if occupied:
            composed = compose_all(strands, pairs, comps, root, args.against, worktree)
        payload = to_json(strands, pairs, comps, composed, occupied)
        if args.emit:
            if not occupied:
                if label in REFUSE:
                    print(f"hank: {label}; not emitting", file=sys.stderr)
                    return 0 if args.report_only else worst_exit(comps)
                print("hank: nothing to emit", file=sys.stderr)
                return 0
            trees: dict[str, list[str]] = {}
            if root:
                for c in composed:
                    hay = load_tree_file(root, c.path, args.against, worktree)
                    if hay is not None:
                        trees[c.path] = hay
            patch, errs = emit_composed(
                composed, mixed=not args.wholesale, trees=trees
            )
            for e in errs:
                print(f"hank: {e}", file=sys.stderr)
            if not patch:
                if errs:
                    return EXIT_ERROR
                print("hank: covering is a noop", file=sys.stderr)
                return 0
            sys.stdout.write(patch)
            occ = occupy_label(composed) or "—"
            print(
                f"hank  compose={label}  occupy={occ}  emit={n_hunks(patch)}  "
                f"files={len({c.path for c in composed})}",
                file=sys.stderr,
            )
            if args.report_only:
                return 0
            return worst_exit(comps)
        if args.json:
            json.dump(payload, sys.stdout, indent=2)
            sys.stdout.write("\n")
        elif args.tsv:
            sys.stdout.write(format_tsv(comps, composed, occupied))
        else:
            sys.stdout.write(format_pretty(strands, pairs, comps, composed, occupied))
        if args.report_only:
            return 0
        return worst_exit(comps)
    except (ParseError, InputError) as e:
        print(f"hank: {e}", file=sys.stderr)
        return EXIT_ERROR
    except BrokenPipeError:
        return 0
    except Exception as e:
        print(f"hank: {e}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
