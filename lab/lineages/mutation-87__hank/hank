def format_pretty(
    strands: list[Strand],
    pairs: list[Pair],
    comps: list[Component],
    composed: list[Composed],
    occupied: bool,
) -> str:
    n = len(strands)
    files = len({s.path for s in strands})
    label = compose_label(comps)
    head = f"hank  n={n}  files={files}  compose={label}"
    if occupied:
        occ = occupy_label(composed)
        if occ:
            head += f"  occupy={occ}"
    else:
        head += "  occupy=—"
    lines = [head, ""]

    shown = [p for p in pairs if p.verdict not in QUIET_PAIRS]
    hidden = len(pairs) - len(shown)
    if shown and len(shown) <= 24:
        lines.append("pairs")
        for p in shown:
            extra = f"  {p.reason}"
            if p.order:
                extra += f"  {p.order}"
            lines.append(
                f"  {p.verdict:<8} {p.path}  #{p.a}@{p.a_span}  #{p.b}@{p.b_span}{extra}"
            )
        if hidden:
            lines.append(f"  ({hidden} DISJOINT hidden)")
        lines.append("")
    elif shown:
        cc: dict[str, int] = defaultdict(int)
        for p in shown:
            cc[p.verdict] += 1
        bits = " ".join(f"{k}={v}" for k, v in sorted(cc.items()))
        lines.append(f"pairs  n={len(shown)}  {bits}")
        if hidden:
            lines.append(f"  ({hidden} DISJOINT hidden)")
        lines.append("")

    if comps:
        lines.append("plaits")
        for c in comps:
            ids = ",".join(f"#{i}" for i in c.strand_ids)
            lines.append(f"  {c.verdict:<8} {c.path}  {ids}  {c.note}")
        lines.append("")

    if occupied and composed:
        lines.append("composed")
        for c in composed:
            ids = ",".join(f"#{i}" for i in c.strand_ids)
            span = f"@{c.start}" if c.start == c.end else f"@{c.start}-{c.end}"
            cov = "covering" if c.covering else "union"
            lines.append(f"  {c.verdict:<8} {c.path}  {ids}  {span}  {cov}")
            b = " | ".join(c.before) if c.before else "∅"
            a = " | ".join(c.after) if c.after else "∅"
            if len(b) > 80:
                b = b[:77] + "..."
            if len(a) > 80:
                a = a[:77] + "..."
            lines.append(f"           {b}  →  {a}")
        lines.append("")
        lines.append("occupy")
        for c in composed:
            occ = c.occupancy
            if not occ:
                continue
            extra = f"  {occ.note}" if occ.note else ""
            lines.append(
                f"  {occ.fate:<10} {c.path}  {occ.method}  "
                f"before_hits={occ.before_hits} after_hits={occ.after_hits}{extra}"
            )
    elif not occupied and comps:
        lines.append("(refused occupy: composition is JAM or SPLIT)")

    if not pairs and not comps:
        lines.append("(no strands)")
    return "\n".join(lines).rstrip() + "\n"


def to_json(
    strands: list[Strand],
    pairs: list[Pair],
    comps: list[Component],
    composed: list[Composed],
    occupied: bool,
) -> dict[str, Any]:
    cc: dict[str, int] = defaultdict(int)
    for c in comps:
        cc[c.verdict] += 1
    pc: dict[str, int] = defaultdict(int)
    for p in pairs:
        pc[p.verdict] += 1
    occ = occupy_label(composed) if occupied else None
    return {
        "n": len(strands),
        "files": len({s.path for s in strands}),
        "compose": compose_label(comps),
        "occupy": occ,
        "occupied": occupied,
        "method": (
            composed[0].occupancy.method
            if occupied and len(composed) == 1 and composed[0].occupancy
            else None
        ),
        "strands": [
            {
                "id": s.id,
                "path": s.path,
                "span": str(s.span),
                "start": s.span.start,
                "end": s.span.end,
                "kind": s.kind,
                "before": s.before,
                "after": s.after,
                "commit": s.commit,
                "original_commit": s.original_commit,
                "recon": s.recon,
            }
            for s in strands
        ],
        "pairs": [asdict(p) for p in pairs if p.verdict not in QUIET_PAIRS],
        "components": [
            {
                "id": c.id,
                "path": c.path,
                "strands": c.strand_ids,
                "verdict": c.verdict,
                "pair_counts": c.pair_counts,
                "note": c.note,
            }
            for c in comps
        ],
        "composed": [
            {
                "path": c.path,
                "strands": c.strand_ids,
                "verdict": c.verdict,
                "before": c.before,
                "after": c.after,
                "covering": c.covering,
                "start": c.start,
                "end": c.end,
                "parts": c.parts,
                "fate": c.occupancy.fate if c.occupancy else None,
                "method": c.occupancy.method if c.occupancy else None,
                "note": c.occupancy.note if c.occupancy else "",
            }
            for c in composed
        ],
        "component_counts": dict(cc),
        "pair_counts": dict(pc),
        "version": VERSION,
    }


def format_tsv(comps: list[Component], composed: list[Composed], occupied: bool) -> str:
    rows = ["kind\tverdict\tpath\tids\tmethod"]
    for c in comps:
        rows.append(f"plait\t{c.verdict}\t{c.path}\t{','.join(c.strand_ids)}\t")
    if occupied:
        for c in composed:
            fate = c.occupancy.fate if c.occupancy else ""
            method = c.occupancy.method if c.occupancy else ""
            rows.append(f"occupy\t{fate}\t{c.path}\t{','.join(c.strand_ids)}\t{method}")
    return "\n".join(rows) + "\n"


