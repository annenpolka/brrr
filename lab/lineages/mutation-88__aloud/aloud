def role_of(path: str) -> str:
    p = path.replace("\\", "/").lower()
    base = p.rsplit("/", 1)[-1]
    if (
        "/test" in p
        or "/spec" in p
        or base.endswith("_test.py")
        or base.endswith("_test.rs")
        or ".test." in base
        or base.endswith("tests.swift")
        or base.endswith("tests.py")
        or base.endswith("tests.rs")
        or base.endswith("tests.ts")
    ):
        return "test"
    if p.endswith(".md"):
        return "docs"
    return "prod"


def relpath(path: str, root: str | None) -> str:
    if root:
        try:
            return str(Path(path).resolve().relative_to(Path(root).resolve()))
        except Exception:
            pass
    return path


def is_literal(src: str) -> bool:
    s = src.strip()
    if not s:
        return False
    if s in {
        "None",
        "nil",
        "true",
        "false",
        "True",
        "False",
        "null",
        "undefined",
        "()",
        "[]",
        "{}",
        "[:] ",
        "[:]",
    }:
        return True
    if re.fullmatch(r"[-+]?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?", s):
        return True
    if re.fullmatch(r"\.[A-Za-z_][A-Za-z0-9_]*", s):
        return True
    if re.fullmatch(r'["\']([^"\'\\]|\\.)*["\']', s):
        return True
    # empty constructed default: Foo() / Foo{}
    if re.fullmatch(rf"{IDENT}\s*\(\s*\)", s):
        return True
    if re.fullmatch(r"b['\"]([^\"'\\\\]|\\\\.)*['\"]", s):
        return True
    return False


def _unquote(s: str) -> str:
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in {'"', "'"}:
        return s[1:-1]
    return s


def values_equal(a: str, b: str) -> bool:
    a = a.strip()
    b = b.strip()
    if a == b:
        return True
    if re.sub(r"\s+", "", a) == re.sub(r"\s+", "", b):
        return True
    try:
        if float(a) == float(b):
            return True
    except ValueError:
        pass
    ua, ub = _unquote(a), _unquote(b)
    if ua != a or ub != b:
        if ua == ub:
            return True
        try:
            if float(ua) == float(ub):
                return True
        except ValueError:
            pass
    return False


def ctor_name(default: str) -> str | None:
    """If default looks like Foo() or Foo(...), return Foo."""
    m = re.fullmatch(rf"({IDENT})\s*\(.*\)", default.strip(), re.S)
    if m:
        return m.group(1)
    return None


# ---------------------------------------------------------------------------
# mask comments/strings so searches don't fire in them
# ---------------------------------------------------------------------------

def mask(src: str, lang: str) -> str:
    n = len(src)
    out = [" "] * n
    i = 0
    py = lang == "py"
    while i < n:
        ch = src[i]
        nxt = src[i + 1] if i + 1 < n else ""
        if ch == "\n":
            out[i] = "\n"
            i += 1
            continue
        # line comments
        if ch == "#" and py:
            while i < n and src[i] != "\n":
                i += 1
            continue
        if ch == "/" and nxt == "/" and not py:
            i += 2
            while i < n and src[i] != "\n":
                i += 1
            continue
        if ch == "/" and nxt == "*" and not py:
            i += 2
            while i + 1 < n and not (src[i] == "*" and src[i + 1] == "/"):
                if src[i] == "\n":
                    out[i] = "\n"
                i += 1
            i = min(n, i + 2)
            continue
        # python triple quotes
        if py and src[i : i + 3] in ('"""', "'''"):
            q = src[i : i + 3]
            i += 3
            while i + 2 < n and src[i : i + 3] != q:
                if src[i] == "\n":
                    out[i] = "\n"
                i += 1
            i = min(n, i + 3)
            continue
        # rust raw strings r#"..."#
        if lang == "rs" and ch == "r" and nxt in ('#', '"'):
            j = i + 1
            hashes = 0
            while j < n and src[j] == "#":
                hashes += 1
                j += 1
            if j < n and src[j] == '"':
                i = j + 1
                close = '"' + ("#" * hashes)
                while i < n and src[i : i + len(close)] != close:
                    if src[i] == "\n":
                        out[i] = "\n"
                    i += 1
                i = min(n, i + len(close))
                continue
        if ch in ('"', "'", "`"):
            q = ch
            i += 1
            while i < n:
                if src[i] == "\n":
                    out[i] = "\n"
                    # unclosed single-line (python/swift) — stop at newline
                    if q != "`" and lang in {"py", "swift"}:
                        i += 1
                        break
                    i += 1
                    continue
                if src[i] == "\\" and lang != "swift":
                    i += 2
                    continue
                if lang == "swift" and src[i] == "\\" and i + 1 < n and src[i + 1] != "(":
                    i += 2
                    continue
                if src[i] == q:
                    i += 1
                    break
                i += 1
            continue
        out[i] = ch
        i += 1
    return "".join(out)


def line_at(src: str, idx: int) -> int:
    return src.count("\n", 0, idx) + 1


def match_paren(src: str, open_idx: int) -> int | None:
    """Return index of closing paren, or None. Respects strings."""
    n = len(src)
    if open_idx >= n or src[open_idx] not in "([{":
        return None
    pairs = {"(": ")", "[": "]", "{": "}"}
    stack = [src[open_idx]]
    i = open_idx + 1
    while i < n:
        ch = src[i]
        if ch in "\"'`":
            q = ch
            i += 1
            while i < n and src[i] != q:
                if src[i] == "\\" and q != "`":
                    i += 2
                    continue
                if src[i] == "\n" and q != "`":
                    break
                i += 1
            i += 1
            continue
        if ch == "/" and i + 1 < n and src[i + 1] == "/":
            while i < n and src[i] != "\n":
                i += 1
            continue
        if ch == "#" and stack[-1] != '"':
            # only treat as comment if we are in python; harmless elsewhere
            # inside ( ) of swift it would be wrong for #available
            pass
        if ch in pairs:
            stack.append(ch)
        elif ch in pairs.values():
            if not stack or pairs.get(stack[-1]) != ch:
                return None
            stack.pop()
            if not stack:
                return i
        i += 1
    return None


def split_top(inner: str) -> list[str]:
    parts: list[str] = []
    buf: list[str] = []
    depth = 0
    i = 0
    n = len(inner)
    while i < n:
        ch = inner[i]
        if ch in "\"'`":
            q = ch
            buf.append(ch)
            i += 1
            while i < n:
                buf.append(inner[i])
                if inner[i] == "\\" and q != "`":
                    i += 1
                    if i < n:
                        buf.append(inner[i])
                    i += 1
                    continue
                if inner[i] == q:
                    i += 1
                    break
                i += 1
            continue
        if ch in "([{":
            depth += 1
            buf.append(ch)
        elif ch in ")]}":
            depth -= 1
            buf.append(ch)
        elif ch == "," and depth == 0:
            parts.append("".join(buf))
            buf = []
        elif ch == "/" and i + 1 < n and inner[i + 1] == "/" and depth == 0:
            while i < n and inner[i] != "\n":
                i += 1
            continue
        else:
            buf.append(ch)
        i += 1
    if buf:
        parts.append("".join(buf))
    return [p.strip() for p in parts if p.strip() and p.strip() != ","]


def strip_line_comment(chunk: str) -> str:
    out = []
    i = 0
    n = len(chunk)
    depth = 0
    while i < n:
        ch = chunk[i]
        if ch in "\"'`":
            q = ch
            out.append(ch)
            i += 1
            while i < n and chunk[i] != q:
                out.append(chunk[i])
                if chunk[i] == "\\":
                    i += 1
                    if i < n:
                        out.append(chunk[i])
                i += 1
            if i < n:
                out.append(chunk[i])
                i += 1
            continue
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        if ch == "/" and i + 1 < n and chunk[i + 1] == "/" and depth == 0:
            break
        if ch == "#" and depth == 0:
            break
        out.append(ch)
        i += 1
    return "".join(out).strip().rstrip(",").strip()


