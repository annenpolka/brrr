def _needle_is_path(n: str) -> bool:
    if "/" in n or n.startswith("."):
        return True
    lower = n.lower()
    return any(lower.endswith(ext) for ext in CODE_EXTS)


def filter_rows(rows: list[Row], needles: list[str], kinds: set[str], why: set[str]) -> list[Row]:
    out = []
    for r in rows:
        if kinds and r.verdict not in kinds:
            continue
        if why and r.why not in why:
            continue
        ok = True
        for n in needles:
            nl = n.lower()
            if _needle_is_path(n):
                if nl not in r.path.lower():
                    ok = False
                    break
            else:
                if nl not in r.callee.lower() and nl not in r.param.lower():
                    ok = False
                    break
        if not ok:
            continue
        out.append(r)
    return out


FATE_ORDER = (
    "ALOUD",
    "MUTE",
    "FOSSIL",
    "PRE",
    "LATE",
    "FRESH",
    "LOCK",
    "BOUND",
    "GONE",
)
DEFAULT_FATES = {"ALOUD", "MUTE", "FOSSIL", "PRE", "LATE"}


def emit_tsv(rows: list[Row], header: bool) -> None:
    cols = [
        "fate",
        "blast",
        "later",
        "role",
        "callee",
        "param",
        "default",
        "passed",
        "file",
        "line",
    ]
    if header:
        print("\t".join(cols))
    for r in rows:
        print(
            "\t".join(
                [
                    r.why or "",
                    r.blast or "—",
                    r.verdict,
                    r.role,
                    r.callee,
                    r.param,
                    r.default.replace("\t", " ").replace("\n", " "),
                    r.passed.replace("\t", " ").replace("\n", " "),
                    r.path,
                    str(r.line),
                ]
            )
        )


def emit_json(rows: list[Row]) -> None:
    payload = []
    for r in rows:
        payload.append(
            {
                "fate": r.why,
                "blast": r.blast or None,
                "later": r.verdict,
                "role": r.role,
                "callee": r.callee,
                "param": r.param,
                "default": r.default,
                "passed": None if r.passed == "—" else r.passed,
                "file": r.path,
                "line": r.line,
                "blast_line": r.blast_line or None,
                "blast_passed": None if r.blast_passed in {"", "—"} else r.blast_passed,
            }
        )
    json.dump(payload, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")


def emit_summary(rows: list[Row]) -> None:
    from collections import Counter

    c = Counter(r.why for r in rows)
    print("fate\tcount")
    for k in FATE_ORDER:
        if c[k]:
            print(f"{k}\t{c[k]}")
    slot: dict[tuple[str, str], Counter] = {}
    for r in rows:
        slot.setdefault((r.callee, r.param), Counter())[r.why] += 1
    if slot:
        print("callee\tparam\tALOUD\tMUTE\tFOSSIL\tPRE\tLATE")
        for (callee, param), cc in sorted(slot.items()):
            print(
                f"{callee}\t{param}\t{cc['ALOUD']}\t{cc['MUTE']}\t"
                f"{cc['FOSSIL']}\t{cc['PRE']}\t{cc['LATE']}"
            )


