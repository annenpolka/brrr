def _fates(rows: list[Row], param: str | None = None) -> dict[str, list[Row]]:
    out: dict[str, list[Row]] = {}
    for r in rows:
        if param and r.param != param:
            continue
        out.setdefault(r.why, []).append(r)
    return out


def _selftest() -> int:
    fails: list[str] = []

    def check(name: str, cond: bool, detail: str = "") -> None:
        if cond:
            print(f"  ok  {name}")
        else:
            fails.append(name)
            print(f"  FAIL {name} {detail}", file=sys.stderr)

    old_h = harvest_texts([("a.swift", OLD_SWIFT, "swift")])
    blast_h = harvest_texts([("a.swift", BLAST_SWIFT, "swift")])
    later_h = harvest_texts([("a.swift", LATER_SWIFT, "swift")])
    moved = moved_slots(old_h, blast_h)
    check(
        "rename+move is one presentThreshold slot",
        any(m.param == "presentThreshold" and m.old_name == "threshold" for m in moved),
        str([(m.old_name, m.param, m.old_val, m.new_val) for m in moved]),
    )
    rows = aloud_rows(blast_h, later_h, moved, unfold=False)
    f = _fates(rows, "presentThreshold")
    check(
        "ALOUD is omitted-then-spoken of the NEW default",
        len(f.get("ALOUD", [])) == 1
        and f["ALOUD"][0].blast == "TACIT"
        and f["ALOUD"][0].verdict == "SHADOW"
        and values_equal(f["ALOUD"][0].passed, "0.45"),
        str([(r.blast, r.verdict, r.passed, r.others) for r in f.get("ALOUD", [])]),
    )
    check(
        "MUTE stayed tacit — not ALOUD",
        len(f.get("MUTE", [])) == 1
        and f["MUTE"][0].blast == "TACIT"
        and f["MUTE"][0].verdict == "TACIT",
        str([(r.blast, r.verdict, r.passed) for r in f.get("MUTE", [])]),
    )
    check(
        "FOSSIL is SHADOW-of-old, not of new",
        len(f.get("FOSSIL", [])) == 1
        and values_equal(f["FOSSIL"][0].passed, "0.4"),
        str([(r.why, r.passed, r.blast) for r in f.get("FOSSIL", [])]),
    )
    check(
        "PRE already spoke new at the BLAST — not a survivor",
        len(f.get("PRE", [])) == 1
        and f["PRE"][0].blast == "SHADOW"
        and values_equal(f["PRE"][0].passed, "0.45"),
        str([(r.why, r.blast, r.passed) for r in f.get("PRE", [])]),
    )
    # LATE is filtered from default view; compute with all fates
    check(
        "ALOUD ≠ PRE ≠ MUTE ≠ FOSSIL ≠ LATE (five distinct sites)",
        {r.why for r in rows if r.param == "presentThreshold" and r.why in DEFAULT_FATES}
        == {"ALOUD", "MUTE", "FOSSIL", "PRE", "LATE"},
        str(sorted({r.why for r in rows})),
    )
    later_all = aloud_rows(blast_h, later_h, moved, unfold=False)
    late = [r for r in later_all if r.why == "LATE" and r.param == "presentThreshold"]
    check(
        "LATE born-after speaking new is not ALOUD",
        len(late) == 1
        and late[0].blast == "—"
        and late[0].verdict == "SHADOW"
        and values_equal(late[0].passed, "0.45"),
        str([(r.why, r.blast, r.verdict, r.passed, r.others) for r in late]),
    )
    # until==blast: nobody has spoken yet
    at_blast = aloud_rows(blast_h, blast_h, moved, unfold=False)
    af = _fates(at_blast, "presentThreshold")
    check(
        "at BLAST there is no ALOUD yet",
        not af.get("ALOUD")
        and len(af.get("MUTE", [])) == 2
        and len(af.get("FOSSIL", [])) == 1
        and len(af.get("PRE", [])) == 1,
        str({k: len(v) for k, v in af.items()}),
    )

    # speaking the slot must not break the join key (siblings exclude the slot)
    spoken = f["ALOUD"][0]
    mute = f["MUTE"][0]
    check(
        "join key ignores the spoken slot",
        ("sensors", '["mic"]') in spoken.others
        and not any(k == "presentThreshold" for k, _ in spoken.others)
        and ("sensors", '["camera"]') in mute.others,
        str(spoken.others),
    )

    # python
    py_old = harvest_texts([("a.py", PY_OLD, "py")])
    py_blast = harvest_texts([("a.py", PY_BLAST, "py")])
    py_later = harvest_texts([("a.py", PY_LATER, "py")])
    py_moved = moved_slots(py_old, py_blast)
    py_rows = aloud_rows(py_blast, py_later, py_moved, unfold=False)
    pf = _fates(py_rows, "greeting")
    check("py ALOUD spoken yo", any(r.why == "ALOUD" and "yo" in r.passed for r in py_rows))
    check("py MUTE stayed", len(pf.get("MUTE", [])) == 1)
    check("py FOSSIL hi (old)", any(r.why == "FOSSIL" and "hi" in r.passed for r in py_rows))
    check("py PRE yo at blast", len(pf.get("PRE", [])) == 1)

    # ts positional
    ts_old = harvest_texts([("a.ts", TS_OLD, "ts")])
    ts_blast = harvest_texts([("a.ts", TS_BLAST, "ts")])
    ts_later = harvest_texts([("a.ts", TS_LATER, "ts")])
    ts_moved = moved_slots(ts_old, ts_blast)
    ts_rows = aloud_rows(ts_blast, ts_later, ts_moved, unfold=False)
    tf = _fates(ts_rows, "attempts")
    check(
        "ts ALOUD positional 5",
        len(tf.get("ALOUD", [])) == 1 and tf["ALOUD"][0].blast == "TACIT",
        str([(r.why, r.blast, r.passed, r.others) for r in ts_rows]),
    )
    check("ts MUTE positional", len(tf.get("MUTE", [])) == 1)
    check("ts FOSSIL 3", any(r.why == "FOSSIL" and r.passed.strip() == "3" for r in ts_rows))
    check("ts PRE 5 at blast", len(tf.get("PRE", [])) == 1)

    # same-fingerprint ordinal: two camera calls, speak the second
    twin_blast = r"""
public final class PresenceArbiter {
    public init(sensors: [String], presentThreshold: Double = 0.45) {}
}
public func seed() {
    let a = PresenceArbiter(sensors: ["camera"])
    let b = PresenceArbiter(sensors: ["camera"])
}
"""
    twin_later = r"""
public final class PresenceArbiter {
    public init(sensors: [String], presentThreshold: Double = 0.45) {}
}
public func seed() {
    let a = PresenceArbiter(sensors: ["camera"])
    let b = PresenceArbiter(sensors: ["camera"], presentThreshold: 0.45)
}
"""
    twin_old = twin_blast.replace("0.45", "0.4")
    th = aloud_rows(
        harvest_texts([("t.swift", twin_blast, "swift")]),
        harvest_texts([("t.swift", twin_later, "swift")]),
        moved_slots(
            harvest_texts([("t.swift", twin_old, "swift")]),
            harvest_texts([("t.swift", twin_blast, "swift")]),
        ),
        unfold=False,
    )
    tw = _fates(th, "presentThreshold")
    check(
        "ordinal zip: first MUTE, second ALOUD",
        len(tw.get("MUTE", [])) == 1
        and len(tw.get("ALOUD", [])) == 1
        and tw["MUTE"][0].line < tw["ALOUD"][0].line,
        str([(r.why, r.line, r.passed) for r in th]),
    )

    # harvest sanity: comment residue still ignored
    noisy = BLAST_SWIFT + "\n// PresenceArbiter(SitboneCore)\n"
    nh = harvest_texts([("n.swift", noisy, "swift")])
    nrows = classify_harvest(nh, unfold=False)
    check(
        "comment residue is not a call",
        not any("SitboneCore" in (r.passed or "") for r in nrows),
    )

    # born-after OVERRIDE of a non-default is LOCK, not LATE
    later_lock = LATER_SWIFT.replace(
        'let late = PresenceArbiter(sensors: ["new"], presentThreshold: 0.45)',
        'let late = PresenceArbiter(sensors: ["new"], presentThreshold: 0.45)\n'
        '    let lock = PresenceArbiter(sensors: ["lock"], presentThreshold: 0.99)',
    )
    lock_rows = aloud_rows(
        blast_h,
        harvest_texts([("a.swift", later_lock, "swift")]),
        moved,
        unfold=False,
    )
    check(
        "born-after OVERRIDE is LOCK not LATE",
        any(r.why == "LOCK" and "0.99" in r.passed for r in lock_rows)
        and not any(r.why == "LATE" and "0.99" in r.passed for r in lock_rows),
        str([(r.why, r.passed) for r in lock_rows if r.param == "presentThreshold"]),
    )

    if fails:
        print(f"selftest: {len(fails)} failed", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


