                        "cstring doc-only stays LATENT",
                        kind_of(cneeds["WAD_DOC_ONLY"]) == "LATENT"
                        if "WAD_DOC_ONLY" in cneeds
                        else False,
                        str(sorted(cneeds)),
                    )
                    ccall = {
                        n.name
                        for n in filter_needs(
                            extract_binary(cstr_bin),
                            app=True,
                            min_evidence="call",
                        )
                    }
                    check(
                        "min-evidence call keeps cstring hop",
                        "WAD_CSTRING" in ccall and "WAD_DOC_ONLY" not in ccall,
                        str(sorted(ccall)),
                    )
                    chits = extract_getenv_xrefs(cstr_bin, cstr_bin.read_bytes())
                    check(
                        "cstring how is cstring",
                        any(n == "WAD_CSTRING" and h == "CString" for n, h, _ in chits),
                        str(chits),
                    )
                    chelpers = extract_cstrings(cstr_bin, cstr_bin.read_bytes())
                    check(
                        "discovered wad_var (ptr,len)",
                        any(p == 0 and ln == 1 for _va, p, ln, _s in chelpers),
                        str(chelpers),
                    )
        rustc = shutil.which("rustc")
        if rustc:
            rs = tmp / "inline.rs"
            rs.write_text(
                'fn main() {\n'
                '    let _ = std::env::var("WAD_INLINE_NAME");\n'
                '    let _ = std::env::var("WAD_PACKED_TOKEN");\n'
                "}\n",
                encoding="utf-8",
            )
            rs_bin = tmp / "inline"
            try:
                subprocess.check_call(
                    [
                        rustc,
                        "-O",
                        "-C",
                        "lto=thin",
                        "-C",
                        "codegen-units=1",
                        "-C",
                        "strip=symbols",
                        "-o",
                        str(rs_bin),
                        str(rs),
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except (OSError, subprocess.CalledProcessError):
                rs_bin = None
            if rs_bin and rs_bin.is_file():
                rneeds = {
                    n.name: n
                    for n in filter_needs(
                        extract_binary(rs_bin), app=True, min_evidence="call"
                    )
                }
                check(
                    "inlined rust WAD_INLINE_NAME is DUE",
                    "WAD_INLINE_NAME" in rneeds
                    and kind_of(rneeds["WAD_INLINE_NAME"]) == "DUE",
                    str(sorted(rneeds)),
                )
                check(
                    "inlined rust WAD_PACKED_TOKEN is DUE",
                    "WAD_PACKED_TOKEN" in rneeds
                    and kind_of(rneeds["WAD_PACKED_TOKEN"]) == "DUE",
                    str(sorted(rneeds)),
                )
    except Exception:
        traceback.print_exc()
        failures += 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if failures:
        print(f"selftest: {failures} failure(s)", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


if __name__ == "__main__":
    sys.exit(run())
