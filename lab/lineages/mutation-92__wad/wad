def format_human(
    rows: list[Row],
    *,
    show: bool,
    have_right: bool,
    have_example: bool,
    kind_view: bool = False,
) -> str:
    if not rows:
        return "(no owed names)\n"
    if kind_view:
        cols = ["KIND", "NAME", "EVIDENCE", "SOURCE", "HOW"]
        table: list[list[str]] = [cols]
        for row in rows:
            table.append([row.kind, row.name, row.evidence, row.source, row.detail])
    else:
        cols = ["STATUS", "KIND", "NAME", "LEFT"]
        if have_right:
            cols.append("RIGHT")
        if have_example:
            cols.append("EXAMPLE")
        cols.extend(["EVIDENCE", "SOURCE"])
        table = [cols]
        for row in rows:
            line = [
                row.status,
                row.kind,
                row.name,
                display_value(row.name, row.left, show=show),
            ]
            if have_right:
                line.append(display_value(row.name, row.right, show=show))
            if have_example:
                line.append(display_value(row.name, row.example, show=show))
            line.extend([row.evidence, row.source])
            table.append(line)
    widths = [max(len(r[i]) for r in table) for i in range(len(cols))]
    out = []
    for i, rec in enumerate(table):
        out.append("  ".join(cell.ljust(widths[j]) for j, cell in enumerate(rec)))
        if i == 0:
            out.append("  ".join("-" * widths[j] for j in range(len(cols))))
    return "\n".join(out) + "\n"


def format_tsv(rows: list[Row], *, show: bool) -> str:
    lines = ["status\tkind\tname\tleft\tright\texample\tevidence\tsource\tdetail"]
    for row in rows:
        fields = [
            row.status,
            row.kind,
            row.name,
            display_value(row.name, row.left, show=show),
            display_value(row.name, row.right, show=show),
            display_value(row.name, row.example, show=show),
            row.evidence,
            row.source,
            row.detail,
        ]
        lines.append("\t".join(fields))
    return "\n".join(lines) + "\n"


def format_json(rows: list[Row], *, show: bool) -> str:
    payload = []
    for row in rows:
        payload.append(
            {
                "status": row.status,
                "kind": row.kind,
                "name": row.name,
                "left": None
                if row.left is None
                else display_value(row.name, row.left, show=show),
                "right": None
                if row.right is None
                else display_value(row.name, row.right, show=show),
                "example": None
                if row.example is None
                else display_value(row.name, row.example, show=show),
                "evidence": row.evidence,
                "source": row.source,
                "detail": row.detail,
            }
        )
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def format_abi(needs: list[Need]) -> str:
    lines = ["name\tkind\tevidence\tsource\tdetail\thows"]
    for n in needs:
        hows = ",".join(sorted(n.hows)) if n.hows else n.detail
        lines.append(
            "\t".join([n.name, kind_of(n), n.evidence, n.source, n.detail, hows])
        )
    return "\n".join(lines) + "\n"


def format_emit(needs: list[Need], env: EnvMap, *, show: bool) -> str:
    lines = []
    for n in needs:
        if n.name not in env.values:
            continue
        val = env.values[n.name]
        if not show and looks_secret(n.name, val):
            continue
        lines.append(f"{n.name}={_emit_quote(val)}")
    return "\n".join(lines) + ("\n" if lines else "")


def _emit_quote(val: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_./:@+-]*", val):
        return val
    return json.dumps(val, ensure_ascii=False)


