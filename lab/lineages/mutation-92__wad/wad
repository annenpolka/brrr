def filter_needs(
    needs: list[Need],
    *,
    app: bool,
    min_evidence: str | None,
    loose: bool = False,
) -> list[Need]:
    out = []
    min_rank = EVIDENCE_RANK[min_evidence] if min_evidence else 0
    for n in needs:
        if app and is_libc_name(n.name):
            continue
        if EVIDENCE_RANK.get(n.evidence, 0) < min_rank:
            continue
        due = uses_getenv(n)
        latent = is_documented(n)
        hows = _hows_of(n)
        if not due and not latent and not loose and "needle" not in hows:
            # Orphan cstring / packed LLVM opcode / COLOR_FORCE peel.
            continue
        if (
            n.evidence == "string"
            and not due
            and not loose
            and not is_likely_env_name(n.name)
        ):
            continue
        out.append(n)
    return out


def filter_kind(needs: list[Need], *, due: bool, latent: bool) -> list[Need]:
    if due and latent:
        return [n for n in needs if kind_of(n) == "BOTH"]
    if due:
        return [n for n in needs if kind_of(n) in {"DUE", "BOTH"}]
    if latent:
        return [n for n in needs if kind_of(n) in {"LATENT", "BOTH"}]
    return needs


def wants_env_join(args: argparse.Namespace) -> bool:
    return bool(
        args.left
        or args.right
        or args.vs
        or args.vs_pid is not None
        or args.example
        or args.emit
        or args.spare
    )


def run(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.version:
        print(VERSION)
        return 0
    if args.selftest:
        return run_selftest()

    if args.chdir:
        os.chdir(args.chdir)

    if args.images:
        if not args.programs:
            print("wad: --images needs a program", file=sys.stderr)
            return 2
        try:
            return emit_images(args)
        except (FileNotFoundError, OSError, RuntimeError) as exc:
            print(f"wad: {exc}", file=sys.stderr)
            return 2

    if args.wrappers:
        if not args.programs:
            print("wad: --wrappers needs a program", file=sys.stderr)
            return 2
        try:
            return emit_wrappers(args)
        except (FileNotFoundError, OSError, RuntimeError) as exc:
            print(f"wad: {exc}", file=sys.stderr)
            return 2

    if getattr(args, "cstrings", False):
        if not args.programs:
            print("wad: --cstrings needs a program", file=sys.stderr)
            return 2
        try:
            return emit_cstrings(args)
        except (FileNotFoundError, OSError, RuntimeError) as exc:
            print(f"wad: {exc}", file=sys.stderr)
            return 2

    if args.calls:
        if not args.programs:
            print("wad: --calls needs a program", file=sys.stderr)
            return 2
        try:
            return emit_calls(args)
        except (FileNotFoundError, OSError, RuntimeError) as exc:
            print(f"wad: {exc}", file=sys.stderr)
            return 2

    try:
        needs = collect_needs(args)
    except (FileNotFoundError, ValueError, RuntimeError) as exc:
        print(f"wad: {exc}", file=sys.stderr)
        return 2

    needs = filter_needs(
        needs, app=args.app, min_evidence=args.min_evidence, loose=args.loose
    )
    needs = filter_kind(needs, due=args.due, latent=args.latent)

    if args.vs_program:
        if args.vs or args.right or args.vs_pid is not None:
            print("wad: --vs-program cannot mix with --vs/--right/--vs-pid", file=sys.stderr)
            return 2
        try:
            right_paths = [resolve_program(p) for p in args.vs_program]
            right_needs = harvest(
                right_paths,
                needles=[n.name for n in needs],
                walk_images=not args.solo,
                system=args.system,
                closure=args.closure,
                depth=args.depth,
                loose=args.loose,
            )
        except (FileNotFoundError, OSError) as exc:
            print(f"wad: {exc}", file=sys.stderr)
            return 2
        right_needs = filter_needs(
            right_needs, app=args.app, min_evidence=None, loose=args.loose
        )
        right_needs = filter_kind(right_needs, due=args.due, latent=args.latent)
        if args.names:
            sys.stdout.write("".join(n.name + "\n" for n in needs))
            return 0
        if args.dump_abi:
            sys.stdout.write(format_abi(needs))
            return 0
        rows = classify_abi(needs, right_needs)
        show = True
        if args.json:
            sys.stdout.write(format_json(rows, show=show))
        elif args.tsv or args.porcelain:
            sys.stdout.write(format_tsv(rows, show=show))
        else:
            sys.stdout.write(
                format_human(rows, show=show, have_right=True, have_example=False)
            )
        if args.report_only:
            return 0
        fail = ABI_FAIL_STATUSES if args.check else set()
        if any(r.status in fail for r in rows):
            return 1
        return 0

    if args.names:
        sys.stdout.write("".join(n.name + "\n" for n in needs))
        return 0
    if args.dump_abi:
        sys.stdout.write(format_abi(needs))
        return 0

    if not wants_env_join(args):
        rows = classify(needs, None, None, None, spare=False)
        show = args.show_values
        if args.json:
            sys.stdout.write(format_json(rows, show=show))
        elif args.tsv or args.porcelain:
            sys.stdout.write(format_tsv(rows, show=show))
        else:
            sys.stdout.write(
                format_human(
                    rows,
                    show=show,
                    have_right=False,
                    have_example=False,
                    kind_view=True,
                )
            )
        if args.report_only:
            return 0
        return 0

    try:
        left, right, example = load_envs(args)
    except (OSError, ValueError, RuntimeError, json.JSONDecodeError) as exc:
        print(f"wad: {exc}", file=sys.stderr)
        return 2

    if args.emit:
        env = left or current_env()
        sys.stdout.write(format_emit(needs, env, show=args.show_values))
        return 0

    rows = classify(
        needs,
        left,
        right,
        example,
        spare=args.spare,
    )
    show = args.show_values
    if args.json:
        sys.stdout.write(format_json(rows, show=show))
    elif args.tsv or args.porcelain:
        sys.stdout.write(format_tsv(rows, show=show))
    else:
        sys.stdout.write(
            format_human(
                rows,
                show=show,
                have_right=right is not None,
                have_example=example is not None,
            )
        )

    if args.report_only:
        return 0
    if args.check and any(r.status in FAIL_STATUSES for r in rows):
        return 1
    if not args.check and any(r.status in FAIL_STATUSES for r in rows):
        return 1
    return 0


def collect_needs(args: argparse.Namespace) -> list[Need]:
    needs: list[Need] = []
    if args.abi:
        if args.abi == "-":
            needs.extend(parse_abi_text(sys.stdin.read(), "stdin"))
        else:
            path = Path(args.abi)
            needs.extend(parse_abi_text(path.read_text(encoding="utf-8"), str(path)))
    programs = list(args.programs)
    if not programs and not args.abi:
        raise ValueError("need a program/tree or --abi")
    paths = [resolve_program(p) for p in programs]
    if paths:
        needs.extend(
            harvest(
                paths,
                walk_images=not args.solo,
                system=args.system,
                closure=args.closure,
                depth=args.depth,
                loose=args.loose,
            )
        )
    return merge_needs(needs)


def format_images(rows: list[ImageRow], *, tsv: bool = False) -> str:
    lines = []
    if tsv:
        lines.append("role\tbytes\tpath\traw")
        for row in rows:
            path = str(row.path) if row.path is not None else "-"
            lines.append(f"{row.role}\t{row.bytes}\t{path}\t{row.raw}")
        return "\n".join(lines) + "\n"
    for row in rows:
        path = str(row.path) if row.path is not None else row.raw
        extra = f"  ({row.bytes})" if row.bytes else ""
        if row.role == "skip":
            lines.append(f"skip  {path}")
        elif row.role == "missing":
            lines.append(f"miss  {row.raw}")
        elif row.role == "main":
            lines.append(f"main  {path}{extra}")
        else:
            lines.append(f"load  {path}{extra}")
    return "\n".join(lines) + ("\n" if lines else "")


def emit_images(args: argparse.Namespace) -> int:
    chunks: list[str] = []
    for spec in args.programs:
        path = resolve_program(spec)
        rows = iter_loaded_images(
            path.resolve(),
            system=args.system,
            closure=args.closure,
            depth=args.depth,
        )
        chunks.append(format_images(rows, tsv=args.tsv or args.porcelain))
    sys.stdout.write("".join(chunks))
    return 0


def emit_calls(args: argparse.Namespace) -> int:
    """Print getenv-shaped xref sites. One row per (name, source, va)."""
    seen_images: set[Path] = set()
    lines = ["name\thow\tva\tsource"]

    def one(path: Path) -> None:
        try:
            path = path.resolve()
        except OSError:
            return
        if path in seen_images:
            return
        seen_images.add(path)
        try:
            raw = path.read_bytes()
        except OSError:
            return
        hits = extract_getenv_xrefs(path, raw)
        for name, how, va in hits:
            if not ENV_NAME_RE.match(name):
                continue
            if args.app and is_libc_name(name):
                continue
            lines.append(f"{name}\t{how}\t{va:#x}\t{path}")
        if args.solo or not is_macho_or_elf(path):
            return
        for row in iter_loaded_images(
            path,
            system=args.system,
            closure=args.closure,
            depth=args.depth,
        ):
            if row.role == "load" and row.path is not None:
                one(row.path)

    for spec in args.programs:
        one(resolve_program(spec))
    sys.stdout.write("\n".join(lines) + "\n")
    return 0


