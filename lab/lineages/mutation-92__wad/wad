_SHELL_BRACE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?::[-+=?][^}]*)?\}")
_SHELL_DOLLAR = re.compile(r"\$([A-Z_][A-Z0-9_]{1,})")


def extract_by_regex(path: Path, text: str, _why: str) -> list[Need]:
    found: list[Need] = []
    for i, line in enumerate(text.splitlines(), 1):
        for _label, cre, detail in _CALL_SPECS:
            for m in cre.finditer(line):
                n = _need(m.group(1), "call", _loc(path, i), detail)
                if n:
                    found.append(n)
    return found


def extract_shell(path: Path, text: str) -> list[Need]:
    found: list[Need] = []
    for i, line in enumerate(text.splitlines(), 1):
        stripped = line.lstrip()
        if stripped.startswith("#"):
            continue
        for m in _SHELL_BRACE.finditer(line):
            n = _need(m.group(1), "shell", _loc(path, i), "${}")
            if n:
                found.append(n)
        for m in _SHELL_DOLLAR.finditer(line):
            n = _need(m.group(1), "shell", _loc(path, i), "$VAR")
            if n:
                found.append(n)
    return found


def is_macho_or_elf(path: Path) -> bool:
    try:
        with path.open("rb") as fh:
            magic = fh.read(4)
    except OSError:
        return False
    if magic == b"\x7fELF":
        return True
    if magic in MACH_O_MAGICS:
        return True
    if magic[:2] == b"MZ":
        return True
    return False


def env_prefixes(extra: Iterable[str] | None = None) -> list[str]:
    prefixes = set(PREFIX_SEEDS)
    names = list(LIBC_ENV)
    if extra:
        names.extend(extra)
    for name in names:
        if "_" not in name or not UPPER_NAME_RE.match(name):
            continue
        head = name.split("_", 1)[0]
        if len(head) >= 2:
            prefixes.add(head + "_")
    return sorted(prefixes, key=len, reverse=True)


def is_runtime_family(name: str) -> bool:
    """PYTHONHOME, PERL5LIB, RUBYOPT — interpreter ABI, often no underscore."""
    if not UPPER_NAME_RE.match(name):
        return False
    if len(name) < 4 or len(name) > 40:
        return False
    if name in REJECT_STRINGS:
        return False
    for pfx in RUNTIME_FAMILY_PREFIXES:
        if name == pfx or name.startswith(pfx):
            rest = name[len(pfx) :]
            if rest == "" or re.fullmatch(r"[A-Z0-9_]+", rest):
                return True
    return False


def is_valid_env_token(name: str) -> bool:
    if name in REJECT_STRINGS:
        return False
    if name in LIBC_ENV or name in BARE_APP:
        return True
    if is_runtime_family(name):
        return True
    if not UPPER_NAME_RE.match(name):
        return False
    if name.startswith("_") or name.endswith("_"):
        return False
    if "_" not in name:
        return False
    if re.search(r"\d$", name):
        return False
    if len(name) > 40:
        return False
    parts = name.split("_")
    head, rest = parts[0], parts[1:]
    if len(head) < 2 or not head.isalpha():
        return False
    if not rest:
        return False
    if any(len(p) > 16 for p in parts):
        return False
    long_alpha = [p for p in parts if len(p) >= 3 and p.isalpha()]
    short_letter = [p for p in parts if len(p) == 1 and p.isalpha()]
    if short_letter and len(long_alpha) < 2:
        return False
    if re.fullmatch(r"U+", name.replace("_", "")):
        return False
    return True


def is_likely_env_name(name: str) -> bool:
    """String-evidence filter: real-looking env, not compiler tables."""
    if name in LIBC_ENV or name in BARE_APP:
        return True
    if is_runtime_family(name):
        return True
    if not is_valid_env_token(name):
        return False
    parts = name.split("_")
    if parts[0] + "_" in PREFIX_SEEDS:
        return True
    if parts[-1] in ENV_SUFFIXES:
        return True
    if len(parts) >= 3 and sum(1 for p in parts if len(p) >= 3) >= 2:
        return True
    return False


def split_packed(blob: str, prefixes: list[str]) -> list[str]:
    cuts = {0, len(blob)}
    for i in range(1, len(blob)):
        for pfx in prefixes:
            if blob.startswith(pfx, i):
                cuts.add(i)
                break
        else:
            # CONFIG|XDG_… — suffix word glued to a new PREFIX_
            if re.match(r"[A-Z]{2,}_", blob[i:]):
                before = blob[:i]
                word = before.rsplit("_", 1)[-1]
                if word in ENV_SUFFIXES:
                    cuts.add(i)
    ordered = sorted(cuts)
    out: list[str] = []
    for a, b in zip(ordered, ordered[1:]):
        piece = blob[a:b]
        if is_valid_env_token(piece) or piece in BARE_APP or piece in LIBC_ENV:
            out.append(piece)
            continue
        for m in PACKED_TOKEN_RE.finditer(piece):
            tok = m.group()
            following = piece[m.end() :]
            if tok and tok[-1].isupper() and following[:1].islower():
                shorter = tok[:-1]
                short_last = shorter.rsplit("_", 1)[-1]
                long_last = tok.rsplit("_", 1)[-1]
                if (
                    is_valid_env_token(shorter)
                    and short_last in ENV_SUFFIXES
                    and long_last not in ENV_SUFFIXES
                ):
                    tok = shorter
            if is_valid_env_token(tok):
                out.append(tok)
        for bare in BARE_APP | (LIBC_ENV & {"HOME", "PATH", "USER", "TERM", "SHELL", "EDITOR"}):
            idx = 0
            while True:
                j = piece.find(bare, idx)
                if j < 0:
                    break
                end = j + len(bare)
                left_ok = j == 0 or not (piece[j - 1].isalnum() or piece[j - 1] == "_")
                right_ok = end == len(piece) or not (piece[end].isalnum() or piece[end] == "_")
                if left_ok and right_ok:
                    out.append(bare)
                idx = j + 1
    return out


def _after_boundary_ok(data: bytes, i: int, n: int) -> bool:
    rest = data[i + n :]
    if not rest:
        return True
    c = rest[0]
    if not (chr(c).isalnum() or c == ord("_")):
        return True
    if 97 <= c <= 122:  # lowercase: end of ALLCAPS token
        return True
    if 65 <= c <= 90:  # uppercase
        if re.match(rb"[A-Z]{2,}_", rest):
            return True
        if len(rest) > 1 and 97 <= rest[1] <= 122:
            return True  # Titlecase word (Library, Application)
        return False
    return False


def name_in_blob(data: bytes, name: str) -> bool:
    try:
        needle = name.encode("ascii")
    except UnicodeEncodeError:
        return False
    start = 0
    n = len(needle)
    while True:
        i = data.find(needle, start)
        if i < 0:
            return False
        if _after_boundary_ok(data, i, n):
            return True
        start = i + 1


def _is_env_byte(b: int) -> bool:
    return (48 <= b <= 57) or (65 <= b <= 90) or b == 95


def extract_doc_env_tokens(data: bytes) -> list[tuple[str, str]]:
    """Help tables, `NAME =`, and `$NAME` — how CPython spells PYTHONHOME.

    Returns (name, how) with how in {help, assign, dollar}.
    """
    found: list[tuple[str, str]] = []
    seen: set[tuple[str, str]] = set()

    def keep(raw: bytes, how: str) -> None:
        try:
            text = raw.decode("ascii")
        except UnicodeDecodeError:
            return
        key = (text, how)
        if key in seen:
            return
        if not (
            is_valid_env_token(text)
            or is_runtime_family(text)
            or text in LIBC_ENV
            or text in BARE_APP
        ):
            return
        seen.add(key)
        found.append((text, how))

    for cre, how in (
        (HELP_ENV_RE, "help"),
        (ASSIGN_ENV_RE, "assign"),
        (DOLLAR_ENV_RE, "dollar"),
        (ENV_PROSE_RE, "prose"),
    ):
        for m in cre.finditer(data):
            keep(m.group(1), how)
    return found


def peel_prefix_tokens(data: bytes, prefixes: list[str]) -> list[str]:
    """Find PREFIX_ seeds as bytes and take the ALLCAPS token at that offset.

    Survives packed Rust rodata without walking every printable run of a
    200MB librustc_driver.
    """
    out: list[str] = []
    seen: set[str] = set()
    for pfx in prefixes:
        try:
            needle = pfx.encode("ascii")
        except UnicodeEncodeError:
            continue
        start = 0
        n = len(needle)
        while True:
            i = data.find(needle, start)
            if i < 0:
                break
            j = i
            m = len(data)
            while j < m and _is_env_byte(data[j]):
                j += 1
            tok = data[i:j].decode("ascii")
            pieces = split_packed(tok, prefixes)
            if not pieces and (
                is_valid_env_token(tok) or tok in LIBC_ENV or tok in BARE_APP
            ):
                pieces = [tok]
            for piece in pieces:
                if piece not in seen and (
                    is_valid_env_token(piece) or piece in LIBC_ENV or piece in BARE_APP
                ):
                    seen.add(piece)
                    out.append(piece)
            start = i + n
    return out


# ---------------------------------------------------------------------------
# Mach-O / ELF getenv xref
# ---------------------------------------------------------------------------

MH_MAGIC_64 = 0xFEEDFACF
MH_CIGAM_64 = 0xCFFAEDFE
FAT_MAGIC = 0xCAFEBABE
FAT_CIGAM = 0xBEBAFECA
CPU_TYPE_X86_64 = 0x01000007
CPU_TYPE_ARM64 = 0x0100000C
LC_SYMTAB = 0x02
LC_DYSYMTAB = 0x0B
LC_SEGMENT_64 = 0x19
S_SYMBOL_STUBS = 0x08
INDIRECT_SYMBOL_LOCAL = 0x80000000
INDIRECT_SYMBOL_ABS = 0x40000000

ELF_MAGIC = b"\x7fELF"


def getenv_sym_kind(name: str) -> str | None:
    """Classify a symbol as a getenv-shaped callee. None = ignore."""
    if not name:
        return None
    raw = name
    if name.startswith("_Z"):  # Itanium
        if "getenvPKc" in name or name == "_ZSt6getenvPKc":
            return "std::getenv"
        if "getenv" in name.lower() and "Environ" not in name:
            return "std::getenv"
    n = name.lstrip("_")
    if "NSGetEnviron" in name or n in {"NSGetEnviron", "_NSGetEnviron"}:
        return None
    if n in {"getenv", "secure_getenv"}:
        return "getenv"
    if n == "Py_GETENV" or name.endswith("Py_GETENV"):
        return "getenv"
    if n.endswith("getenv") or name.endswith("GETENV"):
        # mimalloc _mi_prim_getenv, rust unix getenv, …
        if "Environ" in name:
            return None
        return "getenv"
    if "std3env7__var_os" in name or name.endswith("7__var_os"):
        return "env::var_os"
    if "std3env4__var" in name or name.endswith("4__var"):
        return "env::var"
    if "std3env3var_os" in name:
        return "env::var_os"
    if "std3env3var" in name:
        return "env::var"
    if "3env3var_os" in name:
        return "env::var_os"
    if "3env3var" in name and "current" not in name:
        return "env::var"
    return None


def _host_prefers_arm64() -> bool:
    mach = os.uname().machine.lower() if hasattr(os, "uname") else ""
    return mach in {"arm64", "aarch64"}


def macho_native_slice(data: bytes) -> bytes:
    """Return the preferred thin Mach-O from a fat image, else data."""
    if len(data) < 8:
        return data
    magic = data[:4]
    if magic not in (b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca"):
        return data
    be = magic == b"\xca\xfe\xba\xbe"
    endian = ">" if be else "<"
    nfat = struct.unpack_from(endian + "I", data, 4)[0]
    if nfat <= 0 or nfat > 16:
        return data
    prefer_arm = _host_prefers_arm64()
    arm = x64 = first = None
    for i in range(nfat):
        off = 8 + i * 20
        if off + 20 > len(data):
            break
        cputype, _cpusub, offset, size, _align = struct.unpack_from(
            endian + "IIIII", data, off
        )
        if offset + size > len(data):
            continue
        slice_ = data[offset : offset + size]
        if first is None:
            first = slice_
        if cputype == CPU_TYPE_ARM64:
            arm = slice_
        elif cputype == CPU_TYPE_X86_64:
            x64 = slice_
    if prefer_arm:
        return arm or x64 or first or data
    return x64 or arm or first or data


@dataclass
class _Sect:
    sg: str
    sn: str
    addr: int
    size: int
    off: int
    flags: int
    res1: int
    res2: int


@dataclass
class _MachO:
    data: bytes
    cputype: int
    sects: list[_Sect]
    symbols: list[tuple[str, int, int, int]]  # name, type, sect, value
    indirect: bytes
    nindirect: int


@dataclass(frozen=True)
class _Callee:
    """A getenv-shaped callee: how, which argv register, extra byte offset."""

    how: str
    arg: int = 0
    offset: int = 0
    symbol: str = ""
    len_arg: int | None = None  # env::var / cstring length register


@dataclass(frozen=True)
class _Origin:
    """Where a register at a call site came from."""

    kind: str  # arg | stack | lit | imm
    reg: int = 0
    offset: int = 0
    value: int = 0


def parse_macho(data: bytes) -> _MachO | None:
    if len(data) < 32:
        return None
    magic = struct.unpack_from("<I", data, 0)[0]
    if magic == MH_CIGAM_64:
        return None  # swapped; ignore
    if magic != MH_MAGIC_64:
        return None
    _magic, cputype, _cpusub, _ft, ncmds, sizeofcmds, _flags, _res = struct.unpack_from(
        "<IIIIIIII", data, 0
    )
    if sizeofcmds > len(data):
        return None
    off = 32
    sects: list[_Sect] = []
    indirectoff = nindirect = 0
    symoff = nsyms = stroff = strsize = 0
    end_cmds = 32 + sizeofcmds
    for _ in range(ncmds):
        if off + 8 > end_cmds:
            break
        cmd, cmdsize = struct.unpack_from("<II", data, off)
        if cmdsize < 8:
            break
        if cmd == LC_SEGMENT_64 and cmdsize >= 72:
            nsects = struct.unpack_from("<I", data, off + 64)[0]
            so = off + 72
            for _i in range(nsects):
                if so + 80 > len(data):
                    break
                sn = data[so : so + 16].split(b"\0", 1)[0].decode("ascii", "replace")
                sg = data[so + 16 : so + 32].split(b"\0", 1)[0].decode("ascii", "replace")
                addr, size = struct.unpack_from("<QQ", data, so + 32)
                soff = struct.unpack_from("<I", data, so + 48)[0]
                flags = struct.unpack_from("<I", data, so + 64)[0]
                reserved1, reserved2 = struct.unpack_from("<II", data, so + 68)
                sects.append(_Sect(sg, sn, addr, size, soff, flags, reserved1, reserved2))
                so += 80
        elif cmd == LC_SYMTAB and cmdsize >= 24:
            symoff, nsyms, stroff, strsize = struct.unpack_from("<IIII", data, off + 8)
        elif cmd == LC_DYSYMTAB and cmdsize >= 80:
            fields = struct.unpack_from("<" + "I" * 18, data, off + 8)
            indirectoff, nindirect = fields[12], fields[13]
        off += cmdsize
    symbols: list[tuple[str, int, int, int]] = []
    if nsyms and symoff and stroff + strsize <= len(data) and nsyms < 5_000_000:
        for i in range(nsyms):
            rec = symoff + i * 16
            if rec + 16 > len(data):
                break
            n_strx, n_type, n_sect, _n_desc, n_value = struct.unpack_from(
                "<IBBHQ", data, rec
            )
            name = ""
            if 0 < n_strx < strsize:
                start = stroff + n_strx
                end = data.find(b"\0", start, min(start + 512, stroff + strsize))
                if end > start:
                    name = data[start:end].decode("ascii", "replace")
            symbols.append((name, n_type, n_sect, n_value))
    indirect = b""
    if nindirect and indirectoff and nindirect < 2_000_000:
        nbytes = nindirect * 4
        if indirectoff + nbytes <= len(data):
            indirect = data[indirectoff : indirectoff + nbytes]
    return _MachO(data, cputype, sects, symbols, indirect, nindirect)


def _macho_vm_to_file(mo: _MachO, vm: int) -> int | None:
    for s in mo.sects:
        if s.addr <= vm < s.addr + s.size:
            return s.off + (vm - s.addr)
    return None


def _macho_stub_map(mo: _MachO) -> dict[int, str]:
    """VA → symbol for S_SYMBOL_STUBS only (never __stub_helper)."""
    out: dict[int, str] = {}
    for s in mo.sects:
        if (s.flags & 0xFF) != S_SYMBOL_STUBS:
            continue
        stubsize = s.res2 or (16 if "auth" in s.sn else 12)
        if stubsize <= 0 or s.size <= 0:
            continue
        n = s.size // stubsize
        if n > 100_000:
            continue
        for j in range(n):
            idx_off = (s.res1 + j) * 4
            if idx_off + 4 > len(mo.indirect):
                break
            idx = struct.unpack_from("<I", mo.indirect, idx_off)[0]
            if idx & (INDIRECT_SYMBOL_LOCAL | INDIRECT_SYMBOL_ABS):
                continue
            if idx >= len(mo.symbols):
                continue
            name = mo.symbols[idx][0]
            if name:
                out[s.addr + j * stubsize] = name
    return out


def _macho_getenv_targets(mo: _MachO) -> dict[int, str]:
    """VA → kind for getenv-shaped stubs and defined symbols."""
    targets: dict[int, str] = {}
    for va, name in _macho_stub_map(mo).items():
        kind = getenv_sym_kind(name)
        if kind:
            targets[va] = kind
    for name, _t, sect, val in mo.symbols:
        if sect == 0:
            continue
        kind = getenv_sym_kind(name)
        if kind:
            targets[val] = kind
    return targets


def _is_memcpy_sym(name: str) -> bool:
    n = name.lstrip("_")
    return n in {"memcpy", "memmove", "bcopy", "memcpy_chk"} or n.endswith(
        "memcpy_chk"
    )


def _macho_memcpy_targets(mo: _MachO) -> set[int]:
    return {va for va, name in _macho_stub_map(mo).items() if _is_memcpy_sym(name)}


def _read_ascii(data: bytes, file_off: int, n: int) -> str | None:
    if file_off < 0 or n <= 0 or n > 80:
        return None
    if file_off + n > len(data):
        return None
    chunk = data[file_off : file_off + n]
    if all(32 <= b < 127 for b in chunk):
        return chunk.decode("ascii")
    return None


def _read_cstr(data: bytes, file_off: int, limit: int = 80) -> str | None:
    if file_off < 0 or file_off >= len(data):
        return None
    end = data.find(b"\0", file_off, min(file_off + limit, len(data)))
    if end < 0:
        return None
    return _read_ascii(data, file_off, end - file_off)


def _arm64_adrp(word: int, pc: int) -> tuple[int, int] | None:
    if (word & 0x9F000000) != 0x90000000:
        return None
    rd = word & 31
    immlo = (word >> 29) & 3
    immhi = (word >> 5) & 0x7FFFF
    imm = (immhi << 2) | immlo
    if imm & (1 << 20):
        imm -= 1 << 21
    return rd, (pc & ~0xFFF) + (imm << 12)


def _arm64_adr(word: int, pc: int) -> tuple[int, int] | None:
    if (word & 0x9F000000) != 0x10000000:
        return None
    rd = word & 31
    immlo = (word >> 29) & 3
    immhi = (word >> 5) & 0x7FFFF
    imm = (immhi << 2) | immlo
    if imm & (1 << 20):
        imm -= 1 << 21
    return rd, pc + imm


def _arm64_add_imm(word: int) -> tuple[int, int, int] | None:
    if (word & 0xFF800000) != 0x91000000:
        return None
    sh = (word >> 22) & 1
    imm12 = (word >> 10) & 0xFFF
    rn = (word >> 5) & 31
    rd = word & 31
    return rd, rn, imm12 << (12 if sh else 0)


def _arm64_movz(word: int) -> tuple[int, int] | None:
    if (word & 0x7F800000) != 0x52800000:
        return None
    rd = word & 31
    imm16 = (word >> 5) & 0xFFFF
    hw = (word >> 21) & 3
    return rd, imm16 << (hw * 16)


def _arm64_movk(word: int) -> tuple[int, int, int] | None:
    if (word & 0x7F800000) != 0x72800000:
        return None
    rd = word & 31
    imm16 = (word >> 5) & 0xFFFF
    hw = (word >> 21) & 3
    return rd, imm16, hw


def _arm64_mov_reg(word: int) -> tuple[int, int] | None:
    # ORR Xd, XZR, Xm  / ORR Wd, WZR, Wm  (unshifted)
    if (word & 0x7FE0FFE0) != 0x2A0003E0:
        return None
    if ((word >> 10) & 0x3F) != 0:
        return None
    if ((word >> 22) & 3) != 0:
        return None
    return word & 31, (word >> 16) & 31


def _arm64_bl_target(word: int, pc: int) -> int | None:
    op = word >> 26
    if op not in (0b100101, 0b000101):  # BL, B (tail)
        return None
    imm26 = word & 0x3FFFFFF
    if imm26 & (1 << 25):
        imm26 -= 1 << 26
    return pc + (imm26 << 2)


def _arm64_ret(word: int) -> bool:
    return (word & 0xFFFFFC1F) == 0xD65F0000


def _arm64_is_b_cond(word: int) -> bool:
    return (word & 0xFF000010) == 0x54000000


def _arm64_is_cbz_family(word: int) -> bool:
    op = word & 0x7E000000
    return op in (0x34000000, 0x35000000, 0x36000000, 0x37000000)


def _arm64_is_any_branch(word: int) -> bool:
    op = word >> 26
    if op in (0b000101, 0b100101):
        return True
    return _arm64_is_b_cond(word) or _arm64_is_cbz_family(word)


def _arm64_ldr_rd(word: int) -> int | None:
    """Register written by a common LDR form, else None."""
    if (word & 0xFFC00000) in (0xF9400000, 0xB9400000, 0x39400000, 0x79400000):
        return word & 31
    if (word & 0xFF000000) in (0x58000000, 0x18000000, 0x98000000):
        return word & 31
    return None


def _arm64_mem_uoff64(word: int, *, load: bool) -> tuple[int, int, int] | None:
    """LDR/STR Xt, [Xn, #imm12*8] → (rt, rn, byte_off)."""
    want = 0xF9400000 if load else 0xF9000000
    if (word & 0xFFC00000) != want:
        return None
    rt = word & 31
    rn = (word >> 5) & 31
    imm12 = (word >> 10) & 0xFFF
    return rt, rn, imm12 * 8


def _arm64_mem_unscaled64(word: int, *, load: bool) -> tuple[int, int, int] | None:
    """LDUR/STUR Xt, [Xn, #simm9] → (rt, rn, byte_off)."""
    want = 0xF8400000 if load else 0xF8000000
    if (word & 0xFFE00C00) != want:
        return None
    rt = word & 31
    rn = (word >> 5) & 31
    imm9 = (word >> 12) & 0x1FF
    if imm9 & 0x100:
        imm9 -= 0x200
    return rt, rn, imm9


def _arm64_is_stack_base(rn: int) -> bool:
    return rn in (29, 31)  # fp / sp


def _arm64_recover_regs(blob: bytes, taddr: int, call_off: int, window: int = 48) -> dict[int, int]:
    regs: dict[int, int] = {}
    start = max(0, call_off - window * 4)
    for off in range(start, call_off, 4):
        word = struct.unpack_from("<I", blob, off)[0]
        pc = taddr + off
        ad = _arm64_adrp(word, pc) or _arm64_adr(word, pc)
        if ad:
            regs[ad[0]] = ad[1]
            continue
        add = _arm64_add_imm(word)
        if add:
            rd, rn, imm = add
            if rn in regs:
                regs[rd] = regs[rn] + imm
            continue
        mv = _arm64_mov_reg(word)
        if mv:
            rd, rm = mv
            if rm in regs:
                regs[rd] = regs[rm]
            continue
        mz = _arm64_movz(word)
        if mz:
            regs[mz[0]] = mz[1]
            continue
        mk = _arm64_movk(word)
        if mk:
            rd, imm16, hw = mk
            if rd in regs:
                shift = hw * 16
                mask = 0xFFFF << shift
                regs[rd] = (regs[rd] & ~mask) | (imm16 << shift)
    return regs


def _macho_text_funcs(mo: _MachO, text: _Sect) -> list[tuple[int, str]]:
    lo, hi = text.addr, text.addr + text.size
    funcs = [(val, name) for name, _t, _sect, val in mo.symbols if name and lo <= val < hi]
    funcs.sort()
    return funcs


def _containing_func(funcs: list[tuple[int, str]], va: int) -> tuple[int, str] | None:
    lo, hi = 0, len(funcs)
    best: tuple[int, str] | None = None
    while lo < hi:
        mid = (lo + hi) // 2
        if funcs[mid][0] <= va:
            best = funcs[mid]
            lo = mid + 1
        else:
            hi = mid
    return best


def _arm64_arg_to_x0(
    blob: bytes, taddr: int, fn_off: int, call_off: int
) -> tuple[int, int] | None:
    """If x0 at call_off is ARG[k] plus a small constant, return (k, offset).

    Walks backward from the getenv site. A `ret` / `b elsewhere` block is
    skipped so `_Py_GETENV`'s early `mov x0, #0; ret` does not kill ARG0.
    One hop only: we do not follow a wrapper of a wrapper.
    """
    if call_off <= fn_off or (call_off - fn_off) > 2048:
        return None
    need: int | None = 0  # register we are tracing, or None if tracing a slot
    slot: tuple[int, int] | None = None  # (rn, imm) of a spilled arg
    offset = 0
    skipping = False
    for off in range(call_off - 4, fn_off - 4, -4):
        if off < 0:
            break
        word = struct.unpack_from("<I", blob, off)[0]
        pc = taddr + off
        if skipping:
            if _arm64_is_any_branch(word):
                skipping = False
            continue
        if _arm64_ret(word):
            skipping = True
            continue
        b_tgt = _arm64_bl_target(word, pc)
        op = word >> 26
        if op == 0b000101 and b_tgt is not None:
            # Unconditional B to somewhere that is not this getenv site.
            if b_tgt != taddr + call_off:
                skipping = True
                continue
        if need is not None:
            mv = _arm64_mov_reg(word)
            if mv:
                rd, rm = mv
                if rd == need:
                    need = rm
                continue
            add = _arm64_add_imm(word)
            if add:
                rd, rn, imm = add
                if rd == need:
                    need = rn
                    offset += imm
                    if offset > 32:
                        return None
                continue
            ad = _arm64_adrp(word, pc) or _arm64_adr(word, pc)
            if ad and ad[0] == need:
                return None
            mz = _arm64_movz(word)
            if mz and mz[0] == need:
                return None
            load = _arm64_mem_uoff64(word, load=True) or _arm64_mem_unscaled64(
                word, load=True
            )
            if load:
                rt, rn, imm = load
                if rt == need:
                    if _arm64_is_stack_base(rn):
                        slot = (rn, imm)
                        need = None
                    else:
                        return None
                continue
            if _arm64_ldr_rd(word) == need:
                return None
            continue
        # Tracing a stack slot back to the store that filled it.
        store = _arm64_mem_uoff64(word, load=False) or _arm64_mem_unscaled64(
            word, load=False
        )
        if store and slot is not None:
            rt, rn, imm = store
            if (rn, imm) == slot:
                need = rt
                slot = None
            continue
    if need is not None and 0 <= need <= 7:
        return need, offset
    return None


def _arm64_is_sub_sp(word: int) -> bool:
    """sub sp, sp, #imm12 — typical rustc/C function entry on arm64."""
    return (word & 0xFF0003FF) == 0xD10003FF


def _arm64_strb_imm(word: int) -> tuple[int, int, int] | None:
    """STRB Wt, [Xn, #imm12] → (rt, rn, imm)."""
    if (word & 0xFFC00000) != 0x39000000:
        return None
    rt = word & 31
    rn = (word >> 5) & 31
    imm12 = (word >> 10) & 0xFFF
    return rt, rn, imm12


def _arm64_str_imm32(word: int) -> tuple[int, int, int] | None:
    """STR Wt, [Xn, #imm12*4] → (rt, rn, byte_off)."""
    if (word & 0xFFC00000) != 0xB9000000:
        return None
    rt = word & 31
    rn = (word >> 5) & 31
    return rt, rn, ((word >> 10) & 0xFFF) * 4


def _arm64_stur_imm32(word: int) -> tuple[int, int, int] | None:
    """STUR Wt, [Xn, #simm9]."""
    if (word & 0xFFE00C00) != 0xB8000000:
        return None
    rt = word & 31
    rn = (word >> 5) & 31
    imm9 = (word >> 12) & 0x1FF
    if imm9 & 0x100:
        imm9 -= 0x200
    return rt, rn, imm9


def _arm64_func_starts(
    mo: _MachO, text: _Sect, blob: bytes, taddr: int
) -> list[tuple[int, str]]:
    """Symbol functions plus `bl` targets that begin with `sub sp` (stripped rust)."""
    funcs = {va: name for va, name in _macho_text_funcs(mo, text)}
    limit = taddr + len(blob)
    for i in range(0, len(blob) - 3, 4):
        word = struct.unpack_from("<I", blob, i)[0]
        tgt = _arm64_bl_target(word, taddr + i)
        if tgt is None or tgt < taddr or tgt >= limit:
            continue
        if tgt in funcs:
            continue
        toff = tgt - taddr
        if toff + 4 > len(blob):
            continue
        if _arm64_is_sub_sp(struct.unpack_from("<I", blob, toff)[0]):
            funcs[tgt] = ""
    return sorted(funcs.items())


def _arm64_trace(
    blob: bytes, taddr: int, fn_off: int, call_off: int, start_reg: int
) -> _Origin | None:
    """Trace start_reg at call_off back to an ARG, stack slot, or literal."""
    if call_off <= fn_off or (call_off - fn_off) > 2048:
        return None
    need: int | None = start_reg
    slot: tuple[int, int] | None = None
    offset = 0
    skipping = False
    movks: list[tuple[int, int]] = []  # (imm16, hw) applied onto a later movz
    for off in range(call_off - 4, fn_off - 4, -4):
        if off < 0:
            break
        word = struct.unpack_from("<I", blob, off)[0]
        pc = taddr + off
        if skipping:
            if _arm64_is_any_branch(word):
                skipping = False
            continue
        if _arm64_ret(word):
            skipping = True
            continue
        b_tgt = _arm64_bl_target(word, pc)
        op = word >> 26
        if op == 0b000101 and b_tgt is not None:
            if b_tgt != taddr + call_off:
                skipping = True
                continue
        if need is not None:
            mv = _arm64_mov_reg(word)
            if mv:
                rd, rm = mv
                if rd == need:
                    need = rm
                continue
            add = _arm64_add_imm(word)
            if add:
                rd, rn, imm = add
                if rd == need:
                    if _arm64_is_stack_base(rn):
                        return _Origin("stack", rn, imm + offset)
                    need = rn
                    offset += imm
                    if offset > 64:
                        return None
                continue
            ad = _arm64_adrp(word, pc) or _arm64_adr(word, pc)
            if ad and ad[0] == need:
                return _Origin("lit", value=ad[1] + offset)
            mk = _arm64_movk(word)
            if mk and mk[0] == need:
                movks.append((mk[1], mk[2]))
                continue
            mz = _arm64_movz(word)
            if mz and mz[0] == need:
                val = mz[1]
                for imm16, hw in movks:
                    shift = hw * 16
                    val = (val & ~(0xFFFF << shift)) | (imm16 << shift)
                return _Origin("imm", value=val)
            load = _arm64_mem_uoff64(word, load=True) or _arm64_mem_unscaled64(
                word, load=True
            )
            if load:
                rt, rn, imm = load
                if rt == need:
                    if _arm64_is_stack_base(rn):
                        slot = (rn, imm)
                        need = None
                    else:
                        return None
                continue
            if _arm64_ldr_rd(word) == need:
                return None
            continue
        store = _arm64_mem_uoff64(word, load=False) or _arm64_mem_unscaled64(
            word, load=False
        )
        if store and slot is not None:
            rt, rn, imm = store
            if (rn, imm) == slot:
                need = rt
                slot = None
            continue
    if need is not None and 0 <= need <= 7:
        return _Origin("arg", need, offset)
    return None


def _arm64_imm_bytes(value: int) -> bytes:
    if value < 0:
        return b""
    raw = value.to_bytes(8, "little")
    return raw.rstrip(b"\x00") or b"\x00"


def _arm64_stack_cstr(
    blob: bytes,
    taddr: int,
    fn_off: int,
    call_off: int,
    stack_off: int,
    mo: _MachO,
    data: bytes,
) -> str | None:
    """Recover a stack CString written just before getenv: immediates or rodata copy."""
    if call_off <= fn_off or (call_off - fn_off) > 2048:
        return None
    # slot → bytes written into [sp/fp + stack_off + k]
    written: dict[int, int] = {}
    saw_nul = False
    skipping = False
    for off in range(call_off - 4, fn_off - 4, -4):
        if off < 0:
            break
        word = struct.unpack_from("<I", blob, off)[0]
        pc = taddr + off
        if skipping:
            if _arm64_is_any_branch(word):
                skipping = False
            continue
        if _arm64_ret(word):
            skipping = True
            continue
        # STRB wzr, [sp, #n] — terminator
        sb = _arm64_strb_imm(word)
        if sb and _arm64_is_stack_base(sb[1]) and sb[0] == 31:
            rel = sb[2] - stack_off
            if 0 <= rel <= 80:
                written[rel] = 0
                saw_nul = True
            continue
        # STR/STUR Xt/Wt of an immediate or copied qword
        store = (
            _arm64_mem_uoff64(word, load=False)
            or _arm64_mem_unscaled64(word, load=False)
            or _arm64_str_imm32(word)
            or _arm64_stur_imm32(word)
        )
        if not store or not _arm64_is_stack_base(store[1]):
            continue
        rel = store[2] - stack_off
        if rel < -8 or rel > 80:
            continue
        src = _arm64_trace(blob, taddr, fn_off, off, store[0])
        if src is None:
            continue
        chunk = b""
        if src.kind == "imm":
            chunk = _arm64_imm_bytes(src.value)
        elif src.kind == "lit":
            foff = _macho_vm_to_file(mo, src.value)
            if foff is not None:
                # 4 or 8 bytes depending on store width; take 8 and trim later
                chunk = data[foff : foff + 8]
        if not chunk:
            continue
        width = 4 if (word & 0xFFC00000) in (0xB9000000,) or (
            word & 0xFFE00C00
        ) == 0xB8000000 else 8
        for i, b in enumerate(chunk[:width]):
            if rel + i >= 0:
                written[rel + i] = b
                if b == 0:
                    saw_nul = True
        if len(written) >= 80:
            break
    if not written:
        return None
    # Assemble from offset 0 until NUL or gap
    out = []
    for i in range(0, 81):
        if i not in written:
            if saw_nul and out:
                break
            if i == 0:
                return None
            break
        if written[i] == 0:
            break
        if not (32 <= written[i] < 127):
            return None
        out.append(chr(written[i]))
    if not out:
        return None
    name = "".join(out)
    # Stack peels must look like env names. A lone movz of HOME is "HO".
    if not (
        is_valid_env_token(name)
        or name in LIBC_ENV
        or name in BARE_APP
        or is_runtime_family(name)
    ):
        return None
    return name


def _arm64_cstring_helper(
    blob: bytes,
    taddr: int,
    fn_off: int,
    fn_end: int,
    getenv_callees: dict[int, _Callee],
    memcpy_vas: set[int],
) -> tuple[int, int] | None:
    """If fn memcpy's (ARGptr, ARGlen) onto the stack and getenv's it, return (ptr_arg, len_arg)."""
    if fn_end <= fn_off or fn_end - fn_off > 4096:
        fn_end = min(fn_off + 2048, len(blob))
    memcpy_offs: list[int] = []
    getenv_offs: list[tuple[int, _Callee]] = []
    for i in range(fn_off, min(fn_end, len(blob) - 3), 4):
        word = struct.unpack_from("<I", blob, i)[0]
        tgt = _arm64_bl_target(word, taddr + i)
        if tgt is None:
            continue
        if tgt in memcpy_vas:
            memcpy_offs.append(i)
        callee = getenv_callees.get(tgt)
        if callee is not None and callee.how != "CString":
            getenv_offs.append((i, callee))
    for goff, callee in getenv_offs:
        gorig = _arm64_trace(blob, taddr, fn_off, goff, callee.arg)
        if gorig is None or gorig.kind != "stack":
            continue
        for moff in memcpy_offs:
            if moff >= goff:
                continue
            dest = _arm64_trace(blob, taddr, fn_off, moff, 0)
            src = _arm64_trace(blob, taddr, fn_off, moff, 1)
            n = _arm64_trace(blob, taddr, fn_off, moff, 2)
            if (
                dest
                and dest.kind == "stack"
                and dest.offset == gorig.offset
                and src
                and src.kind == "arg"
                and n
                and n.kind == "arg"
                and src.reg != n.reg
                and 0 <= src.reg <= 7
                and 0 <= n.reg <= 7
            ):
                return src.reg, n.reg
    return None


def xref_macho_arm64(mo: _MachO, targets: dict[int, str]) -> list[tuple[str, str, int]]:
    text = next((s for s in mo.sects if s.sn == "__text"), None)
    if text is None or text.size <= 0:
        return []
    if text.off + text.size > len(mo.data):
        return []
    blob = mo.data[text.off : text.off + text.size]
    taddr = text.addr
    funcs = _arm64_func_starts(mo, text, blob, taddr)
    memcpy_vas = _macho_memcpy_targets(mo)
    bls: list[tuple[int, int]] = []
    for i in range(0, len(blob) - 3, 4):
        word = struct.unpack_from("<I", blob, i)[0]
        tgt = _arm64_bl_target(word, taddr + i)
        if tgt is not None:
            bls.append((i, tgt))

    callees: dict[int, _Callee] = {
        va: _Callee(how=kind) for va, kind in targets.items()
    }
    hits: list[tuple[str, str, int]] = []

    def recover(off: int, callee: _Callee) -> str | None:
        fn = _containing_func(funcs, taddr + off)
        window = 48
        if fn is not None:
            max_back = (off - (fn[0] - taddr)) // 4
            window = max(1, min(48, max_back))
        regs = _arm64_recover_regs(blob, taddr, off, window=window)
        return _name_from_regs(
            mo.data,
            mo,
            regs,
            callee.how,
            arg=callee.arg,
            offset=callee.offset,
            len_arg=callee.len_arg,
        )

    def recover_stack(off: int, callee: _Callee) -> str | None:
        fn = _containing_func(funcs, taddr + off)
        if fn is None:
            return None
        fn_off = fn[0] - taddr
        if fn_off < 0 or fn_off >= off:
            return None
        orig = _arm64_trace(blob, taddr, fn_off, off, callee.arg)
        if orig is None or orig.kind != "stack":
            return None
        return _arm64_stack_cstr(
            blob, taddr, fn_off, off, orig.offset, mo, mo.data
        )

    # Direct getenv / env::var + discover one-hop wrappers.
    for off, tgt in bls:
        callee = callees.get(tgt)
        if callee is None or callee.how in {"wrapper", "CString"}:
            continue
        name = recover(off, callee)
        if not name:
            name = recover_stack(off, callee)
        if name:
            hits.append((name, callee.how, taddr + off))
        fn = _containing_func(funcs, taddr + off)
        if fn is None:
            continue
        fn_va, fn_name = fn
        if fn_va in callees:
            continue
        fn_off = fn_va - taddr
        if fn_off < 0 or fn_off >= off:
            continue
        got = _arm64_arg_to_x0(blob, taddr, fn_off, off)
        if got is None:
            continue
        arg, offset = got
        callees[fn_va] = _Callee("wrapper", arg, offset, fn_name)

    # CString-from-(ptr,len) that feeds getenv or a wrapper.
    fn_index = {va: i for i, (va, _n) in enumerate(funcs)}
    seen_cstr: set[int] = set()
    for off, tgt in bls:
        callee = callees.get(tgt)
        if callee is None or callee.how == "CString":
            continue
        fn = _containing_func(funcs, taddr + off)
        if fn is None or fn[0] in callees or fn[0] in seen_cstr:
            continue
        fn_va, fn_name = fn
        seen_cstr.add(fn_va)
        idx = fn_index.get(fn_va, -1)
        nxt = funcs[idx + 1][0] if 0 <= idx + 1 < len(funcs) else taddr + len(blob)
        fn_off = fn_va - taddr
        fn_end = min(nxt - taddr, fn_off + 2048)
        got = _arm64_cstring_helper(
            blob, taddr, fn_off, fn_end, callees, memcpy_vas
        )
        if got is None:
            continue
        ptr_arg, len_arg = got
        callees[fn_va] = _Callee(
            "CString", ptr_arg, 0, fn_name or "CString", len_arg=len_arg
        )

    for off, tgt in bls:
        callee = callees.get(tgt)
        if callee is None or callee.how not in {"wrapper", "CString"}:
            continue
        name = recover(off, callee)
        if not name:
            name = recover_stack(off, callee)
        if name:
            if callee.how == "wrapper":
                how = callee.symbol or "wrapper"
            else:
                how = "CString"
            hits.append((name, how, taddr + off))
    return hits


def macho_wrappers_arm64(
    mo: _MachO, targets: dict[int, str]
) -> list[tuple[int, int, int, str]]:
    """Return (func_va, arg, offset, symbol) for one-hop getenv wrappers."""
    text = next((s for s in mo.sects if s.sn == "__text"), None)
    if text is None or text.size <= 0 or text.off + text.size > len(mo.data):
        return []
    blob = mo.data[text.off : text.off + text.size]
    taddr = text.addr
    funcs = _arm64_func_starts(mo, text, blob, taddr)
    found: dict[int, tuple[int, int, int, str]] = {}
    for i in range(0, len(blob) - 3, 4):
        word = struct.unpack_from("<I", blob, i)[0]
        tgt = _arm64_bl_target(word, taddr + i)
        if tgt is None or tgt not in targets:
            continue
        fn = _containing_func(funcs, taddr + i)
        if fn is None or fn[0] in targets or fn[0] in found:
            continue
        fn_va, fn_name = fn
        fn_off = fn_va - taddr
        if fn_off < 0 or fn_off >= i:
            continue
        got = _arm64_arg_to_x0(blob, taddr, fn_off, i)
        if got is None:
            continue
        arg, offset = got
        found[fn_va] = (fn_va, arg, offset, fn_name)
    return [found[k] for k in sorted(found)]


def _name_from_regs(
    data: bytes,
    mo: _MachO,
    regs: dict[int, int],
    kind: str,
    *,
    arg: int = 0,
    offset: int = 0,
    len_arg: int | None = None,
) -> str | None:
    ptr = regs.get(arg)
    if ptr is None:
        return None
    ptr += offset
    foff = _macho_vm_to_file(mo, ptr)
    if foff is None:
        return None
    if kind.startswith("env::var") or kind == "CString":
        ln_reg = 1 if len_arg is None else len_arg
        ln = regs.get(ln_reg)
        if ln is not None and 1 <= ln <= 80:
            got = _read_ascii(data, foff, ln)
            if got:
                return got
        # packed rust literals are not NUL-terminated; do not walk on
        return None
    return _read_cstr(data, foff)


def _x64_arg_to_rdi(blob: bytes, fn_off: int, call_off: int) -> tuple[int, int] | None:
    """If rdi at call is ARG[k]+offset, return (k, offset). Linear, few patterns."""
    if call_off <= fn_off or (call_off - fn_off) > 2048:
        return None
    # rdi starts as ARG0. Track which arg register currently lives in rdi.
    src = 0
    offset = 0
    killed = False
    i = fn_off
    while i < call_off:
        # lea rdi, [rip+disp] — a literal, not an argument
        if (
            i + 7 <= call_off
            and blob[i] == 0x48
            and blob[i + 1] == 0x8D
            and (blob[i + 2] & 0xC7) == 0x05
            and ((blob[i + 2] >> 3) & 7) == 7
        ):
            killed = True
            i += 7
            continue
        # lea rdi, [r64+disp8]  48 8d 7x disp8  (mod=01, reg=rdi=111)
        if (
            i + 4 <= call_off
            and blob[i] == 0x48
            and blob[i + 1] == 0x8D
            and (blob[i + 2] & 0xF8) == 0x78
        ):
            rm = blob[i + 2] & 7
            disp = struct.unpack_from("<b", blob, i + 3)[0]
            rm_to_arg = {7: 0, 6: 1, 2: 2, 1: 3}  # rdi,rsi,rdx,rcx
            if rm in rm_to_arg and 0 <= disp <= 32:
                src = rm_to_arg[rm]
                offset = disp
                killed = False
            else:
                killed = True
            i += 4
            continue
        # mov rdi, r64 : 48 89 /r  (mod=11, reg=src, rm=rdi=111)
        if i + 3 <= call_off and blob[i] == 0x48 and blob[i + 1] == 0x89:
            modrm = blob[i + 2]
            if (modrm & 0xC7) == 0xC7:
                src_reg = (modrm >> 3) & 7
                reg_to_arg = {7: 0, 6: 1, 2: 2, 1: 3}
                if src_reg in reg_to_arg:
                    src = reg_to_arg[src_reg]
                    offset = 0
                    killed = False
                else:
                    killed = True
                i += 3
                continue
        i += 1
    if killed:
        return None
    return src, offset


def xref_macho_x64(mo: _MachO, targets: dict[int, str]) -> list[tuple[str, str, int]]:
    text = next((s for s in mo.sects if s.sn == "__text"), None)
    if text is None or text.size <= 0 or text.off + text.size > len(mo.data):
        return []
    blob = mo.data[text.off : text.off + text.size]
    taddr = text.addr
    funcs = _macho_text_funcs(mo, text)
    calls: list[tuple[int, int]] = []
    n = len(blob)
    i = 0
    while i < n - 4:
        if blob[i] != 0xE8:
            i += 1
            continue
        rel = struct.unpack_from("<i", blob, i + 1)[0]
        tgt = taddr + i + 5 + rel
        calls.append((i, tgt))
        i += 5

    callees: dict[int, _Callee] = {va: _Callee(how=kind) for va, kind in targets.items()}
    hits: list[tuple[str, str, int]] = []

    def recover(off: int, callee: _Callee) -> str | None:
        return _x64_recover_name(
            mo, blob, taddr, off, callee.how, arg=callee.arg, offset=callee.offset
        )

    for off, tgt in calls:
        callee = callees.get(tgt)
        if callee is None or callee.how == "wrapper":
            continue
        name = recover(off, callee)
        if name:
            hits.append((name, callee.how, taddr + off))
        fn = _containing_func(funcs, taddr + off)
        if fn is None or fn[0] in callees:
            continue
        fn_va, fn_name = fn
        fn_off = fn_va - taddr
        if fn_off < 0 or fn_off >= off:
            continue
        got = _x64_arg_to_rdi(blob, fn_off, off)
        if got is None:
            continue
        arg, offset = got
        callees[fn_va] = _Callee("wrapper", arg, offset, fn_name)

    for off, tgt in calls:
        callee = callees.get(tgt)
        if callee is None or callee.how != "wrapper":
            continue
        name = recover(off, callee)
        if name:
            how = callee.symbol or "wrapper"
            hits.append((name, how, taddr + off))
    return hits


def macho_wrappers_x64(
    mo: _MachO, targets: dict[int, str]
) -> list[tuple[int, int, int, str]]:
    text = next((s for s in mo.sects if s.sn == "__text"), None)
    if text is None or text.size <= 0 or text.off + text.size > len(mo.data):
        return []
    blob = mo.data[text.off : text.off + text.size]
    taddr = text.addr
    funcs = _macho_text_funcs(mo, text)
    found: dict[int, tuple[int, int, int, str]] = {}
    n = len(blob)
    i = 0
    while i < n - 4:
        if blob[i] != 0xE8:
            i += 1
            continue
        rel = struct.unpack_from("<i", blob, i + 1)[0]
        tgt = taddr + i + 5 + rel
        if tgt in targets:
            fn = _containing_func(funcs, taddr + i)
            if fn is not None and fn[0] not in targets and fn[0] not in found:
                fn_va, fn_name = fn
                fn_off = fn_va - taddr
                if 0 <= fn_off < i:
                    got = _x64_arg_to_rdi(blob, fn_off, i)
                    if got is not None:
                        arg, offset = got
                        found[fn_va] = (fn_va, arg, offset, fn_name)
        i += 5
    return [found[k] for k in sorted(found)]


def _x64_recover_name(
    mo: _MachO,
    blob: bytes,
    taddr: int,
    call_off: int,
    kind: str,
    *,
    arg: int = 0,
    offset: int = 0,
) -> str | None:
    """Look back ~64 bytes for `lea r64, [rip+disp]` into the wrapper's arg reg."""
    # arg 0=rdi, 1=rsi, 2=rdx, 3=rcx
    want = {0: 7, 1: 6, 2: 2, 3: 1}.get(arg, 7)
    start = max(0, call_off - 64)
    ptr = None
    rsi = None
    window = blob[start:call_off]
    j = 0
    while j < len(window) - 6:
        # REX.W lea r/m: 48 8d …
        if window[j] == 0x48 and window[j + 1] == 0x8D:
            modrm = window[j + 2]
            # RIP-relative: mod=00, rm=101
            if (modrm & 0xC7) == 0x05 and j + 7 <= len(window):
                disp = struct.unpack_from("<i", window, j + 3)[0]
                insn_va = taddr + start + j
                val = insn_va + 7 + disp
                reg = (modrm >> 3) & 7
                if reg == want:
                    ptr = val
                elif reg == 6:
                    rsi = val
                j += 7
                continue
        # mov esi, imm32 :  be imm32
        if window[j] == 0xBE and j + 5 <= len(window):
            rsi = struct.unpack_from("<I", window, j + 1)[0]
            j += 5
            continue
        j += 1
    if ptr is None:
        return None
    ptr += offset
    foff = _macho_vm_to_file(mo, ptr)
    if foff is None:
        return None
    if kind.startswith("env::var"):
        if isinstance(rsi, int) and 1 <= rsi <= 80:
            return _read_ascii(mo.data, foff, rsi)
        return None
    return _read_cstr(mo.data, foff)


def xref_macho(data: bytes) -> list[tuple[str, str, int]]:
    mo = parse_macho(data)
    if mo is None:
        return []
    targets = _macho_getenv_targets(mo)
    if not targets:
        return []
    if mo.cputype == CPU_TYPE_ARM64:
        return xref_macho_arm64(mo, targets)
    if mo.cputype == CPU_TYPE_X86_64:
        return xref_macho_x64(mo, targets)
    return []


def macho_cstrings_arm64(
    mo: _MachO, targets: dict[int, str]
) -> list[tuple[int, int, int, str]]:
    """Return (func_va, ptr_arg, len_arg, symbol) for CString→getenv helpers."""
    text = next((s for s in mo.sects if s.sn == "__text"), None)
    if text is None or text.size <= 0 or text.off + text.size > len(mo.data):
        return []
    blob = mo.data[text.off : text.off + text.size]
    taddr = text.addr
    funcs = _arm64_func_starts(mo, text, blob, taddr)
    memcpy_vas = _macho_memcpy_targets(mo)
    if not memcpy_vas:
        return []
    callees: dict[int, _Callee] = {
        va: _Callee(how=kind) for va, kind in targets.items()
    }
    bls: list[tuple[int, int]] = []
    for i in range(0, len(blob) - 3, 4):
        word = struct.unpack_from("<I", blob, i)[0]
        tgt = _arm64_bl_target(word, taddr + i)
        if tgt is not None:
            bls.append((i, tgt))
    for off, tgt in bls:
        if tgt not in targets:
            continue
        fn = _containing_func(funcs, taddr + off)
        if fn is None or fn[0] in callees:
            continue
        fn_off = fn[0] - taddr
        if fn_off < 0 or fn_off >= off:
            continue
        got = _arm64_arg_to_x0(blob, taddr, fn_off, off)
        if got is None:
            continue
        arg, offset = got
        callees[fn[0]] = _Callee("wrapper", arg, offset, fn[1])
    fn_index = {va: i for i, (va, _n) in enumerate(funcs)}
    found: dict[int, tuple[int, int, int, str]] = {}
    seen: set[int] = set()
    for off, tgt in bls:
        if tgt not in callees:
            continue
        fn = _containing_func(funcs, taddr + off)
        if fn is None or fn[0] in callees or fn[0] in seen:
            continue
        fn_va, fn_name = fn
        seen.add(fn_va)
        idx = fn_index.get(fn_va, -1)
        nxt = funcs[idx + 1][0] if 0 <= idx + 1 < len(funcs) else taddr + len(blob)
        fn_off = fn_va - taddr
        fn_end = min(nxt - taddr, fn_off + 2048)
        got = _arm64_cstring_helper(
            blob, taddr, fn_off, fn_end, callees, memcpy_vas
        )
        if got is None:
            continue
        ptr_arg, len_arg = got
        found[fn_va] = (fn_va, ptr_arg, len_arg, fn_name or "CString")
    return [found[k] for k in sorted(found)]


def macho_wrappers(data: bytes) -> list[tuple[int, int, int, str]]:
    mo = parse_macho(data)
    if mo is None:
        return []
    targets = _macho_getenv_targets(mo)
    if not targets:
        return []
    if mo.cputype == CPU_TYPE_ARM64:
        return macho_wrappers_arm64(mo, targets)
    if mo.cputype == CPU_TYPE_X86_64:
        return macho_wrappers_x64(mo, targets)
    return []


# ELF (ET_DYN / ET_EXEC), little-endian 64-bit.

SHT_SYMTAB = 2
SHT_DYNSYM = 11
SHT_STRTAB = 3
SHT_RELA = 4
STT_FUNC = 2
R_X86_64_JUMP_SLOT = 7
R_AARCH64_JUMP_SLOT = 1026


def parse_elf64_le(data: bytes) -> tuple[int, list[tuple], list[tuple], int] | None:
    """e_machine, sections[(name,type,addr,off,size,link,entsize)],
    no full struct — returns (machine, shdrs, names via shstrndx)."""
    if len(data) < 64 or data[:4] != ELF_MAGIC:
        return None
    if data[4] != 2 or data[5] != 1:  # 64-bit LE
        return None
    e_machine = struct.unpack_from("<H", data, 18)[0]
    e_shoff = struct.unpack_from("<Q", data, 40)[0]
    e_shentsize = struct.unpack_from("<H", data, 58)[0]
    e_shnum = struct.unpack_from("<H", data, 60)[0]
    e_shstrndx = struct.unpack_from("<H", data, 62)[0]
    if e_shentsize < 64 or e_shnum == 0 or e_shnum > 10_000:
        return None
    if e_shoff + e_shnum * e_shentsize > len(data):
        return None
    shdrs = []
    for i in range(e_shnum):
        o = e_shoff + i * e_shentsize
        sh_name, sh_type = struct.unpack_from("<II", data, o)
        sh_addr, sh_off, sh_size = struct.unpack_from("<QQQ", data, o + 16)
        sh_link = struct.unpack_from("<I", data, o + 40)[0]
        sh_entsize = struct.unpack_from("<Q", data, o + 56)[0]
        shdrs.append((sh_name, sh_type, sh_addr, sh_off, sh_size, sh_link, sh_entsize))
    if e_shstrndx >= len(shdrs):
        return None
    _, _, _, stroff, strsz, _, _ = shdrs[e_shstrndx]
    return e_machine, shdrs, (stroff, strsz), e_shstrndx


def _elf_sec_name(data: bytes, stroff: int, strsz: int, name_off: int) -> str:
    start = stroff + name_off
    end = data.find(b"\0", start, stroff + strsz)
    if end < 0:
        return ""
    return data[start:end].decode("ascii", "replace")


def xref_elf(data: bytes) -> list[tuple[str, str, int]]:
    parsed = parse_elf64_le(data)
    if parsed is None:
        return []
    e_machine, shdrs, (stroff, strsz), _ = parsed
    named = []
    for i, sh in enumerate(shdrs):
        named.append((_elf_sec_name(data, stroff, strsz, sh[0]), i, sh))

    def sec(name: str):
        for n, i, sh in named:
            if n == name:
                return sh
        return None

    dynsym = next((sh for n, i, sh in named if sh[1] == SHT_DYNSYM), None)
    if dynsym is None:
        return []
    _n, stype, saddr, soff, ssize, slink, entsize = dynsym
    if slink >= len(shdrs) or entsize not in (0, 24):
        return []
    entsize = 24
    strtab = shdrs[slink]
    _, _, _, str_off, str_sz, _, _ = strtab
    nsym = ssize // entsize
    if nsym > 1_000_000:
        return []
    getenv_syms: dict[int, str] = {}  # dynsym index → kind
    getenv_va: dict[int, str] = {}
    for i in range(nsym):
        o = soff + i * entsize
        st_name, st_info, _st_other, _st_shndx, st_value, _st_size = struct.unpack_from(
            "<IBBHQQ", data, o
        )
        start = str_off + st_name
        if start >= str_off + str_sz:
            continue
        end = data.find(b"\0", start, min(start + 256, str_off + str_sz))
        if end < 0:
            continue
        name = data[start:end].decode("ascii", "replace")
        kind = getenv_sym_kind(name) or getenv_sym_kind("_" + name)
        if kind:
            getenv_syms[i] = kind
            if st_value:
                getenv_va[st_value] = kind

    # PLT via RELA
    plt_targets: dict[int, str] = {}
    for n, i, sh in named:
        if sh[1] != SHT_RELA:
            continue
        _n, _t, _a, roff, rsize, rlink, rentsz = sh
        if rentsz not in (0, 24):
            continue
        rentsz = 24
        nrel = rsize // rentsz
        if nrel > 500_000:
            continue
        for j in range(nrel):
            o = roff + j * rentsz
            r_offset, r_info, _addend = struct.unpack_from("<QQq", data, o)
            r_type = r_info & 0xFFFFFFFF
            r_sym = r_info >> 32
            if r_sym in getenv_syms and r_type in (
                R_X86_64_JUMP_SLOT,
                R_AARCH64_JUMP_SLOT,
                0,
            ):
                plt_targets[r_offset] = getenv_syms[r_sym]
            # Some linkers put JUMP_SLOT against .got.plt; call sites hit .plt
    # Map .plt entries: each 16-byte slot after the header often corresponds
    # to reloc order. Also accept direct calls to defined getenv_va.

    plt = sec(".plt") or sec(".plt.got") or sec(".plt.sec")
    text = sec(".text")
    if text is None:
        return []
    _, _, taddr, toff, tsize, _, _ = text
    if toff + tsize > len(data) or tsize <= 0:
        return []
    blob = data[toff : toff + tsize]
    targets = dict(getenv_va)
    # Heuristic: .rela.plt order matches .plt slots of 16 bytes, skip first.
    rela_plt = sec(".rela.plt")
    if plt is not None and rela_plt is not None:
        _n, _t, plt_addr, plt_off, plt_size, _, _ = plt
        _n, _t, _a, roff, rsize, _l, rentsz = rela_plt
        rentsz = 24 if rentsz in (0, 24) else rentsz
        nrel = rsize // rentsz if rentsz else 0
        slot = 16
        # skip PLT0 (16 or 32 bytes)
        for hdr in (32, 16):
            if plt_size >= hdr + nrel * slot:
                for j in range(nrel):
                    o = roff + j * rentsz
                    _r_offset, r_info, _add = struct.unpack_from("<QQq", data, o)
                    r_sym = r_info >> 32
                    if r_sym in getenv_syms:
                        targets[plt_addr + hdr + j * slot] = getenv_syms[r_sym]
                break

    hits: list[tuple[str, str, int]] = []
    if e_machine == 183:  # EM_AARCH64

        def elf_vm_to_file(vm: int) -> int | None:
            for _n, i, sh in named:
                _nm, _t, addr, off, size, _l, _e = sh
                if addr and size and addr <= vm < addr + size:
                    return off + (vm - addr)
            return None

        funcs: list[tuple[int, str]] = []
        for _n, _i, sh in named:
            if sh[1] not in (SHT_SYMTAB, SHT_DYNSYM):
                continue
            _nm, _t, _a, soff2, ssize2, slink2, entsz2 = sh
            if slink2 >= len(shdrs):
                continue
            entsz2 = 24 if entsz2 in (0, 24) else entsz2
            if entsz2 != 24 or ssize2 // entsz2 > 1_000_000:
                continue
            strtab2 = shdrs[slink2]
            _, _, _, str_off2, str_sz2, _, _ = strtab2
            for si in range(ssize2 // entsz2):
                o = soff2 + si * entsz2
                st_name, st_info, _o, _shndx, st_value, _sz = struct.unpack_from(
                    "<IBBHQQ", data, o
                )
                if (st_info & 0xF) != STT_FUNC or not st_value:
                    continue
                if not (taddr <= st_value < taddr + tsize):
                    continue
                s0 = str_off2 + st_name
                s1 = data.find(b"\0", s0, min(s0 + 256, str_off2 + str_sz2))
                nm = data[s0:s1].decode("ascii", "replace") if s1 > s0 else ""
                funcs.append((st_value, nm))
        funcs.sort()

        callees: dict[int, _Callee] = {
            va: _Callee(how=kind) for va, kind in targets.items()
        }
        bls: list[tuple[int, int]] = []
        for i in range(0, len(blob) - 3, 4):
            word = struct.unpack_from("<I", blob, i)[0]
            tgt = _arm64_bl_target(word, taddr + i)
            if tgt is not None:
                bls.append((i, tgt))

        def recover_elf(off: int, callee: _Callee) -> str | None:
            regs = _arm64_recover_regs(blob, taddr, off, window=48)
            ptr = regs.get(callee.arg)
            if ptr is None:
                return None
            ptr += callee.offset
            foff = elf_vm_to_file(ptr)
            if foff is None:
                return None
            if callee.how.startswith("env::var") or callee.how == "CString":
                ln_reg = 1 if callee.len_arg is None else callee.len_arg
                ln = regs.get(ln_reg)
                return _read_ascii(data, foff, ln) if ln else None
            return _read_cstr(data, foff)

        memcpy_vas: set[int] = set()
        for va, kind in targets.items():
            # ELF memcpy is not in getenv targets; leave empty unless we mapped it.
            del kind, va

        for off, tgt in bls:
            callee = callees.get(tgt)
            if callee is None or callee.how in {"wrapper", "CString"}:
                continue
            name = recover_elf(off, callee)
            if name:
                hits.append((name, callee.how, taddr + off))
            fn = _containing_func(funcs, taddr + off)
            if fn is None or fn[0] in callees:
                continue
            fn_va, fn_name = fn
            fn_off = fn_va - taddr
            if fn_off < 0 or fn_off >= off:
                continue
            got = _arm64_arg_to_x0(blob, taddr, fn_off, off)
            if got is None:
                continue
            arg, offset = got
            callees[fn_va] = _Callee("wrapper", arg, offset, fn_name)

        # CString hop when memcpy PLT is known via a symbol named memcpy.
        for n, _i, sh in named:
            if "memcpy" in n or n.endswith("memcpy"):
                pass
        for va, name in getenv_va.items():
            if _is_memcpy_sym(name):
                memcpy_vas.add(va)
        for va, kind in list(targets.items()):
            if kind == "memcpy":
                memcpy_vas.add(va)

        fn_index = {va: i for i, (va, _n) in enumerate(funcs)}
        seen_cstr: set[int] = set()
        for off, tgt in bls:
            callee = callees.get(tgt)
            if callee is None or callee.how == "CString":
                continue
            fn = _containing_func(funcs, taddr + off)
            if fn is None or fn[0] in callees or fn[0] in seen_cstr:
                continue
            fn_va, fn_name = fn
            seen_cstr.add(fn_va)
            if not memcpy_vas:
                continue
            idx = fn_index.get(fn_va, -1)
            nxt = funcs[idx + 1][0] if 0 <= idx + 1 < len(funcs) else taddr + tsize
            fn_off = fn_va - taddr
            fn_end = min(nxt - taddr, fn_off + 2048)
            got = _arm64_cstring_helper(
                blob, taddr, fn_off, fn_end, callees, memcpy_vas
            )
            if got is None:
                continue
            ptr_arg, len_arg = got
            callees[fn_va] = _Callee(
                "CString", ptr_arg, 0, fn_name or "CString", len_arg=len_arg
            )

        for off, tgt in bls:
            callee = callees.get(tgt)
            if callee is None or callee.how not in {"wrapper", "CString"}:
                continue
            name = recover_elf(off, callee)
            if name:
                how = (
                    (callee.symbol or "wrapper")
                    if callee.how == "wrapper"
                    else "CString"
                )
                hits.append((name, how, taddr + off))
        return hits

    if e_machine == 62:  # EM_X86_64
        def elf_vm_to_file(vm: int) -> int | None:
            for _n, i, sh in named:
                _nm, _t, addr, off, size, _l, _e = sh
                if addr and size and addr <= vm < addr + size:
                    return off + (vm - addr)
            return None

        n = len(blob)
        i = 0
        while i < n - 4:
            if blob[i] != 0xE8:
                i += 1
                continue
            rel = struct.unpack_from("<i", blob, i + 1)[0]
            pc = taddr + i
            tgt = pc + 5 + rel
            if tgt in targets:
                kind = targets[tgt]
                start = max(0, i - 48)
                window = blob[start:i]
                rdi = None
                rsi = None
                j = 0
                while j < len(window) - 6:
                    if window[j] == 0x48 and window[j + 1] == 0x8D:
                        modrm = window[j + 2]
                        if (modrm & 0xC7) == 0x05 and j + 7 <= len(window):
                            disp = struct.unpack_from("<i", window, j + 3)[0]
                            insn_va = taddr + start + j
                            val = insn_va + 7 + disp
                            reg = (modrm >> 3) & 7
                            if reg == 7:
                                rdi = val
                            elif reg == 6:
                                rsi = val
                            j += 7
                            continue
                    if window[j] == 0xBE and j + 5 <= len(window):
                        rsi = struct.unpack_from("<I", window, j + 1)[0]
                        j += 5
                        continue
                    j += 1
                if rdi is not None:
                    foff = elf_vm_to_file(rdi)
                    if foff is not None:
                        if kind.startswith("env::var") and isinstance(rsi, int) and 1 <= rsi <= 80:
                            name = _read_ascii(data, foff, rsi)
                        else:
                            name = _read_cstr(data, foff)
                        if name:
                            hits.append((name, kind, pc))
                i += 5
                continue
            i += 1
        return hits
    return hits


def extract_getenv_xrefs(path: Path, data: bytes) -> list[tuple[str, str, int]]:
    """Return (name, how, call_va) for getenv-shaped uses in a load image."""
    if data[:4] in MACH_O_MAGICS:
        slice_ = macho_native_slice(data)
        return xref_macho(slice_)
    if data[:4] == ELF_MAGIC:
        return xref_elf(data)
    return []


def extract_wrappers(path: Path, data: bytes) -> list[tuple[int, int, int, str]]:
    """Return (func_va, arg, offset, symbol) for one-hop getenv wrappers."""
    if data[:4] in MACH_O_MAGICS:
        return macho_wrappers(macho_native_slice(data))
    return []


def extract_cstrings(path: Path, data: bytes) -> list[tuple[int, int, int, str]]:
    """Return (func_va, ptr_arg, len_arg, symbol) for CString→getenv helpers."""
    if data[:4] in MACH_O_MAGICS:
        slice_ = macho_native_slice(data)
        mo = parse_macho(slice_)
        if mo is None or mo.cputype != CPU_TYPE_ARM64:
            return []
        targets = _macho_getenv_targets(mo)
        if not targets:
            return []
        return macho_cstrings_arm64(mo, targets)
    return []


def extract_binary(
    path: Path,
    needles: Iterable[str] | None = None,
    *,
    loose: bool = False,
) -> list[Need]:
    try:
        raw = path.read_bytes()
    except OSError:
        return []
    # Prefer the native slice so xref and the string harvest see one image.
    data = macho_native_slice(raw) if raw[:4] in MACH_O_MAGICS else raw
    found: dict[str, Need] = {}
    prefixes = env_prefixes(needles)

    def add(text: str, detail: str, evidence: str = "string") -> None:
        n = _need(text, evidence, str(path), detail)
        if not n:
            return
        cur = found.get(text)
        if cur is None:
            found[text] = n
            return
        hows = cur.hows | n.hows
        if EVIDENCE_RANK.get(evidence, 0) > EVIDENCE_RANK.get(cur.evidence, 0):
            ev = evidence
            src = n.source
        else:
            ev = cur.evidence
            src = cur.source
        # Prefer a getenv-shaped how as the display detail when mixed.
        if cur.detail in DOC_HOWS and detail not in DOC_HOWS:
            show = detail
        elif detail in DOC_HOWS and cur.detail not in DOC_HOWS:
            show = cur.detail
        elif evidence == "call" and cur.evidence != "call":
            show = detail
        else:
            show = cur.detail
        extra = "+".join(sorted(hows))
        found[text] = Need(cur.name, ev, src, extra or show, hows)

    for name, how, _va in extract_getenv_xrefs(path, raw):
        if ENV_NAME_RE.match(name):
            add(name, how, "call")
            # One-hop wrapper: keep a generic how so KIND/filter stay stable
            # even when --calls names the wrapper symbol.
            if how not in {
                "getenv",
                "secure_getenv",
                "std::getenv",
                "env::var",
                "env::var_os",
                "wrapper",
                "CString",
            } and "getenv" not in how.lower() and not how.startswith("env::"):
                add(name, "wrapper", "call")

    for tok, how in extract_doc_env_tokens(data):
        add(tok, how)

    # Packed / prefix / isolated cstring: --loose search aid, not KIND.
    if loose:
        for chunk in data.split(b"\0"):
            if not (3 <= len(chunk) <= 80):
                continue
            if not all(32 <= b < 127 for b in chunk):
                continue
            text = chunk.decode("ascii")
            assign = CSTRING_ASSIGN_RE.match(text.strip())
            if assign:
                add(assign.group(1), "cstring-assign")
            if is_valid_env_token(text) or text in LIBC_ENV or text in BARE_APP:
                add(text, "cstring")
            else:
                for tok in split_packed(text, prefixes):
                    add(tok, "cstring-packed")

        large = len(data) >= LARGE_IMAGE_BYTES
        if not large:
            for run in PRINTABLE_RUN_RE.finditer(data):
                text = run.group().decode("ascii")
                if is_valid_env_token(text) or text in LIBC_ENV or text in BARE_APP:
                    add(text, "rodata")
                    continue
                for tok in split_packed(text, prefixes):
                    add(tok, "packed")

        for tok in peel_prefix_tokens(data, prefixes):
            add(tok, "prefix")

    if needles:
        for name in needles:
            if name_in_blob(data, name):
                add(name, "needle")
    return list(found.values())


def looks_like_binary_file(path: Path) -> bool:
    if is_macho_or_elf(path):
        return True
    if path.suffix.lower() in {".bin", ".so", ".dylib", ".exe", ".o", ".a", ".dll"}:
        return True
    try:
        chunk = path.read_bytes()[:4096]
    except OSError:
        return False
    return b"\0" in chunk


def extract_file(
    path: Path,
    needles: Iterable[str] | None = None,
    *,
    loose: bool = False,
) -> list[Need]:
    suffix = path.suffix.lower()
    if looks_like_binary_file(path):
        return extract_binary(path, needles, loose=loose)
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    if suffix == ".py" or suffix == ".pyi":
        return extract_python(path, text)
    if suffix in SHELL_SUFFIX or _looks_like_shell(path, text):
        return extract_shell(path, text) + extract_by_regex(path, text, "shell-calls")
    if suffix in SOURCE_SUFFIX:
        return extract_by_regex(path, text, suffix)
    # Shebang scripts without a known suffix.
    if _looks_like_shell(path, text):
        return extract_shell(path, text)
    if text.startswith("#!") and "python" in text.splitlines()[0].lower():
        return extract_python(path, text)
    if is_probably_binary_blob(path):
        return extract_binary(path, needles, loose=loose)
    return extract_by_regex(path, text, "unknown")


def _looks_like_shell(path: Path, text: str) -> bool:
    if path.suffix.lower() in SHELL_SUFFIX:
        return True
    if text.startswith("#!"):
        head = text.splitlines()[0].lower()
        return any(s in head for s in ("bash", "zsh", "ksh", "sh"))
    return False


def is_probably_binary_blob(path: Path) -> bool:
    try:
        st = path.stat()
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    if st.st_mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH):
        try:
            chunk = path.read_bytes()[:4096]
        except OSError:
            return False
        return b"\0" in chunk
    return False


def should_skip_dir(name: str) -> bool:
    return name in SKIP_DIRS or name.startswith(".")


def iter_walk(root: Path) -> Iterator[Path]:
    if root.is_file():
        yield root
        return
    if not root.is_dir():
        return
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not should_skip_dir(d)]
        for fn in filenames:
            if fn.startswith("."):
                # Still allow .env* as env files, not as programs.
                continue
            yield Path(dirpath) / fn


