def load_envs(args: argparse.Namespace) -> tuple[EnvMap | None, EnvMap | None, EnvMap | None]:
    left = load_env_file(Path(args.left)) if args.left else current_env()
    right_path = args.right or args.vs
    right = load_env_file(Path(right_path)) if right_path else None
    if args.vs_pid is not None:
        pid_env = env_from_pid(args.vs_pid)
        if right is None:
            right = pid_env
        else:
            raise ValueError("use only one of --vs/--right and --vs-pid")
    example = load_env_file(Path(args.example)) if args.example else None
    return left, right, example


