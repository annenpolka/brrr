def is_system_install_name(name: str) -> bool:
    text = name.replace("\\", "/")
    for pfx in SYSTEM_IMAGE_PREFIXES:
        if text.startswith(pfx) or text.startswith("/private" + pfx):
            return True
    base = text.rsplit("/", 1)[-1]
    if base in {"libSystem.B.dylib", "libobjc.A.dylib", "libc++.1.dylib", "linux-vdso.so.1"}:
        return True
    return False


def is_system_image(path: Path) -> bool:
    try:
        text = str(path.resolve())
    except OSError:
        text = str(path)
    return is_system_install_name(text)


def parse_otool_L(text: str) -> list[str]:
    names: list[str] = []
    for i, raw in enumerate(text.splitlines()):
        line = raw.strip()
        if not line:
            continue
        if i == 0 and line.endswith(":"):
            continue
        m = re.match(r"^(.+?) \((?:compatibility version|architecture)\b", line)
        if m:
            names.append(m.group(1).strip())
            continue
        if line.startswith(("@", "/")) or ".dylib" in line or ".so" in line:
            names.append(line.split(" (", 1)[0].strip())
    return names


def parse_otool_rpaths(text: str) -> list[str]:
    rpaths: list[str] = []
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if "LC_RPATH" not in line:
            continue
        for j in range(i + 1, min(i + 8, len(lines))):
            m = re.search(r"\bpath\s+(\S+)", lines[j])
            if m:
                rpaths.append(m.group(1))
                break
    return rpaths


def parse_ldd(text: str) -> list[str]:
    out: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        if " => " in line:
            right = line.split(" => ", 1)[1].strip()
            path = right.split(" (", 1)[0].strip()
            if path and path != "not found":
                out.append(path)
        elif line.startswith("/") and ".so" in line:
            out.append(line.split()[0])
    return out


def parse_objdump_dynamic(text: str) -> tuple[list[str], list[str]]:
    needed: list[str] = []
    rpaths: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("NEEDED"):
            needed.append(line.split()[-1])
        elif line.startswith("RPATH") or line.startswith("RUNPATH"):
            val = line.split()[-1]
            rpaths.extend(p for p in val.split(":") if p)
    return needed, rpaths


def _run_tool(argv: list[str], timeout: float = 8.0) -> str:
    try:
        return subprocess.check_output(
            argv, text=True, stderr=subprocess.DEVNULL, timeout=timeout
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return ""


def macho_install_names(path: Path) -> list[str]:
    return parse_otool_L(_run_tool(["otool", "-L", str(path)]))


def macho_rpaths(path: Path) -> list[str]:
    return parse_otool_rpaths(_run_tool(["otool", "-l", str(path)]))


def expand_load_special(spec: str, *, loader: Path, executable: Path) -> str:
    loader_dir = str(loader.parent)
    exec_dir = str(executable.parent)
    return spec.replace("@loader_path", loader_dir).replace(
        "@executable_path", exec_dir
    )


def resolve_load_name(
    name: str,
    *,
    loader: Path,
    executable: Path,
    rpaths: list[str],
) -> Path | None:
    name = name.strip()
    if not name:
        return None
    if name.startswith("@rpath/"):
        rest = name[len("@rpath/") :]
        expanded = [expand_load_special(r, loader=loader, executable=executable) for r in rpaths]
        extra = [
            str(loader.parent),
            str(loader.parent / "lib"),
            str(loader.parent.parent / "lib"),
            str(executable.parent),
            str(executable.parent / "lib"),
            str(executable.parent.parent / "lib"),
        ]
        seen_dir: set[str] = set()
        for rp in expanded + extra:
            if not rp or rp in seen_dir:
                continue
            seen_dir.add(rp)
            cand = Path(rp) / rest
            if cand.is_file():
                return cand.resolve()
        return None

    expanded = expand_load_special(name, loader=loader, executable=executable)
    if expanded.startswith("@rpath/"):
        return resolve_load_name(
            expanded, loader=loader, executable=executable, rpaths=rpaths
        )
    path = Path(expanded)
    if path.is_file():
        return path.resolve()
    rel = loader.parent / name
    if rel.is_file():
        return rel.resolve()
    return None


def elf_needed_and_rpaths(path: Path) -> tuple[list[str], list[str]]:
    ldd = shutil.which("ldd")
    if ldd:
        resolved = parse_ldd(_run_tool([ldd, str(path)]))
        if resolved:
            return resolved, []
    dump = shutil.which("objdump") or shutil.which("llvm-objdump")
    if dump:
        return parse_objdump_dynamic(_run_tool([dump, "-p", str(path)]))
    return [], []


@dataclass
class ImageRow:
    role: str  # main | load | skip | missing
    path: Path | None
    raw: str
    bytes: int = 0


def iter_loaded_images(
    root: Path,
    *,
    system: bool = False,
    closure: bool = False,
    depth: int = 1,
) -> list[ImageRow]:
    """Direct dependents of root (otool -L / ldd). closure=BFS of non-system."""
    root = root.resolve()
    rows: list[ImageRow] = []
    try:
        size = root.stat().st_size
    except OSError:
        size = 0
    rows.append(ImageRow("main", root, str(root), size))
    if not is_macho_or_elf(root):
        return rows

    max_depth = 64 if closure else max(0, depth)
    pending: list[tuple[Path, int]] = [(root, 0)]
    seen: set[Path] = {root}
    listed_raw: set[str] = set()

    while pending:
        current, d = pending.pop(0)
        if d >= max_depth:
            continue
        rpaths = macho_rpaths(current) if is_macho_or_elf(current) else []
        names: list[str] = []
        magic_ok = False
        try:
            with current.open("rb") as fh:
                magic = fh.read(4)
        except OSError:
            magic = b""
        if magic in MACH_O_MAGICS:
            magic_ok = True
            names = macho_install_names(current)
        elif magic == b"\x7fELF":
            magic_ok = True
            needed, elf_rpaths = elf_needed_and_rpaths(current)
            rpaths = list(elf_rpaths) + rpaths
            names = needed
        if not magic_ok:
            continue

        for raw in names:
            if raw in listed_raw:
                continue
            listed_raw.add(raw)
            resolved = resolve_load_name(
                raw, loader=current, executable=root, rpaths=rpaths
            )
            if resolved is None:
                role = "skip" if (not system) and is_system_install_name(raw) else "missing"
                rows.append(ImageRow(role, None, raw, 0))
                continue
            if resolved == root or resolved == current:
                continue
            if resolved in seen:
                continue
            seen.add(resolved)
            try:
                sz = resolved.stat().st_size
            except OSError:
                sz = 0
            skip = (not system) and is_system_image(resolved)
            role = "skip" if skip else "load"
            rows.append(ImageRow(role, resolved, raw, sz))
            if not skip:
                pending.append((resolved, d + 1))
    return rows


def harvest(
    paths: Iterable[Path],
    needles: Iterable[str] | None = None,
    *,
    walk_images: bool = True,
    system: bool = False,
    closure: bool = False,
    depth: int = 1,
    loose: bool = False,
) -> list[Need]:
    acc: list[Need] = []
    needle_list = list(needles) if needles else None
    seen_images: set[Path] = set()

    def add_image_tree(binary: Path) -> None:
        if not walk_images or not is_macho_or_elf(binary):
            return
        for row in iter_loaded_images(
            binary, system=system, closure=closure, depth=depth
        ):
            if row.role != "load" or row.path is None:
                continue
            rp = row.path.resolve()
            if rp in seen_images:
                continue
            seen_images.add(rp)
            acc.extend(extract_file(rp, needle_list, loose=loose))

    for path in paths:
        path = path.resolve()
        seen_images.add(path)
        if path.is_dir():
            for child in iter_walk(path):
                if child.suffix.lower() in SOURCE_SUFFIX or is_macho_or_elf(child):
                    acc.extend(extract_file(child, needle_list, loose=loose))
                    add_image_tree(child)
                elif child.is_file() and os.access(child, os.X_OK):
                    acc.extend(extract_file(child, needle_list, loose=loose))
                    add_image_tree(child)
            continue
        if path.is_file():
            acc.extend(extract_file(path, needle_list, loose=loose))
            add_image_tree(path)
    return merge_needs(acc)


def merge_needs(needs: Iterable[Need]) -> list[Need]:
    best: dict[str, Need] = {}
    extras: dict[str, list[Need]] = defaultdict(list)
    for need in needs:
        cur = best.get(need.name)
        if cur is None:
            best[need.name] = need
            continue
        hows = cur.hows | need.hows
        if EVIDENCE_RANK.get(need.evidence, 0) > EVIDENCE_RANK.get(cur.evidence, 0):
            extras[need.name].append(cur)
            best[need.name] = Need(
                need.name, need.evidence, need.source, need.detail, hows
            )
        else:
            best[need.name] = Need(
                cur.name, cur.evidence, cur.source, cur.detail, hows
            )
            if need.source != cur.source:
                extras[need.name].append(need)
    # Keep the winning row per name; source notes extra loci in detail if few.
    out = []
    for name in sorted(best):
        win = best[name]
        others = extras.get(name, [])
        extra_srcs = sorted({o.source for o in others if o.source != win.source})
        if extra_srcs:
            more = extra_srcs[:3]
            suffix = f" (+{len(extra_srcs)} more)" if extra_srcs[3:] else ""
            detail = win.detail
            extra = ",".join(more) + suffix
            if detail:
                detail = f"{detail}; also {extra}"
            else:
                detail = f"also {extra}"
            win = Need(win.name, win.evidence, win.source, detail, win.hows)
        out.append(win)
    return out


def resolve_program(spec: str) -> Path:
    path = Path(spec)
    if path.exists():
        return path
    found = shutil.which(spec)
    if found:
        return Path(found)
    raise FileNotFoundError(f"not a file, directory, or PATH command: {spec}")


def parse_abi_text(text: str, origin: str) -> list[Need]:
    needs: list[Need] = []
    for i, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("name\t"):
            continue
        parts = line.split("\t")
        name = parts[0].strip()
        idx = 1
        kind_hint = ""
        if len(parts) > 1 and parts[1].strip() in {"DUE", "LATENT", "BOTH"}:
            kind_hint = parts[1].strip()
            idx = 2
        evidence = parts[idx].strip() if len(parts) > idx else "call"
        source = parts[idx + 1].strip() if len(parts) > idx + 1 else origin
        detail = parts[idx + 2].strip() if len(parts) > idx + 2 else "abi"
        hows_s = parts[idx + 3].strip() if len(parts) > idx + 3 else ""
        n = _need(name, evidence or "call", source, detail)
        if n is None and ENV_NAME_RE.match(name):
            n = Need(name, evidence or "call", source, detail)
        if n is None:
            raise ValueError(f"{origin}:{i}: bad ABI name {name!r}")
        if hows_s:
            n.hows = frozenset(h for h in hows_s.split(",") if h)
        elif kind_hint == "LATENT":
            n.hows = frozenset({"help", "string"})
        elif kind_hint == "BOTH":
            n.hows = frozenset({"getenv", "call", "help", "string"})
        elif kind_hint == "DUE":
            n.hows = frozenset({"getenv", "call"})
        needs.append(n)
    return merge_needs(needs)


