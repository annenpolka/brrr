def parse_env_text(text: str, origin: str) -> EnvMap:
    stripped = text.lstrip()
    if stripped.startswith("{"):
        obj = json.loads(text)
        if not isinstance(obj, dict):
            raise ValueError(f"{origin}: JSON env must be an object")
        values = {}
        for key, val in obj.items():
            if not isinstance(key, str) or not ENV_NAME_RE.match(key):
                continue
            if val is None:
                values[key] = ""
            elif isinstance(val, (str, int, float, bool)):
                values[key] = str(val)
        return EnvMap(values, origin)

    values: dict[str, str] = {}
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if "=" not in line:
            continue
        key, _, rest = line.partition("=")
        key = key.strip()
        if not ENV_NAME_RE.match(key):
            continue
        values[key] = _unquote_env_value(rest)
    return EnvMap(values, origin)


def _unquote_env_value(rest: str) -> str:
    s = rest.strip()
    if not s:
        return ""
    if s[0] in {'"', "'"}:
        quote = s[0]
        out: list[str] = []
        i = 1
        while i < len(s):
            ch = s[i]
            if ch == "\\" and i + 1 < len(s):
                out.append(s[i + 1])
                i += 2
                continue
            if ch == quote:
                break
            out.append(ch)
            i += 1
        return "".join(out)
    if " #" in s:
        s = s.split(" #", 1)[0].rstrip()
    return s


def load_env_file(path: Path) -> EnvMap:
    return parse_env_text(path.read_text(encoding="utf-8", errors="replace"), str(path))


def current_env() -> EnvMap:
    return EnvMap(dict(os.environ), "process")


def env_from_pid(pid: int) -> EnvMap:
    proc = Path(f"/proc/{pid}/environ")
    if proc.is_file():
        blob = proc.read_bytes()
        values: dict[str, str] = {}
        for part in blob.split(b"\0"):
            if not part or b"=" not in part:
                continue
            key, _, val = part.partition(b"=")
            try:
                k = key.decode("utf-8")
                v = val.decode("utf-8", "replace")
            except UnicodeDecodeError:
                continue
            if ENV_NAME_RE.match(k):
                values[k] = v
        return EnvMap(values, f"pid:{pid}")

    # macOS: ps may echo KEY=val after the argument vector.
    try:
        out = subprocess.check_output(
            ["ps", "eww", "-p", str(pid), "-o", "command="],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise RuntimeError(f"cannot read environ of pid {pid}: {exc}") from exc
    values = {}
    for token in out.split():
        if "=" not in token:
            continue
        key, _, val = token.partition("=")
        if ENV_NAME_RE.match(key) and UPPER_NAME_RE.match(key):
            values[key] = val
    if not values:
        raise RuntimeError(
            f"cannot read environ of pid {pid} (no /proc, ps eww empty)"
        )
    return EnvMap(values, f"pid:{pid}")


