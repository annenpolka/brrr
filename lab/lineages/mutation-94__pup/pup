def use_color(mode: str) -> bool:
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def paint(value: bool, enabled: bool) -> str:
    raw = "TRUE" if value else "FALSE"
    if not enabled:
        return f"{raw:<5}"
    if value:
        return f"\033[32;1m{raw:<5}\033[0m"
    return f"\033[31m{raw}\033[0m"


def fmt_witnesses(wits: list[str], limit: int = HOLDER_PRINT_LIMIT) -> Optional[str]:
    if not wits:
        return None
    shown = wits[:limit]
    extra = len(wits) - limit
    text = ", ".join(shown)
    if extra > 0:
        text += f" (+{extra})"
    return text


def print_human(report: dict, eras: list[Era], color: bool, show_wits: bool) -> None:
    name = os.path.basename(report["repo"])
    scanned = report["commits_scanned"]
    reachable = report["reachable"]
    walk = "first-parent" if report["first_parent"] else "full"
    if scanned != reachable:
        count = f"{scanned} of {reachable} commits"
    else:
        count = f"{scanned} commits"
    extra = []
    if report["include_now"]:
        extra.append("now")
    extra.append(report["kind"])
    bits = ", ".join([count, walk, *extra])
    print(f"# {report['predicate']}  ({name}, {bits})")
    ident = report.get("identity") or []
    if len(ident) >= 2:
        label = "copy" if report["kind"] == "copy" else "follow"
        print(f"       {label}: " + " → ".join(ident))
    elif ident:
        print("       names: " + " → ".join(ident))
    for era in eras:
        span = fmt_span(era.start, era.end)
        dates = fmt_dates(era.start, era.end)
        unit = "commit" if era.count == 1 else "commits"
        label = paint(era.value, color)
        print(f"{label} {era.count:>3} {unit:<8} {span}  {dates}".rstrip())
        if era.count == 1:
            print(f"       {era.start.subject}")
        else:
            print(f"       {era.start.short}  {era.start.subject}")
            print(f"       {era.end.short}  {era.end.subject}")
        if era.origin is not None:
            n = era.origin_count
            as_name = ""
            if era.origin.witnesses:
                as_name = f"  as {era.origin.witnesses[0]}"
            print(
                f"       origin: {era.origin.short}  {era.origin.subject}"
                f"  ({n} commit{'s' if n != 1 else ''} before this merge)"
                f"{as_name}"
            )
        if show_wits and era.value:
            wtxt = fmt_witnesses(era.holders)
            if wtxt:
                print(f"       holders: {wtxt}")
            if era.split == "holders":
                for h in era.added:
                    print(f"       + {h}")
                for h in era.dropped:
                    print(f"       - {h}")
    holds = "TRUE" if report["holds_now"] else "FALSE"
    holder_splits = sum(1 for e in eras if e.split == "holders")
    bits_out = [
        f"now={holds}",
        f"true={report['true_commits']}/{report['commits_scanned']}",
        f"eras={len(eras)}",
    ]
    if report["split_holders"] and holder_splits:
        bits_out.append(f"boolean={report['boolean_eras']}")
        bits_out.append(f"holder_splits={holder_splits}")
    bits_out.append(f"probes={report['probes']}")
    if report.get("identity"):
        bits_out.append("aka=" + ",".join(report["identity"]))
    print("  ".join(bits_out))
    for w in report.get("warnings") or []:
        print(f"warning: {w}")
    for h in report.get("hints") or []:
        print(f"hint: {h}")


def print_oneline(eras: list[Era]) -> None:
    for era in eras:
        flag = "T" if era.value else "F"
        span = fmt_span(era.start, era.end)
        dates = fmt_dates(era.start, era.end)
        holders = ",".join(era.holders)
        split = "" if era.split == "start" else era.split
        print(
            f"{flag}\t{era.count}\t{span}\t{dates}\t{holders}\t{split}\t{era.kind_name}"
        )


def era_records(eras: list[Era]) -> list[dict]:
    recs = []
    for era in eras:
        rec = {
            "value": era.value,
            "count": era.count,
            "split": era.split,
            "kind": era.kind_name,
            "start": era.start.as_json(),
            "end": era.end.as_json(),
            "holders": list(era.holders),
            "added": list(era.added),
            "dropped": list(era.dropped),
            "witnesses_start": list(era.start.witnesses) if era.value else [],
            "witnesses_end": list(era.end.witnesses) if era.value else [],
        }
        if era.origin is not None:
            rec["origin"] = era.origin.as_json()
            rec["origin_true_commits"] = era.origin_count
        recs.append(rec)
    return recs


# --- occupy one covering ---------------------------------------------------


def occupy_one(
    cov: Covering,
    repo: str,
    commits: list[Sample],
    spec: str,
    first_parent: bool,
    *,
    want_now: bool,
    want_index: bool,
    split_holders: bool,
    name_origin: bool,
) -> dict:
    # clone sample shells so predicates do not share value flags
    local = [
        Sample(
            sha=s.sha,
            short=s.short,
            timestamp=s.timestamp,
            iso=s.iso,
            subject=s.subject,
            kind=s.kind,
            parents=list(s.parents),
        )
        for s in commits
    ]
    probes = 0
    names: list[str] = []
    if cov.kind == "copy":
        probes += occupy_copy_dest(repo, local, cov.dest)
        names = [cov.source, cov.dest]
        extra: list[Sample] = []
        if want_index:
            s = index_sample()
            ok, wits = exists_worktree(repo, cov.dest)
            # index: dest staged?
            r = run_git(repo, ["ls-files", "-c", "--error-unmatch", "--", cov.dest], check=False)
            s.value = r.returncode == 0
            s.witnesses = [cov.dest] if s.value else []
            extra.append(s)
            probes += 1
        if want_now:
            s = now_sample()
            ok, wits = exists_worktree(repo, cov.dest)
            s.value = ok
            s.witnesses = wits
            extra.append(s)
        samples = local + extra
    else:
        query = cov.dest if cov.dest else cov.source
        # Prefer dest so a first-parent dest-only merge still seeds.
        seed = cov.source if cov.source else query
        # Seed from dest if dest exists more recently (first-parent dest birth).
        dest_hits = exists_at_commits(repo, [local[-1].sha], cov.dest) if cov.dest else [(False, [])]
        src_hits = exists_at_commits(repo, [local[-1].sha], cov.source) if cov.source else [(False, [])]
        probes += 2
        if dest_hits and dest_hits[0][0]:
            seed = cov.dest
        elif src_hits and src_hits[0][0]:
            seed = cov.source
        else:
            seed = cov.dest or cov.source
        followed, more = occupy_follow_identity(repo, local, spec, first_parent, seed)
        probes += more
        names = identity_chain(followed)
        if cov.source and cov.source not in names:
            names = [cov.source] + [n for n in names if n != cov.source]
        if cov.dest and cov.dest not in names:
            names.append(cov.dest)
        extra = []
        if want_index:
            s = index_sample()
            head_name = followed[-1] if followed else seed
            cur = follow_dirty_name(repo, head_name, cached=True)
            if cur:
                r = run_git(repo, ["ls-files", "-c", "--error-unmatch", "--", cur], check=False)
                s.value = r.returncode == 0
                s.witnesses = [cur] if s.value else []
            extra.append(s)
            probes += 1
        if want_now:
            s = now_sample()
            head_name = followed[-1] if followed else seed
            cur = follow_dirty_name(repo, head_name, cached=False)
            if cur:
                ok, wits = exists_worktree(repo, cur)
                s.value = ok
                s.witnesses = wits
            extra.append(s)
            probes += 1
        samples = local + extra

    true_commit_n = sum(1 for s in local if s.value)
    holds_now = bool(samples[-1].value) if samples else False
    boolean_eras = compress(samples, split_holders=False)
    eras = compress(samples, split_holders=split_holders)
    classify_eras(eras)
    dest_for_origin = cov.dest if cov.kind == "copy" else (names[-1] if names else cov.dest)
    probes += annotate_origin(
        repo, eras, first_parent, dest_for_origin, cov.event_rev, enabled=name_origin
    )

    pred = f"{cov.kind} {cov.source} → {cov.dest}"
    report = {
        "repo": repo,
        "predicate": pred,
        "kind": cov.kind,
        "from": cov.source,
        "to": cov.dest,
        "end_rev": spec,
        "first_parent": first_parent,
        "include_now": want_now,
        "holds_now": holds_now,
        "never_held": true_commit_n == 0,
        "always_held": true_commit_n == len(local) and len(local) > 0,
        "commits_scanned": len(local),
        "true_commits": true_commit_n,
        "boolean_eras": len(boolean_eras),
        "split_holders": split_holders,
        "copy": cov.kind == "copy",
        "follow": cov.kind == "follow",
        "identity": names,
        "probes": probes,
        "eras": era_records(eras),
        "hints": [],
        "warnings": [],
        "_eras": eras,
        "_samples": samples,
    }
    return report


# --- cli -------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=TOOL,
        description=(
            "Occupy covering copy/follow predicates as eras. stdin is ditto / "
            "held / berth covering lines (or pup A B classifies two trees). "
            "stdout is occupancy, without sh. git mv is FOLLOW; cp is COPY."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  ditto A B | pup
  ditto -C repo 5671a72^ 5671a72 | pup --full
  ditto --walks -C repo A B | pup
  pup -C repo A B
  pup -C repo --json < covering.json
""",
    )
    p.add_argument("-C", "--repo", default=None, help="repository (default: from stdin -C, else cwd)")
    p.add_argument("--rev", default="HEAD", help="occupancy tip (default: HEAD)")
    p.add_argument("--range", dest="rev_range", metavar="REV_RANGE")
    p.add_argument("--full", action="store_true", help="every reachable commit, not first-parent")
    p.add_argument("--now", action="store_true")
    p.add_argument("--index", action="store_true")
    p.add_argument("--limit", type=int, default=None)
    p.add_argument("--json", action="store_true")
    p.add_argument("--oneline", action="store_true")
    p.add_argument("--revs", action="store_true")
    p.add_argument("--bounds", action="store_true")
    p.add_argument("--true-bounds", action="store_true")
    p.add_argument("-q", "--quiet", action="store_true")
    p.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    p.add_argument("--no-witnesses", action="store_true")
    p.add_argument("--boolean", action="store_true")
    p.add_argument("--copy-only", action="store_true")
    p.add_argument("--follow-only", action="store_true")
    p.add_argument(
        "--origin",
        dest="origin",
        action="store_true",
        default=True,
        help="name dest-add behind a first-parent merge (default; kizu C056 = 5671a72)",
    )
    p.add_argument(
        "--no-origin",
        dest="origin",
        action="store_false",
        help="do not name off-mainline dest-add (v1 dest-existence boolean only)",
    )
    p.add_argument("trees", nargs="*", help="optional A B: classify those two trees as covering")
    return p


def stdin_has_data() -> bool:
    return not sys.stdin.isatty()


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    name_origin = bool(args.origin)

    coverings: list[Covering] = []
    notes: list[str] = []
    stdin_repo: Optional[str] = None

    if stdin_has_data():
        text = sys.stdin.read()
        covs, walks, skipped = parse_stdin_text(text)
        coverings.extend(covs)
        for w in walks:
            if w.get("repo") and not stdin_repo:
                stdin_repo = w["repo"]
        repo_guess = args.repo or stdin_repo or "."
        notes.extend(recover_from_walks(walks, coverings, repo_guess))
        notes.extend(skipped)

    if args.trees:
        if len(args.trees) == 1:
            die("need two trees A B (or pipe ditto covering on stdin)")
        if len(args.trees) > 2:
            die("too many tree arguments; expected A B")
        a, b = args.trees
        repo_for_pair = resolve_repo(args.repo or stdin_repo or ".")
        found, _ = classify_pair(repo_for_pair, a, b)
        if not found:
            notes.append(f"{a}..{b} has no copy/follow covering")
        for c in found:
            c.repo = repo_for_pair
            add_covering(coverings, c)

    if args.copy_only:
        coverings = [c for c in coverings if c.kind == "copy"]
    if args.follow_only:
        coverings = [c for c in coverings if c.kind == "follow"]

    repo_arg = args.repo or stdin_repo
    if coverings:
        repo_arg = repo_arg or next((c.repo for c in coverings if c.repo), None)
    if not repo_arg:
        repo_arg = "."
    try:
        repo = resolve_repo(repo_arg)
    except GitError as e:
        die(e.message)

    spec = args.rev_range if args.rev_range else args.rev
    first_parent = not args.full
    split_holders = not args.boolean

    try:
        commits = load_commits(repo, spec, first_parent=first_parent, limit=args.limit)
    except GitError as e:
        die(e.message)
    if not commits:
        die(f"no commits at {spec} (empty repository?)")

    reachable = reachable_count(repo, spec)
    color = use_color(args.color)
    reports: list[dict] = []

    if not coverings:
        hint = "no copy/follow covering on stdin (grep/exists-only is held, not pup)"
        if notes:
            hint = notes[0]
        empty = {
            "repo": repo,
            "predicate": "copy/follow",
            "kind": "none",
            "holds_now": False,
            "never_held": True,
            "commits_scanned": len(commits),
            "reachable": reachable,
            "true_commits": 0,
            "first_parent": first_parent,
            "include_now": bool(args.now),
            "probes": 0,
            "identity": [],
            "eras": [],
            "hints": [hint, *notes[1:]],
            "warnings": [],
            "predicates": [],
        }
        if not args.quiet:
            if args.json:
                print(json.dumps(empty, indent=2, ensure_ascii=False))
            else:
                print(f"# (no copy/follow covering)  ({os.path.basename(repo)}, {len(commits)} commits)")
                for h in empty["hints"]:
                    print(f"hint: {h}")
        return 1

    any_now = False
    for cov in coverings:
        report = occupy_one(
            cov,
            repo,
            commits,
            spec,
            first_parent,
            want_now=bool(args.now),
            want_index=bool(args.index),
            split_holders=split_holders,
            name_origin=name_origin,
        )
        report["reachable"] = reachable
        # Mixed sheaves (copy + leftover grep) are occupied as copy/follow;
        # skip-grep notes are noise on a successful occupy.
        report["hints"] = []
        reports.append(report)
        any_now = any_now or bool(report["holds_now"])

    if not args.quiet:
        if args.json:
            payload = {
                "repo": repo,
                "end_rev": spec,
                "first_parent": first_parent,
                "holds_now": any_now,
                "commits_scanned": len(commits),
                "reachable": reachable,
                "predicates": [],
            }
            for report in reports:
                rec = {k: v for k, v in report.items() if not k.startswith("_")}
                payload["predicates"].append(rec)
            if len(reports) == 1:
                payload.update({k: v for k, v in reports[0].items() if not k.startswith("_")})
            print(json.dumps(payload, indent=2, ensure_ascii=False))
        elif args.revs:
            seen: set[str] = set()
            for report in reports:
                for s in report["_samples"]:
                    if s.value and s.kind == "commit" and s.sha not in seen:
                        seen.add(s.sha)
                        print(s.sha)
        elif args.true_bounds or args.bounds:
            for report in reports:
                for era in report["_eras"]:
                    if args.true_bounds and not era.value:
                        continue
                    print(f"{era.start.sha} {era.end.sha} {int(era.value)} {era.count}")
        elif args.oneline:
            for report in reports:
                print_oneline(report["_eras"])
        else:
            for i, report in enumerate(reports):
                if i:
                    print()
                print_human(report, report["_eras"], color, show_wits=not args.no_witnesses)

    return 0 if any_now else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except GitError as e:
        die(e.message)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
    except KeyboardInterrupt:
        raise SystemExit(130)
