def is_missing_line(line: str) -> bool:
    return line.endswith(" missing") or line == "missing"


def exists_at_commits(repo: str, shas: list[str], path: str) -> list[tuple[bool, list[str]]]:
    if not shas:
        return []
    if is_glob(path):
        out: list[tuple[bool, list[str]]] = []
        for sha in shas:
            r = run_git(
                repo,
                ["ls-files", "-z", "--with-tree", sha, "--", path],
                check=False,
            )
            names = [n for n in r.stdout.split("\0") if n]
            if not names:
                r2 = run_git(repo, ["ls-tree", "-r", "-z", "--name-only", sha], check=False)
                names = [n for n in r2.stdout.split("\0") if n]
                rx = fnmatch_to_re(path)
                names = [n for n in names if rx.match(n)]
            names.sort()
            out.append((bool(names), names))
        return out
    payload = "".join(f"{sha}:{path}\n" for sha in shas)
    r = run_git(repo, ["cat-file", "--batch-check"], input_text=payload)
    lines = [ln for ln in r.stdout.splitlines() if ln]
    if len(lines) != len(shas):
        out = []
        for sha in shas:
            rr = run_git(repo, ["cat-file", "--batch-check"], input_text=f"{sha}:{path}\n")
            miss = is_missing_line(rr.stdout.strip())
            out.append((not miss, [] if miss else [path]))
        return out
    out = []
    for line in lines:
        miss = is_missing_line(line)
        out.append((not miss, [] if miss else [path]))
    return out


def fnmatch_to_re(spec: str) -> re.Pattern:
    rx = []
    i = 0
    while i < len(spec):
        ch = spec[i]
        if ch == "*":
            rx.append(".*")
        elif ch == "?":
            rx.append(".")
        elif ch == "[":
            j = spec.find("]", i + 1)
            if j < 0:
                rx.append(re.escape(ch))
            else:
                rx.append(spec[i : j + 1])
                i = j
        else:
            rx.append(re.escape(ch))
        i += 1
    return re.compile("^" + "".join(rx) + "$")


def unquote_git_path(path: str) -> str:
    if len(path) >= 2 and path[0] == '"' and path[-1] == '"':
        raw = path[1:-1]
        out = bytearray()
        i = 0
        while i < len(raw):
            if raw[i] == "\\" and i + 3 < len(raw) and raw[i + 1 : i + 4].isdigit():
                out.append(int(raw[i + 1 : i + 4], 8))
                i += 4
                continue
            if raw[i] == "\\" and i + 1 < len(raw):
                esc = {"n": 10, "t": 9, "r": 13, '"': 34, "\\": 92}.get(raw[i + 1])
                if esc is not None:
                    out.append(esc)
                    i += 2
                    continue
            out.extend(raw[i].encode("utf-8", "surrogateescape"))
            i += 1
        return out.decode("utf-8", "surrogateescape")
    return path


def collect_tree_changes(
    repo: str, spec: str, first_parent: bool
) -> dict[str, tuple[list[tuple[str, str]], set[str], set[str]]]:
    """sha → (renames old→new, added, deleted). Copies are not identity moves.

    Uses git log --find-renames (R), never --find-copies / -C.
    """
    args = [
        "-c",
        "core.quotepath=false",
        "log",
        "--reverse",
        "--find-renames",
        "--name-status",
        "--pretty=format:COMMIT %H",
    ]
    if first_parent:
        args.append("--first-parent")
    args.append(spec)
    r = run_git(repo, args, check=False)
    out: dict[str, tuple[list[tuple[str, str]], set[str], set[str]]] = {}
    sha: Optional[str] = None
    renames: list[tuple[str, str]] = []
    added: set[str] = set()
    deleted: set[str] = set()

    def flush() -> None:
        nonlocal sha, renames, added, deleted
        if sha:
            out[sha] = (renames, added, deleted)
        sha = None
        renames, added, deleted = [], set(), set()

    for line in r.stdout.splitlines():
        if line.startswith("COMMIT "):
            flush()
            sha = line.split(" ", 1)[1].strip()
            continue
        if not line.strip() or sha is None:
            continue
        parts = line.split("\t")
        code = parts[0] if parts else ""
        if code.startswith("R") and len(parts) >= 3:
            renames.append((unquote_git_path(parts[1]), unquote_git_path(parts[2])))
        elif code.startswith("A") and len(parts) >= 2:
            added.add(unquote_git_path(parts[1]))
        elif code.startswith("D") and len(parts) >= 2:
            deleted.add(unquote_git_path(parts[1]))
    flush()
    return out


def follow_names(
    shas: list[str],
    path: str,
    changes: dict[str, tuple[list[tuple[str, str]], set[str], set[str]]],
    existed: list[bool],
) -> list[Optional[str]]:
    n = len(shas)
    names: list[Optional[str]] = [None] * n
    if n == 0:
        return names

    def rec(i: int) -> tuple[list[tuple[str, str]], set[str], set[str]]:
        return changes.get(shas[i], ([], set(), set()))

    seed = next((i for i, ok in enumerate(existed) if ok), None)
    if seed is None:
        for i in range(n):
            renames, _, _ = rec(i)
            for old, new in renames:
                if path == new:
                    seed = i
                    names[i] = new
                    break
                if path == old:
                    if i > 0:
                        seed = i - 1
                        names[seed] = old
                    else:
                        seed = i
                        names[i] = new
                    break
            if seed is not None:
                break
        if seed is None:
            return names
    else:
        names[seed] = path

    cur = names[seed]
    for i in range(seed, 0, -1):
        if cur is None:
            break
        renames, added, _deleted = rec(i)
        moved = False
        for old, new in renames:
            if new == cur:
                cur = old
                names[i - 1] = cur
                moved = True
                break
        if moved:
            continue
        if cur in added:
            break
        names[i - 1] = cur

    cur = names[seed]
    for i in range(seed, n - 1):
        if cur is None:
            break
        renames, _added, deleted = rec(i + 1)
        moved = False
        for old, new in renames:
            if old == cur:
                cur = new
                names[i + 1] = cur
                moved = True
                break
        if moved:
            continue
        if cur in deleted:
            break
        names[i + 1] = cur
    return names


def identity_chain(names: list[Optional[str]]) -> list[str]:
    out: list[str] = []
    for n in names:
        if n and n not in out:
            out.append(n)
    return out


def occupy_copy_dest(
    repo: str,
    commits: list[Sample],
    dest: str,
) -> int:
    """COPY occupancy is dest existence. Source still holds; dest is the extra holder."""
    shas = [s.sha for s in commits]
    hits = exists_at_commits(repo, shas, dest)
    for sample, (ok, wits) in zip(commits, hits):
        sample.value = ok
        sample.witnesses = wits if ok else []
    return 1


def occupy_follow_identity(
    repo: str,
    commits: list[Sample],
    spec: str,
    first_parent: bool,
    query: str,
) -> tuple[list[Optional[str]], int]:
    shas = [s.sha for s in commits]
    changes = collect_tree_changes(repo, spec, first_parent)
    probes = 1
    seed_hits = exists_at_commits(repo, shas, query)
    probes += 1
    existed = [ok for ok, _ in seed_hits]
    names = follow_names(shas, query, changes, existed)
    payload: list[str] = []
    query_idx: list[int] = []
    for i, sha in enumerate(shas):
        n = names[i]
        if n:
            payload.append(f"{sha}:{n}\n")
            query_idx.append(i)
    if payload:
        r = run_git(repo, ["cat-file", "--batch-check"], input_text="".join(payload))
        probes += 1
        lines = [ln for ln in r.stdout.splitlines() if ln]
        for i, line in zip(query_idx, lines):
            n = names[i]
            if n and not is_missing_line(line):
                commits[i].value = True
                commits[i].witnesses = [n]
            else:
                names[i] = None
                commits[i].value = False
                commits[i].witnesses = []
    return names, probes


def exists_worktree(repo: str, path: str) -> tuple[bool, list[str]]:
    p = os.path.join(repo, path)
    ok = os.path.lexists(p)
    return ok, ([path] if ok else [])


def follow_dirty_name(repo: str, head_name: Optional[str], *, cached: bool) -> Optional[str]:
    if not head_name:
        return None
    args = ["-c", "core.quotepath=false", "diff", "-M", "--name-status"]
    if cached:
        args.append("--cached")
    args.append("HEAD")
    r = run_git(repo, args, check=False)
    cur = head_name
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if not parts:
            continue
        code = parts[0]
        if code.startswith("R") and len(parts) >= 3:
            old, new = unquote_git_path(parts[1]), unquote_git_path(parts[2])
            if old == cur:
                cur = new
        elif code.startswith("D") and len(parts) >= 2:
            if unquote_git_path(parts[1]) == cur:
                return None
    return cur


def dest_birth_sha(repo: str, dest: str, tip: str) -> Optional[str]:
    r = run_git(
        repo,
        ["log", "--reverse", "--diff-filter=A", "--pretty=format:%H", tip, "--", dest],
        check=False,
    )
    if r.returncode != 0 or not r.stdout.strip():
        return None
    return r.stdout.splitlines()[0].strip()


def merge_parents(repo: str, sha: str) -> list[str]:
    r = run_git(repo, ["rev-list", "--parents", "-n", "1", sha], check=False)
    if r.returncode != 0:
        return []
    parts = r.stdout.strip().split()
    return parts[1:] if len(parts) > 1 else []


def load_commit_meta(repo: str, sha: str) -> Optional[Sample]:
    r = run_git(
        repo,
        ["log", "-1", "--pretty=format:%H\t%ct\t%ci\t%s", sha],
        check=False,
    )
    if r.returncode != 0 or not r.stdout.strip():
        return None
    parts = r.stdout.strip().split("\t", 3)
    if len(parts) < 4:
        return None
    h, ts, iso, subject = parts
    return Sample(
        sha=h,
        short=h[:7],
        timestamp=int(ts),
        iso=iso,
        subject=subject,
        kind="commit",
    )


def annotate_origin(
    repo: str,
    eras: list[Era],
    first_parent: bool,
    dest: str,
    event_rev: Optional[str],
    enabled: bool,
) -> int:
    """Name dest-add behind a first-parent merge (kizu C056 = 5671a72)."""
    if not enabled or not first_parent:
        return 0
    extra = 0
    for era in eras:
        if not era.value or era.start.kind != "commit":
            continue
        parents = merge_parents(repo, era.start.sha)
        if len(parents) < 2:
            continue
        extra += 1
        born = dest_birth_sha(repo, dest, era.start.sha)
        if not born or born == era.start.sha:
            if event_rev:
                r = run_git(repo, ["rev-parse", event_rev], check=False)
                born = r.stdout.strip() if r.returncode == 0 else event_rev
            else:
                continue
        if not born or born == era.start.sha:
            continue
        origin = load_commit_meta(repo, born)
        if origin is None:
            continue
        origin.witnesses = [dest]
        era.origin = origin
        behind = run_git(
            repo,
            ["rev-list", "--count", era.start.sha, f"^{parents[0]}"],
            check=False,
        )
        try:
            era.origin_count = int(behind.stdout.strip() or "0")
        except ValueError:
            era.origin_count = 0
    return extra


