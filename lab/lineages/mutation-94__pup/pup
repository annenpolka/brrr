#!/usr/bin/env python3
"""pup — covering predicates in, occupancy eras out.

ditto emits COPY vs FOLLOW then pastes `held exists DEST` / `--follow exists OLD`.
`ditto A B | sh` runs those walks. held does not parse --follow; dest existence
is also TRUE for a unique birth. pup occupies the covering predicates:
git mv is FOLLOW (identity eras); cp is COPY (dest is the extra holder).

Not git diff -C. Not a third ambit. Not leftover-name search.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass, field
from datetime import datetime
from typing import Optional


TOOL = "pup"
COPY_SIM_MIN = 0.5
RENAME_SIM_MIN = 0.5
MAX_BLOB = 1_000_000
HOLDER_PRINT_LIMIT = 8
GLOB_CHARS = set("*?[")

SKIP_TOKEN_SUFFIXES = (
    ".lock",
    ".min.js",
    ".min.css",
    ".map",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
    ".pdf",
    ".zip",
    ".gz",
    ".bin",
)
SKIP_TOKEN_NAMES = {
    "cargo.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "go.sum",
    "poetry.lock",
    "composer.lock",
    "gemfile.lock",
}
SKIP_TOKEN_PARTS = ("/docs/generated/", "/generated/", ".generated.")


class GitError(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


def die(msg: str, code: int = 2) -> None:
    print(f"{TOOL}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def run_git(
    repo: str,
    args: list[str],
    check: bool = True,
    input_text: Optional[str] = None,
    input_bytes: Optional[bytes] = None,
) -> subprocess.CompletedProcess:
    cmd = ["git", "-C", repo, *args]
    if input_bytes is not None:
        r = subprocess.run(cmd, input=input_bytes, capture_output=True)
    else:
        r = subprocess.run(cmd, input=input_text, text=True, capture_output=True)
    if check and r.returncode != 0:
        raw = r.stderr or r.stdout or b""
        err = raw.decode("utf-8", "replace") if isinstance(raw, bytes) else raw
        raise GitError(err.strip() or f"git {' '.join(args)} failed")
    return r


def resolve_repo(path: str) -> str:
    path = os.path.abspath(path)
    if not os.path.isdir(path):
        die(f"not a git repository: {path}")
    r = run_git(path, ["rev-parse", "--show-toplevel"], check=False)
    if r.returncode != 0:
        die(f"not a git repository: {path}")
    top = r.stdout.strip() if isinstance(r.stdout, str) else ""
    if not top:
        die(f"not a git repository: {path}")
    return top


def quote(s: str) -> str:
    if not s:
        return "''"
    if all(ch.isalnum() or ch in "._-/@+," for ch in s):
        return s
    return "'" + s.replace("'", "'\\''") + "'"


def unquote_token(s: str) -> str:
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "'\"":
        inner = s[1:-1]
        if s[0] == "'":
            return inner.replace("'\\''", "'")
        out = []
        i = 0
        while i < len(inner):
            if inner[i] == "\\" and i + 1 < len(inner):
                out.append(inner[i + 1])
                i += 2
                continue
            out.append(inner[i])
            i += 1
        return "".join(out)
    return s


def is_glob(path: str) -> bool:
    return any(ch in path for ch in GLOB_CHARS)


# --- samples / eras --------------------------------------------------------


@dataclass
class Sample:
    sha: str
    short: str
    timestamp: int
    iso: str
    subject: str
    kind: str
    parents: list[str] = field(default_factory=list)
    value: bool = False
    witnesses: list[str] = field(default_factory=list)

    def as_json(self) -> dict:
        return {
            "sha": self.sha,
            "short": self.short,
            "timestamp": self.timestamp,
            "iso": self.iso,
            "subject": self.subject,
            "kind": self.kind,
        }


@dataclass
class Era:
    value: bool
    samples: list[Sample]
    split: str = "start"
    kind_name: str = "absent"
    added: list[str] = field(default_factory=list)
    dropped: list[str] = field(default_factory=list)
    origin: Optional[Sample] = None
    origin_count: int = 0

    @property
    def count(self) -> int:
        return len(self.samples)

    @property
    def start(self) -> Sample:
        return self.samples[0]

    @property
    def end(self) -> Sample:
        return self.samples[-1]

    @property
    def holders(self) -> list[str]:
        if not self.value:
            return []
        return list(self.start.witnesses)


@dataclass
class Identity:
    kind: str  # copied | renamed | died | born | changed
    a_path: Optional[str] = None
    b_path: Optional[str] = None
    sha_a: Optional[str] = None
    sha_b: Optional[str] = None
    similarity: float = 1.0


@dataclass
class Covering:
    kind: str  # copy | follow
    source: str
    dest: str
    repo: Optional[str] = None
    event_rev: Optional[str] = None
    raw: str = ""


def day(iso: str) -> str:
    return iso[:10]


def fmt_dates(start: Sample, end: Sample, always_arrow: bool = False) -> str:
    a, b = day(start.iso), day(end.iso)
    if a == b and not always_arrow:
        return a
    return f"{a} → {b}"


def fmt_span(start: Sample, end: Sample) -> str:
    if start.short == end.short:
        return start.short
    return f"{start.short}..{end.short}"


def load_commits(
    repo: str, spec: str, first_parent: bool, limit: Optional[int]
) -> list[Sample]:
    args = ["log", "--reverse", "--pretty=format:%H\t%P\t%ct\t%ci\t%s"]
    if first_parent:
        args.append("--first-parent")
    args.append(spec)
    r = run_git(repo, args, check=False)
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "").strip()
        if not r.stdout.strip():
            return []
        raise GitError(err)
    samples: list[Sample] = []
    for line in r.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 4)
        if len(parts) < 5:
            continue
        sha, parents, ts, iso, subject = parts
        samples.append(
            Sample(
                sha=sha,
                short=sha[:7],
                timestamp=int(ts),
                iso=iso,
                subject=subject,
                kind="commit",
                parents=parents.split() if parents.strip() else [],
            )
        )
    if limit is not None and limit >= 0:
        samples = samples[-limit:]
    return samples


def reachable_count(repo: str, spec: str) -> int:
    r = run_git(repo, ["rev-list", "--count", spec], check=False)
    if r.returncode != 0:
        return 0
    try:
        return int(r.stdout.strip() or "0")
    except ValueError:
        return 0


def now_sample() -> Sample:
    stamp = datetime.now().astimezone()
    return Sample(
        sha="WORKTREE",
        short="WORKTREE",
        timestamp=int(stamp.timestamp()),
        iso=stamp.isoformat(timespec="seconds"),
        subject="uncommitted working tree",
        kind="worktree",
    )


def index_sample() -> Sample:
    stamp = datetime.now().astimezone()
    return Sample(
        sha="INDEX",
        short="INDEX",
        timestamp=int(stamp.timestamp()),
        iso=stamp.isoformat(timespec="seconds"),
        subject="staged index",
        kind="index",
    )


def compress(samples: list[Sample], split_holders: bool) -> list[Era]:
    eras: list[Era] = []
    for s in samples:
        if not eras:
            eras.append(Era(value=s.value, samples=[s], split="start"))
            continue
        prev = eras[-1]
        if prev.value != s.value:
            eras.append(Era(value=s.value, samples=[s], split="boolean"))
            continue
        if split_holders and s.value and list(prev.end.witnesses) != list(s.witnesses):
            eras.append(Era(value=s.value, samples=[s], split="holders"))
            continue
        prev.samples.append(s)
    return eras


def classify_eras(eras: list[Era]) -> None:
    for i, era in enumerate(eras):
        prev = eras[i - 1] if i else None
        prev_h = list(prev.holders) if prev and prev.value else []
        cur_h = list(era.holders) if era.value else []
        if era.value:
            era.added = sorted(set(cur_h) - set(prev_h))
            era.dropped = sorted(set(prev_h) - set(cur_h))
        else:
            era.added = []
            era.dropped = []
        if not era.value:
            era.kind_name = "absent" if prev is None else "death"
            continue
        if prev is None or not prev.value:
            era.kind_name = "birth"
            continue
        if era.added and era.dropped:
            era.kind_name = "move"
        elif era.added:
            era.kind_name = "spread"
        elif era.dropped:
            era.kind_name = "shrink"
        else:
            era.kind_name = "birth"


# --- two-tree covering (ditto kernel, no history walk) ---------------------


def git_blob_sha(data: bytes) -> str:
    header = f"blob {len(data)}\0".encode()
    return hashlib.sha1(header + data).hexdigest()


class TreeCache:
    def __init__(self, repo: str) -> None:
        self.repo = repo
        self.trees: dict[str, dict[str, str]] = {}
        self.blobs: dict[str, Optional[bytes]] = {}
        self.probes = 0

    def tree(self, spec: str) -> dict[str, str]:
        if spec in self.trees:
            return self.trees[spec]
        if spec in ("WORKTREE", ":worktree"):
            paths = self._load_worktree()
        elif spec in ("INDEX", ":index"):
            paths = self._load_index()
        else:
            paths = self._load_commit(spec)
        self.trees[spec] = paths
        return paths

    def _load_commit(self, sha: str) -> dict[str, str]:
        rb = run_git(self.repo, ["ls-tree", "-r", "-z", sha], check=False, input_bytes=b"")
        self.probes += 1
        if rb.returncode != 0:
            return {}
        data = rb.stdout if isinstance(rb.stdout, bytes) else b""
        paths: dict[str, str] = {}
        for entry in data.split(b"\0"):
            if not entry:
                continue
            try:
                meta, path_b = entry.split(b"\t", 1)
            except ValueError:
                continue
            parts = meta.split()
            if len(parts) < 3:
                continue
            obj_type = parts[1].decode("ascii", "replace")
            sha = parts[2].decode("ascii", "replace")
            path = path_b.decode("utf-8", "surrogateescape")
            if obj_type != "blob":
                continue
            paths[path] = sha
        return paths

    def _load_worktree(self) -> dict[str, str]:
        rb = run_git(
            self.repo,
            ["ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            check=False,
            input_bytes=b"",
        )
        self.probes += 1
        paths: dict[str, str] = {}
        data = rb.stdout if isinstance(rb.stdout, bytes) else b""
        for raw in data.split(b"\0"):
            if not raw:
                continue
            rel = raw.decode("utf-8", "surrogateescape")
            abs_path = os.path.join(self.repo, rel)
            if not os.path.isfile(abs_path):
                continue
            try:
                with open(abs_path, "rb") as fh:
                    blob = fh.read(MAX_BLOB + 1)
            except OSError:
                continue
            if len(blob) > MAX_BLOB:
                paths[rel] = "LARGE"
                continue
            paths[rel] = git_blob_sha(blob)
            self.blobs[paths[rel]] = blob
        return paths

    def _load_index(self) -> dict[str, str]:
        rb = run_git(
            self.repo, ["ls-files", "-z", "--cached", "-s"], check=False, input_bytes=b""
        )
        self.probes += 1
        paths: dict[str, str] = {}
        data = rb.stdout if isinstance(rb.stdout, bytes) else b""
        for entry in data.split(b"\0"):
            if not entry:
                continue
            try:
                meta, path_b = entry.split(b"\t", 1)
            except ValueError:
                continue
            parts = meta.split()
            if len(parts) < 2:
                continue
            sha = parts[1].decode("ascii", "replace")
            path = path_b.decode("utf-8", "surrogateescape")
            paths[path] = sha
        return paths

    def blob(self, tree: dict[str, str], path: str) -> Optional[bytes]:
        sha = tree.get(path)
        if not sha or sha == "LARGE":
            return None
        if sha in self.blobs:
            return self.blobs[sha]
        if len(sha) != 40:
            return None
        rb = run_git(
            self.repo, ["cat-file", "--batch"], check=False, input_bytes=f"{sha}\n".encode()
        )
        self.probes += 1
        data = rb.stdout if isinstance(rb.stdout, bytes) else b""
        nl = data.find(b"\n")
        if nl < 0:
            self.blobs[sha] = None
            return None
        header = data[:nl].decode("ascii", "replace")
        if header.endswith(" missing"):
            self.blobs[sha] = None
            return None
        parts = header.split()
        if len(parts) < 3:
            self.blobs[sha] = None
            return None
        try:
            size = int(parts[2])
        except ValueError:
            self.blobs[sha] = None
            return None
        blob = data[nl + 1 : nl + 1 + size]
        if size > MAX_BLOB or b"\0" in blob[:8000]:
            self.blobs[sha] = None
            return None
        self.blobs[sha] = blob
        return blob


def skip_token_path(path: str) -> bool:
    lower = path.lower().replace("\\", "/")
    base = lower.rsplit("/", 1)[-1]
    if base in SKIP_TOKEN_NAMES:
        return True
    if lower.endswith(SKIP_TOKEN_SUFFIXES):
        return True
    return any(part in lower for part in SKIP_TOKEN_PARTS)


def line_jaccard(a: bytes, b: bytes) -> float:
    if a == b:
        return 1.0
    la = set(a.splitlines())
    lb = set(b.splitlines())
    if not la and not lb:
        return 1.0
    if not la or not lb:
        return 0.0
    return len(la & lb) / len(la | lb)


def path_pair_score(a_path: str, b_path: str) -> tuple:
    a_base = a_path.rsplit("/", 1)[-1]
    b_base = b_path.rsplit("/", 1)[-1]
    a_stem = a_base.rsplit(".", 1)[0] if "." in a_base else a_base
    b_stem = b_base.rsplit(".", 1)[0] if "." in b_base else b_base
    same_base = 0 if a_base == b_base else 1
    same_stem = 0 if a_stem == b_stem else 1
    return (same_base, same_stem, abs(len(a_path) - len(b_path)), a_path, b_path)


def pick_source(sources: list[str], dest: str) -> str:
    scored = sorted(
        sources,
        key=lambda src: (
            0 if src.rsplit("/", 1)[-1] == dest.rsplit("/", 1)[-1] else 1,
            -len(os.path.commonprefix([src, dest])),
            abs(len(src) - len(dest)),
            src,
        ),
    )
    return scored[0]


def ext_of(path: str) -> str:
    base = path.rsplit("/", 1)[-1]
    if "." not in base:
        return ""
    return base.rsplit(".", 1)[-1].lower()


def related_paths(src: str, dest: str) -> bool:
    se, de = ext_of(src), ext_of(dest)
    if se and se == de:
        return True
    sa = src.split("/")[:-1]
    sb = dest.split("/")[:-1]
    return bool(sa and sb and sa[0] == sb[0])


def detect_identities(
    cache: TreeCache,
    tree_a: dict[str, str],
    tree_b: dict[str, str],
) -> list[Identity]:
    """Same blob still on A and born on B is COPY, not FOLLOW."""
    only_a = sorted(p for p in tree_a if p not in tree_b)
    only_b = sorted(p for p in tree_b if p not in tree_a)
    changed = sorted(p for p in tree_a if p in tree_b and tree_a[p] != tree_b[p])
    shared = sorted(p for p in tree_a if p in tree_b)

    used_a: set[str] = set()
    used_b: set[str] = set()
    identities: list[Identity] = []

    def remaining_holders(sha: str) -> list[str]:
        return [
            p
            for p in shared
            if tree_a.get(p) == sha or tree_b.get(p) == sha
        ]

    def take_rename(ap: str, bp: str, sim: float) -> None:
        used_a.add(ap)
        used_b.add(bp)
        identities.append(
            Identity(kind="renamed", a_path=ap, b_path=bp, sha_a=tree_a.get(ap), sha_b=tree_b.get(bp), similarity=sim)
        )

    def take_copy(ap: str, bp: str, sim: float) -> None:
        used_b.add(bp)
        identities.append(
            Identity(kind="copied", a_path=ap, b_path=bp, sha_a=tree_a.get(ap), sha_b=tree_b.get(bp), similarity=sim)
        )

    def blob_a(path: str) -> Optional[bytes]:
        return cache.blob(tree_a, path)

    def blob_b(path: str) -> Optional[bytes]:
        return cache.blob(tree_b, path)

    for bp in only_b:
        sha = tree_b[bp]
        holders = remaining_holders(sha)
        if holders:
            take_copy(pick_source(holders, bp), bp, 1.0)

    a_by_sha: dict[str, list[str]] = {}
    for p in only_a:
        a_by_sha.setdefault(tree_a[p], []).append(p)
    b_by_sha: dict[str, list[str]] = {}
    for p in only_b:
        b_by_sha.setdefault(tree_b[p], []).append(p)
    for sha, a_paths in a_by_sha.items():
        b_paths = b_by_sha.get(sha) or []
        if not b_paths:
            continue
        remaining_a = [p for p in a_paths if p not in used_a]
        remaining_b = [p for p in b_paths if p not in used_b]
        pairs = sorted(
            ((ap, bp) for ap in remaining_a for bp in remaining_b),
            key=lambda pair: path_pair_score(pair[0], pair[1]),
        )
        for ap, bp in pairs:
            if ap in used_a or bp in used_b:
                continue
            holders = remaining_holders(sha)
            if holders:
                take_copy(pick_source(holders, bp), bp, 1.0)
                continue
            take_rename(ap, bp, 1.0)

    leftover_a = [p for p in only_a if p not in used_a]
    leftover_b = [p for p in only_b if p not in used_b]
    a_base: dict[str, list[str]] = {}
    b_base: dict[str, list[str]] = {}
    for p in leftover_a:
        a_base.setdefault(p.rsplit("/", 1)[-1], []).append(p)
    for p in leftover_b:
        b_base.setdefault(p.rsplit("/", 1)[-1], []).append(p)
    for base, a_paths in a_base.items():
        b_paths = b_base.get(base) or []
        if len(a_paths) == 1 and len(b_paths) == 1:
            ap, bp = a_paths[0], b_paths[0]
            if ap in used_a or bp in used_b:
                continue
            ba, bb = blob_a(ap), blob_b(bp)
            sim = line_jaccard(ba or b"", bb or b"") if ba is not None and bb is not None else 0.0
            take_rename(ap, bp, sim)

    leftover_a = [p for p in only_a if p not in used_a]
    leftover_b = [p for p in only_b if p not in used_b]
    scored: list[tuple[float, str, str]] = []
    for ap in leftover_a:
        ba = blob_a(ap)
        if ba is None:
            continue
        for bp in leftover_b:
            bb = blob_b(bp)
            if bb is None:
                continue
            sim = line_jaccard(ba, bb)
            if sim >= RENAME_SIM_MIN:
                scored.append((sim, ap, bp))
    scored.sort(key=lambda t: (-t[0], t[1], t[2]))
    for sim, ap, bp in scored:
        if ap in used_a or bp in used_b:
            continue
        take_rename(ap, bp, sim)

    leftover_b = [p for p in only_b if p not in used_b]
    changed_set = set(changed)
    copy_scored: list[tuple[tuple, str, str, float]] = []
    for bp in leftover_b:
        bb = blob_b(bp)
        if bb is None:
            continue
        best_ap: Optional[str] = None
        best_key: Optional[tuple] = None
        best_sim = 0.0
        for ap in shared:
            if skip_token_path(ap) or not related_paths(ap, bp):
                continue
            ba = blob_a(ap)
            if ba is None:
                continue
            sim = line_jaccard(ba, bb)
            if sim < COPY_SIM_MIN:
                continue
            key = (
                sim,
                1 if ap in changed_set else 0,
                1 if ext_of(ap) == ext_of(bp) else 0,
                len(os.path.commonprefix([ap, bp])),
            )
            if best_key is None or key > best_key:
                best_key = key
                best_ap = ap
                best_sim = sim
        if best_ap is not None and best_key is not None:
            copy_scored.append((best_key, best_ap, bp, best_sim))
    copy_scored.sort(key=lambda t: t[0], reverse=True)
    for _key, ap, bp, sim in copy_scored:
        if bp in used_b:
            continue
        take_copy(ap, bp, sim)

    for p in only_a:
        if p not in used_a:
            identities.append(Identity(kind="died", a_path=p, sha_a=tree_a.get(p)))
    for p in only_b:
        if p not in used_b:
            identities.append(Identity(kind="born", b_path=p, sha_b=tree_b.get(p)))
    for p in changed:
        identities.append(
            Identity(kind="changed", a_path=p, b_path=p, sha_a=tree_a.get(p), sha_b=tree_b.get(p))
        )
    return identities


def classify_pair(repo: str, a: str, b: str) -> tuple[list[Covering], int]:
    cache = TreeCache(repo)
    tree_a = cache.tree(a)
    tree_b = cache.tree(b)
    idents = detect_identities(cache, tree_a, tree_b)
    out: list[Covering] = []
    for ident in idents:
        if ident.kind == "copied" and ident.a_path and ident.b_path:
            out.append(
                Covering(kind="copy", source=ident.a_path, dest=ident.b_path, repo=repo, event_rev=b)
            )
        elif ident.kind == "renamed" and ident.a_path and ident.b_path:
            out.append(
                Covering(kind="follow", source=ident.a_path, dest=ident.b_path, repo=repo, event_rev=b)
            )
    return out, cache.probes


# --- covering ingest -------------------------------------------------------


ARROW_RE = re.compile(r"\s*(?:→|->)\s*")
COPY_LINE_RE = re.compile(
    r"(?:^#\s*[C]\s+\d+\s+)?copy\s+(.+?)\s*(?:→|->)\s*(.+)$",
    re.IGNORECASE,
)
FOLLOW_LINE_RE = re.compile(
    r"(?:^#\s*[R]\s+\d+\s+)?follow\s+(.+?)\s*(?:→|->)\s*(.+)$",
    re.IGNORECASE,
)
WALK_TOOLS = {"held", "berth", "crib", "perch", "roost", "ditto"}


def _strip_sheaf_tail(dest: str) -> str:
    dest = dest.rstrip()
    dest = re.sub(r"\s{2,}\d+\s+paths?\s*$", "", dest)
    dest = re.sub(r"\s{2,}.*$", "", dest)
    return dest.strip()


def add_covering(out: list[Covering], cov: Covering) -> None:
    key = (cov.kind, cov.source, cov.dest)
    for existing in out:
        if (existing.kind, existing.source, existing.dest) == key:
            if cov.repo and not existing.repo:
                existing.repo = cov.repo
            if cov.event_rev and not existing.event_rev:
                existing.event_rev = cov.event_rev
            return
    out.append(cov)


def parse_copy_follow_text(line: str) -> Optional[Covering]:
    raw = line.strip()
    if not raw:
        return None
    body = raw[1:].strip() if raw.startswith("#") else raw
    # drop leading C/R rank columns: "C   26  copy ..."
    body = re.sub(r"^[CR]\s+\d+\s+", "", body)
    m = COPY_LINE_RE.search(body)
    if m:
        src = unquote_token(m.group(1))
        dst = unquote_token(_strip_sheaf_tail(m.group(2)))
        if src and dst:
            return Covering(kind="copy", source=src, dest=dst, raw=raw)
    m = FOLLOW_LINE_RE.search(body)
    if m:
        src = unquote_token(m.group(1))
        dst = unquote_token(_strip_sheaf_tail(m.group(2)))
        if src and dst:
            return Covering(kind="follow", source=src, dest=dst, raw=raw)
    return None


def parse_walk_argv(line: str) -> Optional[dict]:
    try:
        parts = shlex.split(line, posix=True)
    except ValueError:
        return None
    if not parts or parts[0] not in WALK_TOOLS:
        return None
    info: dict = {
        "tool": parts[0],
        "repo": None,
        "rev": None,
        "follow": False,
        "full": False,
        "now": False,
        "observer": None,
        "path": None,
        "paths": [],
    }
    i = 1
    while i < len(parts):
        tok = parts[i]
        if tok in ("-C", "--repo") and i + 1 < len(parts):
            info["repo"] = parts[i + 1]
            i += 2
            continue
        if tok in ("--rev",) and i + 1 < len(parts):
            info["rev"] = parts[i + 1]
            i += 2
            continue
        if tok == "--limit" and i + 1 < len(parts):
            i += 2
            continue
        if tok == "--follow":
            info["follow"] = True
            i += 1
            continue
        if tok == "--full":
            info["full"] = True
            i += 1
            continue
        if tok == "--now":
            info["now"] = True
            i += 1
            continue
        if tok in ("--no-follow", "--boolean", "--json", "--oneline", "-q", "--quiet"):
            i += 1
            continue
        if tok in ("exists", "copy", "grep"):
            info["observer"] = tok
            rest = parts[i + 1 :]
            # grep flags
            j = 0
            while j < len(rest) and rest[j].startswith("-") and rest[j] != "--":
                j += 1
            if tok == "grep":
                # not a covering occupancy we walk
                info["path"] = rest[j] if j < len(rest) else None
            else:
                info["path"] = rest[j] if j < len(rest) else None
                info["paths"] = rest[j:]
            break
        i += 1
    return info


def coverings_from_json(data: object) -> list[Covering]:
    out: list[Covering] = []
    if not isinstance(data, dict):
        return out
    repo = data.get("repo") if isinstance(data.get("repo"), str) else None
    event_rev = None
    b = data.get("b")
    if isinstance(b, dict) and isinstance(b.get("sha"), str):
        event_rev = b["sha"]
    elif isinstance(b, str):
        event_rev = b

    def from_pred(pred: dict, *, walk_copy: Optional[bool] = None, walk_follow: Optional[bool] = None) -> None:
        kind = pred.get("kind")
        src = pred.get("from") or pred.get("from_path")
        dst = pred.get("to") or pred.get("to_path") or pred.get("path")
        if kind == "copy" or walk_copy:
            if not src or not dst:
                note = pred.get("note") or ""
                parsed = parse_copy_follow_text(str(note))
                if parsed:
                    src, dst = parsed.source, parsed.dest
            if src and dst:
                add_covering(
                    out,
                    Covering(kind="copy", source=str(src), dest=str(dst), repo=repo, event_rev=event_rev),
                )
        elif kind == "follow" or walk_follow:
            if not src or not dst:
                note = pred.get("note") or ""
                parsed = parse_copy_follow_text(str(note))
                if parsed:
                    src, dst = parsed.source, parsed.dest
            if src and dst:
                add_covering(
                    out,
                    Covering(kind="follow", source=str(src), dest=str(dst), repo=repo, event_rev=event_rev),
                )

    for key in ("sheaf", "cover", "predicates"):
        items = data.get(key)
        if isinstance(items, list):
            for pred in items:
                if isinstance(pred, dict):
                    from_pred(pred)
    walks = data.get("walks")
    if isinstance(walks, list):
        for walk in walks:
            if not isinstance(walk, dict):
                continue
            if walk.get("copy"):
                src = walk.get("from")
                dst = walk.get("to")
                if src and dst:
                    add_covering(
                        out,
                        Covering(
                            kind="copy",
                            source=str(src),
                            dest=str(dst),
                            repo=repo,
                            event_rev=walk.get("rev") or event_rev,
                        ),
                    )
            elif walk.get("follow"):
                src = walk.get("from")
                dst = walk.get("to")
                if src and dst:
                    add_covering(
                        out,
                        Covering(
                            kind="follow",
                            source=str(src),
                            dest=str(dst),
                            repo=repo,
                            event_rev=walk.get("rev") or event_rev,
                        ),
                    )
            elif isinstance(walk.get("line"), str):
                # recovered below via walk line + classify
                pass
    return out


def parse_stdin_text(text: str) -> tuple[list[Covering], list[dict], list[str]]:
    """Return (coverings, walk infos, skipped notes)."""
    stripped = text.strip()
    if stripped.startswith("{") or stripped.startswith("["):
        try:
            data = json.loads(stripped)
        except json.JSONDecodeError:
            data = None
        if data is not None:
            if isinstance(data, list):
                covs: list[Covering] = []
                for item in data:
                    if isinstance(item, dict):
                        covs.extend(coverings_from_json(item))
                return covs, [], []
            return coverings_from_json(data), [], []

    coverings: list[Covering] = []
    walks: list[dict] = []
    skipped: list[str] = []
    for raw in text.splitlines():
        line = raw.rstrip("\n")
        if not line.strip():
            continue
        cov = parse_copy_follow_text(line)
        if cov:
            add_covering(coverings, cov)
            continue
        info = parse_walk_argv(line.strip())
        if info:
            walks.append(info)
            continue
        if line.lstrip().startswith("#"):
            continue
        if line.lstrip().startswith("held ") or line.lstrip().startswith("berth "):
            skipped.append(line.strip())
    return coverings, walks, skipped


def recover_from_walks(
    walks: list[dict],
    coverings: list[Covering],
    default_repo: Optional[str],
) -> list[str]:
    """Turn dest-exists / --follow exists walks into coverings via two-tree classify."""
    notes: list[str] = []
    for info in walks:
        repo = info.get("repo") or default_repo
        rev = info.get("rev")
        path = info.get("path")
        observer = info.get("observer")
        if observer == "grep":
            if path:
                notes.append(f"skip grep {quote(path)} (not copy/follow)")
            else:
                notes.append("skip grep covering (not copy/follow)")
            continue
        if observer not in ("exists", "copy") or not path:
            continue
        if not repo:
            notes.append(f"walk {observer} {quote(path)} has no -C repo")
            continue
        repo = resolve_repo(repo)
        # dest-exists / --follow exists paste: recover covering at rev^..rev
        if not rev:
            if info.get("follow"):
                add_covering(
                    coverings,
                    Covering(kind="follow", source=path, dest=path, repo=repo, event_rev=rev),
                )
            else:
                notes.append(f"exists {quote(path)} has no --rev to recover covering")
            continue
        parent = f"{rev}^"
        r = run_git(repo, ["rev-parse", "--verify", parent], check=False)
        if r.returncode != 0:
            notes.append(f"cannot resolve {parent} to recover covering of {quote(path)}")
            continue
        found, _probes = classify_pair(repo, parent, rev)
        want = "follow" if info.get("follow") else None
        matched = [
            c
            for c in found
            if path in (c.source, c.dest) and (want is None or c.kind == want)
        ]
        if not matched and want == "follow":
            matched = [c for c in found if c.kind == "follow"]
        if not matched:
            notes.append(
                f"{quote(path)} at {rev[:7] if len(rev) >= 7 else rev} is not copy/follow "
                f"(unique birth?). held exists {quote(path)}"
            )
            continue
        for c in matched:
            c.repo = repo
            c.event_rev = rev
            add_covering(coverings, c)
    return notes


