        (hist / "src" / "web.py").write_text(old_py, encoding="utf-8")
        (hist / "src" / "__init__.py").write_text("", encoding="utf-8")
        (hist / "tests" / "test_web.py").write_text(old_test, encoding="utf-8")
        _commit(hist, "seed isWebApp")
        (hist / "src" / "web.py").write_text(
            '''\
def isBrowser(name):
    return name in ("Safari", "Chrome", "Brave Browser")

def tick(app):
    isBrowser(app)
''',
            encoding="utf-8",
        )
        (hist / "tests" / "test_web.py").write_text(
            '''\
from src.web import isBrowser

def test_safari():
    isBrowser("Safari")
''',
            encoding="utf-8",
        )
        _commit(hist, "rename isWebApp -> isBrowser, callers now dynamic")

        # hatch/sow assumption: HEAD name is identity — leftover old-name world is invisible
        _, _, no_left = analyze(leftover, follow=False)
        no_browser = [r for r in no_left if r.fn.name == "isBrowser" and r.fn.lang == "py"]
        ok(bool(no_browser), "no-follow still sees HEAD isBrowser")
        if no_browser:
            ok(
                not any("Brave" in f.label for f in no_browser[0].due),
                f"no-follow must miss leftover Brave { [f.label for f in no_browser[0].due] }",
            )

        _, _, yes_left = analyze(leftover, follow=True)
        yes_py = [r for r in yes_left if r.fn.name == "isBrowser" and r.fn.lang == "py"]
        ok(bool(yes_py), "follow finds leftover isBrowser")
        if yes_py:
            ok("isWebApp" in yes_py[0].aka, f"aka lists isWebApp {yes_py[0].aka}")
            ok(
                not any(is_test_path(h.path) for h in yes_py[0].hops),
                f"test-path hops must not form identity {yes_py[0].hops}",
            )
            ok("aka\t" in render_aka_map(yes_left) and "isWebApp" in render_aka_map(yes_left), "aka-map lists hop")
            ok(
                any("Brave" in f.label and f.status == "due" for f in yes_py[0].fixtures),
                f"leftover Brave is due { [f.label for f in yes_py[0].due] }",
            )
            ok(
                not any(f.status == "due" and "Safari" in f.label for f in yes_py[0].fixtures),
                "Safari is a HEAD test world, not due",
            )
            emitted = render_tests(yes_py, due_only=True, emit="pytest")
            ok("Brave Browser" in emitted, f"leftover emit pins Brave {emitted}")
            ok("isBrowser" in emitted and "isWebApp(" not in emitted, "emit uses HEAD name")
            ok("assert isBrowser" in emitted, f"predicate leftover pytest asserts {emitted}")
            ok("def test_safari" in emitted, "leftover seats into existing test_web.py")

        yes_sw = [r for r in yes_left if r.fn.name == "isBrowser" and r.fn.lang == "swift"]
        ok(bool(yes_sw), "follow finds leftover Swift isBrowser")
        if yes_sw:
            xct_left = render_tests(yes_sw, due_only=True, emit="xctest")
            ok("import XCTest" in xct_left, "swift leftover is XCTest")
            ok("Brave Browser" in xct_left, f"swift leftover pins Brave {xct_left}")
            ok("..." not in xct_left, "no Swift ellipsis")
            ok("isBrowser" in xct_left, "swift emit uses HEAD name")
            ok("XCTAssertTrue" in xct_left, f"predicate leftover world asserts {xct_left}")
            ok("WindowTitleParserTests" in xct_left, "leftover seats into existing class")
            ok("SeatTests" not in xct_left, "leftover must not sibling")
            ok("func testSafari" in xct_left, "leftover keeps existing testSafari")

        # query by the dead name
        filt = filter_reports(yes_left, ["isWebApp"], min_callers=1, due_only=False)
        ok(any(r.fn.name == "isBrowser" for r in filt), "query isWebApp follows to isBrowser")

        # historical-only: Brave exists only as isWebApp("Brave Browser") last week
        _, _, no_hist = analyze(hist, follow=False)
        nh = [r for r in no_hist if r.fn.name == "isBrowser"]
        if nh:
            ok(
                not any("Brave" in f.label for f in nh[0].due),
                f"no-follow misses historical Brave { [f.label for f in nh[0].due] }",
            )
        _, _, yes_hist = analyze(hist, follow=True)
        yh = [r for r in yes_hist if r.fn.name == "isBrowser"]
        ok(bool(yh), "follow finds historical isBrowser")
        if yh:
            ok(
                any("Brave" in f.label and f.status == "due" for f in yh[0].fixtures),
                f"historical Brave is due { [f.label for f in yh[0].due] }",
            )
            hist_emit = render_tests(yh, due_only=True, emit="pytest")
            ok("Brave Browser" in hist_emit, f"historical emit pins Brave {hist_emit}")
            ok(any(c.commit for c in yh[0].calls if not c.is_test), "historical call tagged with commit")

        # --aka without trusting git hop detection
        _, _, aka_only = analyze(leftover, follow=True, aka_specs=["isWebApp=isBrowser"])
        aka_py = [r for r in aka_only if r.fn.name == "isBrowser" and r.fn.lang == "py"]
        ok(bool(aka_py) and any("Brave" in f.label for f in aka_py[0].due), "--aka attaches leftover Brave")

        # --check still 1
        ok(any(r.due for r in yes_left), "rename fixture has dues for --check")

    if failures:
        print("SELF-TEST FAILURES:")
        for f in failures:
            print("  FAIL", f)
        return 1
    print("self-test ok")
    return 0


