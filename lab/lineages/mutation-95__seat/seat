def analyze(
    root: Path,
    exclude: list[str] | None = None,
    include_test_defs: bool = False,
    follow: bool = True,
    since: Optional[str] = None,
    rev_range: Optional[str] = None,
    max_follow: int = 80,
    aka_specs: list[str] | None = None,
    names: list[str] | None = None,
    rank: bool = True,
    construct: bool = True,
    seat: bool = True,
) -> tuple[list[FuncDef], list[Call], list[Report]]:
    files = list_source_files(root, exclude)
    defs: list[FuncDef] = []
    calls: list[Call] = []
    collections: dict[str, dict[str, list[str]]] = {}
    for p in files:
        d, c, cols = parse_file(p, root)
        defs.extend(d)
        calls.extend(c)
        if cols:
            try:
                rel = str(p.relative_to(root))
            except ValueError:
                rel = str(p)
            collections[rel] = cols

    identities: dict[str, Identity] = {}
    if follow:
        hops = parse_aka_specs(aka_specs)
        if git_ok(root):
            restrict = None
            if names:
                restrict = files_touching_names(root, names, defs)
            hops = hops + detect_rename_hops(
                root, since=since, rev_range=rev_range, max_commits=max_follow, paths=restrict
            )
        identities = resolve_identities(defs, hops)
        # if the user named an old token, still attach it even when git missed the hop
        if names:
            head_live = {d.name for d in defs if not d.is_test and not is_test_path(d.path)}
            for spec_name in names:
                if spec_name in identities or spec_name in head_live:
                    continue
                # old name: bind onto any identity that already lists it, else leave
                for ident in identities.values():
                    if spec_name in ident.names:
                        break
        historical = harvest_historical_calls(root, identities, max_revs=min(40, max_follow))
        if historical:
            calls.extend(historical)
        # leftover HEAD callers keep their written name; matching uses aliases
        for c in calls:
            if c.cited is None:
                for ident in identities.values():
                    if c.name in ident.names and c.name != ident.head:
                        c.cited = c.name
                        break

    reports = build_reports(
        defs,
        calls,
        include_test_defs=include_test_defs,
        collections=collections,
        identities=identities,
    )
    apply_io_rank(reports, rank=rank, defs=defs)
    attach_constructs(reports, defs, calls, construct=construct)
    attach_seats(reports, root, defs, calls, seat=seat, exclude=exclude)
    return defs, calls, reports


def filter_reports(
    reports: list[Report],
    names: list[str],
    min_callers: int,
    due_only: bool,
) -> list[Report]:
    out = []
    want = {n.lower() for n in names}
    for r in reports:
        nprod = sum(1 for c in r.calls if not c.is_test)
        if nprod == 0:
            continue
        if not names and nprod < min_callers:
            continue
        if want:
            hay = {r.fn.name.lower(), r.fn.qualname.lower()}
            hay.update(a.lower() for a in r.aka)
            qual = r.fn.qualname.lower()
            if not (hay & want) and not any(
                qual.endswith("." + n) or qual.endswith("::" + n) for n in want
            ):
                continue
        if due_only and not r.due:
            continue
        out.append(r)
    return out


