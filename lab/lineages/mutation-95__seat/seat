# file parsers
# ---------------------------------------------------------------------------

def _py_decorator_names(node: ast.AST) -> list[str]:
    names: list[str] = []
    for d in getattr(node, "decorator_list", []) or []:
        if isinstance(d, ast.Name):
            names.append(d.id)
        elif isinstance(d, ast.Attribute):
            names.append(d.attr)
        elif isinstance(d, ast.Call):
            if isinstance(d.func, ast.Name):
                names.append(d.func.id)
            elif isinstance(d.func, ast.Attribute):
                names.append(d.func.attr)
    return names


def _leading_static(toks: list[Tok], i: int) -> bool:
    """True when `static` / Swift `class func` sits immediately before a def keyword."""
    j = i - 1
    mods = {
        "public",
        "private",
        "internal",
        "fileprivate",
        "open",
        "override",
        "mutating",
        "nonmutating",
        "final",
        "required",
        "convenience",
        "distributed",
        "async",
        "throws",
        "rethrows",
        "pub",
        "unsafe",
        "const",
        "default",
        "export",
        "isolated",
        "nonisolated",
        "package",
        "indirect",
        "optional",
        "weak",
        "unowned",
    }
    saw_class = False
    while j >= 0:
        t = toks[j]
        if t.k == "op" and t.v in ("@", "\n"):
            j -= 1
            continue
        if t.k == "attr":
            j -= 1
            continue
        if t.k == "id" and t.v in mods:
            j -= 1
            continue
        if t.k == "id" and t.v == "static":
            return True
        if t.k == "id" and t.v == "class":
            # Swift `class func` is a static-like method; `class Type {` is a type.
            saw_class = True
            j -= 1
            continue
        break
    return saw_class


def _inner_has_self(inner: list[Tok]) -> bool:
    text = "".join(t.v for t in inner)
    return bool(re.search(r"(?:^|[,<(\s])(?:&(?:mut)?)?self(?:$|[,>)\s:])", text.replace(" ", ""))) or bool(
        re.search(r"\b(?:&(?:mut\s+)?)?self\b", " ".join(t.v for t in inner if t.k in ("id", "op")))
    )


def parse_python(path: str, src: str) -> tuple[list[FuncDef], list[Call], dict[str, str]]:
    try:
        tree = ast.parse(src)
    except SyntaxError:
        return [], [], {}
    consts: dict[str, str] = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            lit = _ast_literal(node.value)
            if lit is not None:
                consts[node.targets[0].id] = lit
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) and node.value is not None:
            lit = _ast_literal(node.value)
            if lit is not None:
                consts[node.target.id] = lit
    defs: list[FuncDef] = []
    file_test = is_test_path(path)

    class DefVis(ast.NodeVisitor):
        def __init__(self) -> None:
            self.stack: list[str] = []
            self.class_stack: list[str] = []
            self.test_stack: list[bool] = []

        def _visit_fn(self, node: ast.FunctionDef | ast.AsyncFunctionDef) -> None:
            params: list[Param] = []
            args = node.args
            npos = len(args.posonlyargs) + len(args.args)
            defaults = args.defaults
            pad = npos - len(defaults)
            all_pos = list(args.posonlyargs) + list(args.args)
            first_arg = all_pos[0].arg if all_pos else None
            for i, a in enumerate(all_pos):
                if a.arg in ("self", "cls"):
                    continue
                default = None
                if i >= pad:
                    default = _ast_literal(defaults[i - pad])
                    if default is None and isinstance(defaults[i - pad], ast.Name) and defaults[i - pad].id in consts:
                        default = consts[defaults[i - pad].id]
                params.append(Param(a.arg, default))
            for a, d in zip(args.kwonlyargs, args.kw_defaults):
                default = _ast_literal(d) if d is not None else None
                params.append(Param(a.arg, default))
            deco = _py_decorator_names(node)
            is_test = file_test or node.name.startswith("test") or "fixture" in deco or any(
                isinstance(d, ast.Name) and d.id == "pytest" for d in node.decorator_list
            ) or self.test_stack[-1] if self.test_stack else False
            end = getattr(node, "end_lineno", node.lineno) or node.lineno
            start_off = _offset_at_line(src, node.lineno)
            end_off = _offset_at_line(src, end + 1) if end < src.count("\n") + 1 else len(src)
            body = ast.get_source_segment(src, node) or ""
            direct_method = bool(self.class_stack) and (not self.stack or self.stack[-1] == self.class_stack[-1])
            recv = self.class_stack[-1] if direct_method else None
            if recv:
                if "staticmethod" in deco or "classmethod" in deco or first_arg == "cls":
                    kind = "static"
                elif first_arg == "self":
                    kind = "instance"
                else:
                    kind = "static"
            else:
                kind = "free"
            defs.append(
                FuncDef(
                    name=node.name,
                    qualname=".".join(self.stack + [node.name]),
                    params=params,
                    path=path,
                    line=node.lineno,
                    lang="py",
                    is_test=bool(is_test),
                    start=start_off,
                    end=end_off,
                    body=body,
                    recv=recv,
                    kind=kind,
                    type_kind="class" if recv else "",
                    decorators=tuple(deco),
                )
            )
            self.stack.append(node.name)
            self.test_stack.append(bool(is_test))
            self.generic_visit(node)
            self.stack.pop()
            self.test_stack.pop()

        def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
            self._visit_fn(node)

        def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> None:
            self._visit_fn(node)

        def visit_ClassDef(self, node: ast.ClassDef) -> None:
            self.stack.append(node.name)
            self.class_stack.append(node.name)
            self.generic_visit(node)
            self.class_stack.pop()
            self.stack.pop()

    DefVis().visit(tree)

    calls: list[Call] = []

    class CallVis(ast.NodeVisitor):
        def __init__(self) -> None:
            self.fn_stack: list[FuncDef] = []
            self._by_pos = {(d.start, d.name): d for d in defs}

        def _current(self) -> Optional[FuncDef]:
            return self.fn_stack[-1] if self.fn_stack else None

        def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
            self._enter(node)

        def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> None:
            self._enter(node)

        def _enter(self, node: ast.AST) -> None:
            start_off = _offset_at_line(src, getattr(node, "lineno", 1))
            match = None
            name = getattr(node, "name", "")
            for d in defs:
                if d.name == name and abs(d.start - start_off) < 4:
                    match = d
                    break
            if match:
                self.fn_stack.append(match)
            self.generic_visit(node)
            if match:
                self.fn_stack.pop()

        def visit_Call(self, node: ast.Call) -> None:
            name, recv = _ast_callee(node.func)
            if not name:
                self.generic_visit(node)
                return
            cur = self._current()
            is_test = file_test or (cur.is_test if cur else False)
            params = None
            args: list[Arg] = []
            bags: dict[str, Arg] = {}
            for i, a in enumerate(node.args):
                if isinstance(a, ast.Dict):
                    for k, v in zip(a.keys, a.values):
                        if isinstance(k, ast.Constant) and isinstance(k.value, str):
                            bags[k.value] = _ast_arg(0, k.value, v, consts)
                    args.append(Arg(i, None, "dyn", "{...}"))
                    continue
                args.append(_ast_arg(i, None, a, consts))
            for kw in node.keywords:
                if kw.arg is None:
                    continue
                if isinstance(kw.value, ast.Dict):
                    for k, v in zip(kw.value.keys, kw.value.values):
                        if isinstance(k, ast.Constant) and isinstance(k.value, str):
                            bags[k.value] = _ast_arg(0, k.value, v, consts)
                args.append(_ast_arg(len(args), kw.arg, kw.value, consts))
            raw = ast.get_source_segment(src, node) or name
            calls.append(
                Call(
                    name=name,
                    recv=recv,
                    args=args,
                    bags=bags,
                    path=path,
                    line=node.lineno,
                    is_test=is_test,
                    caller=cur.qualname if cur else None,
                    raw=(raw or name)[:240],
                )
            )
            self.generic_visit(node)

    CallVis().visit(tree)
    return defs, calls, consts


def _offset_at_line(src: str, lineno: int) -> int:
    if lineno <= 1:
        return 0
    n = 1
    for i, c in enumerate(src):
        if c == "\n":
            n += 1
            if n == lineno:
                return i + 1
    return len(src)


def _ast_literal(node: ast.AST | None) -> Optional[str]:
    if node is None:
        return None
    if isinstance(node, ast.Constant):
        v = node.value
        if v is None:
            return "null"
        if isinstance(v, bool):
            return "true" if v else "false"
        if isinstance(v, (int, float)):
            return canon_lit(repr(v))
        if isinstance(v, str):
            if "${" in v or "\\(" in v:
                return None
            return canon_lit(json.dumps(v))
        return None
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
        inner = _ast_literal(node.operand)
        if inner is not None and isinstance(node.op, ast.USub) and inner != "null":
            if inner.startswith("-"):
                return inner[1:]
            return "-" + inner
        return inner
    return None


def _ast_callee(node: ast.AST) -> tuple[Optional[str], Optional[str]]:
    if isinstance(node, ast.Name):
        return node.id, None
    if isinstance(node, ast.Attribute):
        recv = None
        if isinstance(node.value, ast.Name):
            recv = node.value.id
        elif isinstance(node.value, ast.Call):
            inner_name, inner_recv = _ast_callee(node.value.func)
            recv = inner_name or inner_recv
        elif isinstance(node.value, ast.Attribute) and isinstance(node.value.value, ast.Name):
            recv = node.value.attr
        return node.attr, recv
    return None, None


def _ast_arg(index: int, name: Optional[str], node: ast.AST, consts: dict[str, str]) -> Arg:
    lit = _ast_literal(node)
    if lit is not None:
        return Arg(index, name, "lit", lit)
    if isinstance(node, ast.Name):
        if node.id in consts:
            return Arg(index, name, "lit", consts[node.id])
        return Arg(index, name, "dyn", None)
    if isinstance(node, ast.Attribute):
        # Mode.FAST or obj.x — if attr is const-like, literal tag
        if looks_const_name(node.attr) or (isinstance(node.value, ast.Name) and looks_const_name(node.value.id)):
            recv = node.value.id if isinstance(node.value, ast.Name) else "?"
            return Arg(index, name, "lit", f"{recv}.{node.attr}")
        return Arg(index, name, "dyn", None)
    return Arg(index, name, "dyn", None)


def parse_generic(path: str, src: str, lang: str) -> tuple[list[FuncDef], list[Call], dict[str, str]]:
    toks = tokenize(src, lang)
    consts: dict[str, str] = _file_consts(toks, lang)
    defs: list[FuncDef] = []
    file_test = is_test_path(path)

    # walk for defs + context
    type_stack: list[tuple[str, int, str]] = []  # (name, brace_depth_inside, type_kind)
    brace = 0
    test_mod_depth = -1
    pending_test_attr = False
    pending_cfg_test = False
    i = 0
    n = len(toks)

    def skip_generics(j: int) -> int:
        if j < n and toks[j].k == "op" and toks[j].v == "<":
            depth = 1
            j += 1
            while j < n and depth:
                if toks[j].k == "op" and toks[j].v == "<":
                    depth += 1
                elif toks[j].k == "op" and toks[j].v == ">":
                    depth -= 1
                j += 1
        return j

    while i < n:
        t = toks[i]
        if t.k == "attr":
            if "test" in t.v and "cfg" not in t.v:
                pending_test_attr = True
            if "cfg(test)" in t.v.replace(" ", "") or "cfg( test )" in t.v:
                pending_cfg_test = True
            i += 1
            continue
        if t.k == "op" and t.v == "{":
            brace += 1
            if pending_cfg_test:
                test_mod_depth = brace
                pending_cfg_test = False
            i += 1
            continue
        if t.k == "op" and t.v == "}":
            if test_mod_depth == brace:
                test_mod_depth = -1
            brace -= 1
            while type_stack and type_stack[-1][1] > brace:
                type_stack.pop()
            i += 1
            continue
        if t.k == "id" and t.v in ("impl", "struct", "enum", "class", "trait", "extension", "protocol", "interface", "mod", "actor"):
            kind = t.v
            j = i + 1
            # rust impl Trait for Type / impl Type
            # swift/js class SiteObserver: @unchecked Sendable  → first ident, not the protocol
            mods = {
                "for",
                "pub",
                "where",
                "unsafe",
                "crate",
                "self",
                "open",
                "final",
                "public",
                "private",
                "internal",
                "fileprivate",
                "static",
                "override",
                "mutating",
                "indirect",
                "unowned",
                "weak",
                "lazy",
                "required",
                "convenience",
                "nonisolated",
                "unchecked",
                "optional",
                "package",
            }
            first = last = None
            saw_for = False
            while j < n and not (toks[j].k == "op" and toks[j].v in "{;"):
                if toks[j].k == "op" and toks[j].v == "<":
                    j = skip_generics(j)
                    continue
                if toks[j].k == "op" and toks[j].v == "@":
                    j += 2
                    continue
                if toks[j].k == "id" and toks[j].v == "for":
                    saw_for = True
                    first = None
                    last = None
                    j += 1
                    continue
                if toks[j].k == "id" and toks[j].v not in mods and not toks[j].v.startswith("'"):
                    if first is None:
                        first = toks[j].v
                    last = toks[j].v
                j += 1
            if kind == "impl":
                name = last or first
            else:
                name = first
            if kind == "mod" and pending_cfg_test:
                pass
            if name and kind != "mod":
                type_stack.append((name, brace + 1, kind))
            i += 1
            continue

        is_fn_kw = t.k == "id" and t.v in DEF_KW
        # Swift `init(` is a constructor, not `func init`
        swift_init = lang == "swift" and t.k == "id" and t.v == "init"
        # js: ident = (  or ident = async (  or ident = function
        js_assign = False
        if lang == "js" and t.k == "id" and t.v not in NOT_CALL:
            j = i + 1
            if j < n and toks[j].k == "op" and toks[j].v == "=":
                k = j + 1
                if k < n and toks[k].k == "id" and toks[k].v in ("async", "function"):
                    if toks[k].v == "function":
                        js_assign = True
                    else:
                        k += 1
                        if k < n and toks[k].k == "id" and toks[k].v == "function":
                            js_assign = True
                        elif k < n and toks[k].k == "op" and toks[k].v == "(":
                            js_assign = True
                elif k < n and toks[k].k == "op" and toks[k].v == "(":
                    js_assign = True

        if is_fn_kw or js_assign or swift_init:
            recv = type_stack[-1][0] if type_stack else None
            type_kind = type_stack[-1][2] if type_stack else ""
            is_static = _leading_static(toks, i)
            if swift_init:
                name = "init"
                j = i + 1
                j = skip_generics(j)
            elif is_fn_kw:
                j = i + 1
                # go receiver func (s *T) Name
                if lang == "go" and j < n and toks[j].k == "op" and toks[j].v == "(":
                    j = _skip_balanced(toks, j) + 1
                    recv_ids = [x.v for x in toks[i + 2 : j] if x.k == "id"]
                    if recv_ids:
                        recv = recv_ids[-1].lstrip("*")
                j = skip_generics(j)
                if j >= n or toks[j].k != "id":
                    i += 1
                    continue
                name = toks[j].v
                j += 1
                j = skip_generics(j)
            else:
                name = t.v
                j = i + 1
                while j < n and not (toks[j].k == "op" and toks[j].v == "("):
                    j += 1
            if j >= n or not (toks[j].k == "op" and toks[j].v == "("):
                i += 1
                continue
            close = _skip_balanced(toks, j)
            inner = toks[j + 1 : close]
            params = parse_params(lang, inner)
            has_self = _inner_has_self(inner)
            if is_static and recv:
                kind = "static"
            elif recv and lang == "rs":
                kind = "instance" if has_self else "static"
            elif recv and lang == "go":
                kind = "instance"
            elif recv:
                kind = "instance"
            else:
                kind = "free"
            # find body
            k = close + 1
            while k < n and not (toks[k].k == "op" and toks[k].v in "{;=") and not (
                lang == "js" and toks[k].k == "op" and toks[k].v == "=>"
            ):
                k += 1
            body_start = toks[j].i
            body_end = toks[k].i if k < n else toks[close].i
            if k < n and toks[k].k == "op" and toks[k].v == "=>":
                k += 1
            if k < n and toks[k].k == "op" and toks[k].v == "{":
                endtok = _skip_balanced(toks, k)
                body_start = toks[k].i
                body_end = toks[endtok].i + 1 if endtok < n else len(src)
            else:
                # no brace body
                endtok = k
                body_end = toks[min(k, n - 1)].i if n else len(src)
            is_test = (
                file_test
                or pending_test_attr
                or (test_mod_depth >= 0)
                or name.startswith("test")
                or name.startswith("Test")
                or name.startswith("it")
            )
            pending_test_attr = False
            q = f"{recv}.{name}" if recv else name
            defs.append(
                FuncDef(
                    name=name,
                    qualname=q,
                    params=params,
                    path=path,
                    line=t.line,
                    lang=lang,
                    is_test=is_test,
                    start=t.i,
                    end=body_end,
                    body=src[body_start:body_end],
                    recv=recv,
                    kind=kind,
                    type_kind=type_kind,
                )
            )
            i = close + 1
            continue
        i += 1

    # calls
    calls: list[Call] = []
    i = 0
    while i < n:
        t = toks[i]
        if t.k != "id" or t.v in NOT_CALL or t.v.endswith("!"):
            i += 1
            continue
        recv = None
        # recv.ident or recv::ident  — including Type().method
        if i >= 2 and toks[i - 1].k == "op" and toks[i - 1].v in (".", "::"):
            if toks[i - 2].k == "id":
                recv = toks[i - 2].v
            elif toks[i - 2].k == "op" and toks[i - 2].v == ")":
                depth = 0
                j = i - 2
                while j >= 0:
                    if toks[j].k == "op" and toks[j].v == ")":
                        depth += 1
                    elif toks[j].k == "op" and toks[j].v == "(":
                        depth -= 1
                        if depth == 0:
                            if j >= 1 and toks[j - 1].k == "id":
                                recv = toks[j - 1].v
                            break
                    j -= 1
        j = i + 1
        j = skip_generics(j) if lang in ("rs", "go", "swift", "js") else j
        # skip type args in ts ident<T>(
        if j < n and toks[j].k == "op" and toks[j].v == "<":
            j = skip_generics(j)
        if j >= n or not (toks[j].k == "op" and toks[j].v == "("):
            i += 1
            continue
        # if previous token is def keyword, this is a def name not a call
        if i >= 1 and toks[i - 1].k == "id" and toks[i - 1].v in DEF_KW:
            i += 1
            continue
        close = _skip_balanced(toks, j)
        inner = toks[j + 1 : close]
        # containing def
        pos = t.i
        container = _innermost_def(defs, path, pos)
        is_test = file_test or (container.is_test if container else False) or (
            container is not None and is_test_path(container.path)
        )
        params = container.params if container and container.name == t.v else None
        args, bags = parse_args(lang, inner, consts, params)
        raw = src[t.i : (toks[close].i + 1 if close < n else t.i + len(t.v))]
        calls.append(
            Call(
                name=t.v,
                recv=recv,
                args=args,
                bags=bags,
                path=path,
                line=t.line,
                is_test=is_test,
                caller=container.qualname if container else None,
                raw=raw[:240],
            )
        )
        # Walk into the argument list so nested calls are not swallowed
        # (test("x", () => { listen(8080) }) must still see listen).
        i = j + 1
    return defs, calls, consts


def _skip_balanced(toks: list[Tok], open_i: int) -> int:
    if open_i >= len(toks):
        return open_i
    pairs = {"(": ")", "{": "}", "[": "]"}
    op = toks[open_i].v
    cl = pairs.get(op)
    if not cl:
        return open_i
    depth = 0
    for j in range(open_i, len(toks)):
        t = toks[j]
        if t.k != "op":
            continue
        if t.v == op:
            depth += 1
        elif t.v == cl:
            depth -= 1
            if depth == 0:
                return j
    return len(toks) - 1


def _innermost_def(defs: list[FuncDef], path: str, pos: int) -> Optional[FuncDef]:
    best = None
    best_span = 10**18
    for d in defs:
        if d.path != path:
            continue
        if d.start <= pos < d.end:
            span = d.end - d.start
            if span < best_span:
                best = d
                best_span = span
    return best


def _file_consts(toks: list[Tok], lang: str) -> dict[str, str]:
    consts: dict[str, str] = {}
    i = 0
    n = len(toks)
    while i < n:
        t = toks[i]
        if t.k == "id" and (t.v.isupper() or (lang == "js" and i > 0 and toks[i - 1].k == "id" and toks[i - 1].v in ("const", "let"))):
            name = t.v
            j = i + 1
            # skip type anno
            if j < n and toks[j].k == "op" and toks[j].v == ":":
                j += 1
                while j < n and not (toks[j].k == "op" and toks[j].v in ("=", ";", ",")):
                    j += 1
            if j < n and toks[j].k == "op" and toks[j].v == "=":
                k = j + 1
                slice: list[Tok] = []
                while k < n:
                    tk = toks[k]
                    if tk.k == "op" and tk.v in (";", ",", "{", "}", ")"):
                        break
                    if tk.k == "id" and tk.v in DEF_KW | {"export", "pub", "const", "let", "var", "return", "if"}:
                        break
                    slice.append(tk)
                    k += 1
                    if len(slice) >= 4:
                        break
                lit = _literal_from_tokens(slice)
                if lit is not None:
                    consts[name] = lit
        i += 1
    return consts


def parse_file(path: Path, root: Path) -> tuple[list[FuncDef], list[Call], dict[str, list[str]]]:
    src = read_text(path)
    if src is None:
        return [], [], {}
    try:
        rel = str(path.relative_to(root))
    except ValueError:
        rel = str(path)
    lang = LANG_BY_EXT.get(path.suffix.lower())
    if not lang:
        return [], [], {}
    try:
        if lang == "py":
            defs, calls, _ = parse_python(rel, src)
        else:
            defs, calls, _ = parse_generic(rel, src, lang)
        cols = extract_collections(src)
    except Exception as ex:  # parser must not crash the census
        eprint(f"seat: skip {rel}: {ex}")
        return [], [], {}
    return defs, calls, cols


