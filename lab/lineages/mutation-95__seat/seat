def use_color(mode: str) -> bool:
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def wrap(enabled: bool, code: str, s: str) -> str:
    if not enabled:
        return s
    return f"\033[{code}m{s}\033[0m"


def rel_site(c: Call) -> str:
    base = f"{c.path}:{c.line}"
    if c.commit:
        short = c.commit[:8]
        cited = f" as {c.cited}" if c.cited and c.cited != c.name else ""
        return f"{base}@{short}{cited}"
    if c.cited and c.cited != c.name:
        return f"{base} as {c.cited}"
    return base


def fixture_record(r: Report, f: Fixture) -> dict:
    return {
        "fn": r.fn.name,
        "qualname": r.fn.qualname,
        "aka": list(r.aka),
        "def": {
            "path": r.fn.path,
            "line": r.fn.line,
            "lang": r.fn.lang,
            "params": [
                {"name": p.name, **({"default": p.default} if p.default is not None else {})}
                for p in r.fn.params
            ],
        },
        "kind": f.kind,
        "status": f.status,
        "generable": f.generable,
        "args": f.args,
        "label": f.label,
        "sites": f.sites,
        "suggest": f.suggest,
        "collection": f.collection,
        "param": f.param,
        "io": f.io or None,
        "io_score": f.io_score,
        "kind_fn": r.fn.kind,
        "construct": None
        if r.construct is None
        else {
            "type": r.construct.type_name,
            "expr": r.construct.expr,
            "binding": r.construct.binding,
            "origin": r.construct.origin,
        },
        "seat": None
        if r.seat is None
        else {
            "name": r.seat.name,
            "path": r.seat.path,
            "kind": r.seat.kind,
        },
    }


def iter_fixtures(reports: list[Report], due_only: bool) -> Iterator[tuple[Report, Fixture]]:
    for r in reports:
        for f in r.fixtures:
            if due_only and f.status != "due":
                continue
            yield r, f


def render_human(reports: list[Report], color: bool, show_all: bool, keep_sown: bool = False) -> str:
    lines: list[str] = []
    shown = 0
    for r in reports:
        due = r.due if not show_all else r.fixtures
        sown_keep = keep_sown and not r.due
        if not show_all and not r.due and not sown_keep:
            continue
        shown += 1
        params = ", ".join(
            (p.name + (f"={p.default}" if p.default is not None else "")) for p in r.fn.params
        )
        nprod = sum(1 for c in r.calls if not c.is_test)
        ndue = len(r.due)
        head = f"{r.fn.qualname}  {r.fn.path}:{r.fn.line}  ({params})"
        flag = wrap(color, "31;1", f"  {ndue} due") if ndue else wrap(color, "32", "  sown")
        lines.append(wrap(color, "1", head) + flag)
        lines.append(f"  prod:{nprod}  worlds:{sum(1 for w in r.worlds if w.n_prod)}  fixtures:{ndue}")
        if r.aka:
            chain = " → ".join(list(r.aka) + [r.fn.name])
            lines.append(f"  aka  {chain}")
        if r.construct:
            c = r.construct
            lines.append(f"  construct  {c.expr}  as {c.binding}  via {c.origin}")
        elif r.fn.kind == "instance" and r.fn.recv:
            lines.append(f"  construct  (none)  {r.fn.recv}.{r.fn.name} needs a receiver")
        if r.seat:
            lines.append(f"  seat  {r.seat.name}  {r.seat.path}  {r.seat.kind}")
        else:
            lines.append("  seat  (none)  fallback sibling")
        for h in r.hops[:6]:
            lines.append(f"  follow  {h.old} → {h.new}  {h.path}  {h.commit[:8]}")
        for g in r.members:
            miss = wrap(color, "31", fmt_vals(g.missing)) if g.missing else "[]"
            lines.append(
                f"  members {g.collection}  {g.param}  {len(g.members)}  "
                f"have={fmt_vals(g.witnessed)}  miss={miss}"
            )
        shown_fx = due if show_all else r.due
        for f in shown_fx:
            tag = wrap(color, "31" if f.status == "due" else "32", f.status)
            gen = "" if f.generable else wrap(color, "33", "  *")
            coll = f"  in {f.collection}" if f.collection else ""
            io = wrap(color, "35", f"  io={f.io}") if f.io else ""
            lines.append(f"  {tag:s}  {f.kind:6s}  {f.label}{coll}{io}{gen}")
            extra = f"  {f.suggest}"
            site = ("  " + ", ".join(f.sites[:3])) if f.sites else ""
            lines.append(f"         {extra.strip()}{site}")
        lines.append("")
    if not shown:
        nfn = len(reports)
        nd = sum(len(r.due) for r in reports)
        lines.append(f"no due fixtures  prod_fns={nfn} due={nd}")
    return "\n".join(lines).rstrip() + "\n"


def render_json(reports: list[Report], due_only: bool) -> str:
    """Test-generator input: a flat fixture list plus per-function grouping."""
    fixtures = [fixture_record(r, f) for r, f in iter_fixtures(reports, due_only)]
    functions = []
    for r in reports:
        fx = [fixture_record(r, f) for f in (r.due if due_only else r.fixtures)]
        if due_only and not fx:
            continue
        functions.append(
            {
                "name": r.fn.name,
                "qualname": r.fn.qualname,
                "def": {"path": r.fn.path, "line": r.fn.line, "params": [p.name for p in r.fn.params]},
                "n_prod": sum(1 for c in r.calls if not c.is_test),
                "due": len(r.due),
                "fixtures": fx,
            }
        )
    return json.dumps({"tool": "seat", "version": VERSION, "fixtures": fixtures, "functions": functions}, indent=2, ensure_ascii=False) + "\n"


def render_ndjson(reports: list[Report], due_only: bool) -> str:
    lines = [json.dumps(fixture_record(r, f), ensure_ascii=False) for r, f in iter_fixtures(reports, due_only)]
    return "\n".join(lines) + ("\n" if lines else "")


def render_tsv(reports: list[Report], due_only: bool) -> str:
    lines = ["kind\tfn\tpath\tline\tstatus\tlabel\tsuggest"]
    for r, f in iter_fixtures(reports, due_only):
        lines.append(
            f"{f.kind}\t{r.fn.qualname}\t{r.fn.path}\t{r.fn.line}\t{f.status}\t{f.label}\t{f.suggest}"
        )
    return "\n".join(lines) + "\n"


def render_aka_map(reports: list[Report]) -> str:
    """Stable identity table: aka<TAB>head<TAB>old<TAB>commit<TAB>path."""
    lines: list[str] = []
    seen: set[tuple[str, str]] = set()
    for r in reports:
        for h in r.hops:
            key = (r.fn.name, h.old)
            if key in seen:
                continue
            seen.add(key)
            lines.append(f"aka\t{r.fn.qualname}\t{h.old}\t{h.commit[:12]}\t{h.path}")
        for old in r.aka:
            key = (r.fn.name, old)
            if key in seen:
                continue
            seen.add(key)
            lines.append(f"aka\t{r.fn.qualname}\t{old}\t\t")
    return "\n".join(lines) + ("\n" if lines else "")


def render_porcelain(reports: list[Report], due_only: bool = True) -> str:
    lines = []
    for r, f in iter_fixtures(reports, due_only):
        gen = "1" if f.generable else "0"
        io = f.io or "-"
        lines.append(
            f"fixture\t{r.fn.qualname}\t{f.kind}\t{f.label}\t{gen}\t{f.suggest}\t{r.fn.path}:{r.fn.line}\t{io}\t{f.io_score}"
        )
    return "\n".join(lines) + ("\n" if lines else "")


def render_rank(reports: list[Report], due_only: bool = True) -> str:
    """Ranked world listing: io-kind first. Used by --check (no test file)."""
    items = list(iter_fixtures(reports, due_only))
    items.sort(key=lambda rf: fixture_rank_key(rf[1], rf[0].fn.qualname))
    lines = []
    for r, f in items:
        tag = f.io or "-"
        lines.append(
            f"{tag}\t{r.fn.qualname}\t{f.kind}\t{f.label}\t{f.suggest}\t{r.fn.path}:{r.fn.line}"
        )
    return "\n".join(lines) + ("\n" if lines else "")


def _emit_call(fn: FuncDef, args: dict, construct: Optional[Construct] = None) -> str:
    bits: list[str] = []
    names = [p.name for p in fn.params] or list(args)
    used = set()
    for name in names:
        if name not in args:
            continue
        used.add(name)
        a = args[name]
        kind, val = a.get("kind"), a.get("value")
        if kind == "dyn" or val is None:
            bits.append(f"{name}=..." if fn.lang == "py" else "...")
        elif fn.lang == "py":
            bits.append(f"{name}={val}")
        elif fn.lang == "swift":
            label = next((p.label or p.name for p in fn.params if p.name == name), name)
            if label == "_":
                bits.append(str(val))
            else:
                bits.append(f"{label}: {val}")
        else:
            bits.append(str(val))
    for name, a in args.items():
        if name in used:
            continue
        val = a.get("value")
        bits.append(f"{name}={val}" if val is not None else f"{name}=...")
    if construct:
        return f"{construct.binding}.{fn.name}({', '.join(bits)})"
    if fn.recv:
        sep = "::" if fn.lang == "rs" and fn.kind != "instance" else "."
        return f"{fn.recv}{sep}{fn.name}({', '.join(bits)})"
    return f"{fn.name}({', '.join(bits)})"


def visa_comment(f: Fixture) -> Optional[str]:
    """Visa is a rank signal — emit as a skip *comment* only, never the object."""
    if f.io != "visa":
        return None
    return "visa path is a rank signal, not the fixture object"


def fixture_dyn_names(args: dict) -> list[str]:
    names: list[str] = []
    for n, a in args.items():
        if not isinstance(a, dict):
            continue
        if a.get("kind") == "dyn" or a.get("value") is None:
            names.append(n)
    return names


def skip_reason(args: dict) -> str:
    dyn = fixture_dyn_names(args)
    pinned = [
        f"{n}={a.get('value')}"
        for n, a in args.items()
        if isinstance(a, dict) and a.get("kind") in ("lit", "default") and a.get("value") is not None
    ]
    bits: list[str] = []
    if dyn:
        bits.append("dynamic slots: " + ", ".join(dyn))
    if pinned:
        bits.append("production pins " + ", ".join(pinned))
    return " — ".join(bits) or "dynamic production world"


def is_predicate_name(name: str) -> bool:
    return bool(re.match(r"^(is|has|can|should)(?:[A-Z_]|_)", name))


def member_assert_true(f: Fixture, fn: Optional[FuncDef] = None) -> bool:
    """Collection members (and concrete is*/has* worlds) get a real boolean oracle."""
    if f.kind == "member":
        return True
    if fn and is_predicate_name(fn.name) and f.kind == "world" and not fixture_dyn_names(f.args):
        return True
    return False


def wrap_oracle(call: str, dialect: str, f: Fixture, fn: Optional[FuncDef] = None) -> str:
    if not member_assert_true(f, fn):
        return call
    if dialect == "xctest":
        return f"XCTAssertTrue({call})"
    return f"assert {call}"


def _unique_name(name: str, seen: set[str]) -> str:
    base, i = name, 2
    while name in seen:
        name = f"{base}_{i}"
        i += 1
    seen.add(name)
    return name


def render_emit_pytest(reports: list[Report], due_only: bool = True, langs: set[str] | None = None) -> str:
    """Runnable pytest module. Only generable due fixtures (optionally language-filtered)."""
    lines = [
        "# generated by seat — production argument worlds as pytest; I/O worlds first",
        "from __future__ import annotations",
        "import pytest",
        "",
    ]
    n = 0
    seen: set[str] = set()
    omitted = 0
    for r, f in iter_fixtures(reports, due_only):
        if not f.generable:
            continue
        if langs is not None and r.fn.lang not in langs:
            omitted += 1
            continue
        name = _unique_name(f.suggest, seen)
        construct = r.construct
        call = _emit_call(r.fn, f.args, construct=construct)
        if construct and construct.origin == "pytest-fixture":
            lines.append(f"def {name}({construct.binding}):")
        else:
            lines.append(f"def {name}():")
        io = f"  io={f.io}" if f.io else ""
        lines.append(f"    # {r.fn.path}:{r.fn.line}  {f.kind}  {f.label}{io}")
        if f.collection:
            lines.append(f"    # member of {f.collection}")
        if f.sites:
            lines.append(f"    # production: {', '.join(f.sites[:3])}")
        visa = visa_comment(f)
        if visa:
            lines.append(f"    # {visa}")
        if construct and construct.origin == "guess":
            lines.append(f"    # no self-contained test fixture; {construct.type_name}() may need args")
        if construct and construct.origin != "pytest-fixture":
            lines.append(f"    {construct.binding} = {construct.expr}")
        dyn = fixture_dyn_names(f.args)
        if dyn:
            lines.append(f"    pytest.skip({skip_reason(f.args)!r})")
        else:
            lines.append(f"    {wrap_oracle(call, 'pytest', f, r.fn)}")
        lines.append("")
        n += 1
    if n == 0:
        lines.append("# no generable due fixtures")
        lines.append("")
    if omitted:
        eprint(f"seat: omitted {omitted} fixture(s) from other languages")
    return "\n".join(lines)


def swift_func_name(suggest: str) -> str:
    """test_isBrowser_appName_Brave_Browser → testIsBrowserAppNameBraveBrowser."""
    parts = [p for p in re.split(r"_+", suggest) if p]
    if not parts:
        return "testProd"
    if parts[0] != "test":
        parts = ["test"] + parts
    return parts[0] + "".join(p[:1].upper() + p[1:] for p in parts[1:])


def xctest_class_name(fn: FuncDef) -> str:
    recv = fn.recv or Path(fn.path).stem
    recv = re.sub(r"[^A-Za-z0-9]", "", recv) or "Seep"
    if recv[0].isdigit():
        recv = "T" + recv
    return f"{recv}SeatTests"


def infer_swift_module(path: str) -> Optional[str]:
    p = path.replace("\\", "/")
    m = re.search(r"(?:^|/)Sources/([^/]+)/", p)
    return m.group(1) if m else None


def choose_dialect(reports: list[Report], due_only: bool, emit: Optional[str]) -> str:
    if emit in ("pytest", "xctest"):
        return emit
    n_swift = n_other = 0
    for r, f in iter_fixtures(reports, due_only):
        if not f.generable:
            continue
        if r.fn.lang == "swift":
            n_swift += 1
        else:
            n_other += 1
    return "xctest" if n_swift > n_other else "pytest"


def render_emit_xctest(reports: list[Report], due_only: bool = True) -> str:
    """Runnable XCTest source. Swift subjects only; other langs go to stderr."""
    groups: dict[str, list[tuple[Report, Fixture]]] = {}
    modules: list[str] = []
    seen_mod: set[str] = set()
    omitted = 0
    for r, f in iter_fixtures(reports, due_only):
        if not f.generable:
            continue
        if r.fn.lang != "swift":
            omitted += 1
            continue
        groups.setdefault(xctest_class_name(r.fn), []).append((r, f))
        mod = infer_swift_module(r.fn.path)
        if mod and mod not in seen_mod:
            seen_mod.add(mod)
            modules.append(mod)
    lines = [
        "// generated by seat — production argument worlds as XCTest; I/O worlds first",
        "import XCTest",
    ]
    for mod in modules:
        lines.append(f"@testable import {mod}")
    lines.append("")
    n = 0
    seen: set[str] = set()
    if not groups:
        lines.append("// no generable due Swift fixtures")
        lines.append("")
        if omitted:
            eprint(f"seat: omitted {omitted} non-Swift fixture(s) (use --emit pytest)")
        return "\n".join(lines)
    for cls, items in groups.items():
        lines.append(f"final class {cls}: XCTestCase {{")
        for r, f in items:
            name = _unique_name(swift_func_name(f.suggest), seen)
            construct = r.construct
            call = _emit_call(r.fn, f.args, construct=construct)
            dyn = fixture_dyn_names(f.args)
            sig = "() throws" if dyn else "()"
            lines.append(f"    func {name}{sig} {{")
            io = f"  io={f.io}" if f.io else ""
            lines.append(f"        // {r.fn.path}:{r.fn.line}  {f.kind}  {f.label}{io}")
            if f.collection:
                lines.append(f"        // member of {f.collection}")
            if f.sites:
                lines.append(f"        // production: {', '.join(f.sites[:3])}")
            visa = visa_comment(f)
            if visa:
                lines.append(f"        // {visa}")
            if construct and construct.origin == "guess":
                lines.append(
                    f"        // no self-contained test fixture; {construct.type_name}() may need args"
                )
            if construct:
                lines.append(f"        let {construct.binding} = {construct.expr}")
            if dyn:
                if construct:
                    lines.append(f"        _ = {construct.binding}")
                    lines.append(f"        // {call.replace('...', '_')}")
                reason = skip_reason(f.args).replace("\\", "\\\\").replace('"', '\\"')
                lines.append(f'        throw XCTSkip("{reason}")')
            else:
                lines.append(f"        {wrap_oracle(call, 'xctest', f, r.fn)}")
            lines.append("    }")
            lines.append("")
            n += 1
        if lines[-1] == "":
            lines.pop()
        lines.append("}")
        lines.append("")
    if omitted:
        eprint(f"seat: omitted {omitted} non-Swift fixture(s) (use --emit pytest)")
    return "\n".join(lines)


def render_tests(
    reports: list[Report],
    due_only: bool = True,
    emit: Optional[str] = None,
    seat: bool = True,
    as_diff: bool = False,
) -> str:
    """Default stdout: existing test type with owed worlds seated, else a sibling file."""
    if seat:
        return render_seated(reports, due_only=due_only, emit=emit, as_diff=as_diff)
    dialect = choose_dialect(reports, due_only, emit)
    if dialect == "xctest":
        return render_emit_xctest(reports, due_only)
    # auto-pytest: keep non-Swift (and Swift if --emit pytest forced)
    langs = None if emit == "pytest" else {"py", "js", "rs", "go"}
    if emit == "pytest":
        langs = None
    return render_emit_pytest(reports, due_only, langs=langs)


# ---------------------------------------------------------------------------
# rename-follow: HEAD name is not the identity
# ---------------------------------------------------------------------------

_DEF_LINE_RE = re.compile(
    r"""(?x)
    ^[+\- ]?
    [ \t]*
    (?:(?:pub(?:\s*\([^)]*\))?|public|private|internal|fileprivate|open|
        static|async|unsafe|export|default|override|class|mutating|
        nonmutating|required|convenience|final|distributed)\s+)*
    (?:def|func|fn|function)\s+
    ([A-Za-z_$\u0080-\uffff][\w$]*)
    \s*[\(<]
    """
)

_SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")


def git_run(root: Path, args: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(root), "-c", "core.pager=cat", *args],
        capture_output=True,
        timeout=timeout,
        check=False,
    )


def git_ok(root: Path) -> bool:
    r = git_run(root, ["rev-parse", "--is-inside-work-tree"], timeout=10)
    return r.returncode == 0 and r.stdout.decode("utf-8", "replace").strip() == "true"


def git_text(root: Path, args: list[str], timeout: int = 60) -> str:
    r = git_run(root, args, timeout=timeout)
    if r.returncode != 0:
        return ""
    return r.stdout.decode("utf-8", "surrogateescape")


def parse_aka_specs(specs: list[str] | None) -> list[RenameHop]:
    """`--aka isWebApp=isBrowser` becomes a synthetic hop (HEAD name on the right)."""
    hops: list[RenameHop] = []
    for raw in specs or []:
        if "=" not in raw:
            continue
        old, new = raw.split("=", 1)
        old, new = old.strip(), new.strip()
        if old and new and old != new:
            hops.append(RenameHop(old=old, new=new, commit="aka", path="--aka", kind="fn"))
    return hops


def _name_parts(name: str) -> set[str]:
    s = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", name)
    return {p.lower() for p in re.split(r"[_\-.]+", s) if p and p.lower() not in {"get", "set", "the"}}


def likely_rename(old: str, new: str) -> bool:
    if not old or not new or old == new:
        return False
    ol, nl = old.lower(), new.lower()
    if ol in nl or nl in ol:
        return True
    shared = _name_parts(old) & _name_parts(new)
    if shared:
        return True
    return difflib.SequenceMatcher(None, ol, nl).ratio() >= 0.55


def _pair_defs(minus: list[str], plus: list[str]) -> list[tuple[str, str]]:
    pairs: list[tuple[str, str]] = []
    used_plus: set[int] = set()
    for old in minus:
        best_i, best = -1, 0.0
        for i, new in enumerate(plus):
            if i in used_plus or old == new:
                continue
            if not likely_rename(old, new):
                continue
            score = difflib.SequenceMatcher(None, old.lower(), new.lower()).ratio()
            if _name_parts(old) & _name_parts(new):
                score += 0.2
            if score > best:
                best, best_i = score, i
        if best_i >= 0:
            used_plus.add(best_i)
            pairs.append((old, plus[best_i]))
    return pairs


def detect_rename_hops(
    root: Path,
    since: Optional[str] = None,
    rev_range: Optional[str] = None,
    max_commits: int = 80,
    paths: list[str] | None = None,
) -> list[RenameHop]:
    """Parse `git log -M -p` for def-line hops and file renames."""
    if not git_ok(root):
        return []
    args = ["log", "-M", "--format=--COMMIT-- %H", "-p", f"--max-count={max_commits}"]
    if rev_range:
        args = ["log", "-M", "--format=--COMMIT-- %H", "-p", rev_range]
    elif since:
        args.append(f"--since={since}")
    args.append("--")
    if paths:
        args.extend(paths)
    else:
        args.extend(f"*{ext}" for ext in sorted(EXTS))
    blob = git_text(root, args, timeout=90)
    if not blob:
        return []
    hops: list[RenameHop] = []
    commit = ""
    path = ""
    rename_from = ""
    minus: list[str] = []
    plus: list[str] = []

    def flush_hunk() -> None:
        nonlocal minus, plus
        src_path = path or rename_from
        if src_path and is_test_path(src_path):
            minus, plus = [], []
            return
        for old, new in _pair_defs(minus, plus):
            hops.append(RenameHop(old=old, new=new, commit=commit, path=src_path, kind="fn"))
        minus, plus = [], []

    for raw in blob.splitlines():
        if raw.startswith("--COMMIT-- "):
            flush_hunk()
            commit = raw.split(" ", 1)[1].strip()
            path = ""
            rename_from = ""
            continue
        if raw.startswith("rename from "):
            rename_from = raw[len("rename from ") :].strip()
            continue
        if raw.startswith("rename to "):
            dest = raw[len("rename to ") :].strip()
            if rename_from and dest and rename_from != dest:
                hops.append(
                    RenameHop(old=rename_from, new=dest, commit=commit, path=dest, kind="file")
                )
            continue
        if raw.startswith("diff --git "):
            flush_hunk()
            path = ""
            rename_from = ""
            continue
        if raw.startswith("+++ b/"):
            flush_hunk()
            path = raw[6:].strip()
            if path == "/dev/null":
                path = ""
            continue
        if raw.startswith("@@"):
            flush_hunk()
            continue
        if raw.startswith("+") and not raw.startswith("+++"):
            m = _DEF_LINE_RE.match(raw)
            if m:
                plus.append(m.group(1))
            continue
        if raw.startswith("-") and not raw.startswith("---"):
            m = _DEF_LINE_RE.match(raw)
            if m:
                minus.append(m.group(1))
            continue
    flush_hunk()
    return hops


def resolve_identities(
    defs: list[FuncDef],
    hops: list[RenameHop],
) -> dict[str, Identity]:
    """Cluster rename hops onto HEAD function names. Both-live names stay distinct."""
    head_names: set[str] = set()
    files_by_name: dict[str, set[str]] = defaultdict(set)
    for d in defs:
        if d.is_test or is_test_path(d.path) or d.name in SKIP_SUBJECT:
            continue
        head_names.add(d.name)
        files_by_name[d.name].add(d.path)

    parent: dict[str, str] = {}

    def find(x: str) -> str:
        parent.setdefault(x, x)
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]

    def union(a: str, b: str) -> None:
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    fn_hops = [h for h in hops if h.kind == "fn"]
    for h in fn_hops:
        union(h.old, h.new)

    clusters: dict[str, set[str]] = defaultdict(set)
    for name in parent:
        clusters[find(name)].add(name)

    identities: dict[str, Identity] = {}
    for names in clusters.values():
        if len(names) < 2:
            continue
        live = [n for n in names if n in head_names]
        if not live:
            continue
        if len(live) == len(names):
            # every name still has a HEAD def — not a rename, two functions
            continue
        dests = [h.new for h in fn_hops if h.new in live and h.old in names]
        # newest hop wins when a dead name fans out onto several live successors
        head = dests[-1] if dests else live[0]
        if len(live) > 1:
            dead = names - head_names
            if not dead:
                continue
            names = set(dead) | {head}
        ident_hops = [h for h in fn_hops if h.old in names or h.new in names]
        files = set(files_by_name.get(head, set()))
        for h in ident_hops:
            if h.path:
                files.add(h.path)
        for h in hops:
            if h.kind == "file" and (h.old in files or h.new in files):
                files.add(h.old)
                files.add(h.new)
        identities[head] = Identity(head=head, names=set(names), hops=ident_hops, files=files)
    return identities


def follow_file(root: Path, rel: str, max_revs: int) -> list[tuple[str, str]]:
    """(commit, path_at_commit) newest-first via `git log --follow`."""
    blob = git_text(
        root,
        ["log", "--follow", "--name-only", "--pretty=format:%H", f"--max-count={max_revs}", "--", rel],
        timeout=30,
    )
    pairs: list[tuple[str, str]] = []
    commit: Optional[str] = None
    for line in blob.splitlines():
        s = line.strip()
        if not s:
            continue
        if _SHA_RE.match(s):
            commit = s
            continue
        if commit:
            pairs.append((commit, s))
            commit = None
    return pairs


def harvest_historical_calls(
    root: Path,
    identities: dict[str, Identity],
    max_revs: int = 40,
) -> list[Call]:
    """Production calls to any alias, from parent revisions (HEAD tests still subtract)."""
    if not identities or not git_ok(root):
        return []
    head = git_text(root, ["rev-parse", "HEAD"], timeout=10).strip()
    out: list[Call] = []
    seen_blob: set[tuple[str, str]] = set()
    for ident in identities.values():
        start_files = set(ident.files)
        if not start_files:
            continue
        alias = set(ident.names)
        for start in sorted(start_files):
            if lang_of_path(start) is None:
                continue
            history = follow_file(root, start, max_revs)
            for commit, path in history:
                if commit == head:
                    continue
                if lang_of_path(path) is None:
                    continue
                key = (commit, path)
                if key in seen_blob:
                    continue
                seen_blob.add(key)
                raw = git_run(root, ["show", f"{commit}:{path}"], timeout=20)
                if raw.returncode != 0 or not raw.stdout:
                    continue
                try:
                    src = raw.stdout.decode("utf-8", "replace")
                except Exception:
                    continue
                if len(src) > MAX_FILE_BYTES:
                    continue
                try:
                    _defs, calls = parse_source(path, src)
                except Exception:
                    continue
                for c in calls:
                    if c.is_test or is_test_path(c.path):
                        continue
                    if c.name not in alias:
                        continue
                    c.commit = commit
                    c.cited = c.name
                    out.append(c)
    return out


def parse_source(rel: str, src: str) -> tuple[list[FuncDef], list[Call]]:
    lang = lang_of_path(rel)
    if not lang:
        return [], []
    if lang == "py":
        defs, calls, _ = parse_python(rel, src)
    else:
        defs, calls, _ = parse_generic(rel, src, lang)
    return defs, calls


def files_touching_names(root: Path, names: list[str], head_defs: list[FuncDef], max_hits: int = 40) -> list[str]:
    """Restrict rename log to files that define a queried name or historically mentioned it."""
    paths: list[str] = []
    want = {n for n in names}
    for d in head_defs:
        if d.name in want:
            paths.append(d.path)
    if git_ok(root):
        for n in names:
            blob = git_text(
                root,
                ["log", "-M", "--name-only", "--pretty=format:", "-S", n, f"--max-count={max_hits}", "--"],
                timeout=30,
            )
            for line in blob.splitlines():
                s = line.strip()
                if s and lang_of_path(s):
                    paths.append(s)
    # unique, stable
    out, seen = [], set()
    for p in paths:
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


