def eprint(*a: object) -> None:
    print(*a, file=sys.stderr)


def is_test_path(path: str) -> bool:
    p = path.replace("\\", "/")
    if TEST_PATH_RE.search(p):
        return True
    stem = Path(p).stem.lower()
    if stem in {"test_support", "conftest", "tests", "test"} or stem.startswith("test_") or stem.endswith("_test") or stem.endswith("_tests") or stem.endswith("tests"):
        return True
    return False


def fmt_vals(vals: Iterable[str], limit: int = 12) -> str:
    s = sorted({v for v in vals if v is not None})
    if not s:
        return "[]"
    if len(s) <= limit:
        return "[" + ",".join(s) + "]"
    return "[" + ",".join(s[:limit]) + f"+{len(s) - limit}]"


STRING_LIT_RE = re.compile(r'"(?:\\.|[^"\\])*"')


def extract_collections(src: str) -> dict[str, list[str]]:
    """Literal arrays/sets bound to a name: browsers = ["Chrome", ...]."""
    out: dict[str, list[str]] = {}
    for m in re.finditer(
        r"\b(?:let|var|const)\s+(\w+)\s*(?::[^=]{0,120})?=\s*\[(.*?)\]",
        src,
        re.S,
    ):
        name, body = m.group(1), m.group(2)
        lits = [canon_lit(s) for s in STRING_LIT_RE.findall(body)]
        if len(lits) >= 2:
            out[name] = lits
    for m in re.finditer(
        r"^([A-Z][A-Z0-9_]*)\s*=\s*\[(.*?)\]",
        src,
        re.S | re.M,
    ):
        lits = [canon_lit(s) for s in STRING_LIT_RE.findall(m.group(2))]
        if len(lits) >= 2:
            out[m.group(1)] = lits
    return out


def membership_hits(body: str, params: list[str], collections: dict[str, list[str]]) -> list[tuple[str, str]]:
    """(param, collection_name) pairs where the body asks if param is in the collection."""
    if not body or not collections:
        return []
    hits: list[tuple[str, str]] = []
    for cname in collections:
        for pname in params:
            pats = [
                rf"\b{re.escape(cname)}\.contains\(\s*{re.escape(pname)}\s*\)",
                rf"\b{re.escape(cname)}\.includes\(\s*{re.escape(pname)}\s*\)",
                rf"\b{re.escape(pname)}\s+in\s+{re.escape(cname)}\b",
                rf"\b{re.escape(cname)}\.has\(\s*{re.escape(pname)}\s*\)",
                rf"\b{re.escape(cname)}\.contains\(\s*\.?\s*{re.escape(pname)}\s*\)",
            ]
            if any(re.search(p, body) for p in pats):
                hits.append((pname, cname))
    return hits


def ident_ok(s: str) -> bool:
    return bool(s) and (s[0].isalpha() or s[0] == "_" or ord(s[0]) > 127)


def canon_lit(raw: str) -> str:
    s = raw.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'`":
        inner = s[1:-1]
        inner = inner.replace("\\n", "\n").replace("\\t", "\t").replace('\\"', '"').replace("\\'", "'")
        if len(inner) > 48:
            inner = inner[:45] + "..."
        return '"' + inner.replace("\n", "\\n") + '"'
    low = s.lower()
    if low in ("true", "false"):
        return low
    if low in ("none", "null", "nil", "undefined"):
        return "null"
    if re.fullmatch(r"[-+]?\d+_?\d*", s.replace("_", "")) or re.fullmatch(r"[-+]?\d+", s.replace("_", "")):
        try:
            return str(int(s.replace("_", "")))
        except ValueError:
            pass
    if re.fullmatch(r"[-+]?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?", s.replace("_", "")):
        try:
            f = float(s.replace("_", ""))
            if f.is_integer() and abs(f) < 1e15:
                return str(int(f))
            return repr(f)
        except ValueError:
            pass
    if s.startswith(".") and ident_ok(s[1:]):
        return s
    if re.fullmatch(r"(?:[\w$]+::)*[\w$]+", s) and ("::" in s or (s[:1].isupper() and "_" not in s[:1])):
        return s
    if len(s) > 48:
        return s[:45] + "..."
    return s


def looks_const_name(name: str) -> bool:
    if not name:
        return False
    if name.isupper() and any(c.isalpha() for c in name):
        return True
    if name[0].isupper() and "_" not in name and name not in ("True", "False", "None", "Ok", "Err", "Some"):
        # PascalCase enum-ish — only treat as const if whole token is a ref, not a ctor call
        return True
    return name.isupper()


