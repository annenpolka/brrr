# worlds / fixtures (production only)
# ---------------------------------------------------------------------------

def lang_of_path(path: str) -> Optional[str]:
    ext = Path(path).suffix.lower()
    return LANG_BY_EXT.get(ext)


def bind_args(fn: FuncDef, call: Call) -> dict[str, Arg]:
    bound: dict[str, Arg] = {}
    params = [p for p in fn.params]
    used: set[str] = set()
    # keyword / labeled
    pos_args = []
    for a in call.args:
        if a.value == "{...}":
            continue
        if a.name and any(p.name == a.name or p.label == a.name for p in params):
            pname = next(p.name for p in params if p.name == a.name or p.label == a.name)
            bound[pname] = a
            used.add(pname)
        else:
            pos_args.append(a)
    pi = 0
    for a in pos_args:
        while pi < len(params) and params[pi].name in used:
            pi += 1
        if pi >= len(params):
            bound[a.name or f"${a.index}"] = a
            continue
        # swift: skip params whose label is not "_" when this positional... already handled via labels
        p = params[pi]
        if p.label and p.label != "_" and p.label != p.name:
            # labeled-only, don't bind positional unless label is "_"
            # still bind if this is positional with no name
            pass
        bound[p.name] = Arg(a.index, p.name, a.kind, a.value)
        used.add(p.name)
        pi += 1
    for p in params:
        if p.name not in bound:
            if p.default is not None:
                bound[p.name] = Arg(-1, p.name, "default", p.default)
            else:
                bound[p.name] = Arg(-1, p.name, "omit", None)
    for k, a in call.bags.items():
        bound[k] = a
    return bound


def world_of(bound: dict[str, Arg]) -> tuple[tuple, str]:
    parts: list[tuple[str, str, Optional[str]]] = []
    bits: list[str] = []
    for name in sorted(bound):
        a = bound[name]
        if a.kind == "omit":
            continue
        if a.kind == "dyn":
            parts.append((name, "dyn", None))
            bits.append(f"{name}=*")
        elif a.kind == "default":
            parts.append((name, "val", a.value))
            bits.append(f"{name}={a.value}d")
        else:
            parts.append((name, "val", a.value))
            bits.append(f"{name}={a.value}")
    label = "{" + ", ".join(bits) + "}" if bits else "{}"
    return tuple(parts), label


def effective_const(bound: dict[str, Arg]) -> dict[str, str]:
    out: dict[str, str] = {}
    for n, a in bound.items():
        if a.kind in ("lit", "default") and a.value is not None:
            out[n] = a.value
    return out


def extract_arms(fn: FuncDef) -> list[str]:
    """Predicates in the body that mention a parameter."""
    names = {p.name for p in fn.params}
    if not names or not fn.body:
        return []
    arms: list[str] = []
    seen: set[str] = set()
    body = fn.body
    name_alt = "|".join(re.escape(n) for n in sorted(names, key=len, reverse=True))
    lit = r"(?:\"(?:\\.|[^\"\\])*\"|'(?:\\.|[^'\\])*'|`(?:\\.|[^`\\])*`|\.[A-Za-z_][\w]*|(?:[\w$]+::)+[\w$]+|[-+]?\d[\d_.]*|true|false|null|nil|None|undefined)"
    for m in re.finditer(rf"\b({name_alt})\b\s*(===?|!==?|==|!=)\s*({lit})", body):
        pred = f"{m.group(1)}{m.group(2)}{canon_lit(m.group(3))}"
        if pred not in seen:
            seen.add(pred)
            arms.append(pred)
    for m in re.finditer(rf"({lit})\s*(===?|!==?|==|!=)\s*\b({name_alt})\b", body):
        pred = f"{m.group(3)}{m.group(2)}{canon_lit(m.group(1))}"
        if pred not in seen:
            seen.add(pred)
            arms.append(pred)
    # contains/in membership of a collection assigned from a literal list — handled later
    return arms[:12]


def arm_inhabited(pred: str, const: dict[str, str], open_params: set[str]) -> bool:
    m = re.match(r"^(\w+)(===?|!==?|==|!=)(.+)$", pred)
    if not m:
        return False
    name, op, lit = m.group(1), m.group(2), m.group(3)
    if name in open_params:
        return True  # dynamic can hit either side
    if name not in const:
        return False
    val = const[name]
    eq = op in ("==", "===", "=")
    hit = val == lit or val == canon_lit(lit)
    return hit if eq else not hit


def match_calls_to_def(
    fn: FuncDef,
    calls: list[Call],
    name_index: dict[str, list[FuncDef]],
    aliases: Optional[set[str]] = None,
) -> list[Call]:
    out: list[Call] = []
    accept = {fn.name}
    if aliases:
        accept.update(aliases)
    siblings = [d for d in name_index.get(fn.name, []) if d.lang == fn.lang]
    unique = len(siblings) == 1
    for c in calls:
        if c.name not in accept:
            continue
        if lang_of_path(c.path) != fn.lang:
            continue
        if c.path == fn.path and c.line == fn.line:
            continue
        npos = len(c.args)
        if fn.params and npos > len(fn.params) + 4:
            continue
        if not unique:
            if c.recv and fn.recv and c.recv != fn.recv and c.recv not in {"self", "this", "super", "Self"}:
                continue
            if c.recv and fn.recv is None and any(d.recv == c.recv for d in siblings):
                continue
            # instance call with no type prefix: keep the def in the same file
            if c.recv in {None, "self", "this", "super", "Self"} or (c.recv and c.recv[:1].islower()):
                same_file = [d for d in siblings if d.path == c.path]
                if same_file and fn.path != c.path:
                    continue
            if not c.recv and fn.recv and any(d.recv is None for d in siblings if d is not fn):
                # ambiguous free function vs method — keep same-path / test-name affinity
                same = Path(c.path).stem.replace("-", "_")
                defstem = Path(fn.path).stem.replace("-", "_")
                if defstem not in same and same not in defstem and Path(c.path).parent != Path(fn.path).parent:
                    if not (is_test_path(c.path) and defstem.split("_")[0] in same):
                        continue
        out.append(c)
    return out


def build_reports(
    defs: list[FuncDef],
    calls: list[Call],
    include_test_defs: bool = False,
    collections: dict[str, dict[str, list[str]]] | None = None,
    identities: dict[str, Identity] | None = None,
) -> list[Report]:
    by_name: dict[str, list[FuncDef]] = defaultdict(list)
    subjects: list[FuncDef] = []
    identities = identities or {}
    for d in defs:
        if d.name in SKIP_SUBJECT or d.name.endswith("!"):
            continue
        if not include_test_defs and (d.is_test or is_test_path(d.path)):
            continue
        subjects.append(d)
        by_name[d.name].append(d)
    reports: list[Report] = []
    seen_def: set[tuple[str, int, str]] = set()
    collections = collections or {}
    for fn in subjects:
        key = (fn.path, fn.line, fn.name)
        if key in seen_def:
            continue
        seen_def.add(key)
        if fn.name in SKIP_SUBJECT:
            continue
        ident = identities.get(fn.name)
        aliases = set(ident.names) if ident else None
        matched = match_calls_to_def(fn, calls, by_name, aliases=aliases)
        # drop recursive? keep
        if not matched:
            continue
        worlds_map: dict[tuple, World] = {}
        bounds: list[tuple[Call, dict[str, Arg]]] = []
        for c in matched:
            bound = bind_args(fn, c)
            bounds.append((c, bound))
            wkey, wlabel = world_of(bound)
            w = worlds_map.get(wkey)
            if w is None:
                w = World(wkey, wlabel)
                worlds_map[wkey] = w
            (w.test_calls if c.is_test else w.prod_calls).append(c)
        worlds = sorted(worlds_map.values(), key=lambda w: (-(w.n_test + w.n_prod), w.label))
        preds = extract_arms(fn)
        arms: list[Arm] = []
        for pred in preds:
            t_hit = p_hit = False
            for c, bound in bounds:
                const = effective_const(bound)
                open_p = {n for n, a in bound.items() if a.kind == "dyn"}
                if arm_inhabited(pred, const, open_p):
                    if c.is_test:
                        t_hit = True
                    else:
                        p_hit = True
            arms.append(Arm(pred, t_hit, p_hit))
        file_cols = collections.get(fn.path, {})
        members = infer_members(fn, bounds, file_cols)
        fixtures = infer_fixtures(fn, worlds, bounds, members)
        # production-only: a function with no production callers is not a seed
        if not any(not c.is_test for c in matched):
            continue
        aka = sorted((ident.names - {fn.name}) if ident else [])
        hops = list(ident.hops) if ident else []
        reports.append(Report(fn, matched, worlds, arms, fixtures, members, aka=aka, hops=hops))
    reports.sort(key=lambda r: (-len(r.due), -len(r.calls), r.fn.qualname))
    return reports


def infer_members(
    fn: FuncDef,
    bounds: list[tuple[Call, dict[str, Arg]]],
    file_cols: dict[str, list[str]],
) -> list[MemberGap]:
    params = [p.name for p in fn.params]
    hits = membership_hits(fn.body, params, file_cols)
    gaps: list[MemberGap] = []
    for pname, cname in hits:
        members = file_cols[cname]
        test_vals: set[str] = set()
        for c, b in bounds:
            if c.is_test and pname in b and b[pname].kind in ("lit", "default") and b[pname].value:
                test_vals.add(b[pname].value)
        missing = [m for m in members if m not in test_vals]
        witnessed = [m for m in members if m in test_vals]
        gaps.append(MemberGap(pname, cname, members, witnessed, missing))
    return gaps


_SLUG_SYM = {
    "←": "left",
    "→": "right",
    "↑": "up",
    "↓": "down",
    "↩": "enter",
    "✕": "cross",
    "×": "times",
    "✓": "ok",
    "✗": "fail",
    "–": "dash",
    "—": "em",
    "…": "ellip",
    " ": "_",
}


def _slug(s: str, n: int = 28) -> str:
    s = s.strip().strip("\"'`")
    parts: list[str] = []
    for ch in s:
        if ch.isalnum() or ch == "_":
            parts.append(ch)
        elif ch in _SLUG_SYM:
            parts.append("_" + _SLUG_SYM[ch] + "_")
        elif ord(ch) > 127:
            # keep letters (CJK etc.); otherwise a short codepoint
            parts.append(ch if ch.isalpha() else f"_u{ord(ch):x}_")
        else:
            parts.append("_")
    s = re.sub(r"_+", "_", "".join(parts)).strip("_")
    return (s or "x")[:n]


def suggest_name(fn: FuncDef, args: dict[str, str]) -> str:
    bits: list[str] = []
    for k, v in args.items():
        if v in (None, "*", ""):
            bits.append(_slug(k, 16))
        else:
            bits.append(f"{_slug(k, 16)}_{_slug(v, 24)}")
    tail = "_".join(bits)[:72]
    return f"test_{_slug(fn.name, 40)}_{tail}" if tail else f"test_{_slug(fn.name, 40)}_prod"


def bound_to_args(bound: dict[str, Arg]) -> dict:
    out = {}
    for name, a in bound.items():
        if a.kind == "omit":
            continue
        out[name] = {"kind": a.kind, "value": a.value}
    return out


def infer_fixtures(
    fn: FuncDef,
    worlds: list[World],
    bounds: list[tuple[Call, dict[str, Arg]]],
    members: list[MemberGap] | None = None,
) -> list[Fixture]:
    """Production worlds the tests do not inhabit, as generator records.

    Tests are a subtract filter only. Test-only worlds never become fixtures.
    """
    prod_calls = [c for c, _ in bounds if not c.is_test]
    if not prod_calls:
        return []

    fixtures: list[Fixture] = []
    seen: set[tuple[str, str]] = set()

    def add(fx: Fixture) -> None:
        k = (fx.kind, fx.label)
        if k in seen:
            return
        seen.add(k)
        fixtures.append(fx)

    # Concrete collection members production can hit and tests never pass.
    member_params: set[str] = set()
    for g in members or []:
        member_params.add(g.param)
        for m in g.missing:
            add(
                Fixture(
                    kind="member",
                    status="due",
                    args={g.param: {"kind": "lit", "value": m}},
                    label=f"{{{g.param}={m}}}",
                    sites=[],
                    suggest=suggest_name(fn, {g.param: m}),
                    generable=True,
                    collection=g.collection,
                    param=g.param,
                )
            )
        for m in g.witnessed:
            add(
                Fixture(
                    kind="member",
                    status="have",
                    args={g.param: {"kind": "lit", "value": m}},
                    label=f"{{{g.param}={m}}}",
                    sites=[],
                    suggest=suggest_name(fn, {g.param: m}),
                    generable=True,
                    collection=g.collection,
                    param=g.param,
                )
            )

    # Production-only worlds (tests never inhabit the same key).
    bound_by_call = {id(c): b for c, b in bounds}
    for w in worlds:
        if w.n_prod == 0:
            continue
        sample = w.prod_calls[0]
        bound = bound_by_call.get(id(sample), {})
        args = bound_to_args(bound)
        # Zero-arg calls are not an argument world — skip unless --all
        # (status have/due still tracked via empty args + kind world).
        if not args:
            continue
        dyn_names = [n for n, a in args.items() if a["kind"] == "dyn"]
        concrete = [
            n
            for n, a in args.items()
            if a["kind"] in ("lit", "default") and a.get("value") is not None
        ]
        # A world is generable when production pinned at least one value.
        # Dyn slots become `...` placeholders in --emit (duration=1, context="tmux").
        generable = bool(concrete)
        suggest_args = {
            n: ("*" if a["kind"] == "dyn" else (a["value"] or n)) for n, a in args.items()
        }
        sites = [rel_site(c) for c in w.prod_calls[:8]]
        # A dyn world whose param already expanded into members is not a seed.
        if dyn_names and set(dyn_names) <= member_params and not concrete:
            if any(g.param in dyn_names and g.missing for g in (members or [])):
                continue
        status = "have" if w.n_test else "due"
        kind = "world" if concrete else "dyn"
        add(
            Fixture(
                kind=kind,
                status=status,
                args=args,
                label=w.label,
                sites=sites,
                suggest=suggest_name(fn, suggest_args),
                generable=generable,
                param=dyn_names[0] if dyn_names else None,
            )
        )

    fixtures.sort(key=lambda f: (0 if f.status == "due" else 1, 0 if f.generable else 1, f.kind, f.label))
    return fixtures


# ---------------------------------------------------------------------------
# IO ranking: timeout=0 / FS / NET / getenv worlds first
# hatch/till emit call-site or label order. seep ranks the world that does
# I/O first — that is the one that flakes and the one no unit test wrote.
# Machine visa is a rank signal, not the object (that is visa/oath/stain).
# ---------------------------------------------------------------------------

IO_TIMEOUT_PARAMS = {
    "timeout",
    "deadline",
    "ttl",
    "time_out",
    "read_timeout",
    "connect_timeout",
    "write_timeout",
    "idle_timeout",
}
IO_NET_PARAMS = {
    "host",
    "hostname",
    "url",
    "uri",
    "addr",
    "address",
    "endpoint",
    "port",
    "socket",
    "peer",
    "origin",
    "authority",
    "baseurl",
    "base_url",
}
IO_FS_PARAMS = {
    "path",
    "file",
    "filename",
    "filepath",
    "dir",
    "directory",
    "cwd",
    "dest",
    "dst",
    "src",
    "root",
    "folder",
    "pathname",
    "outfile",
    "infile",
    "out_path",
    "in_path",
    "workdir",
    "work_dir",
}
IO_ENV_PARAMS = {
    "env",
    "environ",
    "home",
    "user",
    "username",
    "homedir",
    "home_dir",
}
IO_KIND_SCORE = {
    "timeout": 400,
    "visa": 300,
    "env": 250,
    "fs": 200,
    "net": 100,
    "proc": 80,
    "body": 15,
}
IO_KIND_ORDER = ("timeout", "visa", "env", "fs", "net", "proc", "body")

_TIMEOUT_BODY_RE = re.compile(
    r"\b(?:timeout|deadline|ttl)\s*(?:==|===|!=|<=|>=|:|=)\s*0\b"
    r"|\b0\s*(?:==|===)\s*(?:timeout|deadline|ttl)\b",
    re.I,
)
_FS_BODY_RE = re.compile(
    r"\b(?:open|Path|read_text|write_text|read_bytes|write_bytes|"
    r"listdir|mkdir|makedirs|unlink|rmdir|"
    r"FileManager|FileHandle|NSHomeDirectory|"
    r"readFile(?:Sync)?|writeFile(?:Sync)?|createReadStream|createWriteStream|"
    r"File::open|File::create|fs::File|std::fs)\b"
    r"|\bos\.(?:path|listdir|remove|mkdir|open|scandir)\b",
    re.I,
)
_NET_BODY_RE = re.compile(
    r"\b(?:socket|urlopen|urlretrieve|URLSession|URLRequest|"
    r"TcpStream|TcpListener|UdpSocket|reqwest|httpx|aiohttp|"
    r"axios|http\.get|http\.request|net\.connect|"
    r"urlSession)\b"
    r"|\brequests\.(?:get|post|put|delete|head|request)\b",
    re.I,
)
_ENV_BODY_RE = re.compile(
    r"\b(?:getenv|os\.environ|ProcessInfo|NSProcessInfo|"
    r"env::var|std::env|process\.env|GetEnvironmentVariable|"
    r"Environment\.GetEnvironmentVariable)\b",
    re.I,
)
_PROC_BODY_RE = re.compile(
    r"\b(?:subprocess|Popen|os\.system|os\.exec|Command::new|"
    r"NSTask)\b",
    re.I,
)
_VISA_PATH_RE = re.compile(
    r"(?:^|/)(?:Users|home)/[^/]+|(?:^|\\)Users\\[^\\]+|^~(?:/|$)",
    re.I,
)
_HOST_RE = re.compile(
    r"^(?:(?:[a-z0-9-]+\.)+[a-z]{2,}|localhost|\d{1,3}(?:\.\d{1,3}){3}|::1|0\.0\.0\.0)$",
    re.I,
)
_URL_RE = re.compile(r"^(?:https?|ftp|ws|wss|ssh|git|tcp)://", re.I)
_FILE_EXT_RE = re.compile(
    r"\.(?:json|ya?ml|toml|ini|conf|cfg|txt|log|pem|key|sqlite3?|db|"
    r"swift|py|rs|js|ts|go|md|plist|sock)$",
    re.I,
)
# duration=1 is a clock, not timeout=0
_NOT_TIMEOUT_PARAMS = {"duration", "delay", "interval", "every", "period", "tick"}
_FS_SUFFIX_RE = re.compile(
    r"(?:paths?|root|dirs?|files?|filename|filepath|homedir|home|cwd|folder)$"
)


def _lit_text(value: Optional[str]) -> str:
    if value is None:
        return ""
    s = str(value).strip()
    if re.fullmatch(r"[-+]?\d[\d_]*d", s):
        s = s[:-1]
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'`":
        s = s[1:-1]
    if "\\u" in s or "\\U" in s:
        try:
            s = s.encode("utf-8").decode("unicode_escape")
        except Exception:
            pass
    return s


def _is_zero(value: Optional[str]) -> bool:
    s = _lit_text(value)
    return s in {"0", "0.0"}


def _fs_param(key: str) -> bool:
    if not key:
        return False
    if key in IO_FS_PARAMS:
        return True
    return bool(_FS_SUFFIX_RE.search(key))


def _looks_path(s: str) -> bool:
    if not s or len(s) < 2:
        return False
    if "\n" in s or "\r" in s or len(s) > 160:
        return False
    if s[0] in "/~" or s.startswith("./") or s.startswith("../"):
        return True
    if re.match(r"^[A-Za-z]:[\\/]", s) or s.startswith("\\\\"):
        return True
    if "/" in s:
        return True
    # backslash is a path only as a Windows path, not as \uXXXX / \n
    if "\\" in s and not re.search(r"\\[uUxntr\"'`]", s):
        return True
    return bool(_FILE_EXT_RE.search(s))


def _looks_host(s: str) -> bool:
    if not s:
        return False
    if _URL_RE.match(s):
        return True
    if "/" in s or " " in s:
        return False
    return bool(_HOST_RE.match(s))


def _looks_visa(s: str) -> bool:
    """Rank signal only — not a visa/stain object."""
    if not s:
        return False
    if s.startswith("~"):
        return True
    if _VISA_PATH_RE.search(s):
        return True
    for key in ("HOME", "USER", "USERNAME", "LOGNAME", "TMPDIR", "TMP"):
        have = os.environ.get(key)
        if not have:
            continue
        if s == have or s.startswith(have + "/") or s.startswith(have + "\\"):
            return True
    return False


def body_effects(fn: FuncDef) -> set:
    body = fn.body or ""
    # parser often includes the def line; don't let `def fetch(` look like HTTP fetch
    if body.lstrip()[:4] in ("def ", "func", "fn ", "publ", "expo"):
        nl = body.find("\n")
        if nl != -1:
            body = body[nl + 1 :]
    fx: set = set()
    if _TIMEOUT_BODY_RE.search(body):
        fx.add("timeout")
    if _FS_BODY_RE.search(body):
        fx.add("fs")
    if _NET_BODY_RE.search(body):
        fx.add("net")
    if _ENV_BODY_RE.search(body):
        fx.add("env")
    if _PROC_BODY_RE.search(body):
        fx.add("proc")
    return fx


def stain_effects(fn: FuncDef, by_name: Optional[dict] = None, depth: int = 1, seen: Optional[set] = None) -> set:
    """Union body effects with one hop of callees (the original seep join)."""
    seen = seen if seen is not None else set()
    key = (fn.path, fn.line, fn.name)
    if key in seen:
        return set()
    seen.add(key)
    fx = body_effects(fn)
    if depth <= 0 or not by_name:
        return fx
    body = fn.body or ""
    for name, defs in by_name.items():
        if name == fn.name or len(name) < 2:
            continue
        try:
            pat = re.compile(rf"\b{re.escape(name)}\s*\(")
        except re.error:
            continue
        if not pat.search(body):
            continue
        for d in defs:
            if d.lang != fn.lang:
                continue
            fx |= stain_effects(d, by_name, depth - 1, seen)
    return fx


def classify_world_io(
    fn: FuncDef,
    args: dict,
    label: str = "",
    effects: Optional[set] = None,
) -> tuple:
    """Return (kind, score). Empty kind means not an I/O world."""
    kinds: list = []
    for name, a in (args or {}).items():
        if not isinstance(a, dict):
            continue
        val = a.get("value")
        text = _lit_text(val)
        key = (name or "").lower().lstrip("_")
        if key in _NOT_TIMEOUT_PARAMS:
            pass
        elif key in IO_TIMEOUT_PARAMS and _is_zero(val):
            kinds.append("timeout")
        if key in IO_ENV_PARAMS and a.get("kind") in ("lit", "default") and text:
            kinds.append("visa" if _looks_visa(text) else "env")
        if a.get("kind") in ("lit", "default") and text:
            if _looks_visa(text):
                kinds.append("visa")
            elif _looks_path(text) or _fs_param(key):
                kinds.append("fs")
            if _looks_host(text) or key in IO_NET_PARAMS:
                kinds.append("net")
        elif key in IO_NET_PARAMS:
            kinds.append("net")
        elif _fs_param(key):
            kinds.append("fs")
    if "timeout=0" in (label or ""):
        kinds.append("timeout")
    fx = effects if effects is not None else body_effects(fn)
    if "timeout" in fx and ("timeout" in kinds or "timeout=0" in (label or "")):
        kinds.append("timeout")
    if not any(k in kinds for k in ("timeout", "visa", "env", "fs", "net", "proc")):
        if "fs" in fx or "net" in fx or "env" in fx:
            kinds.append("body")
        elif "proc" in fx:
            kinds.append("proc")
    kind = next((k for k in IO_KIND_ORDER if k in kinds), "")
    return kind, IO_KIND_SCORE.get(kind, 0)


def fixture_rank_key(f: Fixture, qualname: str = "") -> tuple:
    return (
        0 if f.status == "due" else 1,
        -(f.io_score or 0),
        0 if f.generable else 1,
        f.kind,
        f.label,
        qualname,
    )


def apply_io_rank(reports: list, rank: bool = True, defs: Optional[list] = None) -> None:
    """Classify I/O on every fixture; optionally sort IO worlds (and functions) first."""
    by_name: dict = defaultdict(list)
    for d in defs or []:
        by_name[d.name].append(d)
    if not by_name:
        for r in reports:
            by_name[r.fn.name].append(r.fn)
    effect_cache: dict = {}
    for r in reports:
        ek = (r.fn.path, r.fn.line, r.fn.name)
        if ek not in effect_cache:
            effect_cache[ek] = stain_effects(r.fn, by_name, depth=1)
        fx = effect_cache[ek]
        for f in r.fixtures:
            kind, score = classify_world_io(r.fn, f.args, f.label, effects=fx)
            f.io = kind
            f.io_score = score
        if rank:
            r.fixtures.sort(key=lambda f: fixture_rank_key(f, r.fn.qualname))
        else:
            r.fixtures.sort(
                key=lambda f: (0 if f.status == "due" else 1, 0 if f.generable else 1, f.kind, f.label)
            )
    if rank:
        reports.sort(
            key=lambda r: (
                -(max((f.io_score for f in r.due), default=0)),
                -(sum(1 for f in r.due if f.io_score)),
                -len(r.due),
                -len(r.calls),
                r.fn.qualname,
            )
        )
    else:
        reports.sort(key=lambda r: (-len(r.due), -len(r.calls), r.fn.qualname))


# ---------------------------------------------------------------------------
# construct Type() / reuse a test fixture of that type
# ---------------------------------------------------------------------------

CTOR_NAMES = {"__init__", "init", "constructor", "new"}
_IDENT_RE = re.compile(r"[A-Za-z_$\u0080-\uffff][\w$]*")
_FACTORY_RE = re.compile(r"^(?:make|new|build|create)_?", re.I)
_LITERAL_WORDS = {
    "true",
    "false",
    "nil",
    "none",
    "null",
    "undefined",
    "self",
    "this",
    "super",
    "ok",
    "some",
    "err",
    "default",
}


def binding_name(typ: str) -> str:
    parts = re.findall(r"[A-Z]+(?=[A-Z][a-z]|$)|[A-Z]?[a-z0-9]+|[0-9]+", typ or "")
    if parts:
        return parts[-1].lower()
    if typ:
        return typ[:1].lower() + typ[1:]
    return "sut"


def _ctor_has_required(fn: FuncDef) -> bool:
    return any(p.default is None for p in fn.params)


def _empty_coll_text(s: str) -> bool:
    t = (s or "").strip()
    return t in {"[]", "{}", "()", "nil", "None", "null", "undefined"}


def self_contained_ctor_expr(expr: str, typ: str) -> bool:
    """True when Type(...) mentions only labels + literals / empty collections.

    A label does not launder a local: `SessionEngine(deps: deps)` is not
    self-contained even though `deps` is also the keyword.
    """
    s = (expr or "").strip().rstrip(";").replace("\n", " ")
    if not typ or not s.startswith(typ):
        return False
    rest = s[len(typ) :].lstrip()
    if rest.startswith("::"):
        rest = rest[2:].lstrip()
        # Type::new(...) / Type::default()
        m = re.match(r"(new|default|init)\s*(\(.*\))\s*$", rest)
        if not m:
            return False
        inner = m.group(2)
    elif rest.startswith("(") and rest.endswith(")"):
        inner = rest
    else:
        return False
    # drop string/char literals so identifiers inside quotes don't count
    stripped = re.sub(r"(['\"`]).*?\1", " ", inner)
    # drop labels (`deps:` / `sensors=`) so only *values* remain
    stripped = re.sub(r"[A-Za-z_$\u0080-\uffff][\w$]*\s*[:=]", " ", stripped)
    ids = _IDENT_RE.findall(stripped)
    for ident in ids:
        low = ident.lower()
        if ident == typ or low in _LITERAL_WORDS:
            continue
        if ident in ("new", "default", "init", "Self"):
            continue
        return False
    return True


def reconstruct_ctor_call(typ: str, call: Call, lang: str) -> Optional[str]:
    raw = (call.raw or "").strip().rstrip(";")
    if raw and self_contained_ctor_expr(raw, typ):
        return raw
    bits: list[str] = []
    for a in call.args:
        if a.kind == "dyn" and not _empty_coll_text(a.value or ""):
            return None
        val = a.value
        if val is None:
            return None
        if lang == "swift" and a.name:
            bits.append(f"{a.name}: {val}")
        elif lang == "py" and a.name:
            bits.append(f"{a.name}={val}")
        else:
            bits.append(str(val))
    expr = f"{typ}({', '.join(bits)})"
    if lang == "rs" and call.name == "new":
        expr = f"{typ}::new({', '.join(bits)})"
    return expr if self_contained_ctor_expr(expr, typ) else None


def zero_arg_ctor_expr(typ: str, lang: str, defs: list[FuncDef]) -> Optional[str]:
    """Type() when init/new has no required params, or no init is visible."""
    ctors = [d for d in defs if d.recv == typ and d.lang == lang and d.name in CTOR_NAMES]
    if lang == "rs":
        news = [d for d in ctors if d.name == "new" and d.kind != "instance"]
        if news:
            if _ctor_has_required(news[0]):
                return None
            return f"{typ}::new()"
        # no new: Default::default is a guess; still a construction
        return f"{typ}::default()"
    if not ctors:
        return f"{typ}()"
    # prefer a ctor with no required params
    easy = [d for d in ctors if not _ctor_has_required(d)]
    if easy:
        return f"{typ}()"
    return None


def _pytest_fixture_for(typ: str, lang: str, defs: list[FuncDef]) -> Optional[Construct]:
    if lang != "py" or not typ:
        return None
    for d in defs:
        if d.lang != "py" or not d.is_test:
            continue
        if d.name.startswith("test"):
            continue
        body = d.body or ""
        if typ not in body:
            continue
        # fixture decorator or factory name
        is_fix = "fixture" in (d.decorators or ()) or _FACTORY_RE.match(d.name)
        if not is_fix and not (is_test_path(d.path) and d.kind == "free" and not d.recv):
            continue
        if f"{typ}(" not in body and f"return {typ}" not in body:
            continue
        origin = "pytest-fixture" if "fixture" in (d.decorators or ()) or "fixture" in d.name else "factory"
        expr = f"{d.name}()" if origin == "factory" else d.name
        return Construct(type_name=typ, expr=expr, binding=d.name, origin=origin)
    return None


def choose_construct(fn: FuncDef, defs: list[FuncDef], calls: list[Call]) -> Optional[Construct]:
    """Build a receiver for an instance method. Static / free subjects stay bare."""
    if fn.kind != "instance" or not fn.recv:
        return None
    typ = fn.recv
    bind = binding_name(typ)

    # 1. pytest fixture / test factory of this type
    fx = _pytest_fixture_for(typ, fn.lang, defs)
    if fx:
        return fx

    # 2. self-contained test construction (Type(), Type(sensors: []), Type::new())
    test_calls: list[Call] = []
    for c in calls:
        if not c.is_test:
            continue
        if c.name == typ and (c.recv is None or c.recv == typ):
            test_calls.append(c)
        elif c.recv == typ and c.name in CTOR_NAMES:
            test_calls.append(c)
    scored: list[tuple[int, str]] = []
    for c in test_calls:
        expr = reconstruct_ctor_call(typ, c, fn.lang)
        if not expr:
            continue
        narg = len([a for a in c.args if a.kind != "omit"])
        scored.append((narg, expr))
    if scored:
        scored.sort()
        return Construct(type_name=typ, expr=scored[0][1], binding=bind, origin="test-fixture")

    # 3. zero-arg init / new / default
    z = zero_arg_ctor_expr(typ, fn.lang, defs)
    if z:
        origin = "new" if "::new" in z or z.endswith("::default()") else "zero-init"
        return Construct(type_name=typ, expr=z, binding=bind, origin=origin)

    # 4. last resort: Type() — still a construction; init needs args we don't have
    return Construct(type_name=typ, expr=f"{typ}()", binding=bind, origin="guess")


def attach_constructs(
    reports: list[Report],
    defs: list[FuncDef],
    calls: list[Call],
    construct: bool = True,
) -> None:
    if not construct:
        for r in reports:
            r.construct = None
        return
    cache: dict[tuple, Optional[Construct]] = {}
    for r in reports:
        key = (r.fn.path, r.fn.line, r.fn.name)
        if key not in cache:
            cache[key] = choose_construct(r.fn, defs, calls)
        r.construct = cache[key]


# ---------------------------------------------------------------------------
# seat: append into the existing test type/class
# ---------------------------------------------------------------------------

SEAT_MARK_SWIFT = "// MARK: - seated production worlds"
SEAT_MARK_PY = "# seated production worlds (seat)"


def _snake_ident(name: str) -> str:
    s = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", name or "")
    s = re.sub(r"[^A-Za-z0-9]+", "_", s)
    return s.lower().strip("_")


def _matching_brace(src: str, open_idx: int) -> int:
    """Index of the closing brace matching src[open_idx] == '{'."""
    if open_idx < 0 or open_idx >= len(src) or src[open_idx] != "{":
        return -1
    depth = 0
    i = open_idx
    n = len(src)
    in_str: Optional[str] = None
    in_line = False
    in_block = False
    while i < n:
        c = src[i]
        nxt = src[i + 1] if i + 1 < n else ""
        if in_line:
            if c == "\n":
                in_line = False
            i += 1
            continue
        if in_block:
            if c == "*" and nxt == "/":
                in_block = False
                i += 2
                continue
            i += 1
            continue
        if in_str:
            if c == "\\" and in_str != '"""':
                i += 2
                continue
            if in_str == '"""' and src[i : i + 3] == '"""':
                in_str = None
                i += 3
                continue
            if c == in_str:
                in_str = None
            i += 1
            continue
        if c == "/" and nxt == "/":
            in_line = True
            i += 2
            continue
        if c == "/" and nxt == "*":
            in_block = True
            i += 2
            continue
        if src[i : i + 3] == '"""':
            in_str = '"""'
            i += 3
            continue
        if c in ('"', "'"):
            in_str = c
            i += 1
            continue
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return -1


def _python_block_end(src: str, header_start: int) -> int:
    """Char offset just after the last line of a Python class body."""
    line_start = src.rfind("\n", 0, header_start) + 1
    header_indent = 0
    while line_start + header_indent < header_start and src[line_start + header_indent] in " \t":
        header_indent += 1
    header_nl = src.find("\n", header_start)
    if header_nl < 0:
        return len(src)
    i = header_nl + 1
    last_body = header_nl
    while i < len(src):
        nxt = src.find("\n", i)
        if nxt < 0:
            nxt = len(src)
        line = src[i:nxt]
        if line.strip():
            ind = len(line) - len(line.lstrip(" \t"))
            if ind <= header_indent:
                return last_body
            last_body = nxt
        i = nxt + 1 if nxt < len(src) else len(src)
    return last_body if last_body > header_nl else len(src)


def _existing_test_names(src: str) -> set[str]:
    names: set[str] = set()
    names.update(re.findall(r"\bfunc\s+(\w+)", src))
    names.update(re.findall(r"^def\s+(\w+)\s*\(", src, re.M))
    names.update(re.findall(r"^\s*def\s+(\w+)\s*\(", src, re.M))
    return names


def _setup_binding(src: str, typ: str) -> Optional[str]:
    """Reuse an instance built in setUp / init instead of Type()."""
    if not typ:
        return None
    m = re.search(
        rf"\bfunc\s+setUp(?:WithError)?\s*\([^)]*\)[^{{\n]*\{{(.*?)\n    \}}",
        src,
        re.S,
    )
    body = m.group(1) if m else ""
    if not body:
        m2 = re.search(rf"\binit\s*\([^)]*\)[^{{\n]*\{{(.*?)\n    \}}", src, re.S)
        body = m2.group(1) if m2 else ""
    if not body:
        return None
    bm = re.search(rf"\b(?:let|var|self\.)(\w+)\s*=\s*{re.escape(typ)}\s*\(", body)
    if bm:
        return bm.group(1)
    return None


def _type_from_test_name(name: str) -> str:
    if name.endswith("Tests"):
        return name[: -len("Tests")]
    if name.endswith("Test"):
        return name[: -len("Test")]
    if name.startswith("Test") and len(name) > 4 and name[4].isupper():
        return name[4:]
    if name.startswith("test_"):
        parts = name[5:].split("_")
        return "".join(p[:1].upper() + p[1:] for p in parts if p)
    return name


def parse_swift_hosts(rel: str, abs_path: str, src: str) -> list[SeatHost]:
    hosts: list[SeatHost] = []
    for m in re.finditer(
        r"^(?P<ind>[ \t]*)(?:(?:final|public|open|internal|fileprivate|private)\s+)*"
        r"class\s+(?P<name>\w+)\s*:\s*XCTestCase\b",
        src,
        re.M,
    ):
        if m.group("ind"):
            continue
        name = m.group("name")
        brace = src.find("{", m.end())
        close = _matching_brace(src, brace) if brace >= 0 else -1
        if close < 0:
            continue
        hosts.append(
            SeatHost(
                path=rel,
                abs_path=abs_path,
                name=name,
                kind="xctest",
                type_name=_type_from_test_name(name),
                source=src,
                insert_at=close,
                existing_names=_existing_test_names(src[m.start() : close + 1]),
                indent="    ",
                setup_binding=_setup_binding(src[m.start() : close + 1], _type_from_test_name(name)),
            )
        )
    for m in re.finditer(
        r"^(?P<ind>[ \t]*)(?:(?:public|internal|private)\s+)*struct\s+(?P<name>\w+Tests)\b",
        src,
        re.M,
    ):
        if m.group("ind"):
            continue
        name = m.group("name")
        brace = src.find("{", m.end())
        close = _matching_brace(src, brace) if brace >= 0 else -1
        if close < 0:
            continue
        hosts.append(
            SeatHost(
                path=rel,
                abs_path=abs_path,
                name=name,
                kind="swift-testing",
                type_name=_type_from_test_name(name),
                source=src,
                insert_at=close,
                existing_names=_existing_test_names(src[m.start() : close + 1]),
                indent="    ",
                setup_binding=_setup_binding(src[m.start() : close + 1], _type_from_test_name(name)),
            )
        )
    return hosts


def parse_py_hosts(rel: str, abs_path: str, src: str) -> list[SeatHost]:
    hosts: list[SeatHost] = []
    stem = Path(rel).stem
    for m in re.finditer(r"^(class\s+(?P<name>Test\w+)\s*[\(:])", src, re.M):
        name = m.group("name")
        end = _python_block_end(src, m.start())
        hosts.append(
            SeatHost(
                path=rel,
                abs_path=abs_path,
                name=name,
                kind="pytest-class",
                type_name=_type_from_test_name(name),
                source=src,
                insert_at=end,
                existing_names=_existing_test_names(src[m.start() : end]),
                indent="    ",
            )
        )
    hosts.append(
        SeatHost(
            path=rel,
            abs_path=abs_path,
            name=stem,
            kind="pytest-module",
            type_name=_type_from_test_name(stem),
            source=src,
            insert_at=len(src),
            existing_names=_existing_test_names(src),
            indent="",
        )
    )
    return hosts


def discover_hosts(root: Path, exclude: list[str] | None = None) -> list[SeatHost]:
    hosts: list[SeatHost] = []
    for p in list_source_files(root, exclude):
        try:
            rel = str(p.relative_to(root))
        except ValueError:
            rel = str(p)
        if not is_test_path(rel):
            continue
        try:
            src = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if p.suffix == ".swift":
            hosts.extend(parse_swift_hosts(rel, str(p), src))
        elif p.suffix == ".py":
            hosts.extend(parse_py_hosts(rel, str(p), src))
    return hosts


def _host_score(fn: FuncDef, host: SeatHost) -> int:
    typ = fn.recv or Path(fn.path).stem
    score = 0
    if host.name == f"{typ}Tests" or host.name == f"Test{typ}":
        score += 100
    elif host.name == f"{typ}Test":
        score += 80
    stem = Path(host.path).stem
    if stem == f"{typ}Tests" or stem == f"test_{_snake_ident(typ)}":
        score += 60
    if host.type_name and typ and host.type_name.lower() == typ.lower():
        score += 40
    if typ and typ in host.name:
        # SiteObserverPersistenceTests is a worse match than SiteObserverTests
        extra = len(host.name) - len(typ)
        score += max(5, 25 - extra)
    if fn.lang == "swift" and host.kind not in ("xctest", "swift-testing"):
        return 0
    if fn.lang == "py" and host.kind not in ("pytest-class", "pytest-module"):
        return 0
    if fn.lang not in ("swift", "py"):
        if host.kind.startswith("pytest"):
            score += 1
        else:
            return 0
    return score


def is_type_host(fn: FuncDef, host: SeatHost) -> bool:
    """True only when the host is the test type of this production type.

    A file that merely calls `detect(` is not a seat for NotchGeometry.detect.
    A file that constructs `SessionEngine(` and calls `store(` is.
    """
    typ = fn.recv or Path(fn.path).stem
    if not typ:
        return False
    if fn.lang == "swift" and host.kind not in ("xctest", "swift-testing"):
        return False
    if fn.lang == "py" and host.kind not in ("pytest-class", "pytest-module"):
        return False
    names = {
        f"{typ}Tests",
        f"{typ}Test",
        f"Test{typ}",
        f"test_{_snake_ident(typ)}",
        f"{_snake_ident(typ)}_test",
        f"{_snake_ident(typ)}_tests",
    }
    if host.name in names:
        return True
    stem = Path(host.path).stem
    if stem in names:
        return True
    if host.type_name and host.type_name.lower() == typ.lower():
        return True
    hay = host.source
    type_ref = f"{typ}(" in hay or f"{typ}." in hay or f"{typ}::" in hay
    if not type_ref:
        return False
    if fn.name and (f".{fn.name}(" in hay or f" {fn.name}(" in hay or hay.startswith(f"{fn.name}(")):
        return True
    return False


def choose_seat(fn: FuncDef, hosts: list[SeatHost]) -> Optional[SeatHost]:
    typed = [h for h in hosts if is_type_host(fn, h)]
    if not typed:
        return None
    scored: list[tuple[int, int, SeatHost]] = []
    for h in typed:
        s = _host_score(fn, h)
        if s <= 0:
            continue
        scored.append((s, len(h.name), h))
    if not scored:
        typed.sort(key=lambda h: (len(h.name), h.path))
        return typed[0]
    scored.sort(key=lambda t: (-t[0], t[1], t[2].path))
    return scored[0][2]


def attach_seats(
    reports: list[Report],
    root: Path,
    defs: list[FuncDef],
    calls: list[Call],
    seat: bool = True,
    exclude: list[str] | None = None,
) -> None:
    if not seat:
        for r in reports:
            r.seat = None
        return
    hosts = discover_hosts(root, exclude)
    cache: dict[tuple, Optional[SeatHost]] = {}
    for r in reports:
        key = (r.fn.path, r.fn.line, r.fn.name, r.fn.recv or "")
        if key not in cache:
            cache[key] = choose_seat(r.fn, hosts)
        r.seat = cache[key]


def render_pytest_func_lines(r: Report, f: Fixture, name: str, indent: str = "") -> list[str]:
    I = indent
    construct = r.construct
    call = _emit_call(r.fn, f.args, construct=construct)
    lines: list[str] = []
    if construct and construct.origin == "pytest-fixture":
        lines.append(f"{I}def {name}({construct.binding}):")
    else:
        lines.append(f"{I}def {name}():")
    io = f"  io={f.io}" if f.io else ""
    lines.append(f"{I}    # {r.fn.path}:{r.fn.line}  {f.kind}  {f.label}{io}")
    if f.collection:
        lines.append(f"{I}    # member of {f.collection}")
    if f.sites:
        lines.append(f"{I}    # production: {', '.join(f.sites[:3])}")
    visa = visa_comment(f)
    if visa:
        lines.append(f"{I}    # {visa}")
    if construct and construct.origin == "guess":
        lines.append(f"{I}    # no self-contained test fixture; {construct.type_name}() may need args")
    if construct and construct.origin != "pytest-fixture":
        if r.seat and r.seat.setup_binding:
            pass
        else:
            lines.append(f"{I}    {construct.binding} = {construct.expr}")
    dyn = fixture_dyn_names(f.args)
    if dyn:
        lines.append(f"{I}    pytest.skip({skip_reason(f.args)!r})")
    else:
        lines.append(f"{I}    {wrap_oracle(call, 'pytest', f, r.fn)}")
    return lines


def render_xctest_method_lines(r: Report, f: Fixture, name: str, indent: str = "    ") -> list[str]:
    I = indent
    construct = r.construct
    # when the host already built the type in setUp, call through that binding
    if r.seat and r.seat.setup_binding and construct:
        construct = Construct(
            type_name=construct.type_name,
            expr=construct.expr,
            binding=r.seat.setup_binding,
            origin="setup",
        )
    call = _emit_call(r.fn, f.args, construct=construct)
    dyn = fixture_dyn_names(f.args)
    sig = "() throws" if dyn else "()"
    lines = [f"{I}func {name}{sig} {{"]
    io = f"  io={f.io}" if f.io else ""
    lines.append(f"{I}    // {r.fn.path}:{r.fn.line}  {f.kind}  {f.label}{io}")
    if f.collection:
        lines.append(f"{I}    // member of {f.collection}")
    if f.sites:
        lines.append(f"{I}    // production: {', '.join(f.sites[:3])}")
    visa = visa_comment(f)
    if visa:
        lines.append(f"{I}    // {visa}")
    if construct and construct.origin == "guess":
        lines.append(f"{I}    // no self-contained test fixture; {construct.type_name}() may need args")
    if construct and construct.origin != "setup":
        lines.append(f"{I}    let {construct.binding} = {construct.expr}")
    if dyn:
        if construct:
            lines.append(f"{I}    _ = {construct.binding}")
            lines.append(f"{I}    // {call.replace('...', '_')}")
        reason = skip_reason(f.args).replace("\\", "\\\\").replace('"', '\\"')
        lines.append(f'{I}    throw XCTSkip("{reason}")')
    else:
        lines.append(f"{I}    {wrap_oracle(call, 'xctest', f, r.fn)}")
    lines.append(f"{I}}}")
    return lines


def render_swift_testing_method_lines(r: Report, f: Fixture, name: str, indent: str = "    ") -> list[str]:
    I = indent
    construct = r.construct
    if r.seat and r.seat.setup_binding and construct:
        construct = Construct(
            type_name=construct.type_name,
            expr=construct.expr,
            binding=r.seat.setup_binding,
            origin="setup",
        )
    call = _emit_call(r.fn, f.args, construct=construct)
    dyn = fixture_dyn_names(f.args)
    lines: list[str] = []
    if dyn:
        reason = skip_reason(f.args).replace("\\", "\\\\").replace('"', '\\"')
        lines.append(f'{I}@Test(.disabled("{reason}"))')
        lines.append(f"{I}func {name}() {{")
    else:
        lines.append(f"{I}@Test")
        lines.append(f"{I}func {name}() {{")
    io = f"  io={f.io}" if f.io else ""
    lines.append(f"{I}    // {r.fn.path}:{r.fn.line}  {f.kind}  {f.label}{io}")
    if f.collection:
        lines.append(f"{I}    // member of {f.collection}")
    if f.sites:
        lines.append(f"{I}    // production: {', '.join(f.sites[:3])}")
    visa = visa_comment(f)
    if visa:
        lines.append(f"{I}    // {visa}")
    if construct and construct.origin == "guess":
        lines.append(f"{I}    // no self-contained test fixture; {construct.type_name}() may need args")
    if construct and construct.origin != "setup":
        lines.append(f"{I}    let {construct.binding} = {construct.expr}")
    if dyn:
        if construct:
            lines.append(f"{I}    _ = {construct.binding}")
            lines.append(f"{I}    // {call.replace('...', '_')}")
    else:
        oracle = wrap_oracle(call, "xctest", f, r.fn)
        if oracle.startswith("XCTAssertTrue(") and oracle.endswith(")"):
            inner = oracle[len("XCTAssertTrue(") : -1]
            lines.append(f"{I}    #expect({inner})")
        else:
            lines.append(f"{I}    {call}")
    lines.append(f"{I}}}")
    return lines


def _method_name_for(r: Report, f: Fixture, host: Optional[SeatHost], seen: set[str]) -> str:
    if host and host.kind in ("xctest", "swift-testing"):
        base = swift_func_name(f.suggest)
        if host.kind == "swift-testing" and not base.startswith("test"):
            base = "test" + base[:1].upper() + base[1:]
    else:
        base = f.suggest
    return _unique_name(base, seen)


def render_method_block(r: Report, f: Fixture, name: str, host: SeatHost) -> list[str]:
    if host.kind == "xctest":
        return render_xctest_method_lines(r, f, name, host.indent)
    if host.kind == "swift-testing":
        return render_swift_testing_method_lines(r, f, name, host.indent)
    return render_pytest_func_lines(r, f, name, host.indent)


def _ensure_py_import(src: str, mod: str) -> str:
    if re.search(rf"^(?:from|import)\s+{re.escape(mod)}\b", src, re.M):
        return src
    stmt = f"import {mod}\n"
    matches = list(re.finditer(r"^(?:from\s+\S+\s+import\s+.+|import\s+.+)\n", src, re.M))
    if matches:
        at = matches[-1].end()
        return src[:at] + stmt + src[at:]
    if src.startswith("#!") or src.startswith("#"):
        nl = src.find("\n")
        if nl >= 0:
            return src[: nl + 1] + stmt + src[nl + 1 :]
    return stmt + src


def seat_into_host(host: SeatHost, items: list[tuple[Report, Fixture]]) -> tuple[str, int]:
    """Return (new source, n methods added)."""
    seen = set(host.existing_names)
    blocks: list[str] = []
    n = 0
    for r, f in items:
        name = _method_name_for(r, f, host, seen)
        if name in host.existing_names:
            continue
        lines = render_method_block(r, f, name, host)
        blocks.append("\n".join(lines))
        n += 1
    if not blocks:
        src = host.source
        if not src.endswith("\n"):
            src += "\n"
        return src, 0
    joined = "\n\n".join(blocks) + "\n"
    src = host.source
    at = host.insert_at
    if host.kind in ("xctest", "swift-testing"):
        mark = SEAT_MARK_SWIFT
        prefix = src[:at].rstrip()
        suffix = src[at:]
        if mark not in prefix:
            joined = f"{host.indent}{mark}\n\n" + joined
        new = prefix + "\n\n" + joined + suffix
        if not new.endswith("\n"):
            new += "\n"
        return new, n
    if host.kind == "pytest-class":
        mark = SEAT_MARK_PY
        prefix = src[:at].rstrip()
        suffix = src[at:]
        if mark not in prefix:
            joined = f"{host.indent}{mark}\n" + joined
        new = prefix + "\n\n" + joined + ("\n" if not suffix.startswith("\n") else "") + suffix
        if not new.endswith("\n"):
            new += "\n"
        if "pytest.skip" in new:
            new = _ensure_py_import(new, "pytest")
        return new, n
    mark = SEAT_MARK_PY
    body = src.rstrip() + "\n"
    if mark not in body:
        body += f"\n{mark}\n"
    body += "\n" + joined
    if not body.endswith("\n"):
        body += "\n"
    if "pytest.skip" in body:
        body = _ensure_py_import(body, "pytest")
    return body, n


def _banner(host: SeatHost) -> str:
    if host.kind.startswith("pytest"):
        return f"# ===== seat: {host.path} ({host.name}) =====\n"
    return f"// ===== seat: {host.path} ({host.name}) =====\n"


def collect_seated_files(
    reports: list[Report], due_only: bool = True
) -> tuple[list[tuple[SeatHost, str, int]], list[Report]]:
    """Group generable dues by host; leftover reports fall back to a sibling."""
    by_path: dict[str, tuple[SeatHost, list[tuple[Report, Fixture]]]] = {}
    unseated_ids: set[int] = set()
    unseated: list[Report] = []
    seated_ids: set[int] = set()
    for r, f in iter_fixtures(reports, due_only):
        if not f.generable:
            continue
        if r.seat is None:
            if id(r) not in unseated_ids:
                unseated_ids.add(id(r))
                unseated.append(r)
            continue
        seated_ids.add(id(r))
        h = r.seat
        by_path.setdefault(h.abs_path, (h, []))
        by_path[h.abs_path][1].append((r, f))
    # a report that had some seated fixtures should not also sibling-emit
    unseated = [r for r in unseated if id(r) not in seated_ids]
    files: list[tuple[SeatHost, str, int]] = []
    for _path, (host, items) in by_path.items():
        new, n = seat_into_host(host, items)
        files.append((host, new, n))
    files.sort(key=lambda t: t[0].path)
    return files, unseated


def render_seated(
    reports: list[Report],
    due_only: bool = True,
    emit: Optional[str] = None,
    as_diff: bool = False,
) -> str:
    files, unseated = collect_seated_files(reports, due_only)
    chunks: list[str] = []
    for host, text, _n in files:
        if as_diff:
            old = host.source.splitlines(True)
            if old and not old[-1].endswith("\n"):
                old[-1] += "\n"
            new = text.splitlines(True)
            diff = "".join(
                difflib.unified_diff(old, new, fromfile=host.path, tofile=host.path, lineterm="\n")
            )
            chunks.append(diff)
        else:
            chunks.append(text if len(files) == 1 and not unseated else _banner(host) + text)
    if unseated:
        sibling = render_tests(unseated, due_only=due_only, emit=emit, seat=False)
        if sibling.strip():
            chunks.append(sibling)
    if not chunks:
        return render_tests(reports, due_only=due_only, emit=emit, seat=False)
    return "".join(chunks) if as_diff else "\n".join(c if c.endswith("\n") else c + "\n" for c in chunks)


def apply_seated(files: list[tuple[SeatHost, str, int]]) -> int:
    n = 0
    for host, text, added in files:
        Path(host.abs_path).write_text(text, encoding="utf-8")
        eprint(f"seat: wrote {host.path}  +{added} test(s) into {host.name}")
        n += added
    return n


