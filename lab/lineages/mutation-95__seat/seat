def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="seat",
        description="Write owed production worlds into the existing test type "
        "(SiteObserverTests), not a sibling *SeatTests class. I/O worlds first, "
        "rename-follow kept, Type() only as fallback. --check lists ranked worlds "
        "without writing. --no-seat is loam (sibling). --no-construct is seep. "
        "Visa is a skip comment only.",
    )
    p.add_argument("names", nargs="*", help="function names or any historical alias (default: those with due fixtures)")
    p.add_argument("-C", "--root", default=".", help="repository / tree root")
    p.add_argument("--report", "--human", action="store_true", help="human fixture listing (opt-in; not the default)")
    p.add_argument("--json", action="store_true", help="JSON fixture records")
    p.add_argument("--ndjson", action="store_true", help="one fixture JSON object per line")
    p.add_argument("--tsv", action="store_true", help="TSV fixture rows")
    p.add_argument("--porcelain", action="store_true", help="stable fixture\\tfn\\tkind\\tlabel lines")
    p.add_argument(
        "--emit",
        choices=["auto", "pytest", "xctest"],
        default="auto",
        help="test dialect (default auto: XCTest if most dues are Swift, else pytest)",
    )
    p.add_argument("--all", action="store_true", help="include already-witnessed (have) fixtures")
    p.add_argument("--due", action="store_true", help="only functions with due fixtures (default)")
    p.add_argument(
        "--check",
        action="store_true",
        help="exit 1 if any due fixture; list ranked worlds (no test file) unless --emit/--json/--report/...",
    )
    p.add_argument("--min-callers", type=int, default=1, help="minimum production call sites (default 1)")
    p.add_argument("--test-defs", action="store_true", help="include functions defined in tests as subjects")
    p.add_argument("--exclude", action="append", default=[], help="substring of relative path to skip (repeatable)")
    p.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    p.add_argument("--self-test", action="store_true")
    p.add_argument("--summary", action="store_true", help="one-line census")
    p.add_argument("--version", action="store_true")
    p.add_argument("--follow", dest="follow", action="store_true", default=True, help=argparse.SUPPRESS)
    p.add_argument(
        "--no-follow",
        dest="follow",
        action="store_false",
        help="disable rename-follow (HEAD token is the identity, like sow/hatch)",
    )
    p.add_argument("--rank", dest="rank", action="store_true", default=True, help=argparse.SUPPRESS)
    p.add_argument(
        "--no-rank",
        dest="rank",
        action="store_false",
        help="disable I/O ranking (call-site / label order, like hatch/till)",
    )
    p.add_argument("--construct", dest="construct", action="store_true", default=True, help=argparse.SUPPRESS)
    p.add_argument(
        "--no-construct",
        dest="construct",
        action="store_false",
        help="disable Type() construction (Type.method like seep; instance worlds are not callable)",
    )
    p.add_argument("--seat", dest="seat", action="store_true", default=True, help=argparse.SUPPRESS)
    p.add_argument(
        "--no-seat",
        dest="seat",
        action="store_false",
        help="disable seating (sibling *SeatTests class, like loam)",
    )
    p.add_argument(
        "--apply",
        action="store_true",
        help="write seated methods into the existing test file(s) instead of stdout",
    )
    p.add_argument(
        "--diff",
        action="store_true",
        help="emit a unified diff against the existing test file instead of the seated file",
    )
    p.add_argument("--since", default=None, help="limit rename-follow to commits since this date")
    p.add_argument("--range", dest="rev_range", default=None, help="git revision range (e.g. HEAD~20..HEAD)")
    p.add_argument("--max-follow", type=int, default=80, help="max commits to scan for renames (default 80)")
    p.add_argument(
        "--aka",
        action="append",
        default=[],
        metavar="OLD=HEAD",
        help="manual alias (repeatable), e.g. --aka isWebApp=isBrowser",
    )
    p.add_argument(
        "--aka-map",
        action="store_true",
        help="print rename identity table (aka\\thead\\told\\tcommit\\tpath) and exit",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    p = build_parser()
    try:
        args = p.parse_args(argv)
    except SystemExit as e:
        return int(e.code) if isinstance(e.code, int) else 2
    if args.version:
        print(VERSION)
        return 0
    if args.self_test:
        return self_test()
    root = Path(args.root).resolve()
    if not root.exists():
        eprint(f"seat: no such path: {root}")
        return 2
    defs, calls, reports = analyze(
        root,
        args.exclude,
        include_test_defs=args.test_defs,
        follow=args.follow,
        since=args.since,
        rev_range=args.rev_range,
        max_follow=args.max_follow,
        aka_specs=args.aka,
        names=args.names or None,
        rank=args.rank,
        construct=args.construct,
        seat=args.seat,
    )
    due_only = not args.all
    filtered = filter_reports(reports, args.names, args.min_callers, due_only=False)
    if args.names:
        view = filtered
    elif args.all:
        view = filtered
    else:
        view = [r for r in filtered if r.due]

    n_due_fns = sum(1 for r in reports if r.due)
    n_due = sum(len(r.due) for r in reports)
    n_prod_fns = len(reports)
    n_aka = sum(1 for r in reports if r.aka)

    n_io = sum(1 for r in reports for f in r.due if f.io_score)
    if args.summary:
        print(
            f"files={len(list_source_files(root, args.exclude))} defs={len(defs)} calls={len(calls)} "
            f"prod_fns={n_prod_fns} due_fns={n_due_fns} due={n_due} "
            f"generable={sum(1 for r in reports for f in r.due if f.generable)} "
            f"aka_fns={n_aka} io_due={n_io}"
        )
        if args.check:
            return 1 if n_due_fns else 0
        return 0

    color = use_color(args.color)
    out_reports = view
    if args.aka_map:
        pool = filtered if args.names else reports
        sys.stdout.write(render_aka_map(pool))
        if args.check:
            return 1 if any(r.due for r in (view if args.names else reports)) else 0
        return 0
    wrote_format = args.json or args.ndjson or args.tsv or args.porcelain or args.report
    # --check lists ranked worlds unless the user asked for a format / --emit
    list_only = args.check and not wrote_format and args.emit == "auto"
    if args.json:
        sys.stdout.write(render_json(out_reports, due_only=due_only))
    elif args.ndjson:
        sys.stdout.write(render_ndjson(out_reports, due_only=due_only))
    elif args.tsv:
        sys.stdout.write(render_tsv(out_reports, due_only=due_only))
    elif args.porcelain:
        sys.stdout.write(render_porcelain(out_reports, due_only=due_only))
    elif args.report:
        sys.stdout.write(
            render_human(out_reports, color, show_all=args.all, keep_sown=bool(args.names))
        )
    elif list_only:
        sys.stdout.write(render_rank(out_reports, due_only=due_only))
    elif args.apply:
        if not args.seat:
            eprint("seat: --apply needs seating (omit --no-seat)")
            return 2
        files, unseated = collect_seated_files(out_reports, due_only=due_only)
        if not files:
            eprint("seat: no existing test type to apply into (Type() sibling stays on stdout)")
            sys.stdout.write(render_tests(out_reports, due_only=due_only, emit=args.emit, seat=False))
            return 2 if not out_reports else 0
        apply_seated(files)
        if unseated:
            eprint(f"seat: {len(unseated)} subject(s) had no host; sibling on stdout")
            sys.stdout.write(render_tests(unseated, due_only=due_only, emit=args.emit, seat=False))
    else:
        # default: seated existing test file, I/O worlds first among new methods
        sys.stdout.write(
            render_tests(
                out_reports,
                due_only=due_only,
                emit=args.emit,
                seat=args.seat,
                as_diff=args.diff,
            )
        )

    if args.check:
        pool = view if args.names else reports
        return 1 if any(r.due for r in pool) else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
