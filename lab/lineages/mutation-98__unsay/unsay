# ---------------------------------------------------------------------------
# signature extraction
# ---------------------------------------------------------------------------

def enclosing_type(prefix: str, lang: str) -> str | None:
    if lang == "swift":
        pat = rf"(?:struct|class|enum|actor|extension|protocol)\s+({IDENT})"
    elif lang == "py":
        pat = rf"class\s+({IDENT})"
    elif lang == "rs":
        pat = rf"(?:struct|enum|impl(?:\s*<[^>]*>)?)\s+({IDENT})"
    else:
        pat = rf"(?:class|interface|type|enum)\s+({IDENT})"
    last = None
    for m in re.finditer(pat, prefix):
        last = m.group(1)
    return last


def enclosing_variant(prefix: str) -> str | None:
    """Last Ident {{ before here — clap lives on enum variants, not the enum name."""
    last = None
    for m in re.finditer(rf"({IDENT})\s*\{{", prefix):
        last = m.group(1)
    if last in {
        "enum",
        "struct",
        "impl",
        "mod",
        "match",
        "if",
        "else",
        "for",
        "while",
        "unsafe",
        "pub",
    }:
        return None
    return last


def parse_swift_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk)
    if not chunk or chunk.startswith("@"):
        # attributes like @escaping may prefix; keep going
        chunk = re.sub(r"^(@[A-Za-z_]\w*(?:\([^)]*\))?\s*)+", "", chunk).strip()
    if not chunk:
        return None
    default = None
    # split default at depth-0 '='
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    # name: Type   or  ext int: Type  or  _ int: Type
    m = re.match(
        rf"(?:({IDENT}|_)\s+)?({IDENT})\s*:",
        chunk,
    )
    if not m:
        return None
    ext, name = m.group(1), m.group(2)
    if ext and ext != "_" and name:
        # external internal:  the *call* uses external label
        call_name = ext
    else:
        call_name = name
    if call_name == "_":
        call_name = name
    return Param(name=call_name, default=default, index=index)


def parse_py_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk).strip()
    if not chunk:
        return None
    if chunk.startswith("**") or chunk.startswith("*"):
        return None
    if chunk in {"self", "cls", "/", "*"}:
        return None
    if chunk.startswith("/") or chunk == "*":
        return None
    default = None
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    # drop annotation
    if ":" in chunk:
        name = chunk.split(":", 1)[0].strip()
    else:
        name = chunk.strip()
    if not re.fullmatch(IDENT, name) or name in {"self", "cls"}:
        return None
    return Param(name=name, default=default, index=index)


def parse_ts_param(chunk: str, index: int) -> Param | None:
    chunk = strip_line_comment(chunk).strip()
    if not chunk or chunk.startswith("..."):
        return None
    default = None
    depth = 0
    eq = None
    for i, ch in enumerate(chunk):
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == "=" and depth == 0:
            eq = i
            break
    if eq is not None:
        default = chunk[eq + 1 :].strip()
        chunk = chunk[:eq].strip()
    chunk = re.sub(r"[?:].*$", "", chunk).strip()
    chunk = chunk.lstrip("{").strip()
    if not re.fullmatch(IDENT, chunk):
        return None
    return Param(name=chunk, default=default, index=index)


def parse_params(inner: str, lang: str) -> list[Param]:
    out: list[Param] = []
    idx = 0
    for chunk in split_top(inner):
        if lang == "swift":
            p = parse_swift_param(chunk, idx)
        elif lang == "py":
            p = parse_py_param(chunk, idx)
        else:
            p = parse_ts_param(chunk, idx)
        if p:
            out.append(p)
            idx += 1
    return out


def extract_swift_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pat = re.compile(
        rf"{SWIFT_MOD}(func|init)\s*(?:<[^>\n]*>)?\s*({IDENT})?\s*\(",
        re.M,
    )
    for m in pat.finditer(masked):
        kind, name = m.group(1), m.group(2)
        open_idx = m.end() - 1
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = parse_params(inner, "swift")
        if kind == "init":
            callee = enclosing_type(masked[: m.start()], "swift")
            if not callee:
                continue
            skind = "init"
        else:
            callee = name
            if not callee:
                continue
            skind = "func"
        if not any(p.default is not None for p in params):
            continue
        sigs.append(
            Sig(
                callee=callee,
                params=params,
                path=path,
                line=line_at(src, m.start()),
                lang="swift",
                kind=skind,
                open_idx=open_idx,
            )
        )
    return sigs


def extract_py_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pat = re.compile(rf"(?:async\s+)?def\s+({IDENT})\s*\(", re.M)
    for m in pat.finditer(masked):
        name = m.group(1)
        open_idx = m.end() - 1
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = parse_params(inner, "py")
        kind = "func"
        callee = name
        if name == "__init__":
            cls = enclosing_type(masked[: m.start()], "py")
            if not cls:
                continue
            callee = cls
            kind = "init"
        if not any(p.default is not None for p in params):
            continue
        sigs.append(
            Sig(
                callee=callee,
                params=params,
                path=path,
                line=line_at(src, m.start()),
                lang="py",
                kind=kind,
                open_idx=open_idx,
            )
        )
    # dataclass fields
    for m in re.finditer(
        rf"@dataclass(?:\([^)]*\))?\s*\nclass\s+({IDENT})\s*(?:\([^)]*\))?\s*:",
        masked,
    ):
        cls = m.group(1)
        # body: until next class/def at column 0
        rest = src[m.end() :]
        params: list[Param] = []
        idx = 0
        for line in rest.splitlines():
            if re.match(r"^(class|def|async def)\b", line):
                break
            fm = re.match(
                rf"\s+({IDENT})\s*:\s*[^=\n]+?=\s*(.+?)\s*$",
                line,
            )
            if not fm:
                continue
            default = strip_line_comment(fm.group(2))
            params.append(Param(name=fm.group(1), default=default, index=idx))
            idx += 1
        if params:
            sigs.append(
                Sig(
                    callee=cls,
                    params=params,
                    path=path,
                    line=line_at(src, m.start()),
                    lang="py",
                    kind="class",
                )
            )
    return sigs


def extract_ts_sigs(src: str, masked: str, path: str) -> list[Sig]:
    sigs: list[Sig] = []
    pats = [
        re.compile(rf"(?:export\s+)?(?:async\s+)?function\s+({IDENT})\s*(?:<[^>]*>)?\s*\("),
        re.compile(rf"(?:export\s+)?(?:const|let|var)\s+({IDENT})\s*=\s*(?:async\s+)?(?:<[^>]*>)?\("),
        re.compile(
            rf"(?:(?:public|private|protected|static|async|readonly)\s+)*(constructor)\s*\("
        ),
        # class/object methods with a default, but not every ident(
        re.compile(
            rf"(?:(?:public|private|protected|static|async|readonly)\s+)+({IDENT})\s*(?:<[^>]*>)?\s*\("
        ),
    ]
    seen_opens: set[int] = set()
    for pat in pats:
        for m in pat.finditer(masked):
            open_idx = m.end() - 1
            if open_idx in seen_opens:
                continue
            # constructor / method: skip control keywords
            name = m.group(1)
            if name in {
                "if",
                "for",
                "while",
                "switch",
                "catch",
                "function",
                "return",
                "await",
                "new",
            }:
                continue
            close = match_paren(src, open_idx)
            if close is None:
                continue
            inner = src[open_idx + 1 : close]
            params = parse_params(inner, "ts")
            if not any(p.default is not None for p in params):
                continue
            seen_opens.add(open_idx)
            callee = name
            kind = "func"
            if name == "constructor":
                cls = enclosing_type(masked[: m.start()], "ts")
                if not cls:
                    continue
                callee = cls
                kind = "init"
            sigs.append(
                Sig(
                    callee=callee,
                    params=params,
                    path=path,
                    line=line_at(src, m.start()),
                    lang="ts",
                    kind=kind,
                    open_idx=open_idx,
                )
            )
    return sigs


def extract_clap_sigs(src: str, masked: str, path: str) -> list[Sig]:
    """Rust clap #[arg(default_value = ...)] field → a defaulted slot.

    Structure is matched on the masked file (strings are spaces); the
    default *value* is read from the original, because it lives in a string.
    """
    sigs: list[Sig] = []
    pat = re.compile(
        r"#\[arg\((.*?)\)\]\s*(?:pub\s+)?(" + IDENT + r")\s*:",
        re.S,
    )
    for m in pat.finditer(masked):
        orig = src[m.start() : m.end()]
        field = m.group(2)
        dm = re.search(
            r'default_value(?:_t)?\s*=\s*("(?:\\.|[^"])*"|[A-Za-z0-9_.]+)',
            orig,
        )
        if not dm:
            continue
        default = dm.group(1)
        callee = enclosing_variant(masked[: m.start()]) or enclosing_type(
            masked[: m.start()], "rs"
        ) or field
        sigs.append(
            Sig(
                callee=callee,
                params=[Param(name=field, default=default, index=0)],
                path=path,
                line=line_at(src, m.start()),
                lang="rs",
                kind="clap",
            )
        )
    return sigs


def extract_sigs(src: str, path: str, lang: str) -> list[Sig]:
    masked = mask(src, lang)
    if lang == "swift":
        return extract_swift_sigs(src, masked, path)
    if lang == "py":
        return extract_py_sigs(src, masked, path)
    if lang == "rs":
        return extract_clap_sigs(src, masked, path)
    return extract_ts_sigs(src, masked, path)


# ---------------------------------------------------------------------------
# call extraction
# ---------------------------------------------------------------------------

def parse_call_args(
    inner: str, lang: str, params: list[Param]
) -> tuple[dict[str, str], set[str], dict[str, tuple[int, int, bool]]]:
    """Return (passed, bound, locs). locs: name -> (inner_start, inner_end, keyword)."""
    passed: dict[str, str] = {}
    bound: set[str] = set()
    locs: dict[str, tuple[int, int, bool]] = {}
    positional_names = [p.name for p in params]
    pos_i = 0
    for start, end in split_top_spans(inner):
        chunk = strip_line_comment(inner[start:end].strip())
        if not chunk:
            continue
        kw = None
        val = None
        keyword = False
        if lang == "swift":
            m = re.match(rf"({IDENT})\s*:\s*(.*)$", chunk, re.S)
            if m:
                kw, val = m.group(1), m.group(2).strip()
                keyword = True
        else:
            m = re.match(rf"({IDENT})\s*=\s*(.*)$", chunk, re.S)
            if m:
                kw, val = m.group(1), m.group(2).strip()
                keyword = True
        if kw is None:
            if pos_i >= len(positional_names):
                continue
            # swift inits are labeled; a positional unlabeled arg is
            # almost always a comment residue or type-cast, not a call.
            if lang == "swift":
                continue
            kw = positional_names[pos_i]
            val = chunk
            pos_i += 1
        else:
            if kw in positional_names:
                ni = positional_names.index(kw)
                if ni >= pos_i:
                    pos_i = ni + 1
        passed[kw] = val
        locs[kw] = (start, end, keyword)
        if not is_literal(val):
            bound.add(kw)
    return passed, bound, locs


def find_calls(
    src: str,
    path: str,
    lang: str,
    callees: set[str],
    merged: dict[str, list[Param]],
    sig_opens: set[int] | None = None,
) -> list[Call]:
    if not callees:
        return []
    masked = mask(src, lang)
    names = sorted(callees, key=len, reverse=True)
    # longest-first so PresenceArbiter wins over Arbiter if both exist
    pat = re.compile(r"\b(" + "|".join(re.escape(n) for n in names) + r")\s*\(")
    role = role_of(path)
    calls: list[Call] = []
    opens = sig_opens or set()
    for m in pat.finditer(masked):
        name = m.group(1)
        open_idx = m.end() - 1
        if open_idx in opens:
            continue  # this paren belongs to the signature, not a call
        close = match_paren(src, open_idx)
        if close is None:
            continue
        inner = src[open_idx + 1 : close]
        params = merged.get(name, [])
        passed, bound, locs = parse_call_args(inner, lang, params)
        # swift: require at least one labeled arg OR empty ()
        # unlabeled-only was filtered; empty is a real call (Thresholds())
        if lang == "swift" and inner.strip() and not passed:
            continue
        calls.append(
            Call(
                callee=name,
                passed=passed,
                bound=bound,
                path=path,
                line=line_at(src, m.start()),
                role=role,
                lang=lang,
                kind="call",
                open_idx=open_idx,
                close_idx=close,
                arg_locs=locs,
                style_keyword=any(v[2] for v in locs.values()),
            )
        )
    return calls


def kebab(name: str) -> str:
    return re.sub(r"(?<!^)(?=[A-Z])", "-", name).replace("_", "-").lower()


def clap_bound_token(val: str) -> bool:
    """Format/interpolation/path-expr tokens are BOUND, not OVERRIDE."""
    if not val:
        return True
    if val[0] in "{$\\":
        return True
    if "{" in val or "}" in val or "$" in val:
        return True
    if val.endswith("\\n") or "\\n" in val:
        return True
    return False


def pick_clap_callees(line: str, sigs: list[Sig]) -> list[Sig]:
    """Bind --flag on a line to the subcommand named on that line."""
    hits = []
    for s in sigs:
        kb = kebab(s.callee)
        if kb and kb in line.lower():
            hits.append(s)
    if hits:
        return hits
    if len(sigs) == 1:
        return sigs
    return []  # ambiguous: two clap slots share the flag, line names neither


def find_clap_uses(src: str, path: str, flags: dict[str, list[Sig]]) -> list[Call]:
    """Find --flag value mentions for clap slots."""
    if not flags:
        return []
    role = role_of(path)
    calls: list[Call] = []
    lines = src.splitlines()
    for field, sigs in flags.items():
        flag = field.replace("_", "-")
        pat = re.compile(
            rf"--{re.escape(flag)}(?:\s+|=)([^\s,;\"'`)\]}}]+)"
        )
        for m in pat.finditer(src):
            val = m.group(1).rstrip("\"',")
            if val.endswith("\\n") or val.endswith("\\t"):
                val = val[:-2]
            if not val or val.startswith(("'", '"')):
                continue
            line_no = line_at(src, m.start())
            line_txt = lines[line_no - 1] if 0 < line_no <= len(lines) else ""
            chosen = pick_clap_callees(line_txt, sigs)
            if not chosen:
                continue
            bound: set[str] = set()
            if clap_bound_token(val):
                passed_val = val
                bound.add(field)
            else:
                passed_val = val if val.startswith(("'", '"')) else f'"{val}"'
            for sig in chosen:
                calls.append(
                    Call(
                        callee=sig.callee,
                        passed={field: passed_val},
                        bound=set(bound),
                        path=path,
                        line=line_no,
                        role=role,
                        lang="rs",
                        kind="clap",
                        flag_start=m.start(),
                        flag_end=m.end(),
                    )
                )
        for sig in sigs:
            kb = kebab(sig.callee)
            tacit_pat = re.compile(
                rf"\b{re.escape(kb)}\b(?![^\n]*--{re.escape(flag)}\b)"
            )
            for m in tacit_pat.finditer(src):
                line = src.count("\n", 0, m.start())
                line_txt = lines[line] if line < len(lines) else ""
                # command-shaped only
                if "command:" not in line_txt and "kizu " not in line_txt.lower() and "$ " not in line_txt:
                    continue
                calls.append(
                    Call(
                        callee=sig.callee,
                        passed={},
                        bound=set(),
                        path=path,
                        line=line + 1,
                        role=role,
                        lang="rs",
                        kind="clap",
                    )
                )
    return calls


# ---------------------------------------------------------------------------
# walk / git
# ---------------------------------------------------------------------------

def lang_of(path: str) -> str | None:
    ext = Path(path).suffix.lower()
    return {
        ".swift": "swift",
        ".py": "py",
        ".ts": "ts",
        ".tsx": "ts",
        ".js": "ts",
        ".jsx": "ts",
        ".rs": "rs",
    }.get(ext)


def iter_files(root: Path) -> Iterator[Path]:
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [
            d
            for d in dirnames
            if d not in SKIP_DIRS and not d.startswith(".")
        ]
        for fn in filenames:
            p = Path(dirpath) / fn
            if p.suffix.lower() in CODE_EXTS:
                yield p


def read_text(path: Path) -> str | None:
    try:
        if path.stat().st_size > MAX_BYTES:
            return None
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None


def git(repo: str, *args: str) -> str:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"git {' '.join(args)} failed")
    return r.stdout


def git_ok(repo: str, *args: str) -> str | None:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        return None
    return r.stdout


def tree_files(repo: str, rev: str) -> list[str]:
    out = git(repo, "ls-tree", "-r", "--name-only", rev)
    files = []
    for line in out.splitlines():
        if Path(line).suffix.lower() in CODE_EXTS:
            files.append(line)
    return files


def tree_text(repo: str, rev: str, path: str) -> str | None:
    r = subprocess.run(
        ["git", "-C", repo, "show", f"{rev}:{path}"],
        capture_output=True,
    )
    if r.returncode != 0:
        return None
    if len(r.stdout) > MAX_BYTES:
        return None
    return r.stdout.decode("utf-8", errors="replace")


# ---------------------------------------------------------------------------
# harvest a tree
# ---------------------------------------------------------------------------

@dataclass
class Harvest:
    sigs: list[Sig] = field(default_factory=list)
    calls: list[Call] = field(default_factory=list)
    texts: dict[str, str] = field(default_factory=dict)

    def merged_params(self) -> dict[str, list[Param]]:
        """Union of params per callee. A name is defaultable if any overload
        gives it a default; required-only names stay required."""
        order: dict[str, list[str]] = {}
        defs: dict[tuple[str, str], str | None] = {}
        idx_of: dict[tuple[str, str], int] = {}
        for s in self.sigs:
            if s.callee not in order:
                order[s.callee] = []
            for p in s.params:
                key = (s.callee, p.name)
                if p.name not in order[s.callee]:
                    order[s.callee].append(p.name)
                    idx_of[key] = p.index
                if key not in defs:
                    defs[key] = p.default
                elif defs[key] is None and p.default is not None:
                    defs[key] = p.default
        merged: dict[str, list[Param]] = {}
        for callee, names in order.items():
            merged[callee] = [
                Param(name=n, default=defs[(callee, n)], index=i)
                for i, n in enumerate(names)
            ]
        return merged


def harvest_texts(items: list[tuple[str, str, str]]) -> Harvest:
    """items: (path, src, lang)"""
    h = Harvest()
    for path, src, lang in items:
        h.texts[path] = src
        h.sigs.extend(extract_sigs(src, path, lang))
    merged = h.merged_params()
    callees = {s.callee for s in h.sigs if s.kind != "clap"}
    clap_flags: dict[str, list[Sig]] = {}
    sig_opens: dict[str, set[int]] = {}
    for s in h.sigs:
        if s.open_idx >= 0:
            sig_opens.setdefault(s.path, set()).add(s.open_idx)
        if s.kind == "clap" and s.params:
            clap_flags.setdefault(s.params[0].name, []).append(s)
    seen_call: set[tuple[str, str, int, tuple]] = set()
    for path, src, lang in items:
        if lang == "rs":
            for c in find_clap_uses(src, path, clap_flags):
                key = (c.callee, c.path, c.line, tuple(sorted(c.passed.items())))
                if key in seen_call:
                    continue
                seen_call.add(key)
                h.calls.append(c)
            continue
        for c in find_calls(
            src, path, lang, callees, merged, sig_opens.get(path, set())
        ):
            key = (c.callee, c.path, c.line, tuple(sorted(c.passed.items())))
            if key in seen_call:
                continue
            seen_call.add(key)
            h.calls.append(c)
    return h


def harvest_root(root: Path) -> Harvest:
    items: list[tuple[str, str, str]] = []
    for p in iter_files(root):
        lang = lang_of(str(p))
        if not lang:
            continue
        src = read_text(p)
        if src is None:
            continue
        items.append((str(p), src, lang))
    return harvest_texts(items)


def harvest_rev(repo: str, rev: str) -> Harvest:
    items: list[tuple[str, str, str]] = []
    for path in tree_files(repo, rev):
        lang = lang_of(path)
        if not lang:
            continue
        src = tree_text(repo, rev, path)
        if src is None:
            continue
        items.append((path, src, lang))
    return harvest_texts(items)


# ---------------------------------------------------------------------------
# classify
# ---------------------------------------------------------------------------

def _norm_val(v: str) -> str:
    return re.sub(r"\s+", "", (v or "").strip())


def sibling_args(call: Call, slot: str) -> tuple:
    """Call identity excluding the slot that may later be spoken."""
    return tuple(
        sorted(
            (k, _norm_val(v))
            for k, v in call.passed.items()
            if k != slot
        )
    )


def classify_call(call: Call, params: list[Param]) -> list[Row]:
    rows: list[Row] = []
    defaultable = [p for p in params if p.default is not None]
    for p in defaultable:
        default = p.default or ""
        if p.name not in call.passed:
            verdict = "TACIT"
            passed = "—"
        elif p.name in call.bound:
            verdict = "BOUND"
            passed = call.passed[p.name]
        elif values_equal(call.passed[p.name], default):
            verdict = "SHADOW"
            passed = call.passed[p.name]
        else:
            verdict = "OVERRIDE"
            passed = call.passed[p.name]
        loc = call.arg_locs.get(p.name)
        rows.append(
            Row(
                verdict=verdict,
                role=call.role,
                callee=call.callee,
                param=p.name,
                default=default,
                passed=passed,
                path=call.path,
                line=call.line,
                others=sibling_args(call, p.name),
                lang=call.lang,
                kind=call.kind,
                open_idx=call.open_idx,
                close_idx=call.close_idx,
                arg_start=loc[0] if loc else -1,
                arg_end=loc[1] if loc else -1,
                arg_keyword=loc[2] if loc else call.style_keyword,
                flag_start=call.flag_start,
                flag_end=call.flag_end,
                style_keyword=call.style_keyword,
            )
        )
    return rows


def unfold_rows(rows: list[Row], merged: dict[str, list[Param]]) -> list[Row]:
    """A TACIT slot whose default is Foo() also rides Foo's defaults."""
    extra: list[Row] = []
    for r in rows:
        if r.verdict != "TACIT":
            continue
        ctor = ctor_name(r.default)
        if not ctor or ctor not in merged:
            continue
        for p in merged[ctor]:
            if p.default is None:
                continue
            extra.append(
                Row(
                    verdict="TACIT",
                    role=r.role,
                    callee=r.callee,
                    param=f"{r.param}.{p.name}",
                    default=p.default,
                    passed="—",
                    path=r.path,
                    line=r.line,
                    others=r.others,
                )
            )
    return rows + extra


def classify_harvest(h: Harvest, unfold: bool) -> list[Row]:
    merged = h.merged_params()
    rows: list[Row] = []
    for c in h.calls:
        params = merged.get(c.callee, [])
        if not params:
            continue
        rows.extend(classify_call(c, params))
    if unfold:
        rows = unfold_rows(rows, merged)
    return rows


def pair_renames(old: list[Param], new: list[Param]) -> dict[str, str]:
    """Map new-param-name → old-param-name when a defaulted slot kept its
    position but changed identity (threshold → presentThreshold)."""
    mapping: dict[str, str] = {}
    old_by_i = {p.index: p for p in old}
    new_names = {p.name for p in new}
    old_names = {p.name for p in old}
    for p in new:
        if p.name in old_names:
            mapping[p.name] = p.name
            continue
        cand = old_by_i.get(p.index)
        if (
            cand
            and cand.name not in new_names
            and cand.default is not None
            and p.default is not None
        ):
            mapping[p.name] = cand.name
    return mapping


def diff_rows(
    old_h: Harvest,
    new_h: Harvest,
    unfold: bool,
) -> list[Row]:
    old_m = old_h.merged_params()
    new_m = new_h.merged_params()
    rows = classify_harvest(new_h, unfold=unfold)
    # defaults per (callee, param)
    def defmap(m: dict[str, list[Param]]) -> dict[tuple[str, str], str | None]:
        out: dict[tuple[str, str], str | None] = {}
        for callee, params in m.items():
            for p in params:
                out[(callee, p.name)] = p.default
        return out

    old_d = defmap(old_m)
    new_d = defmap(new_m)
    rename: dict[tuple[str, str], str] = {}  # (callee, new_name) -> old_name
    for callee, params in new_m.items():
        if callee not in old_m:
            continue
        mapping = pair_renames(old_m[callee], params)
        for new_n, old_n in mapping.items():
            if new_n != old_n:
                rename[(callee, new_n)] = old_n

    tagged: list[Row] = []
    for r in rows:
        # unfold params: look at the leaf ctor? treat as nested; skip rename
        key = (r.callee, r.param.split(".")[0] if "." in r.param else r.param)
        # for unfolded, why follows the parent slot's default change only
        # if the parent ctor default itself moved. Usually Thresholds() is stable.
        param = r.param
        leaf = param.split(".")[-1]
        old_name = rename.get((r.callee, param), param)
        if "." in param:
            old_val = old_d.get((ctor_name(r.default) or "", leaf))
            # unfolded: compare inner default across trees
            parent = param.split(".")[0]
            ctor = ctor_name(
                next(
                    (
                        p.default
                        for p in new_m.get(r.callee, [])
                        if p.name == parent
                    ),
                    r.default,
                )
                or r.default
            )
            old_val = old_d.get((ctor or "", leaf)) if ctor else None
            new_val = new_d.get((ctor or "", leaf)) if ctor else r.default
        else:
            old_val = old_d.get((r.callee, old_name))
            if old_val is None and old_name != param:
                old_val = old_d.get((r.callee, old_name))
            new_val = new_d.get((r.callee, param))

        changed = (old_val is not None and new_val is not None and not values_equal(str(old_val), str(new_val)))
        born = old_val is None and new_val is not None
        died = old_val is not None and new_val is None
        if not (changed or born or died) and old_name == param:
            continue  # stable slot: omit from diff view
        why = ""
        if r.verdict == "TACIT" and (changed or born):
            why = "BLAST"
        elif r.verdict in {"SHADOW", "OVERRIDE"} and old_val is not None and values_equal(r.passed, str(old_val)):
            why = "FOSSIL"
        elif r.verdict == "SHADOW" and (changed or born):
            why = "PRE"
        elif r.verdict == "OVERRIDE" and (changed or born):
            why = "LOCK"
        elif r.verdict == "BOUND" and (changed or born):
            why = "BOUND"
        elif died:
            why = "DIED"
        else:
            why = "BLAST" if r.verdict == "TACIT" else r.verdict
        rr = Row(**{**r.__dict__, "why": why})
        if changed and old_val is not None:
            rr.default = f"{old_val}→{new_val}"
        tagged.append(rr)
    return tagged


@dataclass
class Moved:
    callee: str
    param: str
    old_name: str
    old_val: str | None
    new_val: str | None


def relativize_harvest(h: Harvest, root: str | None) -> Harvest:
    if not root:
        return h
    for s in h.sigs:
        s.path = relpath(s.path, root).replace("\\", "/")
    for c in h.calls:
        c.path = relpath(c.path, root).replace("\\", "/")
    texts: dict[str, str] = {}
    for p, src in h.texts.items():
        texts[_norm_path(relpath(p, root))] = src
    h.texts = texts
    return h


def moved_slots(old_h: Harvest, new_h: Harvest) -> list[Moved]:
    """Slots whose default moved, was born, or was renamed-and-moved.

    Rename-only (same literal, new name) is not a blast of a *value*.
    """
    old_m = old_h.merged_params()
    new_m = new_h.merged_params()

    def defmap(m: dict[str, list[Param]]) -> dict[tuple[str, str], str | None]:
        out: dict[tuple[str, str], str | None] = {}
        for callee, params in m.items():
            for p in params:
                out[(callee, p.name)] = p.default
        return out

    old_d = defmap(old_m)
    new_d = defmap(new_m)
    rename: dict[tuple[str, str], str] = {}
    for callee, params in new_m.items():
        if callee not in old_m:
            continue
        mapping = pair_renames(old_m[callee], params)
        for new_n, old_n in mapping.items():
            if new_n != old_n:
                rename[(callee, new_n)] = old_n

    seen: set[tuple[str, str]] = set()
    out: list[Moved] = []
    for callee, params in new_m.items():
        for p in params:
            if p.default is None:
                continue
            old_name = rename.get((callee, p.name), p.name)
            old_val = old_d.get((callee, old_name))
            new_val = p.default
            changed = (
                old_val is not None
                and new_val is not None
                and not values_equal(str(old_val), str(new_val))
            )
            born = old_val is None and new_val is not None
            if not (changed or born):
                continue
            key = (callee, p.name)
            if key in seen:
                continue
            seen.add(key)
            out.append(
                Moved(
                    callee=callee,
                    param=p.name,
                    old_name=old_name,
                    old_val=None if old_val is None else str(old_val),
                    new_val=str(new_val),
                )
            )
    return out


def _norm_path(p: str) -> str:
    return p.replace("\\", "/").lstrip("./")


def _prefix(r: Row) -> tuple:
    return (_norm_path(r.path), r.callee, r.param, r.others)


def _group_by_prefix(rows: list[Row]) -> dict[tuple, list[Row]]:
    groups: dict[tuple, list[Row]] = {}
    for r in rows:
        groups.setdefault(_prefix(r), []).append(r)
    for rs in groups.values():
        rs.sort(key=lambda x: (x.line, x.passed, x.verdict))
    return groups


def _slot_rows(rows: list[Row], moved: list[Moved]) -> list[Row]:
    want = {(m.callee, m.param) for m in moved}
    # unfolded leaf: Thresholds.driftDelay may move even if parent is stable
    out = []
    for r in rows:
        leaf = r.param.split(".")[-1]
        if (r.callee, r.param) in want or (r.callee, leaf) in want:
            out.append(r)
            continue
        # SessionProfile.thresholds.driftDelay — match inner ctor slot
        if "." in r.param:
            parent, child = r.param.split(".", 1)
            if any(m.param == child or m.param == r.param for m in moved):
                out.append(r)
    return out


def _default_label(m: Moved) -> str:
    if m.old_val is None:
        return f"∅→{m.new_val}"
    return f"{m.old_val}→{m.new_val}"


def _fate_of(blast: Row | None, later: Row | None, m: Moved) -> str:
    """Name the third-snapshot object.

    ALOUD is only a BLAST *survivor* (TACIT at NEW) that later restates
    the new default. PRE already spoke at the blast. LATE never rode it.
    FOSSIL restates the old value. MUTE stayed omitted.
    """
    new_val = m.new_val or ""
    old_val = m.old_val

    def is_new(r: Row) -> bool:
        return r.verdict in {"SHADOW", "OVERRIDE"} and values_equal(r.passed, new_val)

    def is_old(r: Row) -> bool:
        return (
            old_val is not None
            and r.verdict in {"SHADOW", "OVERRIDE"}
            and values_equal(r.passed, old_val)
        )

    if blast is None:
        if later is None:
            return "GONE"
        if is_new(later):
            return "LATE"
        if is_old(later):
            return "FOSSIL"
        if later.verdict == "TACIT":
            return "FRESH"
        if later.verdict == "BOUND":
            return "BOUND"
        return "LOCK"

    # blast exists
    if blast.verdict == "TACIT":
        if later is None:
            return "GONE"
        if later.verdict == "TACIT":
            return "MUTE"
        if is_new(later):
            return "ALOUD"
        if is_old(later):
            return "FOSSIL"
        if later.verdict == "BOUND":
            return "BOUND"
        return "LOCK"

    if is_old(blast):
        return "FOSSIL"
    if is_new(blast):
        return "PRE"
    if blast.verdict == "BOUND":
        return "BOUND"
    # OVERRIDE of something else at blast
    if later is None:
        return "GONE"
    if is_new(later) and blast.verdict == "TACIT":
        return "ALOUD"
    if is_old(later) or is_old(blast):
        return "FOSSIL"
    return "LOCK"


def aloud_rows(
    blast_h: Harvest,
    later_h: Harvest,
    moved: list[Moved],
    unfold: bool,
) -> list[Row]:
    """Join BLAST-time sites to a later snapshot.

    Identity: (path, callee, param, sibling-args-excluding-slot), then
    zip by line order inside that group so speaking the slot (which adds
    the name) does not change the key.
    """
    if not moved:
        return []
    blast_rows = _slot_rows(classify_harvest(blast_h, unfold=unfold), moved)
    later_rows = _slot_rows(classify_harvest(later_h, unfold=unfold), moved)
    by_slot = {(m.callee, m.param): m for m in moved}
    # also index by param name alone for unfolded leaves
    by_param = {}
    for m in moved:
        by_param.setdefault(m.param, m)

    def moved_for(r: Row) -> Moved | None:
        if (r.callee, r.param) in by_slot:
            return by_slot[(r.callee, r.param)]
        leaf = r.param.split(".")[-1]
        if (r.callee, leaf) in by_slot:
            return by_slot[(r.callee, leaf)]
        return by_param.get(leaf) or by_param.get(r.param)

    bg = _group_by_prefix(blast_rows)
    lg = _group_by_prefix(later_rows)
    keys = set(bg) | set(lg)
    tagged: list[Row] = []
    for key in sorted(keys):
        bs = bg.get(key, [])
        ls = lg.get(key, [])
        n = max(len(bs), len(ls))
        for i in range(n):
            b = bs[i] if i < len(bs) else None
            l = ls[i] if i < len(ls) else None
            sample = l or b
            if sample is None:
                continue
            m = moved_for(sample)
            if m is None:
                continue
            fate = _fate_of(b, l, m)
            src = l or b
            hint = l if l is not None else b
            rr = Row(
                verdict=(l.verdict if l else (b.verdict if b else "")),
                role=src.role,
                callee=src.callee,
                param=src.param,
                default=_default_label(m),
                passed=(l.passed if l else "—"),
                path=src.path,
                line=src.line,
                why=fate,
                blast=(b.verdict if b else "—"),
                blast_line=(b.line if b else 0),
                blast_passed=(b.passed if b else "—"),
                others=src.others,
                lang=hint.lang,
                kind=hint.kind,
                open_idx=hint.open_idx,
                close_idx=hint.close_idx,
                arg_start=hint.arg_start,
                arg_end=hint.arg_end,
                arg_keyword=hint.arg_keyword,
                flag_start=hint.flag_start,
                flag_end=hint.flag_end,
                style_keyword=hint.style_keyword,
                new_val=m.new_val or "",
            )
            tagged.append(rr)
    return tagged


