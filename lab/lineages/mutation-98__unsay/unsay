def drop_inner_span(inner: str, start: int, end: int) -> str:
    """Remove one argument from a call inner, taking one adjacent comma."""
    n = len(inner)
    start = max(0, min(start, n))
    end = max(start, min(end, n))
    after = end
    while after < n and inner[after] in " \t":
        after += 1
    if after < n and inner[after] == ",":
        after += 1
        while after < n and inner[after] in " \t":
            after += 1
        out = inner[:start] + inner[after:]
    else:
        before = start
        while before > 0 and inner[before - 1] in " \t":
            before -= 1
        if before > 0 and inner[before - 1] == ",":
            before -= 1
            out = inner[:before] + inner[end:]
        else:
            out = inner[:start] + inner[end:]
    if inner.endswith("\n") and not out.endswith("\n"):
        out += "\n"
    return out


def pin_inner(inner: str, piece: str) -> str:
    """Insert a keyword/positional arg before the closing paren."""
    if not inner.strip():
        return piece
    if "\n" not in inner:
        return inner.rstrip() + ", " + piece
    stripped = inner.rstrip()
    trail = inner[len(stripped) :]
    last_line = stripped.split("\n")[-1]
    indent = last_line[: len(last_line) - len(last_line.lstrip())]
    if not stripped.endswith(","):
        stripped += ","
    return stripped + "\n" + indent + piece + trail


def format_arg(name: str, value: str, lang: str, keyword: bool) -> str:
    if lang == "swift":
        return f"{name}: {value}"
    if lang == "rs":
        flag = name.replace("_", "-")
        return f"--{flag} {_unquote(value)}"
    if not keyword:
        return value
    if lang == "py":
        return f"{name}={value}"
    return f"{name} = {value}"


def drop_clap_flag(src: str, start: int, end: int) -> str:
    if start > 0 and src[start - 1] in " \t":
        start -= 1
    return src[:start] + src[end:]


def pin_clap_line(src: str, line_no: int, piece: str) -> str:
    lines = src.splitlines(keepends=True)
    idx = line_no - 1
    if idx < 0 or idx >= len(lines):
        return src
    line = lines[idx]
    nl = ""
    if line.endswith("\n"):
        nl = "\n"
        line = line[:-1]
        if line.endswith("\r"):
            line = line[:-1]
            nl = "\r\n"
    if line and not line.endswith((" ", "\t")):
        line += " "
    lines[idx] = line + piece + nl
    return "".join(lines)


def _emit_target(r: Row, pin: bool) -> bool:
    """Only ALOUD can be unsaid; only MUTE can be pinned. Nested unfold skips."""
    if "." in r.param:
        return False
    if r.why == "ALOUD":
        return True
    if pin and r.why == "MUTE":
        return True
    return False


def _group_key(r: Row) -> tuple:
    if r.kind == "clap":
        if r.why == "ALOUD" and r.flag_start >= 0:
            return (r.path, "clap-unspeak", r.flag_start, r.flag_end)
        return (r.path, "clap-pin", r.line, 0)
    return (r.path, "call", r.open_idx, r.close_idx)


def rewrite_source(src: str, rows: list[Row], pin: bool) -> str:
    """Apply all unspeak/pin edits for one file, high offset first."""
    groups: dict[tuple, list[Row]] = {}
    for r in rows:
        if not _emit_target(r, pin):
            continue
        groups.setdefault(_group_key(r), []).append(r)
    if not groups:
        return src

    def sort_key(k: tuple) -> int:
        # path, kind, a, b  — use the start offset (or line* large for clap-pin)
        kind = k[1]
        if kind == "clap-pin":
            return 10**12 + int(k[2])
        return int(k[2])

    for key in sorted(groups, key=sort_key, reverse=True):
        grp = groups[key]
        r0 = grp[0]
        if r0.kind == "clap":
            if r0.why == "ALOUD" and r0.flag_start >= 0:
                src = drop_clap_flag(src, r0.flag_start, r0.flag_end)
            elif pin and r0.why == "MUTE" and r0.new_val:
                piece = format_arg(r0.param, r0.new_val, "rs", True)
                src = pin_clap_line(src, r0.line, piece)
            continue
        if r0.open_idx < 0 or r0.close_idx <= r0.open_idx:
            continue
        inner = src[r0.open_idx + 1 : r0.close_idx]
        drops = [r for r in grp if r.why == "ALOUD" and r.arg_start >= 0]
        drops.sort(key=lambda r: r.arg_start, reverse=True)
        for r in drops:
            inner = drop_inner_span(inner, r.arg_start, r.arg_end)
        if pin:
            for r in grp:
                if r.why != "MUTE" or not r.new_val:
                    continue
                keyword = True if r.lang in {"swift", "py"} else r.style_keyword
                if r.lang == "ts" and not r.style_keyword:
                    keyword = False
                piece = format_arg(r.param, r.new_val, r.lang, keyword)
                inner = pin_inner(inner, piece)
        src = src[: r0.open_idx + 1] + inner + src[r0.close_idx :]
    return src


def rewrite_harvest(
    later_h: Harvest, rows: list[Row], pin: bool
) -> dict[str, tuple[str, str]]:
    """path -> (old, new) for files that change."""
    by_path: dict[str, list[Row]] = {}
    for r in rows:
        if _emit_target(r, pin):
            by_path.setdefault(_norm_path(r.path), []).append(r)
    out: dict[str, tuple[str, str]] = {}
    for path, rs in by_path.items():
        old = later_h.texts.get(path)
        if old is None:
            # try basename-insensitive lookup
            for k, v in later_h.texts.items():
                if _norm_path(k) == path:
                    old = v
                    break
        if old is None:
            continue
        new = rewrite_source(old, rs, pin)
        if new != old:
            out[path] = (old, new)
    return out


def unified_file_diff(path: str, old: str, new: str) -> str:
    # Body lines must already include newlines (keepends); difflib only
    # appends lineterm to headers. splitlines() without keepends mashes
    # the hunk and git apply cannot consume it.
    old_lines = old.splitlines(keepends=True)
    new_lines = new.splitlines(keepends=True)
    return "".join(
        difflib.unified_diff(
            old_lines,
            new_lines,
            fromfile=f"a/{path}",
            tofile=f"b/{path}",
            n=3,
        )
    )


def emit_patch(later_h: Harvest, rows: list[Row], pin: bool) -> str:
    chunks = []
    changed = rewrite_harvest(later_h, rows, pin)
    for path in sorted(changed):
        old, new = changed[path]
        chunk = unified_file_diff(path, old, new)
        if chunk:
            chunks.append(chunk)
    return "".join(chunks)


def skip_notes(rows: list[Row], pin: bool) -> list[str]:
    """Stderr when --emit produced no hunks.

    Empty emit of 27 MUTE (still ride) is the opposite of empty emit of
    18 LATE (born speaking, never rode). v0.1 collapsed them.
    """
    from collections import Counter

    c = Counter(r.why for r in rows)
    notes = []
    if c["ALOUD"] == 0:
        reasons = []
        if c["MUTE"]:
            reasons.append(f"{c['MUTE']} MUTE still ride")
        if c["LATE"]:
            reasons.append(f"{c['LATE']} LATE born-speaking, never rode")
        if c["PRE"]:
            reasons.append(f"{c['PRE']} PRE already spoke at the blast")
        if c["FOSSIL"]:
            reasons.append(f"{c['FOSSIL']} FOSSIL restates the old value")
        if reasons:
            notes.append(
                "0 ALOUD (" + "; ".join(reasons) + "); nothing to unspeak"
            )
        else:
            notes.append("0 ALOUD; nothing to unspeak")
    if pin and c["MUTE"] == 0:
        if c["LATE"]:
            notes.append(
                f"0 MUTE ({c['LATE']} LATE is not MUTE); nothing to pin"
            )
        else:
            notes.append("0 MUTE; nothing to pin")
    return notes


