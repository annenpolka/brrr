def _fates(rows: list[Row], param: str | None = None) -> dict[str, list[Row]]:
    out: dict[str, list[Row]] = {}
    for r in rows:
        if param and r.param != param:
            continue
        out.setdefault(r.why, []).append(r)
    return out


def _selftest() -> int:
    fails: list[str] = []

    def check(name: str, cond: bool, detail: str = "") -> None:
        if cond:
            print(f"  ok  {name}")
        else:
            fails.append(name)
            print(f"  FAIL {name} {detail}", file=sys.stderr)

    old_h = harvest_texts([("a.swift", OLD_SWIFT, "swift")])
    blast_h = harvest_texts([("a.swift", BLAST_SWIFT, "swift")])
    later_h = harvest_texts([("a.swift", LATER_SWIFT, "swift")])
    moved = moved_slots(old_h, blast_h)
    check(
        "rename+move is one presentThreshold slot",
        any(m.param == "presentThreshold" and m.old_name == "threshold" for m in moved),
        str([(m.old_name, m.param, m.old_val, m.new_val) for m in moved]),
    )
    rows = aloud_rows(blast_h, later_h, moved, unfold=False)
    f = _fates(rows, "presentThreshold")
    check(
        "ALOUD is omitted-then-spoken of the NEW default",
        len(f.get("ALOUD", [])) == 1
        and f["ALOUD"][0].blast == "TACIT"
        and f["ALOUD"][0].verdict == "SHADOW"
        and values_equal(f["ALOUD"][0].passed, "0.45"),
        str([(r.blast, r.verdict, r.passed, r.others) for r in f.get("ALOUD", [])]),
    )
    check(
        "MUTE stayed tacit — not ALOUD",
        len(f.get("MUTE", [])) == 1
        and f["MUTE"][0].blast == "TACIT"
        and f["MUTE"][0].verdict == "TACIT",
        str([(r.blast, r.verdict, r.passed) for r in f.get("MUTE", [])]),
    )
    check(
        "FOSSIL is SHADOW-of-old, not of new",
        len(f.get("FOSSIL", [])) == 1
        and values_equal(f["FOSSIL"][0].passed, "0.4"),
        str([(r.why, r.passed, r.blast) for r in f.get("FOSSIL", [])]),
    )
    check(
        "PRE already spoke new at the BLAST — not a survivor",
        len(f.get("PRE", [])) == 1
        and f["PRE"][0].blast == "SHADOW"
        and values_equal(f["PRE"][0].passed, "0.45"),
        str([(r.why, r.blast, r.passed) for r in f.get("PRE", [])]),
    )
    # LATE is filtered from default view; compute with all fates
    check(
        "ALOUD ≠ PRE ≠ MUTE ≠ FOSSIL ≠ LATE (five distinct sites)",
        {r.why for r in rows if r.param == "presentThreshold" and r.why in DEFAULT_FATES}
        == {"ALOUD", "MUTE", "FOSSIL", "PRE", "LATE"},
        str(sorted({r.why for r in rows})),
    )
    later_all = aloud_rows(blast_h, later_h, moved, unfold=False)
    late = [r for r in later_all if r.why == "LATE" and r.param == "presentThreshold"]
    check(
        "LATE born-after speaking new is not ALOUD",
        len(late) == 1
        and late[0].blast == "—"
        and late[0].verdict == "SHADOW"
        and values_equal(late[0].passed, "0.45"),
        str([(r.why, r.blast, r.verdict, r.passed, r.others) for r in late]),
    )
    # until==blast: nobody has spoken yet
    at_blast = aloud_rows(blast_h, blast_h, moved, unfold=False)
    af = _fates(at_blast, "presentThreshold")
    check(
        "at BLAST there is no ALOUD yet",
        not af.get("ALOUD")
        and len(af.get("MUTE", [])) == 2
        and len(af.get("FOSSIL", [])) == 1
        and len(af.get("PRE", [])) == 1,
        str({k: len(v) for k, v in af.items()}),
    )

    # speaking the slot must not break the join key (siblings exclude the slot)
    spoken = f["ALOUD"][0]
    mute = f["MUTE"][0]
    check(
        "join key ignores the spoken slot",
        ("sensors", '["mic"]') in spoken.others
        and not any(k == "presentThreshold" for k, _ in spoken.others)
        and ("sensors", '["camera"]') in mute.others,
        str(spoken.others),
    )

    # python
    py_old = harvest_texts([("a.py", PY_OLD, "py")])
    py_blast = harvest_texts([("a.py", PY_BLAST, "py")])
    py_later = harvest_texts([("a.py", PY_LATER, "py")])
    py_moved = moved_slots(py_old, py_blast)
    py_rows = aloud_rows(py_blast, py_later, py_moved, unfold=False)
    pf = _fates(py_rows, "greeting")
    check("py ALOUD spoken yo", any(r.why == "ALOUD" and "yo" in r.passed for r in py_rows))
    check("py MUTE stayed", len(pf.get("MUTE", [])) == 1)
    check("py FOSSIL hi (old)", any(r.why == "FOSSIL" and "hi" in r.passed for r in py_rows))
    check("py PRE yo at blast", len(pf.get("PRE", [])) == 1)

    # ts positional
    ts_old = harvest_texts([("a.ts", TS_OLD, "ts")])
    ts_blast = harvest_texts([("a.ts", TS_BLAST, "ts")])
    ts_later = harvest_texts([("a.ts", TS_LATER, "ts")])
    ts_moved = moved_slots(ts_old, ts_blast)
    ts_rows = aloud_rows(ts_blast, ts_later, ts_moved, unfold=False)
    tf = _fates(ts_rows, "attempts")
    check(
        "ts ALOUD positional 5",
        len(tf.get("ALOUD", [])) == 1 and tf["ALOUD"][0].blast == "TACIT",
        str([(r.why, r.blast, r.passed, r.others) for r in ts_rows]),
    )
    check("ts MUTE positional", len(tf.get("MUTE", [])) == 1)
    check("ts FOSSIL 3", any(r.why == "FOSSIL" and r.passed.strip() == "3" for r in ts_rows))
    check("ts PRE 5 at blast", len(tf.get("PRE", [])) == 1)

    # same-fingerprint ordinal: two camera calls, speak the second
    twin_blast = r"""
public final class PresenceArbiter {
    public init(sensors: [String], presentThreshold: Double = 0.45) {}
}
public func seed() {
    let a = PresenceArbiter(sensors: ["camera"])
    let b = PresenceArbiter(sensors: ["camera"])
}
"""
    twin_later = r"""
public final class PresenceArbiter {
    public init(sensors: [String], presentThreshold: Double = 0.45) {}
}
public func seed() {
    let a = PresenceArbiter(sensors: ["camera"])
    let b = PresenceArbiter(sensors: ["camera"], presentThreshold: 0.45)
}
"""
    twin_old = twin_blast.replace("0.45", "0.4")
    th = aloud_rows(
        harvest_texts([("t.swift", twin_blast, "swift")]),
        harvest_texts([("t.swift", twin_later, "swift")]),
        moved_slots(
            harvest_texts([("t.swift", twin_old, "swift")]),
            harvest_texts([("t.swift", twin_blast, "swift")]),
        ),
        unfold=False,
    )
    tw = _fates(th, "presentThreshold")
    check(
        "ordinal zip: first MUTE, second ALOUD",
        len(tw.get("MUTE", [])) == 1
        and len(tw.get("ALOUD", [])) == 1
        and tw["MUTE"][0].line < tw["ALOUD"][0].line,
        str([(r.why, r.line, r.passed) for r in th]),
    )

    # harvest sanity: comment residue still ignored
    noisy = BLAST_SWIFT + "\n// PresenceArbiter(SitboneCore)\n"
    nh = harvest_texts([("n.swift", noisy, "swift")])
    nrows = classify_harvest(nh, unfold=False)
    check(
        "comment residue is not a call",
        not any("SitboneCore" in (r.passed or "") for r in nrows),
    )

    # born-after OVERRIDE of a non-default is LOCK, not LATE
    later_lock = LATER_SWIFT.replace(
        'let late = PresenceArbiter(sensors: ["new"], presentThreshold: 0.45)',
        'let late = PresenceArbiter(sensors: ["new"], presentThreshold: 0.45)\n'
        '    let lock = PresenceArbiter(sensors: ["lock"], presentThreshold: 0.99)',
    )
    lock_rows = aloud_rows(
        blast_h,
        harvest_texts([("a.swift", later_lock, "swift")]),
        moved,
        unfold=False,
    )
    check(
        "born-after OVERRIDE is LOCK not LATE",
        any(r.why == "LOCK" and "0.99" in r.passed for r in lock_rows)
        and not any(r.why == "LATE" and "0.99" in r.passed for r in lock_rows),
        str([(r.why, r.passed) for r in lock_rows if r.param == "presentThreshold"]),
    )

    # --emit: only ALOUD is unsaid (not PRE, LATE, FOSSIL)
    later_h_emit = harvest_texts([("a.swift", LATER_SWIFT, "swift")])
    changed = rewrite_harvest(later_h_emit, rows, pin=False)
    check("emit rewrites the later file", "a.swift" in changed, str(list(changed)))
    unsaid = changed.get("a.swift", ("", ""))[1]
    check(
        "ALOUD mic lost presentThreshold: 0.45",
        'PresenceArbiter(sensors: ["mic"])' in unsaid
        and 'PresenceArbiter(sensors: ["mic"], presentThreshold: 0.45)' not in unsaid,
        unsaid,
    )
    check(
        "PRE lidar still speaks 0.45 (not unsaid)",
        'PresenceArbiter(sensors: ["lidar"], presentThreshold: 0.45)' in unsaid,
        unsaid,
    )
    check(
        "LATE new still speaks 0.45 (never rode)",
        'PresenceArbiter(sensors: ["new"], presentThreshold: 0.45)' in unsaid,
        unsaid,
    )
    check(
        "FOSSIL radar still speaks 0.4",
        'PresenceArbiter(sensors: ["radar"], presentThreshold: 0.4)' in unsaid,
        unsaid,
    )
    naive = re.sub(r", presentThreshold: 0.45", "", LATER_SWIFT)
    naive_hits = naive.count("presentThreshold")
    unsay_hits = unsaid.count("presentThreshold")
    check(
        "naive comma-regex would also unspeak PRE+LATE; unsay does not",
        naive_hits < unsay_hits
        and '["lidar"]' in naive
        and 'presentThreshold' not in naive.split("lidar")[1].split("\n")[0],
        f"naive_pt={naive_hits} unsay_pt={unsay_hits}",
    )
    re_h = harvest_texts([("a.swift", unsaid, "swift")])
    re_rows = aloud_rows(blast_h, re_h, moved, unfold=False)
    rf = _fates(re_rows, "presentThreshold")
    check(
        "after --emit, ALOUD became MUTE (TACIT rider again)",
        not rf.get("ALOUD") and len(rf.get("MUTE", [])) == 2,
        str({k: len(v) for k, v in rf.items()}),
    )
    check(
        "after --emit, PRE/LATE/FOSSIL fates unchanged",
        len(rf.get("PRE", [])) == 1
        and len(rf.get("LATE", [])) == 1
        and len(rf.get("FOSSIL", [])) == 1,
        str({k: len(v) for k, v in rf.items()}),
    )
    patch = emit_patch(later_h_emit, rows, pin=False)
    check(
        "unified diff deletes the spoken arg",
        patch.startswith("--- a/a.swift")
        and "+++ b/a.swift" in patch
        and "-    let spoken = PresenceArbiter(sensors: [\"mic\"], presentThreshold: 0.45)"
        in patch
        and "+    let spoken = PresenceArbiter(sensors: [\"mic\"])" in patch,
        patch,
    )
    changed_lines = [
        ln
        for ln in patch.splitlines()
        if ln.startswith(("+", "-")) and not ln.startswith(("+++", "---"))
    ]
    check(
        "unified diff only rewrites the ALOUD line (context may name neighbors)",
        any(ln.startswith("-") and "mic" in ln and "0.45" in ln for ln in changed_lines)
        and any(ln.startswith("+") and "mic" in ln and "0.45" not in ln for ln in changed_lines)
        and not any(
            ("lidar" in ln or '["new"]' in ln or "radar" in ln) and ln.startswith(("+", "-"))
            for ln in changed_lines
        ),
        "\n".join(changed_lines),
    )

    # --pin MUTE
    pinned_files = rewrite_harvest(later_h_emit, rows, pin=True)
    pinned = pinned_files["a.swift"][1]
    check(
        "pin MUTE camera now speaks 0.45",
        'PresenceArbiter(sensors: ["camera"], presentThreshold: 0.45)' in pinned,
        pinned,
    )
    check(
        "pin still unspeaks ALOUD mic",
        'PresenceArbiter(sensors: ["mic"])' in pinned
        and '["mic"], presentThreshold' not in pinned,
        pinned,
    )

    # python emit
    py_later_h = harvest_texts([("a.py", PY_LATER, "py")])
    py_changed = rewrite_harvest(py_later_h, py_rows, pin=False)
    py_new = py_changed["a.py"][1]
    check(
        "py emit unsays greeting=yo on spoken only",
        'greet("spoken")' in py_new
        and 'greet("spoken", greeting="yo")' not in py_new
        and 'greet("pre", greeting="yo")' in py_new
        and 'greet("late", greeting="yo")' in py_new
        and 'greet("fossil", greeting="hi")' in py_new,
        py_new,
    )

    # ts positional emit
    ts_later_h = harvest_texts([("a.ts", TS_LATER, "ts")])
    ts_changed = rewrite_harvest(ts_later_h, ts_rows, pin=False)
    ts_new = ts_changed["a.ts"][1]
    check(
        "ts emit drops positional 5 on ALOUD only",
        "retry(() => 2, 5)" not in ts_new
        and "retry(() => 2)" in ts_new
        and "retry(() => 4, 5)" in ts_new
        and "retry(() => 6, 5)" in ts_new
        and "retry(() => 3, 3)" in ts_new,
        ts_new,
    )

    # multiline call
    multi_blast = """
public final class PresenceArbiter {
    public init(sensors: [String], presentThreshold: Double = 0.45) {}
}
public func seed() {
    let spoken = PresenceArbiter(sensors: ["mic"])
    let mute = PresenceArbiter(sensors: ["camera"])
}
"""
    multi_later = """
public final class PresenceArbiter {
    public init(sensors: [String], presentThreshold: Double = 0.45) {}
}
public func seed() {
    let spoken = PresenceArbiter(
        sensors: ["mic"],
        presentThreshold: 0.45
    )
    let mute = PresenceArbiter(sensors: ["camera"])
}
"""
    multi_old = multi_blast.replace("0.45", "0.4")
    mh_old = harvest_texts([("m.swift", multi_old, "swift")])
    mh_blast = harvest_texts([("m.swift", multi_blast, "swift")])
    mh_later = harvest_texts([("m.swift", multi_later, "swift")])
    mh_moved = moved_slots(mh_old, mh_blast)
    mh_rows = aloud_rows(mh_blast, mh_later, mh_moved, unfold=False)
    mh_new = rewrite_harvest(mh_later, mh_rows, pin=False)["m.swift"][1]
    check(
        "multiline ALOUD drops the presentThreshold line",
        "presentThreshold" not in mh_new.split("mic")[1].split("mute")[0]
        and 'sensors: ["mic"]' in mh_new,
        mh_new,
    )
    mh_pin = rewrite_harvest(mh_later, mh_rows, pin=True)["m.swift"][1]
    check(
        "multiline pin adds trailing comma + presentThreshold",
        'sensors: ["camera"],' in mh_pin
        or '["camera"], presentThreshold: 0.45' in mh_pin,
        mh_pin,
    )

    mute_notes = skip_notes([r for r in rows if r.why == "MUTE"], pin=False)
    late_notes = skip_notes([r for r in rows if r.why == "LATE"], pin=False)
    check(
        "empty-emit MUTE names still-ride, not born-speaking",
        any("MUTE still ride" in n and "LATE" not in n for n in mute_notes),
        str(mute_notes),
    )
    check(
        "empty-emit LATE names born-speaking, not still-ride",
        any("LATE born-speaking, never rode" in n and "MUTE" not in n for n in late_notes),
        str(late_notes),
    )
    pin_late = skip_notes([r for r in rows if r.why == "LATE"], pin=True)
    check(
        "--pin LATE is refused as not MUTE",
        any("LATE is not MUTE" in n for n in pin_late),
        str(pin_late),
    )
    mixed = skip_notes(at_blast, pin=False)
    check(
        "at-blast empty emit names MUTE+PRE+FOSSIL, not LATE",
        any(
            "MUTE still ride" in n
            and "PRE already spoke" in n
            and "FOSSIL restates" in n
            and "LATE" not in n
            for n in mixed
        ),
        str(mixed),
    )

    if fails:
        print(f"selftest: {len(fails)} failed", file=sys.stderr)
        return 1
    print("selftest: ok")
    return 0


