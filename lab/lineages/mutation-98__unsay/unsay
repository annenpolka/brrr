HELP = """unsay — unspeak ALOUD so a BLAST survivor rides again.

  unsay -C <tree> --blast REV --emit [filter...]
  unsay -C <tree> --blast OLD NEW [--until LATER] --emit --pin
  unsay --selftest

aloud names ALOUD (omitted at BLAST, later SHADOW of the *new* default).
unsay emits the unified diff that deletes that argument (ALOUD → TACIT).
`--pin` also writes the new default at MUTE sites (MUTE → SHADOW).

PRE already spoke at the blast. LATE never rode it. FOSSIL restates the
old value. None of those are unsaid. `rg ': 0.45'` cannot tell them apart.

  --blast REV        OLD=REV^, NEW=REV; --until defaults to the worktree
  --blast OLD NEW    two-point BLAST interval
  --until LATER      third snapshot (rev or omitted=worktree)
  --emit             unified diff: unspeak ALOUD
  --pin              with --emit, also pin MUTE as SHADOW
  --summary          counts per slot (without --emit)
  --only aloud,mute  restrict fates
  --all              include FRESH/LOCK/BOUND/GONE
  --check            exit 1 if ALOUD remains

Exit: 0 ok, 1 --check found ALOUD, 2 error.
"""


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="unsay",
        description="Unspeak ALOUD (explicit new-default) so the site rides again.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=HELP,
    )
    p.add_argument("-C", "--directory", default=".", help="tree to scan")
    p.add_argument(
        "--blast",
        nargs="+",
        metavar="REV",
        help="BLAST interval: REV (means REV^..REV) or OLD NEW",
    )
    p.add_argument(
        "--until",
        default=None,
        metavar="REV",
        help="later snapshot (default: worktree)",
    )
    p.add_argument("--summary", action="store_true", help="counts per slot")
    p.add_argument("--json", action="store_true", help="JSON array")
    p.add_argument("--header", action="store_true", help="TSV header")
    p.add_argument(
        "--all",
        action="store_true",
        help="include FRESH, LOCK, BOUND, GONE",
    )
    p.add_argument(
        "--only",
        default="",
        help="comma fates (aloud,mute,fossil,pre,late,fresh,lock,bound,gone)",
    )
    p.add_argument("--no-unfold", action="store_true", help="do not expand Foo() defaults")
    p.add_argument("--check", action="store_true", help="exit 1 if ALOUD remains")
    p.add_argument(
        "--emit",
        action="store_true",
        help="unified diff that unsays ALOUD (delete the new-default arg)",
    )
    p.add_argument(
        "--pin",
        action="store_true",
        help="with --emit, also pin MUTE as SHADOW of the new default",
    )
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("filter", nargs="*", help="AND substrings against callee/param/path")
    return p.parse_args(argv)


def fates_from(ns: argparse.Namespace) -> set[str]:
    if ns.only:
        out = set()
        for part in ns.only.split(","):
            part = part.strip().upper()
            if part:
                out.add(part)
        return out
    if ns.all:
        return set()
    return set(DEFAULT_FATES)


def resolve_blast(repo: str, spec: list[str]) -> tuple[str, str]:
    if len(spec) == 1:
        new_rev = spec[0]
        old_rev = spec[0] + "^"
    elif len(spec) >= 2:
        old_rev, new_rev = spec[0], spec[1]
    else:
        raise RuntimeError("--blast needs REV or OLD NEW")
    # prove they exist
    git(repo, "rev-parse", "--verify", old_rev)
    git(repo, "rev-parse", "--verify", new_rev)
    return old_rev, new_rev


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv and argv[0] in {"selftest", "--self-test"}:
        argv = ["--selftest"]
    ns = parse_args(argv)
    if ns.version:
        print(f"unsay {VERSION}")
        return 0
    if ns.selftest:
        return _selftest()

    if not ns.blast:
        print("unsay: --blast REV  (or --blast OLD NEW) is required", file=sys.stderr)
        return 2
    if ns.pin and not ns.emit:
        print("unsay: --pin requires --emit", file=sys.stderr)
        return 2

    root = str(Path(ns.directory).resolve())
    unfold = not ns.no_unfold
    try:
        old_rev, new_rev = resolve_blast(root, ns.blast)
        old_h = relativize_harvest(harvest_rev(root, old_rev), None)
        blast_h = relativize_harvest(harvest_rev(root, new_rev), None)
        if ns.until:
            later_h = relativize_harvest(harvest_rev(root, ns.until), None)
        else:
            later_h = relativize_harvest(harvest_root(Path(root)), root)
        moved = moved_slots(old_h, blast_h)
        if not moved:
            print(
                f"unsay: no default moved between {old_rev} and {new_rev}",
                file=sys.stderr,
            )
            return 0
        rows = aloud_rows(blast_h, later_h, moved, unfold=unfold)
    except RuntimeError as e:
        print(f"unsay: {e}", file=sys.stderr)
        return 2

    for r in rows:
        r.path = _norm_path(relpath(r.path, root))
    later_h.texts = {_norm_path(k): v for k, v in later_h.texts.items()}

    why = fates_from(ns)
    # Path/callee filter first. --only hides fates from TSV *and* from
    # --emit targets, but empty-emit diagnosis uses default fates so
    # `--only late --emit` still names LATE vs MUTE.
    scoped = filter_rows(rows, ns.filter, set(), set())
    rows = filter_rows(scoped, [], set(), why)
    rows.sort(key=lambda r: (r.why, r.callee, r.param, r.path, r.line))

    if ns.emit:
        # Never rewrite PRE/LATE/FOSSIL even if --only named them:
        # emit_patch only unsays ALOUD (and pins MUTE).
        patch = emit_patch(later_h, rows, pin=ns.pin)
        if not patch:
            diag = [r for r in scoped if r.why in DEFAULT_FATES]
            for note in skip_notes(diag, ns.pin):
                print(f"unsay: {note}", file=sys.stderr)
        else:
            sys.stdout.write(patch)
            if not patch.endswith("\n"):
                sys.stdout.write("\n")
        if ns.check and any(r.why == "ALOUD" for r in rows):
            return 1
        return 0

    if ns.json:
        emit_json(rows)
    elif ns.summary:
        emit_summary(rows)
    else:
        emit_tsv(rows, ns.header)

    if ns.check and any(r.why == "ALOUD" for r in rows):
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)


