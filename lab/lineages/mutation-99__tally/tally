@dataclass(frozen=True)
class Edit:
    path: str
    line: int
    cls: str
    op: str
    old: str
    new: str
    new_line: int = 0
    fence: bool = False


def project_edits(old: Sequence[Token], new: Sequence[Token], path: str, classes: Sequence[str]) -> list[Edit]:
    edits: list[Edit] = []
    for cls in classes:
        # Fence vs body matched separately so a prose 30 cannot pair with a
        # fence 60 (and fence ident flood cannot cancel a Makefile ident).
        a_f = [t for t in old if t.cls == cls and t.fence]
        b_f = [t for t in new if t.cls == cls and t.fence]
        a_b = [t for t in old if t.cls == cls and not t.fence]
        b_b = [t for t in new if t.cls == cls and not t.fence]
        edits.extend(_script(a_f, b_f, path, cls, fence=True))
        edits.extend(_script(a_b, b_b, path, cls, fence=False))
    return _collapse_moves(edits)


def _script(a: Sequence[Token], b: Sequence[Token], path: str, cls: str, *, fence: bool) -> list[Edit]:
    if not a and not b:
        return []
    sm = SequenceMatcher(a=[t.value for t in a], b=[t.value for t in b], autojunk=False)
    out: list[Edit] = []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            continue
        if tag == "delete":
            for t in a[i1:i2]:
                out.append(Edit(path, t.line, cls, "del", t.value, "", 0, fence))
        elif tag == "insert":
            for t in b[j1:j2]:
                out.append(Edit(path, t.line, cls, "ins", "", t.value, t.line, fence))
        elif tag == "replace":
            olds = list(a[i1:i2])
            news = list(b[j1:j2])
            n = min(len(olds), len(news))
            one_slot = len(olds) == 1 and len(news) == 1
            for k in range(n):
                if olds[k].value == news[k].value:
                    continue
                if cls == "number" or one_slot or _similar(olds[k].value, news[k].value, cls):
                    out.append(
                        Edit(path, news[k].line, cls, "chg", olds[k].value, news[k].value, news[k].line, fence)
                    )
                else:
                    out.append(Edit(path, olds[k].line, cls, "del", olds[k].value, "", 0, fence))
                    out.append(Edit(path, news[k].line, cls, "ins", "", news[k].value, news[k].line, fence))
            for t in olds[n:]:
                out.append(Edit(path, t.line, cls, "del", t.value, "", 0, fence))
            for t in news[n:]:
                out.append(Edit(path, t.line, cls, "ins", "", t.value, t.line, fence))
    return out


def _similar(a: str, b: str, cls: str) -> bool:
    if cls in {"kw", "punct", "space"}:
        return False
    if a == b:
        return True
    al, bl = a.lower(), b.lower()
    if al in bl or bl in al:
        return True
    if min(len(a), len(b)) >= 4 and SequenceMatcher(None, al, bl).ratio() >= 0.55:
        return True
    return False


def _collapse_moves(edits: list[Edit]) -> list[Edit]:
    unused_ins: dict[tuple[str, str, str, bool], list[int]] = {}
    ins_list = [e for e in edits if e.op == "ins"]
    for idx, e in enumerate(ins_list):
        unused_ins.setdefault((e.path, e.cls, e.new, e.fence), []).append(idx)
    used_ins = [False] * len(ins_list)
    consumed_del = [False] * len(edits)
    result: list[Edit] = []
    for i, e in enumerate(edits):
        if e.op != "del":
            continue
        key = (e.path, e.cls, e.old, e.fence)
        bucket = unused_ins.get(key) or []
        found = None
        while bucket:
            j = bucket.pop(0)
            if not used_ins[j]:
                found = j
                break
        if found is None:
            continue
        used_ins[found] = True
        consumed_del[i] = True
        dest = ins_list[found]
        result.append(Edit(e.path, e.line, e.cls, "mov", e.old, dest.new, dest.line, e.fence))
    ins_used_idx = set(j for j, u in enumerate(used_ins) if u)
    for i, e in enumerate(edits):
        if e.op == "del":
            if not consumed_del[i]:
                result.append(e)
        elif e.op == "ins":
            continue
        elif e.op in {"chg", "mov"}:
            result.append(e)
    ins_cursor = 0
    for e in edits:
        if e.op != "ins":
            continue
        if ins_cursor not in ins_used_idx:
            result.append(e)
        ins_cursor += 1
    return result


def is_lock_path(path: str) -> bool:
    base = path.replace("\\", "/").rsplit("/", 1)[-1]
    if base in LOCK_BASENAMES:
        return True
    if base.endswith(".lock") or base.endswith("-lock.json") or base.endswith(".lockb"):
        return True
    return False


def edits_from_diff(
    files: Sequence[FileDiff],
    *,
    locks: bool = False,
) -> list[Edit]:
    classes = [c for c in CLASSES if c != "space"]
    out: list[Edit] = []
    for fd in files:
        if fd.status == "binary":
            continue
        if not locks and is_lock_path(fd.path or fd.old_path):
            continue
        dialect = dialect_for(fd.path if fd.path != "/dev/null" else fd.old_path)
        for h in fd.hunks:
            old_txt, old_start = hunk_side(h, True)
            new_txt, new_start = hunk_side(h, False)
            old_toks = lex(old_txt, dialect, old_start)
            new_toks = lex(new_txt, dialect, new_start)
            out.extend(project_edits(old_toks, new_toks, fd.path, classes))
    return _collapse_moves(out)


def edits_from_texts(old: str, new: str, path: str) -> list[Edit]:
    dialect = dialect_for(path)
    classes = [c for c in CLASSES if c != "space"]
    return project_edits(lex(old, dialect, 1), lex(new, dialect, 1), path, classes)


