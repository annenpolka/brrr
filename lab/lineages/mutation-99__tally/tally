@dataclass(frozen=True)
class Dialect:
    name: str
    line_comment: tuple[str, ...] = ()
    block_comment: tuple[tuple[str, str], ...] = ()
    json_keys: bool = False
    hash_ok: bool = False
    triple: bool = False
    prose: bool = False


def dialect_for(path: str) -> Dialect:
    name = path.replace("\\", "/").rsplit("/", 1)[-1]
    ext = name.lower()
    ext = ext.rsplit(".", 1)[-1] if "." in ext else ext
    stem = name.lower().rsplit(".", 1)[0] if "." in name else name.lower()
    if name in {"Makefile", "makefile", "GNUmakefile", "Dockerfile"}:
        return Dialect("hash", line_comment=("#",), hash_ok=True)
    if ext in PROSE_EXTS or stem in PROSE_BASENAMES or name.lower() in PROSE_BASENAMES:
        return Dialect("md", block_comment=(("<!--", "-->"),), prose=True)
    if ext in {"py", "pyi"}:
        return Dialect("python", line_comment=("#",), hash_ok=True, triple=True)
    if ext in {
        "sh",
        "bash",
        "zsh",
        "rb",
        "r",
        "pl",
        "ps1",
        "toml",
        "yml",
        "yaml",
        "mak",
        "mk",
        "cfg",
        "ini",
        "env",
        "gitignore",
        "dockerignore",
    }:
        return Dialect("hash", line_comment=("#",), hash_ok=True)
    if ext == "hs":
        return Dialect("haskell", line_comment=("--",), block_comment=(("{-", "-}"),))
    if ext in {"lua", "sql"}:
        return Dialect("dash", line_comment=("--",), block_comment=(("/*", "*/"),))
    if ext in {"html", "xml", "svg", "xhtml"}:
        return Dialect("html", block_comment=(("<!--", "-->"),))
    if ext in {"json"}:
        return Dialect("json", json_keys=True)
    if ext in {"jsonc", "json5"}:
        return Dialect("jsonc", line_comment=("//",), block_comment=(("/*", "*/"),), json_keys=True)
    if ext in {
        "rs",
        "c",
        "h",
        "cc",
        "hh",
        "cpp",
        "hpp",
        "go",
        "java",
        "js",
        "mjs",
        "cjs",
        "ts",
        "tsx",
        "jsx",
        "css",
        "scss",
        "swift",
        "kt",
        "kts",
        "scala",
        "cs",
        "m",
        "mm",
        "pkl",
    }:
        return Dialect("c", line_comment=("//",), block_comment=(("/*", "*/"),))
    return Dialect("c", line_comment=("//",), block_comment=(("/*", "*/"),))


def dialect_for_fence(lang: str) -> Dialect:
    key = (lang or "").strip().lower()
    if not key:
        return Dialect("c", line_comment=("//",), block_comment=(("/*", "*/"),))
    return dialect_for(FENCE_LANG_PATH.get(key, f"x.{key}"))


@dataclass(frozen=True)
class Token:
    cls: str
    value: str
    line: int
    col: int
    fence: bool = False


_IDENT = re.compile(r"[A-Za-z_$@][A-Za-z0-9_$@]*")
_NUMBER = re.compile(
    r"(?:"
    r"0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*"
    r"|0[bB][01](?:_?[01])*"
    r"|0[oO][0-7](?:_?[0-7])*"
    r"|\d+(?:_\d+)*(?:\.\d+(?:_\d+)*)?(?:[eE][+-]?\d+)?"
    r")"
)


def _starts(src: str, i: int, needle: str) -> bool:
    return src.startswith(needle, i)


def _md_fence_header(src: str, i: int) -> tuple[str, str, int] | None:
    """If src[i:] is a fence opener, return (marker, lang, header_bytes)."""
    n = len(src)
    j = i
    spaces = 0
    while j < n and src[j] == " " and spaces < 3:
        j += 1
        spaces += 1
    if j >= n or src[j] not in "`~":
        return None
    ch = src[j]
    k = j
    while k < n and src[k] == ch:
        k += 1
    flen = k - j
    if flen < 3:
        return None
    nl = src.find("\n", k)
    info_end = nl if nl >= 0 else n
    info = src[k:info_end]
    if ch == "`" and "`" in info:
        return None
    lang = info.strip().split()[0] if info.strip() else ""
    header_len = (nl + 1 - i) if nl >= 0 else (n - i)
    return ch * flen, lang, header_len


def _md_fence_close(src: str, start: int, marker: str) -> tuple[int, int]:
    """Return (close_line_start, after_close). Unclosed → (n, n)."""
    n = len(src)
    ch = marker[0]
    flen = len(marker)
    i = start
    while i < n:
        line_start = i
        spaces = 0
        while i < n and src[i] == " " and spaces < 3:
            i += 1
            spaces += 1
        k = i
        while k < n and src[k] == ch:
            k += 1
        if k - i >= flen:
            rest = src[k : src.find("\n", k) if src.find("\n", k) >= 0 else n]
            if rest.strip() == "":
                nl = src.find("\n", k)
                after = (nl + 1) if nl >= 0 else n
                return line_start, after
        nl = src.find("\n", line_start)
        i = (nl + 1) if nl >= 0 else n
    return n, n


def _as_fence(tokens: Sequence[Token]) -> list[Token]:
    return [Token(t.cls, t.value, t.line, t.col, True) for t in tokens]


def lex(src: str, dialect: Dialect, start_line: int = 1) -> list[Token]:
    out: list[Token] = []
    i = 0
    n = len(src)
    line = start_line
    col = 1
    line_start = True

    def emit(cls: str, val: str, at_line: int, at_col: int) -> None:
        if val == "":
            return
        out.append(Token(cls, val, at_line, at_col))

    def bump(k: int) -> None:
        nonlocal i, line, col, line_start
        for ch in src[i : i + k]:
            if ch == "\n":
                line += 1
                col = 1
                line_start = True
            else:
                col += 1
                if not ch.isspace():
                    line_start = False
        i += k

    while i < n:
        ch = src[i]
        sl, sc = line, col

        if dialect.prose and line_start:
            hdr = _md_fence_header(src, i)
            if hdr is not None:
                marker, lang, header_len = hdr
                body_i = i + header_len
                close_at, after = _md_fence_close(src, body_i, marker)
                body = src[body_i:close_at]
                body_line = line + 1 if header_len else line
                bump(after - i)
                if PROJECT_FENCES:
                    inner = dialect_for_fence(lang)
                    out.extend(_as_fence(lex(body, inner, body_line)))
                else:
                    emit("string", (lang + "\n" + body) if lang else body, sl, sc)
                continue

        if ch.isspace():
            j = i
            while j < n and src[j].isspace():
                j += 1
            emit("space", src[i:j], sl, sc)
            bump(j - i)
            continue

        consumed = False
        for open_, close in dialect.block_comment:
            if _starts(src, i, open_):
                j = src.find(close, i + len(open_))
                if j < 0:
                    val = src[i:]
                    emit("comment", _comment_body(val, open_, close), sl, sc)
                    bump(len(val))
                else:
                    val = src[i : j + len(close)]
                    emit("comment", _comment_body(val, open_, close), sl, sc)
                    bump(len(val))
                consumed = True
                break
        if consumed:
            continue

        for mark in dialect.line_comment:
            if _starts(src, i, mark):
                if mark == "#" and not dialect.hash_ok:
                    break
                j = src.find("\n", i)
                if j < 0:
                    j = n
                raw = src[i:j]
                emit("comment", raw[len(mark) :].strip(), sl, sc)
                bump(j - i)
                consumed = True
                break
        if consumed:
            continue

        if ch == "#" and not dialect.hash_ok:
            emit("punct", "#", sl, sc)
            bump(1)
            continue

        if dialect.triple and _starts(src, i, '"""'):
            tok, k = _read_triple(src, i, '"""')
            emit("string", tok, sl, sc)
            bump(k)
            continue
        if dialect.triple and _starts(src, i, "'''"):
            tok, k = _read_triple(src, i, "'''")
            emit("string", tok, sl, sc)
            bump(k)
            continue

        if ch in ("'", '"', "`"):
            if dialect.prose and ch == "`":
                tok, k = _read_inline_tick(src, i)
            else:
                tok, k = _read_string(src, i, ch)
            emit("string", tok, sl, sc)
            bump(k)
            continue

        m = _NUMBER.match(src, i)
        if m and not (i > 0 and (src[i - 1].isalnum() or src[i - 1] in "_$")):
            emit("number", m.group(0), sl, sc)
            bump(m.end() - i)
            continue

        m = _IDENT.match(src, i)
        if m:
            val = m.group(0)
            if dialect.prose:
                emit("text", val, sl, sc)
            else:
                cls = "kw" if val in KEYWORDS else "ident"
                emit(cls, val, sl, sc)
            bump(m.end() - i)
            continue

        if ord(ch) > 127 and unicodedata.category(ch).startswith("L"):
            j = i + 1
            while j < n:
                cj = unicodedata.category(src[j])
                if cj.startswith("L") or cj in {"Mn", "Mc", "Lm"} or src[j] in "ー々〆ゝゞ":
                    j += 1
                else:
                    break
            emit("text" if dialect.prose else "ident", src[i:j], sl, sc)
            bump(j - i)
            continue

        multi = (
            ">>=",
            "<<=",
            "&&=",
            "||=",
            "...",
            "..=",
            "==",
            "!=",
            "<=",
            ">=",
            "&&",
            "||",
            "->",
            "=>",
            "::",
            "<<",
            ">>",
            "++",
            "--",
            "+=",
            "-=",
            "*=",
            "/=",
            "%=",
            "&=",
            "|=",
            "^=",
            "//",
        )
        hit = None
        for op in multi:
            if _starts(src, i, op):
                if op == "//" and "//" in dialect.line_comment:
                    continue
                hit = op
                break
        if hit:
            emit("punct", hit, sl, sc)
            bump(len(hit))
            continue
        emit("punct", ch, sl, sc)
        bump(1)

    tagged = _tag_imports(out)
    if dialect.json_keys:
        tagged = _tag_json_keys(tagged)
    return tagged


def _comment_body(raw: str, open_: str, close: str) -> str:
    s = raw
    if s.startswith(open_):
        s = s[len(open_) :]
    if close and s.endswith(close):
        s = s[: -len(close)]
    return s.strip()


def _read_string(src: str, i: int, quote: str) -> tuple[str, int]:
    n = len(src)
    j = i + 1
    out = []
    while j < n:
        c = src[j]
        if c == "\\":
            if j + 1 < n:
                out.append(src[j : j + 2])
                j += 2
                continue
            out.append(c)
            j += 1
            continue
        if c == quote:
            return "".join(out), (j + 1 - i)
        if c == "\n" and quote != "`":
            return "".join(out), (j - i)
        out.append(c)
        j += 1
    return "".join(out), (n - i)


def _read_inline_tick(src: str, i: int) -> tuple[str, int]:
    """Markdown inline `code`. Does not swallow a fenced block across newlines."""
    n = len(src)
    j = i + 1
    out = []
    while j < n:
        c = src[j]
        if c == "`":
            return "".join(out), (j + 1 - i)
        if c == "\n":
            return "".join(out), (j - i)
        out.append(c)
        j += 1
    return "".join(out), (n - i)


def _read_triple(src: str, i: int, quote: str) -> tuple[str, int]:
    j = i + len(quote)
    k = src.find(quote, j)
    if k < 0:
        return src[j:], (len(src) - i)
    return src[j:k], (k + len(quote) - i)


def _tag_imports(tokens: Sequence[Token]) -> list[Token]:
    by_line: dict[int, list[int]] = {}
    for idx, t in enumerate(tokens):
        by_line.setdefault(t.line, []).append(idx)
    out = list(tokens)
    for idxs in by_line.values():
        heads = [tokens[i] for i in idxs if tokens[i].cls != "space"]
        if not heads:
            continue
        h0 = heads[0]
        is_import = (h0.cls in {"kw", "ident"} and h0.value in _IMPORT_HEADS) or (
            h0.cls == "punct" and h0.value == "#" and len(heads) > 1 and heads[1].value in PREPROCESSOR
        )
        if not is_import:
            continue
        for i in idxs:
            if out[i].cls == "string":
                out[i] = Token("import", out[i].value, out[i].line, out[i].col, out[i].fence)
    return out


def _tag_json_keys(tokens: Sequence[Token]) -> list[Token]:
    out = list(tokens)
    n = len(out)
    for i, t in enumerate(out):
        if t.cls != "string":
            continue
        j = i + 1
        while j < n and out[j].cls == "space":
            j += 1
        if j < n and out[j].cls == "punct" and out[j].value == ":":
            out[i] = Token("key", t.value, t.line, t.col, t.fence)
    return out


