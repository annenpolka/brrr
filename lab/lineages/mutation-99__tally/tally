# unified diff
# ---------------------------------------------------------------------------


@dataclass
class Hunk:
    old_start: int
    new_start: int
    rows: list[tuple[str, str]]


@dataclass
class FileDiff:
    path: str
    old_path: str
    hunks: list[Hunk] = field(default_factory=list)
    status: str = "modified"


_HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def parse_unified(text: str) -> list[FileDiff]:
    files: list[FileDiff] = []
    cur: FileDiff | None = None
    hunk: Hunk | None = None
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("diff --git "):
            hunk = None
            parts = line.split()
            old = parts[2][2:] if len(parts) > 2 and parts[2].startswith("a/") else (parts[2] if len(parts) > 2 else "")
            new = parts[3][2:] if len(parts) > 3 and parts[3].startswith("b/") else (parts[3] if len(parts) > 3 else old)
            cur = FileDiff(path=new or old, old_path=old or new)
            files.append(cur)
            i += 1
            continue
        if line.startswith("Binary files ") or line.startswith("GIT binary patch"):
            if cur:
                cur.status = "binary"
            hunk = None
            i += 1
            continue
        if line.startswith("--- "):
            oldp = _strip_ab(line[4:])
            if cur is None:
                cur = FileDiff(path=oldp, old_path=oldp)
                files.append(cur)
            else:
                cur.old_path = oldp if oldp != "/dev/null" else cur.old_path
            if oldp == "/dev/null" and cur:
                cur.status = "added"
            i += 1
            continue
        if line.startswith("+++ "):
            newp = _strip_ab(line[4:])
            if cur is None:
                cur = FileDiff(path=newp, old_path=newp)
                files.append(cur)
            else:
                if newp != "/dev/null":
                    cur.path = newp
            if newp == "/dev/null" and cur:
                cur.status = "deleted"
            i += 1
            continue
        m = _HUNK_RE.match(line)
        if m:
            if cur is None:
                cur = FileDiff(path="?", old_path="?")
                files.append(cur)
            hunk = Hunk(old_start=int(m.group(1)), new_start=int(m.group(3)), rows=[])
            cur.hunks.append(hunk)
            i += 1
            continue
        if hunk is not None and line[:1] in {" ", "-", "+", "\\"}:
            tag = line[:1]
            body = line[1:] if tag != "\\" else line
            if tag == "\\":
                i += 1
                continue
            hunk.rows.append((tag, body))
            i += 1
            continue
        i += 1
    return files


def _strip_ab(s: str) -> str:
    s = s.strip()
    if "\t" in s:
        s = s.split("\t", 1)[0]
    if s.startswith("a/") or s.startswith("b/"):
        return s[2:]
    return s


def hunk_side(hunk: Hunk, minus: bool) -> tuple[str, int]:
    parts: list[str] = []
    want = "-" if minus else "+"
    for tag, body in hunk.rows:
        if tag == " " or tag == want:
            parts.append(body)
    start = hunk.old_start if minus else hunk.new_start
    return "\n".join(parts), start


