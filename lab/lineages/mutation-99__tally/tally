@dataclass(frozen=True)
class Allowed:
    classes: tuple[str, ...]


def parse_only(spec: str) -> Allowed:
    if not spec or not spec.strip():
        raise SystemExit("tally: --only is required (prose, comments, number, ident, …)")
    out: list[str] = []
    for part in spec.split(","):
        p = part.strip().lower()
        if not p:
            continue
        if p in {"all"}:
            out.extend(c for c in CLASSES if c not in NOISE)
            continue
        if p in ALIAS:
            out.extend(ALIAS[p])
            continue
        if p not in CLASS_SET:
            raise SystemExit(
                f"tally: unknown class {p!r} (want {', '.join(CLASSES)}, prose, comments, code, all)"
            )
        out.append(p)
    seen = set()
    uniq = []
    for c in out:
        if c not in seen:
            seen.add(c)
            uniq.append(c)
    if not uniq:
        raise SystemExit("tally: --only is empty")
    return Allowed(tuple(uniq))


def is_leak(edit: Edit, allowed: Allowed, *, punct: bool, chg: bool = False) -> bool:
    """A leak is a ply outside the allow-list. Path never frees it. Moves do not leak.

    --chg is fence-local: ident flood inside a fence is not a leak. Number ply
    from a fence leaks only on op=chg (30→60). Non-fence code ply is woof.
    Not snag: comment-interior numbers stay comment class.
    """
    if edit.op == "mov":
        return False
    if edit.cls in NOISE:
        return False
    if edit.cls == "punct" and not punct:
        return False
    if chg and edit.fence:
        if edit.cls != "number":
            return False
        if CHG_FENCE_NUMBER_CHANGE_ONLY and edit.op != "chg":
            return False
    return edit.cls not in set(allowed.classes)


def leaks_of(edits: Sequence[Edit], allowed: Allowed, *, punct: bool, chg: bool = False) -> list[Edit]:
    out = [e for e in edits if is_leak(e, allowed, punct=punct, chg=chg)]
    out.sort(key=lambda e: (e.path, e.line, e.cls, e.op))
    return out


def count_classes(edits: Sequence[Edit]) -> dict[str, int]:
    c: dict[str, int] = {}
    for e in edits:
        c[e.cls] = c.get(e.cls, 0) + 1
    return c


def render_verdict(
    leaked: Sequence[Edit], only: str, origin: str, extra: Sequence[str], *, chg: bool = False
) -> str:
    bits = [f"only={only}"]
    if chg:
        bits.append("chg")
    if origin:
        bits.append(origin)
    bits.extend(extra)
    if leaked:
        bits.append(f"leaked={len(leaked)}")
        counts = count_classes(leaked)
        for cls in CLASSES:
            if counts.get(cls):
                bits.append(f"{cls}={counts[cls]}")
        header = "tally FAIL  " + "  ".join(bits)
        rows = [header]
        cap = 32
        for e in leaked[:cap]:
            rows.append(f"  {_fmt_edit(e)}")
        if len(leaked) > cap:
            rows.append(f"  … and {len(leaked) - cap} more")
        return "\n".join(rows) + "\n"
    bits.append("leaked=0")
    return "tally OK  " + "  ".join(bits) + "\n"


def _fmt_edit(e: Edit) -> str:
    if e.op == "chg":
        body = f"{_esc(e.old)} → {_esc(e.new)}"
    elif e.op == "del":
        body = _esc(e.old)
    else:
        body = _esc(e.new)
    where = "  fence" if e.fence else ""
    return f"{e.path}:{e.line}  {e.cls}  {e.op}  {body}{where}"


def _esc(s: str, width: int = 48) -> str:
    s = s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
    if len(s) > width:
        return s[: width - 1] + "…"
    return s


def render_tsv(edits: Sequence[Edit]) -> str:
    rows = ["path\tline\tclass\top\told\tnew"]
    for e in edits:
        rows.append(
            "\t".join(
                [
                    e.path,
                    str(e.line),
                    e.cls,
                    e.op,
                    e.old.replace("\t", "\\t").replace("\n", "\\n"),
                    e.new.replace("\t", "\\t").replace("\n", "\\n"),
                ]
            )
        )
    return "\n".join(rows) + "\n"


