def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="tally",
        description=(
            "CI gate: a unified diff must stay inside comment+prose tokens. "
            "--only prose exits 1 if a number, ident, or string leaked — "
            "even on README.md, even under docs/. --chg: fence interiors "
            "only leak number *changes* (30→60), not ident flood or 2048 inserts. "
            "Not snag --forbid number. TSV only on --emit."
        ),
        epilog="Read a unified diff on stdin. Example: git diff | tally --only prose --chg",
    )
    p.add_argument("input", nargs="?", help="unified diff file, or - for stdin")
    p.add_argument(
        "--only",
        default="",
        help="allowed class(es): prose, comments, number, ident, … (required). "
        "prose/docs = comment+text tokens, not a path glob.",
    )
    p.add_argument(
        "--chg",
        action="store_true",
        help="fence numbers only: drop fence ident/kw/string flood; fence "
        "numbers leak only on *change* (30→60), not 2048 inserts. "
        "Mixed-line 30→60 still FAIL. Not snag --forbid number.",
    )
    p.add_argument("--emit", action="store_true", help="print leaked edits as TSV (no dump by default)")
    p.add_argument("-q", "--quiet", action="store_true", help="exit code only")
    p.add_argument("--punct", action="store_true", help="treat punctuation edits as leaks")
    p.add_argument("--locks", action="store_true", help="include lockfiles")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="version", version=f"tally {VERSION}")
    return p


def run(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    p = build_parser()
    args = p.parse_args(argv)
    if args.selftest:
        return 0 if _selftest() else 1

    if not args.only:
        sys.stderr.write("tally: --only is required (prose, comments, number, ident, …)\n")
        return 2

    if args.input is None and sys.stdin.isatty():
        p.print_help()
        sys.stderr.write("\ntally: pass a unified diff on stdin, or a file path\n")
        return 2

    if args.input and args.input != "-":
        try:
            raw = open(args.input, encoding="utf-8", errors="replace").read()
        except OSError as e:
            sys.stderr.write(f"tally: {e}\n")
            return 2
        origin = args.input
    else:
        raw = sys.stdin.read()
        origin = "stdin"

    try:
        allowed = parse_only(args.only)
    except SystemExit as e:
        msg = e.args[0] if e.args else str(e)
        if isinstance(msg, str) and msg.startswith("tally:"):
            sys.stderr.write(msg + "\n")
            return 2
        raise

    files = parse_unified(raw)
    edits = edits_from_diff(files, locks=args.locks)
    leaked = leaks_of(edits, allowed, punct=args.punct, chg=args.chg)

    extra: list[str] = []
    if files:
        extra.append(f"files={len(files)}")
        n_lock = sum(1 for f in files if is_lock_path(f.path or f.old_path))
        if n_lock and not args.locks:
            extra.append(f"skipped_lock={n_lock}")

    if args.emit:
        sys.stdout.write(render_tsv(leaked))
    elif not args.quiet:
        sys.stdout.write(render_verdict(leaked, args.only, origin, extra, chg=args.chg))
    return 1 if leaked else 0


