#!/usr/bin/env python3
"""dwelt — intervals of git history where a predicate holds.

The missing partner of git-bisect: no monotonicity assumption, every era.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from datetime import datetime
from typing import Optional

TOOL = "dwelt"
GLOB_CHARS = set("*?[")


class GitError(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


def die(msg: str, code: int = 2) -> None:
    print(f"{TOOL}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def run_git(
    repo: str,
    args: list[str],
    check: bool = True,
    input_text: Optional[str] = None,
) -> subprocess.CompletedProcess:
    cmd = ["git", "-C", repo, *args]
    r = subprocess.run(cmd, input=input_text, text=True, capture_output=True)
    if check and r.returncode != 0:
        err = (r.stderr or r.stdout or "").strip()
        raise GitError(err)
    return r


def resolve_repo(path: str) -> str:
    path = os.path.abspath(path)
    if not os.path.isdir(path):
        die(f"not a git repository: {path}")
    r = run_git(path, ["rev-parse", "--show-toplevel"], check=False)
    if r.returncode != 0:
        die(f"not a git repository: {path}")
    top = r.stdout.strip()
    if not top:
        die(f"not a git repository: {path}")
    return top


def is_glob(path: str) -> bool:
    return any(ch in path for ch in GLOB_CHARS)


@dataclass
class Sample:
    sha: str
    short: str
    timestamp: int
    iso: str
    subject: str
    kind: str
    value: bool = False
    witnesses: list[str] = field(default_factory=list)

    def as_json(self) -> dict:
        return {
            "sha": self.sha,
            "short": self.short,
            "timestamp": self.timestamp,
            "iso": self.iso,
            "subject": self.subject,
            "kind": self.kind,
        }


@dataclass
class Era:
    value: bool
    samples: list[Sample]
    origin: Optional[Sample] = None
    origin_count: int = 0

    @property
    def count(self) -> int:
        return len(self.samples)

    @property
    def start(self) -> Sample:
        return self.samples[0]

    @property
    def end(self) -> Sample:
        return self.samples[-1]


def day(iso: str) -> str:
    return iso[:10]


def fmt_dates(start: Sample, end: Sample, always_arrow: bool = False) -> str:
    a, b = day(start.iso), day(end.iso)
    if a == b and not always_arrow:
        return a
    return f"{a} → {b}"


def fmt_span(start: Sample, end: Sample) -> str:
    if start.short == end.short:
        return start.short
    return f"{start.short}..{end.short}"


def compress(samples: list[Sample]) -> list[Era]:
    eras: list[Era] = []
    for s in samples:
        if eras and eras[-1].value == s.value:
            eras[-1].samples.append(s)
        else:
            eras.append(Era(value=s.value, samples=[s]))
    return eras


def load_commits(
    repo: str, spec: str, first_parent: bool, limit: Optional[int]
) -> list[Sample]:
    args = ["log", "--reverse", "--pretty=format:%H\t%ct\t%ci\t%s"]
    if first_parent:
        args.append("--first-parent")
    args.append(spec)
    r = run_git(repo, args, check=False)
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "").strip()
        if "outside repository" in err:
            raise GitError(err)
        if not r.stdout.strip():
            return []
        raise GitError(err)
    samples: list[Sample] = []
    for line in r.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 3)
        if len(parts) < 4:
            continue
        sha, ts, iso, subject = parts
        samples.append(
            Sample(
                sha=sha,
                short=sha[:7],
                timestamp=int(ts),
                iso=iso,
                subject=subject,
                kind="commit",
            )
        )
    if limit is not None and limit >= 0:
        samples = samples[-limit:]
    return samples


def reachable_count(repo: str, spec: str) -> int:
    r = run_git(repo, ["rev-list", "--count", spec], check=False)
    if r.returncode != 0:
        return 0
    try:
        return int(r.stdout.strip() or "0")
    except ValueError:
        return 0


def now_sample() -> Sample:
    stamp = datetime.now().astimezone()
    return Sample(
        sha="WORKTREE",
        short="WORKTREE",
        timestamp=int(stamp.timestamp()),
        iso=stamp.isoformat(timespec="seconds"),
        subject="uncommitted working tree",
        kind="worktree",
    )


def index_sample() -> Sample:
    stamp = datetime.now().astimezone()
    return Sample(
        sha="INDEX",
        short="INDEX",
        timestamp=int(stamp.timestamp()),
        iso=stamp.isoformat(timespec="seconds"),
        subject="staged index",
        kind="index",
    )


def is_missing_line(line: str) -> bool:
    return line.endswith(" missing") or line == "missing"


def exists_at_commits(repo: str, shas: list[str], path: str) -> list[tuple[bool, list[str]]]:
    if not shas:
        return []
    if is_glob(path):
        out: list[tuple[bool, list[str]]] = []
        for sha in shas:
            r = run_git(
                repo,
                ["ls-files", "-z", "--with-tree", sha, "--", path],
                check=False,
            )
            names = [n for n in r.stdout.split("\0") if n]
            if not names:
                # ls-tree pathspecs do not glob; fall back to full list + match
                r2 = run_git(
                    repo, ["ls-tree", "-r", "-z", "--name-only", sha], check=False
                )
                names = git_pathspec_filter(
                    [n for n in r2.stdout.split("\0") if n], path
                )
            names.sort()
            out.append((bool(names), names))
        return out
    payload = "".join(f"{sha}:{path}\n" for sha in shas)
    r = run_git(repo, ["cat-file", "--batch-check"], input_text=payload)
    lines = [ln for ln in r.stdout.splitlines() if ln]
    if len(lines) != len(shas):
        # fall back per-commit
        out = []
        for sha in shas:
            rr = run_git(
                repo, ["cat-file", "--batch-check"], input_text=f"{sha}:{path}\n"
            )
            miss = is_missing_line(rr.stdout.strip())
            out.append((not miss, [] if miss else [path]))
        return out
    out = []
    for line in lines:
        miss = is_missing_line(line)
        out.append((not miss, [] if miss else [path]))
    return out


def exists_worktree(repo: str, path: str) -> tuple[bool, list[str]]:
    if is_glob(path):
        r = run_git(
            repo,
            ["ls-files", "-co", "--exclude-standard", "-z", "--", path],
            check=False,
        )
        names = [n for n in r.stdout.split("\0") if n]
        # also pick up dirty untracked / present files git ls-files might miss
        if not names:
            # pathlib-less walk via git ls-files -o and disk for exact-ish globs
            r2 = run_git(repo, ["ls-files", "-co", "--exclude-standard", "-z"], check=False)
            all_names = [n for n in r2.stdout.split("\0") if n]
            names = git_pathspec_filter(all_names, path)
        names.sort()
        return bool(names), names
    return os.path.lexists(os.path.join(repo, path)), ([path] if os.path.lexists(os.path.join(repo, path)) else [])


def exists_index(repo: str, path: str) -> tuple[bool, list[str]]:
    r = run_git(repo, ["ls-files", "-c", "-z", "--full-name", "--", path], check=False)
    names = [n for n in r.stdout.split("\0") if n]
    names.sort()
    if names:
        return True, names if is_glob(path) else [path]
    return False, []


def git_pathspec_filter(names: list[str], spec: str) -> list[str]:
    # Approximate git's pathspec glob: '*' matches across directories.
    rx = []
    i = 0
    while i < len(spec):
        ch = spec[i]
        if ch == "*":
            rx.append(".*")
        elif ch == "?":
            rx.append(".")
        elif ch == "[":
            j = spec.find("]", i + 1)
            if j < 0:
                rx.append(re.escape(ch))
            else:
                rx.append(spec[i : j + 1])
                i = j
        else:
            rx.append(re.escape(ch))
        i += 1
    pat = re.compile("^" + "".join(rx) + "$")
    return [n for n in names if pat.match(n)]


def grep_at_commits(
    repo: str,
    shas: list[str],
    pattern: str,
    paths: list[str],
    ignore_case: bool,
    fixed: bool,
    word: bool,
) -> list[tuple[bool, list[str]]]:
    if not shas:
        return []
    flags = ["grep", "-I", "-l", "--full-name", "-z", "-e", pattern]
    if ignore_case:
        flags.append("-i")
    if fixed:
        flags.append("-F")
    if word:
        flags.append("-w")
    found: dict[str, list[str]] = {s: [] for s in shas}
    batch_size = 80
    for i in range(0, len(shas), batch_size):
        chunk = shas[i : i + batch_size]
        args = flags + chunk
        if paths:
            args += ["--", *paths]
        r = run_git(repo, args, check=False)
        if r.returncode not in (0, 1):
            # invalid regex or other error: treat as no matches
            continue
        parts = [p for p in r.stdout.split("\0") if p]
        for part in parts:
            if ":" in part:
                sha, path = part.split(":", 1)
                if sha in found:
                    found[sha].append(path)
    out = []
    for sha in shas:
        wits = sorted(set(found[sha]))
        out.append((bool(wits), wits))
    return out


def grep_worktree(
    repo: str,
    pattern: str,
    paths: list[str],
    ignore_case: bool,
    fixed: bool,
    word: bool,
    cached: bool = False,
) -> tuple[bool, list[str]]:
    flags = ["grep", "-I", "-l", "--full-name", "-z", "-e", pattern]
    if ignore_case:
        flags.append("-i")
    if fixed:
        flags.append("-F")
    if word:
        flags.append("-w")
    if cached:
        flags.append("--cached")
    if paths:
        flags += ["--", *paths]
    r = run_git(repo, flags, check=False)
    if r.returncode not in (0, 1):
        return False, []
    names = [n for n in r.stdout.split("\0") if n]
    # worktree git grep -z is just paths
    cleaned = []
    for n in names:
        if ":" in n and not os.path.exists(os.path.join(repo, n)):
            cleaned.append(n.split(":", 1)[-1])
        else:
            cleaned.append(n)
    cleaned = sorted(set(cleaned))
    return bool(cleaned), cleaned


def probe_exec(
    repo: str, shas: list[str], command: list[str], timeout: float
) -> list[tuple[bool, list[str]]]:
    if not shas:
        return []
    tmp = tempfile.mkdtemp(prefix="dwelt-wt-")
    added = False
    out: list[tuple[bool, list[str]]] = []
    try:
        add = run_git(
            repo, ["worktree", "add", "--detach", "-f", tmp, shas[0]], check=False
        )
        if add.returncode != 0:
            return _probe_exec_archive(repo, shas, command, timeout)
        added = True
        for sha in shas:
            co = run_git(tmp, ["checkout", "--detach", "-f", "-q", sha], check=False)
            if co.returncode != 0:
                out.append((False, []))
                continue
            out.append(_run_cmd(command, tmp, timeout))
    finally:
        if added:
            run_git(repo, ["worktree", "remove", "--force", tmp], check=False)
        else:
            try:
                import shutil

                shutil.rmtree(tmp, ignore_errors=True)
            except Exception:
                pass
    return out


def _probe_exec_archive(
    repo: str, shas: list[str], command: list[str], timeout: float
) -> list[tuple[bool, list[str]]]:
    out = []
    for sha in shas:
        tmp = tempfile.mkdtemp(prefix="dwelt-ar-")
        try:
            arch = subprocess.run(
                ["git", "-C", repo, "archive", sha],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            if arch.returncode != 0:
                out.append((False, []))
                continue
            tar = subprocess.run(
                ["tar", "-x", "-C", tmp],
                input=arch.stdout,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            if tar.returncode != 0:
                out.append((False, []))
                continue
            out.append(_run_cmd(command, tmp, timeout))
        finally:
            import shutil

            shutil.rmtree(tmp, ignore_errors=True)
    return out


def _run_cmd(command: list[str], cwd: str, timeout: float) -> tuple[bool, list[str]]:
    try:
        r = subprocess.run(
            command,
            cwd=cwd,
            timeout=timeout,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return r.returncode == 0, []
    except subprocess.TimeoutExpired:
        return False, ["(timeout)"]
    except OSError:
        return False, []


def exec_worktree(repo: str, command: list[str], timeout: float) -> tuple[bool, list[str]]:
    return _run_cmd(command, repo, timeout)


def exec_index(repo: str, command: list[str], timeout: float) -> tuple[bool, list[str]]:
    r = run_git(repo, ["write-tree"], check=False)
    if r.returncode != 0:
        return False, []
    tree = r.stdout.strip()
    tmp = tempfile.mkdtemp(prefix="dwelt-ix-")
    try:
        arch = subprocess.run(
            ["git", "-C", repo, "archive", tree],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if arch.returncode != 0:
            return False, []
        tar = subprocess.run(
            ["tar", "-x", "-C", tmp],
            input=arch.stdout,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if tar.returncode != 0:
            return False, []
        return _run_cmd(command, tmp, timeout)
    finally:
        import shutil

        shutil.rmtree(tmp, ignore_errors=True)


def pathspec_alive(repo: str, shas: list[str], paths: list[str]) -> list[str]:
    dead = []
    if not shas or not paths:
        return dead
    for path in paths:
        alive = False
        if is_glob(path):
            for sha in shas:
                r = run_git(
                    repo,
                    ["ls-files", "--with-tree", sha, "--", path],
                    check=False,
                )
                if r.stdout.strip():
                    alive = True
                    break
        else:
            payload = "".join(f"{sha}:{path}\n" for sha in shas)
            r = run_git(repo, ["cat-file", "--batch-check"], input_text=payload)
            for line in r.stdout.splitlines():
                if line and not is_missing_line(line):
                    alive = True
                    break
        if not alive:
            dead.append(path)
    return dead


def merge_parents(repo: str, sha: str) -> list[str]:
    r = run_git(repo, ["rev-list", "--parents", "-n", "1", sha], check=False)
    if r.returncode != 0:
        return []
    parts = r.stdout.strip().split()
    return parts[1:] if len(parts) > 1 else []


def annotate_origins(
    repo: str,
    eras: list[Era],
    first_parent: bool,
    probe_fn,
) -> int:
    """If a TRUE era starts at a merge, find earlier occupancy behind it."""
    extra = 0
    if not first_parent:
        return extra
    for era in eras:
        if not era.value or era.start.kind != "commit":
            continue
        parents = merge_parents(repo, era.start.sha)
        if len(parents) < 2:
            continue
        behind = load_commits(repo, era.start.sha, first_parent=False, limit=None)
        prior = [s for s in behind if s.sha != era.start.sha]
        if not prior:
            continue
        extra += 1
        results = probe_fn([s.sha for s in prior])
        first_true = None
        ntrue = 0
        for s, (val, wits) in zip(prior, results):
            if val:
                ntrue += 1
                if first_true is None:
                    s.value = True
                    s.witnesses = wits
                    first_true = s
        if first_true is not None:
            era.origin = first_true
            era.origin_count = ntrue
    return extra


def predicate_string(args: argparse.Namespace) -> str:
    if args.cmd == "exists":
        return f"exists {args.path}"
    if args.cmd == "grep":
        flags = []
        if args.ignore_case:
            flags.append("-i")
        if args.fixed:
            flags.append("-F")
        if args.word:
            flags.append("-w")
        if args.invert:
            flags.append("-v")
        body = " ".join(flags + [args.pattern]).strip()
        if args.paths:
            return f"grep {body} -- {' '.join(args.paths)}"
        return f"grep {body}"
    cmd = [c for c in args.command if c != "--"]
    return "exec " + " ".join(cmd)


def use_color(mode: str) -> bool:
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def paint(value: bool, enabled: bool) -> str:
    raw = "TRUE" if value else "FALSE"
    if not enabled:
        return f"{raw:<5}"
    if value:
        return f"\033[32;1m{raw:<5}\033[0m"
    return f"\033[31m{raw}\033[0m"


def fmt_witnesses(wits: list[str], limit: int = 5) -> Optional[str]:
    if not wits:
        return None
    shown = wits[:limit]
    extra = len(wits) - limit
    text = ", ".join(shown)
    if extra > 0:
        text += f" (+{extra})"
    return text


def print_human(report: dict, eras: list[Era], color: bool, show_wits: bool) -> None:
    name = os.path.basename(report["repo"])
    scanned = report["commits_scanned"]
    reachable = report["reachable"]
    walk = "first-parent" if report["first_parent"] else "full"
    extra = []
    if scanned != reachable:
        count = f"{scanned} of {reachable} commits"
    else:
        count = f"{scanned} commits"
    if report["include_now"]:
        extra.append("now")
    bits = ", ".join([count, walk, *extra])
    print(f"# {report['predicate']}  ({name}, {bits})")
    for era in eras:
        span = fmt_span(era.start, era.end)
        dates = fmt_dates(era.start, era.end)
        unit = "commit" if era.count == 1 else "commits"
        label = paint(era.value, color)
        print(f"{label} {era.count:>3} {unit:<8} {span}  {dates}".rstrip())
        if era.count == 1:
            print(f"       {era.start.subject}")
        else:
            print(f"       {era.start.short}  {era.start.subject}")
            print(f"       {era.end.short}  {era.end.subject}")
        if era.origin is not None:
            n = era.origin_count
            print(
                f"       origin: {era.origin.short}  {era.origin.subject}"
                f"  ({n} commit{'s' if n != 1 else ''} before this merge)"
            )
        if show_wits and era.value:
            wtxt = fmt_witnesses(era.end.witnesses or era.start.witnesses)
            if wtxt:
                print(f"       witnesses: {wtxt}")
    holds = "TRUE" if report["holds_now"] else "FALSE"
    print(
        f"now={holds}  true={report['true_commits']}/{report['commits_scanned']}"
        f"  eras={len(eras)}  probes={report['probes']}"
    )
    for w in report["warnings"]:
        print(f"warning: {w}")
    for h in report["hints"]:
        print(f"hint: {h}")


def print_oneline(eras: list[Era]) -> None:
    for era in eras:
        flag = "T" if era.value else "F"
        span = fmt_span(era.start, era.end)
        dates = fmt_dates(era.start, era.end)
        print(f"{flag}\t{era.count}\t{span}\t{dates}")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=TOOL,
        description=(
            "Show contiguous eras of git history where a predicate holds. "
            "The missing partner of git-bisect: no monotonicity assumption, every interval."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  dwelt exists .travis.yml
  dwelt grep FocusRiverView
  dwelt --full exists Sources/SitboneUI/FocusRiverView.swift
  dwelt exec -- test -f Makefile
  dwelt --json grep -i todo -- src | jq '.eras[] | select(.value)'
""",
    )
    p.add_argument("-C", "--repo", default=".", help="repository (default: cwd)")
    p.add_argument("--rev", default="HEAD", help="end revision (default: HEAD)")
    p.add_argument("--range", dest="rev_range", metavar="REV_RANGE", help="limit to A..B")
    p.add_argument("--full", action="store_true", help="walk every reachable commit, not only first-parent")
    p.add_argument("--now", action="store_true", help="append the working tree as a final sample")
    p.add_argument("--index", action="store_true", help="append the index as a sample (implies nothing else)")
    p.add_argument("--limit", type=int, default=None, help="keep only the last N commits")
    p.add_argument("--json", action="store_true", help="machine-readable report")
    p.add_argument("--oneline", action="store_true", help="T/F count span dates")
    p.add_argument("--revs", action="store_true", help="print SHAs where the predicate holds")
    p.add_argument("--bounds", action="store_true", help="print start_sha end_sha value count for each era")
    p.add_argument("--true-bounds", action="store_true", help="like --bounds but only TRUE eras")
    p.add_argument("-q", "--quiet", action="store_true", help="exit code only")
    p.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    p.add_argument("--timeout", type=float, default=30.0, help="seconds per exec probe (default: 30)")
    p.add_argument("--no-witnesses", action="store_true", help="do not print witness paths")
    sub = p.add_subparsers(dest="cmd")

    pe = sub.add_parser("exists", help="true when PATH exists in the tree")
    pe.add_argument("path", help="path or glob relative to repo root")

    pg = sub.add_parser("grep", help="true when PATTERN matches a tracked blob")
    pg.add_argument("-i", "--ignore-case", action="store_true")
    pg.add_argument("-F", "--fixed-strings", action="store_true", dest="fixed")
    pg.add_argument("-w", "--word-regexp", action="store_true", dest="word")
    pg.add_argument("-v", "--invert-match", action="store_true", dest="invert")
    pg.add_argument("pattern")
    pg.add_argument("paths", nargs="*", help="optional path limiters")

    px = sub.add_parser("exec", help="true when COMMAND exits 0 at that checkout")
    px.add_argument("command", nargs=argparse.REMAINDER, help="command to run; prefix with -- to avoid flag eating")
    return p


def apply_results(samples: list[Sample], results: list[tuple[bool, list[str]]], invert: bool) -> None:
    for s, (val, wits) in zip(samples, results):
        if invert:
            s.value = not val
            s.witnesses = [] if s.value else wits
            if s.value:
                s.witnesses = []
        else:
            s.value = val
            s.witnesses = wits if val else (wits if wits == ["(timeout)"] else [])


def main(argv: Optional[list[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_usage(sys.stderr)
        print(f"{TOOL}: error: the following arguments are required: cmd", file=sys.stderr)
        return 2
    if args.cmd == "exec":
        cmd = list(args.command or [])
        if cmd[:1] == ["--"]:
            cmd = cmd[1:]
        if not cmd:
            parser.print_usage(sys.stderr)
            print(f"{TOOL}: error: exec requires a command", file=sys.stderr)
            return 2
        args.command = cmd

    try:
        repo = resolve_repo(args.repo)
    except GitError as e:
        die(e.message)

    spec = args.rev_range if args.rev_range else args.rev
    end_rev = spec
    first_parent = not args.full
    invert = bool(getattr(args, "invert", False))

    try:
        commits = load_commits(repo, spec, first_parent=first_parent, limit=args.limit)
    except GitError as e:
        msg = e.message
        if msg.startswith("fatal:"):
            die(msg)
        die(msg)

    if not commits:
        die(f"no commits at {spec} (empty repository?)")

    reachable = reachable_count(repo, spec)
    probes = 0
    shas = [c.sha for c in commits]

    def probe_exists(sha_list: list[str]) -> list[tuple[bool, list[str]]]:
        return exists_at_commits(repo, sha_list, args.path)

    def probe_grep(sha_list: list[str], ignore_case: Optional[bool] = None) -> list[tuple[bool, list[str]]]:
        ic = args.ignore_case if ignore_case is None else ignore_case
        return grep_at_commits(
            repo,
            sha_list,
            args.pattern,
            args.paths,
            ignore_case=ic,
            fixed=args.fixed,
            word=args.word,
        )

    def probe_exec_shas(sha_list: list[str]) -> list[tuple[bool, list[str]]]:
        return probe_exec(repo, sha_list, args.command, args.timeout)

    warnings: list[str] = []
    hints: list[str] = []

    if args.cmd == "exists":
        if is_glob(args.path):
            results = probe_exists(shas)
            probes += len(shas) if shas else 0
        else:
            results = probe_exists(shas)
            probes += 1
        apply_results(commits, results, invert=False)
        extra_samples: list[Sample] = []
        if args.index:
            s = index_sample()
            val, wits = exists_index(repo, args.path)
            s.value, s.witnesses = val, (wits if val else [])
            extra_samples.append(s)
            probes += 1
        if args.now:
            s = now_sample()
            val, wits = exists_worktree(repo, args.path)
            s.value, s.witnesses = val, (wits if val else [])
            extra_samples.append(s)
            probes += 1
        samples = commits + extra_samples
    elif args.cmd == "grep":
        results = probe_grep(shas)
        probes += 1
        apply_results(commits, results, invert=invert)
        extra_samples = []
        if args.index:
            s = index_sample()
            val, wits = grep_worktree(
                repo, args.pattern, args.paths, args.ignore_case, args.fixed, args.word, cached=True
            )
            if invert:
                val = not val
                wits = []
            s.value, s.witnesses = val, (wits if val else [])
            extra_samples.append(s)
            probes += 1
        if args.now:
            s = now_sample()
            val, wits = grep_worktree(
                repo, args.pattern, args.paths, args.ignore_case, args.fixed, args.word, cached=False
            )
            if invert:
                val = not val
                wits = []
            s.value, s.witnesses = val, (wits if val else [])
            extra_samples.append(s)
            probes += 1
        samples = commits + extra_samples
        if args.paths:
            dead = pathspec_alive(repo, shas, args.paths)
            probes += 1
            for d in dead:
                warnings.append(
                    f"pathspec '{d}' matched no file in any scanned commit. "
                    f"If you meant a phrase, quote it: {TOOL} grep '{args.pattern} {d}'"
                )
    elif args.cmd == "exec":
        results = probe_exec_shas(shas)
        probes += len(shas)
        apply_results(commits, results, invert=False)
        extra_samples = []
        if args.index:
            s = index_sample()
            val, wits = exec_index(repo, args.command, args.timeout)
            s.value, s.witnesses = val, wits if (val or wits == ["(timeout)"]) else []
            extra_samples.append(s)
            probes += 1
        if args.now:
            s = now_sample()
            val, wits = exec_worktree(repo, args.command, args.timeout)
            s.value, s.witnesses = val, wits if (val or wits == ["(timeout)"]) else []
            extra_samples.append(s)
            probes += 1
        samples = commits + extra_samples
    else:
        die(f"unknown command: {args.cmd}")

    true_commit_n = sum(1 for s in samples if s.kind == "commit" and s.value)
    holds_now = bool(samples[-1].value)
    never_held = not any(s.value for s in samples)
    always_held = all(s.value for s in samples)

    # diagnostics for silent never-held
    if never_held and args.cmd == "grep" and not warnings:
        if not args.ignore_case:
            ic_results = probe_grep(shas, ignore_case=True)
            probes += 1
            ic_true = [(sha, wits) for sha, (val, wits) in zip(shas, ic_results) if val]
            if ic_true:
                example = ic_true[0][1][0] if ic_true[0][1] else ic_true[0][0][:7]
                hints.append(
                    f"0 case-sensitive matches; {len(ic_true)} commits match with -i "
                    f"(e.g. {example}). rerun with -i"
                )
        if first_parent:
            full_commits = load_commits(repo, spec, first_parent=False, limit=None)
            probes += 1
            full_res = probe_grep([c.sha for c in full_commits], ignore_case=args.ignore_case)
            full_true = [c for c, (val, _) in zip(full_commits, full_res) if val]
            if full_true:
                a, b = full_true[0], full_true[-1]
                hints.append(
                    f"never held on first-parent, but matched in {len(full_true)} reachable "
                    f"commits off the mainline ({a.short}..{b.short}  {fmt_dates(a, b, always_arrow=True)}). "
                    f"rerun with --full"
                )
    elif never_held and args.cmd == "exists" and first_parent:
        full_commits = load_commits(repo, spec, first_parent=False, limit=None)
        probes += 1
        full_res = probe_exists([c.sha for c in full_commits])
        full_true = [c for c, (val, _) in zip(full_commits, full_res) if val]
        if full_true:
            a, b = full_true[0], full_true[-1]
            hints.append(
                f"never held on first-parent, but existed in {len(full_true)} reachable "
                f"commits off the mainline ({a.short}..{b.short}  {fmt_dates(a, b, always_arrow=True)}). "
                f"rerun with --full"
            )

    eras = compress(samples)

    if args.cmd == "exists":
        probes += annotate_origins(repo, eras, first_parent, probe_exists)
    elif args.cmd == "grep":
        probes += annotate_origins(repo, eras, first_parent, lambda xs: probe_grep(xs))

    pred = predicate_string(args)
    report = {
        "repo": repo,
        "predicate": pred,
        "end_rev": end_rev,
        "first_parent": first_parent,
        "include_now": bool(args.now),
        "holds_now": holds_now,
        "never_held": never_held,
        "always_held": always_held,
        "commits_scanned": len(commits),
        "reachable": reachable,
        "probes": probes,
        "true_commits": true_commit_n,
        "eras": [],
        "hint": hints[0] if hints else None,
        "hints": hints,
        "warnings": warnings,
    }
    for era in eras:
        rec = {
            "value": era.value,
            "count": era.count,
            "start": era.start.as_json(),
            "end": era.end.as_json(),
            "witnesses_start": list(era.start.witnesses),
            "witnesses_end": list(era.end.witnesses),
        }
        if era.origin is not None:
            rec["origin"] = era.origin.as_json()
            rec["origin_true_commits"] = era.origin_count
        report["eras"].append(rec)

    if not args.quiet:
        if args.json:
            print(json.dumps(report, indent=2, ensure_ascii=False))
        elif args.revs:
            for s in samples:
                if s.value and s.kind == "commit":
                    print(s.sha)
        elif args.true_bounds:
            for era in eras:
                if era.value:
                    print(f"{era.start.sha} {era.end.sha} {int(era.value)} {era.count}")
        elif args.bounds:
            for era in eras:
                print(f"{era.start.sha} {era.end.sha} {int(era.value)} {era.count}")
        elif args.oneline:
            print_oneline(eras)
        else:
            print_human(report, eras, use_color(args.color), show_wits=not args.no_witnesses)

    return 0 if holds_now else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except GitError as e:
        die(e.message)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
    except KeyboardInterrupt:
        raise SystemExit(130)
