IDENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
KEBAB_RE = re.compile(r"(?<![A-Za-z0-9])[a-z][a-z0-9]*(?:-[a-z0-9]+)+")
CAMEL_SPLIT_RE = re.compile(r"[A-Z]?[a-z]+|[A-Z]+(?=[A-Z][a-z]|\d|$)|[0-9]+")
NUMBER_RE = re.compile(r"-?\d+(?:\.\d+)?")
VERSION_RE = re.compile(r"\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.]+)?")
SOME_RE = re.compile(
    r"\b([A-Za-z_][A-Za-z0-9_]*)\s*:\s*(?:Some|Option)\s*(?:<[^>]+>)?\s*\(\s*([^)]+?)\s*\)"
)
TYPED_ASSIGN_RE = re.compile(
    r"\b([A-Za-z_][A-Za-z0-9_]*)\s*:\s*[A-Za-z_][A-Za-z0-9_.<>,\[\]& ]*\s*=\s*([^\s,;#]+)"
)
ASSIGN_RE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([^\s,;#]+)")
COLON_RE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_-]*)\s*:\s*([^\s,;#]+)")
QUOTED_KEY_RE = re.compile(
    r"""["']([A-Za-z_][A-Za-z0-9_-]*)["']\s*:\s*([^\s,;}]+)"""
)
QUOTED_RE = re.compile(r'("(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\')')
POLARITY = {
