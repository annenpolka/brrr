@dataclass
class Origin:
    path: str
    line: int
    excerpt: str


@dataclass
class Fact:
    kind: str
    name: str
    old: str
    new: str
    origin: Origin

    def key(self) -> tuple[str, str, str, str]:
        return (self.kind, self.name, self.old, self.new)


@dataclass
class Finding:
    fact: Fact
    path: str
    line: int
