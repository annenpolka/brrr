# search HEAD
# ---------------------------------------------------------------------------


def git_grep_fixed(repo: str, rev: str | None, needles: list[str]) -> list[tuple[str, int, str]]:
    if not needles:
        return []
    args = ["grep", "-n", "-I", "-F"]
    for n in needles:
        args.extend(["-e", n])
    if rev and rev not in {"UNCOMMITTED", "-", "wt"}:
        args.append(rev)
    p = git(repo, *args)
    hits: list[tuple[str, int, str]] = []
    for row in (p.stdout or "").splitlines():
        # rev:path:line:text  OR path:line:text
        parts = row.split(":", 3)
        if rev and rev not in {"UNCOMMITTED", "-", "wt"} and len(parts) >= 4:
            # HEAD:path:line:text — path may contain no colons
            _, path, ln, text = parts[0], parts[1], parts[2], parts[3]
        elif len(parts) >= 3:
            path, ln, text = parts[0], parts[1], parts[2] if len(parts) == 3 else ":".join(parts[2:])
            if not ln.isdigit() and len(parts) >= 4:
                path, ln, text = parts[1], parts[2], parts[3]
        else:
            continue
        try:
            line_no = int(ln)
        except ValueError:
            continue
        hits.append((path, line_no, text))
    return hits


def holds_which(text: str, keys: Iterable[str]) -> str | None:
    # prefer distinctive idents, then numbers
    idents = []
    nums = []
    for k in keys:
        if not token_in(text, k):
            continue
        if is_number(k):
            nums.append(k)
        else:
            idents.append(k)
    if idents:
        idents.sort(key=lambda s: (0 if is_distinctive(s) else 1, len(s)))
        # surface form actually on the line
        for k in idents:
            for s in sorted(surfaces(k), key=len, reverse=True):
                if ident_in(text, s):
                    return s if s.lower() == k.lower() or s == k else k
        return idents[0]
    if nums:
        return nums[0]
    return None


def _slot_holds_abandoned(text: str, abandoned: list[str]) -> bool:
    names = [s.name for s in extract_slots(text, 0)]
    for n in names:
        for k in abandoned:
            if is_number(k):
                continue
            if n.lower() == k.lower() or inflect_pair(n, k):
                return True
    return False


def _kin_path(path: str, birth_path: str) -> bool:
    if not birth_path:
        return False
    stem = os.path.splitext(os.path.basename(birth_path))[0].lower()
    if len(stem) < 4:
        return False
    return stem in path.lower().replace("\\", "/")


def classify_hit(
    path: str,
    text: str,
    abandoned: list[str],
    natal_literals: list[str],
    distinctive: list[str],
    birth_path: str = "",
) -> str | None:
    """Return owing / echo / alias / None (drop)."""
    role = file_role(path)
    has_ident = any(token_in(text, k) for k in abandoned if not is_number(k))
    has_dist = any(token_in(text, k) for k in distinctive)
    has_lit = any(token_in(text, k) for k in natal_literals)
    slotish = _slot_holds_abandoned(text, abandoned)

    # quoted-only adapter
    for k in abandoned:
        if is_number(k):
            continue
        for s in abandoned_forms(k):
            if ident_in(text, s) and only_quoted(text, s) and not has_lit:
                return "alias"

    if has_dist:
        if role == "docs" and not has_lit:
            return "echo"
        if role == "tests":
            code = strip_comments(text)
            if not any(token_in(code, k) for k in distinctive) and not has_lit:
                return "echo"
        return "owing"

    # generic ident / literal
    if slotish and (has_lit or has_dist):
        return "owing"
    if slotish and role == "code":
        # generic slot bound to a different literal (SiteObserver.threshold = 0.7)
        return None
    if has_lit and role in {"tests", "config"}:
        if has_ident or _kin_path(path, birth_path):
            return "owing"
        return "echo"
    if has_ident and role in {"docs", "tests"}:
        return "echo"
    if has_lit and role == "docs":
        return "echo"
    if has_ident and role == "code" and has_lit:
        return "owing"
    # generic ident in code without natal literal: different domain
    return None


