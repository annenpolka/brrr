def _value_distance(ov: str | None, nv: str | None) -> float:
    try:
        return abs(float(ov) - float(nv))  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return 9.0


def _name_related(a: str, b: str) -> bool:
    if inflect_pair(a, b):
        return True
    pa = [p.lower() for p in camel_parts(a)]
    pb = [p.lower() for p in camel_parts(b)]
    if (
        pa
        and pb
        and pa[-1] == pb[-1]
        and len(pa[-1]) >= 4
        and pa[-1] not in {"id", "value", "type", "item"}
    ):
        return True
    al, bl = a.lower(), b.lower()
    # substring only for real stems (threshold ⊂ presentThreshold), not 's' ⊂ 'score'
    if min(len(al), len(bl)) >= 4 and (al in bl or bl in al):
        return True
    return False


def _allow_slot_pair(o: Slot, n: Slot) -> bool:
    if o.name == n.name and o.value == n.value:
        return False
    if stem_noise(o.name, n.name) and not (o.value and is_number(o.value)):
        return False
    if is_generic(o.name):
        # generic 1:1 only when snake/camel OR bound to a natal literal.
        # title→titleValue and window→focusedWindow stay silent.
        if inflect_pair(o.name, n.name):
            return True
        if o.value and is_number(o.value):
            return True
        return False
    return True


def pair_slots(old: list[Slot], new: list[Slot]) -> list[tuple[Slot, Slot]]:
    pairs: list[tuple[Slot, Slot]] = []
    used_new: set[int] = set()
    used_old: set[int] = set()
    # 1. inflection (snake/camel, case)
    for i, o in enumerate(old):
        for j, n in enumerate(new):
            if j in used_new:
                continue
            if inflect_pair(o.name, n.name) and not stem_noise(o.name, n.name):
                pairs.append((o, n))
                used_old.add(i)
                used_new.add(j)
                break
    # 2. related names (threshold ⊂ presentThreshold) — 1 old vs many new
    for i, o in enumerate(old):
        if i in used_old:
            continue
        cands: list[tuple[float, int, Slot]] = []
        for j, n in enumerate(new):
            if j in used_new:
                continue
            if not _allow_slot_pair(o, n):
                continue
            if not _name_related(o.name, n.name):
                continue
            score = _value_distance(o.value, n.value)
            if o.name.lower() in n.name.lower():
                score -= 0.05
            cands.append((score, j, n))
        if cands:
            cands.sort()
            _, j, n = cands[0]
            pairs.append((o, n))
            used_old.add(i)
            used_new.add(j)
    # 3. leftover 1:1 — distinctive names, or generic bound to a natal literal
    rest_old = [(i, o) for i, o in enumerate(old) if i not in used_old]
    rest_new = [(j, n) for j, n in enumerate(new) if j not in used_new]
    if len(rest_old) == 1 and rest_new:
        i, o = rest_old[0]
        # pick closest value among remaining, else first
        scored = []
        for j, n in rest_new:
            if not _allow_slot_pair(o, n):
                continue
            if is_distinctive(o.name) or (
                o.value and n.value and o.value != n.value and is_number(o.value)
            ):
                scored.append((_value_distance(o.value, n.value), j, n))
        if scored:
            scored.sort()
            _, j, n = scored[0]
            pairs.append((o, n))
            used_old.add(i)
            used_new.add(j)
    elif len(rest_old) == len(rest_new) and rest_old:
        for (i, o), (j, n) in zip(rest_old, rest_new):
            if not _allow_slot_pair(o, n):
                continue
            if is_distinctive(o.name) or (
                o.value and n.value and o.value != n.value and is_number(o.value)
            ):
                pairs.append((o, n))
    return pairs


