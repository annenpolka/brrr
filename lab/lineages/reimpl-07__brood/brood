# render
# ---------------------------------------------------------------------------


def colorize(enabled: bool, code: str, s: str) -> str:
    if not enabled:
        return s
    return f"\033[{code}m{s}\033[0m"


def render_human(change: Change, cohorts: list[Cohort], args: argparse.Namespace) -> str:
    use_color = (not args.no_color) and sys.stdout.isatty()
    lines: list[str] = []
    sha = short_sha(change.commit)
    if change.kind == "commit":
        lines.append(f"change commit  {sha}  {change.subject}")
    elif change.kind == "range":
        lines.append(f"change range  {sha}  {change.subject}")
    elif change.kind == "wt":
        lines.append("change wt  UNCOMMITTED  working tree")
    elif change.kind == "stdin":
        lines.append("change stdin  -  stdin diff")
    else:
        lines.append(f"change {change.kind}  {sha}  {change.subject}")

    if not cohorts:
        lines.append("")
        lines.append("no unpaid kin at HEAD")
        return "\n".join(lines) + "\n"

    max_n = args.max
    for i, c in enumerate(cohorts):
        lines.append("")
        bshort = short_sha(c.birth_commit)
        unpaid = c.owing[:max_n] if max_n else c.owing
        extra = c.owing[max_n:] if max_n else []
        echo = c.echo + extra
        if max_n:
            echo = echo[: max(0, max_n * 4)]
        n_unpaid = len(unpaid)
        date = c.birth_date
        subj = c.birth_subject
        if c.kind == "split":
            nfac = max(len(c.factions), 2)
            head = f"split  {nfac} factions  ·  {bshort}  {date}  {subj}".rstrip()
            lines.append(head)
            if c.factions:
                bits = "  ".join(f"{k}×{v}" for k, v in c.factions.items())
                lines.append(f"       HEAD {bits}")
        else:
            lines.append(f"owing  {n_unpaid} unpaid  ·  {bshort}  {date}  {subj}".rstrip())
        if c.pairs:
            lines.append("nee    " + ", ".join(c.pairs))
        if c.keys:
            lines.append("keys   " + ", ".join(c.keys))
        if c.abandoned or c.adopted:
            left = ", ".join(c.abandoned)
            right = ", ".join(c.adopted)
            if right:
                lines.append(f"delta  {left} → {right}")
            else:
                lines.append(f"delta  {left}")
        if c.kind != "split" and not c.pairs and not c.abandoned and c.keys:
            lines.append("token  " + ", ".join(c.keys))

        def emit(tag: str, ms: list[Member]) -> None:
            for m in ms:
                text = m.text.lstrip()
                lines.append(f"{tag:6} {m.path}:{m.line}: {text}")
                extra_bits = []
                if m.holds:
                    extra_bits.append(f"(holds {m.holds})")
                if m.since:
                    extra_bits.append(f"since {short_sha(m.since.get('commit',''), 7)}")
                if extra_bits:
                    lines.append("       " + " ".join(extra_bits))

        if c.paid or unpaid or echo or c.alias:
            lines.append("")
        emit("paid", c.paid[:max_n] if max_n else c.paid)
        emit("owing", unpaid)
        emit("echo", echo)
        emit("alias", c.alias)
        if i != len(cohorts) - 1:
            lines.append("")
            lines.append("---")
    return "\n".join(lines) + "\n"


def render_json(change: Change, cohorts: list[Cohort]) -> str:
    doc = {
        "version": VERSION,
        "change": {
            "spec": change.spec,
            "kind": change.kind,
            "commit": change.commit,
            "parent": change.parent,
            "date": change.date,
            "subject": change.subject,
        },
        "cohorts": [c.as_dict() for c in cohorts],
    }
    return json.dumps(doc, indent=2, ensure_ascii=False) + "\n"


