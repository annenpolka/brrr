# main
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=TOOL,
        description=(
            "From a commit or a diff, list natal cohorts still unpaid at HEAD. "
            "Natal keys inflect (t1 ↔ driftDelay, snake/camel); renamed siblings "
            "count. No FILE:LINE — the change is the query."
        ),
    )
    p.add_argument("change", nargs="?", help="commit, A..B range, 'wt', or '-' (stdin diff). Default: HEAD")
    p.add_argument("-C", "--repo", default=".", help="repository working tree")
    p.add_argument("--wt", action="store_true", help="analyze the working tree vs HEAD")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--check", action="store_true", help="exit 1 if any cohort is unpaid")
    p.add_argument("--all", action="store_true", help="include intact (non-debt) cohorts")
    p.add_argument("--no-birth-clusters", action="store_true", help="skip Path B (change-as-birth clusters)")
    p.add_argument("--max", type=int, default=12, help="max members listed per cohort")
    p.add_argument("--debug", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--no-color", action="store_true")
    p.add_argument("--version", action="store_true", help="show program's version number and exit")
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"{TOOL} {VERSION}")
        return 0
    if args.selftest:
        return selftest()

    repo = os.path.abspath(args.repo)
    p = git(repo, "rev-parse", "--is-inside-work-tree")
    if p.returncode != 0:
        die(f"not a git repository: {args.repo}")

    try:
        change = resolve_change(repo, args.change, args.wt)
    except SystemExit as e:
        return int(e.code) if isinstance(e.code, int) else 2

    cohorts = analyze(repo, change, args)
    if args.json:
        sys.stdout.write(render_json(change, cohorts))
    else:
        sys.stdout.write(render_human(change, cohorts, args))

    if args.check and any(c.owing for c in cohorts):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
