# diff
# ---------------------------------------------------------------------------


@dataclass
class Hunk:
    old_slots: list[Slot] = field(default_factory=list)
    new_slots: list[Slot] = field(default_factory=list)
    added: list[tuple[int, str]] = field(default_factory=list)
    removed: list[tuple[int, str]] = field(default_factory=list)


@dataclass
class FileDiff:
    path: str
    old_path: str
    old_lines: dict[int, str] = field(default_factory=dict)
    new_lines: dict[int, str] = field(default_factory=dict)
    added: list[tuple[int, str]] = field(default_factory=list)
    removed: list[tuple[int, str]] = field(default_factory=list)
    hunks: list[Hunk] = field(default_factory=list)


def parse_diff(text: str) -> list[FileDiff]:
    files: list[FileDiff] = []
    cur: FileDiff | None = None
    hunk: Hunk | None = None
    old_ln = new_ln = 0
    for raw in text.splitlines():
        if raw.startswith("diff --git "):
            rest = raw[len("diff --git a/") :]
            mid = rest.find(" b/")
            if mid == -1:
                continue
            old_p, new_p = rest[:mid], rest[mid + 3 :]
            cur = FileDiff(path=new_p, old_path=old_p)
            files.append(cur)
            hunk = None
            continue
        if raw.startswith("+++ ") or raw.startswith("--- "):
            continue
        if raw.startswith("rename from ") and cur:
            cur.old_path = raw[len("rename from ") :]
            continue
        if raw.startswith("rename to ") and cur:
            cur.path = raw[len("rename to ") :]
            continue
        m = HUNK_RE.match(raw)
        if m and cur is not None:
            old_ln = int(m.group(1))
            new_ln = int(m.group(3))
            hunk = Hunk()
            cur.hunks.append(hunk)
            continue
        if cur is None:
            continue
        if raw.startswith("+") and not raw.startswith("+++"):
            line = raw[1:]
            cur.new_lines[new_ln] = line
            cur.added.append((new_ln, line))
            if hunk is not None:
                hunk.added.append((new_ln, line))
                hunk.new_slots.extend(extract_slots(line, new_ln))
            new_ln += 1
        elif raw.startswith("-") and not raw.startswith("---"):
            line = raw[1:]
            cur.old_lines[old_ln] = line
            cur.removed.append((old_ln, line))
            if hunk is not None:
                hunk.removed.append((old_ln, line))
                hunk.old_slots.extend(extract_slots(line, old_ln))
            old_ln += 1
        elif raw.startswith("\\"):
            continue
        else:
            old_ln += 1
            new_ln += 1
    return files


# ---------------------------------------------------------------------------
# change resolution
# ---------------------------------------------------------------------------


@dataclass
class Change:
    spec: str
    kind: str
    commit: str | None
    parent: str | None
    date: str
    subject: str
    diff: str


def looks_like_file_line(spec: str) -> bool:
    s = spec.strip()
    if FILE_LINE_RE.match(s):
        return True
    # bare File.swift:33 without directories
    if re.match(r"^[\w./ +-]+\.[A-Za-z0-9_+-]+\:\d+$", s):
        return True
    return False


def rev_parse(repo: str, spec: str) -> str | None:
    p = git(repo, "rev-parse", "--verify", spec)
    if p.returncode != 0:
        return None
    return p.stdout.strip()


def commit_meta(repo: str, sha: str) -> tuple[str, str, str]:
    p = git(repo, "log", "-1", "--format=%H%n%aI%n%s", sha)
    if p.returncode != 0:
        return sha, "", ""
    lines = p.stdout.splitlines()
    while len(lines) < 3:
        lines.append("")
    return lines[0], lines[1], lines[2]


def parent_of(repo: str, sha: str) -> str | None:
    p = git(repo, "rev-parse", f"{sha}^")
    if p.returncode != 0:
        return None
    return p.stdout.strip()


def resolve_change(repo: str, spec: str | None, wt: bool) -> Change:
    if spec == "-" or spec == "/dev/stdin":
        diff = sys.stdin.read()
        if not diff.strip():
            print(f"{TOOL}: empty diff for -", file=sys.stderr)
            raise SystemExit(0)
        head = rev_parse(repo, "HEAD")
        h, date, subj = commit_meta(repo, head) if head else ("", "", "")
        return Change(
            spec="-",
            kind="stdin",
            commit="-",
            parent=head,
            date="",
            subject="stdin diff",
            diff=diff,
        )
    if wt or spec == "wt":
        diff = git_ok(repo, "diff", "-U0", "HEAD") or ""
        head = rev_parse(repo, "HEAD")
        return Change(
            spec="wt",
            kind="wt",
            commit="UNCOMMITTED",
            parent=head,
            date="",
            subject="working tree",
            diff=diff,
        )
    if spec is None:
        spec = "HEAD"
    spec = spec.strip()
    if looks_like_file_line(spec):
        die(
            "pass a commit or a diff, not FILE:LINE "
            f"({TOOL} starts from a change; natal keys inflect from the rename itself)"
        )
    m = RANGE_RE.match(spec)
    if m and m.group("dots") in ("..", "..."):
        a, b = m.group("a"), m.group("b")
        ra, rb = rev_parse(repo, a), rev_parse(repo, b)
        if not ra or not rb:
            die(f"not a commit range: {spec}")
        diff = git_ok(repo, "diff", "-U0", ra, rb) or ""
        h, date, subj = commit_meta(repo, rb)
        return Change(
            spec=spec,
            kind="range",
            commit=h,
            parent=ra,
            date=date,
            subject=subj,
            diff=diff,
        )
    sha = rev_parse(repo, spec)
    if not sha:
        die(f"not a commit: {spec}")
    parent = parent_of(repo, sha)
    if parent:
        diff = git_ok(repo, "diff", "-U0", parent, sha) or ""
    else:
        diff = git_ok(repo, "show", "--format=", "-U0", sha) or ""
    h, date, subj = commit_meta(repo, sha)
    return Change(
        spec=spec,
        kind="commit",
        commit=h,
        parent=parent,
        date=date,
        subject=subj,
        diff=diff,
    )


def short_sha(sha: str | None, n: int = 12) -> str:
    if not sha or sha in {"-", "UNCOMMITTED"}:
        return sha or "-"
    return sha[:n]


# ---------------------------------------------------------------------------
# blame / show
# ---------------------------------------------------------------------------


def blame_sha(repo: str, rev: str, path: str, line: int) -> tuple[str, str] | None:
    p = git(repo, "blame", "-l", "-L", f"{line},{line}", rev, "--", path)
    if p.returncode != 0 or not p.stdout.strip():
        return None
    row = p.stdout.splitlines()[0]
    sha = row.split()[0]
    if sha.startswith("^"):
        sha = sha[1:]
    # text after ') '
    text = row.split(") ", 1)[-1] if ") " in row else ""
    return sha, text


def show_line(repo: str, rev: str, path: str, line: int) -> str | None:
    blob = git_ok(repo, "show", f"{rev}:{path}")
    if blob is None:
        return None
    lines = blob.splitlines()
    if 1 <= line <= len(lines):
        return lines[line - 1]
    return None


def head_file(repo: str, path: str, rev: str | None) -> str | None:
    if rev and rev not in {"UNCOMMITTED", "-"}:
        return git_ok(repo, "show", f"{rev}:{path}")
    try:
        return Path(repo, path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None


