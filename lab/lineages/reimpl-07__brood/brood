# selftest
# ---------------------------------------------------------------------------


def selftest() -> int:
    failures = []

    def check(cond: bool, msg: str) -> None:
        if not cond:
            failures.append(msg)

    # tokenizer / inflection
    check("t1" in surfaces("T1") or "T1" in surfaces("t1"), "t1 inflects T1")
    check(inflect_pair("present_threshold", "presentThreshold"), "snake/camel")
    check(not inflect_pair("t1", "driftDelay"), "t1 does not stem-match driftDelay")
    check(is_distinctive("t1") and is_distinctive("present_threshold"), "distinctive")
    check(is_generic("threshold") and is_generic("window"), "generic")
    check(stem_noise("counters", "updatedCounters"), "stem noise")
    check(not stem_noise("t1", "driftDelay"), "t1/driftDelay not stem noise")
    check(number_in("x = 0.4", "0.4") and not number_in("x = 0.45", "0.4"), "0.4 bound")
    check(looks_like_file_line("core.py:1"), "file:line")
    check(not looks_like_file_line("HEAD"), "HEAD not file:line")
    check(not looks_like_file_line("foo:bar"), "foo:bar not file:line")

    # slot extract
    s = extract_slots("t1 = 15", 1)
    check(s and s[0].name == "t1" and s[0].value == "15", "py slot")
    s = extract_slots("        threshold: Double = 0.4,", 30)
    check(s and s[0].name == "threshold" and s[0].value == "0.4", "swift slot")
    s = extract_slots("        self.t1 = t1", 86)
    check(s and s[0].name == "t1", "self assign")
    s = extract_slots("        presentThreshold: Double = 0.45,", 33)
    t = extract_slots("        threshold: Double = 0.4,", 30)
    pairs = pair_slots(t, s)
    check(pairs and pairs[0][0].name == "threshold" and pairs[0][1].name == "presentThreshold", "slot pair")

    # fixture repo
    here = os.path.dirname(os.path.abspath(__file__))
    tool = os.path.join(here, os.path.basename(__file__))
    fix = tempfile.mkdtemp(prefix="brood-selftest-")
    try:
        subprocess.run(["git", "init", "-q"], cwd=fix, check=True, capture_output=True)
        subprocess.run(["git", "-C", fix, "config", "user.email", "b@b"], check=True)
        subprocess.run(["git", "-C", fix, "config", "user.name", "b"], check=True)
        Path(fix, "core.py").write_text("t1 = 15\nthreshold = 0.4\nPORT = 8080\n")
        Path(fix, "docs.md").write_text("T1 is 15 seconds.\n")
        Path(fix, "other.py").write_text("threshold = 0.7  # different domain\n")
        subprocess.run(
            ["git", "-C", fix, "add", "core.py", "docs.md", "other.py"],
            check=True,
            capture_output=True,
        )
        subprocess.run(["git", "-C", fix, "commit", "-q", "-m", "introduce t1=15"], check=True)
        Path(fix, "core.py").write_text("driftDelay = 15\npresentThreshold = 0.45\nPORT = 8080\n")
        subprocess.run(["git", "-C", fix, "add", "core.py"], check=True, capture_output=True)
        subprocess.run(
            ["git", "-C", fix, "commit", "-q", "-m", "rename t1→driftDelay"],
            check=True,
        )
        p = subprocess.run(
            [sys.executable, tool, "--no-color", "-C", fix, "HEAD"],
            capture_output=True,
            text=True,
        )
        out = p.stdout
        check(p.returncode == 0, f"HEAD exit {p.returncode} {p.stderr}")
        check("t1" in out and "driftDelay" in out, "HEAD mentions t1/driftDelay")
        check("docs.md" in out, "docs leftover")
        check("T1" in out or "t1" in out, "T1 inflection")
        check("other.py" not in out, "generic threshold=0.7 different domain")
        check(not number_in("v0.4 camera", "0.4"), "v0.4 is not natal 0.4")
        p2 = subprocess.run(
            [sys.executable, tool, "--no-color", "-C", fix, "core.py:1"],
            capture_output=True,
            text=True,
        )
        check(p2.returncode == 2, "FILE:LINE exit 2")
        check("not FILE:LINE" in p2.stderr, "FILE:LINE message")
        p3 = subprocess.run(
            [sys.executable, tool, "--no-color", "--check", "-C", fix, "HEAD"],
            capture_output=True,
            text=True,
        )
        check(p3.returncode == 1, "--check exit 1")
    finally:
        subprocess.run(["rm", "-rf", fix], check=False)

    if failures:
        print("selftest FAIL:", file=sys.stderr)
        for f in failures:
            print(" -", f, file=sys.stderr)
        return 1
    print("selftest ok")
    return 0


