def git(repo: str, *args: str, check: bool = False, input: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", repo, *args],
        text=True,
        capture_output=True,
        input=input,
        check=check,
    )


def git_ok(repo: str, *args: str) -> str | None:
    p = git(repo, *args)
    if p.returncode != 0:
        return None
    return p.stdout


def die(msg: str, code: int = 2) -> None:
    print(f"{TOOL}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def debug(enabled: bool, msg: str) -> None:
    if enabled:
        print(f"debug: {msg}", file=sys.stderr)


# ---------------------------------------------------------------------------
# tokens / inflection
# ---------------------------------------------------------------------------


def camel_parts(name: str) -> list[str]:
    return [p for p in CAMEL_PART_RE.findall(name) if p]


def to_snake(name: str) -> str:
    if "_" in name:
        return name.lower()
    # t1 / T1 have no camel hump — do not invent t_1.
    if not re.search(r"[a-z][A-Z]|[A-Z]{2,}[a-z]", name):
        return name.lower()
    parts = camel_parts(name) or [name]
    return "_".join(p.lower() for p in parts)


def to_camel(name: str) -> str:
    parts = [p for p in name.split("_") if p]
    if not parts:
        return name
    return parts[0].lower() + "".join(p[:1].upper() + p[1:] for p in parts[1:])


def surfaces(tok: str) -> set[str]:
    out = {tok, tok.lower(), tok.upper()}
    if len(tok) <= 3:
        out.add(tok[:1].upper() + tok[1:].lower())  # T1, T2
    if "_" in tok:
        out.add(to_camel(tok))
        cam = to_camel(tok)
        out.add(cam[:1].upper() + cam[1:])
    else:
        sn = to_snake(tok)
        out.add(sn)
        if sn != tok.lower():
            out.add(to_camel(sn))
    return {s for s in out if s}


def is_distinctive(name: str) -> bool:
    """t1 / T2 / present_threshold — not a 1-letter local (s, r)."""
    if not name:
        return False
    if re.match(r"^[A-Za-z]+\d+$", name):
        return True
    if "_" in name:
        return True
    return False


def is_generic(name: str) -> bool:
    low = name.lower()
    if low in GENERIC_IDENTS:
        return True
    if is_distinctive(name):
        return False
    parts = [p.lower() for p in camel_parts(name)]
    if parts and parts[0] in COMMON_PREFIXES:
        return True
    if len(name) >= 4 and low.isalpha() and low in GENERIC_IDENTS:
        return True
    return False


def stem_noise(a: str, b: str) -> bool:
    """Reject prefix/suffix containment like counters ⊂ updatedCounters."""
    if a.lower() == b.lower():
        return False
    pa, pb = [p.lower() for p in camel_parts(a)], [p.lower() for p in camel_parts(b)]
    if not pa or not pb:
        return False
    shorter, longer = (pa, pb) if len(pa) <= len(pb) else (pb, pa)
    extra = longer[: len(longer) - len(shorter)]
    if longer[-len(shorter) :] == shorter and extra and extra[0] in COMMON_PREFIXES:
        return True
    extra2 = longer[len(shorter) :]
    if longer[: len(shorter)] == shorter and extra2 and extra2[-1] in COMMON_PREFIXES:
        return True
    # simple string containment with a common prefix glued on
    al, bl = a.lower(), b.lower()
    if al in bl or bl in al:
        host, guest = (bl, al) if al in bl else (al, bl)
        rest = host.replace(guest, "", 1)
        if rest in COMMON_PREFIXES or rest.rstrip("s") in COMMON_PREFIXES:
            return True
    return False


def inflect_pair(a: str, b: str) -> bool:
    if a.lower() == b.lower():
        return True
    sa, sb = surfaces(a), surfaces(b)
    if sa & sb:
        return True
    if to_snake(a) == to_snake(b):
        return True
    return False


def tokenize(text: str) -> list[str]:
    found: list[str] = []
    for m in IDENT_RE.finditer(text):
        found.append(m.group(0))
    for m in NUMBER_RE.finditer(text):
        found.append(m.group(0))
    return found


def ident_in(text: str, tok: str) -> bool:
    return re.search(r"(?<![A-Za-z0-9_])" + re.escape(tok) + r"(?![A-Za-z0-9_])", text) is not None


def number_in(text: str, num: str) -> bool:
    # 0.4 must not match 0.45 or v0.4; trailing punctuation (0.4.) is allowed.
    return re.search(r"(?<![A-Za-z0-9])" + re.escape(num) + r"(?!\d)", text) is not None


def abandoned_forms(tok: str) -> set[str]:
    """Surfaces of a natal name still owed — case, not snake↔camel.

    present_threshold leftover is the snake spelling (and T1 for t1).
    The adopted camel presentThreshold is paid, not unpaid kin.
    """
    if is_number(tok):
        return {tok}
    forms = {tok, tok.lower(), tok.upper()}
    if len(tok) <= 3:
        forms.add(tok[:1].upper() + tok[1:].lower())
        forms.add(tok[:1].lower() + tok[1:].upper())
    return {s for s in forms if s}


def token_in(text: str, tok: str, *, inflect: bool = False) -> bool:
    if re.fullmatch(r"\d+\.\d+|\d+", tok):
        return number_in(text, tok)
    forms = surfaces(tok) if inflect else abandoned_forms(tok)
    return any(ident_in(text, s) for s in forms)


def strip_comments(text: str) -> str:
    text = re.sub(r"#.*$", "", text)
    text = re.sub(r"//.*$", "", text)
    text = re.sub(r"/\*.*?\*/", "", text)
    return text


def only_quoted(text: str, tok: str) -> bool:
    """True if every occurrence of tok is inside quotes (adapter / CodingKeys)."""
    hits = 0
    quoted = 0
    for m in re.finditer(r"(?<![A-Za-z0-9_])" + re.escape(tok) + r"(?![A-Za-z0-9_])", text):
        hits += 1
        i = m.start()
        before = text[:i]
        # crude: odd number of quotes before this point on the line
        if before.count('"') % 2 == 1 or before.count("'") % 2 == 1:
            quoted += 1
        elif re.search(r"""['"]\s*$""", before) and re.search(
            r"""^\s*['"]""", text[m.end() :]
        ):
            quoted += 1
    return hits > 0 and quoted == hits


def is_number(tok: str) -> bool:
    return bool(re.fullmatch(r"\d+\.\d+|\d+", tok))


# ---------------------------------------------------------------------------
# slots
# ---------------------------------------------------------------------------


@dataclass
class Slot:
    name: str
    value: str | None
    line: int
    text: str
    kind: str


def clean_value(raw: str | None) -> str | None:
    if raw is None:
        return None
    v = raw.strip().rstrip(",;").strip()
    v = v.split("#")[0].split("//")[0].strip()
    if len(v) >= 2 and v[0] in "\"'" and v[-1] == v[0]:
        v = v[1:-1]
    return v or None


LET_DECL_RE = re.compile(r"\b(?:let|var)\s+([A-Za-z_][A-Za-z0-9_]*)\s*:")


def extract_slots(line: str, lineno: int) -> list[Slot]:
    s = line.rstrip("\n")
    stripped = s.strip()
    if not stripped or stripped.startswith(("#", "//", "/*", "*")):
        return []
    slots: list[Slot] = []
    m = SELF_ASSIGN_RE.search(s)
    if m:
        slots.append(Slot(m.group(1), None, lineno, s, "self"))
        return slots
    if "=" in s:
        for m in TYPED_EQ_RE.finditer(s):
            slots.append(Slot(m.group(1), clean_value(m.group(2)), lineno, s, "typed"))
        if slots:
            return slots
        if "==" in stripped.split("#")[0].split("//")[0] and re.search(
            r"\b(assert|if|while|return)\b", stripped
        ):
            return []
        m = BARE_EQ_RE.match(s)
        if m and not stripped.startswith(("if ", "elif ", "while ", "return ", "assert ", "for ")):
            name, val = m.group(1), clean_value(m.group(2))
            if name not in STOP_IDENTS:
                slots.append(Slot(name, val, lineno, s, "assign"))
                return slots
        return slots
    # `let t1: TimeInterval` — declaration slot without a default.
    for m in LET_DECL_RE.finditer(s):
        name = m.group(1)
        if name not in STOP_IDENTS:
            slots.append(Slot(name, None, lineno, s, "let"))
    return slots


def file_role(path: str) -> str:
    low = path.lower().replace("\\", "/")
    base = os.path.basename(low)
    if low.endswith((".md", ".rst", ".txt", ".adoc")) or base in {
        "readme",
        "readme.md",
        "spec.md",
        "claude.md",
        "agents.md",
    }:
        return "docs"
    if "/docs/" in "/" + low or "/adr/" in "/" + low or "/doc/" in "/" + low:
        return "docs"
    if (
        "/test/" in "/" + low
        or "/tests/" in "/" + low
        or base.startswith("test_")
        or base.endswith("_test.py")
        or "tests." in low
    ):
        return "tests"
    if low.endswith((".yaml", ".yml", ".toml", ".ini", ".json", ".plist", ".cfg")):
        return "config"
    return "code"


