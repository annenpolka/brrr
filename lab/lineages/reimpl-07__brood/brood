# cohorts
# ---------------------------------------------------------------------------


@dataclass
class Member:
    status: str
    path: str
    line: int
    text: str
    birth_path: str
    birth_line: int
    birth_text: str
    shared: list[str]
    holds: str | None
    since: dict[str, str] | None = None

    def as_dict(self) -> dict[str, Any]:
        d: dict[str, Any] = {
            "status": self.status,
            "path": self.path,
            "line": self.line,
            "text": self.text,
            "birth_path": self.birth_path,
            "birth_line": self.birth_line,
            "birth_text": self.birth_text,
            "shared": self.shared,
            "holds": self.holds,
        }
        if self.since:
            d["since"] = self.since
        return d


@dataclass
class Cohort:
    kind: str
    birth_commit: str
    birth_date: str
    birth_subject: str
    birth_path: str
    birth_region: list[str]
    keys: list[str]
    abandoned: list[str]
    adopted: list[str]
    pairs: list[str]
    paid: list[Member] = field(default_factory=list)
    owing: list[Member] = field(default_factory=list)
    ok: list[Member] = field(default_factory=list)
    gone: list[Member] = field(default_factory=list)
    echo: list[Member] = field(default_factory=list)
    alias: list[Member] = field(default_factory=list)
    factions: dict[str, int] = field(default_factory=dict)
    uncommitted: bool = False

    def merge_from(self, other: "Cohort") -> None:
        for attr in ("paid", "owing", "ok", "gone", "echo", "alias"):
            seen = {(m.path, m.line) for m in getattr(self, attr)}
            for m in getattr(other, attr):
                if (m.path, m.line) not in seen:
                    getattr(self, attr).append(m)
                    seen.add((m.path, m.line))
        for k, v in other.factions.items():
            self.factions[k] = self.factions.get(k, 0) + v
        if other.birth_region and other.birth_region[0] not in self.birth_region:
            self.birth_region.extend(other.birth_region)

    def as_dict(self) -> dict[str, Any]:
        return {
            "kind": self.kind,
            "birth": {
                "commit": self.birth_commit,
                "date": self.birth_date,
                "subject": self.birth_subject,
                "path": self.birth_path,
                "region": self.birth_region,
                "uncommitted": self.uncommitted,
            },
            "keys": self.keys,
            "abandoned": self.abandoned,
            "adopted": self.adopted,
            "pairs": self.pairs,
            "paid": [m.as_dict() for m in self.paid],
            "owing": [m.as_dict() for m in self.owing],
            "ok": [m.as_dict() for m in self.ok],
            "gone": [m.as_dict() for m in self.gone],
            "echo": [m.as_dict() for m in self.echo],
            "alias": [m.as_dict() for m in self.alias],
            "factions": self.factions,
        }


def member_shared(text: str, birth_text: str, keys: list[str]) -> list[str]:
    toks = set(t.lower() for t in tokenize(text)) | set(t.lower() for t in tokenize(birth_text))
    shared = []
    for k in tokenize(birth_text):
        if k.lower() in toks and (k.lower() not in {s.lower() for s in shared}):
            if k.lower() in STOP_IDENTS and k.lower() not in {x.lower() for x in keys}:
                continue
            shared.append(k.lower() if not any(c.isupper() for c in k) else k)
    # always include natal keys present in birth
    for k in keys:
        if token_in(birth_text, k) or token_in(text, k):
            if k not in shared and k.lower() not in {s.lower() for s in shared}:
                shared.append(k)
    return sorted(set(shared), key=str.lower)


def search_needles(abandoned: list[str], adopted: list[str]) -> list[str]:
    needles: list[str] = []
    seen: set[str] = set()
    for k in abandoned:
        forms = {k} if is_number(k) else abandoned_forms(k)
        for s in forms:
            if s not in seen and len(s) >= 1:
                seen.add(s)
                needles.append(s)
    for k in adopted:
        forms = {k} if is_number(k) else abandoned_forms(k)
        for s in forms:
            if s not in seen and len(s) >= 1:
                seen.add(s)
                needles.append(s)
    return needles


def populate_hits(
    repo: str,
    search_rev: str | None,
    coh: Cohort,
    changed_paths: set[str],
    dbg: bool,
) -> None:
    abandoned = coh.abandoned
    adopted = coh.adopted
    # Numbers on the natal line still bind leftover docs ("T1 is 15 seconds")
    # even when the number itself did not move.
    literals = [k for k in abandoned if is_number(k)]
    for region in coh.birth_region:
        for tok in tokenize(region):
            if is_number(tok) and tok not in literals:
                literals.append(tok)
    distinctive = [k for k in abandoned if not is_number(k) and is_distinctive(k)]
    needles = search_needles(abandoned, adopted)
    # generic names still searched but filtered later
    hits = git_grep_fixed(repo, search_rev, needles)
    debug(dbg, f"search needles={needles[:12]} hits={len(hits)}")
    paid_locs: set[tuple[str, int]] = set()

    adopted_names = [k for k in adopted if not is_number(k)]
    # paid: changed-file *slots* that hold the adopted name, not every mention
    for path, ln, text in hits:
        holds_adopted = any(token_in(text, k) for k in adopted)
        holds_ab_ident = any(token_in(text, k) for k in abandoned if not is_number(k))
        if not (holds_adopted and path in changed_paths and not holds_ab_ident):
            continue
        slots = extract_slots(text, ln)
        if adopted_names and not any(
            s.name == a or inflect_pair(s.name, a) for s in slots for a in adopted_names
        ):
            continue
        holds = holds_which(text, adopted) or (adopted[0] if adopted else None)
        m = Member(
            status="paid",
            path=path,
            line=ln,
            text=text,
            birth_path=coh.birth_path or path,
            birth_line=1,
            birth_text=coh.birth_region[0] if coh.birth_region else text,
            shared=member_shared(text, coh.birth_region[0] if coh.birth_region else text, coh.keys),
            holds=holds,
        )
        if (path, ln) not in {(x.path, x.line) for x in coh.paid}:
            coh.paid.append(m)
            paid_locs.add((path, ln))

    for path, ln, text in hits:
        if (path, ln) in paid_locs:
            continue
        if not any(token_in(text, k) for k in abandoned):
            continue
        kind = classify_hit(
            path, text, abandoned, literals, distinctive, birth_path=coh.birth_path
        )
        if kind is None:
            continue
        holds = holds_which(text, abandoned) or holds_which(text, coh.keys)
        since = None
        if kind in {"owing", "echo"}:
            bl = blame_sha(repo, search_rev or "HEAD", path, ln) if search_rev != "UNCOMMITTED" else None
            if bl:
                sha, _ = bl
                h, date, subj = commit_meta(repo, sha)
                since = {"commit": h, "date": date, "subject": subj}
        m = Member(
            status=kind,
            path=path,
            line=ln,
            text=text,
            birth_path=path,
            birth_line=ln,
            birth_text=text,
            shared=member_shared(text, text, coh.keys + abandoned),
            holds=holds,
            since=since,
        )
        bucket = {
            "owing": coh.owing,
            "echo": coh.echo,
            "alias": coh.alias,
        }[kind]
        if (path, ln) not in {(x.path, x.line) for x in bucket}:
            bucket.append(m)

    # factions: how HEAD leftovers cluster by the token they hold
    fac: dict[str, int] = defaultdict(int)
    for m in coh.paid + coh.owing:
        if m.holds:
            fac[m.holds] += 1
    coh.factions = dict(fac)


def sort_members(ms: list[Member]) -> list[Member]:
    return sorted(ms, key=lambda m: (m.path, m.line))


# ---------------------------------------------------------------------------
# engine
# ---------------------------------------------------------------------------


def analyze(repo: str, change: Change, args: argparse.Namespace) -> list[Cohort]:
    files = parse_diff(change.diff)
    search_rev = None if change.kind == "wt" else "HEAD"
    if change.kind == "stdin":
        search_rev = "HEAD"
    dbg = args.debug
    changed_paths = {f.path for f in files}
    path_a: list[Cohort] = []

    for fd in files:
        hunk_pairs: list[tuple[Slot, Slot]] = []
        if fd.hunks:
            for hk in fd.hunks:
                hunk_pairs.extend(pair_slots(hk.old_slots, hk.new_slots))
        else:
            old_slots: list[Slot] = []
            new_slots: list[Slot] = []
            for ln, text in fd.removed:
                old_slots.extend(extract_slots(text, ln))
            for ln, text in fd.added:
                new_slots.extend(extract_slots(text, ln))
            hunk_pairs = pair_slots(old_slots, new_slots)
        for old_s, new_s in hunk_pairs:
            if old_s.name == new_s.name and old_s.value == new_s.value:
                continue
            abandoned: list[str] = []
            adopted: list[str] = []
            if old_s.name != new_s.name:
                abandoned.append(old_s.name)
                adopted.append(new_s.name)
            if old_s.value and new_s.value and old_s.value != new_s.value:
                if is_number(old_s.value) or is_number(new_s.value):
                    abandoned.append(old_s.value)
                    adopted.append(new_s.value)
            if not abandoned:
                continue
            # drop generic-only rename without literal
            names_ab = [k for k in abandoned if not is_number(k)]
            if names_ab and all(is_generic(n) for n in names_ab) and not any(
                is_number(k) for k in abandoned
            ):
                # still allow if distinctive? already generic. skip 1:1 window↔focusedWindow
                if not any(is_distinctive(n) for n in names_ab):
                    continue
            blame_rev = change.parent or change.commit
            birth_sha = change.commit or ""
            birth_text = old_s.text
            if blame_rev and blame_rev not in {"UNCOMMITTED", "-"}:
                bl = blame_sha(repo, blame_rev, fd.old_path, old_s.line)
                if bl:
                    birth_sha, blamed = bl
                    if blamed:
                        birth_text = blamed
            b_h, b_date, b_subj = commit_meta(repo, birth_sha) if birth_sha else ("", "", "")
            keys: list[str] = []
            for k in abandoned:
                if k not in keys:
                    # keys: natal names + natal literals that moved
                    keys.append(k)
            pair_labels = []
            if old_s.name != new_s.name:
                pair_labels.append(f"{old_s.name}↔{new_s.name}")
            debug(
                dbg,
                f"birth {short_sha(b_h, 8)} {fd.old_path}:{old_s.line} region={[birth_text]}",
            )
            coh = Cohort(
                kind="owing",
                birth_commit=b_h,
                birth_date=b_date,
                birth_subject=b_subj,
                birth_path=fd.old_path,
                birth_region=[birth_text],
                keys=keys,
                abandoned=abandoned,
                adopted=adopted,
                pairs=pair_labels,
                uncommitted=change.kind == "wt",
            )
            path_a.append(coh)

    # merge identical pairing signatures
    merged: list[Cohort] = []
    index: dict[tuple, Cohort] = {}
    for c in path_a:
        sig = (tuple(c.pairs), tuple(c.keys), c.birth_commit)
        if sig in index:
            index[sig].merge_from(c)
            if c.birth_region[0] not in index[sig].birth_region:
                index[sig].birth_region.extend(c.birth_region)
        else:
            index[sig] = c
            merged.append(c)

    for c in merged:
        populate_hits(repo, search_rev, c, changed_paths, dbg)
        c.paid = sort_members(c.paid)
        c.owing = sort_members(c.owing)
        c.echo = sort_members(c.echo)
        c.alias = sort_members(c.alias)
        if c.owing or c.echo:
            c.kind = "owing"
        elif c.paid and not c.owing:
            c.kind = "ok"
        debug(
            dbg,
            f"cohort keys={c.keys} paid={len(c.paid)} owing={len(c.owing)} echo={len(c.echo)}",
        )

    # Path B: change-as-birth clusters (introduced keys already split at HEAD)
    path_b: list[Cohort] = []
    if not args.no_birth_clusters:
        path_b = path_b_cohorts(repo, change, files, search_rev, dbg, args)

    out = merged + path_b
    if not args.all:
        out = [c for c in out if c.owing or c.kind == "split"]
    return out


def path_b_cohorts(
    repo: str,
    change: Change,
    files: list[FileDiff],
    search_rev: str | None,
    dbg: bool,
    args: argparse.Namespace,
) -> list[Cohort]:
    """Keys introduced by the change, scored at HEAD (factions / split)."""
    # Only interesting when the change itself is a birth (added slots)
    # or a natal literal later mutated.
    introduced: list[tuple[str, Slot, str]] = []  # path, slot, file text at add
    for fd in files:
        if fd.removed and fd.added:
            # modified file: Path A already handles slot renames; still
            # catch added literals that have no old slot (new keys).
            old_names = {s.name.lower() for ln, t in fd.removed for s in extract_slots(t, ln)}
            for ln, text in fd.added:
                for s in extract_slots(text, ln):
                    if s.name.lower() not in old_names and s.value and is_number(s.value):
                        introduced.append((fd.path, s, text))
            continue
        if fd.added and not fd.removed:
            for ln, text in fd.added:
                for s in extract_slots(text, ln):
                    introduced.append((fd.path, s, text))

    # For birth commits, every added slot is natal. Group by natal value
    # when it is a number that has factions at HEAD.
    by_lit: dict[str, list[tuple[str, Slot, str]]] = defaultdict(list)
    for path, slot, text in introduced:
        if slot.value and is_number(slot.value):
            by_lit[slot.value].append((path, slot, text))

    out: list[Cohort] = []
    birth_sha = change.commit if change.kind == "commit" else (change.parent or "")
    if not birth_sha or birth_sha in {"-", "UNCOMMITTED"}:
        b_h, b_date, b_subj = "", change.date, change.subject
    else:
        b_h, b_date, b_subj = commit_meta(repo, birth_sha)

    for lit, slots in by_lit.items():
        # skip quiet intact families unless --all: look for a mutated
        # descendant in the same file.
        needles = [lit]
        hits = git_grep_fixed(repo, search_rev, needles)
        # also look at HEAD of the introducing files for a new number on the slot
        adopted_nums: set[str] = set()
        paid: list[Member] = []
        owing: list[Member] = []
        for path, slot, text in slots:
            blob = head_file(repo, path, "HEAD" if search_rev else None)
            if not blob:
                continue
            head_slots = []
            for i, line in enumerate(blob.splitlines(), 1):
                head_slots.extend(extract_slots(line, i))
            # match by inflection of the slot name
            for hs in head_slots:
                if inflect_pair(slot.name, hs.name) or slot.name.lower() == hs.name.lower():
                    if hs.value and hs.value != lit and is_number(hs.value):
                        adopted_nums.add(hs.value)
                        paid.append(
                            Member(
                                "paid",
                                path,
                                hs.line,
                                hs.text,
                                path,
                                slot.line,
                                text,
                                [hs.value],
                                hs.value,
                            )
                        )
                    break
        if not adopted_nums:
            debug(dbg, f"path-b key='{lit}' natal={len(slots)} intact")
            if not args.all:
                continue
        # leftover natal literal
        for path, ln, text in hits:
            if not number_in(text, lit):
                continue
            role = file_role(path)
            if role == "code" and path in {p for p, _, _ in slots}:
                continue  # paid file no longer holds it
            st = "owing" if role in {"tests", "config"} or (
                role == "docs" and any(token_in(text, s.name) for _, s, _ in slots)
            ) else "echo"
            if role == "docs" and st == "owing" and not any(
                token_in(text, s.name) for _, s, _ in slots
            ):
                st = "echo"
            m = Member(st, path, ln, text, path, ln, text, [lit], lit)
            if st == "owing":
                owing.append(m)
            # echo handled below if we want — keep owing/echo split via classify
        # reclassify docs-only literal as owing if docs mention the natal name too
        echo: list[Member] = []
        kept_owing: list[Member] = []
        natal_names = [s.name for _, s, _ in slots]
        for m in owing:
            role = file_role(m.path)
            if role == "docs" and not any(token_in(m.text, n) for n in natal_names):
                m.status = "echo"
                echo.append(m)
            else:
                kept_owing.append(m)
        # docs leftover of the literal without the name → echo
        for path, ln, text in hits:
            if not number_in(text, lit):
                continue
            if (path, ln) in {(m.path, m.line) for m in kept_owing + paid + echo}:
                continue
            role = file_role(path)
            if role in {"docs", "tests"}:
                echo.append(Member("echo", path, ln, text, path, ln, text, [lit], lit))

        if not kept_owing and not adopted_nums and not args.all:
            continue
        adopted_list = sorted(adopted_nums)
        debug(
            dbg,
            f"path-b key='{lit}' natal={len(hits)} factions={{{lit}: {len(kept_owing)}}}",
        )
        fac: dict[str, int] = defaultdict(int)
        for m in paid + kept_owing:
            if m.holds:
                fac[m.holds] += 1
        kind = "split" if adopted_list and kept_owing else ("owing" if kept_owing else "ok")
        out.append(
            Cohort(
                kind=kind,
                birth_commit=b_h,
                birth_date=b_date,
                birth_subject=b_subj,
                birth_path=slots[0][0] if slots else "",
                birth_region=[],
                keys=[lit],
                abandoned=[lit],
                adopted=adopted_list,
                pairs=[],
                paid=sort_members(paid),
                owing=sort_members(kept_owing),
                echo=sort_members(echo),
                factions=dict(fac),
            )
        )
    return out


