def selftest() -> int:
    import subprocess

    failures = []

    def check(cond: bool, msg: str) -> None:
        if not cond:
            failures.append(msg)

    # source
    h = Harvest()
    harvest_source(
        "t.py",
        'import os\nfrom os import getenv as take\nKEY="DUE_CONST"\nos.environ["DUE_PORT"]\nos.getenv("DUE_API_KEY")\ntake(KEY)\nos.environ["DUE_INTERNAL"]="x"\n',
        h,
    )
    check("DUE_PORT" in h.facts, "py DUE_PORT")
    check("DUE_API_KEY" in h.facts, "py DUE_API_KEY")
    check("DUE_CONST" in h.facts, "py DUE_CONST alias+const")
    check("DUE_INTERNAL" not in h.facts, "py store ignored")

    h = Harvest()
    harvest_source("t.c", 'int main(){ getenv("ASSAY_GETENV_ONLY"); getenv("ASSAY_BOTH"); }\n', h)
    check(set(h.facts) == {"ASSAY_GETENV_ONLY", "ASSAY_BOTH"}, "c getenv")

    h = Harvest()
    harvest_source("t.rs", 'fn main(){ let _=std::env::var("DUE_TOKEN"); let _=env::var_os("DUE_HOME"); }\n', h)
    check("DUE_TOKEN" in h.facts and "DUE_HOME" in h.facts, "rs env::var")

    h = Harvest()
    harvest_source("t.sh", "# $DUE_COMMENTED\necho ${DUE_HOME}\necho $DUE_PORT\n", h)
    check("DUE_HOME" in h.facts and "DUE_PORT" in h.facts, "sh $VAR")
    check("DUE_COMMENTED" not in h.facts, "sh comment")

    cc = shutil.which("cc")
    if cc:
        with tempfile.TemporaryDirectory() as td:
            host_c = Path(td) / "host.c"
            host_c.write_text(Path(__file__).resolve().parent.joinpath("fixtures/split/host.c").read_text() if Path(__file__).resolve().parent.joinpath("fixtures/split/host.c").exists() else """
#include <stdio.h>
#include <stdlib.h>
static const char help[] __attribute__((used)) =
    "\\nASSAY_DOC_ONLY      : documented, never getenv\\n"
    "ASSAY_BOTH      : getenv and documented\\n"
    "Consider setting $ASSAY_DOLLAR to x\\n";
int main(void) { getenv("ASSAY_GETENV_ONLY"); getenv("ASSAY_BOTH"); return 0; }
""")
            host_bin = Path(td) / "host"
            r = subprocess.run([cc, "-o", str(host_bin), str(host_c)], capture_output=True)
            check(r.returncode == 0, "cc host")
            if r.returncode == 0:
                h = Harvest()
                harvest_file(str(host_bin), h, loose=False)
                kinds = {n: f.kind for n, f in h.facts.items()}
                check(kinds.get("ASSAY_GETENV_ONLY") == "DUE", f"GETENV_ONLY {kinds}")
                check(kinds.get("ASSAY_DOC_ONLY") == "LATENT", f"DOC_ONLY {kinds}")
                check(kinds.get("ASSAY_DOLLAR") == "LATENT", f"DOLLAR {kinds}")
                check(kinds.get("ASSAY_BOTH") == "BOTH", f"BOTH {kinds}")
                check(h.facts["ASSAY_GETENV_ONLY"].evidence == "call", "evidence call")
            orphan_c = Path(td) / "orphan.c"
            orphan_c.write_text('#include <stdio.h>\nint main(void){ puts("ORPHAN_ENV_NAME"); return 0; }\n')
            orphan_bin = Path(td) / "orphan"
            r = subprocess.run([cc, "-o", str(orphan_bin), str(orphan_c)], capture_output=True)
            if r.returncode == 0:
                h = Harvest()
                harvest_file(str(orphan_bin), h, loose=False)
                check("ORPHAN_ENV_NAME" not in h.facts, f"orphan default {list(h.facts)}")
                h2 = Harvest()
                harvest_file(str(orphan_bin), h2, loose=True)
                check("ORPHAN_ENV_NAME" in h2.facts, "orphan --loose")
            near_c = Path(td) / "near.c"
            near_c.write_text('#include <stdio.h>\n#include <stdlib.h>\nint main(void){ getenv("REAL_GETENV_NAME"); puts("DECOY_ENV_NAME"); return 0; }\n')
            near_bin = Path(td) / "near"
            r = subprocess.run([cc, "-o", str(near_bin), str(near_c)], capture_output=True)
            if r.returncode == 0:
                h = Harvest()
                harvest_file(str(near_bin), h, loose=False)
                check("REAL_GETENV_NAME" in h.facts, "nearby real")
                check("DECOY_ENV_NAME" not in h.facts, "nearby decoy")
            packed = Path(td) / "packed.bin"
            packed.write_bytes(b"\xd6DUE_FIXTURE_C\x00HOME\x00junkKIZU_CONFIGXDG_CONFIG_HOME")
            h = Harvest()
            harvest_file(str(packed), h, loose=False)
            check("DUE_FIXTURE_C" not in h.facts and "KIZU_CONFIG" not in h.facts, "packed not DUE")
            h = Harvest()
            harvest_file(str(packed), h, loose=True)
            check("DUE_FIXTURE_C" in h.facts, "packed --loose")

    if failures:
        print("selftest: FAIL")
        for f in failures:
            print("  ", f)
        return 1
    print("selftest: ok")
    return 0


