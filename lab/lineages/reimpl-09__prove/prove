def read_bytes_limited(path: str, limit: int = 256 * 1024 * 1024) -> bytes:
    with open(path, "rb") as f:
        return f.read(limit)


def harvest_file(path: str, harvest: Harvest, loose: bool) -> None:
    try:
        st = os.stat(path)
    except OSError:
        return
    if not stat.S_ISREG(st.st_mode):
        return
    try:
        with open(path, "rb") as f:
            peek = f.read(4)
            rest_needed = True
            kind = file_kind(path, peek)
            if kind in ("macho", "fat", "elf"):
                f.seek(0)
                data = f.read()
                if kind == "elf":
                    harvest_elf(path, data, harvest, loose)
                else:
                    harvest_macho(path, data, harvest, loose)
                return
            # source / other
            f.seek(0)
            data = f.read()
    except OSError:
        return
    ext = Path(path).suffix.lower()
    if ext in SOURCE_EXTS or peek.startswith(b"#!"):
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            text = data.decode("utf-8", "replace")
        harvest_source(path, text, harvest)
        return
    # packed blob / unknown: docs + optional loose; NEVER default-DUE
    harvest_docs(path, data, harvest)
    if loose:
        harvest_loose_tokens(path, data, harvest)


def iter_tree_files(root: str) -> Iterator[str]:
    for dirpath, dirnames, filenames in os.walk(root):
        base = os.path.basename(dirpath)
        if base in SKIP_DIR_NAMES or base.startswith("."):
            dirnames[:] = []
            continue
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIR_NAMES and not d.startswith(".")]
        for fn in filenames:
            if fn.startswith("."):
                continue
            yield os.path.join(dirpath, fn)


def harvest_target(target: str, harvest: Harvest, loose: bool, solo: bool, system: bool, closure: bool, depth: int) -> list[Image]:
    if os.path.isdir(target):
        for fp in iter_tree_files(target):
            harvest_file(fp, harvest, loose)
        return [Image("main", os.path.abspath(target), 0)]
    if not os.path.isfile(target):
        return []
    with open(target, "rb") as f:
        peek = f.read(4)
    kind = file_kind(target, peek)
    if kind in ("macho", "fat", "elf"):
        images = walk_images(target, solo=solo, system=system, closure=closure, depth=depth)
        for im in images:
            if im.role in ("main", "load") and os.path.isfile(im.path):
                harvest_file(im.path, harvest, loose)
        return images
    harvest_file(target, harvest, loose)
    return [Image("main", os.path.abspath(target), os.path.getsize(target))]


