KIND_ORDER = {"BOTH": 0, "DUE": 1, "LATENT": 2}


def select_facts(
    facts: dict[str, Fact],
    app: bool,
    due: bool,
    latent: bool,
    min_ev: Optional[str],
    loose: bool,
) -> list[Fact]:
    out = []
    min_rank = EV_RANK.get(min_ev or "", 0)
    for name, fact in facts.items():
        if app and hide_app(name):
            continue
        if not loose and fact.hows and fact.hows <= LOOSE_HOWS:
            continue
        if min_rank and EV_RANK.get(fact.evidence, 0) < min_rank:
            continue
        k = fact.kind
        if due and latent:
            if k != "BOTH":
                continue
        elif due:
            if k not in ("DUE", "BOTH"):
                continue
        elif latent:
            if k not in ("LATENT", "BOTH"):
                continue
        out.append(fact)
    return out


def print_table(facts: list[Fact]) -> None:
    if not facts:
        print("(no owed names)")
        return
    rows = []
    for f in sorted(facts, key=lambda x: (KIND_ORDER.get(x.kind, 9), x.name)):
        rows.append((f.kind, f.name, f.evidence, f.source, f.how_plus))
    w = [max(len(x) for x in col) for col in zip(*([("KIND", "NAME", "EVIDENCE", "SOURCE", "HOW")] + rows))]
    w = [max(w[i], len(h)) for i, h in enumerate(("KIND", "NAME", "EVIDENCE", "SOURCE", "HOW"))]
    fmt = f"{{:<{w[0]}}}  {{:<{w[1]}}}  {{:<{w[2]}}}  {{:<{w[3]}}}  {{:<{w[4]}}}"
    print(fmt.format("KIND", "NAME", "EVIDENCE", "SOURCE", "HOW"))
    print(fmt.format("-" * w[0], "-" * w[1], "-" * w[2], "-" * w[3], "-" * w[4]))
    for r in rows:
        print(fmt.format(*r))


def print_dump_abi(facts: list[Fact]) -> None:
    print("name\tkind\tevidence\tsource\tdetail\thows")
    for f in sorted(facts, key=lambda x: x.name):
        print(f"{f.name}\t{f.kind}\t{f.evidence}\t{f.source}\t{f.how_plus}\t{f.how_csv}")


def print_images(images: list[Image]) -> None:
    for im in images:
        if im.role in ("skip", "miss"):
            print(f"{im.role:4s}  {im.path}")
        else:
            print(f"{im.role:4s}  {im.path}  ({im.size})")


