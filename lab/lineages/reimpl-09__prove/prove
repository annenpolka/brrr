def harvest_elf(path: str, data: bytes, harvest: Harvest, loose: bool) -> None:
    if len(data) < 64 or data[:4] != b"\x7fELF":
        return
    ei_class = data[4]
    ei_data = data[5]
    if ei_class != 2 or ei_data != 1:
        harvest_docs(path, data, harvest)
        if loose:
            harvest_loose_tokens(path, data, harvest)
        return
    e_machine = struct.unpack_from("<H", data, 18)[0]
    e_shoff = struct.unpack_from("<Q", data, 40)[0]
    e_shentsize = struct.unpack_from("<H", data, 58)[0]
    e_shnum = struct.unpack_from("<H", data, 60)[0]
    e_shstrndx = struct.unpack_from("<H", data, 62)[0]
    if e_shoff == 0 or e_shentsize == 0:
        harvest_docs(path, data, harvest)
        return

    def sh(i: int) -> tuple:
        o = e_shoff + i * e_shentsize
        return struct.unpack_from("<IIQQQQIIQQ", data, o)

    shstr_off = sh(e_shstrndx)[4]

    def secname(i: int) -> str:
        name_off = sh(i)[0]
        z = data.find(b"\0", shstr_off + name_off, shstr_off + name_off + 64)
        return data[shstr_off + name_off : z].decode("ascii", "replace")

    sections = {}
    for i in range(e_shnum):
        n = secname(i)
        sections[n] = (i, sh(i))

    def dyn_symbols() -> list[str]:
        for key in (".dynsym", ".symtab"):
            if key not in sections:
                continue
            _, hdr = sections[key]
            sh_offset, sh_size, sh_entsize = hdr[4], hdr[5], hdr[9]
            strtab_idx = hdr[7]
            stroff = sh(strtab_idx)[4]
            strsz = sh(strtab_idx)[5]
            entsize = sh_entsize or 24
            names = []
            for j in range(0, sh_size, entsize):
                st_name = struct.unpack_from("<I", data, sh_offset + j)[0]
                z = data.find(b"\0", stroff + st_name, stroff + strsz)
                names.append(data[stroff + st_name : z].decode("utf-8", "replace"))
            return names
        return []

    # PLT relocs
    targets: dict[int, str] = {}
    dyn_names = dyn_symbols()
    for relk, entsize in ((".rela.plt", 24), (".rel.plt", 16)):
        if relk not in sections:
            continue
        _, hdr = sections[relk]
        off, sz = hdr[4], hdr[5]
        for j in range(0, sz, entsize):
            r_offset = struct.unpack_from("<Q", data, off + j)[0]
            r_info = struct.unpack_from("<Q", data, off + j + 8)[0]
            sym_idx = r_info >> 32
            if sym_idx < len(dyn_names):
                how = getenv_how(dyn_names[sym_idx])
                if how:
                    # plt slot: approximate via .plt + (j/entsize+1)*16
                    if ".plt" in sections:
                        plt_addr = sections[".plt"][1][3]
                        plt_entsize = 16 if e_machine in (0x3E, 0xB7) else 16
                        slot = plt_addr + ((j // entsize) + 1) * plt_entsize
                        targets[slot] = how
                    targets[r_offset] = how

    # defined getenv-shaped symbols
    for key in (".dynsym", ".symtab"):
        if key not in sections:
            continue
        _, hdr = sections[key]
        sh_offset, sh_size, sh_entsize = hdr[4], hdr[5], hdr[9]
        strtab_idx = hdr[7]
        stroff = sh(strtab_idx)[4]
        strsz = sh(strtab_idx)[5]
        entsize = sh_entsize or 24
        for j in range(0, sh_size, entsize):
            st_name, st_info, st_other, st_shndx, st_value, st_size = struct.unpack_from(
                "<IBBHQQ", data, sh_offset + j
            )
            z = data.find(b"\0", stroff + st_name, stroff + strsz)
            nm = data[stroff + st_name : z].decode("utf-8", "replace")
            how = getenv_how(nm)
            if how and st_value:
                targets[st_value] = how

    # scan .text
    if ".text" in sections and targets:
        _, hdr = sections[".text"]
        addr, off, sz = hdr[3], hdr[4], hdr[5]
        text = data[off : off + sz]

        class _E:
            def __init__(self, data, segs):
                self.data = data
                self._off = segs

            def va_to_off(self, va):
                for a, o, s in self._off:
                    if a <= va < a + s:
                        return o + (va - a)
                return None

            def read_va(self, va, n):
                o = self.va_to_off(va)
                if o is None:
                    return b""
                return data[o : o + n]

            def cstring_at(self, va, maxlen=160):
                raw = self.read_va(va, maxlen)
                s = raw.split(b"\0", 1)[0]
                if not s or any(c < 0x20 or c > 0x7E for c in s):
                    return ""
                try:
                    return s.decode("ascii")
                except Exception:
                    return ""

            def slice_at(self, va, n):
                raw = self.read_va(va, n)
                if len(raw) != n or any(c < 0x20 or c > 0x7E for c in raw):
                    return ""
                try:
                    return raw.decode("ascii")
                except Exception:
                    return ""

        segs = []
        for i in range(e_shnum):
            hdr = sh(i)
            if hdr[5] and hdr[4]:
                segs.append((hdr[3], hdr[4], hdr[5]))
        em = _E(data, segs)
        if e_machine == 0xB7:  # AArch64
            # reuse arm64 loop with a shim MachO-like
            class Shim:
                def __init__(self):
                    self.data = data
                    self.path = path
                    self.text = type("T", (), {"off": off, "addr": addr, "size": sz})()

                def read_va(self, va, n):
                    return em.read_va(va, n)

                def cstring_at(self, va, maxlen=160):
                    return em.cstring_at(va, maxlen)

                def slice_at(self, va, n):
                    return em.slice_at(va, n)

            xref_arm64(Shim(), targets, harvest, loose)  # type: ignore
        elif e_machine == 0x3E:  # x86_64
            class Shim:
                def __init__(self):
                    self.path = path
                    self.text = type("T", (), {"off": off, "addr": addr, "size": sz})()
                    self.data = data

                def cstring_at(self, va, maxlen=160):
                    return em.cstring_at(va, maxlen)

            xref_x86_64(Shim(), targets, harvest)  # type: ignore

    harvest_docs(path, data, harvest)
    if loose:
        harvest_loose_tokens(path, data, harvest)


