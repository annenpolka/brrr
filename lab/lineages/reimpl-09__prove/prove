MH_MAGIC_64 = 0xFEEDFACF
MH_CIGAM_64 = 0xCFFAEDFE
FAT_MAGIC = 0xCAFEBABE
FAT_CIGAM = 0xBEBAFECA
FAT_MAGIC_64 = 0xCAFEBABF
FAT_CIGAM_64 = 0xBFBAFECA
CPU_TYPE_ARM64 = 0x0100000C
CPU_TYPE_X86_64 = 0x01000007
LC_REQ_DYLD = 0x80000000
LC_SEGMENT_64 = 0x19
LC_SYMTAB = 0x2
LC_DYSYMTAB = 0xB
LC_LOAD_DYLIB = 0xC
LC_ID_DYLIB = 0xD
LC_LOAD_DYLINKER = 0xE
LC_LOAD_WEAK_DYLIB = 0x18
LC_RPATH = 0x1C
LC_REEXPORT_DYLIB = 0x1F
LC_FUNCTION_STARTS = 0x26
LC_DYLD_INFO = 0x22
LC_DYLD_INFO_ONLY = 0x22 | LC_REQ_DYLD

ARM64_BL = 0x94000000
ARM64_B = 0x14000000


def _u32(data: bytes, off: int, be: bool = False) -> int:
    if be:
        return struct.unpack_from(">I", data, off)[0]
    return struct.unpack_from("<I", data, off)[0]


def sx(val: int, bits: int) -> int:
    sign = 1 << (bits - 1)
    return (val & (sign - 1)) - (val & sign)


def pick_fat_slice(data: bytes) -> bytes:
    magic = struct.unpack_from(">I", data, 0)[0]
    if magic in (FAT_CIGAM, FAT_CIGAM_64):
        # swapped; still stored big-endian on disk for fat headers
        pass
    if magic in (FAT_MAGIC, FAT_CIGAM):
        nfat = struct.unpack_from(">I", data, 4)[0]
        archs = []
        for i in range(nfat):
            cputype, cpusub, offset, size, align = struct.unpack_from(">IIIII", data, 8 + i * 20)
            archs.append((cputype, cpusub, offset, size))
    elif magic in (FAT_MAGIC_64, FAT_CIGAM_64):
        nfat = struct.unpack_from(">I", data, 4)[0]
        archs = []
        for i in range(nfat):
            cputype, cpusub, offset, size, align, reserved = struct.unpack_from(
                ">IIQQII", data, 8 + i * 32
            )
            archs.append((cputype, cpusub, offset, size))
    else:
        return data
    # prefer host ARM64, then arm64e (higher subtype), then x86_64
    def score(item: tuple[int, int, int, int]) -> tuple[int, int]:
        cputype, cpusub, _, _ = item
        cpu = cputype & 0x00FFFFFF
        if cputype == CPU_TYPE_ARM64 or cpu == 12:
            return (2, cpusub & 0xFF)
        if cputype == CPU_TYPE_X86_64 or cpu == 7:
            return (1, 0)
        return (0, 0)

    archs.sort(key=score, reverse=True)
    if not archs or score(archs[0])[0] == 0:
        raise ValueError("no usable fat slice")
    _, _, offset, size = archs[0]
    return data[offset : offset + size]


@dataclass
class Section:
    seg: str
    name: str
    addr: int
    size: int
    off: int
    flags: int
    reserved1: int
    reserved2: int


@dataclass
class Segment:
    name: str
    vmaddr: int
    vmsize: int
    fileoff: int
    filesize: int


class MachO:
    def __init__(self, path: str, data: bytes):
        self.path = path
        self.data = data
        self.cputype = 0
        self.segments: list[Segment] = []
        self.sects: list[Section] = []
        self.dylibs: list[str] = []
        self.rpaths: list[str] = []
        self.symoff = self.nsyms = self.stroff = self.strsize = 0
        self.indirectoff = self.nindirect = 0
        self.text: Optional[Section] = None
        self._parse()

    def _parse(self) -> None:
        data = self.data
        magic = _u32(data, 0)
        if magic == MH_CIGAM_64:
            raise ValueError("big-endian Mach-O unsupported")
        if magic != MH_MAGIC_64:
            raise ValueError("not mach-o 64")
        self.cputype = _u32(data, 4)
        ncmds = _u32(data, 16)
        off = 32
        for _ in range(ncmds):
            cmd, cmdsize = struct.unpack_from("<II", data, off)
            raw = cmd & ~LC_REQ_DYLD
            if raw == LC_SEGMENT_64:
                segname = data[off + 8 : off + 24].split(b"\0", 1)[0].decode("ascii", "replace")
                vmaddr, vmsize, fileoff, filesize = struct.unpack_from("<QQQQ", data, off + 24)
                nsects = struct.unpack_from("<I", data, off + 64)[0]
                self.segments.append(Segment(segname, vmaddr, vmsize, fileoff, filesize))
                so = off + 72
                for _s in range(nsects):
                    sectname = data[so : so + 16].split(b"\0", 1)[0].decode("ascii", "replace")
                    seg2 = data[so + 16 : so + 32].split(b"\0", 1)[0].decode("ascii", "replace")
                    addr, size = struct.unpack_from("<QQ", data, so + 32)
                    sectoff, align, reloff, nreloc, flags, r1, r2, r3 = struct.unpack_from(
                        "<IIIIIIII", data, so + 48
                    )
                    rec = Section(seg2, sectname, addr, size, sectoff, flags, r1, r2)
                    self.sects.append(rec)
                    if sectname == "__text" and rec.seg == "__TEXT":
                        self.text = rec
                    so += 80
            elif raw == LC_SYMTAB:
                self.symoff, self.nsyms, self.stroff, self.strsize = struct.unpack_from(
                    "<IIII", data, off + 8
                )
            elif raw == LC_DYSYMTAB:
                fields = struct.unpack_from("<" + "I" * 18, data, off + 8)
                self.indirectoff = fields[12]
                self.nindirect = fields[13]
            elif raw in (LC_LOAD_DYLIB, LC_LOAD_WEAK_DYLIB, LC_REEXPORT_DYLIB):
                nloff = _u32(data, off + 8)
                name = data[off + nloff : off + cmdsize].split(b"\0", 1)[0].decode("utf-8", "replace")
                self.dylibs.append(name)
            elif raw == LC_RPATH:
                nloff = _u32(data, off + 8)
                name = data[off + nloff : off + cmdsize].split(b"\0", 1)[0].decode("utf-8", "replace")
                self.rpaths.append(name)
            off += cmdsize

    def va_to_off(self, va: int) -> Optional[int]:
        for s in self.segments:
            if s.vmaddr <= va < s.vmaddr + s.filesize:
                return s.fileoff + (va - s.vmaddr)
        for s in self.sects:
            if s.size and s.addr <= va < s.addr + s.size:
                return s.off + (va - s.addr)
        return None

    def read_va(self, va: int, n: int) -> bytes:
        o = self.va_to_off(va)
        if o is None or o < 0 or o >= len(self.data):
            return b""
        return bytes(self.data[o : o + n])

    def cstring_at(self, va: int, maxlen: int = 160) -> str:
        raw = self.read_va(va, maxlen)
        if not raw:
            return ""
        s = raw.split(b"\0", 1)[0]
        if not s or any(c < 0x20 or c > 0x7E for c in s):
            return ""
        return s.decode("ascii", "strict")

    def slice_at(self, va: int, n: int) -> str:
        raw = self.read_va(va, n)
        if len(raw) != n:
            return ""
        if any(c < 0x20 or c > 0x7E for c in raw):
            return ""
        return raw.decode("ascii", "strict")

    def symbols(self) -> Iterator[tuple[str, int, int, int]]:
        if not self.nsyms:
            return
        for i in range(self.nsyms):
            o = self.symoff + i * 16
            nidx, typ, sect, desc, value = struct.unpack_from("<IBBhQ", self.data, o)
            end = self.stroff + self.strsize
            start = self.stroff + nidx
            if start >= end:
                name = ""
            else:
                z = self.data.find(b"\0", start, min(start + 512, end))
                name = self.data[start : z if z >= 0 else start].decode("utf-8", "replace")
            yield name, value, typ, i

    def stub_symbols(self) -> dict[int, str]:
        names: dict[int, str] = {}
        for name, value, typ, i in self.symbols():
            names[i] = name
        out: dict[int, str] = {}
        if not self.nindirect or self.indirectoff <= 0:
            return out
        for s in self.sects:
            if s.name not in ("__stubs", "__auth_stubs", "__got"):
                continue
            stub_size = s.reserved2
            if s.name in ("__stubs", "__auth_stubs"):
                if stub_size <= 0:
                    stub_size = 16 if s.name == "__auth_stubs" else 12
                n = s.size // stub_size if stub_size else 0
            else:
                n = s.size // 8 if s.size else 0
                stub_size = 8
            for j in range(n):
                idx_off = self.indirectoff + (s.reserved1 + j) * 4
                if idx_off + 4 > len(self.data):
                    break
                idx = _u32(self.data, idx_off) & 0x0FFFFFFF
                nm = names.get(idx, "")
                if nm:
                    out[s.addr + j * stub_size] = nm
        return out

    def is_arm64(self) -> bool:
        return (self.cputype & 0x00FFFFFF) == 12 or self.cputype == CPU_TYPE_ARM64

    def is_x86_64(self) -> bool:
        return (self.cputype & 0x00FFFFFF) == 7 or self.cputype == CPU_TYPE_X86_64


def getenv_how(sym: str) -> Optional[str]:
    """Map a symbol name to a getenv-shaped use, or None."""
    if not sym:
        return None
    n = sym[1:] if sym.startswith("_") and not sym.startswith("_Z") and not sym.startswith("_R") else sym
    # C
    if n in ("getenv", "secure_getenv") or sym in ("_getenv", "getenv", "_secure_getenv"):
        return "getenv"
    if n in ("_Py_GETENV",) or sym in ("_Py_GETENV", "Py_GETENV"):
        return "_Py_GETENV"
    if n.endswith("getenv") and "ung" not in n.lower():
        # _Py_GETENV already handled; mimalloc __mi_prim_getenv etc.
        if "prim" in n or n.endswith("_getenv"):
            return "getenv"
    # Rust v0 mangling: std::env::__var / __var_os / unix::getenv
    if "3std3env4__var" in sym or sym.endswith("3env4__var"):
        return "env::var"
    if "3std3env7__var_os" in sym or "3env7__var_os" in sym:
        return "env::var_os"
    if "3std3sys3env4unix6getenv" in sym:
        return "env::getenv"
    # Itanium
    if "_ZN3std3env3varE" in sym or sym.endswith("ZN3std3env3varE"):
        return "env::var"
    if "_ZN3std3env6var_osE" in sym:
        return "env::var_os"
    if "_ZNSt3env6getenvE" in n or "std::getenv" in n:
        return "std::getenv"
    if n in ("_ZSt6getenvPKc", "_ZSt6getenv"):
        return "std::getenv"
    return None


# ARM64 decode --------------------------------------------------------------

def dec_adrp(insn: int, pc: int) -> Optional[tuple[int, int]]:
    if (insn & 0x9F000000) != 0x90000000:
        return None
    rd = insn & 0x1F
    immlo = (insn >> 29) & 3
    immhi = (insn >> 5) & 0x7FFFF
    imm = sx((immhi << 2) | immlo, 21) << 12
    return rd, (pc & ~0xFFF) + imm


def dec_adr(insn: int, pc: int) -> Optional[tuple[int, int]]:
    if (insn & 0x9F000000) != 0x10000000:
        return None
    rd = insn & 0x1F
    immlo = (insn >> 29) & 3
    immhi = (insn >> 5) & 0x7FFFF
    imm = sx((immhi << 2) | immlo, 21)
    return rd, pc + imm


def dec_add_imm(insn: int) -> Optional[tuple[int, int, int]]:
    # ADD (immediate): op0 sf=*, op=0, S=0, 100010
    if (insn & 0x7F800000) != 0x11000000:
        return None
    rd = insn & 0x1F
    rn = (insn >> 5) & 0x1F
    imm12 = (insn >> 10) & 0xFFF
    shift = (insn >> 22) & 3
    if shift == 1:
        imm12 <<= 12
    elif shift != 0:
        return None
    return rd, rn, imm12


def dec_mov_reg(insn: int) -> Optional[tuple[int, int]]:
    # MOV Xd, Xm == ORR Xd, XZR, Xm  (shifted register, shift=0)
    if (insn & 0xFFE0FFE0) == 0xAA0003E0:
        return insn & 0x1F, (insn >> 16) & 0x1F
    if (insn & 0xFFE0FFE0) == 0x2A0003E0:
        return insn & 0x1F, (insn >> 16) & 0x1F
    return None


def dec_movz(insn: int) -> Optional[tuple[int, int]]:
    if (insn & 0x7F800000) != 0x52800000:
        return None
    rd = insn & 0x1F
    imm16 = (insn >> 5) & 0xFFFF
    hw = (insn >> 21) & 3
    return rd, imm16 << (16 * hw)


def dec_movk(insn: int) -> Optional[tuple[int, int, int]]:
    if (insn & 0x7F800000) != 0x72800000:
        return None
    rd = insn & 0x1F
    imm16 = (insn >> 5) & 0xFFFF
    hw = (insn >> 21) & 3
    return rd, imm16, hw


def dec_orr_imm(insn: int) -> Optional[tuple[int, int]]:
    # ORR (immediate): sf N immr imms Rn Rd, opc=01, 00100100
    if (insn & 0x7F800000) != 0x32000000:
        return None
    rd = insn & 0x1F
    rn = (insn >> 5) & 0x1F
    if rn != 31:
        return None
    sf = (insn >> 31) & 1
    N = (insn >> 22) & 1
    immr = (insn >> 16) & 0x3F
    imms = (insn >> 10) & 0x3F
    val = _decode_bitmask(sf, N, immr, imms)
    if val is None:
        return None
    return rd, val & (0xFFFFFFFFFFFFFFFF if sf else 0xFFFFFFFF)


def _decode_bitmask(sf: int, N: int, immr: int, imms: int) -> Optional[int]:
    if sf == 0 and N != 0:
        return None
    len_val = (N << 6) | ((~imms) & 0x3F)
    if len_val == 0:
        return None
    length = len_val.bit_length() - 1
    esize = 1 << length
    levels = esize - 1
    S = imms & levels
    R = immr & levels
    welem = (1 << (S + 1)) - 1
    # ror welem, R, within esize
    if esize != 0:
        welem = ((welem >> R) | (welem << (esize - R))) & ((1 << esize) - 1)
    wmask = 0
    span = 64 if sf else 32
    for i in range(0, span, esize):
        wmask |= welem << i
    if not sf:
        wmask &= 0xFFFFFFFF
    return wmask


def dec_bl(insn: int, pc: int) -> Optional[int]:
    if (insn & 0xFC000000) != ARM64_BL:
        return None
    return pc + sx(insn & 0x03FFFFFF, 26) * 4


def dec_b(insn: int, pc: int) -> Optional[int]:
    if (insn & 0xFC000000) != ARM64_B:
        return None
    return pc + sx(insn & 0x03FFFFFF, 26) * 4


def dec_ldr_uoff64(insn: int) -> Optional[tuple[int, int, int]]:
    # LDR Xt, [Xn, #imm]  size=11 opc=01
    if (insn & 0xFFC00000) != 0xF9400000:
        return None
    rt = insn & 0x1F
    rn = (insn >> 5) & 0x1F
    imm12 = (insn >> 10) & 0xFFF
    return rt, rn, imm12 * 8


def xref_arm64(m: MachO, targets: dict[int, str], harvest: Harvest, loose: bool = False) -> None:
    if not m.text:
        return
    text = m.data[m.text.off : m.text.off + m.text.size]
    base = m.text.addr
    n = len(text) // 4
    adrp = [None] * 32  # type: ignore
    formed = [None] * 32  # type: ignore
    imms = [None] * 32  # type: ignore
    formed_at = [None] * 32  # type: ignore
    imm_at = [None] * 32  # type: ignore
    src = m.path
    unpack = struct.unpack_from
    for i in range(n):
        insn = unpack("<I", text, i * 4)[0]
        pc = base + i * 4
        a = dec_adrp(insn, pc)
        if a is not None:
            rd, page = a
            if rd != 31:
                adrp[rd] = page
                formed[rd] = None
                formed_at[rd] = None
            continue
        ad = dec_adr(insn, pc)
        if ad is not None:
            rd, va = ad
            if rd != 31:
                formed[rd] = va
                formed_at[rd] = i
                adrp[rd] = va & ~0xFFF
            continue
        add = dec_add_imm(insn)
        if add is not None:
            rd, rn, imm = add
            if rd != 31 and rn != 31:
                if adrp[rn] is not None:
                    formed[rd] = adrp[rn] + imm
                    formed_at[rd] = i
                elif formed[rn] is not None:
                    formed[rd] = formed[rn] + imm
                    formed_at[rd] = i
            continue
        mv = dec_mov_reg(insn)
        if mv is not None:
            rd, rm = mv
            formed[rd] = formed[rm]
            formed_at[rd] = formed_at[rm] if formed[rm] is not None else i
            adrp[rd] = adrp[rm]
            imms[rd] = imms[rm]
            imm_at[rd] = imm_at[rm]
            continue
        mz = dec_movz(insn)
        if mz is not None:
            rd, val = mz
            imms[rd] = val
            imm_at[rd] = i
            continue
        mk = dec_movk(insn)
        if mk is not None:
            rd, val, hw = mk
            cur = imms[rd] if imms[rd] is not None else 0
            mask = 0xFFFF << (16 * hw)
            imms[rd] = (cur & ~mask) | (val << (16 * hw))
            imm_at[rd] = i
            continue
        oi = dec_orr_imm(insn)
        if oi is not None:
            rd, val = oi
            imms[rd] = val
            imm_at[rd] = i
            continue
        ldr = dec_ldr_uoff64(insn)
        if ldr is not None:
            rt, rn, off = ldr
            if rn != 31 and adrp[rn] is not None:
                # pointer load; do not treat GOT slot as a cstring
                formed[rt] = None
                formed_at[rt] = None
            continue
        tgt = dec_bl(insn, pc)
        if tgt is None:
            tgt = dec_b(insn, pc)
        if tgt is None or tgt not in targets:
            continue
        how = targets[tgt]
        len1 = imms[1]
        # Rust &str length is load-bearing only when it was written next to x0.
        # A stale w1 turns LLVM_DISABLE_SYMBOLIZATION into LLVM_DISABLE_SY.
        if len1 is not None:
            fa = formed_at[0]
            ia = imm_at[1]
            if fa is None or i - fa > 20:
                len1 = None
            elif ia is None or i - ia > 20:
                len1 = None
        name = recover_name(m, formed[0], len1)
        if name:
            harvest.add(name, how, src, evidence="call", va=pc)


def recover_name(m: MachO, va0: Optional[int], len1: Optional[int]) -> str:
    if va0 is None:
        return ""
    # Rust &str: (ptr, len). Length is load-bearing for packed literals.
    if len1 is not None and 1 <= len1 <= 128:
        s = m.slice_at(va0, len1)
        if s and is_env_token(s):
            return s
    s = m.cstring_at(va0)
    if s and is_env_token(s):
        return s
    return ""


def xref_x86_64(m: MachO, targets: dict[int, str], harvest: Harvest) -> None:
    if not m.text:
        return
    text = m.data[m.text.off : m.text.off + m.text.size]
    base = m.text.addr
    src = m.path
    tset = targets
    i = 0
    n = len(text)
    while i < n - 5:
        if text[i] == 0xE8:
            rel = struct.unpack_from("<i", text, i + 1)[0]
            pc = base + i
            tgt = pc + 5 + rel
            if tgt in tset:
                how = tset[tgt]
                name = recover_x86_name(m, text, base, i)
                if name:
                    harvest.add(name, how, src, evidence="call", va=pc)
            i += 5
            continue
        i += 1


def recover_x86_name(m: MachO, text: bytes, base: int, call_off: int) -> str:
    # look back ~32 bytes for lea rdi, [rip+disp]  48 8d 3d disp32
    start = max(0, call_off - 40)
    window = text[start:call_off]
    for j in range(len(window) - 6):
        if window[j : j + 3] == b"\x48\x8d\x3d":
            disp = struct.unpack_from("<i", window, j + 3)[0]
            insn_va = base + start + j
            va = insn_va + 7 + disp
            s = m.cstring_at(va)
            if s and is_env_token(s):
                return s
        # lea rdi, [rip] with 4c/48 8d 3d already; also mov edi, imm32 (bf)
        if window[j] == 0xBF:
            imm = struct.unpack_from("<I", window, j + 1)[0]
            s = m.cstring_at(imm)
            if s and is_env_token(s):
                return s
    return ""


def macho_targets(m: MachO) -> dict[int, str]:
    out: dict[int, str] = {}
    for va, name in m.stub_symbols().items():
        how = getenv_how(name)
        if how:
            out[va] = how
    for name, value, typ, _i in m.symbols():
        how = getenv_how(name)
        if how and value:
            out[value] = how
    return out


_SKIP_SECTS = {
    "__text", "__stubs", "__auth_stubs", "__stub_helper", "__unwind_info",
    "__eh_frame", "__got", "__la_symbol_ptr", "__nl_symbol_ptr",
    "__mod_init_func", "__mod_term_func", "__bss", "__common", "__objc_methname",
}
S_ATTR_PURE_INSTRUCTIONS = 0x80000000


def macho_string_blob(m: MachO) -> bytes:
    """Documentation lives in cstring/const, not in 97MB of AMDGPU opcodes."""
    parts: list[bytes] = []
    for s in m.sects:
        if s.name in _SKIP_SECTS or s.size <= 0:
            continue
        if s.flags & S_ATTR_PURE_INSTRUCTIONS:
            continue
        end = min(len(m.data), s.off + s.size)
        if s.off >= end:
            continue
        parts.append(bytes(m.data[s.off:end]))
        parts.append(b"\n")
    return b"".join(parts) if parts else bytes(m.data)


def harvest_macho(path: str, data: bytes, harvest: Harvest, loose: bool) -> None:
    try:
        if data[:4] in (b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca", b"\xca\xfe\xba\xbf", b"\xbf\xba\xfe\xca"):
            data = pick_fat_slice(data)
        m = MachO(path, data)
    except Exception:
        return
    targets = macho_targets(m)
    if m.is_arm64():
        xref_arm64(m, targets, harvest, loose)
    elif m.is_x86_64():
        xref_x86_64(m, targets, harvest)
    blob = macho_string_blob(m)
    harvest_docs(path, blob, harvest)
    if loose:
        harvest_loose_tokens(path, blob, harvest)


