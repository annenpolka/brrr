ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def is_env_token(name: str) -> bool:
    if not name or len(name) > 128 or not ENV_NAME_RE.fullmatch(name):
        return False
    if name.endswith("_") or (name.startswith("_") and name[1:] not in LIBC_ENV):
        return False
    if name in LIBC_ENV or name in BARE_APP:
        return True
    if "_" in name:
        parts = [p for p in name.split("_") if p]
        if len(parts) < 2:
            return False
        return all(len(p) >= 1 for p in parts)
    return name.isupper() and len(name) >= 4


def hide_app(name: str) -> bool:
    if name in LIBC_ENV:
        return True
    if name.startswith("LC_") and name not in ("LC_ALL",):
        return name[3:].isupper()
    return False


