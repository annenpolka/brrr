def load_abi(path: str) -> Harvest:
    h = Harvest()
    if path in ("-", "/dev/stdin"):
        text = sys.stdin.read()
    else:
        text = Path(path).read_text("utf-8")
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("\t")
        if parts and parts[0] == "name":
            continue
        if len(parts) < 2:
            continue
        name, kind = parts[0], parts[1] if len(parts) > 1 else ""
        evidence = parts[2] if len(parts) > 2 else "string"
        source = parts[3] if len(parts) > 3 else ""
        hows = parts[5] if len(parts) > 5 else (parts[4] if len(parts) > 4 else "")
        tags = [t for t in re.split(r"[+,]", hows) if t]
        if not tags:
            if kind == "LATENT":
                tags = ["help"]
            elif kind == "BOTH":
                tags = ["getenv", "help"]
            else:
                tags = ["getenv"]
        for t in tags:
            ev = evidence
            if t in DUE_HOWS and t not in ("shell", "$VAR", "${}"):
                ev = "call" if evidence == "call" else evidence
            h.add(name, t, source, ev)
    return h


