HELP_RE = re.compile(br"(?:^|[\n\r])([A-Z][A-Z0-9_]{1,80}) {2,}:")
DOLLAR_RE = re.compile(br"\$([A-Z][A-Z0-9_]{2,80})\b")
PROSE_RE = re.compile(
    br"environment[ \t]+variable[ \t]+[`'\"]?([A-Z][A-Z0-9_]{1,80})",
    re.IGNORECASE,
)
# NAME =  but not GPU assembler `FOO:BAR =`
ASSIGN_RE = re.compile(br"(?:^|[\n\r]|[^:\w])([A-Z][A-Z0-9_]{1,80}) = ")
PACKED_RE = re.compile(br"(?:(?<=[^A-Z0-9_])|^)([A-Z][A-Z0-9]*_[A-Z0-9_]{1,80})(?:(?=[^A-Z0-9_])|$)")
CSTRING_ASSIGN_RE = re.compile(br"([A-Z][A-Z0-9_]{1,80}) = ")


def _doc_name_ok(name: str) -> bool:
    """Help-table / $VAR / NAME = must look documented, not an opcode table."""
    if not is_env_token(name):
        return False
    if name in BARE_APP or name in LIBC_ENV:
        return True
    return "_" in name


def harvest_docs(path: str, data: bytes, harvest: Harvest) -> None:
    for m in HELP_RE.finditer(data):
        name = m.group(1).decode("ascii")
        if _doc_name_ok(name):
            harvest.add(name, "help", path, "string")
    for m in DOLLAR_RE.finditer(data):
        name = m.group(1).decode("ascii")
        if _doc_name_ok(name):
            harvest.add(name, "dollar", path, "string")
    for m in PROSE_RE.finditer(data):
        name = m.group(1).decode("ascii")
        if _doc_name_ok(name):
            harvest.add(name, "prose", path, "string")
    for m in ASSIGN_RE.finditer(data):
        name = m.group(1).decode("ascii")
        # GPU assembler is `SQ_PGM_RESOURCES:STACK_SIZE =` — colon already excluded.
        # Still require an env-shaped name; SIZE-only opcodes drop.
        if _doc_name_ok(name) and (name in BARE_APP or "_" in name):
            harvest.add(name, "assign", path, "string")


_LOOSE_SPLIT = re.compile(
    r"(?=KIZU_|XDG_|KITTY_|TERM_PROGRAM|PYTHON_|RUSTC_|RUST_|CARGO_|GIT_|DUE_|ASSAY_|LODE_|APP_|HTTP_|HTTPS_|CLICOLOR)"
)


def harvest_loose_tokens(path: str, data: bytes, harvest: Harvest) -> None:
    seen = set()
    for m in PACKED_RE.finditer(data):
        raw = m.group(1).decode("ascii", "replace")
        end = m.end(1)
        start = m.start(1)
        isolated = start > 0 and data[start - 1] == 0 and end < len(data) and data[end] == 0
        pieces = [p for p in _LOOSE_SPLIT.split(raw) if p]
        if not pieces:
            pieces = [raw]
        for name in pieces:
            if name in seen or not is_env_token(name):
                continue
            # refuse a peel that continues as more token bytes (COLOR_FORCE ⊂ CLICOLOR_FORCE)
            if not isolated and end < len(data) and (65 <= data[end] <= 90 or 48 <= data[end] <= 57 or data[end] == 95):
                # only reject the unsplit tail; split pieces already ended at a seed
                if name == raw:
                    continue
            seen.add(name)
            harvest.add(name, "cstring" if isolated else "packed", path, "string")


