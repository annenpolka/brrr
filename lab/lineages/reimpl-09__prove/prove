C_GETENV = re.compile(r'\b(?:std::)?getenv\s*\(\s*"([A-Za-z_][A-Za-z0-9_]*)"')
RS_ENV = re.compile(
    r'\b(?:std::)?env::(?:var|var_os|remove_var|set_var)\s*(?:::<[^>]+>)?\s*\(\s*"([A-Za-z_][A-Za-z0-9_]*)"'
)
RS_ENV2 = re.compile(
    r'\b(?:std::)?(?:env::)?(?:var|var_os)\s*\(\s*"([A-Za-z_][A-Za-z0-9_]*)"'
)
PY_ENVIRON_STORE = re.compile(r"""os\.environ\[\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]\s*\]\s*=""")
PY_ENVIRON = re.compile(r"""os\.environ\[\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]\s*\]""")
PY_ENVIRON_GET = re.compile(r"""os\.environ\.get\(\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]""")
PY_GETENV = re.compile(r"""os\.getenv\(\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]""")
PY_CONST = re.compile(r"""^([A-Za-z_]\w*)\s*=\s*['"]([A-Z_][A-Z0-9_]*)['"]""")
PY_FROM_GETENV = re.compile(r"from\s+os\s+import\s+([^#\n]+)")
PY_CALL = re.compile(r"""\b([A-Za-z_]\w*)\s*\(\s*(?:['"]([A-Z_][A-Z0-9_]*)['"]|([A-Za-z_]\w*))\s*[,)]""")
JS_DOT = re.compile(r"process\.env\.([A-Za-z_][A-Za-z0-9_]*)")
JS_BRK = re.compile(r"""process\.env\[\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]\s*\]""")
SH_BRC = re.compile(r"\$\{([A-Z_][A-Z0-9_]*)\}")
SH_DOL = re.compile(r"\$([A-Z_][A-Z0-9_]{1,80})\b")
SH_COMMENT = re.compile(r"^\s*#")
C_COMMENT_LINE = re.compile(r"^\s*//")
PY_COMMENT = re.compile(r"^\s*#")


def harvest_source(path: str, text: str, harvest: Harvest) -> None:
    ext = Path(path).suffix.lower()
    lines = text.splitlines()
    if ext in {".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hh"}:
        for i, line in enumerate(lines, 1):
            if C_COMMENT_LINE.search(line):
                continue
            if "/*" in line and "getenv" in line and "*/" in line and "getenv" not in line.split("/*")[0]:
                continue
            for m in C_GETENV.finditer(line):
                harvest.add(m.group(1), "getenv", f"{path}:{i}", "call")
        return
    if ext == ".rs":
        for i, line in enumerate(lines, 1):
            if C_COMMENT_LINE.search(line):
                continue
            for rx, how in ((RS_ENV, "env::var"), (RS_ENV2, "env::var")):
                for m in rx.finditer(line):
                    harvest.add(m.group(1), how, f"{path}:{i}", "call")
        return
    if ext in {".py"}:
        consts: dict[str, str] = {}
        aliases = {"getenv"}
        for i, line in enumerate(lines, 1):
            if PY_COMMENT.search(line):
                continue
            cm = PY_CONST.match(line.strip())
            if cm:
                consts[cm.group(1)] = cm.group(2)
            fm = PY_FROM_GETENV.search(line)
            if fm:
                # getenv as take
                for part in fm.group(1).split(","):
                    part = part.strip()
                    if "getenv" in part:
                        if " as " in part:
                            aliases.add(part.split(" as ", 1)[1].strip())
                        else:
                            aliases.add("getenv")
            if PY_ENVIRON_STORE.search(line):
                continue
            for m in PY_ENVIRON.finditer(line):
                harvest.add(m.group(1), "os.environ[]", f"{path}:{i}", "call")
            for m in PY_ENVIRON_GET.finditer(line):
                harvest.add(m.group(1), "os.environ.get", f"{path}:{i}", "call")
            for m in PY_GETENV.finditer(line):
                harvest.add(m.group(1), "os.getenv", f"{path}:{i}", "call")
            for m in PY_CALL.finditer(line):
                fn, lit, ident = m.group(1), m.group(2), m.group(3)
                if fn not in aliases:
                    continue
                if lit:
                    harvest.add(lit, "os.getenv", f"{path}:{i}", "call")
                elif ident and ident in consts:
                    harvest.add(consts[ident], "os.getenv", f"{path}:{i}", "call")
        return
    if ext in {".ts", ".js", ".mjs", ".cjs"}:
        for i, line in enumerate(lines, 1):
            if C_COMMENT_LINE.search(line):
                continue
            for m in JS_DOT.finditer(line):
                harvest.add(m.group(1), "process.env", f"{path}:{i}", "call")
            for m in JS_BRK.finditer(line):
                harvest.add(m.group(1), "process.env[]", f"{path}:{i}", "call")
        return
    if ext in {".sh", ".bash", ".zsh", ".ksh"} or _looks_shell(text):
        for i, line in enumerate(lines, 1):
            if SH_COMMENT.search(line):
                continue
            for m in SH_BRC.finditer(line):
                harvest.add(m.group(1), "${}", f"{path}:{i}", "shell")
            for m in SH_DOL.finditer(line):
                harvest.add(m.group(1), "$VAR", f"{path}:{i}", "shell")
        return
    # generic: C getenv + rust + python-ish
    for i, line in enumerate(lines, 1):
        for m in C_GETENV.finditer(line):
            harvest.add(m.group(1), "getenv", f"{path}:{i}", "call")
        for m in RS_ENV.finditer(line):
            harvest.add(m.group(1), "env::var", f"{path}:{i}", "call")


def _looks_shell(text: str) -> bool:
    return text.startswith("#!") and any(s in text[:80] for s in ("sh", "bash", "zsh"))


