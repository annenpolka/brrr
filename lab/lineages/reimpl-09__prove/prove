def is_system_path(p: str) -> bool:
    return (
        p.startswith("/usr/lib/")
        or p.startswith("/System/")
        or p == "/usr/lib/libSystem.B.dylib"
        or p.startswith("/lib/")
        or p.startswith("/lib64/")
        or "/ld-linux" in p
        or p.startswith("/usr/lib64/")
    )


def file_kind(path: str, peek: bytes) -> str:
    if peek[:4] in (b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf", b"\xce\xfa\xed\xfe"):
        return "macho"
    if peek[:4] in (b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca", b"\xca\xfe\xba\xbf"):
        return "fat"
    if peek[:4] == b"\x7fELF":
        return "elf"
    return "other"


def resolve_load(name: str, loader: str, executable: str, rpaths: list[str]) -> Optional[str]:
    def subst(p: str) -> str:
        p = p.replace("@loader_path", str(Path(loader).resolve().parent))
        p = p.replace("@executable_path", str(Path(executable).resolve().parent))
        return p

    if name.startswith("@rpath/"):
        rest = name[len("@rpath/") :]
        for rp in rpaths:
            cand = os.path.normpath(os.path.join(subst(rp), rest))
            if os.path.isfile(cand):
                return cand
        return None
    if name.startswith("@loader_path/") or name.startswith("@executable_path/"):
        cand = os.path.normpath(subst(name))
        return cand if os.path.isfile(cand) else None
    if os.path.isfile(name):
        return name
    return None


@dataclass
class Image:
    role: str  # main / load / skip / miss
    path: str
    size: int = 0


def macho_or_none(path: str) -> Optional[MachO]:
    try:
        data = Path(path).read_bytes()
    except OSError:
        return None
    try:
        if data[:4] in (b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca", b"\xca\xfe\xba\xbf"):
            data = pick_fat_slice(data)
        if data[:4] != b"\xcf\xfa\xed\xfe":
            return None
        return MachO(path, data)
    except Exception:
        return None


def elf_needed(path: str) -> list[str]:
    try:
        data = Path(path).read_bytes()
    except OSError:
        return []
    if data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1:
        return []
    e_phoff = struct.unpack_from("<Q", data, 32)[0]
    e_phentsize = struct.unpack_from("<H", data, 54)[0]
    e_phnum = struct.unpack_from("<H", data, 56)[0]
    dyn = None
    for i in range(e_phnum):
        o = e_phoff + i * e_phentsize
        p_type = struct.unpack_from("<I", data, o)[0]
        if p_type == 2:  # PT_DYNAMIC
            p_offset, p_filesz = struct.unpack_from("<QQ", data, o + 8)[0], struct.unpack_from("<Q", data, o + 32)[0]
            dyn = (p_offset, p_filesz)
            break
    if not dyn:
        return []
    off, sz = dyn
    strtab = None
    needed_off = []
    k = off
    while k + 16 <= off + sz:
        tag, val = struct.unpack_from("<QQ", data, k)
        if tag == 0:
            break
        if tag == 5:  # DT_STRTAB
            strtab = val
        if tag == 1:  # DT_NEEDED
            needed_off.append(val)
        k += 16
    # map vaddr strtab to file via PT_LOAD
    loads = []
    for i in range(e_phnum):
        o = e_phoff + i * e_phentsize
        p_type = struct.unpack_from("<I", data, o)[0]
        if p_type == 1:
            p_offset = struct.unpack_from("<Q", data, o + 8)[0]
            p_vaddr = struct.unpack_from("<Q", data, o + 16)[0]
            p_filesz = struct.unpack_from("<Q", data, o + 32)[0]
            loads.append((p_vaddr, p_offset, p_filesz))
    if strtab is None:
        return []

    def vaoff(va: int) -> Optional[int]:
        for v, fo, fs in loads:
            if v <= va < v + fs:
                return fo + (va - v)
        return None

    so = vaoff(strtab)
    if so is None:
        return []
    out = []
    for n in needed_off:
        z = data.find(b"\0", so + n, so + n + 256)
        out.append(data[so + n : z].decode("utf-8", "replace"))
    return out


def walk_images(
    main: str,
    solo: bool = False,
    system: bool = False,
    closure: bool = False,
    depth: int = 1,
) -> list[Image]:
    main_p = str(Path(main).resolve()) if os.path.isfile(main) else main
    try:
        sz = os.path.getsize(main_p)
    except OSError:
        sz = 0
    images = [Image("main", main_p, sz)]
    if solo:
        return images
    seen = {os.path.realpath(main_p)}
    frontier = [(main_p, 0)]
    executable = main_p
    max_depth = 64 if closure else max(1, depth)
    while frontier:
        cur, d = frontier.pop(0)
        if d >= max_depth:
            continue
        m = macho_or_none(cur)
        deps: list[tuple[str, list[str]]] = []
        if m is not None:
            deps = [(n, m.rpaths) for n in m.dylibs]
        else:
            needed = elf_needed(cur)
            rpaths: list[str] = []
            deps = [(n, rpaths) for n in needed]
        for name, rpaths in deps:
            resolved = resolve_load(name, cur, executable, rpaths)
            display = resolved or name
            if resolved is None:
                if is_system_path(name) and not system:
                    images.append(Image("skip", name, 0))
                else:
                    images.append(Image("miss", name, 0))
                continue
            real = os.path.realpath(resolved)
            if real in seen:
                continue
            seen.add(real)
            if is_system_path(resolved) and not system:
                images.append(Image("skip", resolved, os.path.getsize(resolved) if os.path.isfile(resolved) else 0))
                continue
            try:
                dsz = os.path.getsize(resolved)
            except OSError:
                dsz = 0
            images.append(Image("load", resolved, dsz))
            frontier.append((resolved, d + 1))
    return images


