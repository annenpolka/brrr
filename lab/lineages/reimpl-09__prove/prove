ENV_LINE = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$")


def parse_env_file(path: str) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        text = Path(path).read_text("utf-8")
    except OSError:
        return out
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        m = ENV_LINE.match(s)
        if not m:
            continue
        val = m.group(2)
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
        out[m.group(1)] = val
    return out


def redact(name: str, val: Optional[str], show: bool) -> str:
    if val is None:
        return ""
    if not show and val and SECRET_RE.search(name):
        return "«redacted»"
    return val


FAIL_STATUSES = {"MISSING", "DIFF", "UNSET_LEFT", "UNSET_RIGHT", "UNDOCUMENTED"}


def join_rows(
    facts: dict[str, Fact],
    left: Optional[dict[str, str]],
    right: Optional[dict[str, str]],
    example: Optional[dict[str, str]],
    spare: bool,
    show: bool,
) -> list[dict]:
    names = set(facts)
    if spare and left:
        names |= set(left)
    if example:
        names |= set(example)
    rows = []
    for name in sorted(names):
        fact = facts.get(name)
        kind = fact.kind if fact else "DUE"
        ev = fact.evidence if fact else "example"
        src = fact.source if fact else (next(iter(example.keys()), "") if example else "")
        detail = fact.detail if fact else "documented but unread"
        lv = left.get(name) if left and name in left else None
        rv = right.get(name) if right and name in right else None
        evv = example.get(name) if example and name in example else None
        owed = name in facts
        statuses: list[str] = []
        if owed:
            if left is not None and right is not None:
                lin, rin = name in left, name in right
                if not lin and not rin:
                    statuses.append("MISSING")
                elif lin and rin and left[name] != right[name]:
                    statuses.append("DIFF")
                elif lin and not rin:
                    statuses.append("UNSET_RIGHT")
                elif rin and not lin:
                    statuses.append("UNSET_LEFT")
                else:
                    statuses.append("DUE")
            elif left is not None:
                if name in left:
                    statuses.append("DUE")
                else:
                    statuses.append("MISSING")
            else:
                statuses.append("DUE")
            if example is not None and name not in example:
                statuses.append("UNDOCUMENTED")
        else:
            if example is not None and name in example and name not in facts:
                statuses.append("STALE_EXAMPLE")
            if spare and left is not None and name in left and name not in facts:
                statuses.append("SPARE")
        if not statuses:
            continue
        for st in statuses:
            if st == "STALE_EXAMPLE":
                src = next((p for p in [src] if p), "")
                detail = "documented but unread"
                ev = "example"
            if st == "SPARE":
                detail = "set but unread"
                ev = "-"
            rows.append(
                {
                    "status": st,
                    "kind": kind,
                    "name": name,
                    "left": redact(name, lv if lv is not None else "", show) if lv is not None else "",
                    "right": redact(name, rv if rv is not None else "", show) if rv is not None else "",
                    "example": evv if evv is not None else "",
                    "evidence": ev,
                    "source": src if st != "STALE_EXAMPLE" else (list(example.keys()) and ""),
                    "detail": detail,
                }
            )
            if st == "STALE_EXAMPLE" and example:
                rows[-1]["source"] = ""
                # fill example path later
    return rows


