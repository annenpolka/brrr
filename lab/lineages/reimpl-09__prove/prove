HELP = """prove — DUE vs LATENT of a load image set, by getenv-shaped use.

DUE is a call-site xref (getenv / env::var / env::var_os / std::getenv), not an
env-shaped token. LATENT is documentation (help tables, $VAR, NAME =,
environment variable NAME). BOTH is the intersection.

Usage:
  prove PROGRAM
  prove --due PROGRAM
  prove --latent PROGRAM
  prove --due --latent PROGRAM     # BOTH only
  prove --solo PROGRAM
  prove --images PROGRAM
  prove --app python3
  prove --calls --app python3
  prove --dump-abi --app python3
  prove --loose PROGRAM            # packed/orphan tokens as a search aid
"""


def main(argv: Optional[list[str]] = None) -> int:
    p = argparse.ArgumentParser(
        prog="prove",
        description="DUE vs LATENT env of a load image set: getenv-shaped use versus documentation.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=HELP,
    )
    p.add_argument("programs", nargs="*", help="binary, script, source file, or tree")
    p.add_argument("-C", dest="chdir", metavar="DIR")
    p.add_argument("--vs", dest="vs", metavar="FILE", help="right-hand env file")
    p.add_argument("--left", metavar="FILE")
    p.add_argument("--right", metavar="FILE", help="alias for --vs")
    p.add_argument("--example", metavar="FILE")
    p.add_argument("--vs-pid", metavar="PID")
    p.add_argument("--vs-program", metavar="PATH")
    p.add_argument("--abi", metavar="FILE")
    p.add_argument("--dump-abi", action="store_true")
    p.add_argument("--names", action="store_true")
    p.add_argument("--emit", action="store_true")
    p.add_argument("--tsv", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--porcelain", action="store_true")
    p.add_argument("--spare", action="store_true")
    p.add_argument("--app", action="store_true")
    p.add_argument("--due", action="store_true")
    p.add_argument("--latent", action="store_true")
    p.add_argument("--loose", action="store_true")
    p.add_argument("--min-evidence", choices=["call", "shell", "string"])
    p.add_argument("--show-values", action="store_true")
    p.add_argument("--check", action="store_true")
    p.add_argument("--report-only", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("--solo", action="store_true")
    p.add_argument("--images", action="store_true")
    p.add_argument("--system", action="store_true")
    p.add_argument("--closure", action="store_true")
    p.add_argument("--depth", type=int, default=1, metavar="N")
    p.add_argument("--calls", action="store_true", help="print getenv/env::var sites: name, how, va, source")
    args = p.parse_args(argv)

    if args.version:
        print(VERSION)
        return 0
    if args.selftest:
        return selftest()
    if args.chdir:
        os.chdir(args.chdir)

    right = args.right or args.vs
    tsv = args.tsv or args.porcelain

    if not args.programs and not args.abi:
        print("prove: need a program/tree or --abi", file=sys.stderr)
        return 2

    harvest = Harvest()
    images_all: list[Image] = []
    resolved_programs: list[str] = []

    if args.abi:
        try:
            harvest = load_abi(args.abi)
        except Exception as e:
            print(f"prove: --abi: {e}", file=sys.stderr)
            return 2

    for spec in args.programs:
        try:
            target = resolve_operand(spec)
        except FileNotFoundError:
            print(f"prove: {spec}: not a file, directory, or PATH command", file=sys.stderr)
            return 2
        resolved_programs.append(target)
        try:
            imgs = harvest_target(
                target, harvest, args.loose, args.solo, args.system, args.closure, args.depth
            )
        except Exception as e:
            print(f"prove: {spec}: {e}", file=sys.stderr)
            return 2
        images_all.extend(imgs)

    if args.images:
        if not images_all and resolved_programs:
            print("(no owed names)")
            return 0
        print_images(images_all)
        return 0

    facts = harvest.facts

    # vs-program join of name sets
    if args.vs_program:
        try:
            right_path = resolve_operand(args.vs_program)
        except FileNotFoundError:
            print(f"prove: {args.vs_program}: not a file, directory, or PATH command", file=sys.stderr)
            return 2
        right_h = Harvest()
        right_imgs = harvest_target(
            right_path, right_h, args.loose, args.solo, args.system, args.closure, args.depth
        )
        left_sel = {f.name: f for f in select_facts(facts, args.app, False, False, args.min_evidence, args.loose)}
        right_sel = {f.name: f for f in select_facts(right_h.facts, args.app, False, False, args.min_evidence, args.loose)}
        image_files = [im.path for im in right_imgs if im.role in ("main", "load") and os.path.isfile(im.path)]
        # needles from left survive as BOTH if the bytes exist in the image set
        # (inlined Rust env::var does not leave x0 at the getenv bl).
        for n in list(left_sel):
            if n not in right_sel and needle_in_images(n, image_files):
                right_sel[n] = left_sel[n]
        names = sorted(set(left_sel) | set(right_sel))
        if args.names:
            for n in names:
                if n in left_sel and n in right_sel:
                    print(n)
            return 0
        print("status\tkind\tname")
        for n in names:
            if n in left_sel and n in right_sel:
                st = "BOTH"
            elif n in left_sel:
                st = "LEFT_ONLY"
            else:
                st = "RIGHT_ONLY"
            fact = left_sel.get(n) or right_sel.get(n)
            kind = fact.kind if fact else "DUE"
            print(f"{st}\t{kind}\t{n}")
        return 0

    selected = select_facts(facts, args.app, args.due, args.latent, args.min_evidence, args.loose)

    if args.calls:
        shown = {f.name for f in selected}
        rows = [(n, how, va, src) for n, how, va, src in harvest.calls if n in shown]
        if args.app:
            rows = [r for r in rows if not hide_app(r[0])]
        for n, how, va, src in rows:
            print(f"{n}\t{how}\t{va:#x}\t{src}")
        return 0

    # env join
    joining = args.left or right or args.example or args.emit
    if joining:
        left = parse_env_file(args.left) if args.left else None
        rgt = parse_env_file(right) if right else None
        ex = parse_env_file(args.example) if args.example else None
        owed = {f.name: f for f in selected}
        if args.emit:
            if left is None:
                print("prove: --emit needs --left", file=sys.stderr)
                return 2
            for name in sorted(owed):
                if name in left:
                    print(f"{name}={left[name]}")
            return 0
        rows = join_rows(owed, left, rgt, ex, args.spare, args.show_values)
        # fill STALE source with example path
        if ex is not None and args.example:
            for row in rows:
                if row["status"] == "STALE_EXAMPLE":
                    row["source"] = args.example
                    row["kind"] = owed[row["name"]].kind if row["name"] in owed else "DUE"
        if tsv or not args.json:
            if tsv:
                print("status\tkind\tname\tleft\tright\texample\tevidence\tsource\tdetail")
                for row in rows:
                    print(
                        f"{row['status']}\t{row['kind']}\t{row['name']}\t{row['left']}\t{row['right']}\t{row['example']}\t{row['evidence']}\t{row['source']}\t{row['detail']}"
                    )
            else:
                print_table(selected)
        fail = any(row["status"] in FAIL_STATUSES for row in rows)
        if args.report_only:
            return 0
        return 1 if fail else 0

    if args.dump_abi:
        print_dump_abi(selected)
        return 0
    if args.names:
        for f in sorted(selected, key=lambda x: x.name):
            print(f.name)
        return 0
    print_table(selected)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
