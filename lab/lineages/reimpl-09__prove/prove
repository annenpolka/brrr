@dataclass
class Fact:
    name: str
    hows: set[str] = field(default_factory=set)
    sources: list[str] = field(default_factory=list)
    evidence: str = "string"
    vas: list[int] = field(default_factory=list)
    call_how: str = ""

    def add(self, how: str, source: str, evidence: str, va: Optional[int] = None) -> None:
        self.hows.add(how)
        if source and source not in self.sources:
            self.sources.append(source)
        if EV_RANK.get(evidence, 0) > EV_RANK.get(self.evidence, 0):
            self.evidence = evidence
        if va is not None:
            self.vas.append(va)
            if how in DUE_HOWS and not self.call_how:
                self.call_how = how

    @property
    def due(self) -> bool:
        return bool(self.hows & DUE_HOWS)

    @property
    def latent(self) -> bool:
        return bool(self.hows & LATENT_HOWS)

    @property
    def kind(self) -> str:
        d, l = self.due, self.latent
        if d and l:
            return "BOTH"
        if d:
            return "DUE"
        if l:
            return "LATENT"
        return "DUE"  # loose packed search aid

    @property
    def source(self) -> str:
        return self.sources[0] if self.sources else ""

    @property
    def how_plus(self) -> str:
        return "+".join(sorted(self.hows))

    @property
    def how_csv(self) -> str:
        return ",".join(sorted(self.hows))

    @property
    def detail(self) -> str:
        extra = ""
        if len(self.sources) > 1:
            extra = "; also " + ",".join(self.sources[1:3])
        return self.how_plus + extra


class Harvest:
    def __init__(self) -> None:
        self.facts: dict[str, Fact] = {}
        self.calls: list[tuple[str, str, int, str]] = []  # name, how, va, source

    def add(
        self,
        name: str,
        how: str,
        source: str,
        evidence: str = "string",
        va: Optional[int] = None,
    ) -> None:
        if not is_env_token(name):
            return
        fact = self.facts.get(name)
        if fact is None:
            fact = Fact(name=name)
            self.facts[name] = fact
        fact.add(how, source, evidence, va)
        if evidence == "call" and va is not None:
            self.calls.append((name, how, va, source))

    def merge(self, other: "Harvest") -> None:
        for name, fact in other.facts.items():
            for how in fact.hows:
                ev = fact.evidence
                if how not in DUE_HOWS and how not in LATENT_HOWS:
                    ev = "string"
                elif how in DUE_HOWS and how in ("shell", "$VAR", "${}"):
                    ev = "shell" if how != "call" else "call"
                if how in DUE_HOWS and how not in ("shell", "$VAR", "${}"):
                    ev = fact.evidence if fact.evidence == "call" else (
                        "call" if how not in ("shell", "$VAR", "${}") else "shell"
                    )
                self.add(name, how, fact.source, fact.evidence)
            for src in fact.sources[1:]:
                self.add(name, next(iter(fact.hows)), src, fact.evidence)
        self.calls.extend(other.calls)


