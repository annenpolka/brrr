def _mint(repo: Path, ref: str, loc: str) -> str:
    snap = Snapshot("git", str(repo), ref)
    o = origin_payload(str(repo), ref)
    payload = mint_from_snapshot(snap, loc, DEFAULT_CTX, o)
    return encode_token(payload)


def _resolve(repo: Path, ref: str, tok: str) -> dict:
    snap = Snapshot("git", str(repo), ref)
    dest_o = origin_payload(str(repo), ref)
    payload = decode_token(tok)
    if not origins_match(payload.get("o"), str(repo), dest_o):
        raise AssertionError("origin mismatch in selftest")
    return resolve_payload(snap, payload, dest_empty_error=False)


