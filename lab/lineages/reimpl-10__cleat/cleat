def snapshot_from(flags: dict, side: str) -> tuple[Snapshot, dict | None, str | None]:
    repo = flags.get("repo")
    if side == "from":
        if flags.get("from_dir"):
            root = flags["from_dir"]
            if not Path(root).is_dir():
                raise CleatError(f"not a directory: {root}", 2)
            return Snapshot("dir", root), None, None
        if not repo:
            repo = "."
        if not flags.get("from"):
            raise CleatError("missing --from ref", 2)
        sha = resolve_ref(repo, flags["from"])
        o = origin_payload(repo, sha)
        return Snapshot("git", repo, sha), o, sha
    # dest
    if flags.get("to_dir"):
        root = flags["to_dir"]
        if not Path(root).is_dir():
            raise CleatError(f"not a directory: {root}", 2)
        git_root = discover_repo(root)
        o = origin_payload(git_root) if git_root else None
        return Snapshot("dir", root), o, git_root
    if not repo:
        repo = "."
    if not flags.get("to"):
        raise CleatError("missing --to ref", 2)
    sha = resolve_ref(repo, flags["to"])
    o = origin_payload(repo, sha)
    return Snapshot("git", repo, sha), o, repo


def cmd_mint(flags: dict) -> int:
    pos = flags["_pos"]
    if not pos:
        die("mint needs path:line", 2)
    loc = pos[0]
    if looks_like_token(loc):
        die("mint needs path:line, not a token", 2)
    ctx = int(flags.get("context") or DEFAULT_CTX)
    snap, origin, _ = snapshot_from(flags, "from")
    payload = mint_from_snapshot(snap, loc, ctx, origin)
    tok = encode_token(payload)
    if flags.get("pretty"):
        eprint(show_text(payload, tok))
    name = flags.get("name") or "-"
    if flags.get("file"):
        append_pinfile(flags["file"], name if name != "-" else os.path.basename(payload["p"]), tok)
    print(tok)
    return 0


def show_text(payload: dict, _tok: str | None = None) -> str:
    lines = []
    lines.append(f"  minted: {payload['p']}:{payload['n']}")
    lines.append(f"  text:       {payload.get('t', '')}")
    if payload.get("fn"):
        lines.append(f"  fn:         {payload['fn']}")
    if payload.get("u"):
        lines.append("  unique:     " + ", ".join(payload["u"]))
    if payload.get("a"):
        lines.append("  anchors:    " + ", ".join(payload["a"]))
    o = payload.get("o")
    lines.append(f"  origin:     {origin_str(o)}")
    if o and o.get("r"):
        lines.append("  remotes:    " + ", ".join(o["r"]))
    if payload.get("e"):
        lines.append("  before:")
        for x in payload["e"]:
            lines.append(f"    - {x}")
    if payload.get("b"):
        lines.append("  after:")
        for x in payload["b"]:
            lines.append(f"    - {x}")
    return "\n".join(lines)


def cmd_show(flags: dict) -> int:
    toks = flags["_tok"] + [p for p in flags["_pos"] if looks_like_token(p)]
    if not toks:
        die("show needs a cleat1. token", 2)
    payload = decode_token(toks[0])
    print(show_text(payload, toks[0]))
    return 0


def cmd_id(flags: dict) -> int:
    repo = flags.get("repo") or "."
    if not Path(repo, ".git").exists() and not discover_repo(repo):
        die(f"not a git repo: {repo}", 2)
    repo = flags.get("repo") or discover_repo(repo) or repo
    o = origin_payload(repo)
    print(origin_str(o))
    return 0


def resolve_one(snap: Snapshot, tok: str, flags: dict, dest_repo: str | None, dest_o: dict | None) -> dict:
    payload = decode_token(tok)
    token_o = payload.get("o")
    if not flags.get("any_repo"):
        if not origins_match(token_o, dest_repo if snap.kind == "git" else dest_repo, dest_o):
            raise CleatError(
                f"token belongs to a different repository ({origin_str(token_o)} vs {origin_str(dest_o)})"
            )
    empty_err = bool(flags.get("to_dir"))
    return resolve_payload(snap, payload, dest_empty_error=empty_err), payload


def cmd_resolve(flags: dict) -> int:
    pos = flags["_pos"]
    toks = list(flags["_tok"])
    locators = [p for p in pos if looks_like_locator(p)]
    toks += [p for p in pos if looks_like_token(p)]
    names_filter = [p for p in pos if not looks_like_token(p) and not looks_like_locator(p)]
    if locators and not toks and not flags.get("file") and not flags.get("stdin") and sys.stdin.isatty():
        die(
            f"resolve: {locators[0]} is a locator; pins are minted tokens, not path:line",
            2,
        )
    if locators and not toks and not flags.get("file"):
        die(
            f"resolve: {locators[0]} is a locator; pins are minted tokens, not path:line",
            2,
        )

    rows: list[tuple[str, str]] = []
    if flags.get("file"):
        rows.extend(read_pinfile(flags["file"]))
    if flags.get("stdin") or (not toks and not rows and not sys.stdin.isatty()):
        text = sys.stdin.read()
        if text.strip():
            rows.extend(read_pinfile(None, text))
    for t in toks:
        rows.append(("-", t))
    if names_filter:
        rows = [r for r in rows if r[0] in names_filter]
    if not rows:
        die("resolve needs a cleat1. token or --file", 2)

    snap, dest_o, dest_repo = snapshot_from(flags, "to")
    strict_fail = False
    last_rc = 0
    printed = []
    for name, tok in rows:
        try:
            res, payload = resolve_one(snap, tok, flags, dest_repo, dest_o)
        except CleatError as ex:
            eprint(f"cleat: {ex}")
            return ex.code
        if res["status"] == "ambiguous" and flags.get("strict"):
            strict_fail = True
        if flags.get("json"):
            printed.append(json.dumps(json_obj(res, name, tok, payload.get("o")), separators=(",", ":")))
        elif flags.get("porcelain"):
            printed.append(porcelain_line(res, name))
        else:
            printed.append(human_line(res, name))
    print("\n".join(printed))
    if strict_fail:
        return 1
    return last_rc


# --- selftest ----------------------------------------------------------------


def _git_init(repo: Path, files: dict[str, str], msg: str) -> str:
    repo.mkdir(parents=True)
    for rel, body in files.items():
        p = repo / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(body.lstrip("\n") if body.startswith("\n") else body, encoding="utf-8")
    subprocess.run(["git", "init", "-q"], cwd=repo, check=True)
    subprocess.run(["git", "add", "-A"], cwd=repo, check=True)
    subprocess.run(
        ["git", "-c", "user.name=cleat", "-c", "user.email=cleat@example.com", "commit", "-q", "-m", msg],
        cwd=repo,
        check=True,
    )
    return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip()


def _git_commit(repo: Path, files: dict[str, str], msg: str) -> str:
    for rel, body in files.items():
        p = repo / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(body.lstrip("\n") if body.startswith("\n") else body, encoding="utf-8")
    subprocess.run(["git", "add", "-A"], cwd=repo, check=True)
    subprocess.run(
        ["git", "-c", "user.name=cleat", "-c", "user.email=cleat@example.com", "commit", "-q", "-m", msg],
        cwd=repo,
        check=True,
    )
    return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip()


