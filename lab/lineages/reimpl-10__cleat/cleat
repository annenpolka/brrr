class CleatError(Exception):
    def __init__(self, msg: str, code: int = 1):
        super().__init__(msg)
        self.code = code


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def nfc(s: str) -> str:
    return unicodedata.normalize("NFC", s)


def die(msg: str, code: int = 1) -> None:
    eprint(f"cleat: {msg}")
    raise SystemExit(code)


# --- git / snapshot ----------------------------------------------------------


def run_git(repo: str, args: list[str], check: bool = True) -> subprocess.CompletedProcess:
    r = subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
    )
    if check and r.returncode != 0:
        err = (r.stderr or b"").decode("utf-8", "replace").strip()
        raise CleatError(err or f"git {' '.join(args)} failed", 2)
    return r


def git_text(repo: str, args: list[str], check: bool = True) -> str:
    r = run_git(repo, args, check=check)
    return (r.stdout or b"").decode("utf-8", "replace")


def git_ok(repo: str, args: list[str]) -> bool:
    return run_git(repo, args, check=False).returncode == 0


def discover_repo(directory: str) -> str | None:
    p = Path(directory).resolve()
    if (p / ".git").exists():
        return str(p)
    r = subprocess.run(
        ["git", "-C", str(p), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
    )
    if r.returncode == 0:
        return r.stdout.strip()
    return None


def resolve_ref(repo: str, ref: str) -> str:
    r = run_git(repo, ["rev-parse", "--verify", ref], check=False)
    if r.returncode != 0:
        raise CleatError(f"unknown ref: {ref}", 2)
    return (r.stdout or b"").decode().strip()


def norm_remote(url: str) -> str:
    u = url.strip()
    if not u:
        return u
    if u.startswith("git@"):
        rest = u[4:]
        if ":" in rest:
            host, path = rest.split(":", 1)
            path = path.removesuffix(".git").strip("/")
            return f"{host}/{path}"
    parsed = urlparse(u)
    if parsed.scheme == "file":
        return str(Path(parsed.path).resolve())
    if parsed.scheme in ("http", "https", "ssh", "git"):
        host = parsed.hostname or ""
        path = (parsed.path or "").removesuffix(".git").strip("/")
        return f"{host}/{path}"
    if u.endswith(".git"):
        u = u[:-4]
    return u


def collect_remotes(repo: str) -> list[str]:
    r = run_git(repo, ["remote", "-v"], check=False)
    out = (r.stdout or b"").decode("utf-8", "replace")
    found: list[str] = []
    seen: set[str] = set()
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        n = norm_remote(parts[1])
        if n and n not in seen:
            seen.add(n)
            found.append(n)
    return found


def follow_local_remotes(repo: str) -> list[str]:
    remotes = collect_remotes(repo)
    extra: list[str] = []
    r = run_git(repo, ["remote", "get-url", "origin"], check=False)
    if r.returncode != 0:
        return remotes
    origin = (r.stdout or b"").decode().strip()
    path = None
    if origin.startswith("/") or origin.startswith("file://"):
        path = origin[7:] if origin.startswith("file://") else origin
    if path:
        try:
            hop = str(Path(path).resolve())
            if hop != str(Path(repo).resolve()) and Path(hop, ".git").exists() or (
                Path(hop).exists() and discover_repo(hop)
            ):
                extra.extend(collect_remotes(hop))
        except OSError:
            pass
    merged: list[str] = []
    seen: set[str] = set()
    for x in remotes + extra:
        if x not in seen:
            seen.add(x)
            merged.append(x)
    return merged


def collect_witnesses(repo: str, extra: list[str] | None = None) -> list[str]:
    w: list[str] = []
    seen: set[str] = set()

    def add(sha: str) -> None:
        sha = sha.strip()
        if sha and sha not in seen and re.fullmatch(r"[0-9a-f]{7,40}", sha):
            seen.add(sha)
            w.append(sha)

    for x in extra or []:
        add(x)
    head = git_text(repo, ["rev-parse", "HEAD"], check=False).strip()
    add(head)
    tips = git_text(repo, ["rev-list", "-n", "4", "--all"], check=False)
    for line in tips.splitlines():
        add(line)
        if len(w) >= 8:
            break
    return w


def origin_payload(repo: str | None, from_sha: str | None = None) -> dict | None:
    if not repo:
        return None
    remotes = follow_local_remotes(repo)
    witnesses = collect_witnesses(repo, [from_sha] if from_sha else None)
    if not remotes and not witnesses:
        return None
    return {"r": remotes, "w": witnesses}


def origin_str(o: dict | None) -> str:
    if not o:
        return "-"
    r = ",".join(o.get("r") or [])
    w = ",".join((x[:12] for x in (o.get("w") or [])[:4]))
    return f"cleat1:r:{r};w:{w}"


