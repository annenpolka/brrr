            "v2",
        )
        tok = _mint(bp, v1, "src/calc.py:5")
        res = _resolve(bp, "HEAD", tok)
        check("body pin follows leftover", res["to"].startswith("src/math/ops.py:"), str(res))

        # ops_v2 unique, not ops substring
        sub = root / "sub"
        v1 = _git_init(sub, {"src/calc.py": V1_CALC}, "v1")
        _git_commit(
            sub,
            {
                "src/calc.py": (
                    "def helper_keep():\n"
                    "    from src.math.ops_v2 import helper_keep as impl\n"
                    "    return impl()\n"
                ),
                "src/math/ops_v2.py": 'def helper_keep():\n    return "stable helper"\n',
                "src/math/ops.py": 'def helper_keep():\n    return "stable helper"\n',
                "src/legacy/calc.py": 'def helper_keep():\n    return "stable helper"\n',
            },
            "v2",
        )
        tok = _mint(sub, v1, "src/calc.py:4")
        res = _resolve(sub, "HEAD", tok)
        check("ops_v2 not ops", res["to"].startswith("src/math/ops_v2.py:"), str(res))

        # partial body edit is not a leftover
        pb = root / "pb"
        v1 = _git_init(
            pb,
            {"src/calc.py": 'def helper_keep():\n    flag = True\n    return "stable helper"\n'},
            "v1",
        )
        _git_commit(
            pb,
            {
                "src/calc.py": 'def helper_keep():\n    flag = False\n    return "stable helper"\n',
                "src/math/ops.py": 'def helper_keep():\n    flag = True\n    return "stable helper"\n',
                "src/legacy/calc.py": 'def helper_keep():\n    return "stable helper"\n',
            },
            "v2",
        )
        tok = _mint(pb, v1, "src/calc.py:1")
        res = _resolve(pb, "HEAD", tok)
        check("partial body stays origin", res["to"].startswith("src/calc.py:"), str(res))

        # sibling fn remaining body is identity of the file
        sib = root / "sib"
        v1 = _git_init(sib, {"src/calc.py": V1_CALC}, "v1")
        _git_commit(
            sib,
            {
                "src/calc.py": (
                    "def helper_keep():\n"
                    "    return helper_keep_impl()\n\n"
                    "def helper_keep_impl():\n"
                    '    return "stable helper"\n'
                ),
                "src/math/ops.py": 'def helper_keep():\n    return "stable helper"\n',
            },
            "v2",
        )
        tok = _mint(sib, v1, "src/calc.py:4")
        res = _resolve(sib, "HEAD", tok)
        check("sibling fn stays origin", res["to"].startswith("src/calc.py:"), str(res))

        # keepcomment: origin holds body, comment is not a pointer
        kc = root / "kc"
        v1 = _git_init(kc, {"src/calc.py": V1_CALC}, "v1")
        _git_commit(
            kc,
            {
                "src/calc.py": (
                    "def add(a, b):\n"
                    "    return a + b\n\n"
                    "def helper_keep():\n"
                    "    # also copied to src.math.ops\n"
                    '    return "stable helper"\n'
                ),
                "src/math/ops.py": HELPER_BODY,
                "src/legacy/calc.py": 'def helper_keep():\n    return "stable helper"\n',
            },
            "v2",
        )
        tok = _mint(kc, v1, "src/calc.py:4")
        res = _resolve(kc, "HEAD", tok)
        check("keepcomment identity", res["to"].startswith("src/calc.py:"), str(res))

        # common-line clones are skipped paths, not extracted copies
        clones = root / "clones"
        v1 = _git_init(
            clones,
            {
                "packages/kernel/src/evaluate.ts": 'import {\n  type Catalog,\n} from "@voidtrace/catalog";\n'
            },
            "v1",
        )
        _git_commit(
            clones,
            {
                "packages/kernel/src/evaluate.ts": 'import {\n  type Catalog,\n} from "@voidtrace/catalog";\n',
                "apps/cli/src/cli.test.ts": 'import {\n  describe,\n} from "vitest";\n',
            },
            "v2",
        )
        tok = _mint(clones, v1, "packages/kernel/src/evaluate.ts:1")
        res = _resolve(clones, "HEAD", tok)
        check("import-clone identity", res["to"].startswith("packages/kernel/src/evaluate.ts:"), str(res))
        check(
            "import-clone not extracted",
            "extracted copy" not in res["note"] and "cli.test.ts" not in res["note"],
            str(res),
        )

        # trivial refuse
        triv = root / "triv"
        _git_init(triv, {"src/x.py": "}\n"}, "v1")
        try:
            _mint(triv, "HEAD", "src/x.py:1")
            check("trivial refuse", False, "minted }")
        except CleatError as ex:
            check("trivial refuse", "trivial" in str(ex).lower(), str(ex))

        # locator decode
        p, n = parse_locator("src/weird:colon.py:1")
        check("colon locator", p == "src/weird:colon.py" and n == 1)

    if failures:
        eprint("selftest failures:")
        for f in failures:
            eprint("  " + f)
        return 1
    print("selftest: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv if argv is None else argv)
    try:
        flags = parse_argv(argv)
        cmd = flags.get("_cmd")
        if flags.get("help") and cmd in (None, "help"):
            return cmd_help()
        if cmd == "version" or (flags.get("version") and cmd in (None, "version")):
            return cmd_version()
        if cmd == "help":
            return cmd_help()
        if cmd == "selftest":
            return cmd_selftest()
        if cmd == "mint":
            return cmd_mint(flags)
        if cmd == "show":
            return cmd_show(flags)
        if cmd == "id":
            return cmd_id(flags)
        if cmd == "resolve":
            return cmd_resolve(flags)
        if flags.get("help"):
            return cmd_help()
        die("usage: cleat mint|resolve|show|id|selftest — try --help", 2)
        return 2
    except CleatError as ex:
        eprint(f"cleat: {ex}")
        return ex.code
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
